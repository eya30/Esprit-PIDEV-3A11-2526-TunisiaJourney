{% extends 'base.html.twig' %}

{% block title %}Boutique Artisanale - TunisiaJourney{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --tunisia-red: #E31B23;
        --tunisia-orange: #FF6B35;
        --tunisia-sand: #FDF5E6;
        --tunisia-soft: #F5CAC3;
        --dark-gray: #2C3E50;
    }

    /* HERO CORRIGÉ */
    .hero {
        position: relative;
        height: 70vh;
        min-height: 500px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        text-align: center;
    }

    .hero-bg {
        position: absolute;
        width: 100%;
        height: 100%;
        object-fit: cover;
        top: 0;
        left: 0;
        z-index: 1;
    }

    .hero::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
            rgba(227,27,35,0.2),
            rgba(245,202,195,0.3)
        );
        z-index: 2;
    }

    .hero-content {
        position: relative;
        z-index: 3;
        max-width: 800px;
        padding: 3rem;
        color: white;
        animation: fadeInUp 1.2s cubic-bezier(0.2,0.9,0.4,1.1);
    }

    @keyframes fadeInUp {
        from {opacity:0;transform:translateY(50px)}
        to {opacity:1;transform:translateY(0)}
    }

    .hero h1 {
        font-family:'Cormorant Garamond',serif;
        font-size:4rem;
        font-weight:700;
        margin-bottom:1rem;
        text-shadow:3px 3px 12px rgba(0,0,0,0.5);
        color:#F5CAC3;
        letter-spacing:2px;
    }

    /* FILTERS */
    .filters-bar {
        background:white;
        padding:1.5rem 2rem;
        border-radius:20px;
        box-shadow:0 10px 30px rgba(0,0,0,0.08);
        margin-bottom:2rem;
        display:flex;
        flex-wrap:wrap;
        gap:1.5rem;
        align-items:center;
        justify-content:center;
    }

    .filter-group {
        display:flex;
        align-items:center;
        gap:0.5rem;
    }

    .filter-group label {
        font-weight:600;
        color:var(--dark-gray);
        font-size:0.9rem;
    }

    .filter-select, .search-input {
        padding:10px 18px;
        border:2px solid var(--tunisia-soft);
        border-radius:25px;
        background:white;
    }

    .custom-select-wrapper {
        position: relative;
        width: 220px;
        cursor: pointer;
    }

    .custom-select-trigger {
        padding: 10px 20px;
        border: 2px solid var(--tunisia-soft);
        border-radius: 25px;
        background: white;
        display: flex;
        justify-content: space-between;
    }

    .custom-options {
        position: absolute;
        top: 110%;
        left: 0;
        right: 0;
        background: white;
        border-radius: 15px;
        border: 2px solid var(--tunisia-soft);
        opacity: 0;
        visibility: hidden;
        transition: 0.3s;
    }

    .custom-select-wrapper.open .custom-options {
        opacity: 1;
        visibility: visible;
    }

    .custom-option {
        padding: 10px 20px;
        cursor: pointer;
    }

    .custom-option:hover {
        background: var(--tunisia-sand);
    }

    /* CARDS */
    .card-custom {
        background:white;
        border-radius:24px;
        overflow:hidden;
        box-shadow:0 15px 35px rgba(0,0,0,0.1);
        transition:0.4s;
        margin-bottom:30px;
    }

    .card-custom:hover {
        transform:translateY(-10px);
    }

    .card-img {
        height:260px;
        overflow:hidden;
    }

    .card-img img {
        width:100%;
        height:100%;
        object-fit:cover;
    }

    .card-content {
        padding:1.5rem;
    }

    .card-title {
        font-size:1.5rem;
        font-weight:700;
        color:var(--tunisia-red);
    }

    .card-price {
        font-size:1.3rem;
        font-weight:800;
        color:var(--tunisia-red);
        margin:10px 0;
    }

    .btn-commander {
        display:block;
        width:100%;
        text-align:center;
        background:linear-gradient(135deg,var(--tunisia-red),var(--tunisia-orange));
        color:white;
        padding:12px;
        border-radius:30px;
        text-decoration:none;
    }

    .btn-panier {
        background:var(--dark-gray);
        color:white;
        padding:12px 25px;
        border-radius:30px;
        text-decoration:none;
    }
</style>
{% endblock %}

{% block body %}

<!-- HERO CORRIGÉ -->
<section class="hero">
    <img src="https://switchmed.eu/wp-content/uploads/2020/04/tunisia-1.jpg" class="hero-bg">

    <div class="hero-content">
        <h1>Boutique Artisanale</h1>
        <p>Découvrez l'excellence du savoir-faire tunisien.</p>
    </div>
</section>

<section class="py-5" style="background:var(--tunisia-sand);">
    <div class="container">

        <div class="filters-bar">
            <input type="text" id="searchInput" placeholder="Rechercher..." class="search-input">

            <select id="priceFilter" class="filter-select">
                <option value="all">Tous prix</option>
                <option value="0-50">0 - 50 TND</option>
                <option value="50-100">50 - 100 TND</option>
                <option value="100+">100+ TND</option>
            </select>

            <select id="triFilter" class="filter-select">
                <option value="default">Par défaut</option>
                <option value="prix-asc">Prix croissant</option>
                <option value="prix-desc">Prix décroissant</option>
            </select>

            <a href="{{ path('app_panier_index') }}" class="btn-panier">
                🛒 Mon panier
            </a>
        </div>

        <div class="row" id="produitsGrid">
            {% for produit in produits %}
                <div class="col-md-4 produit-item"
                     data-titre="{{ produit.titre|lower }}"
                     data-prix="{{ produit.prix }}">

                    <div class="card-custom">
                        <div class="card-img">
                            <img src="{{ asset('uploads/produits/' ~ produit.image) }}">
                        </div>

                        <div class="card-content">
                            <h3 class="card-title">{{ produit.titre }}</h3>
                            <div class="card-price">{{ produit.prix }} TND</div>

                            <a href="{{ path('app_panier_add', {id: produit.idPR}) }}" class="btn-commander">
                                Ajouter au panier
                            </a>
                        </div>
                    </div>

                </div>
            {% endfor %}
        </div>

    </div>
</section>

{% endblock %}

{% block javascripts %}
<script>
function applyFilters() {
    const search = document.getElementById('searchInput').value.toLowerCase();
    const price = document.getElementById('priceFilter').value;
    const tri = document.getElementById('triFilter').value;

    const items = Array.from(document.querySelectorAll('.produit-item'));
    const grid = document.getElementById('produitsGrid');

    items.forEach(item => {
        const titre = item.dataset.titre;
        const p = parseFloat(item.dataset.prix);

        let visible = titre.includes(search);

        if (price === '0-50' && p > 50) visible = false;
        if (price === '50-100' && (p <= 50 || p > 100)) visible = false;
        if (price === '100+' && p <= 100) visible = false;

        item.style.display = visible ? 'block' : 'none';
    });

    const visibles = items.filter(i => i.style.display !== 'none');

    visibles.sort((a, b) => {
        const pA = parseFloat(a.dataset.prix);
        const pB = parseFloat(b.dataset.prix);

        if (tri === 'prix-asc') return pA - pB;
        if (tri === 'prix-desc') return pB - pA;
        return 0;
    });

    visibles.forEach(i => grid.appendChild(i));
}

document.getElementById('searchInput').addEventListener('input', applyFilters);
document.getElementById('priceFilter').addEventListener('change', applyFilters);
document.getElementById('triFilter').addEventListener('change', applyFilters);
</script>
{% endblock %}