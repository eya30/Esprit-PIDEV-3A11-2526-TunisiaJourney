{% extends 'base.html.twig' %}

{% block title %}Boutique Artisanale - TunisiaJourney{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --tunisia-red: #E31B23; --tunisia-orange: #FF6B35;
        --tunisia-sand: #FDF5E6; --tunisia-soft: #F5CAC3; --dark-gray: #2C3E50;
    }
    .hero { position:relative; height:70vh; min-height:500px; background-image:linear-gradient(rgba(227,27,35,0.2),rgba(245,202,195,0.3)),url('https://switchmed.eu/wp-content/uploads/2020/04/tunisia-1.jpg'); background-size:cover; background-position:center; background-attachment:fixed; display:flex; align-items:center; justify-content:center; text-align:center; color:white; overflow:hidden; }
    .hero-content { position:relative; z-index:2; max-width:800px; padding:3rem; animation:fadeInUp 1.2s cubic-bezier(0.2,0.9,0.4,1.1); }
    @keyframes fadeInUp { from{opacity:0;transform:translateY(50px)} to{opacity:1;transform:translateY(0)} }
    .hero h1 { font-family:'Cormorant Garamond',serif; font-size:4rem; font-weight:700; margin-bottom:1rem; text-shadow:3px 3px 12px rgba(0,0,0,0.5); color:#F5CAC3; letter-spacing:2px; }
    
    /* Barre de filtres */
    .filters-bar { background:white; padding:1.5rem 2rem; border-radius:20px; box-shadow:0 10px 30px rgba(0,0,0,0.08); margin-bottom:2rem; display:flex; flex-wrap:wrap; gap:1.5rem; align-items:center; justify-content:center; }
    .filter-group { display:flex; align-items:center; gap:0.5rem; }
    .filter-group label { font-weight:600; color:var(--dark-gray); font-size:0.9rem; }
    .filter-select, .search-input { padding:10px 18px; border:2px solid var(--tunisia-soft); border-radius:25px; background:white; font-size:0.9rem; transition:all 0.3s; }
    .filter-select:focus, .search-input:focus { outline:none; border-color:var(--tunisia-red); }

    /* Custom Category Select */
    .custom-select-wrapper { position: relative; width: 220px; cursor: pointer; }
    .custom-select-trigger { 
        padding: 10px 20px; border: 2px solid var(--tunisia-soft); border-radius: 25px; 
        background: white; display: flex; align-items: center; justify-content: space-between;
        font-weight: 600; color: var(--dark-gray); font-size: 0.9rem;
    }
    .custom-options {
        position: absolute; top: 110%; left: 0; right: 0; background: white;
        border-radius: 15px; border: 2px solid var(--tunisia-soft); box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        z-index: 100; opacity: 0; visibility: hidden; transition: all 0.3s;
    }
    .custom-select-wrapper.open .custom-options { opacity: 1; visibility: visible; }
    .custom-option { padding: 10px 20px; transition: 0.3s; font-size: 0.9rem; display: flex; align-items: center; gap: 10px; }
    .custom-option:hover { background: var(--tunisia-sand); color: var(--tunisia-red); }
    .custom-option.selected { background: var(--tunisia-red); color: white; }

    /* Cards */
    .card-custom { background:white; border-radius:24px; overflow:hidden; box-shadow:0 15px 35px rgba(0,0,0,0.1); transition:all 0.4s; margin-bottom:30px; }
    .card-custom:hover { transform:translateY(-10px); }
    .card-img { height:260px; overflow:hidden; position:relative; }
    .card-img img { width:100%; height:100%; object-fit:cover; }
    .badge-cat-card { position:absolute; top:15px; left:15px; padding:5px 12px; border-radius:20px; font-size:0.75rem; font-weight:700; background:rgba(227,27,35,0.9); color:white; }
    .card-content { padding:1.5rem; }
    .card-title { font-family:'Cormorant Garamond',serif; font-size:1.5rem; font-weight:700; color:var(--tunisia-red); }
    .card-price { font-size:1.3rem; font-weight:800; color:var(--tunisia-red); margin: 10px 0; }
    
    .btn-commander { display:block; width:100%; text-align:center; background:linear-gradient(135deg,var(--tunisia-red),var(--tunisia-orange)); color:white; padding:12px; border-radius:30px; font-weight:700; text-decoration:none; }
    .btn-panier { background:var(--dark-gray); color:white; padding:12px 25px; border-radius:30px; font-weight:700; text-decoration:none; display:inline-flex; align-items:center; gap:8px; transition:0.3s; }
    .btn-panier:hover { background:var(--tunisia-red); color:white; }

    @media(max-width:768px) { .filters-bar { flex-direction: column; align-items: stretch; } .custom-select-wrapper { width: 100%; } }
</style>
{% endblock %}

{% block body %}

<section class="hero">
    <div class="hero-content">
        <h1>Boutique Artisanale</h1>
        <p>Découvrez l'excellence du savoir-faire tunisien.</p>
    </div>
</section>

<section class="py-5" style="background:var(--tunisia-sand);">
    <div class="container">
       <div class="filters-bar">
    <div class="filter-group">
        <input type="text" class="search-input" id="searchInput" placeholder="Rechercher...">
    </div>

    <div class="filter-group">
        <label>Catégorie :</label>
        <div class="custom-select-wrapper" id="catSelector">
            <div class="custom-select-trigger">
                <span><i class="fas fa-th-large me-2"></i>Toutes</span>
                <i class="fas fa-chevron-down arrow"></i>
            </div>
            <div class="custom-options">
                <div class="custom-option selected" data-cat="all"><i class="fas fa-th-large"></i> Toutes</div>
                <div class="custom-option" data-cat="Artisanat"><i class="fas fa-hammer"></i> Artisanat</div>
                <div class="custom-option" data-cat="Bijoux"><i class="fas fa-gem"></i> Bijoux</div>
                <div class="custom-option" data-cat="Vêtements"><i class="fas fa-tshirt"></i> Vêtements</div>
                <div class="custom-option" data-cat="Décoration"><i class="fas fa-couch"></i> Décoration</div>
                <div class="custom-option" data-cat="Alimentaire"><i class="fas fa-utensils"></i> Alimentaire</div>
            </div>
        </div>
    </div>

    <div class="filter-group">
        <label>Budget :</label>
        <select class="filter-select" id="priceFilter">
            <option value="all">Tous prix</option>
            <option value="0-50">0 - 50 TND</option>
            <option value="50-100">50 - 100 TND</option>
            <option value="100+">100+ TND</option>
        </select>
    </div>

    <div class="filter-group">
        <label>Trier par :</label>
        <select class="filter-select" id="triFilter">
            <option value="default">Par défaut</option>
            <option value="prix-asc">Prix croissant</option>
            <option value="prix-desc">Prix décroissant</option>
            <option value="nom-asc">Nom (A-Z)</option>
        </select>
    </div>
    
    <a href="{{ path('app_panier_index') }}" class="btn-panier">
        <i class="fas fa-shopping-cart"></i> Mon panier
    </a>
</div>

        <div class="row" id="produitsGrid">
            {% for produit in produits %}
                <div class="col-md-4 produit-item" 
                     data-titre="{{ produit.titre|lower }}" 
                     data-prix="{{ produit.prix }}" 
                     data-cat="{{ produit.categorie }}"
                     data-dispo="{{ produit.disponibilite ? '1' : '0' }}">
                    <div class="card-custom">
                        <div class="card-img">
                            <img src="{{ asset('uploads/produits/' ~ produit.image) }}" alt="{{ produit.titre }}">
                            <span class="badge-cat-card">{{ produit.categorie }}</span>
                        </div>
                        <div class="card-content">
                            <h3 class="card-title">{{ produit.titre }}</h3>
                            <div class="card-price">{{ produit.prix }} TND</div>
                            <a href="{{path('app_panier_add', {id: produit.idPR}) }}" class="btn-commander">Ajouter au panier</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
<script>
    let activeCat = 'all';

    // Gestion de l'ouverture du menu catégorie
    const selector = document.getElementById('catSelector');
    selector.addEventListener('click', (e) => {
        e.stopPropagation();
        selector.classList.toggle('open');
    });

    document.querySelectorAll('.custom-option').forEach(option => {
        option.addEventListener('click', function() {
            document.querySelector('.custom-option.selected').classList.remove('selected');
            this.classList.add('selected');
            selector.querySelector('.custom-select-trigger span').innerHTML = this.innerHTML;
            activeCat = this.dataset.cat;
            applyFilters();
        });
    });

    function applyFilters() {
        const search = document.getElementById('searchInput').value.toLowerCase();
        const price = document.getElementById('priceFilter').value;
        const tri = document.getElementById('triFilter').value;
        const grid = document.getElementById('produitsGrid');
        const items = Array.from(document.querySelectorAll('.produit-item'));

        // 1. Filtrage
        items.forEach(item => {
            const titre = item.dataset.titre;
            const p = parseFloat(item.dataset.prix);
            const c = item.dataset.cat;

            let isVisible = titre.includes(search);
            if (activeCat !== 'all' && c !== activeCat) isVisible = false;
            if (price === '0-50' && p > 50) isVisible = false;
            if (price === '50-100' && (p <= 50 || p > 100)) isVisible = false;
            if (price === '100+' && p <= 100) isVisible = false;

            item.style.display = isVisible ? 'block' : 'none';
        });

        // 2. Tri des éléments visibles
        const visibles = items.filter(i => i.style.display !== 'none');
        
        visibles.sort((a, b) => {
            const pA = parseFloat(a.dataset.prix), pB = parseFloat(b.dataset.prix);
            const nA = a.dataset.titre, nB = b.dataset.titre;

            if (tri === 'prix-asc') return pA - pB;
            if (tri === 'prix-desc') return pB - pA;
            if (tri === 'nom-asc') return nA.localeCompare(nB);
            return 0;
        });

        // Réinjection dans la grille
        visibles.forEach(i => grid.appendChild(i));
    }

    // Écouteurs
    document.getElementById('searchInput').addEventListener('input', applyFilters);
    document.getElementById('priceFilter').addEventListener('change', applyFilters);
    document.getElementById('triFilter').addEventListener('change', applyFilters);

    window.onclick = () => selector.classList.remove('open');
</script>
{% endblock %}
