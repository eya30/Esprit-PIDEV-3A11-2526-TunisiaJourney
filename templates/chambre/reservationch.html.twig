{% extends 'base.html.twig' %}

{% block title %}Réserver - Chambre n°{{ chambre.num }} - {{ chambre.hotel_nom }}{% endblock %}

{% block stylesheets %}
<style>
    .reservation-page {
        min-height: 80vh;
        padding: 3rem 0 5rem;
    }

    .reservation-card {
        background: white;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 8px 40px rgba(38,70,83,0.10);
        max-width: 860px;
        margin: 0 auto;
    }

    .reservation-header {
        background: #264653;
        padding: 2rem 2.5rem;
        border-radius: 24px 24px 0 0;
    }

    .reservation-header h2 {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.8rem;
        font-weight: 700;
        color: white;
        margin: 0 0 0.6rem 0;
    }

    .reservation-header-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 1.2rem;
        margin-top: 0.5rem;
    }

    .reservation-header-meta span {
        color: rgba(255,255,255,0.85);
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .reservation-header-meta i { color: #F5A623; font-size: 0.9rem; }

    .reservation-body { padding: 2.5rem 2.5rem 3rem; }

    .currency-selector {
        text-align: right;
        margin-bottom: 1.5rem;
    }
    
    .currency-selector label {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--dark-gray);
        margin-right: 8px;
    }
    
    .currency-selector select {
        background: white;
        border: 1px solid #E8DFD1;
        border-radius: 30px;
        padding: 6px 15px;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s;
    }

    .prix-detail {
        background: linear-gradient(135deg, #F8F4F0, #FDF8F3);
        border-radius: 20px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        border: 1px solid #E8DFD1;
    }

    .prix-detail-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 1rem;
        padding-bottom: 0.8rem;
        border-bottom: 2px solid #264653;
    }

    .prix-detail-header i { font-size: 1.5rem; color: #C0392B; }

    .prix-detail-header h3 {
        margin: 0;
        font-size: 1.3rem;
        font-weight: 700;
        color: #264653;
    }

    .prix-ligne {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.8rem 0;
        border-bottom: 1px dashed #E8DFD1;
    }

    .prix-ligne:last-child { border-bottom: none; }

    .prix-ligne-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #264653;
        color: white;
        border-radius: 12px;
        padding: 1rem 1.5rem;
        margin-top: 0.5rem;
    }

    .prix-label-detail { font-weight: 600; color: #4A3B2F; }
    .prix-valeur { font-weight: 700; color: #C0392B; }
    .prix-valeur-original { text-decoration: line-through; color: #999; font-size: 0.9rem; }

    .badge-remise {
        background: #C0392B; color: white; border-radius: 20px;
        padding: 2px 10px; font-size: 0.7rem; font-weight: 600; margin-left: 8px;
    }
    .badge-saison {
        background: #E67E22; color: white; border-radius: 20px;
        padding: 2px 10px; font-size: 0.7rem; font-weight: 600; margin-left: 8px;
    }
    .badge-fidelite {
        background: linear-gradient(135deg, #FFD700, #FFA500);
        color: #1a1a2e; border-radius: 20px;
        padding: 4px 12px; font-size: 0.7rem; font-weight: 700; margin-left: 8px;
    }
    .badge-promo {
        background: #6D28D9; color: white; border-radius: 20px;
        padding: 2px 10px; font-size: 0.7rem; font-weight: 600; margin-left: 8px;
    }

    .info-meteo {
        background: #E3F2FD;
        border-left: 4px solid #2196F3;
        padding: 0.8rem 1rem;
        border-radius: 10px;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .info-meteo i { font-size: 1.2rem; color: #2196F3; }
    .info-meteo small { color: #555; }

    .alert-fidelite {
        background: linear-gradient(135deg, #1a1a2e, #16213e);
        border-left: 4px solid #FFD700;
        color: white;
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 1.5rem;
    }
    .alert-fidelite i { color: #FFD700; font-size: 1.2rem; margin-right: 10px; }

    /* ===== CODE PROMO ===== */
    .promo-section {
        background: linear-gradient(135deg, #F5F3FF, #EDE9FE);
        border: 1px dashed #7C3AED;
        border-radius: 14px;
        padding: 1rem 1.2rem;
        margin: 1.2rem 0 1.5rem;
    }

    .promo-section-title {
        font-size: 0.82rem;
        font-weight: 700;
        color: #5B21B6;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.6rem;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .promo-input-row {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .promo-input-row input {
        flex: 1;
        padding: 9px 12px;
        border: 1.5px solid #C4B5FD;
        border-radius: 10px;
        font-size: 0.9rem;
        font-family: 'Montserrat', sans-serif;
        text-transform: uppercase;
        letter-spacing: 1px;
        background: white;
        box-sizing: border-box;
    }

    .promo-input-row input:focus {
        outline: none;
        border-color: #7C3AED;
        box-shadow: 0 0 0 3px rgba(124,58,237,0.1);
    }

    .btn-verifier-promo {
        background: #7C3AED;
        color: white;
        border: none;
        padding: 9px 16px;
        border-radius: 10px;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        transition: background 0.2s;
        flex-shrink: 0;
    }

    .btn-verifier-promo:hover { background: #5B21B6; }

    .promo-feedback {
        margin-top: 0.5rem;
        font-size: 0.82rem;
        font-weight: 600;
        min-height: 1.2rem;
    }

    .promo-feedback.success { color: #047857; }
    .promo-feedback.error   { color: #DC2626; }
    /* ====================== */

    .field-row {
        display: flex;
        align-items: flex-start;
        gap: 2rem;
        padding: 1.1rem 0;
        border-bottom: 1px solid #F0EBE3;
    }

    .field-label {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 180px;
        padding-top: 12px;
        font-weight: 600;
        font-size: 1rem;
        color: #264653;
        flex-shrink: 0;
    }

    .field-label i { color: #264653; font-size: 1rem; width: 18px; text-align: center; }
    .field-input-wrap { flex: 1; display: flex; flex-direction: column; }

    .field-input {
        width: 100%;
        padding: 11px 16px;
        border: 1.5px solid #D9D0C7;
        border-radius: 10px;
        font-size: 1rem;
        font-family: 'Montserrat', sans-serif;
        background: #F8F5F0;
        color: #1a1a1a;
        box-sizing: border-box;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .field-input:focus {
        outline: none;
        border-color: #264653;
        background: white;
        box-shadow: 0 0 0 3px rgba(38,70,83,0.08);
    }

    .field-input.is-error {
        border: 2px solid #C0392B !important;
        background: #F8F5F0 !important;
    }

    .field-error {
        color: #C0392B;
        font-size: 0.83rem;
        margin-top: 6px;
        font-weight: 600;
        display: none;
        align-items: center;
        gap: 5px;
    }

    .field-error.visible { display: flex; }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .reservation-actions {
        display: flex;
        justify-content: center;
        gap: 1.5rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 2px solid #F0EBE3;
        flex-wrap: wrap;
    }

    .btn-annuler {
        background: #264653;
        color: white !important;
        border: none;
        padding: 13px 40px;
        border-radius: 30px;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-annuler:hover { background: #1a3340; color: white !important; text-decoration: none; }

    .btn-confirmer {
        background: #C0392B !important;
        color: white !important;
        border: none;
        padding: 13px 40px;
        border-radius: 50px !important;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        display: inline-flex !important;
        align-items: center;
        gap: 8px;
    }

    .btn-confirmer:hover { background: #a93226 !important; color: white !important; }

    .error-messages {
        background: #FEF2F2;
        border-left: 4px solid #EF4444;
        padding: 12px 16px;
        margin-bottom: 1rem;
        border-radius: 8px;
    }

    .error-messages ul {
        margin: 0;
        padding-left: 1.5rem;
        color: #EF4444;
    }

    @media (max-width: 640px) {
        .reservation-body { padding: 1.5rem; }
        .reservation-header { padding: 1.5rem; }
        .field-row { flex-direction: column; gap: 0.5rem; }
        .field-label { min-width: unset; padding-top: 0; }
        .form-row { grid-template-columns: 1fr; }
        .prix-detail { padding: 1rem; }
        .reservation-actions { flex-direction: column; align-items: center; }
        .btn-annuler, .btn-confirmer { width: 100%; justify-content: center; }
        .currency-selector { text-align: center; }
        .promo-input-row { flex-direction: column; }
        .btn-verifier-promo { width: 100%; }
    }
</style>
{% endblock %}

{% block body %}
<div class="reservation-page">
    <div class="container">

        <div class="reservation-card">

            <div class="reservation-header">
                <h2>Réservation - Chambre n°{{ chambre.num }}</h2>
                <div class="reservation-header-meta">
                    <span><i class="fas fa-hotel"></i> {{ chambre.hotel_nom }}</span>
                    <span><i class="fas fa-map-marker-alt"></i> {{ chambre.hotel_ville }}</span>
                    <span><i class="fas fa-bed"></i> {{ chambre.type }} - {{ chambre.capacite_max }} personnes</span>
                </div>
            </div>

            <div class="reservation-body">

                {# Sélecteur de devise #}
                <div class="currency-selector">
                    <label><i class="fas fa-money-bill-wave"></i> Devise :</label>
                    <select id="currencySelect">
                        {% for code, name in currencies %}
                            <option value="{{ code }}" {% if code == selected_currency %}selected{% endif %}>
                                {{ name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                {# Réduction fidélité #}
                {% if reduction_fidelite is defined and reduction_fidelite > 0 %}
                <div class="alert-fidelite">
                    <i class="fas fa-crown"></i>
                    <strong>🏆 Réduction fidélité {{ reduction_fidelite }}% !</strong><br>
                    <small>Prix original : {{ prix_original|number_format(2, ',', ' ') }} TND → Prix après réduction : <strong>{{ (prix_original * (1 - reduction_fidelite/100))|number_format(2, ',', ' ') }} TND</strong></small>
                </div>
                {% endif %}

                {# Météo #}
                {% if weather_data is defined and weather_data and weather_data.current %}
                <div class="info-meteo">
                    <i class="fas fa-cloud-sun"></i>
                    <div>
                        <strong>Météo à {{ weather_data.city }} :</strong> {{ weather_data.current.condition }}
                        - {{ weather_data.current.temp_max }}°C
                        {% if weather_data.current.rain %}
                            <span class="badge-remise" style="background:#C0392B;">☔ Pluie prévue -15%</span>
                        {% endif %}
                        <br><small>Prévisions sur 5 jours disponibles</small>
                    </div>
                </div>
                {% endif %}

                {# SECTION PRIX DÉTAILLÉ #}
                <div class="prix-detail">
                    <div class="prix-detail-header">
                        <i class="fas fa-calculator"></i>
                        <h3>Détail du prix</h3>
                    </div>

                    <div class="prix-ligne">
                        <span class="prix-label-detail"><i class="fas fa-tag"></i> Prix de base / nuit</span>
                        <span class="prix-valeur">
                            {{ (chambre.prix_nuit * taux_conversion)|number_format(2, ',', ' ') }} {{ symbole }}
                        </span>
                    </div>

                    {% if chambre.promotion is defined and chambre.promotion > 0 %}
                    <div class="prix-ligne">
                        <span class="prix-label-detail"><i class="fas fa-gift"></i> Promotion hôtel</span>
                        <span class="prix-valeur" style="color: #27AE60;">-{{ chambre.promotion }}%</span>
                    </div>
                    {% endif %}

                    {% if dynamic_price is defined and dynamic_price and dynamic_price.season_percent is defined %}
                        {% if dynamic_price.season_percent > 0 %}
                        <div class="prix-ligne">
                            <span class="prix-label-detail">
                                <i class="fas fa-sun"></i> Haute saison
                                <span class="badge-saison">+{{ dynamic_price.season_percent }}%</span>
                            </span>
                            <span class="prix-valeur" style="color: #E67E22;">
                                +{{ ((dynamic_price.base_price * dynamic_price.season_percent / 100) * taux_conversion)|number_format(2, ',', ' ') }} {{ symbole }}
                            </span>
                        </div>
                        {% elseif dynamic_price.season_percent < 0 %}
                        <div class="prix-ligne">
                            <span class="prix-label-detail">
                                <i class="fas fa-snowflake"></i> Basse saison
                                <span class="badge-saison" style="background:#27AE60;">{{ dynamic_price.season_percent }}%</span>
                            </span>
                            <span class="prix-valeur" style="color: #27AE60;">
                                {{ ((dynamic_price.base_price * dynamic_price.season_percent / 100) * taux_conversion)|number_format(2, ',', ' ') }} {{ symbole }}
                            </span>
                        </div>
                        {% endif %}
                    {% endif %}

                    {% if weather_data is defined and weather_data and weather_data.current and weather_data.current.rain %}
                    <div class="prix-ligne">
                        <span class="prix-label-detail">
                            <i class="fas fa-cloud-rain"></i> Remise météo (pluie)
                            <span class="badge-remise">-15%</span>
                        </span>
                        <span class="prix-valeur" style="color: #27AE60;">-15%</span>
                    </div>
                    {% endif %}

                    {% if reduction_fidelite is defined and reduction_fidelite > 0 %}
                    <div class="prix-ligne">
                        <span class="prix-label-detail">
                            <i class="fas fa-crown"></i> Réduction fidélité
                            <span class="badge-fidelite">-{{ reduction_fidelite }}%</span>
                        </span>
                        <span class="prix-valeur" style="color: #27AE60;">-{{ reduction_fidelite }}%</span>
                    </div>
                    {% endif %}

                    {# Ligne code promo (affichée dynamiquement via JS) #}
                    <div class="prix-ligne" id="ch-promo-ligne" style="display:none;">
                        <span class="prix-label-detail">
                            <i class="fas fa-ticket-alt"></i> Code promo
                            <span class="badge-promo" id="ch-promo-badge">-0%</span>
                        </span>
                        <span class="prix-valeur" style="color: #27AE60;" id="ch-promo-valeur">-0%</span>
                    </div>

                    <div class="prix-ligne" style="background: #F0EBE3; margin: 0.5rem 0; padding: 0.8rem; border-radius: 10px;">
                        <span class="prix-label-detail" style="font-weight: 800;">
                            <i class="fas fa-star"></i> Prix par nuit (après ajustements)
                        </span>
                        <span class="prix-valeur" style="font-size: 1.3rem; color: #C0392B;" id="prixParNuitConverti">
                            {{ prix_converti|number_format(2, ',', ' ') }} {{ symbole }}
                        </span>
                    </div>

                    <div class="prix-ligne">
                        <span class="prix-label-detail"><i class="fas fa-moon"></i> Nombre de nuits</span>
                        <span class="prix-valeur" id="nbNuitsAffichage">-</span>
                    </div>

                    <div class="prix-ligne-total">
                        <span style="font-size: 1.2rem; font-weight: 700;">
                            <i class="fas fa-check-circle"></i> TOTAL À PAYER
                        </span>
                        <span style="font-size: 1.5rem; font-weight: 800;" id="prixTotalAffichage">
                            {{ prix_converti|number_format(2, ',', ' ') }} {{ symbole }}
                        </span>
                    </div>
                </div>

                {# Affichage des erreurs Symfony #}
                {% if errors is defined and errors|length > 0 %}
                    <div class="error-messages">
                        <ul>
                            {% for error in errors %}
                                <li>{{ error }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                <form method="POST" action="{{ path('app_reservation_ch_new', {'idCh': chambre.idCh}) }}" id="reservationForm">

                    <div class="form-row">
                        <div class="field-row">
                            <div class="field-label"><i class="fas fa-user"></i> Nom :</div>
                            <div class="field-input-wrap">
                                <input type="text" name="nom" id="field-nom" class="field-input" placeholder="Votre nom" value="{{ old.nom ?? '' }}" required>
                                <div class="field-error" id="error-nom"><i class="fas fa-exclamation-circle"></i><span></span></div>
                            </div>
                        </div>

                        <div class="field-row">
                            <div class="field-label"><i class="fas fa-user"></i> Prénom :</div>
                            <div class="field-input-wrap">
                                <input type="text" name="prenom" id="field-prenom" class="field-input" placeholder="Votre prénom" value="{{ old.prenom ?? '' }}" required>
                                <div class="field-error" id="error-prenom"><i class="fas fa-exclamation-circle"></i><span></span></div>
                            </div>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="field-row">
                            <div class="field-label"><i class="fas fa-envelope"></i> Email :</div>
                            <div class="field-input-wrap">
                                <input type="text" name="email" id="field-email" class="field-input" placeholder="exemple@email.com" value="{{ old.email ?? '' }}" required>
                                <div class="field-error" id="error-email"><i class="fas fa-exclamation-circle"></i><span></span></div>
                            </div>
                        </div>

                        <div class="field-row">
                            <div class="field-label"><i class="fas fa-phone"></i> Téléphone :</div>
                            <div class="field-input-wrap">
                                <input type="text" name="telephone" id="field-telephone" class="field-input" placeholder="Ex: 12345678" value="{{ old.telephone ?? '' }}" required>
                                <div class="field-error" id="error-telephone"><i class="fas fa-exclamation-circle"></i><span></span></div>
                            </div>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="field-row">
                            <div class="field-label"><i class="fas fa-calendar"></i> Date début :</div>
                            <div class="field-input-wrap">
                                <input type="date" name="dateDebut" id="dateDebut" class="field-input" value="{{ old.dateDebut ?? default_checkin ?? '' }}" required>
                                <div class="field-error" id="error-dateDebut"><i class="fas fa-exclamation-circle"></i><span></span></div>
                            </div>
                        </div>

                        <div class="field-row">
                            <div class="field-label"><i class="fas fa-calendar"></i> Date fin :</div>
                            <div class="field-input-wrap">
                                <input type="date" name="dateFin" id="dateFin" class="field-input" value="{{ old.dateFin ?? default_checkout ?? '' }}" required>
                                <div class="field-error" id="error-dateFin"><i class="fas fa-exclamation-circle"></i><span></span></div>
                            </div>
                        </div>
                    </div>

                    <div class="field-row">
                        <div class="field-label"><i class="fas fa-users"></i> Nombre de personnes :</div>
                        <div class="field-input-wrap">
                            <input type="number" name="nbPersonnes" id="field-nbPersonnes" class="field-input" placeholder="Ex: 2" value="{{ old.nbPersonnes ?? '1' }}" min="1" max="{{ chambre.capacite_max }}" required>
                            <div class="field-error" id="error-nbPersonnes"><i class="fas fa-exclamation-circle"></i><span></span></div>
                            <small style="color: #6c757d; font-size: 0.7rem;">Capacité maximale : {{ chambre.capacite_max }} personnes</small>
                        </div>
                    </div>

                    {# ===== SECTION CODE PROMO ===== #}
                    <div class="promo-section">
                        <div class="promo-section-title">
                            <i class="fas fa-ticket-alt"></i> Code promo (facultatif)
                        </div>
                        <div class="promo-input-row">
                            <input
                                type="text"
                                id="ch-code-promo-input"
                                placeholder="Ex : PROMO20"
                                autocomplete="off"
                                maxlength="30"
                                value="{{ old.code_promo ?? '' }}"
                            >
                            <button type="button" class="btn-verifier-promo" onclick="verifierPromo()">
                                Vérifier
                            </button>
                        </div>
                        <div class="promo-feedback" id="ch-promo-feedback">
                            {% if errors.code_promo is defined %}
                                <span style="color:#DC2626;">❌ {{ errors.code_promo }}</span>
                            {% endif %}
                        </div>
                        {# Champ caché envoyé au serveur #}
                        <input type="hidden" name="code_promo" id="ch-code-promo-hidden" value="{{ old.code_promo ?? '' }}">
                    </div>
                    {# ============================== #}

                    <input type="hidden" name="idUtilisateur" value="{{ app.user ? app.user.id : 1 }}">

                    <div class="reservation-actions">
                        <a href="{{ path('app_chambre_show', {'idCh': chambre.idCh}) }}" class="btn-annuler">
                            <i class="fas fa-times"></i> Annuler
                        </a>
                        <button type="submit" class="btn-confirmer" id="btnConfirmer">
                            <i class="fas fa-check"></i> Confirmer la réservation
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

<script>
    const tauxConversion = {{ taux_conversion|default(1) }};
    const symboleDevise  = "{{ symbole|default('TND') }}";
    // Prix par nuit converti (déjà avec fidélité)
    const prixParNuit = {{ prix_converti|replace({',': '.'})|default(0) }};

    let reductionPromo = 0; // pourcentage 0–100

    const dateDebutEl  = document.getElementById('dateDebut');
    const dateFinEl    = document.getElementById('dateFin');
    const nbNuitsSpan  = document.getElementById('nbNuitsAffichage');
    const prixTotalSpan= document.getElementById('prixTotalAffichage');
    const promoInput   = document.getElementById('ch-code-promo-input');
    const promoHidden  = document.getElementById('ch-code-promo-hidden');
    const promoFeedback= document.getElementById('ch-promo-feedback');
    const promoLigne   = document.getElementById('ch-promo-ligne');
    const promoBadge   = document.getElementById('ch-promo-badge');
    const promoValeur  = document.getElementById('ch-promo-valeur');

    function getNbNuits() {
        if (dateDebutEl && dateFinEl && dateDebutEl.value && dateFinEl.value) {
            const debut = new Date(dateDebutEl.value);
            const fin   = new Date(dateFinEl.value);
            if (fin > debut) {
                return Math.ceil(Math.abs(fin - debut) / (1000 * 60 * 60 * 24));
            }
        }
        return 0;
    }

    function calculerTotal() {
        const nbNuits = getNbNuits();
        if (nbNuitsSpan) {
            nbNuitsSpan.textContent = nbNuits > 0 ? nbNuits + ' nuit(s)' : '-';
        }

        const sousTotal = prixParNuit * nbNuits;
        const total     = sousTotal * (1 - reductionPromo / 100);

        if (prixTotalSpan) {
            if (nbNuits > 0) {
                prixTotalSpan.textContent = total.toFixed(2).replace('.', ',') + ' ' + symboleDevise;
            } else {
                prixTotalSpan.textContent = '0,00 ' + symboleDevise;
            }
        }

        return { sousTotal, total, nbNuits };
    }

    function verifierPromo() {
        const code    = promoInput ? promoInput.value.trim().toUpperCase() : '';
        const nbNuits = getNbNuits();
        const sousTotal = prixParNuit * nbNuits;

        if (!code) {
            promoFeedback.className = 'promo-feedback error';
            promoFeedback.textContent = '⚠️ Veuillez saisir un code promo.';
            return;
        }

        promoFeedback.className = 'promo-feedback';
        promoFeedback.textContent = '⏳ Vérification…';

        fetch('{{ path('api_verifier_code_promo') }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ code: code, prix_base: sousTotal })
        })
        .then(r => r.json())
        .then(data => {
            if (data.valid) {
                reductionPromo = data.reduction;
                promoHidden.value = code;

                // Afficher la ligne promo dans le tableau
                if (promoLigne) promoLigne.style.display = 'flex';
                if (promoBadge) promoBadge.textContent = '-' + data.reduction + '%';
                if (promoValeur) promoValeur.textContent = '-' + data.reduction + '%';

                promoFeedback.className  = 'promo-feedback success';
                promoFeedback.textContent = data.message;
                calculerTotal();
            } else {
                reductionPromo = 0;
                promoHidden.value = '';
                if (promoLigne) promoLigne.style.display = 'none';

                promoFeedback.className  = 'promo-feedback error';
                promoFeedback.textContent = '❌ ' + data.message;
                calculerTotal();
            }
        })
        .catch(() => {
            promoFeedback.className  = 'promo-feedback error';
            promoFeedback.textContent = '❌ Erreur réseau. Réessayez.';
        });
    }

    // Événements
    if (dateDebutEl && dateFinEl) {
        dateDebutEl.addEventListener('change', calculerTotal);
        dateFinEl.addEventListener('change', calculerTotal);
        calculerTotal();

        // Contraintes de dates
        const today = new Date();
        const pad   = n => n.toString().padStart(2, '0');
        const toYMD = d => `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
        dateDebutEl.min = toYMD(today);
        const max = new Date(); max.setFullYear(max.getFullYear()+1);
        dateDebutEl.max = toYMD(max);
        dateFinEl.max   = toYMD(max);

        const syncDateFinMin = () => {
            if (!dateDebutEl.value) { dateFinEl.min = dateDebutEl.min; return; }
            const d = new Date(dateDebutEl.value);
            const minFin = new Date(d);
            minFin.setDate(minFin.getDate() + 1);
            dateFinEl.min = toYMD(minFin);
            if (dateFinEl.value && dateFinEl.value < dateFinEl.min) {
                dateFinEl.value = dateFinEl.min;
            }
            calculerTotal();
        };
        syncDateFinMin();
        dateDebutEl.addEventListener('change', syncDateFinMin);
    }

    if (promoInput) {
        promoInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') { e.preventDefault(); verifierPromo(); }
        });

        promoInput.addEventListener('input', function() {
            if (this.value.trim() === '') {
                reductionPromo = 0;
                promoHidden.value = '';
                if (promoLigne) promoLigne.style.display = 'none';
                promoFeedback.className  = 'promo-feedback';
                promoFeedback.textContent = '';
                calculerTotal();
            }
        });
    }

    // Changement de devise
    const currencySelect = document.getElementById('currencySelect');
    if (currencySelect) {
        currencySelect.addEventListener('change', function() {
            fetch('/change-currency-ch', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({currency: this.value})
            })
            .then(() => window.location.reload());
        });
    }

    // Affichage des erreurs par champ
    {% if errors is defined and errors is not empty %}
        const errorMessages = {{ errors|json_encode|raw }};
        const fields = ['nom', 'prenom', 'email', 'telephone', 'dateDebut', 'dateFin', 'nbPersonnes'];
        fields.forEach(function(field) {
            if (errorMessages[field]) {
                const input    = document.getElementById('field-' + field);
                const errorDiv = document.getElementById('error-' + field);
                if (input && errorDiv) {
                    input.classList.add('is-error');
                    errorDiv.querySelector('span').textContent = errorMessages[field];
                    errorDiv.classList.add('visible');
                }
            }
        });
    {% endif %}
</script>
{% endblock %}
