{% extends 'base.html.twig' %}

{% block title %}Chambre n°{{ chambre.num }} - {{ chambre.hotel_nom }}{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --tunisia-red: #E31B23;
        --tunisia-orange: #FF6B35;
        --tunisia-blue: #0054A6;
        --dark-gray: #2C3E50;
    }
    
    .back-arrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--tunisia-red);
        text-decoration: none;
        font-weight: 500;
        margin-bottom: 2rem;
        transition: all 0.3s ease;
    }
    .back-arrow:hover { transform: translateX(-5px); color: var(--tunisia-orange); }

    .chambre-container {
        display: flex;
        gap: 2rem;
        background: white;
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid #F0E8DD;
    }

    .chambre-image { flex: 1; min-width: 0; background: #FEF9F0; min-height: 400px; display: flex; align-items: center; justify-content: center; }
    .chambre-image img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .chambre-image-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #E8DFD1; font-size: 3rem; background: #FEF9F0; }
    .chambre-info { flex: 1; padding: 2rem; }
    .chambre-title { font-family: 'Cormorant Garamond', serif; font-size: 2rem; font-weight: 700; color: var(--tunisia-red); margin-bottom: 1rem; }
    .chambre-meta { display: flex; flex-wrap: wrap; gap: 1.5rem; margin: 1.5rem 0; padding: 1rem 0; border-top: 1px solid #F0E8DD; border-bottom: 1px solid #F0E8DD; }
    .meta-item { display: flex; align-items: center; gap: 8px; color: #6c757d; font-size: 0.9rem; }
    .meta-item i { color: var(--tunisia-red); width: 20px; }
    .chambre-description { color: #4A3B2F; line-height: 1.8; margin: 1.5rem 0; }
    .chambre-price { font-size: 1.8rem; font-weight: 800; color: var(--tunisia-red); margin: 1rem 0; }
    .chambre-price small { font-size: 0.9rem; font-weight: 400; color: #6c757d; }
    
    .hotel-stars { margin-bottom: 1rem; }
    .hotel-stars i { color: #FFD700; font-size: 1rem; margin-right: 2px; }
    .hotel-stars i.far { color: #ddd; }

    .currency-selector {
        background: #FEF9F0;
        padding: 10px 15px;
        border-radius: 40px;
        display: inline-block;
        border: 1px solid #F0E8DD;
        margin-bottom: 15px;
    }
    
    .currency-selector label {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--dark-gray);
        margin-right: 8px;
    }
    
    .currency-selector select {
        background: white;
        border: 1px solid #E8DFD1;
        border-radius: 30px;
        padding: 6px 15px;
        font-size: 0.85rem;
        color: var(--dark-gray);
        cursor: pointer;
        transition: all 0.2s;
    }
    
    .currency-selector select:hover {
        border-color: var(--tunisia-red);
    }

    .btn-reserve {
        background: linear-gradient(135deg, var(--tunisia-red), var(--tunisia-orange));
        color: white;
        border: none;
        padding: 14px 35px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 1.5rem;
        display: inline-block;
        text-decoration: none;
        box-shadow: 0 4px 15px rgba(227,27,35,0.3);
    }
    .btn-reserve:hover { 
        background: linear-gradient(135deg, #C41E3A, #E55B2B);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(227,27,35,0.4);
        color: white;
    }

    @media (max-width: 768px) {
        .chambre-container { flex-direction: column; }
        .chambre-image { min-height: 300px; }
        .chambre-info { padding: 1.5rem; }
        .chambre-title { font-size: 1.5rem; }
        .chambre-price { font-size: 1.3rem; }
        .currency-selector { display: block; text-align: center; }
    }
</style>
{% endblock %}

{% block body %}
<div class="container py-5">
    <a href="{{ path('app_hotel_chambres', {'idH': chambre.idH}) }}" class="back-arrow">
        <i class="fas fa-arrow-left"></i> Retour aux chambres
    </a>

    <div class="chambre-container">
        <div class="chambre-image">
            {% if chambre.image and chambre.image != 'NULL' and chambre.image != '' %}
                <img src="{{ asset('uploads/chambres/' ~ chambre.image|replace({' ': '%20'})) }}" alt="Chambre n°{{ chambre.num }}">
            {% else %}
                <div class="chambre-image-placeholder"><i class="fas fa-bed"></i></div>
            {% endif %}
        </div>

        <div class="chambre-info">
            <h1 class="chambre-title" id="chambre-type">Chambre n°{{ chambre.num }} - {{ chambre.type }}</h1>
            
            <div class="hotel-stars">
                {% for i in 1..chambre.hotel_etoiles %}
                    <i class="fas fa-star"></i>
                {% endfor %}
                {% for i in chambre.hotel_etoiles+1..5 %}
                    <i class="far fa-star"></i>
                {% endfor %}
                <span class="ms-2 text-muted" id="hotel-nom">{{ chambre.hotel_nom }}</span>
            </div>
            
            <div class="currency-selector">
                <label><i class="fas fa-money-bill-wave"></i> Devise :</label>
                <select id="currencySelect">
                    {% for code, name in currencies %}
                        <option value="{{ code }}" {% if code == selected_currency %}selected{% endif %}>
                            {{ name }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="chambre-price">
                <span class="price-value">{{ prix_converti|number_format(2, ',', ' ') }}</span>
                <span class="price-symbol">{{ symbole }}</span>
                <small>/nuit</small>
                {% if chambre.promotion is defined and chambre.promotion > 0 %}
                    <br><small class="text-success">🔥 Promotion -{{ chambre.promotion }}%</small>
                {% endif %}
            </div>
            
            <div class="chambre-meta">
                <div class="meta-item"><i class="fas fa-bed"></i> <span>Type : {{ chambre.type }}</span></div>
                <div class="meta-item"><i class="fas fa-users"></i> <span>Capacité : {{ chambre.capacite_max }} personnes</span></div>
                <div class="meta-item"><i class="fas fa-hotel"></i> <span>Hôtel : <span id="hotel-nom-meta">{{ chambre.hotel_nom }}</span></span></div>
                <div class="meta-item"><i class="fas fa-map-marker-alt"></i> <span id="hotel-ville">{{ chambre.hotel_ville }}</span></div>
                {% if chambre.status == 'disponible' %}
                    <div class="meta-item text-success"><i class="fas fa-check-circle"></i> <span>Disponible</span></div>
                {% else %}
                    <div class="meta-item text-danger"><i class="fas fa-times-circle"></i> <span>Indisponible</span></div>
                {% endif %}
            </div>
            
            <div class="chambre-description" id="chambre-description">
                {{ chambre.description }}
            </div>
            
            <a href="{{ path('app_reservation_ch_new', {'idCh': chambre.idCh}) }}" class="btn-reserve">
                <i class="fas fa-calendar-check"></i> Réserver cette chambre
            </a>
        </div>
    </div>
</div>

<script>
    const currencySelect = document.getElementById('currencySelect');
    if (currencySelect) {
        currencySelect.addEventListener('change', function() {
            fetch('/change-currency-ch', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({currency: this.value})
            })
            .then(response => response.json())
            .then(() => window.location.reload());
        });
    }
</script>
{% endblock %}