{% extends 'base.html.twig' %}

{% block title %}Réservation - {{ activite.Titre }}{% endblock %}

{% block stylesheets %}
<style>
    .reservation-page {
        min-height: 80vh;
        padding: 3rem 0 5rem;
    }

    .reservation-card {
        background: white;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 8px 40px rgba(38,70,83,0.10);
        max-width: 860px;
        margin: 0 auto;
    }

    .reservation-header {
        background: #264653;
        padding: 2rem 2.5rem;
        border-radius: 24px 24px 0 0;
    }

    .reservation-header h2 {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.5rem;
        font-weight: 700;
        color: white;
        margin: 0 0 0.6rem 0;
    }

    .reservation-header-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 1.2rem;
        margin-top: 0.5rem;
    }

    .reservation-header-meta span {
        color: rgba(255,255,255,0.85);
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .reservation-header-meta i { color: #F5A623; font-size: 0.9rem; }

    .reservation-body { padding: 2.5rem 2.5rem 3rem; }

    .field-row {
        display: flex;
        align-items: flex-start;
        gap: 2rem;
        padding: 1.1rem 0;
        border-bottom: 1px solid #F0EBE3;
    }

    .field-label {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 180px;
        padding-top: 12px;
        font-weight: 600;
        font-size: 1rem;
        color: #264653;
        flex-shrink: 0;
    }

    .field-label i { color: #264653; font-size: 1rem; width: 18px; text-align: center; }

    .field-input-wrap { flex: 1; display: flex; flex-direction: column; }

    .field-input {
        width: 100%;
        padding: 11px 16px;
        border: 1.5px solid #D9D0C7;
        border-radius: 10px;
        font-size: 1rem;
        font-family: 'Montserrat', sans-serif;
        background: #F8F5F0;
        color: #1a1a1a;
        box-sizing: border-box;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .field-input:focus {
        outline: none;
        border-color: #264653;
        background: white;
        box-shadow: 0 0 0 3px rgba(38,70,83,0.08);
    }

    .field-input.is-error {
        border: 2px solid #C0392B !important;
        background: #F8F5F0 !important;
    }

    .field-error {
        color: #C0392B;
        font-size: 0.83rem;
        margin-top: 6px;
        font-weight: 600;
        display: none;
        align-items: center;
        gap: 5px;
    }

    .field-error.visible { display: flex; }

    .promo-input-row {
        display: flex;
        gap: 0.6rem;
        align-items: center;
    }

    .promo-input-row .field-input { flex: 1; }

    .btn-verifier-promo {
        background: #264653;
        color: white;
        border: none;
        padding: 11px 20px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.88rem;
        cursor: pointer;
        white-space: nowrap;
        font-family: 'Montserrat', sans-serif;
        transition: background 0.2s;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .btn-verifier-promo:hover { background: #1a3340; }
    .btn-verifier-promo:disabled { opacity: 0.6; cursor: not-allowed; }

    .promo-status {
        font-size: 0.85rem;
        font-weight: 700;
        margin-top: 7px;
        display: none;
        align-items: center;
        gap: 6px;
    }

    .promo-status.visible { display: flex; }
    .promo-status.valide  { color: #27AE60; }
    .promo-status.invalide { color: #C0392B; }

    /* ── Section prix ── */
    .prix-section {
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 2px solid #F0EBE3;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .prix-row { display: flex; align-items: flex-start; gap: 2rem; padding: 0.3rem 0; }

    .prix-label {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 180px;
        font-weight: 600;
        font-size: 1rem;
        color: #264653;
        flex-shrink: 0;
        padding-top: 2px;
    }

    .prix-label i { color: #264653; font-size: 1rem; width: 18px; text-align: center; }

    .prix-value { font-size: 1.15rem; font-weight: 700; color: #C0392B; }
    .prix-value.neutral { color: #264653; font-size: 1rem; font-weight: 600; }

    .prix-row-reduction { display: none; }
    .prix-row-reduction.visible { display: flex; }
    .prix-reduction-value { font-size: 1rem; font-weight: 700; color: #27AE60; }

    /* ── Total avec conversion ── */
    .total-value-wrap {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .total-tnd {
        font-size: 1.15rem;
        font-weight: 700;
        color: #C0392B;
    }

    /* Dropdown + résultat */
    .total-devise-row {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .devise-select-resa {
        border: 1.5px solid #D0C8BE;
        border-radius: 8px;
        padding: 5px 10px;
        font-size: 0.88rem;
        color: #264653;
        background: white;
        cursor: pointer;
        font-family: inherit;
        font-weight: 600;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
        min-width: 130px;
    }

    .devise-select-resa:focus {
        border-color: #264653;
        box-shadow: 0 0 0 3px rgba(38,70,83,0.08);
    }

    .total-converti-inline {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .total-conv-label {
        font-size: 0.88rem;
        color: #7D7D7D;
        font-weight: 500;
        display: none;
    }

    .total-conv-val {
        font-size: 1rem;
        font-weight: 700;
        color: #C0392B;
        display: none;
    }

    .total-conv-loading {
        font-size: 0.82rem;
        color: #bbb;
        display: none;
        align-items: center;
        gap: 5px;
    }

    .total-conv-taux {
        font-size: 0.95rem;
        color: #5e5c5c;
        display: none;
        font-weight: 500;
    }

    .spin-xs {
        width: 11px; height: 11px;
        border: 2px solid #ddd;
        border-top-color: #C0392B;
        border-radius: 50%;
        animation: spinXsR 0.7s linear infinite;
        display: inline-block;
        flex-shrink: 0;
    }
    @keyframes spinXsR { to { transform: rotate(360deg); } }

    .reservation-actions {
        display: flex;
        justify-content: center;
        gap: 1.5rem;
        margin-top: 2.5rem;
        padding-top: 1.5rem;
        border-top: 2px solid #F0EBE3;
        flex-wrap: wrap;
    }

    .btn-annuler {
        background: #264653;
        color: white !important;
        border: none;
        padding: 13px 40px;
        border-radius: 30px;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-annuler:hover { background: #1a3340; color: white !important; text-decoration: none; }

    .btn-confirmer {
        background: #C0392B !important;
        color: white !important;
        border: none;
        padding: 13px 40px;
        border-radius: 50px !important;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        display: inline-flex !important;
        align-items: center;
        gap: 8px;
        -webkit-text-fill-color: white !important;
    }

    .btn-confirmer:hover {
        background: #a93226 !important;
        color: white !important;
        -webkit-text-fill-color: white !important;
    }

    .btn-confirmer:disabled { opacity: 0.7; cursor: not-allowed; }

    .flash-success {
        background: #F0FFF4;
        border: 1px solid #6EE7B7;
        color: #065F46;
        padding: 12px 18px;
        border-radius: 10px;
        margin-bottom: 1.5rem;
        font-weight: 500;
        display: none;
    }

    .api-warning {
        background: #FFF3CD;
        border: 1px solid #FFEAA7;
        border-radius: 8px;
        padding: 6px 10px;
        font-size: 0.75rem;
        color: #856404;
    }

    @media (max-width: 640px) {
        .reservation-body   { padding: 1.5rem; }
        .reservation-header { padding: 1.5rem; border-radius: 18px 18px 0 0; }
        .field-row          { flex-direction: column; gap: 0.5rem; }
        .field-label        { min-width: unset; padding-top: 0; }
        .prix-row           { flex-direction: column; gap: 0.3rem; }
        .prix-label         { min-width: unset; }
        .reservation-actions { flex-direction: column; align-items: center; }
        .btn-annuler, .btn-confirmer { width: 100%; justify-content: center; }
        .promo-input-row { flex-direction: column; }
        .btn-verifier-promo { width: 100%; justify-content: center; }
        .total-devise-row { flex-direction: column; align-items: flex-start; }
    }
</style>
{% endblock %}

{% block body %}
<div class="reservation-page">
    <div class="container">

        <div class="flash-success" id="flashSuccess">
            <i class="fas fa-check-circle me-2"></i>
            <span id="flashSuccessText"></span>
        </div>

        <div class="reservation-card" id="reservationCard">

            <div class="reservation-header">
                <h2>Activité : {{ activite.Titre }}</h2>
                <div class="reservation-header-meta">
                    <span><i class="fas fa-clock"></i> {{ activite.HeureDebut }} ({{ activite.Duree }})</span>
                    <span><i class="fas fa-users"></i> {{ placesDisponibles }} place(s) disponible(s)</span>
                </div>
            </div>

            <div class="reservation-body">

                <form id="reservationForm"
                      method="POST"
                      action="{{ path('app_reservationact_new', {'IDAct': activite.IDAct}) }}"
                      novalidate
                      autocomplete="off">

                    <div class="field-row">
                        <div class="field-label"><i class="fas fa-user"></i> Nom :</div>
                        <div class="field-input-wrap">
                            <input type="text" name="nom" id="field-nom" class="field-input" placeholder="Votre nom" autocomplete="off">
                            <div class="field-error" id="error-nom"><i class="fas fa-exclamation-circle"></i><span></span></div>
                        </div>
                    </div>

                    <div class="field-row">
                        <div class="field-label"><i class="fas fa-user"></i> Prénom :</div>
                        <div class="field-input-wrap">
                            <input type="text" name="prenom" id="field-prenom" class="field-input" placeholder="Votre prénom" autocomplete="off">
                            <div class="field-error" id="error-prenom"><i class="fas fa-exclamation-circle"></i><span></span></div>
                        </div>
                    </div>

                    <div class="field-row">
                        <div class="field-label"><i class="fas fa-phone"></i> Téléphone :</div>
                        <div class="field-input-wrap">
                            <input type="text" name="telephone" id="field-telephone" class="field-input" placeholder="8 chiffres (ex: 71234567)" autocomplete="off" maxlength="8">
                            <div class="field-error" id="error-telephone"><i class="fas fa-exclamation-circle"></i><span></span></div>
                        </div>
                    </div>

                    <div class="field-row">
                        <div class="field-label"><i class="fas fa-envelope"></i> Email :</div>
                        <div class="field-input-wrap">
                            <input type="text" name="email" id="field-email" class="field-input" placeholder="exemple@domaine.com" autocomplete="off">
                            <div class="field-error" id="error-email"><i class="fas fa-exclamation-circle"></i><span></span></div>
                        </div>
                    </div>

                    <div class="field-row">
                        <div class="field-label"><i class="fas fa-users"></i> Personnes :</div>
                        <div class="field-input-wrap">
                            <input type="text" name="nombrePlaces" id="field-nombrePlaces" class="field-input" placeholder="Ex: 2" autocomplete="off">
                            <div class="field-error" id="error-nombrePlaces"><i class="fas fa-exclamation-circle"></i><span></span></div>
                        </div>
                    </div>

                    <div class="field-row">
                        <div class="field-label"><i class="fas fa-ticket-alt"></i> Code promo :</div>
                        <div class="field-input-wrap">
                            <div class="promo-input-row">
                                <input type="text" name="codePromo" id="field-codePromo" class="field-input"
                                       placeholder="Ex: PROMO20 (optionnel)" autocomplete="off" maxlength="50">
                                <button type="button" class="btn-verifier-promo" id="btnVerifierPromo">
                                    <i class="fas fa-search"></i> Vérifier
                                </button>
                            </div>
                            <div class="promo-status valide" id="promoValide">
                                <i class="fas fa-check-circle"></i>
                                <span id="promoValideText"></span>
                            </div>
                            <div class="promo-status invalide" id="promoInvalide">
                                <i class="fas fa-times-circle"></i>
                                <span id="promoInvalideText"></span>
                            </div>
                        </div>
                    </div>

                    {# SECTION PRIX #}
                    <div class="prix-section">
                        <div class="prix-row">
                            <div class="prix-label"><i class="fas fa-tag"></i> Prix unitaire :</div>
                            <div class="prix-value neutral" id="prixOriginal">
                                {{ activite.Prix|number_format(2, ',', ' ') }} TND / personne
                            </div>
                        </div>
                        <div class="prix-row prix-row-reduction" id="rowReduction">
                            <div class="prix-label"><i class="fas fa-percent"></i> Réduction :</div>
                            <div class="prix-reduction-value" id="prixReduction">-0,00 TND</div>
                        </div>

                        {# ── Total à payer + conversion ── #}
                        <div class="prix-row">
                            <div class="prix-label"><i class="fas fa-coins"></i> Total à payer :</div>
                            <div class="total-value-wrap">
                                <div class="total-devise-row">
                                    <span class="total-tnd" id="prixTotal">0,00 TND</span>
                                    <select class="devise-select-resa" id="devisePickerResa">
                                        <option value="">Devise ▾</option>
                                        <option value="EUR">EUR — €</option>
                                        <option value="USD">USD — $</option>
                                        <option value="GBP">GBP — £</option>
                                        <option value="MAD">MAD</option>
                                        <option value="DZD">DZD</option>
                                        <option value="SAR">SAR</option>
                                        <option value="AED">AED</option>
                                        <option value="JPY">JPY — ¥</option>
                                    </select>
                                </div>
                                <div class="total-converti-inline" id="totalConvertiRow" style="display:none;">
                                    <span class="total-conv-label" id="totalConvLabel">Converti :</span>
                                    <div class="total-conv-loading" id="totalConvLoading">
                                        <span class="spin-xs"></span> ...
                                    </div>
                                    <span class="total-conv-val" id="totalConvVal"></span>
                                </div>
                                <div>
                                    <span class="total-conv-taux" id="totalConvTaux"></span>
                                </div>
                                {% if not exchangeRateApiKey %}
                                <div class="api-warning">
                                    <i class="fas fa-exclamation-triangle"></i> Conversion indisponible (clé API manquante)
                                </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <div class="reservation-actions">
                        <a href="{{ path('app_activite_show', {'IDAct': activite.IDAct}) }}" class="btn-annuler">
                            <i class="fas fa-times"></i> Annuler
                        </a>
                        <button type="submit" class="btn-confirmer" id="btnConfirmer">
                            <i class="fas fa-check"></i> Confirmer la réservation
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

<script>
// ══ CLÉ API (passée depuis le controller) ══
var EXCHANGE_API_KEY = '{{ exchangeRateApiKey }}';

// Taux de fallback
var FALLBACK_RATES = {
    'EUR': 0.30,
    'USD': 0.32,
    'GBP': 0.26,
    'MAD': 3.20,
    'DZD': 43.50,
    'SAR': 1.20,
    'AED': 1.18,
    'JPY': 48.00
};

var SYMBOLES = { EUR:'€', USD:'$', GBP:'£', MAD:'MAD', DZD:'DA', SAR:'SAR', AED:'AED', JPY:'¥' };

(function () {

    var redirectUrl    = "{{ path('app_activite_show', {'IDAct': activite.IDAct}) }}";
    var verifyUrl      = "{{ path('app_reservationact_verify_promo') }}";
    var prixUnit       = {{ activite.Prix }};
    var promoReduction = 0;
    var currentTotal   = 0;
    var rateCache      = {};

    var inputPlaces   = document.getElementById('field-nombrePlaces');
    var inputPromo    = document.getElementById('field-codePromo');
    var prixOrigEl    = document.getElementById('prixOriginal');
    var prixTotalEl   = document.getElementById('prixTotal');
    var prixRedEl     = document.getElementById('prixReduction');
    var rowReduction  = document.getElementById('rowReduction');

    var promoValideDiv    = document.getElementById('promoValide');
    var promoValideText   = document.getElementById('promoValideText');
    var promoInvalideDiv  = document.getElementById('promoInvalide');
    var promoInvalideText = document.getElementById('promoInvalideText');
    var btnVerifier       = document.getElementById('btnVerifierPromo');

    // Éléments conversion
    var devisePickerResa   = document.getElementById('devisePickerResa');
    var totalConvertiRow   = document.getElementById('totalConvertiRow');
    var totalConvLabel     = document.getElementById('totalConvLabel');
    var totalConvLoading   = document.getElementById('totalConvLoading');
    var totalConvVal       = document.getElementById('totalConvVal');
    var totalConvTaux      = document.getElementById('totalConvTaux');

    function fmt(n) { return n.toFixed(2).replace('.', ',') + ' TND'; }

    // ── Mise à jour prix ──
    function updatePrix() {
        var n = parseInt(inputPlaces.value, 10);
        if (!isNaN(n) && n > 0) {
            var total      = prixUnit * n;
            var reduction  = total * (promoReduction / 100);
            var totalFinal = total - reduction;
            currentTotal   = totalFinal;

            prixOrigEl.textContent  = prixUnit.toFixed(2).replace('.', ',') + ' TND × ' + n;
            prixTotalEl.textContent = fmt(totalFinal);

            if (promoReduction > 0) {
                prixRedEl.textContent = '-' + fmt(reduction) + ' (' + promoReduction + '%)';
                rowReduction.classList.add('visible');
            } else {
                rowReduction.classList.remove('visible');
            }
        } else {
            currentTotal = 0;
            prixOrigEl.textContent  = prixUnit.toFixed(2).replace('.', ',') + ' TND / personne';
            prixTotalEl.textContent = '0,00 TND';
            rowReduction.classList.remove('visible');
        }

        // Rafraîchir la conversion si devise sélectionnée
        if (devisePickerResa && devisePickerResa.value) {
            afficherConversionTotal(devisePickerResa.value);
        } else {
            resetConvTotal();
        }
    }

    if (inputPlaces) inputPlaces.addEventListener('input', updatePrix);

    // ── Conversion du total ──
    function resetConvTotal() {
        totalConvertiRow.style.display = 'none';
        totalConvTaux.style.display    = 'none';
    }

    function setLoadingTotal(on) {
        totalConvLoading.style.display = on ? 'flex' : 'none';
        totalConvVal.style.display     = on ? 'none' : 'inline';
        totalConvLabel.style.display   = on ? 'none' : 'inline';
    }

    function afficherConversionTotal(devise) {
        if (!devise || currentTotal <= 0) { resetConvTotal(); return; }

        // Si pas de clé API, utiliser fallback
        if (!EXCHANGE_API_KEY || EXCHANGE_API_KEY === '') {
            var fallbackTaux = FALLBACK_RATES[devise];
            if (fallbackTaux) {
                renderConvTotal(devise, fallbackTaux, true);
            } else {
                totalConvertiRow.style.display = 'flex';
                setLoadingTotal(false);
                totalConvLabel.style.display = 'inline';
                totalConvVal.textContent = 'Taux non disponible';
                totalConvVal.style.color = '#aaa';
            }
            return;
        }

        var now = Date.now();
        if (rateCache[devise] && (now - rateCache[devise].ts) < 600000) {
            renderConvTotal(devise, rateCache[devise].taux, false);
            return;
        }

        totalConvertiRow.style.display = 'flex';
        totalConvTaux.style.display    = 'none';
        setLoadingTotal(true);

        fetch('https://v6.exchangerate-api.com/v6/' + EXCHANGE_API_KEY + '/pair/TND/' + devise)
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.result === 'success') {
                    rateCache[devise] = { taux: data.conversion_rate, ts: Date.now() };
                    renderConvTotal(devise, data.conversion_rate, false);
                } else {
                    var fallbackTaux = FALLBACK_RATES[devise];
                    if (fallbackTaux) {
                        renderConvTotal(devise, fallbackTaux, true);
                    } else {
                        throw new Error('Taux non disponible');
                    }
                }
            })
            .catch(function () {
                var fallbackTaux = FALLBACK_RATES[devise];
                if (fallbackTaux) {
                    renderConvTotal(devise, fallbackTaux, true);
                } else {
                    setLoadingTotal(false);
                    totalConvLabel.style.display = 'inline';
                    totalConvVal.textContent   = 'Taux indisponible';
                    totalConvVal.style.color   = '#aaa';
                    totalConvVal.style.display = 'inline';
                }
            });
    }

    function renderConvTotal(devise, taux, isFallback) {
        var montant  = currentTotal * taux;
        var symbole  = SYMBOLES[devise] || devise;
        var decimals = (devise === 'JPY') ? 0 : 2;
        var fmtMont  = montant.toFixed(decimals).replace('.', ',');
        var prefix = isFallback ? '(approx) ' : '';

        totalConvertiRow.style.display = 'flex';
        setLoadingTotal(false);
        totalConvLabel.style.display = 'inline';
        totalConvVal.textContent     = prefix + fmtMont + ' ' + symbole;
        totalConvVal.style.color     = '#C0392B';

        if (isFallback) {
            totalConvTaux.textContent = 'Taux approximatif (service indisponible)';
        } else {
            totalConvTaux.textContent = '1 TND = ' + taux.toFixed(4) + ' ' + devise;
        }
        totalConvTaux.style.display = 'inline';
    }

    if (devisePickerResa) {
        devisePickerResa.addEventListener('change', function () {
            afficherConversionTotal(this.value);
        });
    }

    // ── Réinitialiser promo ──
    function resetPromoStatus() {
        promoValideDiv.classList.remove('visible');
        promoInvalideDiv.classList.remove('visible');
        promoReduction = 0;
        rowReduction.classList.remove('visible');
        updatePrix();
    }

    if (inputPromo) inputPromo.addEventListener('input', function () { resetPromoStatus(); });

    // ── Vérification code promo ──
    if (btnVerifier) {
        btnVerifier.addEventListener('click', function () {
            var code = inputPromo.value.trim();
            if (!code) { resetPromoStatus(); return; }

            btnVerifier.disabled = true;
            btnVerifier.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

            fetch(verifyUrl + '?code=' + encodeURIComponent(code), {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                btnVerifier.disabled = false;
                btnVerifier.innerHTML = '<i class="fas fa-search"></i> Vérifier';
                promoValideDiv.classList.remove('visible');
                promoInvalideDiv.classList.remove('visible');

                if (data.valide) {
                    promoReduction = data.pourcentage;
                    promoValideText.textContent = 'Code valide — ' + data.pourcentage + '% de réduction !';
                    promoValideDiv.classList.add('visible');
                } else {
                    promoReduction = 0;
                    promoInvalideText.textContent = data.message;
                    promoInvalideDiv.classList.add('visible');
                }
                updatePrix();
            })
            .catch(function () {
                btnVerifier.disabled = false;
                btnVerifier.innerHTML = '<i class="fas fa-search"></i> Vérifier';
            });
        });
    }

    // ── Erreurs champs ──
    var fields = ['nom', 'prenom', 'telephone', 'email', 'nombrePlaces'];

    function setFieldError(name, msg) {
        var input    = document.getElementById('field-' + name);
        var errorDiv = document.getElementById('error-' + name);
        var span     = errorDiv ? errorDiv.querySelector('span') : null;
        if (!input || !errorDiv || !span) return;
        if (msg) {
            input.classList.add('is-error');
            span.textContent = msg;
            errorDiv.classList.add('visible');
        } else {
            input.classList.remove('is-error');
            span.textContent = '';
            errorDiv.classList.remove('visible');
        }
    }

    function clearAllErrors() { fields.forEach(function (n) { setFieldError(n, ''); }); }

    fields.forEach(function (name) {
        var input = document.getElementById('field-' + name);
        if (input) {
            input.addEventListener('input', function () {
                setFieldError(name, '');
                if (name === 'nombrePlaces') updatePrix();
            });
        }
    });

    // ── Soumission AJAX ──
    var form       = document.getElementById('reservationForm');
    var btnConfirm = document.getElementById('btnConfirmer');
    var flashBox   = document.getElementById('flashSuccess');
    var flashText  = document.getElementById('flashSuccessText');

    if (form) {
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            clearAllErrors();
            btnConfirm.disabled = true;
            btnConfirm.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Envoi...';

            var formData = new FormData(form);
            formData.append('promoReduction', promoReduction);

            fetch(form.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: formData
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.success) {
                    flashText.textContent = 'Votre réservation a été enregistrée avec succès !';
                    flashBox.style.display = 'flex';
                    form.reset();
                    resetPromoStatus();
                    updatePrix();
                    if (devisePickerResa) { devisePickerResa.value = ''; resetConvTotal(); }
                    setTimeout(function () { window.location.href = redirectUrl; }, 1500);
                } else {
                    if (data.errors) {
                        Object.keys(data.errors).forEach(function (field) { setFieldError(field, data.errors[field]); });
                    }
                    btnConfirm.disabled = false;
                    btnConfirm.innerHTML = '<i class="fas fa-check"></i> Confirmer la réservation';
                }
            })
            .catch(function () { form.submit(); });
        });
    }

})();
</script>
{% endblock %}