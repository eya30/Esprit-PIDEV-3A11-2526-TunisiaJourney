{% extends 'base.html.twig' %}

{% block title %}Mes Commandes — TunisiaJourney{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --tunisia-red: #E31B23; --tunisia-orange: #FF6B35;
        --tunisia-sand: #FDF5E6; --tunisia-soft: #F5CAC3; --dark-gray: #2C3E50;
    }
    body { background: var(--tunisia-sand); }

    .page-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 2.8rem; font-weight: 700;
        color: var(--tunisia-red); text-align: center;
        margin: 3rem 0 0.5rem;
    }
    .page-subtitle { text-align: center; color: #9CA3AF; font-size: 0.9rem; margin-bottom: 2.5rem; }
    .page-subtitle i { color: var(--tunisia-soft); }

    .commandes-table {
        background: white; border-radius: 24px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.08);
        overflow: hidden;
    }
    .commandes-table table { margin: 0; min-width: 900px; }
    .commandes-table thead th {
        background: linear-gradient(135deg, var(--tunisia-sand), #fff);
        padding: 16px 20px; font-size: 11px; font-weight: 700;
        color: var(--tunisia-red); text-transform: uppercase;
        letter-spacing: 0.5px; border-bottom: 1px solid #F0E8DD;
    }
    .commandes-table td {
        padding: 16px 20px; vertical-align: middle;
        border-bottom: 1px solid #F5F0E8; font-size: 0.88rem;
        color: var(--dark-gray); background: white;
    }
    .commandes-table tr:hover td { background: #FFF9F0; }
    .commandes-table tr:last-child td { border-bottom: none; }

    .articles-cell { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
    .article-chip {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 4px 10px; border-radius: 20px;
        background: var(--tunisia-sand); font-size: 0.78rem; font-weight: 600;
        color: var(--dark-gray); white-space: nowrap;
    }
    .article-chip img {
        width: 26px; height: 26px; border-radius: 6px; object-fit: cover;
    }

    .badge-statut {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 5px 14px; border-radius: 20px;
        font-size: 0.75rem; font-weight: 700; white-space: nowrap;
    }
    .badge-attente  { background: #FEF3C7; color: #92400E; }
    .badge-encours  { background: #DBEAFE; color: #1E40AF; }
    .badge-livree   { background: #D1FAE5; color: #065F46; }
    .badge-annulee  { background: #FEE2E2; color: #991B1B; }

    .action-buttons { display: flex; gap: 8px; align-items: center; }
    .action-btn {
        width: 36px; height: 36px; border-radius: 10px;
        display: inline-flex; align-items: center; justify-content: center;
        transition: all 0.2s; cursor: pointer; border: none;
        background: transparent; font-size: 0.88rem; text-decoration: none;
    }
    .view-btn  { background: #F0FDF4; color: #16A34A; }
    .view-btn:hover  { background: #16A34A; color: white; transform: translateY(-2px); }
    .edit-btn  { background: #EFF6FF; color: #3B82F6; }
    .edit-btn:hover  { background: #3B82F6; color: white; transform: translateY(-2px); }
    .delete-btn { background: #FEF2F2; color: #EF4444; }
    .delete-btn:hover { background: #EF4444; color: white; transform: translateY(-2px); }
    .disabled-btn { background: #F9FAFB; color: #D1D5DB; cursor: not-allowed; }

    .total-cell { font-weight: 800; color: var(--tunisia-red); font-size: 1rem; }

    .btn-boutique {
        background: white; border: 2px solid var(--tunisia-red);
        color: var(--tunisia-red); padding: 10px 24px;
        border-radius: 30px; font-weight: 700; text-decoration: none;
        display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s;
    }
    .btn-boutique:hover { background: var(--tunisia-red); color: white; transform: translateY(-2px); }
    .btn-panier {
        background: var(--dark-gray); color: white;
        padding: 10px 24px; border-radius: 30px; font-weight: 700;
        text-decoration: none; display: inline-flex; align-items: center; gap: 8px;
        transition: all 0.2s;
    }
    .btn-panier:hover { background: var(--tunisia-red); color: white; }

    .empty-state { text-align: center; padding: 5rem 2rem; }
    .empty-state i { font-size: 3.5rem; color: var(--tunisia-soft); margin-bottom: 1rem; }
    .empty-state p { color: #9CA3AF; margin-bottom: 1.5rem; }
</style>
{% endblock %}

{% block body %}
<div class="container py-4">

    <h1 class="page-title">Historique des Commandes</h1>
    <p class="page-subtitle">
        <i class="fas fa-diamond me-1"></i>
        {{ commandes|length }} commande(s) au total
        <i class="fas fa-diamond ms-1"></i>
    </p>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <a href="{{ path('app_produit_index') }}" class="btn-boutique">
            <i class="fas fa-store"></i> Retour à la boutique
        </a>
        <a href="{{ path('app_panier_index') }}" class="btn-panier">
            <i class="fas fa-shopping-cart"></i> Mon panier
        </a>
    </div>

    {% if commandes is empty %}
        <div class="commandes-table">
            <div class="empty-state">
                <i class="fas fa-box-open"></i>
                <p>Vous n'avez pas encore passé de commande.</p>
                <a href="{{ path('app_produit_index') }}" class="btn-boutique">
                    <i class="fas fa-store"></i> Découvrir la boutique
                </a>
            </div>
        </div>
    {% else %}
        <div class="commandes-table overflow-x-auto">
            <table class="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>DATE</th>
                        <th>ARTICLES COMMANDÉS</th>
                        <th>ADRESSE</th>
                        <th>PAIEMENT</th>
                        <th>TOTAL</th>
                        <th>STATUT</th>
                        <th>ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    {% for commande in commandes %}
                        <tr>
                            <td><strong style="color:var(--tunisia-red);">#{{ commande.id }}</strong></td>
                            <td>{{ commande.dateC|date('d/m/Y') }}</td>
                            <td>
                                <div class="articles-cell">
                                    {# ✅ CORRECTION : commande.lignes au lieu de commande.commandeProduits #}
                                    {% for item in commande.lignes %}
                                        <span class="article-chip">
                                            {% if item.produit.image %}
                                                <img src="{{ asset('uploads/produits/' ~ item.produit.image) }}"
                                                     alt="{{ item.produit.titre }}">
                                            {% endif %}
                                            {{ item.produit.titre }} × {{ item.quantite }}
                                            {% if item.taille is defined and item.taille %}
                                                <span style="color:var(--tunisia-orange);">({{ item.taille }})</span>
                                            {% endif %}
                                        </span>
                                    {% endfor %}
                                </div>
                            </td>
                            <td>
                                {{ commande.adresseLiv ?? '—' }}
                                {% if commande.codePostal is defined and commande.codePostal %}
                                    <br><small style="color:#9CA3AF;">{{ commande.codePostal }}</small>
                                {% endif %}
                            </td>
                            <td>
                                <i class="fas fa-credit-card me-1" style="color:var(--tunisia-soft);"></i>
                                {{ commande.modePaiement ?? '—' }}
                            </td>
                            <td class="total-cell">{{ commande.total|number_format(2, ',', ' ') }} TND</td>
                            <td>
                                {% set statutClass = {
                                    'En attente': 'attente',
                                    'En cours':   'encours',
                                    'Livrée':     'livree',
                                    'Annulée':    'annulee'
                                } %}
                                <span class="badge-statut badge-{{ statutClass[commande.statut] ?? 'attente' }}">
                                    {% if commande.statut == 'En attente' %}
                                        <i class="fas fa-clock"></i>
                                    {% elseif commande.statut == 'En cours' %}
                                        <i class="fas fa-truck"></i>
                                    {% elseif commande.statut == 'Livrée' %}
                                        <i class="fas fa-check-circle"></i>
                                    {% else %}
                                        <i class="fas fa-times-circle"></i>
                                    {% endif %}
                                    {{ commande.statut }}
                                </span>
                            </td>
                            <td>
                                <div class="action-buttons">
                                    {# Voir le détail #}
                                    <a href="{{ path('app_commande_show', {id: commande.id}) }}"
                                       class="action-btn view-btn" title="Voir le détail">
                                        <i class="fas fa-eye"></i>
                                    </a>

                                    {# Modifier — seulement si En attente #}
                                    {% if commande.statut == 'En attente' %}
                                        <a href="{{ path('app_commande_edit', {id: commande.id}) }}"
                                           class="action-btn edit-btn" title="Modifier la commande">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    {% else %}
                                        <span class="action-btn disabled-btn" title="Non modifiable">
                                            <i class="fas fa-lock"></i>
                                        </span>
                                    {% endif %}
                                    {% if commande.statut in ['Confirmée', 'En cours', 'Expédiée', 'Livrée'] %}
    <a href="{{ path('app_commande_tracking', {id: commande.id}) }}"
       class="action-btn" style="background:#DBEAFE;color:#1D4ED8;" title="Suivre ma livraison">
        <i class="fas fa-map-marked-alt"></i>
    </a>
{% endif %}

                                    {# Supprimer — seulement si En attente #}
                                    {% if commande.statut == 'En attente' %}
                                        <form method="post"
                                              action="{{ path('app_commande_delete', {id: commande.id}) }}"
                                              onsubmit="return confirm('Supprimer la commande #{{ commande.id }} ?')"
                                              style="display:inline;">
                                            <button type="submit" class="action-btn delete-btn" title="Supprimer">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    {% else %}
                                        <span class="action-btn disabled-btn" title="Non supprimable">
                                            <i class="fas fa-trash-alt"></i>
                                        </span>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

</div>
{% endblock %}