function toggleSpeechRecognition(textareaId){
    var service=window.SpeechRecognitionService; if(!service){ showToast('Reconnaissance vocale non disponible','warn'); return; }
    var pageLang=document.getElementById('pageLangSelect')?document.getElementById('pageLangSelect').value:'fr';
    service.setLanguage(pageLang);
