function switchShareTab(tab){
    shareTabCurrent=tab;
    document.getElementById('shareTabPhoto').classList.toggle('active',tab==='photo');
    document.getElementById('shareTabVideo').classList.toggle('active',tab==='video');
    document.getElementById('shareTabLink').classList.toggle('active',tab==='link');
