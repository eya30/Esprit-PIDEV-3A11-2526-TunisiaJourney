        '<button style="background:none;border:1px solid rgba(59,130,246,.3);color:#3B82F6;border-radius:14px;padding:3px 10px;font-size:.7rem;cursor:pointer;white-space:nowrap;" onclick="translateCommentInline('+commentId+')"><i class="fas fa-language"></i> Traduire</button>';
}

/* ★ FIX : Traduction avec barre visible SEULEMENT après succès ★ */
async function translateCommentInline(commentId) {
    var select = document.getElementById('langSelect-'+commentId);
    var targetLang = select ? select.value : '';
    if (!targetLang) { showToast('⚠️ Choisissez une langue','warn'); return; }
    var bar = document.getElementById('translateBar-'+commentId);
    
    if (bar) {
        bar.classList.add('visible');
        bar.innerHTML = '<span style="font-size:.75rem;color:#3B82F6;"><i class="fas fa-spinner fa-spin"></i> Traduction en cours...</span>';
    }
    
    try {
        var response = await fetch('/commentaire/api/translate/'+commentId, {
            method:'POST',
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify({targetLang:targetLang})
        });
        var data = await response.json();
        if (data.success) {
            pendingTranslations[commentId] = {original:data.original, translated:data.translated};
            if (bar) {
                bar.innerHTML = '<span class="translate-preview-text">'+esc(data.translated.substring(0,60))+(data.translated.length>60?'…':'')+'</span>'
                    + '<button class="btn-replace-translation" onclick="replaceCommentInline('+commentId+')"><i class="fas fa-check"></i> Remplacer</button>'
                    + '<button class="btn-cancel-translation" onclick="cancelTranslation('+commentId+')">Annuler</button>';
            }
            showToast('🌐 Traduction prête !','info',2000);
        } else {
            if (bar) { bar.classList.remove('visible'); bar.style.display = ''; }
            showToast('❌ Erreur de traduction','error');
        }
    } catch(e) {
        if (bar) { bar.classList.remove('visible'); bar.style.display = ''; }
        showToast('❌ Service de traduction indisponible','error');
    }
}

async function replaceCommentInline(commentId) {
    var t = pendingTranslations[commentId]; if (!t) return;
    try {
        var response = await fetch('/commentaire/api/replace/'+commentId, {
            method:'PUT',
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify({newText:t.translated})
        });
        var data = await response.json();
        if (data.success) {
            var el = document.getElementById('cmt-text-'+commentId);
            if (el) el.innerHTML = esc(t.translated).replace(/\n/g,'<br>');
            cancelTranslation(commentId);
            showToast('✅ Commentaire remplacé !','success');
        }
    } catch(e) { showToast('❌ Erreur lors du remplacement','error'); }
}

function cancelTranslation(commentId) {
    var bar = document.getElementById('translateBar-'+commentId);
    if (bar) { bar.classList.remove('visible'); bar.style.display = ''; bar.innerHTML = ''; }
    delete pendingTranslations[commentId];
}

