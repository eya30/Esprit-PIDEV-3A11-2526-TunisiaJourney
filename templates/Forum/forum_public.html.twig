{% extends 'base.html.twig' %}

{% block title %}Forum Voyageurs — TunisiaJourney{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&display=swap');

:root {
    --dr:#93032E;
    --dr2:#6B0221;
    --or:#FF6B35;
    --gold:#FFD700;
    --sand:#FDF5E6;
    --soft:#F5CAC3;
    --bg-warm:#FEF9F0;
    --border:#E8DFD1;
    --dark:#2C3E50;
    --ai-primary:#667eea;
    --ai-secondary:#764ba2;
}

/* ─── HERO ──────────────────────────────────────────────── */
.hero{position:relative;min-height:480px;height:48vh;
    background:linear-gradient(rgba(147,3,46,.22),rgba(245,202,195,.32)),
               url('https://images.pexels.com/photos/27622071/pexels-photo-27622071.jpeg') center/cover fixed;
    display:flex;align-items:center;justify-content:center;text-align:center;color:white;overflow:hidden;}
.hero::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at center,transparent,rgba(0,0,0,.30))}
.hero::after{content:'';position:absolute;bottom:0;left:0;right:0;height:90px;background:linear-gradient(to top,var(--sand),transparent);pointer-events:none}
.hero-content{position:relative;z-index:2;max-width:820px;padding:2rem;animation:fadeUp 1.2s cubic-bezier(.2,.9,.4,1.1)}
@keyframes fadeUp{from{opacity:0;transform:translateY(50px)}to{opacity:1;transform:translateY(0)}}
.hero h1{font-family:'Cormorant Garamond',serif;font-size:clamp(2rem,5vw,3.6rem);font-weight:700;color:#F5CAC3;letter-spacing:2px;text-shadow:3px 3px 12px rgba(0,0,0,.5);margin-bottom:1rem}
.hero p{font-size:1.05rem;line-height:1.8;color:rgba(255,255,255,.92);margin-bottom:1.5rem}
.hero-stats{display:flex;gap:1.2rem;justify-content:center;flex-wrap:wrap}
.stat-item{background:rgba(255,255,255,.15);backdrop-filter:blur(10px);border-radius:20px;padding:.7rem 1.4rem;text-align:center;border:1px solid rgba(255,255,255,.2)}
.stat-value{font-size:1.7rem;font-weight:800;color:var(--gold);line-height:1}
.stat-label{font-size:.72rem;font-weight:600;text-transform:uppercase;letter-spacing:1px;color:rgba(255,255,255,.8)}

/* ─── BOUTONS / TABS / FILTERS ──────────────────────────── */
.btn-share-adventure{display:inline-flex;align-items:center;gap:10px;background:linear-gradient(135deg,var(--dr),var(--or));color:white;border:none;padding:13px 28px;border-radius:40px;font-size:.92rem;font-weight:700;cursor:pointer;transition:all .3s;box-shadow:0 6px 20px rgba(147,3,46,.35);text-decoration:none;}
.btn-share-adventure:hover{transform:translateY(-3px);box-shadow:0 10px 28px rgba(147,3,46,.45);color:white;}

.nav-tabs-wrap{background:white;border-radius:20px;box-shadow:0 8px 28px rgba(0,0,0,.08);padding:8px;margin-bottom:2rem;display:flex;gap:8px;width:100%;}
.nav-tab{flex:1;padding:13px 18px;border-radius:14px;border:none;background:transparent;cursor:pointer;font-size:.86rem;font-weight:700;color:#9CA3AF;transition:all .3s;display:flex;align-items:center;justify-content:center;gap:9px;}
.nav-tab.active{background:linear-gradient(135deg,var(--dr),#C49A6C);color:white;box-shadow:0 6px 18px rgba(147,3,46,.3);}
.nav-tab:not(.active):hover{background:#FEF9F0;color:var(--dr);}
.tab-count{background:rgba(255,255,255,.3);border-radius:20px;padding:2px 9px;font-size:.72rem;font-weight:800;}
.tab-panel{display:none;}
.tab-panel.active{display:block;}

.filters-bar{background:white;padding:1.2rem 1.6rem;border-radius:20px;box-shadow:0 8px 28px rgba(0,0,0,.08);margin-bottom:2rem;display:flex;flex-wrap:wrap;gap:1rem;align-items:center;justify-content:space-between}
.search-wrapper{position:relative;flex:1;min-width:240px}
.search-icon{position:absolute;left:16px;top:50%;transform:translateY(-50%);color:#C49A6C;pointer-events:none}
.search-input-pub{width:100%;padding:11px 16px 11px 44px;border:2px solid var(--soft);border-radius:40px;font-size:.88rem;color:var(--dark);background:white;outline:none;transition:all .3s;font-family:inherit}
.search-input-pub:focus{border-color:var(--dr);box-shadow:0 0 0 3px rgba(147,3,46,.1)}
.search-results-badge{display:none;background:var(--bg-warm);color:var(--dr);border:1px solid var(--border);padding:5px 14px;border-radius:20px;font-size:.78rem;font-weight:600;white-space:nowrap}

.sort-bar{display:flex;align-items:center;gap:8px;flex-shrink:0;}
.sort-label{font-size:.8rem;color:#9CA3AF;font-weight:600;white-space:nowrap;}
.sort-btn{padding:7px 13px;border-radius:22px;border:1.5px solid var(--border);background:white;color:#6B7280;font-size:.76rem;font-weight:600;cursor:pointer;transition:all .2s;display:flex;align-items:center;gap:5px;}
.sort-btn:hover{border-color:var(--dr);color:var(--dr);}
.sort-btn.active{background:var(--dr);color:white;border-color:var(--dr);}

.lang-wrapper{display:flex;align-items:center;gap:8px;background:#FEF9F0;padding:4px 12px;border-radius:30px;border:1px solid var(--border);}
.lang-wrapper i{color:#93032E;font-size:.9rem;}
.lang-select{padding:6px 10px;border-radius:20px;border:1px solid #E8DFD1;background:white;cursor:pointer;font-size:.75rem;outline:none;}
.lang-refresh-btn{background:none;border:none;cursor:pointer;color:#93032E;font-size:.9rem;padding:4px;border-radius:50%;transition:all .2s;display:flex;align-items:center;justify-content:center;}
.lang-refresh-btn:hover{background:rgba(147,3,46,.1);transform:rotate(180deg);}

/* ─── TITRES DE SECTION ─────────────────────────────────── */
.section-title{text-align:center;font-family:'Cormorant Garamond',serif;font-size:clamp(1.8rem,4vw,2.6rem);font-weight:700;color:var(--dr);margin-bottom:.6rem}
.section-title::after{content:'✦ ✦ ✦';display:block;color:var(--soft);font-size:1.1rem;margin-top:.5rem;letter-spacing:10px}
.section-subtitle{text-align:center;color:var(--dark);font-size:.92rem;margin-bottom:2rem;font-style:italic;opacity:.8}

/* ─── REELS ─────────────────────────────────────────────── */
.reels-feed{display:flex;flex-direction:column;gap:0;max-width:680px;margin:0 auto;}
.reel-card{background:#000;border-radius:20px;overflow:hidden;position:relative;height:560px;margin-bottom:20px;box-shadow:0 8px 32px rgba(0,0,0,.18);}
.reel-video-wrap{width:100%;height:100%;position:relative;overflow:hidden;}
.reel-video-wrap iframe,.reel-video-wrap video{width:100%;height:100%;object-fit:cover;border:none;display:block;}
.reel-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.8) 0%,transparent 40%,rgba(0,0,0,.15) 100%);pointer-events:none;z-index:2;}
.reel-info{position:absolute;bottom:0;left:0;right:60px;padding:16px 18px 18px;z-index:3;pointer-events:none;}
.reel-title{color:white;font-size:1rem;font-weight:700;margin-bottom:4px;text-shadow:0 1px 6px rgba(0,0,0,.7);font-family:'Cormorant Garamond',serif;}
.reel-desc{color:rgba(255,255,255,.85);font-size:.78rem;line-height:1.4;text-shadow:0 1px 4px rgba(0,0,0,.5);}
.reel-actions{position:absolute;bottom:18px;right:12px;z-index:3;display:flex;flex-direction:column;align-items:center;gap:14px;}
.reel-action-btn{display:flex;flex-direction:column;align-items:center;gap:3px;cursor:pointer;color:white;text-shadow:0 1px 4px rgba(0,0,0,.6);text-decoration:none;background:transparent;border:none;}
.reel-action-btn i{font-size:1.4rem;}
.reel-action-btn span{font-size:.7rem;font-weight:600;}
.reel-badge{position:absolute;top:14px;left:14px;background:linear-gradient(135deg,var(--dr),var(--soft));color:white;padding:4px 12px;border-radius:20px;font-size:.68rem;font-weight:700;z-index:3;}

/* ─── FEED IMAGES (Facebook style) ──────────────────────── */
.fb-feed{display:flex;flex-direction:column;gap:22px;max-width:680px;margin:0 auto;}
.card-image{background:white;border-radius:20px;overflow:hidden;box-shadow:0 4px 18px rgba(0,0,0,.08);border:1px solid var(--border);}
.post-header{display:flex;align-items:center;gap:12px;padding:14px 16px 10px;}
.author-avatar{width:42px;height:42px;border-radius:50%;background:linear-gradient(135deg,var(--dr),var(--or));display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:1rem;flex-shrink:0;}
.author-name{font-weight:700;color:var(--dark);font-size:.9rem;}
.post-body{padding:0 16px 10px;}
.card-image-title{font-family:'Cormorant Garamond',serif;font-size:1.15rem;font-weight:700;color:var(--dr);margin-bottom:.4rem;}
.card-image-desc{color:#6c757d;font-size:.85rem;line-height:1.55;margin:0;}
.card-image-media img{width:100%;object-fit:cover;display:block;cursor:pointer;}
.reactions-bar{padding:8px 16px;display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--border);}
.post-footer{padding:8px 16px 12px;display:flex;justify-content:space-between;align-items:center;border-top:1px solid #f0ebe3;gap:12px;}
.btn-comment-inline{display:flex;align-items:center;justify-content:center;gap:6px;padding:8px 16px;border-radius:30px;border:none;background:#F5F0E8;cursor:pointer;font-size:.8rem;font-weight:600;color:var(--dark);transition:all .2s;}
.btn-comment-inline:hover{background:var(--bg-warm);color:var(--dr);}
.no-results-msg{display:none;text-align:center;padding:4rem 2rem;color:#aaa;}

/* ─── PAGINATION KnpPaginator — style TunisiaJourney ── */
.pagination-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
    margin: 3rem 0 2rem;
}
.pagination-wrapper::before {
    content: '✦ ✦ ✦';
    font-family: 'Cormorant Garamond', serif;
    font-size: 14px;
    color: var(--soft);
    letter-spacing: 14px;
    animation: fadeUp 1s ease;
}
.pagination-wrapper .pagination {
    display: flex;
    list-style: none;
    gap: 6px;
    margin: 0;
    padding: 10px 16px;
    flex-wrap: wrap;
    justify-content: center;
    background: white;
    border-radius: 60px;
    box-shadow: 0 12px 40px rgba(147,3,46,.18), 0 2px 8px rgba(196,154,108,.15);
    border: 1.5px solid var(--soft);
}
.pagination-wrapper .pagination li a,
.pagination-wrapper .pagination li span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 44px;
    padding: 0 16px;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 800;
    font-family: 'Cormorant Garamond', serif;
    letter-spacing: .5px;
    text-decoration: none;
    border: 2px solid transparent;
    background: transparent;
    color: #C4B8AA;
    cursor: pointer;
    transition: all .3s cubic-bezier(.2,.9,.4,1.2);
}
.pagination-wrapper .pagination li a:hover {
    background: linear-gradient(135deg, var(--bg-warm), var(--sand));
    border-color: var(--soft);
    color: var(--dr);
    transform: translateY(-4px) scale(1.08);
    box-shadow: 0 8px 20px rgba(147,3,46,.2);
}
.pagination-wrapper .pagination li.active span,
.pagination-wrapper .pagination li.active a {
    background: linear-gradient(135deg, var(--dr) 0%, #B5400A 50%, #C49A6C 100%);
    color: white;
    border-color: transparent;
    box-shadow: 0 8px 24px rgba(147,3,46,.45), 0 2px 8px rgba(196,154,108,.3);
    transform: translateY(-5px) scale(1.12);
    letter-spacing: 1px;
}
.pagination-wrapper .pagination li.disabled span,
.pagination-wrapper .pagination li.disabled a {
    opacity: .3;
    cursor: not-allowed;
    pointer-events: none;
}
.pagination-wrapper .pagination li.gap span {
    border-style: dashed;
    border-color: var(--border);
    background: var(--bg-warm);
    color: #C4B8AA;
    letter-spacing: 3px;
    cursor: default;
    pointer-events: none;
    font-size: 11px;
}
.pagination-info {
    text-align: center;
    font-size: .82rem;
    color: #aaa;
    margin-bottom: 1.5rem;
    background: white;
    display: block;
    width: fit-content;
    margin-left: auto;
    margin-right: auto;
    padding: 6px 20px;
    border-radius: 30px;
    border: 1px solid var(--border);
    box-shadow: 0 2px 8px rgba(0,0,0,.05);
}
.pagination-info strong { color: var(--dr); }

@media(max-width:768px){
    .pagination-wrapper .pagination {
        padding: 8px 14px;
        gap: 5px;
        border-radius: 40px;
    }
    .pagination-wrapper .pagination li a,
    .pagination-wrapper .pagination li span {
        min-width: 38px;
        height: 38px;
        font-size: 12px;
        padding: 0 10px;
    }
}

/* ─── POPUP RÉACTIONS CENTRÉ ─────────────────────────────── */
.fb-reaction-wrap {
    position: relative;
    display: inline-block;
}

.btn-fb-react {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 16px;
    border-radius: 30px;
    border: 1.5px solid #E8DFD1;
    background: white;
    font-size: .82rem;
    font-weight: 700;
    cursor: pointer;
    transition: all .25s ease;
    color: #65676B;
    user-select: none;
    position: relative;
    z-index: 5;
}

.btn-fb-react.reacted {
    border-color: transparent;
    color: white;
}

.btn-fb-react .react-emoji {
    font-size: 1.1rem;
    transition: transform .3s cubic-bezier(.2,.9,.4,1.3);
    display: inline-block;
}

.btn-fb-react:hover .react-emoji {
    transform: scale(1.25) rotate(-5deg);
}

/* Popup de réactions - CENTRÉ */
.reactions-popup {
    position: absolute;
    bottom: calc(100% + 15px);
    left: 50%;
    transform: translateX(-50%) scale(0.9);
    background: white;
    border-radius: 60px;
    box-shadow: 0 8px 32px rgba(0,0,0,.18), 0 2px 8px rgba(0,0,0,.1);
    padding: 10px 16px;
    display: flex;
    gap: 8px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: all .2s cubic-bezier(.2,.9,.4,1.2);
    z-index: 9999;
    border: 1px solid rgba(0,0,0,.08);
    white-space: nowrap;
}

.reactions-popup.visible {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
    transform: translateX(-50%) scale(1);
}

/* Flèche du popup centrée */
.reactions-popup::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 16px;
    height: 16px;
    background: white;
    border-right: 1px solid rgba(0,0,0,.08);
    border-bottom: 1px solid rgba(0,0,0,.08);
    box-shadow: 2px 2px 4px rgba(0,0,0,.05);
}

/* Options de réaction */
.reaction-option {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    padding: 8px 6px;
    border-radius: 16px;
    transition: all .2s ease;
    position: relative;
}

.reaction-option:hover {
    background: rgba(0,0,0,.05);
    transform: translateY(-8px) scale(1.1);
}

.reaction-option .r-emoji {
    font-size: 2rem;
    line-height: 1;
    display: block;
    transition: transform .2s ease;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,.1));
}

.reaction-option:hover .r-emoji {
    transform: scale(1.15);
}

.reaction-option .r-label {
    font-size: .65rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    transition: opacity .15s ease;
    position: absolute;
    bottom: -22px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,.8);
    color: white;
    padding: 3px 8px;
    border-radius: 12px;
    pointer-events: none;
    font-size: .7rem;
}

.reaction-option:hover .r-label {
    opacity: 1;
}

/* Pour les reels */
.reel-actions .reactions-popup {
    bottom: calc(100% + 15px);
    left: 50%;
    transform: translateX(-50%) scale(0.9);
}

.reel-actions .reactions-popup.visible {
    transform: translateX(-50%) scale(1);
}

.reel-actions .reactions-popup::after {
    left: 50%;
}

/* Animation flottante */
.reaction-float-notif {
    position: fixed;
    font-size: 2.2rem;
    pointer-events: none;
    z-index: 100000;
    animation: floatUp 1s ease-out forwards;
    filter: drop-shadow(0 4px 12px rgba(0,0,0,.3));
}

@keyframes floatUp {
    0%   { opacity: 1; transform: translateY(0) scale(0.8); }
    50%  { opacity: 1; transform: translateY(-40px) scale(1.2); }
    100% { opacity: 0; transform: translateY(-80px) scale(0.6); }
}

.reactions-summary-bar {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: .78rem;
    color: #65676B;
    cursor: pointer;
    padding: 2px 6px;
    border-radius: 20px;
    transition: background .2s;
    user-select: none;
}
.reactions-summary-bar:hover {
    background: #F2F2F2;
}
.react-pill .pill-emoji { font-size: .9rem; line-height: 1; }
.react-total { font-weight: 600; margin-left: 2px; }
.reactions-detail-tooltip {
    position: fixed;
    background: rgba(0,0,0,.85);
    color: white;
    border-radius: 12px;
    padding: 10px 14px;
    font-size: .75rem;
    white-space: nowrap;
    pointer-events: none;
    z-index: 9998;
    opacity: 0;
    transition: opacity .2s ease;
    min-width: 130px;
    box-shadow: 0 4px 16px rgba(0,0,0,.25);
}
.reactions-detail-tooltip.show { opacity: 1; }
.reactions-detail-tooltip .tooltip-row { display: flex; align-items: center; gap: 8px; padding: 3px 0; }
.reactions-detail-tooltip .tooltip-row span:last-child { margin-left: auto; font-weight: 700; color: #FFD700; }

/* ─── CORRECTION : Barre de traduction cachée par défaut ─── */
.comment-translate-bar {
    display: none;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    padding: 8px 12px;
    background: linear-gradient(135deg, #EFF6FF, #DBEAFE);
    border: 1px solid #93C5FD;
    border-radius: 12px;
    font-size: .78rem;
    animation: slideDown .25s ease;
}
.comment-translate-bar.visible {
    display: flex;
}
@keyframes slideDown {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
}
.translate-preview-text {
    flex: 1;
    color: #1D4ED8;
    font-style: italic;
    font-size: .75rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 200px;
}
.btn-replace-translation {
    background: linear-gradient(135deg, #1877F2, #42A5F5);
    color: white;
    border: none;
    padding: 5px 14px;
    border-radius: 20px;
    font-size: .72rem;
    font-weight: 700;
    cursor: pointer;
    transition: all .2s;
    white-space: nowrap;
}
.btn-replace-translation:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(24,119,242,.35);
}
.btn-cancel-translation {
    background: #F5F0E8;
    color: #4A3B2F;
    border: 1px solid #E8DFD1;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: .72rem;
    cursor: pointer;
    transition: all .2s;
    white-space: nowrap;
}
.btn-cancel-translation:hover { background: #ede8df; }

/* ─── AI Tags container amélioré ─── */
.ai-tags-container {
    background: linear-gradient(135deg, rgba(102,126,234,.06), rgba(118,75,162,.06));
    border: 1px solid rgba(102,126,234,.2);
    border-radius: 14px;
    padding: 10px 14px;
    margin-bottom: 12px;
    min-height: 42px;
    transition: all .3s ease;
}
.ai-tag-suggestion {
    display: inline-flex;
    align-items: center;
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
    border: none;
    border-radius: 24px;
    padding: 5px 14px;
    margin: 0 5px 5px 0;
    font-size: .75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all .25s ease;
    gap: 4px;
}
.ai-tag-suggestion:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(102,126,234,.45);
}

/* ─── CHATBOT AMÉLIORÉ ─── */
.chatbot-button {
    position: fixed; bottom: 30px; right: 30px;
    width: 62px; height: 62px; border-radius: 50%;
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white; border: none; cursor: pointer;
    box-shadow: 0 6px 24px rgba(102,126,234,.5);
    z-index: 10000; transition: all .3s ease;
    display: flex; align-items: center; justify-content: center;
    font-size: 26px;
    animation: pulseGlow 3s ease-in-out infinite;
}
.chatbot-button:hover { transform: scale(1.12) rotate(-5deg); }
@keyframes pulseGlow {
    0%, 100% { box-shadow: 0 6px 24px rgba(102,126,234,.5); }
    50%       { box-shadow: 0 6px 36px rgba(102,126,234,.85); }
}
.chatbot-window {
    position: fixed; bottom: 106px; right: 30px;
    width: 390px; height: 620px;
    background: white; border-radius: 24px;
    box-shadow: 0 20px 60px rgba(0,0,0,.18), 0 4px 16px rgba(102,126,234,.15);
    display: none; flex-direction: column;
    z-index: 10001; overflow: hidden;
    border: 1px solid rgba(102,126,234,.15);
}
.chatbot-window.open { display: flex; animation: chatOpen .3s cubic-bezier(.2,.9,.4,1.1); }
@keyframes chatOpen {
    from { opacity: 0; transform: translateY(20px) scale(.96); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
}
.chatbot-header {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white; padding: 16px 20px;
    display: flex; justify-content: space-between; align-items: center;
}
.chatbot-header h3 {
    margin: 0; font-size: 1rem; font-weight: 700;
    display: flex; align-items: center; gap: 10px;
}
.chatbot-status-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 0 2px rgba(74,222,128,.3);
    animation: blink 2s ease-in-out infinite;
    flex-shrink: 0;
}
@keyframes blink {
    0%, 100% { opacity: 1; } 50% { opacity: .4; }
}
.chatbot-messages {
    flex: 1; overflow-y: auto; padding: 16px;
    background: #f8f9fc;
    display: flex; flex-direction: column; gap: 10px;
}
.chatbot-messages::-webkit-scrollbar { width: 4px; }
.chatbot-messages::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 4px; }
.chatbot-message { display: flex; animation: msgIn .25s ease; }
@keyframes msgIn {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
}
.chatbot-message.user { justify-content: flex-end; }
.chatbot-message-content {
    max-width: 82%; padding: 10px 14px; border-radius: 18px;
    word-break: break-word; font-size: .88rem; line-height: 1.5;
}
.chatbot-message.user .chatbot-message-content {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white; border-bottom-right-radius: 4px;
}
.chatbot-message.bot .chatbot-message-content {
    background: white; color: #374151;
    border-bottom-left-radius: 4px;
    box-shadow: 0 2px 8px rgba(0,0,0,.08);
    border: 1px solid #f0f0f0;
}
.chatbot-message-time {
    font-size: .65rem; margin-top: 5px; opacity: .55;
    text-align: right;
}
.chatbot-message.bot .chatbot-message-time { text-align: left; }
.chatbot-typing {
    display: flex; gap: 5px; padding: 10px 14px;
    align-items: center;
}
.chatbot-typing span {
    width: 7px; height: 7px; background: #9CA3AF;
    border-radius: 50%; animation: typingBounce 1.2s ease-in-out infinite;
}
.chatbot-typing span:nth-child(2) { animation-delay: .2s; }
.chatbot-typing span:nth-child(3) { animation-delay: .4s; }
@keyframes typingBounce {
    0%, 60%, 100% { transform: translateY(0); opacity: .4; }
    30% { transform: translateY(-8px); opacity: 1; }
}
.chatbot-suggestions {
    padding: 10px 14px; background: white;
    border-top: 1px solid #f0f0f0;
    display: flex; gap: 7px; overflow-x: auto; flex-wrap: wrap;
}
.chatbot-suggestions::-webkit-scrollbar { display: none; }
.suggestion-chip {
    background: #F3F4F6; border: 1px solid #E5E7EB;
    border-radius: 20px; padding: 6px 12px;
    font-size: .75rem; cursor: pointer; white-space: nowrap;
    transition: all .2s; color: #374151; font-weight: 500;
}
.suggestion-chip:hover {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white; border-color: transparent;
    transform: translateY(-1px);
}
.chatbot-input-area {
    padding: 12px 14px; background: white;
    border-top: 1px solid #f0f0f0;
    display: flex; gap: 8px; align-items: flex-end;
}
.chatbot-input {
    flex: 1; border: 2px solid #E5E7EB; border-radius: 20px;
    padding: 10px 14px; font-size: .88rem; resize: none;
    font-family: inherit; max-height: 100px;
    transition: border-color .2s; line-height: 1.4; outline: none;
}
.chatbot-input:focus { border-color: #667eea; }
.chatbot-send-btn, .chatbot-mic-btn {
    width: 40px; height: 40px; border-radius: 50%;
    border: none; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: all .2s; flex-shrink: 0;
}
.chatbot-send-btn {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
}
.chatbot-send-btn:hover { transform: scale(1.08); }
.chatbot-mic-btn { background: #F3F4F6; color: #6B7280; }
.chatbot-mic-btn.listening { background: #FEF2F2; color: #EF4444; }

@media(max-width:768px){
    .chatbot-window { width: calc(100% - 40px); right: 20px; left: 20px; height: 520px; }
    .chatbot-button { bottom: 20px; right: 20px; width: 52px; height: 52px; font-size: 22px; }
    .reactions-popup { padding: 8px 12px; gap: 6px; bottom: calc(100% + 12px); }
    .reaction-option .r-emoji { font-size: 1.6rem; }
    .reaction-option .r-label { font-size: .6rem; bottom: -20px; padding: 2px 6px; }
    .fb-feed,.reels-feed{max-width:100%;}
    .filters-bar{flex-direction:column}
    .hero h1{font-size:2rem}
    .modal-content,.share-modal-box{width:96%;margin:.5rem}
    .nav-tabs-wrap{flex-direction:column}
    .reel-card{height:480px;}
    .sort-bar{flex-wrap:wrap;}
    .gif-grid{grid-template-columns:repeat(auto-fill,minmax(120px,1fr));}
}

/* ─── MODALS ─────────────────────────────────────────────── */
.comment-modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);backdrop-filter:blur(5px);z-index:10000;align-items:center;justify-content:center}
.comment-modal.open{display:flex}
.modal-content{background:white;border-radius:28px;max-width:580px;width:92%;max-height:88vh;overflow-y:auto;animation:slideUp .4s cubic-bezier(.2,.9,.4,1.1);box-shadow:0 28px 56px rgba(0,0,0,.3)}
@keyframes slideUp{from{opacity:0;transform:translateY(50px)}to{opacity:1;transform:translateY(0)}}
.modal-header{padding:1.2rem 1.5rem .8rem;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;background:white;z-index:5}
.modal-header h3{font-family:'Cormorant Garamond',serif;font-size:1.35rem;font-weight:700;color:var(--dr);margin:0;display:flex;align-items:center;gap:10px}
.modal-close{background:var(--bg-warm);border:none;width:36px;height:36px;border-radius:50%;font-size:1.2rem;cursor:pointer;transition:all .2s;color:var(--dark)}
.modal-close:hover{background:var(--dr);color:white;transform:rotate(90deg)}
.publication-preview{background:var(--bg-warm);margin:1rem 1.5rem;padding:.8rem 1rem;border-radius:14px;border-left:4px solid var(--dr)}
.publication-preview h4{font-size:.92rem;font-weight:700;color:var(--dr);margin-bottom:.3rem}
.publication-preview p{font-size:.8rem;color:#666;margin:0}
.modal-body{padding:0 1.5rem 1.5rem}

.emoji-strip{display:flex;flex-direction:column;gap:8px;margin-bottom:12px;padding:8px 12px;background:var(--bg-warm);border-radius:40px;border:1px solid var(--border);}
.emoji-btn{background:white;border:1px solid var(--border);border-radius:40px;font-size:1rem;cursor:pointer;padding:4px 9px;transition:all .2s;width:36px;height:36px;display:inline-flex;align-items:center;justify-content:center;}
.emoji-btn:hover{transform:scale(1.15);background:var(--dr);color:white;border-color:var(--dr);}

.symfony-error{display:none;background:#FEF2F2;border:1.5px solid #FECACA;border-left:4px solid #EF4444;border-radius:12px;padding:10px 14px;margin-bottom:12px;font-size:.83rem;font-weight:600;color:#B91C1C;align-items:center;gap:8px;}
.symfony-error.visible{display:flex;}
.comment-textarea{width:100%;border:2px solid var(--border);border-radius:18px;padding:12px;font-size:.86rem;resize:vertical;font-family:inherit;transition:border-color .3s, box-shadow .3s;background:white;box-sizing:border-box;min-height:88px;}
.comment-textarea:focus{outline:none;border-color:var(--dr);box-shadow:0 0 0 3px rgba(147,3,46,.1);}
.comment-tags-input{width:100%;border:2px solid var(--border);border-radius:40px;padding:10px 15px;font-size:.82rem;margin-bottom:8px;transition:border-color .3s;background:white;box-sizing:border-box;}
.comment-tags-input:focus{outline:none;border-color:var(--dr);}

.modal-submit{background:linear-gradient(135deg,var(--dr),var(--or));color:white;border:none;padding:12px 24px;border-radius:40px;font-weight:700;font-size:.86rem;cursor:pointer;transition:all .3s;width:100%;display:flex;align-items:center;justify-content:center;gap:9px;margin-top:12px;}
.modal-submit:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 7px 22px rgba(147,3,46,.4)}
.modal-submit:disabled{opacity:.65;cursor:not-allowed}
.comments-section{margin-top:1.2rem;padding-top:1rem;border-top:2px solid var(--border)}
.comments-section-title{font-size:.82rem;font-weight:700;color:var(--dark);margin-bottom:.8rem;display:flex;align-items:center;gap:8px}
.comments-list-modal{max-height:340px;overflow-y:auto;padding-right:3px}
.comment-item{background:var(--bg-warm);border-radius:14px;padding:10px 12px;margin-bottom:8px;border-left:3px solid var(--dr);}
.comment-item-text{font-size:.83rem;color:#444;line-height:1.5;margin-top:5px}
.like-comment-btn{display:flex;align-items:center;gap:4px;background:none;border:none;cursor:pointer;font-size:.78rem;color:#aaa;padding:3px 8px;border-radius:18px;transition:all .2s}
.like-comment-btn:hover,.like-comment-btn.liked{color:#e74c3c}
.reply-comment-btn{display:flex;align-items:center;gap:4px;background:none;border:1px solid rgba(147,3,46,.2);cursor:pointer;font-size:.72rem;color:#93032E;padding:4px 10px;border-radius:18px;transition:all .2s;font-weight:500;}
.btn-report-comment{display:flex;align-items:center;gap:4px;background:none;border:1px solid rgba(147,3,46,.15);cursor:pointer;font-size:.72rem;color:#bbb;padding:3px 9px;border-radius:18px;transition:all .2s;}
.btn-report-comment:hover{background:rgba(147,3,46,.08);color:var(--dr);border-color:var(--dr);}
.empty-comments-modal{text-align:center;padding:1.6rem;color:#aaa}
.loading-spinner{display:inline-block;width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-radius:50%;border-top-color:white;animation:spin .6s linear infinite;margin-right:5px}
@keyframes spin{to{transform:rotate(360deg)}}
.toast-notification{position:fixed;bottom:22px;right:22px;color:white;padding:11px 22px;border-radius:46px;font-size:.82rem;font-weight:600;z-index:10001;box-shadow:0 7px 24px rgba(0,0,0,.22);max-width:360px;animation:toastIn .3s ease}
@keyframes toastIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}

.bad-words-error{display:none;background:#FEF2F2;border:1.5px solid #FECACA;border-left:4px solid #EF4444;border-radius:12px;padding:10px 14px;margin-bottom:12px;font-size:.83rem;font-weight:600;color:#B91C1C;align-items:center;gap:8px;}
.bad-words-error.visible{display:flex;}

.report-modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);backdrop-filter:blur(4px);z-index:20000;align-items:center;justify-content:center;}
.report-modal.open{display:flex;}
.report-modal-box{background:white;border-radius:22px;max-width:420px;width:92%;padding:1.8rem;box-shadow:0 20px 50px rgba(0,0,0,.3);animation:slideUp .35s cubic-bezier(.2,.9,.4,1.1);}
.report-modal-title{font-family:'Cormorant Garamond',serif;font-size:1.25rem;font-weight:700;color:var(--dr);margin-bottom:.4rem;display:flex;align-items:center;gap:9px;}
.report-option{display:flex;align-items:center;gap:12px;padding:9px 12px;border-radius:12px;cursor:pointer;transition:background .2s;margin-bottom:5px;}
.report-option:hover{background:var(--bg-warm);}
.report-option input[type=radio]{accent-color:var(--dr);width:17px;height:17px;}
.report-modal-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:1.2rem;padding-top:1rem;border-top:1px solid var(--border);}
.btn-cancel-report{background:#F5F0E8;color:#4A3B2F;border:none;padding:9px 18px;border-radius:22px;font-size:.84rem;font-weight:600;cursor:pointer;}
.btn-submit-report{background:linear-gradient(135deg,var(--dr),var(--or));color:white;border:none;padding:9px 20px;border-radius:22px;font-size:.84rem;font-weight:700;cursor:pointer;transition:all .3s;}
.btn-submit-report:disabled{opacity:.5;cursor:not-allowed;}

.share-modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);backdrop-filter:blur(6px);z-index:15000;align-items:center;justify-content:center;}
.share-modal.open{display:flex;}
.share-modal-box{background:white;border-radius:28px;max-width:560px;width:94%;max-height:90vh;overflow-y:auto;animation:slideUp .4s cubic-bezier(.2,.9,.4,1.1);box-shadow:0 28px 60px rgba(0,0,0,.3);}
.share-modal-header{padding:1.3rem 1.5rem 1rem;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;background:white;z-index:5;}
.share-modal-header h3{font-family:'Cormorant Garamond',serif;font-size:1.4rem;font-weight:700;color:var(--dr);margin:0;}
.share-modal-body{padding:1.5rem;}
.share-notice{background:linear-gradient(135deg,#EFF6FF,#DBEAFE);border:1px solid #93C5FD;border-radius:14px;padding:10px 14px;margin-bottom:1.2rem;font-size:.8rem;color:#1D4ED8;display:flex;align-items:center;gap:8px;}
.share-tabs{display:flex;gap:8px;margin-bottom:1.4rem;background:var(--bg-warm);padding:6px;border-radius:14px;}
.share-tab-btn{flex:1;padding:10px;border-radius:10px;border:none;background:transparent;cursor:pointer;font-size:.82rem;font-weight:600;color:#9CA3AF;transition:all .25s;display:flex;align-items:center;justify-content:center;gap:6px;}
.share-tab-btn.active{background:linear-gradient(135deg,var(--dr),#C49A6C);color:white;box-shadow:0 3px 10px rgba(0,0,0,.1);}
.share-form-group{margin-bottom:1rem;}
.share-form-group label{display:block;font-size:.83rem;font-weight:600;color:var(--dark);margin-bottom:5px;}
.share-input{width:100%;padding:10px 14px;border:2px solid var(--border);border-radius:14px;font-size:.86rem;font-family:inherit;outline:none;transition:border-color .2s;background:white;box-sizing:border-box;}
.share-input:focus{border-color:var(--dr);box-shadow:0 0 0 3px rgba(147,3,46,.08);}
.share-textarea{min-height:90px;resize:vertical;}
.share-upload-zone{border:2px dashed var(--border);border-radius:18px;padding:2rem;text-align:center;cursor:pointer;transition:all .25s;background:var(--bg-warm);}
.share-upload-zone:hover{border-color:var(--dr);background:rgba(147,3,46,.04);}
.share-upload-zone i{font-size:2.2rem;color:#C49A6C;margin-bottom:.8rem;display:block;}
.share-upload-zone p{color:#888;font-size:.85rem;margin:0;}
.share-preview{display:none;position:relative;border-radius:14px;overflow:hidden;margin-top:.8rem;max-height:240px;}
.share-preview img{width:100%;max-height:240px;object-fit:cover;display:block;}
.share-preview-remove{position:absolute;top:8px;right:8px;background:rgba(0,0,0,.6);color:white;border:none;width:30px;height:30px;border-radius:50%;cursor:pointer;font-size:.9rem;display:flex;align-items:center;justify-content:center;}
.forum-select{width:100%;padding:10px 14px;border:2px solid var(--border);border-radius:14px;font-size:.86rem;outline:none;background:white;transition:border-color .2s;box-sizing:border-box;}
.forum-select:focus{border-color:var(--dr);}
.share-submit-btn{width:100%;background:linear-gradient(135deg,var(--dr),var(--or));color:white;border:none;padding:13px;border-radius:40px;font-size:.9rem;font-weight:700;cursor:pointer;transition:all .3s;display:flex;align-items:center;justify-content:center;gap:10px;margin-top:.5rem;}
.share-submit-btn:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 8px 24px rgba(147,3,46,.4);}
.share-submit-btn:disabled{opacity:.6;cursor:not-allowed;}

.btn-gif{background:linear-gradient(135deg,#8B5CF6,#6D28D9);color:white;border:none;padding:6px 14px;border-radius:20px;font-size:.75rem;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:all 0.3s;}
.gif-picker-modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);backdrop-filter:blur(5px);z-index:20000;align-items:center;justify-content:center;}
.gif-picker-modal.open{display:flex;}
.gif-picker-container{background:white;border-radius:20px;width:90%;max-width:800px;max-height:80vh;overflow:hidden;display:flex;flex-direction:column;}
.gif-picker-header{padding:1rem 1.5rem;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;}
.gif-picker-header h3{margin:0;font-family:'Cormorant Garamond',serif;color:var(--dr);}
.gif-search-bar{display:flex;gap:10px;padding:1rem 1.5rem;background:#FEF9F0;border-bottom:1px solid var(--border);}
.gif-search-input{flex:1;padding:10px 15px;border:2px solid var(--border);border-radius:40px;font-size:.85rem;outline:none;}
.gif-search-btn{background:linear-gradient(135deg,var(--dr),#C49A6C);color:white;border:none;padding:10px 20px;border-radius:40px;cursor:pointer;font-weight:600;}
.gif-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;padding:1.5rem;overflow-y:auto;max-height:500px;}
.gif-item{cursor:pointer;border-radius:10px;overflow:hidden;transition:all 0.3s;background:#F5F0E8;aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;}
.gif-item img{width:100%;height:100%;object-fit:cover;}
.gif-item:hover{transform:scale(1.05);}
.gif-loading{text-align:center;padding:2rem;color:#aaa;}
.gif-picker-footer{padding:1rem 1.5rem;border-top:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;font-size:.75rem;color:#aaa;}
.gif-load-more{background:#F5F0E8;border:none;padding:8px 16px;border-radius:20px;cursor:pointer;font-size:.75rem;}
.gif-load-more:hover{background:var(--dr);color:white;}

/* Chatbot legacy (remplacé par version améliorée mais gardé pour compatibilité) */
.chatbot-button-legacy{position:fixed;bottom:30px;right:30px;width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,var(--ai-primary),var(--ai-secondary));color:white;border:none;cursor:pointer;box-shadow:0 4px 20px rgba(102,126,234,0.4);z-index:10000;transition:all 0.3s ease;display:flex;align-items:center;justify-content:center;font-size:24px;animation:pulseGlow 2s infinite;}
.chatbot-button-legacy:hover{transform:scale(1.1);}
@keyframes pulseGlowLegacy{0%{box-shadow:0 4px 20px rgba(102,126,234,0.4);}50%{box-shadow:0 4px 30px rgba(102,126,234,0.8);}100%{box-shadow:0 4px 20px rgba(102,126,234,0.4);}}
</style>
