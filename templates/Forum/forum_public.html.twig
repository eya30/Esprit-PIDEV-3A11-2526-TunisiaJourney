function openGifPicker(){ document.getElementById('gifPickerModal').classList.add('open'); loadTrendingGifs(); }
function closeGifPicker(){ document.getElementById('gifPickerModal').classList.remove('open'); }
async function loadTrendingGifs(){
    var service=window.GiphyService; if(!service||!service.isConfigured()){ document.getElementById('gifGrid').innerHTML='<div>Service GIF non configuré</div>'; return; }
    currentGifQuery=''; var result=await service.getTrending(20,0);
    if(result.success&&result.gifs.length>0){ displayGifs(result.gifs); currentGifPage=1; }
}
async function searchGifs(){
    var query=document.getElementById('gifSearchInput').value.trim(); var service=window.GiphyService; if(!service) return;
    if(!query){ loadTrendingGifs(); return; }
    currentGifQuery=query; var result=await service.search(query,20,0);
    if(result.success&&result.gifs.length>0){ displayGifs(result.gifs); currentGifPage=1; }
}
async function loadMoreGifs(){
    var service=window.GiphyService; if(!service) return;
    var offset=currentGifPage*20;
    var result=currentGifQuery?await service.search(currentGifQuery,20,offset):await service.getTrending(20,offset);
    if(result.success&&result.gifs.length>0){ displayGifs(result.gifs,true); currentGifPage++; }
}
function displayGifs(gifs,append){
    var grid=document.getElementById('gifGrid'); if(!append) grid.innerHTML='';
    gifs.forEach(function(gif){
        var gifUrl=window.GiphyService.getGifUrl(gif,'fixed_height');
        var item=document.createElement('div'); item.className='gif-item';
        item.innerHTML='<img src="'+gifUrl+'" alt="GIF">';
        item.onclick=function(){ insertGifToComment(gif); };
        grid.appendChild(item);
    });
}
function insertGifToComment(gif){
    var ta=document.getElementById('modalCommentText'); if(!ta) return;
    var gifUrl=window.GiphyService.getGifUrl(gif,'fixed_height');
    var markup='\n[[GIF:'+gifUrl+']]';
    ta.value=ta.value.trim()?ta.value+markup:markup.trim();
    closeGifPicker(); showToast('✅ GIF ajouté !','success');
}

/* ★ GEMINI CHATBOT AMÉLIORÉ ★ */
class GeminiChatbot {
    constructor() {
        this.isOpen       = false;
        this.isListening  = false;
        this.recognition  = null;
        this.synth        = window.speechSynthesis;
        this.sessionId    = 'sess_' + Date.now();
        this.isProcessing = false;
        this.init();
    }

    init() {
        this.createUI();
        this.initSpeechRecognition();
        this.addEventListeners();
        this.addWelcomeMessage();
    }

    createUI() {
        // Bouton flottant
        const btn = document.createElement('button');
        btn.className = 'chatbot-button';
        btn.innerHTML = '✨';
        btn.title = 'Assistant Gemini AI';
        btn.onclick = () => this.toggle();
        document.body.appendChild(btn);

        // Fenêtre
        const win = document.createElement('div');
        win.className = 'chatbot-window';
        win.id = 'chatbotWindow';
        win.innerHTML = `
            <div class="chatbot-header">
                <h3>
                    <span class="chatbot-status-dot"></span>
                    ✨ Assistant Gemini AI
                </h3>
                <div style="display:flex;gap:8px;">
                    <button onclick="window.chatbot.clearChat()"
                            title="Nouvelle conversation"
                            style="background:rgba(255,255,255,.15);border:none;color:white;
                                   width:30px;height:30px;border-radius:50%;cursor:pointer;">
                        <i class="fas fa-redo-alt"></i>
                    </button>
                    <button onclick="window.chatbot.toggle()"
                            style="background:rgba(255,255,255,.15);border:none;color:white;
                                   width:30px;height:30px;border-radius:50%;cursor:pointer;">✕</button>
                </div>
            </div>
            <div class="chatbot-messages" id="chatbotMessages"></div>
            <div class="chatbot-suggestions" id="chatbotSuggestions"></div>
            <div class="chatbot-input-area">
                <textarea class="chatbot-input" id="chatbotInput"
                          placeholder="Posez votre question à Gemini..." rows="1"></textarea>
                <button class="chatbot-mic-btn" id="chatbotMicBtn">
                    <i class="fas fa-microphone"></i>
                </button>
                <button class="chatbot-send-btn" id="chatbotSendBtn">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>`;
        document.body.appendChild(win);

        // Suggestions rapides
        const chips = [
            { i: '📝', t: 'Comment publier sur le forum ?' },
            { i: '🏝️', t: 'Meilleurs endroits en Tunisie ?' },
            { i: '🍽️', t: 'Spécialités culinaires tunisiennes' },
            { i: '💙', t: 'Que visiter à Sidi Bou Saïd ?' },
            { i: '✈️', t: 'Quand visiter la Tunisie ?' },
            { i: '🏛️', t: 'Histoire de Carthage' },
            { i: '🌊', t: 'Djerba ou Hammamet ?' },
            { i: '🛡️', t: 'La Tunisie est-elle sûre ?' }
        ];
        document.getElementById('chatbotSuggestions').innerHTML =
            chips.map(c =>
                `<span class="suggestion-chip"
                       onclick="window.chatbot.sendText('${c.t}')">
                     ${c.i} ${c.t}
                 </span>`
            ).join('');
    }

    initSpeechRecognition() {
        if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
            const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
            this.recognition = new SR();
            this.recognition.lang = 'fr-FR';
            this.recognition.continuous = false;

            this.recognition.onresult = (e) => {
                document.getElementById('chatbotInput').value = e.results[0][0].transcript;
                this.sendMessage();
                this.stopListening();
            };
            this.recognition.onerror = () => this.stopListening();
            this.recognition.onend   = () => this.stopListening();
        }
    }

    startListening() {
        if (this.recognition) {
            this.isListening = true;
            this.recognition.start();
            const m = document.getElementById('chatbotMicBtn');
            m.classList.add('listening');
            m.innerHTML = '<i class="fas fa-microphone-slash"></i>';
            showToast('🎤 Parlez maintenant...', 'info');
        }
    }

    stopListening() {
        if (this.recognition && this.isListening) {
            try { this.recognition.stop(); } catch(e) {}
            this.isListening = false;
            const m = document.getElementById('chatbotMicBtn');
            m.classList.remove('listening');
            m.innerHTML = '<i class="fas fa-microphone"></i>';
        }
    }

    toggle() {
        this.isOpen = !this.isOpen;
        const win = document.getElementById('chatbotWindow');
        win.classList.toggle('open', this.isOpen);
        if (this.isOpen) {
            document.getElementById('chatbotInput').focus();
            this.scrollBottom();
        }
    }

    sendText(text) {
        document.getElementById('chatbotInput').value = text;
        this.sendMessage();
    }

    async sendMessage() {
        if (this.isProcessing) {
            showToast('⏳ Attendez la réponse en cours...', 'info');
            return;
        }

        const input   = document.getElementById('chatbotInput');
        const message = input.value.trim();
        if (!message) return;

        this.addMessage(message, 'user');
        input.value        = '';
        input.style.height = 'auto';
        this.showTyping();
        this.isProcessing = true;

        try {
            const response = await fetch('/api/chat/send', {
                method:  'POST',
                headers: {
                    'Content-Type':     'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({
                    message:    message,
                    session_id: this.sessionId
                })
            });

            this.hideTyping();

            if (!response.ok) {
                let errMsg = '❌ Erreur serveur (' + response.status + '). Veuillez réessayer.';
                try {
                    const errData = await response.json();
                    if (errData && errData.response) errMsg = errData.response;
                } catch(e) {}
                this.addMessage(errMsg, 'bot');
                return;
            }

            const data = await response.json();

            if (data.response) {
                this.addMessage(data.response, 'bot');
                if (data.success) {
                    this.speak(data.response);
                }
            } else {
                this.addMessage('❌ Réponse vide du serveur. Veuillez réessayer.', 'bot');
            }

        } catch (networkError) {
            this.hideTyping();
            this.addMessage(
                '⚠️ Impossible de contacter le serveur. Vérifiez votre connexion et réessayez.',
                'bot'
            );
        } finally {
            this.isProcessing = false;
        }

        this.scrollBottom();
    }

    format(text) {
        text = text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
        text = text.replace(/\*(.*?)\*/g,     '<em>$1</em>');
        text = text.replace(/^• (.*?)$/gm,    '<li style="margin:3px 0">$1</li>');
        text = text.replace(/(<li[^>]*>.*?<\/li>)+/gs,
                   m => `<ul style="margin:6px 0;padding-left:18px;">${m}</ul>`);
        text = text.replace(/\n/g, '<br>');
        return text;
    }

    addMessage(text, type) {
        const container = document.getElementById('chatbotMessages');
        const div       = document.createElement('div');
        div.className   = 'chatbot-message ' + type;
        const time      = new Date().toLocaleTimeString('fr-FR',
                            { hour: '2-digit', minute: '2-digit' });
        div.innerHTML = `
            <div class="chatbot-message-content">
                <div class="chatbot-message-text">${this.format(text)}</div>
                <div class="chatbot-message-time">${time}</div>
            </div>`;
        container.appendChild(div);
        this.scrollBottom();
    }

    speak(text) {
        if (this.synth) {
            this.synth.cancel();
            const clean = text.replace(/<[^>]*>/g, '')
                              .replace(/[*_#]/g, '')
                              .substring(0, 200);
            const u  = new SpeechSynthesisUtterance(clean);
            u.lang   = 'fr-FR';
            u.rate   = 0.92;
            this.synth.speak(u);
        }
    }

    showTyping() {
        const c  = document.getElementById('chatbotMessages');
        const d  = document.createElement('div');
        d.className = 'chatbot-message bot';
        d.id        = 'chatTyping';
        d.innerHTML = `
            <div class="chatbot-message-content">
                <div class="chatbot-typing">
                    <span></span><span></span><span></span>
                </div>
            </div>`;
        c.appendChild(d);
        this.scrollBottom();
    }

    hideTyping() {
        const i = document.getElementById('chatTyping');
        if (i) i.remove();
    }

    scrollBottom() {
        const c = document.getElementById('chatbotMessages');
        if (c) c.scrollTop = c.scrollHeight;
    }

    clearChat() {
        document.getElementById('chatbotMessages').innerHTML = '';
        this.sessionId = 'sess_' + Date.now();

        // Réinitialiser côté serveur
        fetch('/api/chat/reset', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ session_id: this.sessionId })
        }).catch(() => {});

        this.addWelcomeMessage();
        showToast('🔄 Nouvelle conversation', 'info');
    }

    addWelcomeMessage() {
        setTimeout(() => {
            this.addMessage(
                '🌟 **Bonjour ! Je suis votre assistant Gemini AI.**\n\n' +
                'Je peux vous aider avec :\n' +
                '• 📝 Utilisation du forum\n' +
                '• 🏝️ Destinations en Tunisie\n' +
                '• 🍽️ Gastronomie tunisienne\n' +
                '• ✈️ Conseils de voyage\n' +
                '• 🏛️ Histoire & culture\n\n' +
                'Que souhaitez-vous savoir ? 😊', 'bot'
            );
        }, 600);
    }

    addEventListeners() {
        document.getElementById('chatbotSendBtn')
            .addEventListener('click', () => this.sendMessage());
        document.getElementById('chatbotMicBtn')
            .addEventListener('click', () => this.startListening());
        document.getElementById('chatbotInput')
            .addEventListener('keypress', (e) => {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    this.sendMessage();
                }
            });
        document.getElementById('chatbotInput')
            .addEventListener('input', function () {
                this.style.height = 'auto';
                this.style.height = Math.min(this.scrollHeight, 100) + 'px';
            });
    }
}

/* ─── INITIALISATION ─── */
document.addEventListener('DOMContentLoaded', function() {
    applySortFeed('reelsFeed', 'desc');
    applySortFeed('imageFeed', 'desc');

    ReactionSystem.init();

    var sv = document.getElementById('pageLangSelect');
    var si = document.getElementById('pageLangSelectImage');
    if (sv) sv.addEventListener('change', function(){ translatePage(sv.value); if(si) si.value=sv.value; });
    if (si) si.addEventListener('change', function(){ translatePage(si.value); if(sv) sv.value=si.value; });
    document.getElementById('resetTranslationBtn') && document.getElementById('resetTranslationBtn').addEventListener('click', resetPageTranslation);
    document.getElementById('resetTranslationBtnImage') && document.getElementById('resetTranslationBtnImage').addEventListener('click', resetPageTranslation);

    var ids = new Set();
    document.querySelectorAll('[data-id]').forEach(function(card){
        if (card.dataset.id) ids.add(card.dataset.id);
    });
    ids.forEach(function(id) {
        fetch('/publication/'+id+'/likes', {headers:{'X-Requested-With':'XMLHttpRequest'}})
            .then(function(r){ return r.json(); })
            .then(function(d){
                if (d.likes !== undefined) {
                    var rl = document.getElementById('reelLikeCount-'+id);
                    var tr = document.getElementById('totalReactions-'+id);
                    if (rl) rl.textContent = d.likes;
                    if (tr) tr.textContent = d.likes;
                }
            }).catch(function(){});
    });

    window.chatbot = new GeminiChatbot();

    document.querySelectorAll('input[name="reportReason"]').forEach(function(radio) {
        radio.addEventListener('change', function(){
            document.getElementById('reportSubmitBtn').disabled = false;
        });
    });

    var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
            var video = entry.target.querySelector('video'); if (!video) return;
            if (entry.isIntersecting && entry.intersectionRatio > 0.5) {
                video.play().catch(function(){});
            } else {
                video.pause();
            }
        });
    }, {threshold:[0.5]});
    document.querySelectorAll('.reel-card').forEach(function(card){ observer.observe(card); });
});

document.addEventListener('keydown', function(e) {
    if (e.key==='Escape') {
        closeCommentModal(); closeReportModal(); closeShareModal(); closeGifPicker();
    }
});

document.getElementById('commentModal') && document.getElementById('commentModal').addEventListener('click', function(e){ if(e.target===this) closeCommentModal(); });
document.getElementById('reportModal') && document.getElementById('reportModal').addEventListener('click', function(e){ if(e.target===this) closeReportModal(); });
document.getElementById('shareModal') && document.getElementById('shareModal').addEventListener('click', function(e){ if(e.target===this) closeShareModal(); });
</script>
