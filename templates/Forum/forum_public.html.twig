function previewShareFile(input,type){
    var file=input.files[0]; if(!file) return;
    if(type==='photo'){ var reader=new FileReader(); reader.onload=function(e){ document.getElementById('sharePhotoImg').src=e.target.result; document.getElementById('sharePhotoPreview').style.display='block'; }; reader.readAsDataURL(file); }
    else if(type==='video'){ document.getElementById('shareVideoEl').src=URL.createObjectURL(file); document.getElementById('shareVideoPreview').style.display='block'; }
}
function removeSharePreview(type){
    if(type==='photo'){ document.getElementById('sharePhotoPreview').style.display='none'; document.getElementById('sharePhotoFile').value=''; }
    else if(type==='video'){ document.getElementById('shareVideoPreview').style.display='none'; document.getElementById('shareVideoFile').value=''; document.getElementById('shareVideoEl').src=''; }
}
async function submitShareAdventure(){
    var forumId=document.getElementById('shareForumId').value;
    var title=document.getElementById('shareTitle').value.trim();
    if(!forumId){ showToast('Veuillez sélectionner un forum','error'); return; }
    if(!title||title.length<3){ showToast('Le titre doit contenir au moins 3 caractères','error'); return; }
    var btn=document.getElementById('shareSubmitBtn'); var orig=btn.innerHTML;
    btn.innerHTML='<i class="fas fa-spinner fa-spin"></i> Publication...'; btn.disabled=true;
    try{
        var formData=new FormData();
        formData.append('forumId',forumId); formData.append('title',title);
        formData.append('description',document.getElementById('shareDescription').value.trim());
        if(shareTabCurrent==='photo'){ var pf=document.getElementById('sharePhotoFile').files[0]; if(pf) formData.append('image',pf); }
        else if(shareTabCurrent==='video'){ var vf=document.getElementById('shareVideoFile').files[0]; if(vf) formData.append('video',vf); }
        else if(shareTabCurrent==='link'){ var vu=document.getElementById('shareVideoUrl').value.trim(); if(vu) formData.append('videoUrl',vu); }
        var response=await fetch('/publication/api/new',{method:'POST',body:formData,headers:{'X-Requested-With':'XMLHttpRequest'}});
        var data=await response.json();
        if(data.success){ showToast('🎉 Publication ajoutée !','success'); closeShareModal(); setTimeout(function(){ window.location.href=data.profileUrl; },1500); }
        else { showToast('❌ '+(data.error||'Erreur lors de la publication'),'error'); }
    }catch(error){ showToast('❌ Erreur de connexion','error'); }
    finally{ btn.innerHTML=orig; btn.disabled=false; }
}

