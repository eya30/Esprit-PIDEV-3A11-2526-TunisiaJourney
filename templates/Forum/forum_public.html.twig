            <div id="shareLinkSection" style="display:none;">
                <div class="share-form-group">
                    <label><span data-translate="true">Lien vidéo (YouTube, Vimeo, ...)</span></label>
                    <input type="url" class="share-input" id="shareVideoUrl"
                           placeholder="https://www.youtube.com/watch?v=...">
