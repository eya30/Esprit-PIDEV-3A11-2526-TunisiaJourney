{% block javascripts %}
<script src="{{ asset('js/bad-words-service.js') }}"></script>
<script src="{{ asset('js/render-comment.js') }}"></script>
<script src="{{ asset('js/speech-recognition.js') }}"></script>
<script src="{{ asset('js/translation.js') }}"></script>
<script src="{{ asset('js/giphy-service.js') }}"></script>
<script src="{{ asset('js/tag-suggestion.js') }}"></script>
<script src="{{ asset('js/emoji-service.js') }}"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<script>
'use strict';

/* REACTIONS SYSTEM — Version corrigée avec popup centré */
var ReactionSystem = (function() {

    var REACTIONS = {
        like:  { emoji: '👍', label: "J'aime",  gradient: 'linear-gradient(135deg,#1877F2,#42A5F5)' },
        love:  { emoji: '❤️',  label: "J'adore", gradient: 'linear-gradient(135deg,#F33E58,#FF6584)' },
        haha:  { emoji: '😂', label: 'Haha',    gradient: 'linear-gradient(135deg,#F7B928,#FDD835)' },
        wow:   { emoji: '😮', label: 'Wouah',   gradient: 'linear-gradient(135deg,#F7B928,#FF8F00)' },
        sad:   { emoji: '😢', label: 'Triste',  gradient: 'linear-gradient(135deg,#64B5F6,#F7B928)' },
        angry: { emoji: '😡', label: 'Grrr',    gradient: 'linear-gradient(135deg,#E9710F,#FF5722)' }
    };

    var userReactions  = {};
    var reactionCounts = {};
    var _openPopup     = null;
    var _hoverTimer    = null;
    var _closeTimer    = null;
    var _longPressTimer = null;

    function _loadStorage() {
        try { userReactions = JSON.parse(localStorage.getItem('tj_reactions') || '{}'); } catch(e) { userReactions = {}; }
    }
    function _saveStorage() {
        try { localStorage.setItem('tj_reactions', JSON.stringify(userReactions)); } catch(e) {}
    }

    function _initCounts(pubId) {
        if (!reactionCounts[pubId]) {
            reactionCounts[pubId] = { like:0, love:0, haha:0, wow:0, sad:0, angry:0 };
        }
    }

    function _updateImageButton(pubId, type) {
        var btn   = document.getElementById('react-btn-' + pubId);
        var emoji = document.getElementById('react-emoji-' + pubId);
        var label = document.getElementById('react-label-' + pubId);
        if (!btn) return;
        if (type && REACTIONS[type]) {
            btn.style.background  = REACTIONS[type].gradient;
            btn.style.borderColor = 'transparent';
            btn.style.color       = 'white';
            btn.classList.add('reacted');
            if (emoji) emoji.textContent = REACTIONS[type].emoji;
            if (label) label.textContent = REACTIONS[type].label;
        } else {
            btn.style.background  = '';
            btn.style.borderColor = '';
            btn.style.color       = '';
            btn.classList.remove('reacted');
            if (emoji) emoji.textContent = '👍';
            if (label) label.textContent = "J'aime";
        }
    }

    function _updateReelButton(pubId, type) {
        var btn  = document.getElementById('reel-react-btn-' + pubId);
        var icon = document.getElementById('reel-react-icon-' + pubId);
        if (!btn) return;
        if (type && REACTIONS[type]) {
            btn.style.color = type === 'like' ? '#42A5F5' : type === 'love' ? '#F33E58' : type === 'angry' ? '#E9710F' : '#F7B928';
            if (icon) icon.style.transform = 'scale(1.3)';
        } else {
            btn.style.color = 'white';
            if (icon) icon.style.transform = '';
        }
    }

    function _updateCounter(pubId) {
        var counts  = reactionCounts[pubId] || {};
        var total   = Object.values(counts).reduce(function(s,c){ return s+(c||0); }, 0);
        var totalEl = document.getElementById('totalReactions-' + pubId);
        var pillsEl = document.getElementById('react-pills-' + pubId);
        var cntReel = document.getElementById('reelLikeCount-' + pubId);

        if (totalEl) totalEl.textContent = total;
        if (cntReel) cntReel.textContent = total;

        if (pillsEl) {
            var top = Object.entries(counts)
                .filter(function(e){ return e[1] > 0; })
                .sort(function(a,b){ return b[1]-a[1]; })
                .slice(0,3);
            pillsEl.innerHTML = top.map(function(e){
                return '<span class="react-pill"><span class="pill-emoji">'+REACTIONS[e[0]].emoji+'</span></span>';
            }).join('');
        }
    }

    function _floatEmoji(pubId, emoji, isReel) {
        var btn = isReel
            ? document.getElementById('reel-react-btn-' + pubId)
            : document.getElementById('react-btn-' + pubId);
        if (!btn) return;
        var rect  = btn.getBoundingClientRect();
        var el    = document.createElement('div');
        el.className   = 'reaction-float-notif';
        el.textContent = emoji;
        el.style.left  = (rect.left + rect.width/2 - 20) + 'px';
        el.style.top   = (rect.top + window.scrollY - 10) + 'px';
        document.body.appendChild(el);
        setTimeout(function(){ el.remove(); }, 1000);
    }

    function _sendAPI(pubId, type) {
        fetch('/publication/' + pubId + '/react', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: JSON.stringify({ type: type || null })
        }).catch(function(){});
    }

    return {

        init: function() {
            _loadStorage();
            document.querySelectorAll('[data-id]').forEach(function(card) {
                var pubId = card.getAttribute('data-id');
                if (!pubId) return;
                _initCounts(pubId);
                var saved = userReactions[pubId];
                if (saved) {
                    _updateImageButton(pubId, saved);
                    _updateReelButton(pubId, saved);
                }
                _updateCounter(pubId);
            });
        },

        react: function(pubId, type, mode) {
            _initCounts(pubId);
            var current = userReactions[pubId];
            var counts  = reactionCounts[pubId];

            if (current === type) {
                counts[type] = Math.max(0, (counts[type]||0) - 1);
                delete userReactions[pubId];
                if (mode === 'reel') _updateReelButton(pubId, null);
                else _updateImageButton(pubId, null);
            } else {
                if (current) counts[current] = Math.max(0, (counts[current]||0) - 1);
                counts[type] = (counts[type]||0) + 1;
                userReactions[pubId] = type;
                if (mode === 'reel') _updateReelButton(pubId, type);
                else _updateImageButton(pubId, type);
                _floatEmoji(pubId, REACTIONS[type].emoji, mode === 'reel');
            }

            _updateCounter(pubId);
            _saveStorage();
            this.closePopup(pubId, mode);
            _sendAPI(pubId, userReactions[pubId] || null);
        },

        handleQuickClick: function(pubId, mode, event) {
            var isMobile = window.innerWidth <= 768;
            
            if (isMobile && mode !== 'reel') {
                this.openPopup(pubId, mode);
                var self = this;
                setTimeout(function() {
                    self.closePopup(pubId, mode);
                }, 2500);
            } else {
                var current = userReactions[pubId];
                if (current) this.react(pubId, current, mode);
                else this.react(pubId, 'like', mode);
            }
        },

        startHoverTimer: function(pubId, mode) {
            clearTimeout(_hoverTimer);
            clearTimeout(_closeTimer);
            var self = this;
            _hoverTimer = setTimeout(function(){ self.openPopup(pubId, mode); }, 400);
        },

        startCloseTimer: function(pubId, mode) {
            clearTimeout(_hoverTimer);
            clearTimeout(_closeTimer);
            var self = this;
            _closeTimer = setTimeout(function(){ self.closePopup(pubId, mode); }, 300);
        },

        keepPopupOpen: function(pubId, mode) {
            clearTimeout(_hoverTimer);
            clearTimeout(_closeTimer);
        },

        openPopup: function(pubId, mode) {
            if (_openPopup && _openPopup !== pubId + mode) {
                this.closePopup(_openPopup.replace(mode, ''), mode);
            }
            
            var popupId = (mode === 'reel') ? 'reel-popup-' + pubId : 'react-popup-' + pubId;
            var popup = document.getElementById(popupId);
            
            if (popup) {
                popup.classList.add('visible');
                _openPopup = pubId + mode;
            }
        },

        closePopup: function(pubId, mode) {
            var popupId = (mode === 'reel') ? 'reel-popup-' + pubId : 'react-popup-' + pubId;
            var popup = document.getElementById(popupId);
            
            if (popup) {
                popup.classList.remove('visible');
            }
            
            if (_openPopup === pubId + mode) {
                _openPopup = null;
            }
        },

        startLongPress: function(pubId, mode, event) {
            clearTimeout(_longPressTimer);
            var self = this;
            _longPressTimer = setTimeout(function(){
                event.preventDefault();
                self.openPopup(pubId, mode);
            }, 500);
        },

        cancelLongPress: function() {
            clearTimeout(_longPressTimer);
        },

        showDetailTooltip: function(pubId, anchorEl) {
            this.hideDetailTooltip();
            var counts = reactionCounts[pubId] || {};
            var total  = Object.values(counts).reduce(function(s,c){ return s+(c||0); }, 0);
            if (total === 0) return;

            var tooltip = document.createElement('div');
            tooltip.className = 'reactions-detail-tooltip';
            tooltip.id = 'react-tooltip-global';

            var rows = Object.entries(counts)
                .filter(function(e){ return e[1] > 0; })
                .sort(function(a,b){ return b[1]-a[1]; })
                .map(function(e){
                    return '<div class="tooltip-row"><span>'+REACTIONS[e[0]].emoji+' '+REACTIONS[e[0]].label+'</span><span>'+e[1]+'</span></div>';
                }).join('');

            tooltip.innerHTML = '<div style="font-weight:700;margin-bottom:6px;font-size:.8rem;border-bottom:1px solid rgba(255,255,255,.2);padding-bottom:5px;">Réactions ('+total+')</div>'+rows;
            document.body.appendChild(tooltip);

            var rect = anchorEl.getBoundingClientRect();
            tooltip.style.position = 'fixed';
            tooltip.style.left = rect.left + 'px';
            tooltip.style.top  = (rect.top - tooltip.offsetHeight - 10) + 'px';
            requestAnimationFrame(function(){ tooltip.classList.add('show'); });
        },

        hideDetailTooltip: function() {
            var el = document.getElementById('react-tooltip-global');
            if (el) el.remove();
        }
    };
})();

// Fermer les popups quand on clique ailleurs
document.addEventListener('click', function(e) {
    var isInsideReaction = e.target.closest('.fb-reaction-wrap') || 
                          e.target.closest('[id^="reel-react-wrap-"]') || 
                          e.target.closest('.reactions-popup');
    
    if (!isInsideReaction) {
        document.querySelectorAll('.reactions-popup.visible').forEach(function(popup) {
            popup.classList.remove('visible');
        });
        ReactionSystem._openPopup = null;
        ReactionSystem.hideDetailTooltip();
    }
}, true);

/* ─── VARIABLES GLOBALES ─── */
var tagSuggestionDebounceTimer = null;
var currentActiveTab = '{{ activeTab }}';
var currentPubId = null;
var commentLikes = {};
var reportTargetCommentId = null;
var shareTabCurrent = 'photo';
var videoSort = 'desc';
var imageSort = 'desc';
var originalPageContent = null;
var currentGifPage = 0;
var currentGifQuery = '';
var pendingTranslations = {};
var emojiSearchVisible = false;

function esc(s) {
    if (!s) return '';
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

function showToast(msg, type, duration) {
    var c = {success:'#27ae60', error:'#c0392b', warn:'#e07b39', info:'#2980b9'};
    var t = document.createElement('div');
    t.className = 'toast-notification';
    t.style.background = c[type] || c.success;
    t.innerHTML = msg;
    document.body.appendChild(t);
    setTimeout(function() {
        t.style.opacity='0'; t.style.transition='.3s';
        setTimeout(function(){ t.remove(); }, 300);
    }, duration || 3500);
}

function switchTab(tab) {
    currentActiveTab = tab;
    document.getElementById('panel-video').classList.toggle('active', tab==='video');
    document.getElementById('panel-image').classList.toggle('active', tab==='image');
    document.getElementById('tab-btn-video').classList.toggle('active', tab==='video');
    document.getElementById('tab-btn-image').classList.toggle('active', tab==='image');
}

function searchFeed(feedId, inputId, badgeId, noResId) {
    var q = document.getElementById(inputId).value.trim().toLowerCase();
    var cards = document.querySelectorAll('#'+feedId+' [data-title]');
    var badge = document.getElementById(badgeId);
    var noRes = document.getElementById(noResId);
    var vis = 0;
    cards.forEach(function(c) {
        var m = q==='' || (c.getAttribute('data-title')||'').toLowerCase().includes(q);
        c.style.display = m ? '' : 'none';
        if (m) vis++;
    });
    if (badge) {
        badge.style.display = q ? 'inline-block' : 'none';
        if (q) badge.textContent = vis + ' résultat' + (vis!==1?'s':'');
    }
    if (noRes) noRes.style.display = (vis===0 && q) ? 'block' : 'none';
}

function setSortFeed(feed, dir) {
    if (feed==='video') {
        videoSort = dir;
        document.getElementById('sortVideoAsc').classList.toggle('active', dir==='asc');
        document.getElementById('sortVideoDesc').classList.toggle('active', dir==='desc');
        applySortFeed('reelsFeed', dir);
    } else {
        imageSort = dir;
        document.getElementById('sortImageAsc').classList.toggle('active', dir==='asc');
        document.getElementById('sortImageDesc').classList.toggle('active', dir==='desc');
        applySortFeed('imageFeed', dir);
    }
}

function applySortFeed(feedId, dir) {
    var feed = document.getElementById(feedId); if (!feed) return;
    var cards = Array.from(feed.querySelectorAll('[data-date]'));
    cards.sort(function(a,b) {
        var da = a.getAttribute('data-date')||'';
        var db = b.getAttribute('data-date')||'';
        return dir==='asc' ? da.localeCompare(db) : db.localeCompare(da);
    });
    cards.forEach(function(card){ feed.appendChild(card); });
}

function saveOriginalPageContent() {
    if (!originalPageContent) {
        var c = document.querySelector('.container');
        if (c) originalPageContent = c.cloneNode(true);
    }
}

async function translatePage(targetLang) {
    if (targetLang === 'fr') { resetPageTranslation(); return; }
    saveOriginalPageContent();
    var els = document.querySelectorAll('[data-translate="true"]');
    if (!els.length) { showToast('⚠️ Aucun texte à traduire', 'warn'); return; }
    showToast('🌐 Traduction en cours...', 'info', 2000);
    for (var el of els) {
        var ot = el.getAttribute('data-original-text') || el.textContent;
        if (!ot || ot.trim().length < 3) continue;
        if (!el.getAttribute('data-original-text')) el.setAttribute('data-original-text', ot);
        try {
            var resp = await fetch('/api/translation/translate-page', {
                method:'POST',
                headers:{'Content-Type':'application/json'},
                body:JSON.stringify({text:ot, targetLang:targetLang})
            });
            var data = await resp.json();
            if (data.success) el.textContent = data.translated;
        } catch(e) {}
    }
    showToast('✅ Page traduite !', 'success');
}

function resetPageTranslation() {
    if (originalPageContent) {
        var c = document.querySelector('.container');
        if (c) {
            c.innerHTML = originalPageContent.innerHTML;
            originalPageContent = null;
            showToast('🔄 Page restaurée', 'success');
        }
        var sv = document.getElementById('pageLangSelect');
        var si = document.getElementById('pageLangSelectImage');
        if (sv) sv.value = 'fr';
        if (si) si.value = 'fr';
    }
}

function toggleReelVideo(pubId) {
    var video = document.getElementById('reelVideo-'+pubId); if (!video) return;
    if (video.paused) video.play(); else video.pause();
}

async function loadDynamicEmojis() {
    var emojiList = document.getElementById('emojiList'); if (!emojiList) return;
    emojiList.innerHTML = '<span style="font-size:.7rem;color:#aaa;"><i class="fas fa-spinner fa-spin"></i> Chargement...</span>';
    try {
        var emojis = await window.EmojiService.getTravelEmojis(30);
        if (emojis && emojis.length > 0) {
            var html = '';
            emojis.forEach(function(emoji) {
                var c = emoji.character||emoji.emoji||emoji;
                html += '<button type="button" class="emoji-btn" onclick="addEmoji(\''+c+'\')">'+c+'</button>';
            });
            emojiList.innerHTML = html;
        }
    } catch(e) { emojiList.innerHTML = '<span>⚠️ Erreur</span>'; }
}

function toggleEmojiSearch() {
    var c = document.getElementById('emojiSearchContainer');
    emojiSearchVisible = !emojiSearchVisible;
    c.style.display = emojiSearchVisible ? 'block' : 'none';
}

async function searchEmojis() {
    var query = document.getElementById('emojiSearchInput').value.trim();
    var res = document.getElementById('emojiSearchResults');
    if (!query) return;
    res.innerHTML = '<span>Recherche...</span>';
    try {
        var emojis = await window.EmojiService.searchEmojis(query, 20);
        if (emojis && emojis.length > 0) {
            var html = '';
            emojis.forEach(function(e) {
                var c = e.character||e.emoji||e;
                html += '<button type="button" class="emoji-btn" onclick="addEmoji(\''+c+'\');toggleEmojiSearch();">'+c+'</button>';
            });
            res.innerHTML = html;
        } else res.innerHTML = '<span>Aucun résultat</span>';
    } catch(e) {}
}

async function refreshEmojis() {
    window.EmojiService.clearCache();
    await loadDynamicEmojis();
    showToast('✨ Emojis actualisés', 'success');
}

function addEmoji(e) {
    var ta = document.getElementById('modalCommentText');
    var pos = ta.selectionStart || ta.value.length;
    ta.value = ta.value.slice(0,pos) + e + ta.value.slice(pos);
    ta.focus();
}

/* ★ FIX : Génération de tags améliorée (seuil à 5 caractères) ★ */
function handleCommentInput(textarea) {
    var text = textarea.value;

    if (window.checkBadWords) {
        var ok = window.checkBadWords('modalCommentText', 'badWordsErrorModal', 'badWordsErrorTextModal');
        var submitBtn = document.getElementById('modalSubmitBtn');
        if (submitBtn) submitBtn.disabled = !ok;
    }

    clearTimeout(tagSuggestionDebounceTimer);
    if (text.trim().length >= 5) {
        tagSuggestionDebounceTimer = setTimeout(function(){ fetchAITags(text); }, 600);
    } else {
        var container = document.getElementById('aiTagsContainer');
        if (container) {
            container.innerHTML = '<span style="font-size:.75rem;color:#aaa;font-style:italic;"><i class="fas fa-magic" style="font-size:.65rem;margin-right:3px;"></i> ✨ Écrivez votre commentaire pour des suggestions de tags</span>';
        }
    }
}

async function fetchAITags(commentText) {
    if (!commentText || commentText.trim().length < 5) return;
    var container = document.getElementById('aiTagsContainer');
    if (!container) return;
    container.innerHTML = '<span style="font-size:.75rem;color:#aaa;"><i class="fas fa-spinner fa-spin"></i> Analyse IA en cours...</span>';
    try {
        var existingTags = document.getElementById('modalCommentTags') ? document.getElementById('modalCommentTags').value : '';
        var response = await fetch('/api/tags/suggest', {
            method:'POST',
            headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
            body:JSON.stringify({text:commentText, existingTags:existingTags, maxTags:6})
        });
        if (!response.ok) { throw new Error('HTTP '+response.status); }
        var data = await response.json();
        if (data.success && data.tags && data.tags.length > 0) {
            var html = '<div style="display:flex;flex-wrap:wrap;gap:6px;align-items:center;">'
                + '<span style="font-size:.7rem;color:var(--dr);font-weight:700;">🤖 IA suggère :</span>';
            data.tags.forEach(function(tag) {
                html += '<button class="ai-tag-suggestion" onclick="addTag(\''+esc(tag)+'\')">✦ #'+esc(tag)+'</button>';
            });
            html += '</div>';
            container.innerHTML = html;
        } else {
            container.innerHTML = '<span style="font-size:.75rem;color:#aaa;font-style:italic;">✍️ Continuez à écrire pour des suggestions...</span>';
        }
    } catch(e) {
        console.warn('[Tags] Erreur API:', e.message);
        container.innerHTML = '<span style="font-size:.75rem;color:#bbb;font-style:italic;">⚠️ Suggestions indisponibles</span>';
    }
}

function addTag(tag) {
    var i = document.getElementById('modalCommentTags');
    var c = i.value.trim();
    i.value = c ? c + ', ' + tag : tag;
}

/* ─── MODAL COMMENTAIRE ─── */
async function loadComments(pubId) {
    var list = document.getElementById('modalCommentsList');
    var badge = document.getElementById('commentsCountBadge');
    if (!list) return;
    list.innerHTML = '<div class="empty-comments-modal"><i class="fas fa-spinner fa-spin"></i><p>Chargement...</p></div>';
    try {
        var response = await fetch('/commentaire/publication/'+pubId+'/comments', {
            headers:{'X-Requested-With':'XMLHttpRequest','Accept':'application/json'}
        });
        var data = await response.json();
        if (data.success && data.comments && data.comments.length > 0) {
            badge.textContent = data.total + ' commentaire' + (data.total>1?'s':'');
            list.innerHTML = data.comments.map(function(comment) {
                if (!commentLikes[comment.id]) {
                    commentLikes[comment.id] = {liked:false, count:comment.likes||0};
                }
                var ld = commentLikes[comment.id];
                var renderedText = window.renderCommentText ? window.renderCommentText(comment.description) : esc(comment.description).replace(/\n/g,'<br>');
                return '<div class="comment-item" id="cmt-'+comment.id+'">' +
                    '<div style="display:flex;align-items:center;gap:8px;margin-bottom:5px;">' +
                    '<div style="width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,var(--dr),var(--soft));display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:.7rem;">V</div>' +
                    '<span style="font-weight:700;color:var(--dark);font-size:.82rem;">Voyageur</span>' +
                    '<span style="font-size:.68rem;color:#aaa;">'+esc(comment.date)+'</span></div>' +
                    '<div class="comment-item-text" id="cmt-text-'+comment.id+'">'+renderedText+'</div>' +
                    '<div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap;">' +
                    '<button class="like-comment-btn" onclick="likeComment('+comment.id+')">' +
                    '<span id="lcHeart-'+comment.id+'">'+(ld.liked?'❤️':'🤍')+'</span>' +
                    '<span id="lcCount-'+comment.id+'">'+ld.count+'</span></button>' +
                    '<button class="reply-comment-btn" onclick="toggleReply('+comment.id+')">Répondre</button>' +
                    '<button class="btn-report-comment" onclick="openReportModal('+comment.id+')">Signaler</button>' +
                    '<div style="margin-left:auto;display:flex;gap:6px;align-items:center;">'+buildLangButton(comment.id)+'</div></div>' +
                    '<div id="replyForm-'+comment.id+'" style="display:none;margin-top:8px;">' +
                    '<textarea id="replyTxt-'+comment.id+'" style="width:100%;border:1.5px solid var(--border);border-radius:10px;padding:8px 12px;font-size:.8rem;resize:none;box-sizing:border-box;font-family:inherit;" rows="2" placeholder="Votre réponse..."></textarea>' +
                    '<div style="display:flex;gap:6px;margin-top:6px;">' +
                    '<button style="background:var(--dr);color:white;border:none;padding:6px 14px;border-radius:20px;font-size:.72rem;cursor:pointer;font-weight:600;" onclick="submitReply('+comment.id+')">Répondre</button>' +
                    '<button style="background:#F5F0E8;color:#4A3B2F;border:none;padding:6px 12px;border-radius:20px;font-size:.72rem;cursor:pointer;" onclick="toggleReply('+comment.id+')">Annuler</button></div></div>' +
                    '<div class="comment-translate-bar" id="translateBar-'+comment.id+'">' +
                    '<span class="translate-preview-text" id="translatePreview-'+comment.id+'"></span>' +
                    '<button class="btn-replace-translation" onclick="replaceCommentInline('+comment.id+')"><i class="fas fa-check"></i> Remplacer</button>' +
                    '<button class="btn-cancel-translation" onclick="cancelTranslation('+comment.id+')">Annuler</button></div></div>';
            }).join('');
        } else {
            badge.textContent = '0 commentaire';
            list.innerHTML = '<div class="empty-comments-modal"><i class="fas fa-comment-dots"></i><p>Soyez le premier à commenter !</p></div>';
        }
    } catch(error) {
        list.innerHTML = '<div class="empty-comments-modal" style="color:#c0392b;"><i class="fas fa-exclamation-circle"></i><p>Erreur lors du chargement</p></div>';
    }
}

async function openCommentModal(pubId, title, desc) {
    currentPubId = pubId;
    document.getElementById('previewTitle').textContent = title;
    document.getElementById('previewDesc').textContent = desc;
    document.getElementById('modalCommentText').value = '';
    document.getElementById('modalCommentTags').value = '';

    var bwErr = document.getElementById('badWordsErrorModal');
    if (bwErr) bwErr.classList.remove('visible');
    var ta = document.getElementById('modalCommentText');
    if (ta) { ta.style.borderColor = ''; ta.style.boxShadow = ''; }
    var submitBtn = document.getElementById('modalSubmitBtn');
    if (submitBtn) submitBtn.disabled = false;

    var aiContainer = document.getElementById('aiTagsContainer');
    if (aiContainer) {
        aiContainer.innerHTML = '<span style="font-size:.75rem;color:#aaa;font-style:italic;"><i class="fas fa-magic" style="font-size:.65rem;margin-right:3px;"></i> ✨ Écrivez votre commentaire pour des suggestions de tags</span>';
    }

    document.getElementById('commentModal').classList.add('open');
    document.body.style.overflow = 'hidden';
    await loadComments(pubId);
    await loadDynamicEmojis();
}

function closeCommentModal() {
    document.getElementById('commentModal').classList.remove('open');
    document.body.style.overflow = '';
    currentPubId = null;
}

async function submitComment() {
    if (!currentPubId) return;

    var text = document.getElementById('modalCommentText').value;
    var tags = document.getElementById('modalCommentTags').value;

    if (window.BadWordsService && window.BadWordsService.containsBadWords(text)) {
        showToast('🚫 Votre commentaire contient des mots inappropriés. Veuillez le reformuler.', 'error', 5000);
        return;
    }

    var btn = document.getElementById('modalSubmitBtn');
    var orig = btn.innerHTML;
    btn.innerHTML = '<span class="loading-spinner"></span> Publication...';
    btn.disabled = true;
    try {
        var r = await fetch('/commentaire/api/new/'+currentPubId, {
            method:'POST',
            headers:{'Content-Type':'application/json','Accept':'application/json','X-Requested-With':'XMLHttpRequest'},
            body:JSON.stringify({description:text, tags:tags})
        });
        var data = await r.json();
        if (data.success) {
            document.getElementById('modalCommentText').value = '';
            document.getElementById('modalCommentTags').value = '';
            var bwErr = document.getElementById('badWordsErrorModal');
            if (bwErr) bwErr.classList.remove('visible');
            var taEl = document.getElementById('modalCommentText');
            if (taEl) { taEl.style.borderColor = ''; taEl.style.boxShadow = ''; }
            await loadComments(currentPubId);
            var ci = document.getElementById('commentCount-i-'+currentPubId);
            var cr = document.getElementById('reelComCount-'+currentPubId);
            if (ci) ci.textContent = data.total;
            if (cr) cr.textContent = data.total;
            showToast('✅ Commentaire publié !', 'success');
        } else {
            showToast('❌ '+(data.error||'Erreur'), 'error');
        }
    } catch(e) { showToast('❌ Erreur', 'error'); }
    finally { btn.innerHTML = orig; btn.disabled = false; }
}

function likeComment(id) {
    if (!commentLikes[id]) commentLikes[id] = {liked:false, count:0};
    var d = commentLikes[id];
    d.liked = !d.liked;
    d.count += d.liked ? 1 : -1;
    var h = document.getElementById('lcHeart-'+id);
    var cnt = document.getElementById('lcCount-'+id);
    if (h) h.textContent = d.liked ? '❤️' : '🤍';
    if (cnt) cnt.textContent = d.count;
}

function toggleReply(id) {
    var f = document.getElementById('replyForm-'+id);
    if (f) f.style.display = f.style.display==='none' ? 'block' : 'none';
}

async function submitReply(commentId) {
    var ta = document.getElementById('replyTxt-'+commentId);
    var text = ta ? ta.value.trim() : '';
    if (!text) return;

    if (window.BadWordsService && window.BadWordsService.containsBadWords(text)) {
        showToast('🚫 Votre réponse contient des mots inappropriés.', 'error', 4000);
        return;
    }

    try {
        var r = await fetch('/commentaire/api/new/'+currentPubId, {
            method:'POST',
            headers:{'Content-Type':'application/json','Accept':'application/json'},
            body:JSON.stringify({description:text, tags:''})
        });
        var data = await r.json();
        if (data.success) { ta.value=''; toggleReply(commentId); showToast('💬 Réponse publiée !','success'); }
    } catch(e) {}
}

function buildLangButton(commentId) {
    return '<select id="langSelect-'+commentId+'" style="padding:3px 8px;border-radius:14px;border:1px solid #E8DFD1;background:white;font-size:.7rem;cursor:pointer;outline:none;color:#555;max-width:120px;">' +
        '<option value="">🌐 Langue</option><option value="fr">Français</option><option value="en">English</option>' +
        '<option value="ar">العربية</option><option value="es">Español</option><option value="de">Deutsch</option>' +
