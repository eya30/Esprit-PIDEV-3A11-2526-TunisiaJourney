{% block body %}

{% set pubs_video = paginationVideo %}
{% set pubs_image = paginationImage %}

<section class="hero">
    <div class="hero-content">
        <h1 data-translate="true">Forum des Voyageurs</h1>
        <p data-translate="true">Partagez vos expériences en Tunisie, posez vos questions et connectez-vous avec des passionnés.</p>
        <div class="hero-stats">
            <div class="stat-item">
                <div class="stat-value">{{ totalPublications }}</div>
                <div class="stat-label" data-translate="true">Publications</div>
            </div>
            <div class="stat-item">
                <div class="stat-value">{{ forums|length }}</div>
                <div class="stat-label" data-translate="true">Forums</div>
            </div>
            <div class="stat-item">
                <div class="stat-value">{{ totalComments }}</div>
                <div class="stat-label" data-translate="true">Commentaires</div>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">

        <div style="text-align:center;margin-bottom:2rem;">
            <button class="btn-share-adventure" onclick="openShareModal()">
                <i class="fas fa-plus-circle"></i>
                <span data-translate="true">Partager votre aventure</span>
            </button>
            <p style="font-size:.78rem;color:#aaa;margin-top:.5rem;">
                <i class="fas fa-info-circle" style="color:#C49A6C;"></i>
                <span data-translate="true">Votre publication apparaîtra dans votre profil voyageur</span>
            </p>
        </div>

        <div class="nav-tabs-wrap mb-4">
            <button class="nav-tab {{ activeTab == 'video' ? 'active' : '' }}" id="tab-btn-video" onclick="switchTab('video')">
                <i class="fas fa-play-circle"></i>
                <span data-translate="true">Reels — Vidéos</span>
                <span class="tab-count">{{ totalVideo }}</span>
            </button>
            <button class="nav-tab {{ activeTab == 'image' ? 'active' : '' }}" id="tab-btn-image" onclick="switchTab('image')">
                <i class="fas fa-image"></i>
                <span data-translate="true">Photos — Votre avis</span>
                <span class="tab-count">{{ totalImage }}</span>
            </button>
        </div>

        {# ONGLET VIDÉOS #}
        <div class="tab-panel {{ activeTab == 'video' ? 'active' : '' }}" id="panel-video">
            <div class="filters-bar">
                <div class="search-wrapper">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" id="searchVideo" class="search-input-pub"
                           placeholder="🔍 Rechercher une vidéo..."
                           oninput="searchFeed('reelsFeed','searchVideo','badgeVideo','noVideo')"
                           autocomplete="off">
                </div>
                <span class="search-results-badge" id="badgeVideo"></span>
                <div class="sort-bar">
                    <span class="sort-label"><i class="fas fa-sort me-1"></i><span data-translate="true">Trier :</span></span>
                    <button class="sort-btn" id="sortVideoAsc" onclick="setSortFeed('video','asc')">
                        <i class="fas fa-sort-amount-up-alt"></i> <span data-translate="true">Anciens</span>
                    </button>
                    <button class="sort-btn active" id="sortVideoDesc" onclick="setSortFeed('video','desc')">
                        <i class="fas fa-sort-amount-down"></i> <span data-translate="true">Récents</span>
                    </button>
                </div>
                <div class="lang-wrapper">
                    <i class="fas fa-language"></i>
                    <select id="pageLangSelect" class="lang-select">
                        <option value="fr" selected>🇫🇷 Français</option>
                        <option value="en">🇬🇧 English</option>
                        <option value="ar">🇸🇦 العربية</option>
                        <option value="es">🇪🇸 Español</option>
                        <option value="de">🇩🇪 Deutsch</option>
                        <option value="it">🇮🇹 Italiano</option>
                        <option value="pt">🇵🇹 Português</option>
                        <option value="ru">🇷🇺 Русский</option>
                    </select>
                    <button id="resetTranslationBtn" class="lang-refresh-btn" title="Réinitialiser">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                </div>
            </div>

            <h2 class="section-title" data-translate="true">🎬 Reels — Vivez le voyage</h2>
            <p class="section-subtitle" data-translate="true">Faites défiler les vidéos inspirantes de nos voyageurs</p>

            {% if pubs_video.totalItemCount > 0 %}
            <p class="pagination-info">
                Page <strong>{{ pubs_video.currentPageNumber }}</strong> sur
                <strong>{{ pubs_video.pageCount }}</strong>
                — <strong>{{ pubs_video.totalItemCount }}</strong> vidéo{{ pubs_video.totalItemCount > 1 ? 's' : '' }} au total
            </p>
            {% endif %}

            <div class="reels-feed" id="reelsFeed">
                {% for pub in pubs_video %}
                <div class="reel-card"
                     data-id="{{ pub.idP }}"
                     data-title="{{ pub.nom|lower }}"
                     data-date="{{ pub.dateCreation|date('Y-m-d') }}"
                     id="reel-{{ pub.idP }}">
                    <span class="reel-badge">{{ pub.forum.nom }}</span>
                    <div class="reel-video-wrap" id="reelMedia-{{ pub.idP }}">
                        {% if pub.isYoutubeVideo() and pub.youtubeId %}
                            <iframe id="reelIframe-{{ pub.idP }}"
                                    src="https://www.youtube.com/embed/{{ pub.youtubeId }}?enablejsapi=1&rel=0&modestbranding=1&mute=1&loop=1&playlist={{ pub.youtubeId }}"
                                    title="{{ pub.nom }}" allowfullscreen loading="lazy"
                                    allow="autoplay; encrypted-media"></iframe>
                        {% elseif pub.isVimeoVideo() and pub.vimeoId %}
                            <iframe id="reelIframe-{{ pub.idP }}"
                                    src="https://player.vimeo.com/video/{{ pub.vimeoId }}?autoplay=0&loop=1&muted=1&dnt=1"
                                    title="{{ pub.nom }}" allowfullscreen loading="lazy"
                                    allow="autoplay"></iframe>
                        {% else %}
                            <video id="reelVideo-{{ pub.idP }}"
                                   src="{{ pub.video starts with 'http' ? pub.video : asset('uploads/publications/' ~ pub.video) }}"
                                   preload="metadata" muted loop playsinline
                                   style="cursor:pointer;"
                                   onclick="toggleReelVideo({{ pub.idP }})"></video>
                        {% endif %}
                    </div>
                    <div class="reel-overlay"></div>
                    <div class="reel-info">
                        <div class="reel-title" data-translate="true">{{ pub.nom }}</div>
                        <div class="reel-desc" data-translate="true">
                            {{ pub.description|slice(0,90)|default('') }}{% if pub.description|length > 90 %}…{% endif %}
                        </div>
                    </div>
                    <div class="reel-actions">
                        <div style="display:flex;flex-direction:column;align-items:center;gap:3px;">
                            <div id="reel-react-wrap-{{ pub.idP }}" style="position:relative;">
                                <button class="reel-action-btn"
                                        id="reel-react-btn-{{ pub.idP }}"
                                        onclick="ReactionSystem.handleQuickClick({{ pub.idP }},'reel', event)"
                                        onmouseenter="ReactionSystem.startHoverTimer({{ pub.idP }},'reel')"
                                        onmouseleave="ReactionSystem.startCloseTimer({{ pub.idP }},'reel')"
                                        style="flex-direction:column;align-items:center;">
                                    <i class="fas fa-heart" id="reel-react-icon-{{ pub.idP }}"></i>
                                    <span id="reelLikeCount-{{ pub.idP }}">0</span>
                                </button>
                                <div class="reactions-popup" id="reel-popup-{{ pub.idP }}"
                                     onmouseenter="ReactionSystem.keepPopupOpen({{ pub.idP }},'reel')"
                                     onmouseleave="ReactionSystem.startCloseTimer({{ pub.idP }},'reel')">
                                    <div class="reaction-option" onclick="ReactionSystem.react({{ pub.idP }},'like','reel')" title="J'aime"><span class="r-emoji">👍</span><span class="r-label">J'aime</span></div>
                                    <div class="reaction-option" onclick="ReactionSystem.react({{ pub.idP }},'love','reel')" title="J'adore"><span class="r-emoji">❤️</span><span class="r-label">J'adore</span></div>
                                    <div class="reaction-option" onclick="ReactionSystem.react({{ pub.idP }},'haha','reel')" title="Haha"><span class="r-emoji">😂</span><span class="r-label">Haha</span></div>
                                    <div class="reaction-option" onclick="ReactionSystem.react({{ pub.idP }},'wow','reel')" title="Wouah"><span class="r-emoji">😮</span><span class="r-label">Wouah</span></div>
                                    <div class="reaction-option" onclick="ReactionSystem.react({{ pub.idP }},'sad','reel')" title="Triste"><span class="r-emoji">😢</span><span class="r-label">Triste</span></div>
                                    <div class="reaction-option" onclick="ReactionSystem.react({{ pub.idP }},'angry','reel')" title="Grrr"><span class="r-emoji">😡</span><span class="r-label">Grrr</span></div>
                                </div>
                            </div>
                        </div>
                        <div class="reel-action-btn"
                             onclick="openCommentModal({{ pub.idP }},'{{ pub.nom|e('js') }}','{{ pub.description|slice(0,100)|e('js') }}')">
                            <i class="fas fa-comment"></i>
                            <span id="reelComCount-{{ pub.idP }}">{{ pub.commentaires|length }}</span>
                        </div>
                        <a href="{{ path('app_publication_watch', {'idP': pub.idP}) }}"
                           class="reel-action-btn" style="color:white;text-decoration:none;">
                            <i class="fas fa-expand"></i>
                            <span data-translate="true">Voir</span>
                        </a>
                    </div>
                </div>
                {% else %}
                <div style="text-align:center;padding:4rem;color:#aaa;background:white;border-radius:20px;border:1px solid var(--border);">
                    <i class="fas fa-video" style="font-size:4rem;opacity:.2;margin-bottom:1rem;display:block;"></i>
                    <h3 style="color:var(--dr);" data-translate="true">Aucune vidéo pour le moment</h3>
                </div>
                {% endfor %}
                <div class="no-results-msg" id="noVideo">
                    <h3 style="color:var(--dr);" data-translate="true">Aucun résultat</h3>
                </div>
            </div>

            {% if pubs_video.pageCount > 1 %}
            <div class="pagination-wrapper">
                {{ knp_pagination_render(pubs_video) }}
            </div>
            {% endif %}
        </div>

        {# ONGLET IMAGES #}
        <div class="tab-panel {{ activeTab == 'image' ? 'active' : '' }}" id="panel-image">
            <div class="filters-bar">
                <div class="search-wrapper">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" id="searchImage" class="search-input-pub"
                           placeholder="🔍 Rechercher par titre..."
                           oninput="searchFeed('imageFeed','searchImage','badgeImage','noImage')"
                           autocomplete="off">
                </div>
                <span class="search-results-badge" id="badgeImage"></span>
                <div class="sort-bar">
                    <span class="sort-label"><i class="fas fa-sort me-1"></i><span data-translate="true">Trier :</span></span>
                    <button class="sort-btn" id="sortImageAsc" onclick="setSortFeed('image','asc')">
                        <i class="fas fa-sort-amount-up-alt"></i> <span data-translate="true">Anciens</span>
                    </button>
                    <button class="sort-btn active" id="sortImageDesc" onclick="setSortFeed('image','desc')">
                        <i class="fas fa-sort-amount-down"></i> <span data-translate="true">Récents</span>
                    </button>
                </div>
                <div class="lang-wrapper">
                    <i class="fas fa-language"></i>
                    <select id="pageLangSelectImage" class="lang-select">
                        <option value="fr" selected>🇫🇷 Français</option>
                        <option value="en">🇬🇧 English</option>
                        <option value="ar">🇸🇦 العربية</option>
                        <option value="es">🇪🇸 Español</option>
                        <option value="de">🇩🇪 Deutsch</option>
                        <option value="it">🇮🇹 Italiano</option>
                        <option value="pt">🇵🇹 Português</option>
                        <option value="ru">🇷🇺 Русский</option>
                    </select>
                    <button id="resetTranslationBtnImage" class="lang-refresh-btn" title="Réinitialiser">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                </div>
            </div>

            <h2 class="section-title" data-translate="true">📸 Donnez-nous votre avis</h2>
            <p class="section-subtitle" data-translate="true">Découvrez les plus beaux clichés et partagez votre expérience</p>

            {% if pubs_image.totalItemCount > 0 %}
            <p class="pagination-info">
                Page <strong>{{ pubs_image.currentPageNumber }}</strong> sur
                <strong>{{ pubs_image.pageCount }}</strong>
                — <strong>{{ pubs_image.totalItemCount }}</strong> photo{{ pubs_image.totalItemCount > 1 ? 's' : '' }} au total
            </p>
            {% endif %}

            <div class="fb-feed" id="imageFeed">
                {% for pub in pubs_image %}
                <div class="card-image"
                     data-id="{{ pub.idP }}"
                     data-title="{{ pub.nom|lower }}"
                     data-date="{{ pub.dateCreation|date('Y-m-d') }}">
                    <div class="post-header">
                        <div class="author-avatar">T</div>
                        <div class="author-name">TunisiaJourney</div>
                    </div>
                    <div class="post-body">
                        <h3 class="card-image-title" data-translate="true">{{ pub.nom }}</h3>
                        <p class="card-image-desc" data-translate="true">
                            {{ pub.description|slice(0,140)|default('') }}{% if pub.description|length > 140 %}…{% endif %}
                        </p>
                    </div>
                    <div class="card-image-media"
                         onclick="openCommentModal({{ pub.idP }},'{{ pub.nom|e('js') }}','{{ pub.description|slice(0,100)|e('js') }}')">
                        <img src="{{ pub.image starts with 'http' ? pub.image : asset('uploads/publications/' ~ pub.image) }}"
                             alt="{{ pub.nom }}" loading="lazy">
                    </div>
                    <div class="reactions-bar">
                        <div class="reactions-summary-bar" id="react-bar-{{ pub.idP }}"
                             onmouseenter="ReactionSystem.showDetailTooltip({{ pub.idP }}, this)"
                             onmouseleave="ReactionSystem.hideDetailTooltip()">
                            <span id="react-pills-{{ pub.idP }}"></span>
                            <span class="react-total" id="totalReactions-{{ pub.idP }}">0</span>
                            <span style="font-size:.72rem;" data-translate="true"> réactions</span>
                        </div>
                        <span>
                            <i class="fas fa-comment"></i>
                            <span id="commentCount-i-{{ pub.idP }}">{{ pub.commentaires|length }}</span>
                            <span data-translate="true"> commentaires</span>
                        </span>
                    </div>
                    <div class="post-footer">
                        <div class="fb-reaction-wrap" id="react-wrap-{{ pub.idP }}">
                            <button class="btn-fb-react"
                                    id="react-btn-{{ pub.idP }}"
                                    onclick="ReactionSystem.handleQuickClick({{ pub.idP }},'image', event)"
                                    onmouseenter="ReactionSystem.startHoverTimer({{ pub.idP }},'image')"
                                    onmouseleave="ReactionSystem.startCloseTimer({{ pub.idP }},'image')"
                                    ontouchstart="ReactionSystem.startLongPress({{ pub.idP }},'image',event)"
                                    ontouchend="ReactionSystem.cancelLongPress()">
                                <span class="react-emoji" id="react-emoji-{{ pub.idP }}">👍</span>
                                <span class="react-label" id="react-label-{{ pub.idP }}" data-translate="true">J'aime</span>
                            </button>
                            <div class="reactions-popup" id="react-popup-{{ pub.idP }}"
                                 onmouseenter="ReactionSystem.keepPopupOpen({{ pub.idP }},'image')"
                                 onmouseleave="ReactionSystem.startCloseTimer({{ pub.idP }},'image')">
                                <div class="reaction-option" onclick="ReactionSystem.react({{ pub.idP }},'like','image')" title="J'aime"><span class="r-emoji">👍</span><span class="r-label">J'aime</span></div>
                                <div class="reaction-option" onclick="ReactionSystem.react({{ pub.idP }},'love','image')" title="J'adore"><span class="r-emoji">❤️</span><span class="r-label">J'adore</span></div>
                                <div class="reaction-option" onclick="ReactionSystem.react({{ pub.idP }},'haha','image')" title="Haha"><span class="r-emoji">😂</span><span class="r-label">Haha</span></div>
                                <div class="reaction-option" onclick="ReactionSystem.react({{ pub.idP }},'wow','image')" title="Wouah"><span class="r-emoji">😮</span><span class="r-label">Wouah</span></div>
                                <div class="reaction-option" onclick="ReactionSystem.react({{ pub.idP }},'sad','image')" title="Triste"><span class="r-emoji">😢</span><span class="r-label">Triste</span></div>
                                <div class="reaction-option" onclick="ReactionSystem.react({{ pub.idP }},'angry','image')" title="Grrr"><span class="r-emoji">😡</span><span class="r-label">Grrr</span></div>
                            </div>
                        </div>
                        <button class="btn-comment-inline"
                                onclick="openCommentModal({{ pub.idP }},'{{ pub.nom|e('js') }}','{{ pub.description|slice(0,100)|e('js') }}')">
                            <i class="fas fa-comment"></i> <span data-translate="true">Commenter</span>
                        </button>
                    </div>
                </div>
                {% else %}
                <div style="text-align:center;padding:4rem;color:#aaa;background:white;border-radius:20px;border:1px solid var(--border);">
                    <i class="fas fa-image" style="font-size:4rem;opacity:.2;margin-bottom:1rem;display:block;"></i>
                    <h3 style="color:var(--dr);" data-translate="true">Aucune photo pour le moment</h3>
                </div>
                {% endfor %}
                <div class="no-results-msg" id="noImage">
                    <h3 style="color:var(--dr);" data-translate="true">Aucun résultat</h3>
                </div>
            </div>

            {% if pubs_image.pageCount > 1 %}
            <div class="pagination-wrapper">
                {{ knp_pagination_render(pubs_image) }}
            </div>
            {% endif %}
        </div>

    </div>
</section>

{# MODAL COMMENTAIRE #}
<div class="comment-modal" id="commentModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3><i class="fas fa-comment-dots" style="color:var(--dr);"></i> <span data-translate="true">Commenter</span></h3>
            <button class="modal-close" onclick="closeCommentModal()">✕</button>
        </div>
        <div class="publication-preview" id="publicationPreview">
            <h4 id="previewTitle">—</h4><p id="previewDesc">—</p>
        </div>
        <div class="modal-body">
            <div class="emoji-strip" id="dynamicEmojiStrip">
                <div style="display:flex;gap:8px;align-items:center;width:100%;flex-wrap:wrap;">
                    <div id="emojiList" style="display:flex;gap:6px;flex-wrap:wrap;flex:1;">
                        <span style="font-size:.7rem;color:#aaa;"><i class="fas fa-spinner fa-spin"></i> Chargement...</span>
                    </div>
                    <div style="display:flex;gap:4px;">
                        <button type="button" class="emoji-btn" style="background:linear-gradient(135deg,#667eea,#764ba2);color:white;" onclick="toggleEmojiSearch()"><i class="fas fa-search"></i></button>
                        <button type="button" class="emoji-btn" onclick="refreshEmojis()"><i class="fas fa-sync-alt"></i></button>
                    </div>
                </div>
                <div id="emojiSearchContainer" style="display:none;margin-top:10px;width:100%;">
                    <div style="display:flex;gap:8px;">
                        <input type="text" id="emojiSearchInput" placeholder="Rechercher un emoji..."
                               style="flex:1;padding:8px 12px;border:1px solid var(--border);border-radius:20px;font-size:.8rem;">
                        <button onclick="searchEmojis()" style="background:linear-gradient(135deg,var(--dr),var(--or));color:white;border:none;padding:8px 16px;border-radius:20px;cursor:pointer;">Rechercher</button>
                    </div>
                    <div id="emojiSearchResults" style="display:flex;gap:6px;flex-wrap:wrap;margin-top:10px;max-height:150px;overflow-y:auto;padding:8px;background:var(--bg-warm);border-radius:12px;"></div>
                </div>
            </div>
            <div style="display:flex;justify-content:space-between;margin-bottom:8px;gap:8px;">
                <button type="button" class="btn-gif" onclick="openGifPicker()"><i class="fas fa-grin-tears"></i> GIF</button>
                <button type="button" id="micBtn"
                        onclick="toggleSpeechRecognition('modalCommentText')"
                        style="background:linear-gradient(135deg,#3B82F6,#2563EB);color:white;border:none;padding:6px 14px;border-radius:20px;font-size:.75rem;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:6px;">
                    <i class="fas fa-microphone"></i> Dicter
                </button>
            </div>

            <div class="bad-words-error" id="badWordsErrorModal">
                <i class="fas fa-exclamation-triangle"></i>
                <span id="badWordsErrorTextModal"></span>
            </div>

            <div class="symfony-error" id="errorDescription">
                <i class="fas fa-exclamation-circle"></i><span id="errorDescriptionText"></span>
            </div>
            <textarea class="comment-textarea" id="modalCommentText" rows="4"
                      placeholder="Partagez votre expérience... (3 à 500 caractères)"
                      oninput="handleCommentInput(this)"></textarea>
            <div class="symfony-error" id="errorTags" style="margin-top:8px;">
                <i class="fas fa-exclamation-circle"></i><span id="errorTagsText"></span>
            </div>
            <input type="text" class="comment-tags-input" id="modalCommentTags"
                   placeholder="🏷️ Tags : voyage, plage, culture...">
            <div id="aiTagsContainer" class="ai-tags-container">
                <span style="font-size:.75rem;color:#aaa;font-style:italic;">
                    <i class="fas fa-magic" style="font-size:.65rem;margin-right:3px;"></i>
                    ✨ Écrivez votre commentaire pour des suggestions de tags
                </span>
            </div>
            <button class="modal-submit" id="modalSubmitBtn" onclick="submitComment()">
                <i class="fas fa-paper-plane"></i> <span data-translate="true">Publier mon commentaire</span>
            </button>
            <div class="comments-section">
                <div class="comments-section-title">
                    <i class="fas fa-history"></i>
                    <span data-translate="true">Commentaires</span>
                    <span id="commentsCountBadge" style="background:var(--bg-warm);color:var(--dr);border:1px solid var(--border);padding:2px 9px;border-radius:18px;font-size:.7rem;font-weight:600;"></span>
                </div>
                <div class="comments-list-modal" id="modalCommentsList">
                    <div class="empty-comments-modal">
                        <i class="fas fa-spinner fa-spin" style="font-size:1.8rem;"></i>
                        <p data-translate="true">Chargement...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{# MODAL SIGNALEMENT #}
<div class="report-modal" id="reportModal">
    <div class="report-modal-box">
        <div class="report-modal-title">
            <i class="fas fa-flag"></i><span data-translate="true">Signaler ce commentaire</span>
        </div>
        <p style="font-size:.8rem;color:#888;margin-bottom:1rem;" data-translate="true">Aidez-nous à maintenir une communauté respectueuse.</p>
        <form id="reportForm">
            <div class="report-option"><input type="radio" name="reportReason" id="rr1" value="langage_inapproprié"><label for="rr1">🤬 <span data-translate="true">Langage inapproprié</span></label></div>
            <div class="report-option"><input type="radio" name="reportReason" id="rr2" value="propos_injurieux"><label for="rr2">💢 <span data-translate="true">Propos injurieux</span></label></div>
            <div class="report-option"><input type="radio" name="reportReason" id="rr3" value="spam"><label for="rr3">📢 <span data-translate="true">Spam ou publicité</span></label></div>
            <div class="report-option"><input type="radio" name="reportReason" id="rr4" value="autre"><label for="rr4">❓ <span data-translate="true">Autre</span></label></div>
        </form>
        <div class="report-modal-actions">
            <button class="btn-cancel-report" onclick="closeReportModal()"><span data-translate="true">Annuler</span></button>
            <button class="btn-submit-report" id="reportSubmitBtn" onclick="submitReport()" disabled>
                <i class="fas fa-flag me-1"></i> <span data-translate="true">Signaler</span>
            </button>
        </div>
    </div>
</div>

{# MODAL PARTAGE #}
<div class="share-modal" id="shareModal">
    <div class="share-modal-box">
        <div class="share-modal-header">
            <h3>
                <i class="fas fa-globe-africa" style="color:var(--dr);margin-right:8px;"></i>
                <span data-translate="true">Partager votre aventure</span>
            </h3>
            <button class="modal-close" onclick="closeShareModal()">✕</button>
        </div>
        <div class="share-modal-body">
            <div class="share-notice">
                <i class="fas fa-user-circle" style="font-size:1.2rem;flex-shrink:0;"></i>
                <span data-translate="true">Votre publication sera visible dans votre profil voyageur.</span>
            </div>
            <div class="share-tabs">
                <button class="share-tab-btn active" id="shareTabPhoto" onclick="switchShareTab('photo')">
                    <i class="fas fa-image"></i> <span data-translate="true">Photo</span>
                </button>
                <button class="share-tab-btn" id="shareTabVideo" onclick="switchShareTab('video')">
                    <i class="fas fa-video"></i> <span data-translate="true">Vidéo / Reel</span>
                </button>
                <button class="share-tab-btn" id="shareTabLink" onclick="switchShareTab('link')">
                    <i class="fas fa-link"></i> <span data-translate="true">Lien URL</span>
                </button>
            </div>
            <div class="share-form-group">
                <label><span data-translate="true">Forum</span> <span style="color:red;">*</span></label>
                <select class="forum-select" id="shareForumId">
                    <option value="">-- Choisissez un forum --</option>
                    {% for forum in forums %}
                        {% if forum.status == 'actif' %}
                            <option value="{{ forum.idF }}">{{ forum.nom }} — {{ forum.theme }}</option>
                        {% endif %}
                    {% endfor %}
                </select>
            </div>
            <div class="share-form-group">
                <label><span data-translate="true">Titre</span> <span style="color:red;">*</span></label>
                <input type="text" class="share-input" id="shareTitle"
                       placeholder="Ex: Coucher de soleil à Djerba 🌅" maxlength="100">
            </div>
            <div class="share-form-group">
                <label><span data-translate="true">Description</span></label>
                <textarea class="share-input share-textarea" id="shareDescription"
                          placeholder="Décrivez votre aventure en Tunisie..."></textarea>
            </div>
            <div id="sharePhotoSection">
                <div class="share-form-group">
                    <label><span data-translate="true">Image</span></label>
                    <div class="share-upload-zone" onclick="document.getElementById('sharePhotoFile').click()">
                        <i class="fas fa-cloud-upload-alt"></i>
                        <p>Cliquez ou glissez votre photo ici</p>
                        <small>JPG, PNG, WEBP — max 10 Mo</small>
                    </div>
                    <input type="file" id="sharePhotoFile" accept="image/*" style="display:none;"
                           onchange="previewShareFile(this,'photo')">
                    <div class="share-preview" id="sharePhotoPreview">
                        <img id="sharePhotoImg" src="" alt="">
                        <button class="share-preview-remove" onclick="removeSharePreview('photo')">✕</button>
                    </div>
                </div>
            </div>
            <div id="shareVideoSection" style="display:none;">
                <div class="share-form-group">
                    <label><span data-translate="true">Vidéo / Reel</span></label>
                    <div class="share-upload-zone" onclick="document.getElementById('shareVideoFile').click()">
                        <i class="fas fa-film"></i>
                        <p>Cliquez ou glissez votre vidéo ici</p>
                        <small>MP4, MOV, WEBM — max 100 Mo</small>
