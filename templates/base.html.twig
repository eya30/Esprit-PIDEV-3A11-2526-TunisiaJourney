    <!-- ══════════════════════════════════════════════════════
         MODAL PROFIL (lecture)
    ══════════════════════════════════════════════════════ -->
    {% if app.user %}
    <div class="profile-modal-overlay" id="profileModal">
        <div class="profile-modal-blur" id="profileBlur"></div>
        <div class="profile-modal-panel">
            <div class="profile-modal-header">
                <h2 class="modal-title"><i class="fas fa-user-circle me-2" style="color:#A0231F"></i> Mon Profil</h2>
                <button class="profile-modal-close" id="closeProfileModal">&times;</button>
            </div>
            <div class="pf-body">
                <div class="pf-hero">
                    <div class="pf-avatar-lg">
                        {% if app.user.profileImageUrl %}
                            <img src="{{ app.user.profileImageUrl }}" alt="Photo de profil">
                        {% else %}
                            {{ app.user.prenom|slice(0,1)|upper }}{{ app.user.nom|slice(0,1)|upper }}
                        {% endif %}
                        <div class="pf-avatar-cam"><i class="fas fa-camera"></i></div>
                    </div>
                    <div class="pf-hero-info">
                        <p class="pf-fullname">{{ app.user.prenom }} {{ app.user.nom }}</p>
                        <p class="pf-mail">{{ app.user.email }}</p>
                        <span class="pf-badge"><span class="pf-badge-dot"></span> Compte actif</span>
                    </div>
                </div>

                <div class="pf-card">
                    <div class="pf-card-title"><i class="fas fa-id-card"></i> Informations personnelles</div>
                    <div class="pf-grid">
                        <div class="pf-field">
                            <span class="pf-label">Nom</span>
                            <span class="pf-value">{{ app.user.nom }}</span>
                        </div>
                        <div class="pf-field">
                            <span class="pf-label">Prénom</span>
                            <span class="pf-value">{{ app.user.prenom }}</span>
                        </div>
                        <div class="pf-field">
                            <span class="pf-label">Date de naissance</span>
                            <span class="pf-value {% if not app.user.dateNaissance %}empty{% endif %}">
                                {% if app.user.dateNaissance %}{{ app.user.dateNaissance|date('d/m/Y') }}{% else %}Non renseignée{% endif %}
                            </span>
                        </div>
                        <div class="pf-field">
                            <span class="pf-label">Téléphone</span>
                            <span class="pf-value {% if not app.user.telephone %}empty{% endif %}">
                                {% if app.user.telephone %}{{ app.user.telephone }}{% else %}Non renseigné{% endif %}
                            </span>
                        </div>
                        <div class="pf-field" style="grid-column:1/-1">
                            <span class="pf-label">Adresse</span>
                            <span class="pf-value {% if not app.user.adresse %}empty{% endif %}">
                                {% if app.user.adresse %}{{ app.user.adresse }}{% else %}Non renseignée{% endif %}
                            </span>
                        </div>
                    </div>
                </div>

                <div class="pf-card">
                    <div class="pf-card-title"><i class="fas fa-envelope"></i> Informations de connexion</div>
                    <div class="pf-grid">
                        <div class="pf-field" style="grid-column:1/-1">
                            <span class="pf-label">Email</span>
                            <span class="pf-value">{{ app.user.email }}</span>
                        </div>
                        <div class="pf-field" style="grid-column:1/-1">
                            <span class="pf-label">Mot de passe</span>
                            <span class="pf-value">••••••••••••</span>
                        </div>
                    </div>
                </div>

                <button class="pf-edit-btn" id="openEditModal">
                    <i class="fas fa-pen"></i> Modifier le profil
                </button>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- ══════════════════════════════════════════════════════
         MODAL EDIT PROFIL  — avec erreurs Symfony
    ══════════════════════════════════════════════════════ -->
    {% if app.user %}
    <div class="edit-modal-overlay {% if app.session.get('_profile_errors') %}active{% endif %}" id="editProfileModal">
        <div class="edit-modal-blur" id="editModalBlur"></div>
        <div class="edit-modal-panel">
            <div class="edit-modal-header">
                <h2 class="edit-modal-title"><i class="fas fa-pen me-2" style="color:#A0231F"></i> Modifier le profil</h2>
                <button class="edit-modal-close" id="closeEditModal2">&times;</button>
            </div>
            <div class="edit-body">

                <form id="profileEditForm" method="POST" action="{{ path('app_profile_edit') }}"
                      enctype="multipart/form-data" novalidate>
                    <input type="hidden" name="_token" value="{{ csrf_token('profile_edit') }}">

                    {# Input fichier caché #}
                    <input type="file" name="photo" id="photoInput"
                           accept="image/jpeg,image/png,image/webp"
                           style="display:none;">

                    <!-- Avatar -->
                    <div class="edit-hero" style="margin-bottom:14px;">
                        <div class="edit-av" id="editAvatarPreview"
                             style="overflow:hidden;cursor:pointer;position:relative;"
                             onclick="document.getElementById('photoInput').click()"
                             title="Cliquer pour changer la photo">
                            {% if app.user.profileImageUrl %}
                                <img src="{{ app.user.profileImageUrl }}" alt="Photo"
                                     style="width:100%;height:100%;object-fit:cover;border-radius:50%;">
                            {% else %}
                                {{ app.user.prenom|slice(0,1)|upper }}{{ app.user.nom|slice(0,1)|upper }}
                            {% endif %}
                            <div style="position:absolute;inset:0;background:rgba(0,0,0,0.35);
                                        border-radius:50%;display:flex;align-items:center;
                                        justify-content:center;opacity:0;transition:opacity .2s;"
                                 class="avatar-hover-cam">
                                <i class="fas fa-camera" style="color:white;font-size:.9rem;"></i>
                            </div>
                        </div>
                        <div>
                            <p class="edit-hero-name">{{ app.user.prenom }} {{ app.user.nom }}</p>
                            <p class="edit-hero-sub">Cliquez sur l'avatar pour changer la photo</p>
                        </div>
                    </div>

                    <!-- Infos personnelles -->
                    <div class="edit-card" style="margin-bottom:14px;">
                        <div class="edit-card-title"><i class="fas fa-id-card"></i> Informations personnelles</div>
                        <div class="edit-grid">

                            <div class="edit-field">
                                <label for="field_nom">Nom</label>
                                <input type="text" id="field_nom" name="nom"
                                       value="{{ app.session.get('_profile_data') ? app.session.get('_profile_data')['nom'] : app.user.nom }}"
                                       placeholder="Votre nom"
                                       class="{{ app.session.get('_profile_errors') and app.session.get('_profile_errors')['nom'] is defined ? 'input-error' : '' }}">
                                {% if app.session.get('_profile_errors') and app.session.get('_profile_errors')['nom'] is defined %}
                                    <span class="field-error">{{ app.session.get('_profile_errors')['nom'][0] }}</span>
                                {% endif %}
                            </div>

                            <div class="edit-field">
                                <label for="field_prenom">Prénom</label>
                                <input type="text" id="field_prenom" name="prenom"
                                       value="{{ app.session.get('_profile_data') ? app.session.get('_profile_data')['prenom'] : app.user.prenom }}"
                                       placeholder="Votre prénom"
                                       class="{{ app.session.get('_profile_errors') and app.session.get('_profile_errors')['prenom'] is defined ? 'input-error' : '' }}">
                                {% if app.session.get('_profile_errors') and app.session.get('_profile_errors')['prenom'] is defined %}
                                    <span class="field-error">{{ app.session.get('_profile_errors')['prenom'][0] }}</span>
                                {% endif %}
                            </div>

                            <div class="edit-field">
                                <label for="field_dob">Date de naissance</label>
                                <input type="date" id="field_dob" name="dateNaissance"
                                       value="{{ app.session.get('_profile_data') and app.session.get('_profile_data')['dateNaissance'] ? app.session.get('_profile_data')['dateNaissance'] : (app.user.dateNaissance ? app.user.dateNaissance|date('Y-m-d') : '') }}"
                                       max="{{ "now"|date_modify("-18 years")|date('Y-m-d') }}"
                                       class="{{ app.session.get('_profile_errors') and app.session.get('_profile_errors')['dateNaissance'] is defined ? 'input-error' : '' }}">
                                {% if app.session.get('_profile_errors') and app.session.get('_profile_errors')['dateNaissance'] is defined %}
                                    <span class="field-error">{{ app.session.get('_profile_errors')['dateNaissance'][0] }}</span>
                                {% endif %}
                            </div>

                            <div class="edit-field">
                                <label for="field_tel">Téléphone</label>
                                <input type="text" id="field_tel" name="telephone"
                                       value="{{ app.session.get('_profile_data') ? app.session.get('_profile_data')['telephone'] : app.user.telephone }}"
                                       placeholder="06XXXXXXXX"
                                       class="{{ app.session.get('_profile_errors') and app.session.get('_profile_errors')['telephone'] is defined ? 'input-error' : '' }}">
                                {% if app.session.get('_profile_errors') and app.session.get('_profile_errors')['telephone'] is defined %}
                                    <span class="field-error">{{ app.session.get('_profile_errors')['telephone'][0] }}</span>
                                {% endif %}
                            </div>

                            <div class="edit-field" style="grid-column:1/-1">
                                <label for="field_adresse">Adresse</label>
                                <input type="text" id="field_adresse" name="adresse"
                                       value="{{ app.session.get('_profile_data') ? app.session.get('_profile_data')['adresse'] : app.user.adresse }}"
                                       placeholder="Votre adresse"
                                       class="{{ app.session.get('_profile_errors') and app.session.get('_profile_errors')['adresse'] is defined ? 'input-error' : '' }}">
                                {% if app.session.get('_profile_errors') and app.session.get('_profile_errors')['adresse'] is defined %}
                                    <span class="field-error">{{ app.session.get('_profile_errors')['adresse'][0] }}</span>
                                {% endif %}
                            </div>

                        </div>
                    </div>

                    <!-- Infos de connexion -->
                    <div class="edit-card" style="margin-bottom:14px;">
                        <div class="edit-card-title"><i class="fas fa-shield-alt"></i> Informations de connexion</div>
                        <div style="display:flex;flex-direction:column;gap:12px;">

                            <div class="edit-field">
                                <label for="field_email">Email</label>
                                <input type="text" id="field_email" name="email"
                                       value="{{ app.session.get('_profile_data') ? app.session.get('_profile_data')['email'] : app.user.email }}"
                                       class="{{ app.session.get('_profile_errors') and app.session.get('_profile_errors')['email'] is defined ? 'input-error' : '' }}">
                                {% if app.session.get('_profile_errors') and app.session.get('_profile_errors')['email'] is defined %}
                                    <span class="field-error">{{ app.session.get('_profile_errors')['email'][0] }}</span>
                                {% endif %}
                            </div>

                            <hr style="border-color:#F0E8DD;margin:4px 0;">
                            <p style="font-size:.72rem;color:#A0A0A0;margin:0;">
                                <i class="fas fa-key"></i> Changer le mot de passe
                                <em>(laisser vide pour ne pas modifier)</em>
                            </p>

                            <div class="edit-field">
                                <label for="field_cur_pwd">Mot de passe actuel</label>
                                <input type="password" id="field_cur_pwd" name="current_password" placeholder="Mot de passe actuel"
                                       class="{{ app.session.get('_profile_errors') and app.session.get('_profile_errors')['current_password'] is defined ? 'input-error' : '' }}">
                                {% if app.session.get('_profile_errors') and app.session.get('_profile_errors')['current_password'] is defined %}
                                    <span class="field-error">{{ app.session.get('_profile_errors')['current_password'][0] }}</span>
                                {% endif %}
                            </div>

                            <div class="edit-grid">
                                <div class="edit-field">
                                    <label for="field_new_pwd">Nouveau mot de passe</label>
                                    <input type="password" id="field_new_pwd" name="new_password" placeholder="Nouveau"
                                           class="{{ app.session.get('_profile_errors') and app.session.get('_profile_errors')['new_password'] is defined ? 'input-error' : '' }}">
                                    {% if app.session.get('_profile_errors') and app.session.get('_profile_errors')['new_password'] is defined %}
                                        <span class="field-error">{{ app.session.get('_profile_errors')['new_password'][0] }}</span>
                                    {% endif %}
                                </div>
                                <div class="edit-field">
                                    <label for="field_confirm_pwd">Confirmer</label>
                                    <input type="password" id="field_confirm_pwd" name="confirm_password" placeholder="Confirmer"
                                           class="{{ app.session.get('_profile_errors') and app.session.get('_profile_errors')['confirm_password'] is defined ? 'input-error' : '' }}">
                                    {% if app.session.get('_profile_errors') and app.session.get('_profile_errors')['confirm_password'] is defined %}
                                        <span class="field-error">{{ app.session.get('_profile_errors')['confirm_password'][0] }}</span>
                                    {% endif %}
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="edit-actions">
                        <button type="button" class="edit-btn-cancel" id="cancelEditModal">
                            <i class="fas fa-times"></i> Annuler
                        </button>
                        <button type="submit" class="edit-btn-save">
                            <i class="fas fa-check"></i> Enregistrer
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
    {% endif %}

    <script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Afficher l'icône réservation uniquement sur la page voyages
        if (window.location.pathname === '/voyage/' || window.location.pathname === '/voyage') {
            const icon = document.getElementById('reservationIcon');
            if (icon) icon.style.display = 'flex';
        }

        // Sidebar réservations
        const reservationIcon = document.getElementById('reservationIcon');
        const sidebar = document.getElementById('reservationsSidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const closeSidebarBtn = document.getElementById('closeSidebarBtn');

        function openSidebar() {
            if (sidebar && overlay) { sidebar.classList.add('open'); overlay.classList.add('active'); loadReservations(); }
        }
        function closeSidebar() {
            if (sidebar && overlay) { sidebar.classList.remove('open'); overlay.classList.remove('active'); }
        }

        if (reservationIcon) reservationIcon.addEventListener('click', openSidebar);
        if (closeSidebarBtn) closeSidebarBtn.addEventListener('click', closeSidebar);
        if (overlay) overlay.addEventListener('click', closeSidebar);
async function loadReservations() {
    const container = document.getElementById('reservationsList');
    if (!container) return;
    try {
        const response = await fetch('/api/reservations');
        const reservations = await response.json();
        
        // 🔥 DEBUG : Afficher dans la console
        console.log('Réservations reçues:', reservations);
        console.log('Nombre de réservations:', reservations.length);
        
        if (reservations.length === 0) {
            container.innerHTML = '<div class="empty-reservations"><i class="fas fa-ticket-alt fa-3x mb-2"></i><p>Aucune réservation trouvée</p><p class="small">Connectez-vous avec le même email que votre réservation</p></div>';
            return;
        }
        container.innerHTML = reservations.map(res => `
            <div class="reservation-card" data-id="${res.idRP}">
                <div class="reservation-info">
                    <div class="reservation-name">${escapeHtml(res.prenom)} ${escapeHtml(res.nom)}</div>
                    <div class="reservation-details">
                        <div><i class="fas fa-phone"></i> ${escapeHtml(res.telephone)}</div>
                        <div><i class="fas fa-envelope"></i> ${escapeHtml(res.email)}</div>
                        <div><i class="fas fa-users"></i> ${res.nbre} personnes</div>
                        <div><i class="fas fa-calendar"></i> ${res.dateProgramme}</div>
                        <div><i class="fas fa-tag"></i> ${res.prixProg} DT</div>
                    </div>
                </div>
                <div class="reservation-actions">
                    <button class="btn-edit-reservation" onclick="editReservation(${res.idRP})">
                        <i class="fas fa-edit"></i> Modifier
                    </button>
                    <button class="btn-delete-reservation" onclick="deleteReservation(${res.idRP})">
                        <i class="fas fa-trash"></i> Supprimer
                    </button>
                </div>
            </div>
        `).join('');
    } catch (error) {
        console.error('Erreur:', error);
        container.innerHTML = '<div class="empty-reservations"><i class="fas fa-exclamation-circle fa-3x mb-2"></i><p>Erreur de chargement</p></div>';
    }
}

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/[&<>]/g, m => m === '&' ? '&amp;' : m === '<' ? '&lt;' : '&gt;');
        }

        async function editReservation(id) {
            try {
                const response = await fetch(`/api/reservations/${id}`);
                const res = await response.json();
                document.getElementById('editReservationId').value = res.idRP;
                document.getElementById('editNom').value = res.nom;
                document.getElementById('editPrenom').value = res.prenom;
                document.getElementById('editTelephone').value = res.telephone;
                document.getElementById('editEmail').value = res.email;
                document.getElementById('editNbre').value = res.nbre;
                document.getElementById('editModal').classList.add('active');
            } catch (error) { alert('Erreur lors du chargement'); }
        }

        const closeEditModalBtn = document.getElementById('closeEditModal');
        if (closeEditModalBtn) {
            closeEditModalBtn.addEventListener('click', () => document.getElementById('editModal').classList.remove('active'));
        }

        const editReservationForm = document.getElementById('editReservationForm');
        if (editReservationForm) {
            editReservationForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const id = document.getElementById('editReservationId').value;
                const data = {
                    nom: document.getElementById('editNom').value,
                    prenom: document.getElementById('editPrenom').value,
                    telephone: document.getElementById('editTelephone').value,
                    email: document.getElementById('editEmail').value,
                    nbre: parseInt(document.getElementById('editNbre').value)
                };
                try {
                    const response = await fetch(`/api/reservations/${id}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    if (response.ok) {
                        document.getElementById('editModal').classList.remove('active');
                        loadReservations();
                        showToast('Réservation modifiée avec succès !');
                    } else { alert('Erreur lors de la modification'); }
                } catch (error) { alert('Erreur lors de la modification'); }
            });
        }

        async function deleteReservation(id) {
            if (!confirm('Êtes-vous sûr de vouloir supprimer cette réservation ?')) return;
            try {
                const response = await fetch(`/api/reservations/${id}`, { method: 'DELETE' });
                if (response.ok) { loadReservations(); showToast('Réservation supprimée avec succès !'); }
                else { alert('Erreur lors de la suppression'); }
            } catch (error) { alert('Erreur lors de la suppression'); }
        }

        function showToast(message) {
            const toast = document.createElement('div');
            toast.className = 'alert alert-success toast-message';
            toast.innerHTML = `<i class="fas fa-check-circle me-2"></i> ${message}`;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }

        setTimeout(() => {
            document.querySelectorAll('.toast-message').forEach(toast => {
                toast.style.transition = 'opacity 0.5s';
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 500);
            });
        }, 5000);

        window.addEventListener('scroll', () => {
            const navbar = document.querySelector('.navbar');
            if (window.scrollY !== undefined) navbar.classList.toggle('scrolled', window.scrollY > 50);
        });
    </script>

    <!-- JS Modals Profil + Edit -->
    <script>
    (function(){
        const profileModal   = document.getElementById('profileModal');
        const openProfileBtn = document.getElementById('openProfileModal');
        const closeProfileBtn= document.getElementById('closeProfileModal');
        const profileBlur    = document.getElementById('profileBlur');

        const editModal      = document.getElementById('editProfileModal');
        const openEditBtn    = document.getElementById('openEditModal');
        const closeEditBtn   = document.getElementById('closeEditModal2');
        const cancelEditBtn  = document.getElementById('cancelEditModal');
        const editBlur       = document.getElementById('editModalBlur');

        function openProfile() {
            if (profileModal) { profileModal.classList.add('active'); document.body.style.overflow = 'hidden'; }
        }
        function closeProfile() {
            if (profileModal) { profileModal.classList.remove('active'); document.body.style.overflow = ''; }
        }
        function openEdit() {
            closeProfile();
            if (editModal) { editModal.classList.add('active'); document.body.style.overflow = 'hidden'; }
        }
        function closeEdit() {
            if (editModal) { editModal.classList.remove('active'); document.body.style.overflow = ''; }
            openProfile();
        }
        function closeEditOnly() {
            if (editModal) { editModal.classList.remove('active'); document.body.style.overflow = ''; }
        }

        if (openProfileBtn)  openProfileBtn.addEventListener('click', openProfile);
        if (closeProfileBtn) closeProfileBtn.addEventListener('click', closeProfile);
        if (profileBlur)     profileBlur.addEventListener('click', closeProfile);
        if (openEditBtn)     openEditBtn.addEventListener('click', openEdit);
        if (closeEditBtn)    closeEditBtn.addEventListener('click', closeEdit);
        if (cancelEditBtn)   cancelEditBtn.addEventListener('click', closeEdit);
        if (editBlur)        editBlur.addEventListener('click', closeEditOnly);

        document.addEventListener('keydown', function(e){
            if (e.key === 'Escape') { closeProfile(); closeEditOnly(); }
        });

        /* ── Soumission du formulaire profil ── */
        const profileEditForm = document.getElementById('profileEditForm');
        if (profileEditForm) {
            profileEditForm.addEventListener('submit', function(e) {
                e.preventDefault();
                const btn = profileEditForm.querySelector('.edit-btn-save');
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Enregistrement...';
                btn.disabled = true;
                profileEditForm.submit();
            });
        }

        /* ── Prévisualisation photo ── */
        const photoInput = document.getElementById('photoInput');
        if (photoInput) {
            photoInput.addEventListener('change', function() {
                const file = this.files[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = function(e) {
                    const av = document.getElementById('editAvatarPreview');
                    if (av) av.innerHTML = `<img src="${e.target.result}" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">`;
                };
                reader.readAsDataURL(file);
            });
        }

        /* ── Rouvre le profil si ?openProfile=1 après redirect succès ── */
        if (new URLSearchParams(window.location.search).get('openProfile') === '1') {
            openProfile();
            history.replaceState({}, '', window.location.pathname);
        }

        /* ── Rouvre la modal d'édition si ?openEditModal=1 (erreurs de validation) ── */
        if (new URLSearchParams(window.location.search).get('openEditModal') === '1') {
            openEdit();
            history.replaceState({}, '', window.location.pathname);
            /* Nettoyage session côté serveur après affichage des erreurs */
            fetch('{{ path("app_profile_clear_errors") }}', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        }

        /* ── Rouvre la modal d'édition si erreurs Symfony (classe active déjà posée par Twig) ── */
        if (editModal && editModal.classList.contains('active')) {
            document.body.style.overflow = 'hidden';
        }
    })();
    </script>

    {% block javascripts %}{% endblock %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
</body>
</html>
