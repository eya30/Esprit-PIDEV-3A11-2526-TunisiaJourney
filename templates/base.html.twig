<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}TunisiaJourney - Découvrez la Tunisie{% endblock %}</title>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&family=Cormorant+Garamond:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --tunisia-red: #E31B23;
            --tunisia-dark-red: #C41E3A;
            --tunisia-orange: #FF6B35;
            --tunisia-gold: #FFCBCC;
            --tunisia-blue: #0054A6;
            --tunisia-sand: #FDF5E6;
            --tunisia-white: #FFFFFF;
            --tunisia-cream: #FEF9E6;
            --footer-blue: #4e0915;
            --dark-gray: #2C3E50;
        }
        
        body {
            font-family: 'Montserrat', sans-serif;
            color: var(--dark-gray);
            background: var(--tunisia-sand);
        }
        
        h1, h2, h3, h4, .logo-text {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 800;
        }
        
        /* Navbar */
        .navbar {
            background: rgba(255,255,255,0.98);
            padding: 0.8rem 0;
            box-shadow: 0 2px 20px rgba(0,0,0,0.08);
            transition: all 0.3s ease;
        }
        
        .navbar.scrolled {
            padding: 0.5rem 0;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
        }
        
        .reservation-menu-icon {
            cursor: pointer;
            margin-right: 2rem;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            gap: 5px;
            padding: 5px;
        }
        
        .reservation-menu-icon .line {
            width: 25px;
            height: 3px;
            background-color: var(--tunisia-red);
            border-radius: 3px;
            transition: all 0.3s ease;
        }
        
        .reservation-menu-icon:hover .line {
            background-color: var(--tunisia-orange);
        }
        
        .reservation-menu-icon:hover {
            transform: scale(1.05);
        }
        
        .reservations-sidebar {
            position: fixed;
            top: 0;
            left: -450px;
            width: 450px;
            height: 100vh;
            background: white;
            box-shadow: 5px 0 30px rgba(0,0,0,0.1);
            z-index: 1050;
            transition: left 0.3s ease;
            overflow-y: auto;
            padding: 1.5rem;
        }
        
        .reservations-sidebar.open {
            left: 0;
        }
        
        .sidebar-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 1040;
            display: none;
        }
        
        .sidebar-overlay.active {
            display: block;
        }
        
        .sidebar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 1rem;
            margin-bottom: 1.5rem;
            border-bottom: 2px solid #F0E8DD;
        }
        
        .sidebar-header h4 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.5rem;
            color: var(--tunisia-red);
            margin: 0;
        }
        
        .close-sidebar {
            background: none;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: #9CA3AF;
            transition: all 0.2s;
        }
        
        .close-sidebar:hover {
            color: var(--tunisia-red);
            transform: rotate(90deg);
        }
        
        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            transition: all 0.3s ease;
        }
        
        .navbar-brand:hover {
            transform: scale(1.02);
        }
        
        .navbar-brand .logo-img {
            width: 65px;
            height: 65px;
            object-fit: contain;
        }
        
        .navbar-brand .logo-text {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--tunisia-red);
        }
        
        .navbar-brand .logo-text span {
            color: var(--tunisia-orange);
        }
        
        .nav-link {
            font-weight: 500;
            color: var(--dark-gray);
            transition: all 0.3s ease;
            margin: 0 0.5rem;
            position: relative;
            padding-bottom: 5px;
        }
        
        .nav-link::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--tunisia-red);
            transition: width 0.3s ease;
            border-radius: 2px;
        }
        
        .nav-link:hover::after { width: 100%; }
        .nav-link.active::after { width: 100%; }
        .nav-link:hover, .nav-link.active { color: var(--tunisia-red); }
        
        .btn-login {
            background: transparent;
            border: 2px solid var(--tunisia-red);
            color: var(--tunisia-red);
            padding: 8px 25px;
            border-radius: 30px;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }
        
        .btn-login:hover {
            background: var(--tunisia-red);
            color: white;
            transform: translateY(-2px);
        }
        
        .btn-register {
            background: var(--tunisia-red);
            border: none;
            color: white;
            padding: 8px 25px;
            border-radius: 30px;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }
        
        .btn-register:hover {
            background: #C41E3A;
            transform: translateY(-2px);
            color: white;
        }
        
        .reservation-card {
            background: #FEF9F0;
            border-radius: 16px;
            padding: 1rem;
            margin-bottom: 1rem;
            border: 1px solid #F0E8DD;
            transition: all 0.2s;
        }
        
        .reservation-card:hover {
            transform: translateX(5px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            border-color: var(--tunisia-red);
        }
        
        .reservation-info { margin-bottom: 0.5rem; }
        .reservation-name { font-weight: 700; color: var(--tunisia-red); margin-bottom: 0.3rem; }
        .reservation-details { font-size: 0.8rem; color: #6c757d; }
        .reservation-details i { width: 20px; color: var(--tunisia-orange); }
        
        .reservation-actions {
            display: flex;
            gap: 0.5rem;
            margin-top: 0.5rem;
        }
        
        .reservation-actions button {
            background: none;
            border: none;
            padding: 5px 10px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 0.8rem;
        }
        
        .btn-edit-reservation { background: #FEF3C7; color: #D97706; }
        .btn-edit-reservation:hover { background: #F59E0B; color: white; }
        .btn-delete-reservation { background: #FEF2F2; color: #EF4444; }
        .btn-delete-reservation:hover { background: #EF4444; color: white; }
        
        .edit-modal {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 1100;
            align-items: center;
            justify-content: center;
        }
        
        .edit-modal.active { display: flex; }
        
        .edit-modal-content {
            background: white;
            border-radius: 20px;
            padding: 2rem;
            max-width: 450px;
            width: 90%;
        }
        
        .edit-modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #E8DFD1;
        }
        
        .edit-modal-header h3 { font-size: 1.3rem; color: var(--tunisia-blue); margin: 0; }
        
        .close-edit-modal {
            background: none; border: none;
            font-size: 1.5rem; cursor: pointer; color: #9CA3AF;
        }
        
        .edit-form-group { margin-bottom: 1rem; }
        
        .edit-form-group label {
            display: block; font-size: 0.85rem;
            font-weight: 500; margin-bottom: 0.3rem;
        }
        
        .edit-form-group input {
            width: 100%; padding: 10px 12px;
            border: 1px solid #E8DFD1; border-radius: 10px; font-size: 0.9rem;
        }
        
        .edit-form-group input:focus { outline: none; border-color: var(--tunisia-blue); }
        
        .btn-save-edit {
            width: 100%; background: var(--tunisia-blue); color: white;
            border: none; padding: 12px; border-radius: 30px;
            font-weight: 600; cursor: pointer; margin-top: 1rem;
        }
        
        .btn-save-edit:hover { background: #00408a; }
        
        .empty-reservations { text-align: center; padding: 2rem; color: #9CA3AF; }
        
        /* Footer */
        .footer {
            background: #4e0915;
            color: white;
            padding: 3rem 0 2rem;
            margin-top: 3rem;
        }
        
        .footer a {
            color: rgba(255,255,255,0.8);
            text-decoration: none;
            transition: all 0.3s ease;
        }
        
        .footer a:hover { color: var(--tunisia-gold); padding-left: 5px; }
        
        .social-icons a {
            display: inline-flex; align-items: center; justify-content: center;
            width: 40px; height: 40px; background: rgba(255,255,255,0.15);
            border-radius: 50%; margin: 0 5px; transition: all 0.3s ease; color: white;
        }
        
        .social-icons a:hover { background: var(--tunisia-red); transform: translateY(-3px); color: white; }
        
        .footer-title { font-size: 1.1rem; font-weight: 600; margin-bottom: 1rem; color: var(--tunisia-gold); }
        .footer-separator { background: rgba(255,255,255,0.2); margin: 2rem 0; }
        .copyright { color: rgba(255,255,255,0.7); font-size: 0.85rem; }
        
        .toast-message {
            position: fixed; top: 90px; right: 20px; z-index: 1050;
            min-width: 300px; animation: slideInRight 0.5s ease-out;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }
        
        @keyframes slideInRight {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        
        @media (max-width: 768px) {
            .navbar-brand .logo-text { font-size: 1.2rem; }
            .navbar-brand .logo-img { width: 50px; height: 50px; }
            .reservations-sidebar { width: 100%; left: -100%; }
        }

        /* Bouton Logout */
        .btn-logout {
            display: inline-flex; align-items: center; gap: 7px;
            background: transparent; color: var(--tunisia-dark-red);
            border: 2px solid var(--tunisia-dark-red);
            padding: 7px 18px; border-radius: 30px;
            font-weight: 600; font-size: 0.85rem;
            font-family: 'Montserrat', sans-serif;
            cursor: pointer; transition: all 0.28s ease; letter-spacing: 0.3px;
        }
        .btn-logout i { font-size: 0.9rem; transition: transform 0.28s ease; }
        .btn-logout:hover {
            background: var(--tunisia-dark-red); color: white;
            transform: translateY(-2px); box-shadow: 0 5px 16px rgba(196,30,58,0.28);
        }
        .btn-logout:hover i { transform: translateX(3px); }

        /* Avatar profil */
        .profile-avatar {
            width: 40px; height: 40px; border-radius: 50%;
            background: linear-gradient(135deg, var(--tunisia-red), var(--tunisia-dark-red));
            display: inline-flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 0.95rem; color: white; letter-spacing: 0.5px;
            border: 2.5px solid rgba(227,27,35,0.25);
            box-shadow: 0 3px 12px rgba(227,27,35,0.22);
            transition: all 0.28s ease; position: relative; flex-shrink: 0;
            cursor: pointer; font-family: 'Montserrat', sans-serif;
        }
        .profile-avatar:hover { transform: scale(1.1); box-shadow: 0 5px 18px rgba(227,27,35,0.38); }
        .avatar-dot {
            position: absolute; bottom: 1px; right: 1px;
            width: 10px; height: 10px; border-radius: 50%;
            background: #22C55E; border: 2px solid white;
        }

        /* Modal Profil */
        .profile-modal-overlay {
            display: none;
            position: fixed; inset: 0; z-index: 2000;
        }
        .profile-modal-overlay.active { display: block; }
        .profile-modal-blur {
            position: absolute; inset: 0;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            background: rgba(26,46,74,0.35);
        }
        .profile-modal-panel {
            position: absolute;
            top: 50%; right: 0;
            transform: translateY(-50%) translateX(100%);
            width: min(520px, 96vw);
            height: 100vh;
            background: linear-gradient(160deg, #FDF6EC 0%, #F5EDD8 100%);
            box-shadow: -12px 0 60px rgba(26,46,74,.18);
            overflow-y: auto;
            transition: transform 0.45s cubic-bezier(.76,0,.24,1);
            padding: 0 0 40px;
        }
        .profile-modal-overlay.active .profile-modal-panel {
            transform: translateY(-50%) translateX(0);
        }
        .profile-modal-header {
            display: flex; align-items: center; justify-content: space-between;
            padding: 20px 28px 0;
            position: sticky; top: 0; z-index: 1;
            background: linear-gradient(160deg, #FDF6EC 0%, #F5EDD8 100%);
            padding-bottom: 10px;
            border-bottom: 1px solid rgba(160,35,31,.1);
        }
        .profile-modal-header .modal-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.2rem; font-weight: 700; color: #1A2E4A; margin: 0;
        }
        .profile-modal-close {
            width: 34px; height: 34px; border-radius: 50%;
            border: none; background: rgba(160,35,31,.1);
            color: #A0231F; font-size: 1.1rem; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: background .2s, transform .2s;
        }
        .profile-modal-close:hover { background: #A0231F; color: white; transform: rotate(90deg); }

        .pf-body { padding: 20px 28px 0; display: flex; flex-direction: column; gap: 16px; }

        .pf-hero {
            background: white; border-radius: 16px; padding: 24px;
            display: flex; align-items: center; gap: 18px;
            box-shadow: 0 3px 16px rgba(26,46,74,.07);
        }
        .pf-avatar-lg {
            width: 80px; height: 80px; border-radius: 50%; flex-shrink: 0;
            background: linear-gradient(135deg, #C94040, #A0231F);
            display: flex; align-items: center; justify-content: center;
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.8rem; font-weight: 800; color: white;
            border: 3px solid rgba(160,35,31,.2);
            box-shadow: 0 4px 14px rgba(160,35,31,.22);
            position: relative;
        }
        .pf-avatar-lg img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
        .pf-avatar-cam {
            position: absolute; bottom: 0; right: 0;
            width: 24px; height: 24px; border-radius: 50%;
            background: #A0231F; border: 2px solid white;
            display: flex; align-items: center; justify-content: center;
        }
        .pf-avatar-cam i { font-size: 9px; color: white; }
        .pf-hero-info .pf-fullname {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.35rem; font-weight: 800; color: #1A2E4A; margin: 0 0 3px;
        }
        .pf-hero-info .pf-mail { font-size: .8rem; color: #A0231F; margin: 0 0 8px; }
        .pf-badge {
            display: inline-flex; align-items: center; gap: 5px;
            background: #FDF1F1; color: #A0231F;
            font-size: .68rem; font-weight: 700;
            padding: 3px 10px; border-radius: 20px;
            border: 1px solid rgba(160,35,31,.18);
        }
        .pf-badge-dot { width: 6px; height: 6px; border-radius: 50%; background: #22C55E; }

        .pf-card {
            background: white; border-radius: 14px; padding: 20px 22px;
            box-shadow: 0 3px 16px rgba(26,46,74,.06);
        }
        .pf-card-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: .95rem; font-weight: 800; color: #1A2E4A;
            margin: 0 0 14px; padding-bottom: 8px;
            border-bottom: 1.5px solid #F0E8DD;
            display: flex; align-items: center; gap: 7px;
        }
        .pf-card-title i { color: #A0231F; font-size: .85rem; }
        .pf-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .pf-field { display: flex; flex-direction: column; gap: 3px; }
        .pf-label { font-size: .65rem; font-weight: 700; color: #A0A0A0; letter-spacing: .6px; text-transform: uppercase; }
        .pf-value {
            font-size: .85rem; color: #1A2E4A; font-weight: 500;
            padding: 9px 12px; background: #FDF6EC;
            border-radius: 8px; border: 1px solid #EFE5D0;
        }
        .pf-value.empty { color: #C0B090; font-style: italic; }

        .pf-edit-btn {
            display: flex; align-items: center; justify-content: center; gap: 7px;
            width: 100%; padding: 13px;
            background: linear-gradient(90deg, #A0231F, #C0392B);
            color: white; border: none; border-radius: 50px;
            font-family: 'Montserrat', sans-serif; font-size: .88rem; font-weight: 700;
            cursor: pointer; text-decoration: none;
            box-shadow: 0 4px 14px rgba(160,35,31,.28);
            transition: transform .18s, box-shadow .18s;
        }
        .pf-edit-btn:hover { transform: translateY(-2px); box-shadow: 0 7px 20px rgba(160,35,31,.4); color: white; }
        .pf-edit-btn i { font-size: .85rem; }

        /* Modal Edit Profil */
        .edit-modal-overlay {
            display: none;
            position: fixed; inset: 0; z-index: 2500;
        }
        .edit-modal-overlay.active { display: block; }
        .edit-modal-blur {
            position: absolute; inset: 0;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            background: rgba(26,46,74,0.35);
            cursor: pointer;
        }
        .edit-modal-panel {
            position: absolute;
            top: 50%; right: 0;
            transform: translateY(-50%) translateX(100%);
            width: min(520px, 96vw);
            height: 100vh;
            background: linear-gradient(160deg, #FDF6EC 0%, #F5EDD8 100%);
            box-shadow: -12px 0 60px rgba(26,46,74,.18);
            overflow-y: auto;
            transition: transform 0.45s cubic-bezier(.76,0,.24,1);
            padding: 0 0 40px;
        }
        .edit-modal-overlay.active .edit-modal-panel {
            transform: translateY(-50%) translateX(0);
        }
        .edit-modal-header {
            display: flex; align-items: center; justify-content: space-between;
            padding: 20px 28px 10px;
            position: sticky; top: 0; z-index: 1;
            background: linear-gradient(160deg, #FDF6EC 0%, #F5EDD8 100%);
            border-bottom: 1px solid rgba(160,35,31,.1);
        }
        .edit-modal-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.2rem; font-weight: 800; color: #1A2E4A; margin: 0;
        }
        .edit-modal-close {
            width: 34px; height: 34px; border-radius: 50%;
            border: none; background: rgba(160,35,31,.1);
            color: #A0231F; font-size: 1.1rem; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: background .2s, transform .2s;
        }
        .edit-modal-close:hover { background: #A0231F; color: white; transform: rotate(90deg); }

        .edit-body { padding: 20px 28px; display: flex; flex-direction: column; gap: 14px; }

        .edit-hero {
            background: white; border-radius: 16px; padding: 18px 20px;
            display: flex; align-items: center; gap: 14px;
            box-shadow: 0 3px 14px rgba(26,46,74,.07);
        }
        .edit-av {
            width: 56px; height: 56px; border-radius: 50%; flex-shrink: 0;
            background: linear-gradient(135deg, #C94040, #A0231F);
            display: flex; align-items: center; justify-content: center;
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.4rem; font-weight: 800; color: white;
            border: 3px solid rgba(160,35,31,.2);
        }
        .edit-hero-name { font-family: 'Cormorant Garamond', serif; font-size: 1.05rem; font-weight: 800; color: #1A2E4A; margin: 0 0 2px; }
        .edit-hero-sub  { font-size: .75rem; color: #A0231F; margin: 0; }

        .edit-card {
            background: white; border-radius: 14px; padding: 18px 20px;
            box-shadow: 0 3px 14px rgba(26,46,74,.06);
        }
        .edit-card-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: .95rem; font-weight: 800; color: #1A2E4A;
            margin: 0 0 14px; padding-bottom: 8px;
            border-bottom: 1.5px solid #F0E8DD;
            display: flex; align-items: center; gap: 7px;
        }
        .edit-card-title i { color: #A0231F; font-size: .82rem; }

        .edit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .edit-field { display: flex; flex-direction: column; gap: 4px; }
        .edit-field label { font-size: .65rem; font-weight: 700; color: #A0A0A0; letter-spacing: .5px; text-transform: uppercase; }
        .edit-field input {
            width: 100%; padding: 10px 13px;
            border: 1.5px solid #EFE5D0; border-radius: 9px;
            font-family: 'Montserrat', sans-serif; font-size: .84rem; color: #1A2E4A;
            background: #FDF6EC; outline: none;
            transition: border-color .2s, background .2s;
            -webkit-appearance: none; appearance: none;
        }
        .edit-field input:focus { border-color: #A0231F; background: white; box-shadow: 0 0 0 3px rgba(160,35,31,.08); }
        .edit-field input[type="date"] { cursor: pointer; }

        /* ── Champ en erreur ── */
        .edit-field input.input-error {
            border-color: #A0231F !important;
            background: #FDF1F1 !important;
        }

        /* ── Message d'erreur sous le champ ── */
        .field-error {
            color: #A0231F;
            font-size: .68rem;
            font-weight: 600;
            margin-top: 2px;
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .field-error::before {
            content: '!';
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: #A0231F;
            color: white;
            font-size: .6rem;
            font-weight: 800;
            flex-shrink: 0;
        }

        .edit-locked { display: flex; flex-direction: column; gap: 4px; }
        .edit-locked label { font-size: .65rem; font-weight: 700; color: #A0A0A0; letter-spacing: .5px; text-transform: uppercase; }
        .edit-locked-val {
            padding: 10px 13px; background: #F0EEEA;
            border-radius: 9px; border: 1.5px solid #E0DAD0;
            font-size: .84rem; color: #999;
            display: flex; align-items: center; gap: 8px;
        }
        .edit-locked-note { font-size: .65rem; color: #bbb; display: flex; align-items: center; gap: 4px; margin-top: 2px; }

        .edit-actions { display: flex; gap: 10px; }
        .edit-btn-cancel {
            flex: 1; display: flex; align-items: center; justify-content: center; gap: 6px;
            padding: 11px; border: 2px solid #A0231F; border-radius: 50px;
            background: transparent; color: #A0231F;
            font-family: 'Montserrat', sans-serif; font-size: .84rem; font-weight: 700;
            cursor: pointer; transition: all .22s;
        }
        .edit-btn-cancel:hover { background: #A0231F; color: white; }
        .edit-btn-save {
            flex: 2; display: flex; align-items: center; justify-content: center; gap: 6px;
            padding: 11px;
            background: linear-gradient(90deg, #A0231F, #C0392B);
            color: white; border: none; border-radius: 50px;
            font-family: 'Montserrat', sans-serif; font-size: .84rem; font-weight: 700;
            cursor: pointer; box-shadow: 0 4px 14px rgba(160,35,31,.28);
            transition: transform .18s, box-shadow .18s;
        }
        .edit-btn-save:hover { transform: translateY(-2px); box-shadow: 0 7px 20px rgba(160,35,31,.4); }
    </style>
    
    {% block stylesheets %}{% endblock %}
</head>
