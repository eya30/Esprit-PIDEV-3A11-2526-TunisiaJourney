            border-radius: 50px;
            font-family: 'Montserrat', sans-serif;
            font-size: .88rem;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            box-shadow: 0 4px 14px rgba(160,35,31,.28);
            transition: transform .18s, box-shadow .18s;
        }
        .pf-edit-btn:hover { transform: translateY(-2px); box-shadow: 0 7px 20px rgba(160,35,31,.4); color: white; }
        .pf-edit-btn i { font-size: .85rem; }
        
        /* Edit Modal Profil */
        .edit-modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 2500;
        }
        .edit-modal-overlay.active { display: block; }
        .edit-modal-blur {
            position: absolute;
            inset: 0;
            backdrop-filter: blur(8px);
            background: rgba(26,46,74,0.35);
            cursor: pointer;
        }
        .edit-modal-panel {
            position: absolute;
            top: 50%;
            right: 0;
            transform: translateY(-50%) translateX(100%);
            width: min(520px, 96vw);
            height: 100vh;
            background: linear-gradient(160deg, #FDF6EC 0%, #F5EDD8 100%);
            box-shadow: -12px 0 60px rgba(26,46,74,.18);
            overflow-y: auto;
            transition: transform 0.45s cubic-bezier(.76,0,.24,1);
            padding: 0 0 40px;
        }
        .edit-modal-overlay.active .edit-modal-panel {
            transform: translateY(-50%) translateX(0);
        }
        .edit-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px 28px 10px;
            position: sticky;
            top: 0;
            z-index: 1;
            background: linear-gradient(160deg, #FDF6EC 0%, #F5EDD8 100%);
            border-bottom: 1px solid rgba(160,35,31,.1);
        }
        .edit-modal-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.2rem;
            font-weight: 800;
            color: #1A2E4A;
            margin: 0;
        }
        .edit-modal-close {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            border: none;
            background: rgba(160,35,31,.1);
            color: #A0231F;
            font-size: 1.1rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background .2s, transform .2s;
        }
        .edit-modal-close:hover { background: #A0231F; color: white; transform: rotate(90deg); }
        .edit-body { padding: 20px 28px; display: flex; flex-direction: column; gap: 14px; }
        .edit-hero {
            background: white;
            border-radius: 16px;
            padding: 18px 20px;
            display: flex;
            align-items: center;
            gap: 14px;
            box-shadow: 0 3px 14px rgba(26,46,74,.07);
        }
        .edit-av {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            flex-shrink: 0;
            background: linear-gradient(135deg, #C94040, #A0231F);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.4rem;
            font-weight: 800;
            color: white;
            border: 3px solid rgba(160,35,31,.2);
        }
        .edit-hero-name { font-family: 'Cormorant Garamond', serif; font-size: 1.05rem; font-weight: 800; color: #1A2E4A; margin: 0 0 2px; }
        .edit-hero-sub { font-size: .75rem; color: #A0231F; margin: 0; }
        .edit-card {
            background: white;
            border-radius: 14px;
            padding: 18px 20px;
            box-shadow: 0 3px 14px rgba(26,46,74,.06);
        }
        .edit-card-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: .95rem;
            font-weight: 800;
            color: #1A2E4A;
            margin: 0 0 14px;
            padding-bottom: 8px;
            border-bottom: 1.5px solid #F0E8DD;
            display: flex;
            align-items: center;
            gap: 7px;
        }
        .edit-card-title i { color: #A0231F; font-size: .82rem; }
        .edit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .edit-field { display: flex; flex-direction: column; gap: 4px; }
        .edit-field label { font-size: .65rem; font-weight: 700; color: #A0A0A0; letter-spacing: .5px; text-transform: uppercase; }
        .edit-field input {
            width: 100%;
            padding: 10px 13px;
            border: 1.5px solid #EFE5D0;
            border-radius: 9px;
            font-family: 'Montserrat', sans-serif;
            font-size: .84rem;
            color: #1A2E4A;
            background: #FDF6EC;
            outline: none;
            transition: border-color .2s, background .2s;
            -webkit-appearance: none;
            appearance: none;
        }
        .edit-field input:focus { border-color: #A0231F; background: white; box-shadow: 0 0 0 3px rgba(160,35,31,.08); }
        .edit-field input[type="date"] { cursor: pointer; }
        .edit-field input.input-error {
            border-color: #A0231F !important;
            background: #FDF1F1 !important;
        }
        .field-error {
            color: #A0231F;
            font-size: .68rem;
            font-weight: 600;
            margin-top: 2px;
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .field-error::before {
            content: '!';
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: #A0231F;
            color: white;
            font-size: .6rem;
            font-weight: 800;
            flex-shrink: 0;
        }
        .edit-locked { display: flex; flex-direction: column; gap: 4px; }
        .edit-locked label { font-size: .65rem; font-weight: 700; color: #A0A0A0; letter-spacing: .5px; text-transform: uppercase; }
        .edit-locked-val {
            padding: 10px 13px;
            background: #F0EEEA;
            border-radius: 9px;
            border: 1.5px solid #E0DAD0;
            font-size: .84rem;
            color: #999;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .edit-locked-note { font-size: .65rem; color: #bbb; display: flex; align-items: center; gap: 4px; margin-top: 2px; }
        .edit-actions { display: flex; gap: 10px; }
        .edit-btn-cancel {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 11px;
            border: 2px solid #A0231F;
            border-radius: 50px;
            background: transparent;
            color: #A0231F;
            font-family: 'Montserrat', sans-serif;
            font-size: .84rem;
            font-weight: 700;
            cursor: pointer;
            transition: all .22s;
        }
        .edit-btn-cancel:hover { background: #A0231F; color: white; }
        .edit-btn-save {
            flex: 2;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 11px;
            background: linear-gradient(90deg, #A0231F, #C0392B);
            color: white;
            border: none;
            border-radius: 50px;
            font-family: 'Montserrat', sans-serif;
            font-size: .84rem;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 4px 14px rgba(160,35,31,.28);
            transition: transform .18s, box-shadow .18s;
        }
        .edit-btn-save:hover { transform: translateY(-2px); box-shadow: 0 7px 20px rgba(160,35,31,.4); }
        
        /* Bouton météo flottant */
        .weather-float-btn {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: linear-gradient(135deg, #264653, #2A9D8F);
            color: white;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 5px 20px rgba(0,0,0,0.2);
            transition: all 0.3s ease;
            z-index: 1000;
            text-decoration: none;
        }
        
        .weather-float-btn:hover {
            transform: scale(1.1);
            color: white;
            background: linear-gradient(135deg, #1a3340, #1f7a6f);
        }
        
        .weather-float-btn i {
            font-size: 28px;
        }
        
        .weather-tooltip {
            position: absolute;
            right: 70px;
            background: #264653;
            color: white;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            white-space: nowrap;
            opacity: 0;
            transition: opacity 0.3s;
            pointer-events: none;
        }
        
        .weather-float-btn:hover .weather-tooltip {
            opacity: 1;
        }
        
        .footer {
            background: #4e0915;
            color: white;
            padding: 3rem 0 2rem;
            margin-top: 3rem;
        }
        
        .footer a {
            color: rgba(255,255,255,0.8);
            text-decoration: none;
            transition: all 0.3s ease;
        }
        
        .footer a:hover { color: var(--tunisia-gold); padding-left: 5px; }
        
        .social-icons a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            background: rgba(255,255,255,0.15);
            border-radius: 50%;
            margin: 0 5px;
            transition: all 0.3s ease;
            color: white;
        }
        
        .social-icons a:hover { background: var(--tunisia-red); transform: translateY(-3px); color: white; }
        
        .footer-title { font-size: 1.1rem; font-weight: 600; margin-bottom: 1rem; color: var(--tunisia-gold); }
        .footer-separator { background: rgba(255,255,255,0.2); margin: 2rem 0; }
        .copyright { color: rgba(255,255,255,0.7); font-size: 0.85rem; }
        
        .toast-message {
            position: fixed;
            top: 90px;
            right: 20px;
            z-index: 1050;
            min-width: 300px;
            animation: slideInRight 0.5s ease-out;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }
        
        @keyframes slideInRight {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        
        @media (max-width: 768px) {
            .navbar-brand .logo-text { font-size: 1.2rem; }
            .navbar-brand .logo-img { width: 50px; height: 50px; }
            .reservations-sidebar { width: 100%; left: -100%; }
            .weather-float-btn { width: 50px; height: 50px; bottom: 20px; right: 20px; }
            .weather-float-btn i { font-size: 22px; }
            .reservation-actions { flex-direction: column; }
            .reservation-actions button { width: 100%; justify-content: center; }
            .btn-delete-reservation-link { width: 100%; justify-content: center; }
            .fidelite-niveau { font-size: 1.2rem; }
            .fidelite-points { font-size: 1.3rem; }
        }
    </style>
    
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container">
            <div class="d-flex align-items-center">
                <div class="reservation-menu-icon" id="reservationIcon" style="display: none;">
                    <div class="line"></div>
                    <div class="line"></div>
                    <div class="line"></div>
                </div>
                <a class="navbar-brand" href="{{ path('app_accueil') }}">
                    <img src="{{ asset('images/logo.png') }}" alt="TunisiaJourney" class="logo-img">
                    <div class="logo-text">Tunisia<span>Journey</span></div>
                </a>
            </div>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.get('_route') == 'app_accueil' %}active{% endif %}" href="{{ path('app_accueil') }}">Accueil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.get('_route') starts with 'app_voyage' %}active{% endif %}" href="{{ path('app_voyage_index') }}">Voyages</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_hotel_index') }}">Hôtels</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_evenement_index') }}">Événements</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_produit_index') }}">Produits</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">Forum</a>
                    </li>
                </ul>
                
                {% if app.user %}
                <div class="d-flex align-items-center gap-2 ms-2">
                    <button class="dark-mode-toggle" id="darkModeToggle" title="Mode sombre/clair">
                        <i class="fas fa-sun"></i>
                        <i class="fas fa-moon"></i>
                    </button>
                    
                    <!-- Sélecteur de langue -->
                    <div class="language-selector">
                        <select id="languageSelectCh">
                            <option value="fr">🇫🇷 Français</option>
                            <option value="en">🇬🇧 English</option>
                            <option value="ar">🇸🇦 العربية</option>
                            <option value="de">🇩🇪 Deutsch</option>
                            <option value="it">🇮🇹 Italiano</option>
                            <option value="es">🇪🇸 Español</option>
                        </select>
                    </div>
                    
                    <button class="profile-avatar" id="openProfileModal" title="Mon profil"
                            style="{% if app.user.profileImageUrl %}background:none;padding:0;border:2px solid rgba(227,27,35,0.4);{% endif %}">
                        {% if app.user.profileImageUrl %}
                            <img src="{{ app.user.profileImageUrl }}" alt="Photo"
                                 style="width:100%;height:100%;border-radius:50%;object-fit:cover;">
                        {% else %}
                            {{ app.user.prenom|slice(0,1)|upper }}{{ app.user.nom|slice(0,1)|upper }}
                        {% endif %}
                        <span class="avatar-dot"></span>
                    </button>
                    <form method="post" action="{{ path('app_logout') }}" style="display:inline;">
                        <button class="btn-logout">
                            <i class="fas fa-arrow-right-from-bracket"></i>
                            Déconnexion
                        </button>
                    </form>
                </div>
                {% else %}
                <div class="d-flex align-items-center gap-2">
                    <button class="dark-mode-toggle" id="darkModeToggle2" title="Mode sombre/clair">
                        <i class="fas fa-sun"></i>
                        <i class="fas fa-moon"></i>
                    </button>
                    
                    <!-- Sélecteur de langue -->
                    <div class="language-selector">
                        <select id="languageSelectCh">
                            <option value="fr">🇫🇷 Français</option>
                            <option value="en">🇬🇧 English</option>
                            <option value="ar">🇸🇦 العربية</option>
                            <option value="de">🇩🇪 Deutsch</option>
                            <option value="it">🇮🇹 Italiano</option>
                            <option value="es">🇪🇸 Español</option>
                        </select>
                    </div>
                    
                    <a href="{{ path('app_login') }}" class="btn-login me-2">Connexion</a>
                    <a href="{{ path('app_register') }}" class="btn-register">Inscription</a>
                </div>
                {% endif %}
            </div>
        </div>
    </nav>
    
    <!-- OVERLAY sidebar -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    
    <!-- SIDEBAR RÉSERVATIONS -->
    <div class="reservations-sidebar" id="reservationsSidebar">
        <div class="sidebar-header">
            <h4><i class="fas fa-ticket-alt me-2"></i> Mes Réservations</h4>
            <button class="close-sidebar" id="closeSidebarBtn">&times;</button>
        </div>
        
        <!-- Carte Fidélité - Nouveau design -->
        <div class="fidelite-card" id="fidelite-card" style="display: none;">
            <div id="fidelite-content">
                <i class="fas fa-spinner fa-spin"></i> Chargement...
            </div>
        </div>
        
        <div id="reservationsList">
            <div class="empty-reservations">
                <i class="fas fa-spinner fa-spin fa-2x mb-2"></i>
                <p>Chargement...</p>
            </div>
        </div>
    </div>
    
    <!-- MODAL RÉSERVATION ÉDITION -->
    <div class="edit-modal" id="editModal">
        <div class="edit-modal-content">
            <div class="edit-modal-header">
                <h3>Modifier la réservation</h3>
                <button class="close-edit-modal" id="closeEditModal">&times;</button>
            </div>
            <form id="editReservationForm">
                <input type="hidden" id="editReservationId">
                <input type="hidden" id="editReservationType">
                <div class="edit-form-group">
                    <label>Nom</label>
                    <input type="text" id="editNom">
                </div>
                <div class="edit-form-group">
                    <label>Prénom</label>
                    <input type="text" id="editPrenom">
                </div>
                <div class="edit-form-group">
                    <label>Téléphone</label>
                    <input type="tel" id="editTelephone">
                </div>
                <div class="edit-form-group">
                    <label>Email</label>
                    <input type="email" id="editEmail">
                </div>
                <div class="edit-form-group">
                    <label>Nombre de personnes</label>
                    <input type="number" id="editNbre" min="1">
                </div>
                <button type="submit" class="btn-save-edit">Enregistrer</button>
            </form>
        </div>
    </div>
    
    <!-- Espace navbar fixe -->
    <div style="height: 85px;"></div>
    
    <!-- FLASH MESSAGES -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show toast-message" role="alert">
                <i class="fas fa-{% if label == 'success' %}check-circle{% else %}exclamation-circle{% endif %} me-2"></i>
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}
    
    <!-- MAIN CONTENT -->
    <main>
        {% block body %}{% endblock %}
    </main>
    
    <!-- BOUTON MÉTÉO FLOTTANT -->
