        .pf-badge-dot { width: 6px; height: 6px; border-radius: 50%; background: #22C55E; }
        .pf-card {
            background: white;
            border-radius: 14px;
            padding: 20px 22px;
            box-shadow: 0 3px 16px rgba(26,46,74,.06);
        }
        .pf-card-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: .95rem;
            font-weight: 800;
            color: #1A2E4A;
