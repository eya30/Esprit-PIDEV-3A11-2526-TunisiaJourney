    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
    // ══════════════════════════════════════════
    // MODE SOMBRE
    // ══════════════════════════════════════════
    if (localStorage.getItem('darkMode') === 'enabled') {
        document.body.classList.add('dark-mode');
    }
    function toggleDarkMode() {
        document.body.classList.toggle('dark-mode');
        localStorage.setItem('darkMode', document.body.classList.contains('dark-mode') ? 'enabled' : 'disabled');
    }
    const dmToggle  = document.getElementById('darkModeToggle');
    const dmToggle2 = document.getElementById('darkModeToggle2');
    if (dmToggle)  dmToggle.addEventListener('click', toggleDarkMode);
    if (dmToggle2) dmToggle2.addEventListener('click', toggleDarkMode);

    // ══════════════════════════════════════════
    // SIDEBAR RÉSERVATIONS
    // Affichée sur /voyage* ET /evenement*
    // ══════════════════════════════════════════
    (function() {
        const showOnPaths = ['/voyage', '/evenement'];
        if (showOnPaths.some(p => window.location.pathname.startsWith(p))) {
            const icon = document.getElementById('reservationIcon');
            if (icon) icon.style.display = 'flex';
        }

        const icon      = document.getElementById('reservationIcon');
        const sidebar   = document.getElementById('reservationsSidebar');
        const overlay   = document.getElementById('sidebarOverlay');
        const closeBtn  = document.getElementById('closeSidebarBtn');

        function openSidebar()  { sidebar.classList.add('open'); overlay.classList.add('active'); loadReservations(); }
        function closeSidebar() { sidebar.classList.remove('open'); overlay.classList.remove('active'); }

        if (icon)     icon.addEventListener('click', openSidebar);
        if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
        if (overlay)  overlay.addEventListener('click', closeSidebar);
    })();

    // ══════════════════════════════════════════
    // CHARGEMENT RÉSERVATIONS
    // Détecte automatiquement voyage ou événement
    // ══════════════════════════════════════════
    async function loadReservations() {
        const container = document.getElementById('reservationsList');
        if (!container) return;

        const isEvenement = window.location.pathname.startsWith('/evenement');
        const apiUrl = isEvenement ? '/api/reservations-act' : '/api/reservations';

        container.innerHTML = '<div class="empty-reservations"><i class="fas fa-spinner fa-spin fa-2x mb-2"></i><p>Chargement...</p></div>';

        try {
            const response     = await fetch(apiUrl);
            const reservations = await response.json();

            if (!reservations.length) {
                container.innerHTML = '<div class="empty-reservations"><i class="fas fa-ticket-alt fa-3x mb-2"></i><p>Aucune réservation trouvée</p></div>';
                return;
            }

            container.innerHTML = reservations.map(res => {
                const id     = res.IDRes        ?? res.idRP      ?? '';
                const nom    = res.Nom          ?? res.nom       ?? '';
                const prenom = res.Prenom       ?? res.prenom    ?? '';
                const places = res.NombrePlaces ?? res.nbre      ?? '';
                const prix   = res.Prix         ?? res.prixProg  ?? '';

                // Bouton Modifier : événement → page dédiée, voyage → modal inline
                const editBtn = isEvenement
                    ? `<button class="btn-edit-reservation" onclick="window.location.href='/evenement/reservation/${id}/edit'"><i class="fas fa-edit"></i> Modifier</button>`
                    : `<button class="btn-edit-reservation" onclick="editReservation(${id})"><i class="fas fa-edit"></i> Modifier</button>`;

                return `
                <div class="reservation-card" data-id="${id}">
                    <div class="reservation-info">
                        <div class="reservation-name">${escapeHtml(prenom)} ${escapeHtml(nom)}</div>
                        <div class="reservation-details">
                            <div><i class="fas fa-users"></i> ${places} personne(s)</div>
                            <div><i class="fas fa-tag"></i> ${prix} DT</div>
                        </div>
                    </div>
                    <div class="reservation-actions">
                        ${editBtn}
                        <button class="btn-delete-reservation" onclick="deleteReservation(${id})"><i class="fas fa-trash"></i> Supprimer</button>
                    </div>
                </div>`;
            }).join('');
        } catch (e) {
            container.innerHTML = '<div class="empty-reservations"><i class="fas fa-exclamation-circle fa-3x mb-2"></i><p>Erreur de chargement</p></div>';
        }
    }

    function escapeHtml(str) {
        if (!str) return '';
        return str.replace(/[&<>]/g, m => m === '&' ? '&amp;' : m === '<' ? '&lt;' : '&gt;');
    }

    // ══════════════════════════════════════════
    // VALIDATION INLINE (email, téléphone, nbre)
    // ══════════════════════════════════════════
    function clearValidationErrors() {
        document.querySelectorAll('.validation-error').forEach(s => s.remove());
        document.querySelectorAll('.edit-form-group input').forEach(i => i.classList.remove('input-error'));
    }

    function showValidationErrors(errors) {
        clearValidationErrors();
        const map = { telephone: 'editTelephone', email: 'editEmail', nbre: 'editNbre' };
        for (const [field, msg] of Object.entries(errors)) {
            const el = document.getElementById(map[field]);
            if (el) {
                el.classList.add('input-error');
                const span = document.createElement('span');
                span.className = 'validation-error';
                span.innerHTML = `<i class="fas fa-exclamation-circle"></i> ${msg}`;
                el.parentNode.appendChild(span);
            }
        }
    }

    /**
     * Validation côté client avant envoi
     * Retourne un objet d'erreurs (vide = OK)
     */
    function validateReservationForm() {
        const errors = {};
        const tel   = document.getElementById('editTelephone').value.trim();
        const email = document.getElementById('editEmail').value.trim();
        const nbre  = parseInt(document.getElementById('editNbre').value);

        // Téléphone : 8 chiffres (Tunisie) ou format international
        if (!tel) {
            errors.telephone = 'Le téléphone est obligatoire.';
        } else if (!/^\+?[0-9]{8,15}$/.test(tel.replace(/\s/g, ''))) {
            errors.telephone = 'Numéro invalide (ex: 12345678).';
        }

        // Email
        if (!email) {
            errors.email = "L'email est obligatoire.";
        } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            errors.email = 'Adresse email invalide.';
        }

        // Nombre de places
        if (!nbre || nbre < 1) {
            errors.nbre = 'Le nombre de places doit être ≥ 1.';
        } else if (nbre > 50) {
            errors.nbre = 'Maximum 50 places par réservation.';
        }

        return errors;
    }

    // ══════════════════════════════════════════
    // ÉDITION RÉSERVATION VOYAGE
    // ══════════════════════════════════════════
    async function editReservation(id) {
        try {
            const res  = await (await fetch(`/api/reservations/${id}`)).json();
            document.getElementById('editReservationId').value = id;
            document.getElementById('editNom').value       = res.Nom    || res.nom    || '';
            document.getElementById('editPrenom').value    = res.Prenom || res.prenom || '';
            document.getElementById('editTelephone').value = res.telephone || '';
            document.getElementById('editEmail').value     = res.email     || '';
            document.getElementById('editNbre').value      = res.NombrePlaces || res.nbre || 1;
            clearValidationErrors();
            document.getElementById('editModal').classList.add('active');
        } catch (e) {
            showToast('Erreur lors du chargement de la réservation', 'error');
        }
    }

    document.getElementById('closeEditModal')?.addEventListener('click', () =>
        document.getElementById('editModal').classList.remove('active')
    );

    document.getElementById('editReservationForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Validation client
        const clientErrors = validateReservationForm();
        if (Object.keys(clientErrors).length) {
            showValidationErrors(clientErrors);
            showToast('Veuillez corriger les erreurs', 'error');
            return;
        }

        const id  = document.getElementById('editReservationId').value;
        const btn = e.target.querySelector('button[type="submit"]');
        const origText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Enregistrement...';

        try {
            const response = await fetch(`/api/reservations/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    telephone: document.getElementById('editTelephone').value.trim(),
                    email:     document.getElementById('editEmail').value.trim(),
                    nbre:      parseInt(document.getElementById('editNbre').value)
                })
            });
            const result = await response.json();
            if (response.ok) {
                document.getElementById('editModal').classList.remove('active');
                loadReservations();
                showToast('Réservation modifiée avec succès !', 'success');
            } else if (result.errors) {
                showValidationErrors(result.errors);
                showToast('Veuillez corriger les erreurs', 'error');
            } else {
                showToast('Erreur lors de la modification', 'error');
            }
        } catch (err) {
            showToast('Erreur lors de la modification', 'error');
        } finally {
            btn.disabled = false;
            btn.innerHTML = origText;
        }
    });

    // ══════════════════════════════════════════
    // SUPPRESSION RÉSERVATION
    // ══════════════════════════════════════════
    async function deleteReservation(id) {
        if (!confirm('Êtes-vous sûr de vouloir supprimer cette réservation ?')) return;
        const isEvenement = window.location.pathname.startsWith('/evenement');
        const apiBase     = isEvenement ? '/api/reservations-act' : '/api/reservations';
        try {
            const r = await fetch(`${apiBase}/${id}`, { method: 'DELETE' });
            if (r.ok) { loadReservations(); showToast('Réservation supprimée avec succès !', 'success'); }
            else showToast('Erreur lors de la suppression', 'error');
        } catch (e) { showToast('Erreur lors de la suppression', 'error'); }
    }

    // ══════════════════════════════════════════
    // TOAST
    // ══════════════════════════════════════════
    function showToast(message, type = 'success') {
        const toast = document.createElement('div');
        toast.className = `alert alert-${type === 'success' ? 'success' : 'danger'} toast-message`;
        toast.innerHTML = `<i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'} me-2"></i> ${message}`;
        document.body.appendChild(toast);
        setTimeout(() => {
            toast.style.transition = 'opacity 0.5s';
            toast.style.opacity = '0';
            setTimeout(() => toast.remove(), 500);
        }, 3000);
    }

    // Auto-dismiss flash messages
    setTimeout(() => {
        document.querySelectorAll('.toast-message').forEach(t => {
            t.style.transition = 'opacity 0.5s';
            t.style.opacity = '0';
            setTimeout(() => t.remove(), 500);
        });
    }, 5000);

    // Navbar scroll effect
    window.addEventListener('scroll', () => {
        document.querySelector('.navbar')?.classList.toggle('scrolled', window.scrollY > 50);
    });
    </script>

    <!-- ══════════════════════════════════════════
         JS MODALS PROFIL + EDIT PROFIL
    ══════════════════════════════════════════ -->
    <script>
    (function(){
        const profileModal    = document.getElementById('profileModal');
        const openProfileBtn  = document.getElementById('openProfileModal');
        const closeProfileBtn = document.getElementById('closeProfileModal');
        const profileBlur     = document.getElementById('profileBlur');
        const editModal       = document.getElementById('editProfileModal');
        const openEditBtn     = document.getElementById('openEditModal');
        const closeEditBtn    = document.getElementById('closeEditModal2');
        const cancelEditBtn   = document.getElementById('cancelEditModal');
        const editBlur        = document.getElementById('editModalBlur');

        function openProfile()   { if (profileModal) { profileModal.classList.add('active'); document.body.style.overflow = 'hidden'; } }
        function closeProfile()  { if (profileModal) { profileModal.classList.remove('active'); document.body.style.overflow = ''; } }
        function openEdit()      { closeProfile(); if (editModal) { editModal.classList.add('active'); document.body.style.overflow = 'hidden'; } }
        function closeEdit()     { if (editModal) { editModal.classList.remove('active'); document.body.style.overflow = ''; } openProfile(); }
        function closeEditOnly() { if (editModal) { editModal.classList.remove('active'); document.body.style.overflow = ''; } }

        if (openProfileBtn)  openProfileBtn.addEventListener('click', openProfile);
        if (closeProfileBtn) closeProfileBtn.addEventListener('click', closeProfile);
        if (profileBlur)     profileBlur.addEventListener('click', closeProfile);
        if (openEditBtn)     openEditBtn.addEventListener('click', openEdit);
        if (closeEditBtn)    closeEditBtn.addEventListener('click', closeEdit);
        if (cancelEditBtn)   cancelEditBtn.addEventListener('click', closeEdit);
        if (editBlur)        editBlur.addEventListener('click', closeEditOnly);

        document.addEventListener('keydown', e => { if (e.key === 'Escape') { closeProfile(); closeEditOnly(); } });

        // Soumission formulaire profil
        const profileEditForm = document.getElementById('profileEditForm');
        if (profileEditForm) {
            profileEditForm.addEventListener('submit', function(e) {
                e.preventDefault();
                const btn = profileEditForm.querySelector('.edit-btn-save');
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Enregistrement...';
                btn.disabled = true;
                profileEditForm.submit();
            });
        }

        // Prévisualisation photo
        const photoInput = document.getElementById('photoInput');
        if (photoInput) {
            photoInput.addEventListener('change', function() {
                const file = this.files[0]; if (!file) return;
                const reader = new FileReader();
                reader.onload = e => {
                    const av = document.getElementById('editAvatarPreview');
                    if (av) av.innerHTML = `<img src="${e.target.result}" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">`;
                };
                reader.readAsDataURL(file);
            });
        }

        // Hover avatar caméra
        const av = document.getElementById('editAvatarPreview');
        if (av) {
            const cam = av.querySelector('.avatar-hover-cam');
            if (cam) {
                av.addEventListener('mouseenter', () => cam.style.opacity = '1');
                av.addEventListener('mouseleave', () => cam.style.opacity = '0');
            }
        }

        // Réouverture après redirect
        const params = new URLSearchParams(window.location.search);
        if (params.get('openProfile') === '1')   { openProfile(); history.replaceState({}, '', window.location.pathname); }
        if (params.get('openEditModal') === '1') {
            openEdit(); history.replaceState({}, '', window.location.pathname);
            fetch('/api/profile/clear-errors', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } }).catch(() => {});
        }
        if (editModal && editModal.classList.contains('active')) document.body.style.overflow = 'hidden';
    })();
    </script>

    <!-- ══════════════════════════════════════════
         SESSION TIMEOUT JS
    ══════════════════════════════════════════ -->
    {% if app.user %}
    <script>
    (function() {
        var INACTIVE_MS  = 15 * 60 * 1000; // 15 minutes
        var WARNING_SECS = 60;
        var inactiveTimer, countdownTimer;
        var countLeft = WARNING_SECS;
        var overlay  = document.getElementById('inactivityOverlay');
        var counter  = document.getElementById('inactivityCounter');
        var bar      = document.getElementById('inactivityBar');

        function resetTimer() {
            clearTimeout(inactiveTimer);
            clearInterval(countdownTimer);
            if (overlay && overlay.classList.contains('active')) {
                overlay.classList.remove('active');
                document.body.style.overflow = '';
                if (counter) counter.style.color = '#C41E3A';
            }
            inactiveTimer = setTimeout(showWarning, INACTIVE_MS);
        }

        function showWarning() {
            if (!overlay) return;
            countLeft = WARNING_SECS;
            if (counter) counter.textContent = countLeft;
            if (bar) bar.style.width = '100%';
            overlay.classList.add('active');
            document.body.style.overflow = 'hidden';

            countdownTimer = setInterval(function() {
                countLeft--;
                if (counter) counter.textContent = countLeft;
                if (bar) bar.style.width = Math.round((countLeft / WARNING_SECS) * 100) + '%';
                if (countLeft <= 10 && counter) counter.style.color = '#DC2626';
                if (countLeft <= 0) {
                    clearInterval(countdownTimer);
                    document.getElementById('inactivityLogoutForm').submit();
                }
            }, 1000);
        }

        window.inactivityStay = function() { resetTimer(); };

        ['mousemove', 'mousedown', 'keydown', 'touchstart', 'scroll', 'click'].forEach(function(evt) {
            document.addEventListener(evt, resetTimer, { passive: true });
        });

        resetTimer();
    })();
    </script>
    {% endif %}

    {# ══════════════════════════════════════════
       TOAST ÉMOTION — Face ID login
    ══════════════════════════════════════════ #}
    {% if app.session.get('face_emotion') %}
    {% set _emo = app.session.get('face_emotion') %}
    <script>
    (function() {
        const emoji  = {{ _emo.emoji|json_encode|raw }};
        const msg    = {{ _emo.message|json_encode|raw }};
        const prenom = {{ _emo.prenom|json_encode|raw }};

        const overlay = document.createElement('div');
        overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.4);backdrop-filter:blur(4px);z-index:99998;';

        const toast = document.createElement('div');
        toast.style.cssText = `
            position:fixed;top:50%;left:50%;
            transform:translate(-50%,-50%);
            background:white;border-radius:20px;
            padding:32px 40px;text-align:center;
            box-shadow:0 20px 60px rgba(0,0,0,.25);
            z-index:99999;min-width:300px;
            animation:toastPop .4s cubic-bezier(.34,1.56,.64,1);
            font-family:'Montserrat',sans-serif;
        `;
        toast.innerHTML = `
            <style>
                @keyframes toastPop { from{transform:translate(-50%,-50%) scale(.7);opacity:0} to{transform:translate(-50%,-50%) scale(1);opacity:1} }
                @keyframes progressBar { from{width:100%} to{width:0%} }
            </style>
            <div style="font-size:3.8rem;margin-bottom:12px;">${emoji}</div>
            <div style="font-family:'Cormorant Garamond',serif;font-size:1.3rem;font-weight:800;color:#1A2E4A;margin-bottom:6px;">
                ${prenom ? 'Bonjour ' + prenom + ' !' : 'Connexion réussie !'}
            </div>
            <div style="font-size:.88rem;color:#777;line-height:1.5;">${msg}</div>
            <div style="margin-top:16px;height:3px;background:#F0E0E0;border-radius:10px;overflow:hidden;">
                <div style="height:100%;background:linear-gradient(90deg,#C41E3A,#E31B23);animation:progressBar 3s linear forwards;border-radius:10px;"></div>
            </div>
        `;

        document.body.appendChild(overlay);
        document.body.appendChild(toast);

        function dismiss() {
            toast.style.transition = 'opacity .4s';
            overlay.style.transition = 'opacity .4s';
            toast.style.opacity = overlay.style.opacity = '0';
            setTimeout(() => { toast.remove(); overlay.remove(); }, 400);
        }
        overlay.addEventListener('click', dismiss);
        setTimeout(dismiss, 3500);
    })();
    </script>
    {% do app.session.remove('face_emotion') %}
    {% endif %}

    {% block javascripts %}{% endblock %}
</body>
</html>
