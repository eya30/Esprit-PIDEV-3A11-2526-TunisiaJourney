    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        // ==================== MODE SOMBRE ====================
        if (localStorage.getItem('darkMode') === 'enabled') {
            document.body.classList.add('dark-mode');
        }
        
        function toggleDarkMode() {
            document.body.classList.toggle('dark-mode');
            if (document.body.classList.contains('dark-mode')) {
                localStorage.setItem('darkMode', 'enabled');
            } else {
                localStorage.setItem('darkMode', 'disabled');
            }
        }
        
        const darkModeToggle = document.getElementById('darkModeToggle');
        const darkModeToggle2 = document.getElementById('darkModeToggle2');
        
        if (darkModeToggle) darkModeToggle.addEventListener('click', toggleDarkMode);
        if (darkModeToggle2) darkModeToggle2.addEventListener('click', toggleDarkMode);
        
        // ==================== TRADUCTION ====================
        // Fonction pour traduire la page
        async function translatePage(lang) {
            const path = window.location.pathname;
            console.log('Traduction vers:', lang);
            
            // Page chambre
            const chambreMatch = path.match(/\/chambre\/(\d+)/);
            if (chambreMatch) {
                const id = chambreMatch[1];
                console.log('ID chambre:', id);
                try {
                    const response = await fetch(`/traduction/chambre/${id}?lang=${lang}`);
                    const data = await response.json();
                    console.log('Données reçues:', data);
                    
                    // Mettre à jour le titre
                    const titleEl = document.getElementById('chambre-type');
                    if (titleEl) titleEl.innerHTML = data.type;
                    
                    // Mettre à jour la description
                    const descEl = document.getElementById('chambre-description');
                    if (descEl) descEl.innerHTML = data.description;
                    
                    // Mettre à jour le nom de l'hôtel
                    const hotelEl = document.getElementById('hotel-nom');
                    if (hotelEl) hotelEl.innerHTML = data.hotel_nom;
                    
                    const hotelMetaEl = document.getElementById('hotel-nom-meta');
                    if (hotelMetaEl) hotelMetaEl.innerHTML = data.hotel_nom;
                    
                    // Mettre à jour la ville
                    const villeEl = document.getElementById('hotel-ville');
                    if (villeEl) villeEl.innerHTML = data.hotel_ville;
                    
                    localStorage.setItem('preferred_language', lang);
                    alert('Page traduite en ' + lang.toUpperCase());
                } catch (error) {
                    console.error('Erreur:', error);
                    alert('Erreur de traduction');
                }
                return;
            }
            
            // Page hôtel
            const hotelMatch = path.match(/\/hotel\/(\d+)/);
            if (hotelMatch) {
                const id = hotelMatch[1];
                console.log('ID hôtel:', id);
                try {
                    const response = await fetch(`/traduction/hotel/${id}?lang=${lang}`);
                    const data = await response.json();
                    console.log('Données reçues:', data);
                    
                    const titleEl = document.querySelector('.hotel-title');
                    if (titleEl) titleEl.innerHTML = data.nom;
                    
                    const descEl = document.querySelector('.hotel-description');
                    if (descEl) descEl.innerHTML = data.description;
                    
                    const locationEl = document.querySelector('.hotel-location');
                    if (locationEl) locationEl.innerHTML = '<i class="fas fa-map-marker-alt"></i> ' + data.ville + ', ' + data.adresse;
                    
                    localStorage.setItem('preferred_language', lang);
                    alert('Page traduite en ' + lang.toUpperCase());
                } catch (error) {
                    console.error('Erreur:', error);
                    alert('Erreur de traduction');
                }
                return;
            }
        }
        
        // Ajouter l'événement au sélecteur de langue
        const languageSelect = document.getElementById('languageSelectCh');
        if (languageSelect) {
            // Récupérer la langue sauvegardée
            const savedLang = localStorage.getItem('preferred_language') || 'fr';
            languageSelect.value = savedLang;
            
            // Traduire automatiquement si la langue n'est pas français
            if (savedLang !== 'fr') {
                setTimeout(() => translatePage(savedLang), 500);
            }
            
            // Écouter le changement
            languageSelect.addEventListener('change', function() {
                const selectedLang = this.value;
                if (selectedLang === 'fr') {
                    window.location.reload();
                } else {
                    translatePage(selectedLang);
                }
            });
        }
        
        // ==================== FIDÉLITÉ - NOUVEAU DESIGN ====================
        async function chargerFidelite() {
            try {
                const response = await fetch('/api/fidelite');
                const data = await response.json();
                
                if (data.error) {
                    const fideliteCard = document.getElementById('fidelite-card');
                    if (fideliteCard) fideliteCard.style.display = 'none';
                    return;
                }
                
                const container = document.getElementById('fidelite-content');
                const fideliteCard = document.getElementById('fidelite-card');
                
                if (container && fideliteCard) {
                    fideliteCard.style.display = 'block';
                    
                    let reductionHtml = '';
                    if (data.reduction > 0) {
                        reductionHtml = `<div class="fidelite-reduction">
                            <i class="fas fa-tag"></i> -${data.reduction}% sur vos réservations
                        </div>`;
                    }
                    
                    let progressionHtml = '';
                    if (data.points_restants && data.points_restants > 0) {
                        const pourcentage = (data.points / (data.points + data.points_restants)) * 100;
                        progressionHtml = `
                            <div class="fidelite-progress-container">
                                <div class="fidelite-progress-label">
                                    <span>Progression vers ${data.prochain_seuil}</span>
                                    <span>${data.points} / ${data.points + data.points_restants} pts</span>
                                </div>
                                <div class="fidelite-progress">
                                    <div class="fidelite-progress-bar" style="width: ${pourcentage}%;"></div>
                                </div>
                                <div class="fidelite-next">
                                    <i class="fas fa-arrow-up"></i> Encore ${data.points_restants} points
                                </div>
                            </div>
                        `;
                    } else if (data.niveau === 'platine') {
                        progressionHtml = `<div class="fidelite-next">🏆 Niveau maximum atteint ! 🏆</div>`;
                    }
                    
                    const icones = {
                        bronze: 'fa-medal',
                        argent: 'fa-medal',
                        or: 'fa-crown',
                        platine: 'fa-gem'
                    };
                    
                    container.innerHTML = `
                        <div class="fidelite-badge">FIDÉLITÉ</div>
                        <div class="fidelite-icon">
                            <i class="fas ${icones[data.niveau] || 'fa-star'}"></i>
                        </div>
                        <div class="fidelite-niveau" style="color: ${data.couleur}; text-shadow: 0 0 10px ${data.couleur}40;">
                            ${data.niveau}
                        </div>
                        <div class="fidelite-points">
                            ${data.points} <small>points</small>
                        </div>
                        ${reductionHtml}
                        ${progressionHtml}
                    `;
                }
            } catch (error) {
                console.error('Erreur chargement fidélité:', error);
            }
        }
        
        // ==================== SIDEBAR RÉSERVATIONS ====================
        const showReservationIcon = ['/voyage/', '/voyage', '/hotel/', '/hotel', '/evenement/', '/evenement'];
        if (showReservationIcon.some(p => window.location.pathname.startsWith(p))) {
            const icon = document.getElementById('reservationIcon');
            if (icon) icon.style.display = 'flex';
        }
        
        const reservationIcon = document.getElementById('reservationIcon');
        const sidebar = document.getElementById('reservationsSidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const closeSidebarBtn = document.getElementById('closeSidebarBtn');
        
        function openSidebar() {
            if (sidebar && overlay) { 
                sidebar.classList.add('open'); 
                overlay.classList.add('active'); 
                loadReservations();
                setTimeout(chargerFidelite, 500);
            }
        }
        
        function closeSidebar() {
            if (sidebar && overlay) { 
                sidebar.classList.remove('open'); 
                overlay.classList.remove('active'); 
            }
        }
        
        if (reservationIcon) reservationIcon.addEventListener('click', openSidebar);
        if (closeSidebarBtn) closeSidebarBtn.addEventListener('click', closeSidebar);
        if (overlay) overlay.addEventListener('click', closeSidebar);
        
        async function loadReservations() {
            const container = document.getElementById('reservationsList');
            if (!container) return;
            
            try {
                const path = window.location.pathname;
                let reservations = [];
                
                if (path.startsWith('/hotel') || path.startsWith('/chambre')) {
                    const response = await fetch('/reservation/api/reservations/all');
                    const data = await response.json();
                    reservations = data.map(r => ({ ...r, type: 'chambre' }));
                }
                else if (path.startsWith('/voyage')) {
                    const response = await fetch('/api/reservations');
                    const data = await response.json();
                    reservations = data.map(r => ({ ...r, type: 'voyage' }));
                }
                else if (path.startsWith('/evenement')) {
                    const response = await fetch('/api/reservations-act');
                    const data = await response.json();
                    reservations = data.map(r => ({ ...r, type: 'activite' }));
                }
                else {
                    const [respChambres, respVoyages] = await Promise.all([
                        fetch('/reservation/api/reservations/all'),
                        fetch('/api/reservations')
                    ]);
                    const chambres = (await respChambres.json()).map(c => ({ ...c, type: 'chambre' }));
                    const voyages = (await respVoyages.json()).map(v => ({ ...v, type: 'voyage' }));
                    reservations = [...chambres, ...voyages];
                }
                
                if (!reservations || reservations.length === 0) {
                    container.innerHTML = '<div class="empty-reservations"><i class="fas fa-ticket-alt fa-3x mb-2"></i><p>Aucune réservation trouvée</p></div>';
                    return;
                }
                
                container.innerHTML = reservations.map(res => {
                    if (res.type === 'chambre') {
                        const rid = res.idRes || res.id || res.idRP;
                        const nom = res.nom || '';
                        const prenom = res.prenom || '';
                        const email = res.email || '';
                        const telephone = res.telephone || '';
                        const chambreNum = res.chambre_num || '-';
                        const hotelNom = res.hotel_nom || '';
                        const prixTotal = res.prixTotal || 0;
                        const nbPersonnes = res.nbPersonnes || 1;
                        const dateDebut = res.dateDebut || '';
                        const dateFin = res.dateFin || '';
                        const nbNuit = res.nbNuit || 0;
                        const statut = res.statut || 'en_attente';
                        
                        return `
                            <div class="reservation-card" data-id="${rid}" data-type="chambre">
                                <div class="reservation-info">
                                    <div class="reservation-name">${escapeHtml(nom)} ${escapeHtml(prenom)}</div>
                                    <div class="reservation-sub">${escapeHtml(email)} | ${escapeHtml(telephone)}</div>
                                    <div class="reservation-details">
                                        <div><strong>🏨 Hôtel :</strong> ${escapeHtml(hotelNom)}</div>
                                        <div><strong>🛏️ Chambre :</strong> n°${chambreNum}</div>
                                        <div><strong>👥 Personnes :</strong> ${nbPersonnes}</div>
                                        <div><strong>📅 Dates :</strong> du ${dateDebut} au ${dateFin}</div>
                                        <div><strong>🌙 Nuits :</strong> ${nbNuit}</div>
                                        <div><strong>💰 Prix total :</strong> ${prixTotal} TND</div>
                                        <div><span class="${statut === 'confirmé' ? 'badge-success' : 'badge-warning'}">${statut === 'confirmé' ? '✓ Confirmée' : '⏳ En attente'}</span></div>
                                    </div>
                                </div>
                                <div class="reservation-actions">
                                    <button class="btn-edit-reservation" onclick="editReservationChambre(${rid})">
                                        <i class="fas fa-edit"></i> Modifier
                                    </button>
                                    <a href="/reservation/chambre/${rid}/supprimer" class="btn-delete-reservation-link">
                                        <i class="fas fa-trash-alt"></i> Supprimer
                                    </a>
                                    <button class="btn-qr-reservation" onclick="showQRCode(${rid})">
                                        <i class="fas fa-qrcode"></i> QR Code
                                    </button>
                                </div>
                            </div>
                        `;
                    }
                    else if (res.type === 'voyage') {
                        const rid = res.idRP || res.id;
                        const nom = res.nom || '';
                        const prenom = res.prenom || '';
                        const email = res.email || '';
                        const telephone = res.telephone || '';
                        const nbre = res.nbre || 1;
                        const prixProg = res.prixProg || 0;
                        const dateProgramme = res.dateProgramme || '';
                        
                        return `
                            <div class="reservation-card" data-id="${rid}" data-type="voyage">
                                <div class="reservation-info">
                                    <div class="reservation-name">${escapeHtml(prenom)} ${escapeHtml(nom)}</div>
                                    <div class="reservation-sub">${escapeHtml(email)} | ${escapeHtml(telephone)}</div>
                                    <div class="reservation-details">
                                        <div><strong>👥 Personnes :</strong> ${nbre}</div>
                                        <div><strong>📅 Date :</strong> ${dateProgramme}</div>
                                        <div><strong>💰 Prix total :</strong> ${prixProg} DT</div>
                                    </div>
                                </div>
                                <div class="reservation-actions">
                                    <button class="btn-edit-reservation" onclick="editReservation(${rid})">
                                        <i class="fas fa-edit"></i> Modifier
                                    </button>
                                    <button class="btn-delete-reservation" onclick="deleteReservation(${rid})">
                                        <i class="fas fa-trash"></i> Supprimer
                                    </button>
                                </div>
                            </div>
                        `;
                    }
                    else {
                        const rid = res.IDRes || res.id;
                        const nom = res.Nom || res.nom || '';
                        const prenom = res.Prenom || res.prenom || '';
                        const email = res.email || '';
                        const telephone = res.telephone || '';
                        const nbre = res.NombrePlaces || res.nbre || 1;
                        const prix = res.Prix || 0;
                        const dateReservation = res.DateReservation || '';
                        
                        return `
                            <div class="reservation-card" data-id="${rid}" data-type="activite">
                                <div class="reservation-info">
                                    <div class="reservation-name">${escapeHtml(prenom)} ${escapeHtml(nom)}</div>
                                    <div class="reservation-sub">${escapeHtml(email)} | ${escapeHtml(telephone)}</div>
                                    <div class="reservation-details">
                                        <div><strong>👥 Personnes :</strong> ${nbre}</div>
                                        <div><strong>📅 Date :</strong> ${dateReservation}</div>
                                        <div><strong>💰 Prix total :</strong> ${prix} DT</div>
                                    </div>
                                </div>
                                <div class="reservation-actions">
                                    <button class="btn-edit-reservation" onclick="editReservationAct(${rid})">
                                        <i class="fas fa-edit"></i> Modifier
                                    </button>
                                    <button class="btn-delete-reservation" onclick="deleteReservationAct(${rid})">
                                        <i class="fas fa-trash"></i> Supprimer
                                    </button>
                                </div>
                            </div>
                        `;
                    }
                }).join('');
            } catch (error) {
                console.error('Erreur:', error);
                container.innerHTML = '<div class="empty-reservations"><i class="fas fa-exclamation-circle fa-3x mb-2"></i><p>Erreur de chargement</p></div>';
            }
        }
        
        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/[&<>]/g, m => m === '&' ? '&amp;' : m === '<' ? '&lt;' : '&gt;');
        }
        
        async function editReservation(id) {
            try {
                const response = await fetch(`/api/reservations/${id}`);
                const res = await response.json();
                document.getElementById('editReservationId').value = res.idRP;
                document.getElementById('editReservationType').value = 'voyage';
                document.getElementById('editNom').value = res.nom;
                document.getElementById('editPrenom').value = res.prenom;
                document.getElementById('editTelephone').value = res.telephone;
                document.getElementById('editEmail').value = res.email;
                document.getElementById('editNbre').value = res.nbre;
                document.getElementById('editModal').classList.add('active');
            } catch (error) { alert('Erreur lors du chargement'); }
        }
        
        async function editReservationChambre(id) {
            try {
                const response = await fetch(`/reservation/api/reservations/chambres/${id}`);
                const res = await response.json();
                document.getElementById('editReservationId').value = res.id;
                document.getElementById('editReservationType').value = 'chambre';
                document.getElementById('editNom').value = res.nom || '';
                document.getElementById('editPrenom').value = res.prenom || '';
                document.getElementById('editTelephone').value = res.telephone || '';
                document.getElementById('editEmail').value = res.email || '';
                document.getElementById('editNbre').value = res.nbPersonnes || 1;
                document.getElementById('editModal').classList.add('active');
            } catch (error) { alert('Erreur lors du chargement'); }
        }
        
        async function editReservationAct(id) {
            try {
                const response = await fetch(`/api/reservations-act/${id}`);
                const res = await response.json();
                document.getElementById('editReservationId').value = res.IDRes;
                document.getElementById('editReservationType').value = 'activite';
                document.getElementById('editNom').value = res.Nom || '';
                document.getElementById('editPrenom').value = res.Prenom || '';
                document.getElementById('editTelephone').value = res.telephone || '';
                document.getElementById('editEmail').value = res.email || '';
                document.getElementById('editNbre').value = res.NombrePlaces || 1;
                document.getElementById('editModal').classList.add('active');
            } catch (error) { alert('Erreur lors du chargement'); }
        }
        
        const closeEditModal = document.getElementById('closeEditModal');
        if (closeEditModal) {
            closeEditModal.addEventListener('click', () => document.getElementById('editModal').classList.remove('active'));
        }
        
        const editForm = document.getElementById('editReservationForm');
        if (editForm) {
            editForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const id = document.getElementById('editReservationId').value;
                const type = document.getElementById('editReservationType').value;
                const data = {
                    nom: document.getElementById('editNom').value,
                    prenom: document.getElementById('editPrenom').value,
                    telephone: document.getElementById('editTelephone').value,
                    email: document.getElementById('editEmail').value,
                    nbre: parseInt(document.getElementById('editNbre').value)
                };
                
                let url;
                if (type === 'chambre') {
                    url = `/reservation/api/reservations/chambres/${id}`;
                } else if (type === 'voyage') {
                    url = `/api/reservations/${id}`;
                } else {
                    url = `/api/reservations-act/${id}`;
                }
                
                try {
                    const response = await fetch(url, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    if (response.ok) {
                        document.getElementById('editModal').classList.remove('active');
                        loadReservations();
                        showToast('Réservation modifiée avec succès !');
                    } else { alert('Erreur lors de la modification'); }
                } catch (error) { alert('Erreur lors de la modification'); }
            });
        }
        
        async function deleteReservation(id) {
            if (!confirm('Êtes-vous sûr de vouloir supprimer cette réservation ?')) return;
            try {
                const response = await fetch(`/api/reservations/${id}`, { method: 'DELETE' });
                if (response.ok) { loadReservations(); showToast('Réservation supprimée avec succès !'); }
                else { alert('Erreur lors de la suppression'); }
            } catch (error) { alert('Erreur lors de la suppression'); }
        }
        
        async function deleteReservationAct(id) {
            if (!confirm('Êtes-vous sûr de vouloir supprimer cette réservation ?')) return;
            try {
                const response = await fetch(`/api/reservations-act/${id}`, { method: 'DELETE' });
                if (response.ok) { loadReservations(); showToast('Réservation supprimée avec succès !'); }
                else { alert('Erreur lors de la suppression'); }
            } catch (error) { alert('Erreur lors de la suppression'); }
        }
        
        function showToast(message) {
            const toast = document.createElement('div');
            toast.className = 'alert alert-success toast-message';
            toast.innerHTML = `<i class="fas fa-check-circle me-2"></i> ${message}`;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }
        
        setTimeout(() => {
            document.querySelectorAll('.toast-message').forEach(toast => {
                toast.style.transition = 'opacity 0.5s';
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 500);
            });
        }, 5000);
        
        window.addEventListener('scroll', () => {
            const navbar = document.querySelector('.navbar');
            if (window.scrollY !== undefined) navbar.classList.toggle('scrolled', window.scrollY > 50);
        });
        
        // ==================== QR CODE FUNCTIONS ====================
        let currentQRCodeDataUri = null;

        function showQRCode(id) {
            console.log('Génération QR code pour ID:', id);
            const modal = document.getElementById('qrModal');
            modal.style.display = 'flex';
            document.getElementById('qrCodeImage').innerHTML = '<div style="text-align: center;"><i class="fas fa-spinner fa-spin fa-3x"></i><p>Génération du QR code...</p></div>';
            document.getElementById('qrDetails').innerHTML = '<p><i class="fas fa-spinner fa-spin"></i> Chargement des détails...</p>';
            
            fetch(`/reservation/api/reservations/chambres/${id}/qrcode`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Erreur HTTP ' + response.status);
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success && data.qrCode) {
                        currentQRCodeDataUri = data.qrCode;
                        document.getElementById('qrCodeImage').innerHTML = `<img src="${data.qrCode}" style="width: 200px; height: 200px; border: 3px solid #264653; border-radius: 15px; padding: 10px; background: white;">`;
                        
                        const res = data.reservation;
                        let detailsHtml = `
                            <h4 style="color: #264653; margin-bottom: 15px;">🏨 ${res.hotel_nom || 'Hôtel'}</h4>
                            <div style="margin-bottom: 15px;">
                                <p><strong>🛏️ Chambre n° :</strong> ${res.chambre_num || '-'}</p>
                                <p><strong>👤 Client :</strong> ${res.prenom || ''} ${res.nom || ''}</p>
                                <p><strong>📧 Email :</strong> ${res.email || '-'}</p>
                                <p><strong>📞 Téléphone :</strong> ${res.telephone || '-'}</p>
                                <p><strong>👥 Personnes :</strong> ${res.nbPersonnes || 1}</p>
                                <p><strong>📅 Dates :</strong> du ${res.dateDebut || '-'} au ${res.dateFin || '-'}</p>
                                <p><strong>🌙 Nuits :</strong> ${res.nbNuit || 0}</p>
                            </div>
                            <hr style="border-color: #E8DFD1;">
                            <div style="margin: 15px 0;">
                                <h4 style="color: #C0392B;">💰 Détail du prix</h4>
                                <p><strong>Prix total payé :</strong> <span style="font-size: 1.2rem; color: #C0392B;">${res.prixTotal || 0} TND</span></p>
                                <p><strong>Détail complet :</strong> ${res.detailsPrix || '-'}</p>
                            </div>
                        `;
                        document.getElementById('qrDetails').innerHTML = detailsHtml;
                    } else {
                        document.getElementById('qrCodeImage').innerHTML = '<p style="color: red;">Erreur lors de la génération du QR code</p>';
                        document.getElementById('qrDetails').innerHTML = '<p style="color: red;">' + (data.error || 'Impossible de charger les détails') + '</p>';
                    }
                })
                .catch(error => {
                    console.error('Erreur:', error);
                    document.getElementById('qrCodeImage').innerHTML = '<p style="color: red;">Erreur de connexion</p>';
                    document.getElementById('qrDetails').innerHTML = '<p style="color: red;">Impossible de charger les détails. Vérifiez que la réservation existe.</p>';
                });
        }

        function closeQRModal() {
            document.getElementById('qrModal').style.display = 'none';
            document.getElementById('qrCodeImage').innerHTML = '';
            document.getElementById('qrDetails').innerHTML = '<p><i class="fas fa-spinner fa-spin"></i> Chargement...</p>';
            currentQRCodeDataUri = null;
        }

        function downloadQRCode() {
            if (currentQRCodeDataUri) {
                const link = document.createElement('a');
                link.download = 'qrcode_reservation.png';
                link.href = currentQRCodeDataUri;
                link.click();
            } else {
                alert('Aucun QR code à télécharger');
            }
        }

        document.addEventListener('click', function(event) {
            const modal = document.getElementById('qrModal');
            if (event.target === modal) {
                closeQRModal();
            }
        });
    </script>
    
    <script>
    (function(){
        const profileModal   = document.getElementById('profileModal');
        const openProfileBtn = document.getElementById('openProfileModal');
        const closeProfileBtn= document.getElementById('closeProfileModal');
        const profileBlur    = document.getElementById('profileBlur');
        
        const editModal      = document.getElementById('editProfileModal');
        const openEditBtn    = document.getElementById('openEditModal');
        const closeEditBtn   = document.getElementById('closeEditModal2');
        const cancelEditBtn  = document.getElementById('cancelEditModal');
        const editBlur       = document.getElementById('editModalBlur');
        
        function openProfile() {
            if (profileModal) { profileModal.classList.add('active'); document.body.style.overflow = 'hidden'; }
        }
        function closeProfile() {
            if (profileModal) { profileModal.classList.remove('active'); document.body.style.overflow = ''; }
        }
        function openEdit() {
            closeProfile();
            if (editModal) { editModal.classList.add('active'); document.body.style.overflow = 'hidden'; }
        }
        function closeEdit() {
            if (editModal) { editModal.classList.remove('active'); document.body.style.overflow = ''; }
            openProfile();
        }
        function closeEditOnly() {
            if (editModal) { editModal.classList.remove('active'); document.body.style.overflow = ''; }
        }
        
        if (openProfileBtn)  openProfileBtn.addEventListener('click', openProfile);
        if (closeProfileBtn) closeProfileBtn.addEventListener('click', closeProfile);
        if (profileBlur)     profileBlur.addEventListener('click', closeProfile);
        if (openEditBtn)     openEditBtn.addEventListener('click', openEdit);
        if (closeEditBtn)    closeEditBtn.addEventListener('click', closeEdit);
        if (cancelEditBtn)   cancelEditBtn.addEventListener('click', closeEdit);
        if (editBlur)        editBlur.addEventListener('click', closeEditOnly);
        
        document.addEventListener('keydown', function(e){
            if (e.key === 'Escape') { closeProfile(); closeEditOnly(); }
        });
        
        const profileEditForm = document.getElementById('profileEditForm');
        if (profileEditForm) {
            profileEditForm.addEventListener('submit', function(e) {
                e.preventDefault();
                const btn = profileEditForm.querySelector('.edit-btn-save');
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Enregistrement...';
                btn.disabled = true;
                profileEditForm.submit();
            });
        }
        
        const photoInput = document.getElementById('photoInput');
        if (photoInput) {
            photoInput.addEventListener('change', function() {
                const file = this.files[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = function(e) {
                    const av = document.getElementById('editAvatarPreview');
                    if (av) av.innerHTML = `<img src="${e.target.result}" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">`;
                };
                reader.readAsDataURL(file);
            });
        }
        
        if (new URLSearchParams(window.location.search).get('openProfile') === '1') {
            openProfile();
            history.replaceState({}, '', window.location.pathname);
        }
        
        if (editModal && editModal.classList.contains('active')) {
            document.body.style.overflow = 'hidden';
        }
    })();
    </script>
    
    {% block javascripts %}{% endblock %}
</body>
</html>