<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}TunisiaJourney - Découvrez la Tunisie{% endblock %}</title>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&family=Cormorant+Garamond:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --tunisia-red: #E31B23;
            --tunisia-dark-red: #C41E3A;
            --tunisia-orange: #FF6B35;
            --tunisia-gold: #FFCBCC;
            --tunisia-blue: #0054A6;
            --tunisia-sand: #FDF5E6;
            --tunisia-white: #FFFFFF;
            --tunisia-cream: #FEF9E6;
            --footer-blue: #4e0915;
            --dark-gray: #2C3E50;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        body.dark-mode {
            --tunisia-red: #FF6B6B;
            --tunisia-dark-red: #FF4757;
            --tunisia-orange: #FFA502;
            --tunisia-gold: #FFEAA7;
            --tunisia-blue: #70A1FF;
            --tunisia-sand: #1a1a2e;
            --tunisia-white: #2d2d3f;
            --tunisia-cream: #25253a;
            --footer-blue: #0f0f1a;
            --dark-gray: #e0e0e0;
            background-color: #1a1a2e;
            color: #e0e0e0;
        }
        
        body.dark-mode .navbar {
            background: rgba(30, 30, 47, 0.98);
            box-shadow: 0 2px 20px rgba(0,0,0,0.3);
        }
        
        body.dark-mode .navbar-brand .logo-text,
        body.dark-mode .navbar-brand .logo-text span {
            color: #FF6B6B;
        }
        
        body.dark-mode .nav-link {
            color: #e0e0e0;
        }
        
        body.dark-mode .nav-link:hover,
        body.dark-mode .nav-link.active {
            color: #FF6B6B;
        }
        
        body.dark-mode .nav-link::after {
            background: #FF6B6B;
        }
        
        body.dark-mode .btn-login {
            border-color: #FF6B6B;
            color: #FF6B6B;
        }
        
        body.dark-mode .btn-login:hover {
            background: #FF6B6B;
            color: #1a1a2e;
        }
        
        body.dark-mode .btn-register {
            background: #FF6B6B;
            color: #1a1a2e;
        }
        
        body.dark-mode .btn-register:hover {
            background: #FF4757;
        }
        
        body.dark-mode .btn-logout {
            border-color: #FF6B6B;
            color: #FF6B6B;
        }
        
        body.dark-mode .btn-logout:hover {
            background: #FF6B6B;
            color: #1a1a2e;
        }
        
        body.dark-mode .reservations-sidebar {
            background: #2d2d3f;
            border-left: 1px solid rgba(255,255,255,0.1);
        }
        
        body.dark-mode .sidebar-header {
            border-bottom-color: rgba(255,255,255,0.1);
        }
        
        body.dark-mode .reservation-card {
            background: #25253a;
            border-color: rgba(255,255,255,0.08);
        }
        
        body.dark-mode .reservation-card:hover {
            border-color: #FF6B6B;
        }
        
        body.dark-mode .close-sidebar,
        body.dark-mode .close-edit-modal {
            color: #aaa;
        }
        
        body.dark-mode .edit-modal-content {
            background: #2d2d3f;
            border: 1px solid rgba(255,255,255,0.1);
        }
        
        body.dark-mode .edit-form-group input {
            background: #25253a;
            border-color: rgba(255,255,255,0.1);
            color: #e0e0e0;
        }
        
        body.dark-mode .footer {
            background: #0f0f1a;
        }
        
        body.dark-mode .profile-modal-panel,
        body.dark-mode .edit-modal-panel {
            background: linear-gradient(160deg, #25253a 0%, #1e1e2f 100%);
        }
        
        body.dark-mode .pf-hero,
        body.dark-mode .pf-card,
        body.dark-mode .edit-hero,
        body.dark-mode .edit-card {
            background: #2d2d3f;
            border: 1px solid rgba(255,255,255,0.08);
        }
        
        body.dark-mode .pf-value {
            background: #25253a;
            border-color: rgba(255,255,255,0.08);
        }
        
        body.dark-mode .edit-field input {
            background: #25253a;
            border-color: rgba(255,255,255,0.1);
            color: #e0e0e0;
        }
        
        body.dark-mode .profile-modal-header,
        body.dark-mode .edit-modal-header {
            background: linear-gradient(160deg, #25253a 0%, #1e1e2f 100%);
            border-bottom-color: rgba(255,255,255,0.1);
        }
        
        .dark-mode-toggle {
            background: transparent;
            border: none;
            cursor: pointer;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
            margin-left: 12px;
            position: relative;
            overflow: hidden;
        }
        
        .dark-mode-toggle i {
            font-size: 1.3rem;
            transition: var(--transition);
        }
        
        .dark-mode-toggle .fa-sun {
            color: #F59E0B;
            display: block;
        }
        
        .dark-mode-toggle .fa-moon {
            color: #C49A6C;
            display: none;
        }
        
        body.dark-mode .dark-mode-toggle .fa-sun {
            display: none;
        }
        
        body.dark-mode .dark-mode-toggle .fa-moon {
            display: block;
        }
        
        .dark-mode-toggle:hover {
            background: rgba(0,0,0,0.05);
            transform: scale(1.1);
        }
        
        body.dark-mode .dark-mode-toggle:hover {
            background: rgba(255,255,255,0.1);
        }
        
        body {
            transition: background-color 0.3s ease, color 0.3s ease;
            font-family: 'Montserrat', sans-serif;
            color: var(--dark-gray);
            background: var(--tunisia-sand) !important;
            background-color: #FDF5E6 !important;
        }
        
        .container, .main-content, .content, section, .py-5 {
            background: transparent !important;
        }
        
        h1, h2, h3, h4, .logo-text {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 800;
        }
        
        .navbar {
            background: rgba(255,255,255,0.98);
            padding: 0.8rem 0;
            box-shadow: 0 2px 20px rgba(0,0,0,0.08);
            transition: all 0.3s ease;
        }
        
        .navbar.scrolled {
            padding: 0.5rem 0;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
        }
        
        .reservation-menu-icon {
            cursor: pointer;
            margin-right: 2rem;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            gap: 5px;
            padding: 5px;
        }
        
        .reservation-menu-icon .line {
            width: 25px;
            height: 3px;
            background-color: var(--tunisia-red);
            border-radius: 3px;
            transition: all 0.3s ease;
        }
        
        .reservation-menu-icon:hover .line {
            background-color: var(--tunisia-orange);
        }
        
        .reservation-menu-icon:hover {
            transform: scale(1.05);
        }
        
        .reservations-sidebar {
            position: fixed;
            top: 0;
            left: -450px;
            width: 450px;
            height: 100vh;
            background: white;
            box-shadow: 5px 0 30px rgba(0,0,0,0.1);
            z-index: 1050;
            transition: left 0.3s ease;
            overflow-y: auto;
            padding: 1.5rem;
        }
        
        .reservations-sidebar.open {
            left: 0;
        }
        
        .sidebar-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 1040;
            display: none;
        }
        
        .sidebar-overlay.active {
            display: block;
        }
        
        .sidebar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 1rem;
            margin-bottom: 1.5rem;
            border-bottom: 2px solid #F0E8DD;
        }
        
        .sidebar-header h4 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.5rem;
            color: var(--tunisia-red);
            margin: 0;
        }
        
        .close-sidebar {
            background: none;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: #9CA3AF;
            transition: all 0.2s;
        }
        
        .close-sidebar:hover {
            color: var(--tunisia-red);
            transform: rotate(90deg);
        }
        
        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            transition: all 0.3s ease;
        }
        
        .navbar-brand:hover {
            transform: scale(1.02);
        }
        
        .navbar-brand .logo-img {
            width: 70px;
            height: 70px;
            object-fit: contain;
        }
        
        .navbar-brand .logo-text {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--tunisia-red);
        }
        
        .navbar-brand .logo-text span {
            color: var(--tunisia-orange);
        }
        
        .nav-link {
            font-weight: 500;
            color: var(--dark-gray);
            transition: all 0.3s ease;
            margin: 0 0.5rem;
            position: relative;
            padding-bottom: 5px;
        }
        
        .nav-link::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--tunisia-red);
            transition: width 0.3s ease;
            border-radius: 2px;
        }
        
        .nav-link:hover::after { width: 100%; }
        .nav-link.active::after { width: 100%; }
        .nav-link:hover, .nav-link.active { color: var(--tunisia-red); }
        
        .btn-login {
            background: transparent;
            border: 2px solid var(--tunisia-red);
            color: var(--tunisia-red);
            padding: 8px 25px;
            border-radius: 30px;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }
        
        .btn-login:hover {
            background: var(--tunisia-red);
            color: white;
            transform: translateY(-2px);
        }
        
        .btn-register {
            background: var(--tunisia-red);
            border: none;
            color: white;
            padding: 8px 25px;
            border-radius: 30px;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }
        
        .btn-register:hover {
            background: #C41E3A;
            transform: translateY(-2px);
            color: white;
        }
        
        .btn-logout {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: transparent;
            color: var(--tunisia-dark-red);
            border: 2px solid var(--tunisia-dark-red);
            padding: 7px 18px;
            border-radius: 30px;
            font-weight: 600;
            font-size: 0.85rem;
            font-family: 'Montserrat', sans-serif;
            cursor: pointer;
            transition: all 0.28s ease;
            letter-spacing: 0.3px;
        }
        
        .btn-logout i { font-size: 0.9rem; transition: transform 0.28s ease; }
        .btn-logout:hover {
            background: var(--tunisia-dark-red);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 5px 16px rgba(196,30,58,0.28);
        }
        .btn-logout:hover i { transform: translateX(3px); }
        
        .profile-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--tunisia-red), var(--tunisia-dark-red));
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.95rem;
            color: white;
            letter-spacing: 0.5px;
            border: 2.5px solid rgba(227,27,35,0.25);
            box-shadow: 0 3px 12px rgba(227,27,35,0.22);
            transition: all 0.28s ease;
            position: relative;
            flex-shrink: 0;
            cursor: pointer;
            font-family: 'Montserrat', sans-serif;
        }
        
        .profile-avatar:hover {
            transform: scale(1.1);
            box-shadow: 0 5px 18px rgba(227,27,35,0.38);
        }
        
        .avatar-dot {
            position: absolute;
            bottom: 1px;
            right: 1px;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #22C55E;
            border: 2px solid white;
        }
        
        .reservation-card {
            background: #FEF9F0;
            border-radius: 16px;
            padding: 1rem;
            margin-bottom: 1rem;
            border: 1px solid #F0E8DD;
            transition: all 0.2s;
        }
        
        .reservation-card:hover {
            transform: translateX(5px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            border-color: var(--tunisia-red);
        }
        
        .reservation-info { margin-bottom: 0.5rem; }
        .reservation-name { font-weight: 700; color: var(--tunisia-red); margin-bottom: 0.3rem; font-size: 1rem; }
        .reservation-sub { font-size: 0.7rem; color: #93032E; margin-bottom: 0.5rem; font-weight: 500; word-break: break-all; }
        .reservation-details { font-size: 0.75rem; color: #6c757d; }
        .reservation-details div { margin-bottom: 0.25rem; }
        .reservation-details strong { color: #2C1810; }
        
        .badge-success {
            background: #D1FAE5;
            color: #059669;
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 0.65rem;
            font-weight: 600;
            display: inline-block;
        }
        
        .badge-warning {
            background: #FEF3C7;
            color: #D97706;
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 0.65rem;
            font-weight: 600;
            display: inline-block;
        }
        
        .reservation-actions {
            display: flex;
            gap: 0.5rem;
            margin-top: 0.5rem;
            flex-wrap: wrap;
        }
        
        .reservation-actions button {
            background: none;
            border: none;
            padding: 5px 10px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 0.7rem;
        }
        
        .btn-edit-reservation { background: #FEF3C7; color: #D97706; }
        .btn-edit-reservation:hover { background: #F59E0B; color: white; }
        
        /* Bouton QR Code - visible */
        .btn-qr-reservation {
            background: #6B5B95 !important;
            color: white !important;
            border: none !important;
            padding: 5px 12px !important;
            border-radius: 8px !important;
            cursor: pointer !important;
            transition: all 0.2s !important;
            display: inline-flex !important;
            align-items: center !important;
            gap: 5px !important;
            font-size: 0.7rem !important;
            font-weight: 500 !important;
        }
        
        .btn-qr-reservation:hover {
            background: #5a4a7a !important;
            transform: translateY(-2px) !important;
            color: white !important;
        }
        
        .btn-qr-reservation i {
            font-size: 0.7rem !important;
        }
        
        /* Bouton Supprimer - lien vers la page de suppression */
        .btn-delete-reservation-link {
            background: #FEF2F2 !important;
            color: #EF4444 !important;
            border: none !important;
            padding: 5px 12px !important;
            border-radius: 8px !important;
            cursor: pointer !important;
            transition: all 0.2s !important;
            display: inline-flex !important;
            align-items: center !important;
            gap: 5px !important;
            font-size: 0.7rem !important;
            font-weight: 500 !important;
            text-decoration: none !important;
        }
        
        .btn-delete-reservation-link:hover {
            background: #EF4444 !important;
            color: white !important;
            transform: translateY(-2px) !important;
        }
        
        /* Sélecteur de langue */
        .language-selector select {
            padding: 5px 10px;
            border-radius: 30px;
            border: 1px solid #E8DFD1;
            background: white;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.2s;
        }
        
        .language-selector select:hover {
            border-color: var(--tunisia-red);
        }
        
        body.dark-mode .language-selector select {
            background: #2d2d3f;
            border-color: rgba(255,255,255,0.1);
            color: #e0e0e0;
        }
        
        /* Nouveau design carte fidélité - Professionnel */
        .fidelite-card {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            border-radius: 20px;
            padding: 20px;
            margin-bottom: 20px;
            color: white;
            text-align: center;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,0.1);
        }
        
        .fidelite-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 70%);
            pointer-events: none;
        }
        
        .fidelite-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }
        
        .fidelite-niveau {
            font-size: 1.8rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin: 5px 0;
            text-shadow: 0 2px 5px rgba(0,0,0,0.3);
        }
        
        .fidelite-points {
            font-size: 2rem;
            font-weight: 800;
            margin: 10px 0;
            background: rgba(255,255,255,0.15);
            display: inline-block;
            padding: 5px 20px;
            border-radius: 50px;
        }
        
        .fidelite-points small {
            font-size: 0.8rem;
            font-weight: normal;
        }
        
        .fidelite-reduction {
            background: rgba(255,215,0,0.2);
            border-radius: 50px;
            padding: 8px 15px;
            display: inline-block;
            margin-top: 10px;
            font-size: 0.9rem;
            font-weight: 600;
        }
        
        .fidelite-progress-container {
            margin-top: 15px;
            text-align: left;
        }
        
        .fidelite-progress-label {
            display: flex;
            justify-content: space-between;
            font-size: 0.7rem;
            margin-bottom: 5px;
            color: rgba(255,255,255,0.7);
        }
        
        .fidelite-progress {
            background: rgba(255,255,255,0.2);
            border-radius: 10px;
            height: 8px;
            overflow: hidden;
        }
        
        .fidelite-progress-bar {
            background: linear-gradient(90deg, #FFD700, #FFA500);
            border-radius: 10px;
            height: 100%;
            width: 0%;
            transition: width 0.5s ease;
        }
        
        .fidelite-next {
            font-size: 0.7rem;
            margin-top: 8px;
            color: rgba(255,255,255,0.6);
            text-align: center;
        }
        
        .fidelite-icon {
            font-size: 2rem;
            margin-bottom: 5px;
        }
        
        .fidelite-badge {
            position: absolute;
            top: 10px;
            right: 10px;
            background: rgba(255,255,255,0.2);
            border-radius: 20px;
            padding: 3px 10px;
            font-size: 0.6rem;
            font-weight: 600;
        }
        
        .edit-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 1100;
            align-items: center;
            justify-content: center;
        }
        
        .edit-modal.active { display: flex; }
        
        .edit-modal-content {
            background: white;
            border-radius: 20px;
            padding: 2rem;
            max-width: 450px;
            width: 90%;
        }
        
        .edit-modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #E8DFD1;
        }
        
        .edit-modal-header h3 { font-size: 1.3rem; color: var(--tunisia-blue); margin: 0; }
        
        .close-edit-modal {
            background: none;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: #9CA3AF;
        }
        
        .edit-form-group { margin-bottom: 1rem; }
        
        .edit-form-group label {
            display: block;
            font-size: 0.85rem;
            font-weight: 500;
            margin-bottom: 0.3rem;
        }
        
        .edit-form-group input {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #E8DFD1;
            border-radius: 10px;
            font-size: 0.9rem;
        }
        
        .edit-form-group input:focus { outline: none; border-color: var(--tunisia-blue); }
        
        .btn-save-edit {
            width: 100%;
            background: var(--tunisia-blue);
            color: white;
            border: none;
            padding: 12px;
            border-radius: 30px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 1rem;
        }
        
        .btn-save-edit:hover { background: #00408a; }
        
        .empty-reservations { text-align: center; padding: 2rem; color: #9CA3AF; }
        
        /* Profile Modal */
        .profile-modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 2000;
        }
        .profile-modal-overlay.active { display: block; }
        .profile-modal-blur {
            position: absolute;
            inset: 0;
            backdrop-filter: blur(8px);
            background: rgba(26,46,74,0.35);
        }
        .profile-modal-panel {
            position: absolute;
            top: 50%;
            right: 0;
            transform: translateY(-50%) translateX(100%);
            width: min(520px, 96vw);
            height: 100vh;
            background: linear-gradient(160deg, #FDF6EC 0%, #F5EDD8 100%);
            box-shadow: -12px 0 60px rgba(26,46,74,.18);
            overflow-y: auto;
            transition: transform 0.45s cubic-bezier(.76,0,.24,1);
