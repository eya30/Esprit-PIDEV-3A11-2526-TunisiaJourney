{% extends 'base.html.twig' %}

{% block title %}Assistant TunisiaJourney{% endblock %}

{% block stylesheets %}
<style>
    .assistant-container {
        max-width: 800px;
        margin: 50px auto;
        padding: 30px;
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        text-align: center;
    }
    
    h1 {
        color: #93032E;
        font-family: 'Playfair Display', serif;
        margin-bottom: 20px;
    }
    
    .chat-container {
        background: #FEF9F0;
        border-radius: 15px;
        padding: 20px;
        height: 400px;
        overflow-y: auto;
        margin-bottom: 20px;
        border: 1px solid #F0E8DD;
    }
    
    .message {
        margin-bottom: 15px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
    }
    
    .message.user {
        flex-direction: row-reverse;
    }
    
    .message.user .message-content {
        background: #93032E;
        color: white;
        border-radius: 20px 20px 5px 20px;
    }
    
    .message.bot .message-content {
        background: white;
        color: #2C1810;
        border-radius: 20px 20px 20px 5px;
        border: 1px solid #F0E8DD;
    }
    
    .message-content {
        max-width: 70%;
        padding: 12px 16px;
        font-size: 14px;
        line-height: 1.5;
    }
    
    .message-avatar {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    
    .user .message-avatar {
        background: #93032E;
        color: white;
    }
    
    .bot .message-avatar {
        background: #E8DFD1;
        color: #93032E;
    }
    
    .input-group {
        display: flex;
        gap: 10px;
    }
    
    .input-group input {
        flex: 1;
        padding: 12px 15px;
        border: 1px solid #E8DFD1;
        border-radius: 30px;
        font-size: 14px;
        background: #FEF9F0;
    }
    
    .input-group input:focus {
        outline: none;
        border-color: #93032E;
    }
    
    .btn-send {
        background: #93032E;
        border: none;
        color: white;
        width: 45px;
        height: 45px;
        border-radius: 50%;
        cursor: pointer;
        transition: all 0.2s;
    }
    
    .btn-send:hover {
        background: #6B0221;
        transform: scale(1.05);
    }
    
    .btn-mic {
        background: #2C1810;
        border: none;
        color: white;
        width: 45px;
        height: 45px;
        border-radius: 50%;
        cursor: pointer;
        transition: all 0.2s;
    }
    
    .btn-mic:hover {
        background: #4A3B2F;
        transform: scale(1.05);
    }
    
    .btn-mic.listening {
        background: #E31B23;
        animation: pulse 1.5s infinite;
    }
    
    @keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.1); }
        100% { transform: scale(1); }
    }
    
    .typing {
        display: flex;
        gap: 4px;
        padding: 10px 15px;
        background: white;
        border-radius: 20px;
        width: fit-content;
    }
    
    .typing span {
        width: 8px;
        height: 8px;
        background: #9CA3AF;
        border-radius: 50%;
        animation: typing 1.4s infinite;
    }
    
    .typing span:nth-child(2) { animation-delay: 0.2s; }
    .typing span:nth-child(3) { animation-delay: 0.4s; }
    
    @keyframes typing {
        0%, 60%, 100% { transform: translateY(0); }
        30% { transform: translateY(-10px); }
    }
    
    .examples {
        margin-top: 20px;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: center;
    }
    
    .example-btn {
        background: white;
        border: 1px solid #E8DFD1;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        cursor: pointer;
        transition: all 0.2s;
    }
    
    .example-btn:hover {
        background: #93032E;
        color: white;
        border-color: #93032E;
    }
</style>
{% endblock %}

{% block body %}
<div class="assistant-container">
    <h1><i class="fas fa-robot"></i> Assistant TunisiaJourney</h1>
    <p>Posez vos questions sur nos voyages et destinations</p>
    
    <div class="chat-container" id="chatContainer">
        <div class="message bot">
            <div class="message-avatar">
                <i class="fas fa-robot"></i>
            </div>
            <div class="message-content">
                Bonjour ! Je suis l'assistant TunisiaJourney. <br>
                Je peux vous renseigner sur nos voyages, les prix, les programmes et vous aider à planifier votre séjour.<br><br>
                Que souhaitez-vous savoir ?
            </div>
        </div>
    </div>
    
    <div class="input-group">
        <input type="text" id="questionInput" placeholder="Posez votre question..." autocomplete="off">
        <button class="btn-mic" id="micBtn" title="Parler au micro">
            <i class="fas fa-microphone"></i>
        </button>
        <button class="btn-send" id="sendBtn">
            <i class="fas fa-paper-plane"></i>
        </button>
    </div>
    
    <div class="examples">
        <button class="example-btn" data-question="Quels sont les voyages disponibles ?">📋 Voyages disponibles</button>
        <button class="example-btn" data-question="Quel est le prix moyen d'un voyage en Tunisie ?">💰 Prix moyens</button>
        <button class="example-btn" data-question="Quelle est la meilleure période pour visiter le Sahara ?">🏜️ Sahara</button>
        <button class="example-btn" data-question="Je veux voyager en famille, que me conseillez-vous ?">👨‍👩‍👧‍👦 Voyage famille</button>
    </div>
</div>

<script>
    const chatContainer = document.getElementById('chatContainer');
    const questionInput = document.getElementById('questionInput');
    const sendBtn = document.getElementById('sendBtn');
    const micBtn = document.getElementById('micBtn');
    
    let isSending = false;
    let recognition = null;
    
    function addMessage(message, isUser = false) {
        const messageDiv = document.createElement('div');
        messageDiv.className = `message ${isUser ? 'user' : 'bot'}`;
        
        messageDiv.innerHTML = `
            <div class="message-avatar">
                <i class="fas ${isUser ? 'fa-user' : 'fa-robot'}"></i>
            </div>
            <div class="message-content">${escapeHtml(message)}</div>
        `;
        
        chatContainer.appendChild(messageDiv);
        chatContainer.scrollTop = chatContainer.scrollHeight;
    }
    
    function showTyping() {
        const typingDiv = document.createElement('div');
        typingDiv.className = 'message bot';
        typingDiv.id = 'typingIndicator';
        typingDiv.innerHTML = `
            <div class="message-avatar">
                <i class="fas fa-robot"></i>
            </div>
            <div class="typing">
                <span></span><span></span><span></span>
            </div>
        `;
        chatContainer.appendChild(typingDiv);
        chatContainer.scrollTop = chatContainer.scrollHeight;
    }
    
    function removeTyping() {
        const indicator = document.getElementById('typingIndicator');
        if (indicator) indicator.remove();
    }
    
    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
    
    async function sendQuestion(question) {
        if (isSending || !question.trim()) return;
        
        addMessage(question, true);
        questionInput.value = '';
        isSending = true;
        showTyping();
        
        try {
            const response = await fetch('{{ path("app_ai_ask") }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'question=' + encodeURIComponent(question)
            });
            
            const data = await response.json();
            removeTyping();
            
            if (data.success) {
                addMessage(data.answer, false);
                // Lire la réponse à voix haute
                speakAnswer(data.answer);
            } else {
                addMessage(data.error || 'Une erreur est survenue', false);
            }
        } catch (error) {
            removeTyping();
            addMessage('Désolé, une erreur de connexion est survenue.', false);
        } finally {
            isSending = false;
        }
    }
    
    function speakAnswer(text) {
        if ('speechSynthesis' in window) {
            const utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = 'fr-FR';
            utterance.rate = 0.9;
            window.speechSynthesis.speak(utterance);
        }
    }
    
    // Reconnaissance vocale
    if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        recognition = new SpeechRecognition();
        recognition.lang = 'fr-FR';
        recognition.continuous = false;
        recognition.interimResults = false;
        
        recognition.onstart = () => {
            micBtn.classList.add('listening');
        };
        
        recognition.onend = () => {
            micBtn.classList.remove('listening');
        };
        
        recognition.onresult = (event) => {
            const text = event.results[0][0].transcript;
            questionInput.value = text;
            sendQuestion(text);
        };
        
        recognition.onerror = () => {
            micBtn.classList.remove('listening');
        };
    }
    
    sendBtn.addEventListener('click', () => sendQuestion(questionInput.value));
    questionInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') sendQuestion(questionInput.value);
    });
    
    micBtn.addEventListener('click', () => {
        if (recognition && !micBtn.classList.contains('listening')) {
            recognition.start();
        }
    });
    
    document.querySelectorAll('.example-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const question = btn.getAttribute('data-question');
            sendQuestion(question);
        });
    });
</script>
{% endblock %}