                            <input type="radio" name="avis_chambre[noteCalme]" value="4" id="calme_4"><label for="calme_4">☆</label>
                            <input type="radio" name="avis_chambre[noteCalme]" value="3" id="calme_3"><label for="calme_3">☆</label>
                            <input type="radio" name="avis_chambre[noteCalme]" value="2" id="calme_2"><label for="calme_2">☆</label>
