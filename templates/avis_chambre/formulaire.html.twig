                            <input type="radio" name="avis_chambre[noteConfort]" value="3" id="confort_3"><label for="confort_3">☆</label>
                            <input type="radio" name="avis_chambre[noteConfort]" value="2" id="confort_2"><label for="confort_2">☆</label>
