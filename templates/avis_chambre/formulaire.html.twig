                            <input type="radio" name="avis_chambre[noteServices]" value="4" id="services_4"><label for="services_4">☆</label>
                            <input type="radio" name="avis_chambre[noteServices]" value="3" id="services_3"><label for="services_3">☆</label>
                            <input type="radio" name="avis_chambre[noteServices]" value="2" id="services_2"><label for="services_2">☆</label>
                            <input type="radio" name="avis_chambre[noteServices]" value="1" id="services_1"><label for="services_1">☆</label>
