                        <i class="fas fa-comment-dots" style="color: #E31B23;"></i> Votre commentaire (optionnel)
                    </label>
                    {{ form_widget(formAvis.commentaire, {'attr': {'style': 'width:100%; border:1px solid #F0E8DD; border-radius:12px; padding:1rem; resize:vertical;', 'rows': 4}}) }}
                </div>
                
                <button type="submit" class="btn-submit-avis" style="background: linear-gradient(135deg, #E31B23, #FF6B35); color: white; border: none; padding: 14px 40px; border-radius: 50px; font-weight: 700; width: 100%; display: flex; align-items: center; justify-content: center; gap: 10px; cursor: pointer; transition: all 0.3s ease;">
