<style>
    /* Style pour les étoiles interactives */
    .star-rating {
        display: flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
        gap: 8px;
    }
    
    .star-rating input {
        display: none;
    }
    
    .star-rating label {
        font-size: 28px;
        cursor: pointer;
        color: #ddd;
        transition: all 0.2s ease;
    }
    
    .star-rating label:before {
        content: "☆";
    }
    
    .star-rating input:checked ~ label:before,
    .star-rating label:hover:before,
    .star-rating label:hover ~ label:before {
        content: "★";
        color: #FFD700;
    }
    
    .star-rating input:checked ~ label {
        color: #FFD700;
    }
    
    .btn-submit-avis:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(227,27,35,0.3);
    }
    
    .critere-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        border-color: #E31B23;
    }
</style>

<script>
    // Script pour gérer les étoiles interactives
    document.addEventListener('DOMContentLoaded', function() {
        const starRatings = document.querySelectorAll('.star-rating');
        
        starRatings.forEach(rating => {
            const labels = rating.querySelectorAll('label');
            const inputs = rating.querySelectorAll('input');
            
            labels.forEach((label, index) => {
                label.addEventListener('click', function() {
                    const value = this.htmlFor.split('_')[1];
                    // Mettre à jour l'affichage
                    inputs.forEach((input, i) => {
                        if (i >= (5 - parseInt(value))) {
                            const lbl = input.nextElementSibling;
                            if (lbl) lbl.style.color = '#FFD700';
                        } else {
                            const lbl = input.nextElementSibling;
                            if (lbl) lbl.style.color = '#ddd';
                        }
                    });
                });
            });
        });
    });
</script>