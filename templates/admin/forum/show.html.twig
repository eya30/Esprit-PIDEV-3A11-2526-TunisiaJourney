{% extends 'admin/dashboard/base_admin.html.twig' %}

{% block title %}{{ forum.nom }} — Publications{% endblock %}
{% block page_title %}{{ forum.nom }}{% endblock %}

{% block body %}

<style>
.tj-table-wrap { background: white; border-radius: 20px; border: 1px solid #F0E8DD; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.04); }
.tj-table { width: 100%; border-collapse: collapse; }
.tj-table thead tr { background: #FEF9F0; border-bottom: 2px solid #F0E8DD; }
.tj-table th { padding: 14px 20px; font-size: 0.72rem; font-weight: 700; color: #93032E; text-transform: uppercase; letter-spacing: 0.6px; white-space: nowrap; }
.tj-table td { padding: 14px 20px; font-size: 0.87rem; border-bottom: 1px solid #F5F0E8; color: #4A3B2F; vertical-align: middle; }
.tj-table tr:last-child td { border-bottom: none; }
.tj-table tbody tr:hover td { background: #FFF9F0; transition: background 0.15s; }
.tj-badge { padding: 4px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; display: inline-block; white-space: nowrap; }
.tj-badge-wine { background: #FEF9F0; color: #93032E; border: 1px solid #F0E8DD; }
.tj-badge-orange { background: #FEF3C7; color: #B45309; }
.tj-badge-green { background: #E0F2E9; color: #047857; }
.tj-badge-grey { background: #F3F4F6; color: #6B7280; }
.tj-badge-blue { background: #EFF6FF; color: #3B82F6; }
.media-thumb { width: 64px; height: 48px; border-radius: 8px; object-fit: cover; border: 1px solid #F0E8DD; display: block; }
.media-thumb-video { width: 64px; height: 48px; border-radius: 8px; object-fit: cover; border: 1px solid #F5CAC3; display: block; }
.media-cell { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.tj-actions { display: flex; gap: 8px; justify-content: center; align-items: center; }
.action-btn { width: 34px; height: 34px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; transition: all 0.2s; cursor: pointer; border: none; font-size: 0.9rem; text-decoration: none; }
.view-btn { background: #EFF6FF; color: #3B82F6; }
.view-btn:hover { background: #3B82F6; color: white; transform: translateY(-2px); }
.edit-btn { background: #FEF3C7; color: #D97706; }
.edit-btn:hover { background: #F59E0B; color: white; transform: translateY(-2px); }
.delete-btn { background: #FEF2F2; color: #EF4444; }
.delete-btn:hover { background: #EF4444; color: white; transform: translateY(-2px); }
.tj-btn-primary { background: #93032E; color: white; border: none; padding: 9px 18px; border-radius: 40px; font-size: 0.85rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s; }
.tj-btn-primary:hover { background: #6B0221; color: white; transform: translateY(-2px); box-shadow: 0 4px 14px rgba(147,3,46,0.3); }
.tj-btn-back { background: #F3F4F6; color: #6B7280; border: none; padding: 9px 18px; border-radius: 40px; font-size: 0.85rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s; }
.tj-btn-back:hover { background: #E5E7EB; color: #374151; }
.search-wrap { position: relative; }
.search-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #C49A6C; font-size: 0.9rem; }
.search-input { width: 100%; padding: 10px 14px 10px 38px; border: 1px solid #E8DFD1; border-radius: 10px; font-size: 0.87rem; background: #FEF9F0; color: #2C1810; outline: none; transition: all 0.2s; min-width: 260px; }
.search-input:focus { border-color: #93032E; background: white; box-shadow: 0 0 0 3px rgba(147,3,46,0.06); }
.tj-empty { background: white; border-radius: 20px; border: 1px solid #F0E8DD; padding: 3rem; text-align: center; }
.sort-btn { padding: 9px 16px; border-radius: 10px; border: 1.5px solid #F0E8DD; background: #FEF9F0; color: #93032E; font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 0.18s; }
.sort-btn:hover { background: #93032E; color: white; border-color: #93032E; }
.sort-active { background: #93032E !important; color: white !important; border-color: #93032E !important; box-shadow: 0 2px 8px rgba(147,3,46,0.25) !important; }

/* ── PAGINATION STYLES ── */
.pagination-container { 
    display: flex; 
    justify-content: center; 
    align-items: center; 
    gap: 8px; 
    margin-top: 24px; 
    margin-bottom: 16px; 
    flex-wrap: wrap; 
}
.pagination-btn { 
    min-width: 40px; 
    height: 40px; 
    padding: 0 12px; 
    border-radius: 8px; 
    border: 1px solid #E8DFD1; 
    background: white; 
    color: #4A3B2F; 
    font-size: 0.87rem; 
    font-weight: 500; 
    cursor: pointer; 
    transition: all 0.2s; 
    display: inline-flex; 
    align-items: center; 
    justify-content: center; 
}
.pagination-btn:hover:not(:disabled) { 
    background: #FEF9F0; 
    border-color: #93032E; 
    color: #93032E; 
    transform: translateY(-1px); 
}
.pagination-btn.active { 
    background: #93032E; 
    color: white; 
    border-color: #93032E; 
    cursor: default; 
}
.pagination-btn:disabled { 
    opacity: 0.5; 
    cursor: not-allowed; 
    background: #F9FAFB; 
}
.pagination-dots { 
    padding: 0 8px; 
    color: #9CA3AF; 
    font-size: 0.9rem; 
}

/* ── SELECTEUR PAR PAGE ── */
.rows-per-page-select {
    margin-left: 12px;
    padding: 8px 12px;
    border: 1px solid #E8DFD1;
    border-radius: 8px;
    font-size: 0.85rem;
    background: #FEF9F0;
    color: #2C1810;
    cursor: pointer;
    outline: none;
}
.rows-per-page-select:hover {
    border-color: #93032E;
}
</style>

{# ── FLASH MESSAGES ── #}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        {% if label == 'success' or label == 'error' %}
        <div style="margin-bottom:14px; padding:12px 18px; border-radius:12px; font-size:0.87rem; font-weight:500; display:flex; align-items:center; gap:10px;
            {% if label == 'success' %}background:#E0F2E9; color:#047857; border:1px solid #A7F3D0;
            {% else %}background:#FEF2F2; color:#DC2626; border:1px solid #FECACA;{% endif %}">
            {{ message }}
        </div>
        {% endif %}
    {% endfor %}
{% endfor %}

{# ── EN-TÊTE ── #}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1" style="font-family:'Playfair Display',serif; color:#2C1810;">{{ forum.nom }}</h4>
        <p class="mb-0" style="font-size:0.85rem; color:#6B7280;">
            Thème : <strong style="color:#93032E;">{{ forum.theme }}</strong> &nbsp;·&nbsp;
            <span id="countBadge" class="tj-badge tj-badge-wine">
                {{ forum.publications|length }} publication{{ forum.publications|length != 1 ? 's' : '' }}
            </span>
        </p>
    </div>
    <div style="display:flex; gap:8px; flex-wrap:wrap;">
        <a href="{{ path('app_publication_new') }}" class="tj-btn-primary">
            <i class="fas fa-plus me-2"></i> Nouvelle publication
        </a>
        {# ✅ Bouton Retour vers la liste des forums #}
        <a href="{{ path('app_forum_index') }}" class="tj-btn-back">
            <i class="fas fa-arrow-left me-2"></i> Retour
        </a>
    </div>
</div>

{# ── BARRE RECHERCHE + TRI ── #}
<div style="display:flex; gap:12px; margin-bottom:18px; align-items:center; flex-wrap:wrap;">
    <div class="search-wrap" style="flex:1; min-width:240px;">
        <i class="fas fa-search search-icon"></i>
        <input type="text" id="searchInput" class="search-input" placeholder="Rechercher par titre..." oninput="filterAndPaginate()">
    </div>
    <div style="display:flex; gap:8px; align-items:center; flex-shrink:0;">
        <span style="font-size:0.82rem; color:#9CA3AF; font-weight:500;">Tri date :</span>
        <button onclick="setSortAndPaginate('asc')" id="btnAsc" class="sort-btn"><i class="fas fa-sort-amount-up-alt me-1"></i>Croissant</button>
        <button onclick="setSortAndPaginate('desc')" id="btnDesc" class="sort-btn"><i class="fas fa-sort-amount-down me-1"></i>Décroissant</button>
        <button onclick="setSortAndPaginate('none')" id="btnNone" class="sort-btn" style="background:#F3F4F6; color:#6B7280;"><i class="fas fa-times me-1"></i></button>
    </div>
</div>

{# ── TABLEAU PUBLICATIONS ── #}
{% if forum.publications is empty %}
    <div class="tj-empty">
        <i class="fas fa-newspaper" style="font-size:3rem; color:#E8DFD1; margin-bottom:1rem;"></i>
        <p style="color:#9CA3AF; margin-bottom:1rem;">Aucune publication dans ce forum.</p>
        <a href="{{ path('app_publication_new') }}" class="tj-btn-primary">
            <i class="fas fa-plus me-2"></i>Créer une publication
        </a>
    </div>
{% else %}
<div class="tj-table-wrap">
    <div style="overflow-x:auto;">
        <table class="tj-table">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Vidéo</th>
                    <th>Titre</th>
                    <th>Description</th>
                    <th>Date</th>
                    <th>Commentaires</th>
                    <th style="text-align:center;">Actions</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                {% for pub in forum.publications %}
                <tr data-title="{{ pub.nom|lower }}" data-date="{{ pub.dateCreation|date('Y-m-d') }}" data-original-index="{{ loop.index0 }}">
                    
                    {# ── IMAGE ── #}
                    <td>
                        {% if pub.image %}
                            <div class="media-cell">
                                {% if pub.image starts with 'http' %}
                                    <img src="{{ pub.image }}" class="media-thumb" alt="image" onerror="this.style.display='none'">
                                {% else %}
                                    <img src="{{ asset('uploads/publications/' ~ pub.image) }}" class="media-thumb" alt="image">
                                {% endif %}
                                <span class="tj-badge tj-badge-blue"><i class="fas fa-image"></i> Image</span>
                            </div>
                        {% else %}
                            <span class="tj-badge tj-badge-grey">Aucune</span>
                        {% endif %}
                    </td>

                    {# ── VIDÉO ── #}
                    <td>
                        {% if pub.video %}
                            <div class="media-cell">
                                {% if pub.isYoutubeVideo() and pub.youtubeId %}
                                    <img src="https://img.youtube.com/vi/{{ pub.youtubeId }}/mqdefault.jpg" class="media-thumb-video" alt="YouTube">
                                    <span class="tj-badge tj-badge-wine"><i class="fab fa-youtube"></i> YouTube</span>
                                {% elseif pub.isVimeoVideo() %}
                                    <span class="tj-badge tj-badge-wine"><i class="fab fa-vimeo"></i> Vimeo</span>
                                {% else %}
                                    <video src="{{ pub.video starts with 'http' ? pub.video : asset('uploads/publications/' ~ pub.video) }}" class="media-thumb-video" muted preload="metadata"></video>
                                    <span class="tj-badge tj-badge-wine"><i class="fas fa-video"></i> Vidéo</span>
                                {% endif %}
                            </div>
                        {% else %}
                            <span class="tj-badge tj-badge-grey">Aucune</span>
                        {% endif %}
                    </td>
                    
                    {# ── TITRE ── #}
                    <td><strong style="color:#2C1810;">{{ pub.nom|slice(0,40) }}{% if pub.nom|length > 40 %}…{% endif %}</strong></td>
                    
                    {# ── DESCRIPTION ── #}
                    <td style="color:#6B7280; max-width:200px;">
                        {{ pub.description|slice(0,60)|default('—') }}{% if pub.description|length > 60 %}…{% endif %}
                    </td>

                    {# ── DATE ── #}
                    <td><span class="tj-badge tj-badge-orange">{{ pub.dateCreation|date('d/m/Y') }}</span></td>
                    
                    {# ── COMMENTAIRES ── #}
                    <td><span class="tj-badge tj-badge-green"><i class="fas fa-comment"></i> {{ pub.commentaires|length }}</span></td>

                    {# ── ACTIONS ── #}
                    <td>
                        <div class="tj-actions">
                            {# ── Voir commentaires ── #}
                            <a href="{{ path('app_publication_show', {'idP': pub.idP}) }}" class="action-btn view-btn" title="Voir commentaires">
                                <i class="fas fa-eye"></i>
                            </a>
                            {# ── Modifier ── #}
                            <a href="{{ path('app_publication_edit', {'idP': pub.idP}) }}" class="action-btn edit-btn" title="Modifier">
                                <i class="fas fa-edit"></i>
                            </a>
                            {# ── Supprimer ── #}
                            <form method="post" action="{{ path('app_publication_delete', {'idP': pub.idP}) }}"
                                  onsubmit="return confirm('Supprimer cette publication ?')" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ pub.idP) }}">
                                <button type="submit" class="action-btn delete-btn" title="Supprimer">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div id="noResult" style="display:none; padding:2.5rem; text-align:center; color:#9CA3AF;">
        <i class="fas fa-search" style="font-size:1.4rem; opacity:0.4; display:block; margin-bottom:8px;"></i>
        Aucune publication ne correspond à votre recherche.
    </div>
</div>

{# ── PAGINATION ── #}
<div class="pagination-container" id="paginationContainer">
    <!-- La pagination sera générée ici dynamiquement -->
</div>
{% endif %}

<script>
let currentPage = 1;
let rowsPerPage = 5;
let currentSort = 'none';
let allRows = [];
let filteredRows = [];

// Initialisation : récupérer toutes les lignes
function init() {
    const tbody = document.getElementById('tableBody');
    if (!tbody) return;
    
    const rows = Array.from(tbody.querySelectorAll('tr'));
    allRows = rows.map((row, index) => ({
        row: row,
        title: row.getAttribute('data-title') || '',
        date: row.getAttribute('data-date') || '',
        originalIndex: parseInt(row.getAttribute('data-original-index')) || index
    }));
    
    filterAndPaginate();
}

// Filtrer les lignes selon la recherche
function filterRows() {
    const search = document.getElementById('searchInput').value.toLowerCase().trim();
    
    filteredRows = allRows.filter(item => {
        const match = search === '' || item.title.includes(search);
        return match;
    });
    
    return filteredRows;
}

// Trier les lignes filtrées
function sortRows(rows) {
    if (currentSort === 'none') {
        // Retour à l'ordre original
        return [...rows].sort((a, b) => a.originalIndex - b.originalIndex);
    }
    
    return [...rows].sort((a, b) => {
        if (currentSort === 'asc') {
            return a.date.localeCompare(b.date);
        } else {
            return b.date.localeCompare(a.date);
        }
    });
}

// Mettre à jour l'affichage avec pagination
function updateDisplay() {
    // Filtrer d'abord
    let workingRows = filterRows();
    
    // Trier ensuite
    workingRows = sortRows(workingRows);
    
    // Pagination
    const totalPages = Math.ceil(workingRows.length / rowsPerPage);
    const start = (currentPage - 1) * rowsPerPage;
    const end = start + rowsPerPage;
    const pageRows = workingRows.slice(start, end);
    
    // Cacher toutes les lignes
    allRows.forEach(item => {
        item.row.style.display = 'none';
    });
    
    // Afficher les lignes de la page courante
    pageRows.forEach(item => {
        item.row.style.display = '';
    });
    
    // Mettre à jour le compteur
    const count = workingRows.length;
    const badge = document.getElementById('countBadge');
    if (badge) badge.textContent = count + ' publication' + (count !== 1 ? 's' : '');
    
    // Mettre à jour le message "aucun résultat"
    const noResult = document.getElementById('noResult');
    if (noResult) {
        noResult.style.display = workingRows.length === 0 ? 'block' : 'none';
    }
    
    // Générer la pagination
    renderPagination(workingRows.length, totalPages);
}

// Rendu de la pagination
function renderPagination(totalItems, totalPages) {
    const container = document.getElementById('paginationContainer');
    if (!container) return;
    
    if (totalPages <= 1) {
        container.style.display = 'none';
        return;
    }
    
    container.style.display = 'flex';
    let html = '';
    
    // Bouton Précédent
    html += `<button class="pagination-btn" onclick="goToPage(${currentPage - 1})" ${currentPage === 1 ? 'disabled' : ''}>
        <i class="fas fa-chevron-left"></i>
    </button>`;
    
    // Calcul des pages à afficher
    let startPage = Math.max(1, currentPage - 2);
    let endPage = Math.min(totalPages, currentPage + 2);
    
    // Ajuster pour avoir toujours 5 pages si possible
    if (endPage - startPage < 4) {
        if (startPage === 1) {
            endPage = Math.min(totalPages, startPage + 4);
        } else if (endPage === totalPages) {
            startPage = Math.max(1, endPage - 4);
        }
    }
    
    // Première page si nécessaire
    if (startPage > 1) {
        html += `<button class="pagination-btn" onclick="goToPage(1)">1</button>`;
        if (startPage > 2) {
            html += `<span class="pagination-dots">...</span>`;
        }
    }
    
    // Pages numérotées
    for (let i = startPage; i <= endPage; i++) {
        html += `<button class="pagination-btn ${i === currentPage ? 'active' : ''}" onclick="goToPage(${i})">${i}</button>`;
    }
    
    // Dernière page si nécessaire
    if (endPage < totalPages) {
        if (endPage < totalPages - 1) {
            html += `<span class="pagination-dots">...</span>`;
        }
        html += `<button class="pagination-btn" onclick="goToPage(${totalPages})">${totalPages}</button>`;
    }
    
    // Bouton Suivant
    html += `<button class="pagination-btn" onclick="goToPage(${currentPage + 1})" ${currentPage === totalPages ? 'disabled' : ''}>
        <i class="fas fa-chevron-right"></i>
    </button>`;
    
    // Sélecteur de nombre de lignes par page
    html += `<select class="rows-per-page-select" onchange="changeRowsPerPage(this)">
        <option value="5" ${rowsPerPage === 5 ? 'selected' : ''}>5 par page</option>
        <option value="10" ${rowsPerPage === 10 ? 'selected' : ''}>10 par page</option>
        <option value="20" ${rowsPerPage === 20 ? 'selected' : ''}>20 par page</option>
        <option value="50" ${rowsPerPage === 50 ? 'selected' : ''}>50 par page</option>
        <option value="-1" ${rowsPerPage === -1 ? 'selected' : ''}>Tout afficher</option>
    </select>`;
    
    // Affichage du nombre total
    html += `<span style="font-size:0.8rem; color:#9CA3AF; margin-left: 8px;">
        ${totalItems} publication${totalItems !== 1 ? 's' : ''}
    </span>`;
    
    container.innerHTML = html;
}

// Changer de page
function goToPage(page) {
    const workingRows = sortRows(filterRows());
    const totalPages = Math.ceil(workingRows.length / rowsPerPage);
    
    if (page < 1 || page > totalPages) return;
    currentPage = page;
    updateDisplay();
}

// Changer le nombre de lignes par page
function changeRowsPerPage(select) {
    const value = parseInt(select.value);
    rowsPerPage = value === -1 ? Infinity : value;
    currentPage = 1;
    updateDisplay();
}

// Fonction principale de filtrage et pagination
function filterAndPaginate() {
    currentPage = 1;
    updateDisplay();
}

// Changer le tri et mettre à jour
function setSortAndPaginate(dir) {
    currentSort = dir;
    
    // Mettre à jour l'apparence des boutons
    const btnAsc = document.getElementById('btnAsc');
    const btnDesc = document.getElementById('btnDesc');
    const btnNone = document.getElementById('btnNone');
    
    if (btnAsc) btnAsc.classList.toggle('sort-active', dir === 'asc');
    if (btnDesc) btnDesc.classList.toggle('sort-active', dir === 'desc');
    if (btnNone) {
        btnNone.style.background = dir === 'none' ? '#F3F4F6' : '#FEF9F0';
        btnNone.style.color = dir === 'none' ? '#6B7280' : '#93032E';
        btnNone.style.borderColor = dir === 'none' ? '#F0E8DD' : '#93032E';
    }
    
    currentPage = 1;
    updateDisplay();
}

// Initialisation au chargement
document.addEventListener('DOMContentLoaded', function() { 
    init(); 
});

// Forcer rechargement après retour arrière (évite bugs de cache)
window.addEventListener('pageshow', function(event) { 
    if (event.persisted) { 
        location.reload(); 
    } 
});
</script>
{% endblock %}