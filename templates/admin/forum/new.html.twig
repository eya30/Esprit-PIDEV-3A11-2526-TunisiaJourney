{% extends 'admin/base_admin.html.twig' %}

{% block title %}Nouveau Forum{% endblock %}
{% block page_title %}Créer un nouveau forum{% endblock %}

{% block body %}
<div class="row">
    <div class="col-md-8">
        <div class="form-card">
            <h5 class="form-title">Créer un forum</h5>
            <p class="form-subtitle">Ajoutez un nouveau forum de discussion</p>

            {# ── Résumé global des erreurs ── #}
            {% if form.nom.vars.errors|length > 0 or form.theme.vars.errors|length > 0 or form.status.vars.errors|length > 0 %}
                <div class="alert-errors">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Veuillez corriger les erreurs ci-dessous avant de continuer.</strong>
                    <ul style="margin: 8px 0 0 20px;">
                        {% for error in form.nom.vars.errors %}<li>{{ error.message }}</li>{% endfor %}
                        {% for error in form.theme.vars.errors %}<li>{{ error.message }}</li>{% endfor %}
                        {% for error in form.status.vars.errors %}<li>{{ error.message }}</li>{% endfor %}
                    </ul>
                </div>
            {% endif %}

            {{ form_start(form, {'attr': {'id': 'forum-form'}}) }}

                {# ── NOM DU FORUM ── #}
                <div class="form-group">
                    <label class="form-label" for="{{ form.nom.vars.id }}">
                        Nom du forum <span class="required">*</span>
                    </label>
                    <div class="input-group-custom {% if form.nom.vars.errors|length > 0 %}input-error{% endif %}">
                        <i class="fas fa-tag"></i>
                        {{ form_widget(form.nom, {
                            'attr': {
                                'class': 'form-control',
                                'placeholder': 'Ex: Aventures Europe'
                            }
                        }) }}
                    </div>
                    {% if form.nom.vars.errors|length > 0 %}
                        <div class="error-block">
                            <i class="fas fa-exclamation-circle"></i>
                            <div>{% for error in form.nom.vars.errors %}<div>{{ error.message }}</div>{% endfor %}</div>
                        </div>
                    {% endif %}
                    <div class="field-hint">
                        Doit commencer par une lettre · Min. 3 caractères · Max. 100 caractères
                    </div>
                </div>

                {# ── THÈME ── #}
                <div class="form-group">
                    <label class="form-label">
                        Thème <span class="required">*</span>
                    </label>
                    <div class="input-group-custom {% if form.theme.vars.errors|length > 0 %}input-error{% endif %}">
                        <i class="fas fa-palette"></i>
                        {{ form_widget(form.theme, {
                            'attr': {
                                'class': 'form-control custom-select'
                            }
                        }) }}
                        <i class="fas fa-chevron-down select-arrow"></i>
                    </div>
                    {% if form.theme.vars.errors|length > 0 %}
                        <div class="error-block">
                            <i class="fas fa-exclamation-circle"></i>
                            <div>{% for error in form.theme.vars.errors %}<div>{{ error.message }}</div>{% endfor %}</div>
                        </div>
                    {% endif %}
                </div>

                {# ── STATUT ── #}
                <div class="form-group">
                    <label class="form-label">
                        Statut <span class="required">*</span>
                    </label>
                    <div class="input-group-custom {% if form.status.vars.errors|length > 0 %}input-error{% endif %}">
                        <i class="fas fa-toggle-on"></i>
                        {{ form_widget(form.status, {
                            'attr': {
                                'class': 'form-control custom-select'
                            }
                        }) }}
                        <i class="fas fa-chevron-down select-arrow"></i>
                    </div>
                    {% if form.status.vars.errors|length > 0 %}
                        <div class="error-block">
                            <i class="fas fa-exclamation-circle"></i>
                            <div>{% for error in form.status.vars.errors %}<div>{{ error.message }}</div>{% endfor %}</div>
                        </div>
                    {% endif %}
                </div>

                <div class="form-actions">
                    <a href="{{ path('app_forum_index') }}" class="btn-outline-action">
                        <i class="fas fa-arrow-left me-2"></i>Annuler
                    </a>
                    <button type="submit" class="btn-submit">
                        <i class="fas fa-save me-2"></i>Créer
                    </button>
                </div>

            {{ form_end(form) }}
        </div>
    </div>

    {# ── CARTE D'INFORMATION ── #}
    <div class="col-md-4">
        <div class="info-card">
            <h5 class="info-title"><i class="fas fa-info-circle me-2"></i>À propos des forums</h5>
            <div class="info-content">
                <p>Les forums permettent d'organiser les publications par thème de voyage.</p>
                <hr class="info-divider">
                <div class="info-tip">
                    <i class="fas fa-lightbulb"></i>
                    <span>Choisissez un nom clair et représentatif du thème du forum.</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.form-card{background:white;border-radius:24px;padding:32px;border:1px solid #F0E8DD;box-shadow:0 4px 12px rgba(0,0,0,.05)}
.form-title{font-family:'Playfair Display',serif;font-size:1.4rem;font-weight:700;color:#2C1810;margin-bottom:8px}
.form-subtitle{font-size:.85rem;color:#93032E;margin-bottom:24px;padding-bottom:16px;border-bottom:1px solid #F0E8DD}
.alert-errors{background:#FEF2F2;border:1px solid #FECACA;border-radius:12px;padding:12px 16px;margin-bottom:20px;color:#DC2626;font-size:.85rem;display:block}
.alert-errors ul{margin-bottom:0}
.form-group{margin-bottom:22px}
.form-label{font-size:.85rem;font-weight:700;color:#2C1810;margin-bottom:8px;display:block}
.required{color:#EF4444}
.field-hint{font-size:.73rem;color:#9CA3AF;margin-top:4px}
.error-block{display:flex;align-items:flex-start;gap:8px;background:#FEF2F2;border:1px solid #FECACA;border-radius:10px;padding:10px 14px;margin-top:6px;color:#DC2626;font-size:.82rem;font-weight:500}
.error-block i{flex-shrink:0;margin-top:2px}
.input-group-custom{display:flex;align-items:center;background:#FEF9F0;border:1.5px solid #E8DFD1;border-radius:12px;transition:all .2s;overflow:hidden;position:relative}
.input-group-custom:focus-within{border-color:#93032E;box-shadow:0 0 0 3px rgba(147,3,46,.07);background:white}
.input-group-custom.input-error{border-color:#EF4444!important;background:#FFF5F5}
.input-group-custom>i:first-child{padding:12px 0 12px 14px;color:#C49A6C;font-size:.95rem;flex-shrink:0}
.input-group-custom .form-control{border:none;background:transparent;padding:12px 14px;font-size:.87rem;width:100%;color:#2C1810}
.input-group-custom .form-control:focus{outline:none;box-shadow:none}
.select-arrow{position:absolute;right:14px;color:#C49A6C;font-size:.7rem;pointer-events:none}
.custom-select{appearance:none;-webkit-appearance:none;padding-right:36px!important;cursor:pointer}
.form-actions{display:flex;justify-content:flex-end;gap:12px;margin-top:28px;padding-top:22px;border-top:1px solid #F0E8DD}
.btn-submit{background:#93032E;border:none;padding:11px 26px;border-radius:40px;font-size:.88rem;font-weight:600;color:white;cursor:pointer;transition:all .2s;display:inline-flex;align-items:center}
.btn-submit:hover{background:#6B0221;transform:translateY(-2px);box-shadow:0 4px 14px rgba(147,3,46,.3)}
.btn-outline-action{background:transparent;border:1.5px solid #E8DFD1;padding:11px 22px;border-radius:40px;font-size:.88rem;font-weight:500;color:#4A3B2F;text-decoration:none;display:inline-flex;align-items:center;transition:all .2s}
.btn-outline-action:hover{border-color:#93032E;color:#93032E;background:#FFF9F0}
.info-card{background:white;border-radius:24px;padding:22px;border:1px solid #F0E8DD;position:sticky;top:20px;box-shadow:0 4px 12px rgba(0,0,0,.04)}
.info-title{font-size:1rem;font-weight:700;color:#2C1810;margin-bottom:16px;display:flex;align-items:center}
.info-content p{font-size:.85rem;color:#6B7280;margin-bottom:0}
.info-divider{margin:16px 0;border-top:1px solid #F0E8DD}
.info-tip{display:flex;align-items:center;gap:10px;background:#FEF9F0;padding:12px;border-radius:12px;font-size:.8rem;color:#93032E}
.info-tip i{font-size:1.1rem}
</style>
{% endblock %}