{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Voyages{% endblock %}
{% block page_title %}Liste des voyages{% endblock %}

{% block body %}
<div class="page-header mb-4">
    <p class="page-header-subtitle">Gérez l'ensemble de vos offres de voyage</p>
</div>

<div class="d-flex justify-content-end mb-4">
    <a href="{{ path('admin_voyage_new') }}" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i> Nouveau voyage
    </a>
</div>

<div class="admin-table">
    <table class="table">
        <thead>
            <tr>
                <th style="width: 100px">Image</th>
                <th style="width: 200px">Nom</th>
                <th>Description</th>
                <th style="width: 100px">Capacité</th>
                <th style="width: 100px">Prix</th>
                <th style="width: 110px">Date</th>
                <th style="width: 140px">Actions</th>
            </thead>
        <tbody>
            {% for voyage in voyages %}
              <tr class="voyage-row">
                <td>
                    {% if voyage.image %}
                        <img src="{{ asset('uploads/voyages/' ~ voyage.image) }}" class="voyage-thumbnail" alt="{{ voyage.nom }}">
                    {% else %}
                        <div class="thumbnail-placeholder">
                            <i class="fas fa-image"></i>
                        </div>
                    {% endif %}
                 </td>
                 <td class="voyage-name">{{ voyage.nom }}</td>
                <td class="voyage-description-cell">{{ voyage.description }}</td>
                <td class="voyage-capacity">{{ voyage.capacite }} pers</td>
                <td class="voyage-price">{{ voyage.prix|number_format(0, ',', ' ') }} DT</td>
                <td class="voyage-date">{{ voyage.dateCreation|date('d/m/Y') }}</td>
                <td>
                    <div class="action-buttons">
                        <a href="{{ path('admin_voyage_programmes', {'id': voyage.idV}) }}" class="action-btn programmes-btn" title="Voir les programmes">
                            <i class="fas fa-calendar-week"></i>
                        </a>
                        <a href="{{ path('admin_voyage_edit', {'id': voyage.idV}) }}" class="action-btn edit-btn" title="Modifier">
                            <i class="fas fa-edit"></i>
                        </a>
                        <form method="post" action="{{ path('admin_voyage_delete', {'id': voyage.idV}) }}" style="display: inline-block;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_voyage_' ~ voyage.idV) }}">
                            <button type="submit" class="action-btn delete-btn" onclick="return confirm('Supprimer ce voyage ?')" title="Supprimer">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </form>
                    </div>
                 </td>
             </tr>
            {% else %}
             <tr>
                <td colspan="7" class="text-center py-5">
                    <i class="fas fa-suitcase fa-3x mb-3" style="color: #E8DFD1;"></i>
                    <p class="text-muted mb-0">Aucun voyage trouvé</p>
                    <a href="{{ path('admin_voyage_new') }}" class="btn btn-primary mt-3">Créer un voyage</a>
                </td>
             </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<!-- Pagination -->
{% if voyages is defined and voyages|length > 0 %}
<div class="pagination-wrapper">
    <div class="pagination-info">
        Affichage de <strong>{{ voyages|length }}</strong> voyage(s)
    </div>
    <nav class="pagination-nav">
        <ul class="pagination">
            <li class="page-item {% if current_page == 1 %}disabled{% endif %}">
                <a class="page-link" href="{{ path('admin_voyage_index', {page: current_page - 1}) }}" {% if current_page == 1 %}tabindex="-1" aria-disabled="true"{% endif %}>
                    <i class="fas fa-chevron-left"></i>
                </a>
            </li>
            {% for i in 1..total_pages %}
                <li class="page-item {% if i == current_page %}active{% endif %}">
                    <a class="page-link" href="{{ path('admin_voyage_index', {page: i}) }}">{{ i }}</a>
                </li>
            {% endfor %}
            <li class="page-item {% if current_page == total_pages %}disabled{% endif %}">
                <a class="page-link" href="{{ path('admin_voyage_index', {page: current_page + 1}) }}" {% if current_page == total_pages %}tabindex="-1" aria-disabled="true"{% endif %}>
                    <i class="fas fa-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
</div>
{% endif %}

<style>
    .page-header {
        margin-bottom: 28px;
    }
    
    .page-header-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.8rem;
        font-weight: 800;
        color: #2C1810;
        margin-bottom: 8px;
        letter-spacing: -0.5px;
    }
    
    .page-header-subtitle {
        font-size: 0.9rem;
        color: #93032E;
        font-weight: 500;
        margin: 0;
    }
    
    .admin-table {
        background: white;
        border-radius: 20px;
        border: 1px solid #F0E8DD;
        overflow-x: auto;
        overflow-y: visible;
    }
    
    .admin-table .table {
        margin-bottom: 0;
        min-width: 1000px;
    }
    
    .admin-table th {
        background: #FEF9F0;
        padding: 16px 20px;
        font-size: 12px;
        font-weight: 700;
        color: #93032E;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1px solid #F0E8DD;
        white-space: nowrap;
    }
    
    .admin-table td {
        padding: 16px 20px;
        font-size: 13px;
        border-bottom: 1px solid #F5F0E8;
        color: #4A3B2F;
        vertical-align: middle;
        background: white;
    }
    
    .admin-table tr:hover td {
        background: #FFF9F0;
    }
    
    /* Image plus grande */
    .voyage-thumbnail {
        width: 70px;
        height: 70px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid #F0E8DD;
        transition: all 0.2s;
    }
    
    .voyage-thumbnail:hover {
        transform: scale(1.05);
        border-color: #93032E;
        box-shadow: 0 4px 12px rgba(147,3,46,0.15);
    }
    
    .thumbnail-placeholder {
        width: 70px;
        height: 70px;
        background: #FEF9F0;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #E8DFD1;
        font-size: 1.5rem;
        border: 1px solid #F0E8DD;
    }
    
    /* Nom du voyage en gras */
    .voyage-name {
        font-weight: 700;
        color: #2C1810;
        font-size: 0.95rem;
        white-space: nowrap;
    }
    
    /* Description complète */
    .voyage-description-cell {
        max-width: 350px;
        color: #6B7280;
        line-height: 1.5;
        font-size: 0.85rem;
        word-wrap: break-word;
        white-space: normal;
    }
    
    /* Capacité */
    .voyage-capacity {
        white-space: nowrap;
    }
    
    .voyage-capacity span {
        display: inline-flex;
        align-items: center;
        background: #FEF9F0;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
        color: #93032E;
    }
    
    /* Prix */
    .voyage-price {
        font-weight: 700;
        color: #93032E;
        font-size: 1rem;
        white-space: nowrap;
    }
    
    /* Date */
    .voyage-date {
        white-space: nowrap;
        color: #9CA3AF;
        font-size: 0.85rem;
    }
    
    /* Action Buttons */
    .action-buttons {
        display: flex;
        gap: 8px;
    }
    
    .action-btn {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        cursor: pointer;
        border: none;
        background: transparent;
        font-size: 0.9rem;
        text-decoration: none;
    }
    
    .programmes-btn {
        background: #FEF3C7;
        color: #D97706;
    }
    
    .programmes-btn:hover {
        background: #F59E0B;
        color: white;
        transform: translateY(-2px);
    }
    
    .edit-btn {
        background: #EFF6FF;
        color: #3B82F6;
    }
    
    .edit-btn:hover {
        background: #3B82F6;
        color: white;
        transform: translateY(-2px);
    }
    
    .delete-btn {
        background: #FEF2F2;
        color: #EF4444;
    }
    
    .delete-btn:hover {
        background: #EF4444;
        color: white;
        transform: translateY(-2px);
    }
    
    .btn-primary {
        background: #93032E;
        border: none;
        padding: 10px 24px;
        border-radius: 40px;
        font-size: 13px;
        font-weight: 600;
        color: white;
        transition: all 0.2s;
    }
    
    .btn-primary:hover {
        background: #6B0221;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(147,3,46,0.3);
    }
    
    /* Pagination Styles */
    .pagination-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 24px;
        padding: 16px 0;
    }
    
    .pagination-info {
        font-size: 0.85rem;
        color: #9CA3AF;
    }
    
    .pagination-info strong {
        color: #93032E;
        font-weight: 600;
    }
    
    .pagination-nav {
        margin: 0;
    }
    
    .pagination {
        margin: 0;
        gap: 6px;
    }
    
    .page-item {
        list-style: none;
    }
    
    .page-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: white;
        border: 1px solid #E8DFD1;
        color: #4A3B2F;
        font-size: 0.85rem;
        font-weight: 500;
        transition: all 0.2s;
        text-decoration: none;
    }
    
    .page-link:hover {
        background: #FFF9F0;
        border-color: #93032E;
        color: #93032E;
    }
    
    .page-item.active .page-link {
        background: #93032E;
        border-color: #93032E;
        color: white;
    }
    
    .page-item.disabled .page-link {
        background: #FEF9F0;
        border-color: #F0E8DD;
        color: #E8DFD1;
        cursor: not-allowed;
    }
    
    @media (max-width: 768px) {
        .pagination-wrapper {
            flex-direction: column;
            gap: 16px;
            align-items: center;
        }
        
        .voyage-description-cell {
            max-width: 200px;
        }
    }
</style>
{% endblock %}