{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Voyages{% endblock %}
{% block page_title %}Liste des voyages{% endblock %}

{% block body %}
<div class="page-header mb-4">
    <p class="page-header-subtitle">Gérez l'ensemble de vos offres de voyage</p>
</div>

<!-- Barre de recherche dynamique -->
<div class="search-bar-wrapper mb-4">
    <div class="search-input-group">
        <i class="fas fa-search search-icon"></i>
        <input type="text" id="searchInput" class="form-control search-input" 
               placeholder="Rechercher par nom ou description..." 
               value="{{ search }}" autocomplete="off">
        <button id="clearSearch" class="clear-search-btn" style="display: {% if search %}flex{% else %}none{% endif %};">
            <i class="fas fa-times"></i>
        </button>
    </div>
    <div class="search-info">
        <i class="fas fa-spinner fa-spin" id="searchSpinner" style="display: none;"></i>
        <span id="resultCount">{{ total_count }}</span> voyage(s) trouvé(s)
    </div>
</div>

<div class="d-flex justify-content-end mb-4">
    <a href="{{ path('admin_voyage_new') }}" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i> Nouveau voyage
    </a>
</div>

<div class="admin-table">
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th style="width: 100px">Image</th>
                    <th style="width: 200px">Nom</th>
                    <th>Description</th>
                    <th style="width: 100px">Capacité</th>
                    <th style="width: 100px">Prix</th>
                    <th style="width: 110px">Date</th>
                    <th style="width: 140px">Actions</th>
                </tr>
            </thead>
            <tbody id="voyagesTableBody">
                {% for voyage in voyages %}
                <tr class="voyage-row">
                    <td>
                        {% if voyage.image %}
                            <img src="{{ asset('uploads/voyages/' ~ voyage.image) }}" class="voyage-thumbnail" alt="{{ voyage.nom }}">
                        {% else %}
                            <div class="thumbnail-placeholder">
                                <i class="fas fa-image"></i>
                            </div>
                        {% endif %}
                    </td>
                    <td class="voyage-name">{{ voyage.nom }}</td>
                    <td class="voyage-description-cell">{{ voyage.description }}</td>
                    <td class="voyage-capacity">{{ voyage.capacite }} pers</td>
                    <td class="voyage-price">{{ voyage.prix|number_format(0, ',', ' ') }} DT</td>
                    <td class="voyage-date">{{ voyage.dateCreation|date('d/m/Y') }}</td>
                    <td>
                        <div class="action-buttons">
                            <a href="{{ path('admin_voyage_programmes', {'id': voyage.idV}) }}" class="action-btn programmes-btn" title="Voir les programmes">
                                <i class="fas fa-calendar-week"></i>
                            </a>
                            <a href="{{ path('admin_voyage_edit', {'id': voyage.idV}) }}" class="action-btn edit-btn" title="Modifier">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form method="post" action="{{ path('admin_voyage_delete', {'id': voyage.idV}) }}" style="display: inline-block;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_voyage_' ~ voyage.idV) }}">
                                <button type="submit" class="action-btn delete-btn" onclick="return confirm('Supprimer ce voyage ?')" title="Supprimer">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="7" class="text-center py-5">
                        <i class="fas fa-suitcase fa-3x mb-3" style="color: #E8DFD1;"></i>
                        <p class="text-muted mb-0">Aucun voyage trouvé</p>
                        <a href="{{ path('admin_voyage_new') }}" class="btn btn-primary mt-3">Créer un voyage</a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<!-- Pagination -->
<div class="pagination-wrapper">
    <div class="pagination-info" id="paginationInfo">
        Affichage de <strong>{{ voyages|length }}</strong> sur <strong>{{ total_count }}</strong> voyage(s)
    </div>
    <nav class="pagination-nav">
        <ul class="pagination" id="paginationList">
            <li class="page-item {% if current_page == 1 %}disabled{% endif %}">
                <a class="page-link" href="#" data-page="{{ current_page - 1 }}">
                    <i class="fas fa-chevron-left"></i>
                </a>
            </li>
            {% for i in 1..total_pages %}
                <li class="page-item {% if i == current_page %}active{% endif %}">
                    <a class="page-link" href="#" data-page="{{ i }}">{{ i }}</a>
                </li>
            {% endfor %}
            <li class="page-item {% if current_page == total_pages %}disabled{% endif %}">
                <a class="page-link" href="#" data-page="{{ current_page + 1 }}">
                    <i class="fas fa-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
</div>

<style>
    .page-header-subtitle {
        font-size: 0.9rem;
        color: #93032E;
        font-weight: 500;
        margin: 0;
    }
    
    .search-bar-wrapper {
        background: white;
        border-radius: 16px;
        padding: 16px 20px;
        border: 1px solid #F0E8DD;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }
    
    .search-input-group {
        position: relative;
        flex: 1;
        min-width: 250px;
    }
    
    .search-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #9CA3AF;
        font-size: 0.9rem;
    }
    
    .search-input {
        width: 100%;
        padding: 12px 40px 12px 40px;
        border: 1px solid #E8DFD1;
        border-radius: 40px;
        font-size: 14px;
        background: #FEF9F0;
        transition: all 0.2s;
    }
    
    .search-input:focus {
        outline: none;
        border-color: #93032E;
        background: white;
        box-shadow: 0 0 0 3px rgba(147,3,46,0.1);
    }
    
    .clear-search-btn {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: #9CA3AF;
        cursor: pointer;
        padding: 5px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.2s;
    }
    
    .clear-search-btn:hover {
        color: #93032E;
    }
    
    .search-info {
        font-size: 0.85rem;
        color: #9CA3AF;
        white-space: nowrap;
    }
    
    .search-info span {
        color: #93032E;
        font-weight: 600;
    }
    
    .admin-table {
        background: white;
        border-radius: 20px;
        border: 1px solid #F0E8DD;
        overflow: hidden;
    }
    
    .admin-table th {
        background: #FEF9F0;
        padding: 16px 20px;
        font-size: 12px;
        font-weight: 700;
        color: #93032E;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1px solid #F0E8DD;
    }
    
    .admin-table td {
        padding: 16px 20px;
        font-size: 13px;
        border-bottom: 1px solid #F5F0E8;
        color: #4A3B2F;
        vertical-align: middle;
    }
    
    .admin-table tr:hover td {
        background: #FFF9F0;
    }
    
    .voyage-thumbnail {
        width: 70px;
        height: 70px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid #F0E8DD;
        transition: all 0.2s;
    }
    
    .voyage-thumbnail:hover {
        transform: scale(1.05);
        border-color: #93032E;
    }
    
    .thumbnail-placeholder {
        width: 70px;
        height: 70px;
        background: #FEF9F0;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #E8DFD1;
        font-size: 1.5rem;
        border: 1px solid #F0E8DD;
    }
    
    .voyage-name {
        font-weight: 700;
        color: #2C1810;
        font-size: 0.95rem;
    }
    
    .voyage-description-cell {
        max-width: 350px;
        color: #6B7280;
        line-height: 1.5;
        font-size: 0.85rem;
    }
    
    .voyage-price {
        font-weight: 700;
        color: #93032E;
        font-size: 1rem;
    }
    
    .action-buttons {
        display: flex;
        gap: 8px;
    }
    
    .action-btn {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        cursor: pointer;
        border: none;
        background: transparent;
        font-size: 0.9rem;
        text-decoration: none;
    }
    
    .programmes-btn {
        background: #FEF3C7;
        color: #D97706;
    }
    
    .programmes-btn:hover {
        background: #F59E0B;
        color: white;
        transform: translateY(-2px);
    }
    
    .edit-btn {
        background: #EFF6FF;
        color: #3B82F6;
    }
    
    .edit-btn:hover {
        background: #3B82F6;
        color: white;
        transform: translateY(-2px);
    }
    
    .delete-btn {
        background: #FEF2F2;
        color: #EF4444;
    }
    
    .delete-btn:hover {
        background: #EF4444;
        color: white;
        transform: translateY(-2px);
    }
    
    .btn-primary {
        background: #93032E;
        border: none;
        padding: 10px 24px;
        border-radius: 40px;
        font-size: 13px;
        font-weight: 600;
        color: white;
        transition: all 0.2s;
    }
    
    .btn-primary:hover {
        background: #6B0221;
        transform: translateY(-2px);
    }
    
    .pagination-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 24px;
        padding: 16px 0;
    }
    
    .pagination-info {
        font-size: 0.85rem;
        color: #9CA3AF;
    }
    
    .pagination-info strong {
        color: #93032E;
        font-weight: 600;
    }
    
    .pagination {
        margin: 0;
        gap: 6px;
    }
    
    .page-item {
        list-style: none;
    }
    
    .page-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: white;
        border: 1px solid #E8DFD1;
        color: #4A3B2F;
        font-size: 0.85rem;
        font-weight: 500;
        transition: all 0.2s;
        text-decoration: none;
    }
    
    .page-link:hover {
        background: #FFF9F0;
        border-color: #93032E;
        color: #93032E;
    }
    
    .page-item.active .page-link {
        background: #93032E;
        border-color: #93032E;
        color: white;
    }
    
    .page-item.disabled .page-link {
        background: #FEF9F0;
        border-color: #F0E8DD;
        color: #E8DFD1;
        cursor: not-allowed;
    }
    
    @media (max-width: 768px) {
        .search-bar-wrapper {
            flex-direction: column;
            align-items: stretch;
        }
        
        .search-info {
            text-align: center;
        }
        
        .pagination-wrapper {
            flex-direction: column;
            gap: 16px;
            align-items: center;
        }
        
        .voyage-description-cell {
            max-width: 200px;
        }
    }
</style>

<script>
    let searchTimeout;
    let currentPage = {{ current_page }};
    let isSearching = false;
    
    const searchInput = document.getElementById('searchInput');
    const clearSearchBtn = document.getElementById('clearSearch');
    const searchSpinner = document.getElementById('searchSpinner');
    const voyagesTableBody = document.getElementById('voyagesTableBody');
    const resultCountSpan = document.getElementById('resultCount');
    const paginationList = document.getElementById('paginationList');
    const paginationInfo = document.getElementById('paginationInfo');
    
    function performSearch() {
        const searchValue = searchInput.value;
        isSearching = true;
        searchSpinner.style.display = 'inline-block';
        
        fetch(`{{ path('admin_voyage_index') }}?search=${encodeURIComponent(searchValue)}&page=${currentPage}&ajax=1`)
            .then(response => response.json())
            .then(data => {
                // Générer le HTML des lignes du tableau
                let html = '';
                if (data.voyages.length === 0) {
                    html = `<tr>
                        <td colspan="7" class="text-center py-5">
                            <i class="fas fa-suitcase fa-3x mb-3" style="color: #E8DFD1;"></i>
                            <p class="text-muted mb-0">Aucun voyage trouvé</p>
                            <a href="{{ path('admin_voyage_new') }}" class="btn btn-primary mt-3">Créer un voyage</a>
                        </td>
                    </tr>`;
                } else {
                    for (const voyage of data.voyages) {
                        html += `<tr class="voyage-row">
                            <td>
                                ${voyage.image ? 
                                    `<img src="{{ asset('uploads/voyages/') }}${voyage.image}" class="voyage-thumbnail" alt="${voyage.nom}">` : 
                                    `<div class="thumbnail-placeholder"><i class="fas fa-image"></i></div>`
                                }
                            </td>
                            <td class="voyage-name">${escapeHtml(voyage.nom)}</td>
                            <td class="voyage-description-cell">${escapeHtml(voyage.description)}</td>
                            <td class="voyage-capacity">${voyage.capacite} pers</td>
                            <td class="voyage-price">${new Intl.NumberFormat('fr-FR').format(voyage.prix)} DT</td>
                            <td class="voyage-date">${formatDate(voyage.dateCreation)}</td>
                            <td>
                                <div class="action-buttons">
                                    <a href="/admin/voyages/${voyage.idV}/programmes" class="action-btn programmes-btn" title="Voir les programmes">
                                        <i class="fas fa-calendar-week"></i>
                                    </a>
                                    <a href="/admin/voyages/${voyage.idV}/edit" class="action-btn edit-btn" title="Modifier">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form method="post" action="/admin/voyages/${voyage.idV}/delete" style="display: inline-block;">
                                        <input type="hidden" name="_token" value="${data.csrf_token}">
                                        <button type="submit" class="action-btn delete-btn" onclick="return confirm('Supprimer ce voyage ?')" title="Supprimer">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>`;
                    }
                }
                
                voyagesTableBody.innerHTML = html;
                resultCountSpan.textContent = data.total_count;
                paginationInfo.innerHTML = `Affichage de <strong>${data.voyages.length}</strong> sur <strong>${data.total_count}</strong> voyage(s)`;
                
                // Générer la pagination
                let paginationHtml = '';
                paginationHtml += `<li class="page-item ${data.current_page === 1 ? 'disabled' : ''}">
                    <a class="page-link" href="#" data-page="${data.current_page - 1}">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                </li>`;
                for (let i = 1; i <= data.total_pages; i++) {
                    paginationHtml += `<li class="page-item ${i === data.current_page ? 'active' : ''}">
                        <a class="page-link" href="#" data-page="${i}">${i}</a>
                    </li>`;
                }
                paginationHtml += `<li class="page-item ${data.current_page === data.total_pages ? 'disabled' : ''}">
                    <a class="page-link" href="#" data-page="${data.current_page + 1}">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                </li>`;
                
                paginationList.innerHTML = paginationHtml;
                attachPaginationEvents();
                searchSpinner.style.display = 'none';
                isSearching = false;
            })
            .catch(error => {
                console.error('Erreur:', error);
                searchSpinner.style.display = 'none';
                isSearching = false;
            });
    }
    
    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
    
    function formatDate(dateString) {
        if (!dateString) return '';
        const date = new Date(dateString);
        return date.toLocaleDateString('fr-FR');
    }
    
    function attachPaginationEvents() {
        document.querySelectorAll('.page-link[data-page]').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const page = parseInt(this.getAttribute('data-page'));
                if (page && !isNaN(page) && !this.parentElement.classList.contains('disabled') && !isSearching) {
                    currentPage = page;
                    performSearch();
                }
            });
        });
    }
    
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            currentPage = 1;
            if (this.value.length > 2 || this.value.length === 0) {
                searchTimeout = setTimeout(performSearch, 500);
            }
            clearSearchBtn.style.display = this.value.length > 0 ? 'flex' : 'none';
        });
    }
    
    if (clearSearchBtn) {
        clearSearchBtn.addEventListener('click', function() {
            searchInput.value = '';
            performSearch();
        });
    }
    
    attachPaginationEvents();
</script>
{% endblock %}