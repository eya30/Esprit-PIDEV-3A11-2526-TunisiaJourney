{% extends 'admin/base_admin.html.twig' %}

{% block title %}Nouveau voyage{% endblock %}
{% block page_title %}Nouveau voyage{% endblock %}

{% block body %}
<div class="form-container">
    <div class="form-card">
        <h5 class="form-title">Créer un nouveau voyage</h5>
        <p class="form-subtitle">Remplissez les informations ci-dessous</p>

        {% if errors is defined and errors|length > 0 %}
            <div class="error-box">
                <strong>Veuillez corriger les éléments suivants :</strong>
                <ul>
                    {% for error in errors %}
                        <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <form method="post" enctype="multipart/form-data" id="voyageForm">

            {# ── Nom du voyage ── #}
            <div class="form-group">
                <label class="form-label">Nom du voyage</label>
                <div class="input-group-custom">
                    <i class="fas fa-tag"></i>
                    <input type="text" name="nom" id="voyageNom" class="form-control"
                           value="{{ nom|default('') }}"
                           placeholder="Ex: Sidi Bou Said, Djerba...">
                </div>
            </div>

            {# ── Description + bouton IA ── #}
            <div class="form-group">
                <label class="form-label">Description</label>
                <div class="input-group-custom textarea-group">
                    <i class="fas fa-align-left" style="align-self:flex-start;margin-top:14px;"></i>
                    <textarea name="description" id="voyageDescription"
                              class="form-control" rows="5"
                              placeholder="Décrivez le voyage...">{{ description|default('') }}</textarea>
                </div>

                <button type="button" id="generateDescBtn" class="btn-generate-ia mt-3">
                    <i class="fas fa-robot"></i> Générer la description avec IA
                </button>
                <p class="text-muted small mt-2">
                    <i class="fas fa-lock"></i>
                    Génération 100 % locale via Ollama Llama3 — aucune donnée envoyée en ligne
                </p>

                <div id="iaFeedback" style="display:none;"></div>
            </div>

            {# ── Capacité / Prix ── #}
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Capacité (personnes)</label>
                        <div class="input-group-custom">
                            <i class="fas fa-users"></i>
                            <input type="text" name="capacite" class="form-control"
                                   value="{{ capacite|default('') }}" placeholder="50">
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Prix (DT)</label>
                        <div class="input-group-custom">
                            <i class="fas fa-coins"></i>
                            <input type="text" name="prix" class="form-control"
                                   value="{{ prix|default('') }}" placeholder="299.00">
                        </div>
                    </div>
                </div>
            </div>

            {# ── Date / Heure ── #}
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Date de création</label>
                        <div class="input-group-custom">
                            <i class="fas fa-calendar-alt"></i>
                            <input type="text" name="dateCreation" class="form-control"
                                   value="{{ dateCreation|default('') }}" placeholder="YYYY-MM-DD">
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Heure</label>
                        <div class="input-group-custom">
                            <i class="fas fa-clock"></i>
                            <input type="text" name="heure" class="form-control"
                                   value="{{ heure|default('') }}" placeholder="HH:MM">
                        </div>
                    </div>
                </div>
            </div>

            {# ── Image ── #}
            <div class="form-group">
                <label class="form-label">Image</label>
                <div class="upload-area" id="uploadArea">
                    <i class="fas fa-cloud-upload-alt"></i>
                    <p>Cliquez ou glissez une image ici</p>
                    <small>JPG, PNG, JPEG (max. 2MB)</small>
                    <input type="file" name="image" id="imageInput" accept="image/*" style="display:none;">
                </div>
                <div id="imagePreview" class="image-preview-container"></div>

                <button type="button" id="generateImageBtn" class="btn-generate-ia mt-3">
                    <i class="fas fa-brain"></i> Générer une image avec IA (Ollama)
                </button>
                <p class="text-muted small mt-2">
                    <i class="fas fa-info-circle"></i>
                    L'IA génère des mots-clés intelligents pour trouver la meilleure image
                </p>
            </div>

            {# ── Actions ── #}
            <div class="form-actions">
                <a href="{{ path('admin_voyage_index') }}" class="btn btn-outline">
                    <i class="fas fa-arrow-left me-2"></i> Annuler
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i> Créer le voyage
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .form-container { max-width: 800px; margin: 0 auto; }

    .form-card {
        background: white;
        border-radius: 24px;
        padding: 32px;
        border: 1px solid #F0E8DD;
    }

    .form-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.4rem;
        font-weight: 700;
        color: #2C1810;
        margin-bottom: 8px;
    }

    .form-subtitle {
        font-size: 0.85rem;
        color: #93032E;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid #F0E8DD;
    }

    .input-group-custom {
        display: flex;
        align-items: center;
        background: #FEF9F0;
        border: 1px solid #E8DFD1;
        border-radius: 12px;
        transition: all 0.2s;
    }

    .input-group-custom.textarea-group { align-items: flex-start; }

    .input-group-custom:focus-within {
        border-color: #93032E;
        box-shadow: 0 0 0 3px rgba(147,3,46,0.05);
        background: white;
    }

    .input-group-custom i {
        padding: 12px 0 12px 16px;
        color: #C49A6C;
        font-size: 1rem;
    }

    .input-group-custom .form-control {
        border: none;
        background: transparent;
        padding: 12px 16px;
        font-size: 14px;
        width: 100%;
    }

    .input-group-custom .form-control:focus { box-shadow: none; }

    .form-group { margin-bottom: 20px; }

    .form-label {
        font-size: 13px;
        font-weight: 600;
        color: #2C1810;
        margin-bottom: 8px;
        display: block;
    }

    .upload-area {
        background: #FEF9F0;
        border: 2px dashed #E8DFD1;
        border-radius: 16px;
        padding: 32px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s;
    }

    .upload-area:hover { border-color: #93032E; background: #FFF5F0; }
    .upload-area i { font-size: 2rem; color: #C49A6C; margin-bottom: 12px; }
    .upload-area p { margin: 0; font-size: 0.9rem; color: #4A3B2F; }
    .upload-area small { font-size: 0.75rem; color: #9CA3AF; }

    .image-preview-container { margin-top: 16px; text-align: center; }
    .image-preview { max-width: 200px; max-height: 150px; border-radius: 12px; border: 1px solid #E8DFD1; }

    .error-box {
        background: #F8D7DA;
        border: 1px solid #F5C2C7;
        color: #842029;
        border-radius: 16px;
        padding: 18px 20px;
        margin-bottom: 20px;
    }

    .error-box ul { margin: 8px 0 0; padding-left: 18px; }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid #F0E8DD;
    }

    .btn-primary {
        background: #93032E;
        border: none;
        padding: 10px 24px;
        border-radius: 40px;
        font-size: 13px;
        font-weight: 600;
        color: white;
        transition: all 0.2s;
    }

    .btn-primary:hover {
        background: #6B0221;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(147,3,46,0.3);
    }

    .btn-outline {
        background: transparent;
        border: 1.5px solid #E8DFD1;
        padding: 10px 24px;
        border-radius: 40px;
        font-size: 13px;
        font-weight: 500;
        color: #4A3B2F;
        transition: all 0.2s;
    }

    .btn-outline:hover { border-color: #93032E; color: #93032E; background: #FFF9F0; }

    .btn-generate-ia {
        background: linear-gradient(135deg, #2C1810, #4A3B2F);
        border: none;
        padding: 10px 20px;
        border-radius: 40px;
        font-size: 13px;
        font-weight: 500;
        color: white;
        transition: all 0.2s;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-generate-ia:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(44,24,16,0.3);
        background: linear-gradient(135deg, #3A2A20, #5A4B3F);
    }

    .btn-generate-ia:disabled { opacity: 0.6; transform: none; cursor: not-allowed; }

    .text-muted { color: #9CA3AF !important; }
    .small { font-size: 0.75rem; }
    .mt-2 { margin-top: 8px; }
    .mt-3 { margin-top: 16px; }

    .ia-success {
        background: #D1FAE5;
        color: #047857;
        padding: 10px 16px;
        border-radius: 10px;
        font-size: 13px;
        margin-top: 10px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ia-error {
        background: #FEE2E2;
        color: #991B1B;
        padding: 10px 16px;
        border-radius: 10px;
        font-size: 13px;
        margin-top: 10px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    @keyframes flashGreen {
        0% { background: #D1FAE5; }
        100% { background: transparent; }
    }

    .flash-success { animation: flashGreen 1.2s ease-out forwards; }
</style>

<script>
(function () {
    const uploadArea = document.getElementById('uploadArea');
    const imageInput = document.getElementById('imageInput');
    const imagePreview = document.getElementById('imagePreview');
    const generateImageBtn = document.getElementById('generateImageBtn');
    const generateDescBtn = document.getElementById('generateDescBtn');
    const voyageNom = document.getElementById('voyageNom');
    const voyageDescription = document.getElementById('voyageDescription');
    const iaFeedback = document.getElementById('iaFeedback');

    function showFeedback(type, message, autoDismissMs) {
        iaFeedback.style.display = 'block';
        iaFeedback.className = 'ia-' + type;
        iaFeedback.innerHTML = '<i class="fas fa-' + (type === 'success' ? 'check-circle' : 'exclamation-circle') + '"></i> ' + message;
        if (autoDismissMs) {
            setTimeout(() => { iaFeedback.style.display = 'none'; }, autoDismissMs);
        }
    }

    // Upload manuel
    uploadArea.addEventListener('click', () => imageInput.click());

    imageInput.addEventListener('change', function (e) {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (e) => {
            imagePreview.innerHTML = '<img src="' + e.target.result + '" class="image-preview">';
            uploadArea.style.display = 'none';
        };
        reader.readAsDataURL(file);
    });

    uploadArea.addEventListener('dragover', (e) => {
        e.preventDefault();
        uploadArea.style.borderColor = '#93032E';
        uploadArea.style.background = '#FFF5F0';
    });

    uploadArea.addEventListener('dragleave', () => {
        uploadArea.style.borderColor = '#E8DFD1';
        uploadArea.style.background = '#FEF9F0';
    });

    uploadArea.addEventListener('drop', (e) => {
        e.preventDefault();
        const file = e.dataTransfer.files[0];
        if (file && file.type.startsWith('image/')) {
            const reader = new FileReader();
            reader.onload = (e) => {
                imagePreview.innerHTML = '<img src="' + e.target.result + '" class="image-preview">';
                uploadArea.style.display = 'none';
            };
            reader.readAsDataURL(file);
            imageInput.files = e.dataTransfer.files;
        }
        uploadArea.style.borderColor = '#E8DFD1';
        uploadArea.style.background = '#FEF9F0';
    });

    // Génération d'image avec IA (Ollama) - un seul bouton
    if (generateImageBtn) {
        generateImageBtn.addEventListener('click', async function () {
            const nom = voyageNom.value.trim();
            if (!nom) {
                alert("Veuillez d'abord entrer le nom du voyage");
                voyageNom.focus();
                return;
            }
            
            this.disabled = true;
            const origHtml = this.innerHTML;
            this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> IA génère des mots-clés…';
            
            try {
                const res = await fetch('{{ path("admin_voyage_generate_image_ai") }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'nom=' + encodeURIComponent(nom),
                });
                const data = await res.json();
                
                if (data.success) {
                    imagePreview.innerHTML = '<img src="/uploads/' + data.image + '" class="image-preview">';
                    uploadArea.style.display = 'none';
                    const message = data.keywords_used ? `Mots-clés: ${data.keywords_used.substring(0, 100)}...` : '';
                    showFeedback('success', `✅ Image trouvée par IA ! ${message}`, 5000);
                } else {
                    showFeedback('error', 'Erreur : ' + (data.error || 'Impossible de trouver une image'));
                }
            } catch (err) {
                showFeedback('error', 'Erreur de connexion. Vérifiez que Ollama est lancé.');
            } finally {
                this.disabled = false;
                this.innerHTML = origHtml;
            }
        });
    }

    // Génération de description
    if (generateDescBtn) {
        generateDescBtn.addEventListener('click', async function () {
            const nom = voyageNom.value.trim();
            if (!nom) {
                alert("Veuillez d'abord entrer le nom du voyage");
                voyageNom.focus();
                return;
            }
            
            this.disabled = true;
            const origHtml = this.innerHTML;
            this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Llama3 génère…';
            
            try {
                const res = await fetch('{{ path("admin_voyage_generate_description") }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'nom=' + encodeURIComponent(nom),
                });
                const data = await res.json();
                
                if (data.success) {
                    voyageDescription.value = data.description;
                    voyageDescription.classList.add('flash-success');
                    setTimeout(() => voyageDescription.classList.remove('flash-success'), 1200);
                    showFeedback('success', '✓ Description générée par Llama3 (100 % local)', 4000);
                } else {
                    showFeedback('error', data.error || 'Ollama non disponible — lancez : ollama serve');
                }
            } catch (err) {
                showFeedback('error', 'Erreur de connexion. Ollama est-il lancé sur le port 11434 ?');
            } finally {
                this.disabled = false;
                this.innerHTML = origHtml;
            }
        });
    }
})();
</script>
{% endblock %}