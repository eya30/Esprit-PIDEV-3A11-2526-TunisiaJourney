{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Réservations{% endblock %}
{% block page_title %}Réservations{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1" style="font-family: 'Playfair Display', serif;">Liste des réservations</h4>
        <p class="text-muted small" style="color: #93032E !important;">Consultez l'ensemble des réservations effectuées par les clients</p>
    </div>
    <div class="d-flex gap-3">
        <a href="{{ path('admin_reservationch_index', {'sort': 'hotel_nom', 'direction': 'ASC'}) }}" class="btn-elegant" style="background: #93032E;">
            <i class="fas fa-sort-alpha-down"></i>
            <span>Trier A-Z</span>
        </a>
        <button id="exportPdfBtn" class="btn-elegant btn-elegant-outline">
            <i class="fas fa-file-pdf"></i>
            <span>Exporter PDF</span>
        </button>
    </div>
</div>

<!-- Barre de recherche dynamique -->
<div class="search-bar-wrapper mb-4">
    <div class="search-input-group">
        <i class="fas fa-search search-icon"></i>
        <input type="text" id="searchInput" class="form-control search-input" 
               placeholder="Rechercher par client ID, téléphone ou statut..." 
               value="{{ search }}">
        <button id="clearSearch" class="clear-search-btn" style="display: {% if search %}flex{% else %}none{% endif %};">
            <i class="fas fa-times"></i>
        </button>
    </div>
    <div class="search-info">
        <span id="resultCount">{{ total_count }}</span> réservation(s) trouvée(s)
    </div>
</div>

<!-- Boutons de tri rapide -->
<div class="sort-buttons-wrapper mb-4">
    <span class="sort-label"><i class="fas fa-sort-amount-down-alt me-2"></i>Trier par :</span>
    <div class="sort-buttons-group">
        <button class="sort-btn {% if sort == 'hotel_nom' %}active{% endif %}" data-sort="hotel_nom">
            <i class="fas fa-hotel"></i> Hôtel
        </button>
        <button class="sort-btn {% if sort == 'chambre_num' %}active{% endif %}" data-sort="chambre_num">
            <i class="fas fa-bed"></i> Chambre
        </button>
        <button class="sort-btn {% if sort == 'prixTotal' %}active{% endif %}" data-sort="prixTotal">
            <i class="fas fa-tag"></i> Prix (croissant)
        </button>
        <button class="sort-btn {% if sort == 'nbPersonnes' %}active{% endif %}" data-sort="nbPersonnes">
            <i class="fas fa-users"></i> Personnes
        </button>
        <button class="sort-btn {% if sort == 'statut' %}active{% endif %}" data-sort="statut">
            <i class="fas fa-check-circle"></i> Statut
        </button>
    </div>
</div>

<div class="admin-table">
    <table class="table" id="reservationsTable">
        <thead>
            <tr>
                <th>
                    Hôtel
                    {% if sort == 'hotel_nom' %}
                        <i class="fas fa-sort-{% if direction == 'ASC' %}up{% else %}down{% endif %} sort-icon-active"></i>
                    {% endif %}
                </th>
                <th>
                    Chambre
                    {% if sort == 'chambre_num' %}
                        <i class="fas fa-sort-{% if direction == 'ASC' %}up{% else %}down{% endif %} sort-icon-active"></i>
                    {% endif %}
                </th>
                <th>Client ID</th>
                <th>
                    Téléphone
                    {% if sort == 'telephone' %}
                        <i class="fas fa-sort-{% if direction == 'ASC' %}up{% else %}down{% endif %} sort-icon-active"></i>
                    {% endif %}
                </th>
                <th>
                    Personnes
                    {% if sort == 'nbPersonnes' %}
                        <i class="fas fa-sort-{% if direction == 'ASC' %}up{% else %}down{% endif %} sort-icon-active"></i>
                    {% endif %}
                </th>
                <th>Dates</th>
                <th>
                    Nuits
                    {% if sort == 'nbNuit' %}
                        <i class="fas fa-sort-{% if direction == 'ASC' %}up{% else %}down{% endif %} sort-icon-active"></i>
                    {% endif %}
                </th>
                <th>
                    Prix total
                    {% if sort == 'prixTotal' %}
                        <i class="fas fa-sort-{% if direction == 'ASC' %}up{% else %}down{% endif %} sort-icon-active"></i>
                    {% endif %}
                </th>
                <th>
                    Statut
                    {% if sort == 'statut' %}
                        <i class="fas fa-sort-{% if direction == 'ASC' %}up{% else %}down{% endif %} sort-icon-active"></i>
                    {% endif %}
                </th>
            </thead>
        <tbody id="reservationsTableBody">
            {% for reservation in reservations %}
                <tr data-id="{{ reservation.idRes }}">
                    <td class="hotel-name">
                        <strong>{{ reservation.hotel_nom }}</strong><br>
                        <small class="text-muted">{{ reservation.hotel_ville }}</small>
                    </td>
                    <td class="chambre-num">Chambre n°{{ reservation.chambre_num }}</td>
                    <td class="client-id">{{ reservation.idUtilisateur }}</td>
                    <td>
                        <div><i class="fas fa-phone me-1" style="color: #93032E;"></i> {{ reservation.telephone }}</div>
                    </td>
                    <td class="client-nbre">{{ reservation.nbPersonnes }} pers</td>
                    <td class="date-range">
                        <span class="date-start">{{ reservation.dateDebut|date('d/m/Y') }}</span>
                        <i class="fas fa-arrow-right mx-1" style="font-size: 11px;"></i>
                        <span class="date-end">{{ reservation.dateFin|date('d/m/Y') }}</span>
                    </td>
                    <td class="nb-nuits">{{ reservation.nbNuit }}</td>
                    <td class="reservation-price">{{ reservation.prixTotal|number_format(2, ',', ' ') }} €</td>
                    <td>
                        {% if reservation.statut == 'confirmée' %}
                            <span class="badge-status badge-success">Confirmée</span>
                        {% elseif reservation.statut == 'en_attente' %}
                            <span class="badge-status badge-pending">En attente</span>
                        {% elseif reservation.statut == 'annulée' %}
                            <span class="badge-status badge-cancelled">Annulée</span>
                        {% else %}
                            <span class="badge-status badge-other">{{ reservation.statut }}</span>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="9" class="text-center py-5">
                        <i class="fas fa-calendar-check fa-3x mb-3" style="color: #E8DFD1;"></i>
                        <p class="text-muted mb-0">Aucune réservation trouvée</p>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<!-- Pagination -->
<div class="pagination-wrapper">
    <div class="pagination-info">
        Affichage de <strong>{{ reservations|length }}</strong> sur <strong>{{ total_count }}</strong> réservation(s)
    </div>
    <nav class="pagination-nav">
        <ul class="pagination">
            <li class="page-item {% if current_page == 1 %}disabled{% endif %}">
                <a class="page-link" href="#" data-page="{{ current_page - 1 }}">
                    <i class="fas fa-chevron-left"></i>
                </a>
            </li>
            {% for i in 1..total_pages %}
                <li class="page-item {% if i == current_page %}active{% endif %}">
                    <a class="page-link" href="#" data-page="{{ i }}">{{ i }}</a>
                </li>
            {% endfor %}
            <li class="page-item {% if current_page == total_pages %}disabled{% endif %}">
                <a class="page-link" href="#" data-page="{{ current_page + 1 }}">
                    <i class="fas fa-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
</div>

<style>
    .btn-elegant {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 24px;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.85rem;
        text-decoration: none;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
        background: #93032E;
        color: white;
        box-shadow: 0 4px 12px rgba(147, 3, 46, 0.2);
    }
    
    .btn-elegant:hover {
        background: #6B0221;
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(147, 3, 46, 0.3);
        color: white;
    }
    
    .btn-elegant-outline {
        background: transparent;
        border: 2px solid #93032E;
        color: #93032E;
        box-shadow: none;
    }
    
    .btn-elegant-outline:hover {
        background: #93032E;
        color: white;
    }
    
    .search-bar-wrapper {
        background: white;
        border-radius: 16px;
        padding: 16px 20px;
        border: 1px solid #F0E8DD;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }
    
    .search-input-group {
        position: relative;
        flex: 1;
        min-width: 250px;
    }
    
    .search-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #9CA3AF;
        font-size: 0.9rem;
    }
    
    .search-input {
        width: 100%;
        padding: 12px 40px 12px 40px;
        border: 1px solid #E8DFD1;
        border-radius: 40px;
        font-size: 14px;
        background: #FEF9F0;
        transition: all 0.2s;
    }
    
    .search-input:focus {
        outline: none;
        border-color: #93032E;
        background: white;
        box-shadow: 0 0 0 3px rgba(147,3,46,0.1);
    }
    
    .clear-search-btn {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: #9CA3AF;
        cursor: pointer;
        padding: 5px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.2s;
    }
    
    .clear-search-btn:hover {
        color: #93032E;
    }
    
    .search-info {
        font-size: 0.85rem;
        color: #9CA3AF;
        white-space: nowrap;
    }
    
    .search-info span {
        color: #93032E;
        font-weight: 600;
    }
    
    .sort-buttons-wrapper {
        background: white;
        border-radius: 16px;
        padding: 12px 20px;
        border: 1px solid #F0E8DD;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }
    
    .sort-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: #2C1810;
    }
    
    .sort-buttons-group {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }
    
    .sort-btn {
        background: #FEF9F0;
        border: 1px solid #E8DFD1;
        padding: 8px 16px;
        border-radius: 30px;
        font-size: 0.8rem;
        font-weight: 500;
        color: #4A3B2F;
        cursor: pointer;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    
    .sort-btn:hover {
        background: #FFF0E8;
        border-color: #93032E;
        color: #93032E;
    }
    
    .sort-btn.active {
        background: #93032E;
        border-color: #93032E;
        color: white;
    }
    
    .sort-icon-active {
        color: #93032E;
        margin-left: 5px;
    }
    
    .admin-table {
        background: white;
        border-radius: 20px;
        border: 1px solid #F0E8DD;
        overflow-x: auto;
    }
    
    .admin-table th {
        background: #FEF9F0;
        padding: 14px 16px;
        font-size: 12px;
        font-weight: 600;
        color: #93032E;
        text-transform: uppercase;
    }
    
    .admin-table td {
        padding: 14px 16px;
        font-size: 13px;
        border-bottom: 1px solid #F5F0E8;
        vertical-align: middle;
    }
    
    .admin-table tr:hover td {
        background: #FFF9F0;
    }
    
    .hotel-name strong {
        color: #2C1810;
    }
    
    .date-range {
        display: flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }
    
    .reservation-price {
        font-weight: 700;
        color: #93032E;
        white-space: nowrap;
    }
    
    .badge-status {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        display: inline-block;
    }
    
    .badge-success { background: #D1FAE5; color: #059669; }
    .badge-pending { background: #FEF3C7; color: #D97706; }
    .badge-cancelled { background: #FEE2E2; color: #DC2626; }
    .badge-other { background: #F3F4F6; color: #6B7280; }
    
    .pagination-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 24px;
        padding: 16px 0;
    }
    
    .pagination {
        margin: 0;
        gap: 6px;
    }
    
    .page-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: white;
        border: 1px solid #E8DFD1;
        color: #4A3B2F;
        transition: all 0.2s;
        text-decoration: none;
    }
    
    .page-link:hover {
        background: #FFF9F0;
        border-color: #93032E;
        color: #93032E;
    }
    
    .page-item.active .page-link {
        background: #93032E;
        border-color: #93032E;
        color: white;
    }
    
    @media (max-width: 768px) {
        .pagination-wrapper {
            flex-direction: column;
            gap: 16px;
            align-items: center;
        }
        .admin-table {
            overflow-x: auto;
        }
    }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script>
    // Export PDF
    document.getElementById('exportPdfBtn')?.addEventListener('click', function() {
        const element = document.getElementById('reservationsTable');
        const titleDiv = document.createElement('div');
        titleDiv.innerHTML = `
            <div style="text-align: center; margin-bottom: 20px;">
                <h1 style="color: #93032E;">TunisiaJourney</h1>
                <h2>Liste des réservations</h2>
                <p>Généré le ${new Date().toLocaleDateString('fr-FR')} à ${new Date().toLocaleTimeString('fr-FR')}</p>
                <hr>
            </div>
        `;
        const cloneTable = element.cloneNode(true);
        const container = document.createElement('div');
        container.appendChild(titleDiv);
        container.appendChild(cloneTable);
        
        html2pdf().set({
            margin: [0.5, 0.5, 0.5, 0.5],
            filename: `reservations_${new Date().toISOString().slice(0,19)}.pdf`,
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: { scale: 2 },
            jsPDF: { unit: 'in', format: 'a4', orientation: 'landscape' }
        }).from(container).save();
    });
    
    // Recherche
    let searchTimeout;
    const searchInput = document.getElementById('searchInput');
    const clearSearchBtn = document.getElementById('clearSearch');
    
    function performSearch() {
        const searchValue = searchInput.value;
        const url = new URL(window.location.href);
        url.searchParams.set('search', searchValue);
        url.searchParams.set('page', 1);
        window.location.href = url.toString();
    }
    
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            if (this.value.length > 2 || this.value.length === 0) {
                searchTimeout = setTimeout(performSearch, 500);
            }
        });
    }
    
    if (clearSearchBtn) {
        clearSearchBtn.addEventListener('click', function() {
            searchInput.value = '';
            performSearch();
        });
        searchInput.addEventListener('input', function() {
            clearSearchBtn.style.display = this.value.length > 0 ? 'flex' : 'none';
        });
    }
    
    // Tri
    document.querySelectorAll('.sort-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const sort = this.getAttribute('data-sort');
            const url = new URL(window.location.href);
            let direction = 'ASC';
            if (sort === 'prixTotal') direction = 'ASC';
            else if (sort === 'nbPersonnes') direction = 'ASC';
            url.searchParams.set('sort', sort);
            url.searchParams.set('direction', direction);
            url.searchParams.set('page', 1);
            window.location.href = url.toString();
        });
    });
    
    // Pagination
    document.querySelectorAll('.page-link[data-page]').forEach(link => {
        link.addEventListener('click', function(e) {
            e.preventDefault();
            const page = this.getAttribute('data-page');
            if (page && !this.parentElement.classList.contains('disabled')) {
                const url = new URL(window.location.href);
                url.searchParams.set('page', page);
                window.location.href = url.toString();
            }
        });
    });
</script>
{% endblock %}