{% extends 'admin/base_admin.html.twig' %}

{% block title %}Notifications - Avis chambres{% endblock %}
{% block page_title %}Notifications des avis chambres{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    
    <!-- Statistiques -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">Positifs</h5>
                    {% set totalPositifs = 0 %}
                    {% for stat in stats %}
                        {% if stat.sentiment == 'positif' %}
                            {% set totalPositifs = stat.total %}
                        {% endif %}
                    {% endfor %}
                    <p class="card-text display-4">{{ totalPositifs }}</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-danger">
                <div class="card-body">
                    <h5 class="card-title">Négatifs non lus</h5>
                    <p class="card-text display-4">{{ totalNegatifs }}</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-secondary">
                <div class="card-body">
                    <h5 class="card-title">Neutres</h5>
                    {% set totalNeutres = 0 %}
                    {% for stat in stats %}
                        {% if stat.sentiment == 'neutre' %}
                            {% set totalNeutres = stat.total %}
                        {% endif %}
                    {% endfor %}
                    <p class="card-text display-4">{{ totalNeutres }}</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title">Total avis</h5>
                    {% set totalAvis = 0 %}
                    {% for stat in stats %}
                        {% set totalAvis = totalAvis + stat.total %}
                    {% endfor %}
                    <p class="card-text display-4">{{ totalAvis }}</p>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Avis négatifs non lus -->
    <div class="card mb-4">
        <div class="card-header bg-danger text-white">
            <i class="fas fa-exclamation-triangle"></i> Avis négatifs non lus
        </div>
        <div class="card-body">
            {% if avisNegatifs|length > 0 %}
                {% for avis in avisNegatifs %}
                    <div class="alert alert-warning mb-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong>
                                    <i class="fas fa-user"></i> {{ avis.prenom }} {{ avis.nom }}
                                </strong>
                                <br>
                                <small class="text-muted">
                                    <i class="fas fa-envelope"></i> {{ avis.email }}
                                </small>
                                <p class="mt-2">
                                    <i class="fas fa-comment"></i> "{{ avis.commentaire|slice(0, 200) }}"
                                    {% if avis.commentaire|length > 200 %}...{% endif %}
                                </p>
                                <div class="row small">
                                    <div class="col-md-3">🛏️ Confort: {{ avis.note_confort }}/5</div>
                                    <div class="col-md-3">📶 Services: {{ avis.note_services }}/5</div>
                                    <div class="col-md-3">🧹 Propreté: {{ avis.note_proprete }}/5</div>
                                    <div class="col-md-3">👨‍💼 Personnel: {{ avis.note_personnel }}/5</div>
                                </div>
                            </div>
                            <div class="text-end">
                                <small class="text-muted">{{ avis.date_creation|date('d/m/Y H:i') }}</small>
                                <br>
                                <a href="{{ path('app_admin_marquer_lue_chambre', {'id': avis.id}) }}" class="btn btn-sm btn-success mt-2">
                                    <i class="fas fa-check"></i> Marquer comme lue
                                </a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i> Aucun avis négatif non lu. Bon travail !
                </div>
            {% endif %}
        </div>
    </div>
    
    <!-- Avis négatifs déjà lus -->
    {% if avisLus|length > 0 %}
    <div class="card">
        <div class="card-header bg-secondary text-white">
            <i class="fas fa-history"></i> Historique des avis négatifs (lus)
        </div>
        <div class="card-body">
            {% for avis in avisLus %}
                <div class="alert alert-light mb-2 border">
                    <div class="d-flex justify-content-between">
                        <div>
                            <strong>{{ avis.prenom }} {{ avis.nom }}</strong>
                            <br>
                            <small>"{{ avis.commentaire|slice(0, 100) }}"</small>
                        </div>
                        <div>
                            <small class="text-muted">{{ avis.date_creation|date('d/m/Y') }}</small>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}
</div>

<style>
    .display-4 {
        font-size: 2rem;
        font-weight: 600;
        margin: 0;
    }
    .card {
        border-radius: 16px;
        border: none;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    }
    .btn-sm {
        border-radius: 20px;
        padding: 5px 15px;
    }
</style>
{% endblock %}