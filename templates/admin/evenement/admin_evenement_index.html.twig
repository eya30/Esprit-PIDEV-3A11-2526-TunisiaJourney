<script>
// ── Recherche en temps réel avec debounce (500ms) ──────────────────────────
(function () {
    var input      = document.getElementById('searchInput');
    var form       = document.getElementById('searchForm');
    var loading    = document.getElementById('searchLoading');
    if (!input || !form) return;

    var timer      = null;
    var submitting = false;
    var lastSubmittedValue = input.value;

    function restoreFocusAndCursor() {
        if (input.value.length > 0) {
            input.focus();
            var len = input.value.length;
            input.setSelectionRange(len, len);
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', restoreFocusAndCursor);
    } else {
        restoreFocusAndCursor();
    }

    function showLoading(show) {
        if (!loading) return;
        loading.classList.toggle('visible', show);
    }

    input.addEventListener('input', function () {
        clearTimeout(timer);
        
        if (this.value === lastSubmittedValue) return;
        
        showLoading(true);

        timer = setTimeout(function () {
            if (submitting) return;
            submitting = true;
            showLoading(false);
            var p = form.querySelector('input[name="page"]');
            if (p) p.value = 1;
            
            lastSubmittedValue = input.value;
            form.submit();
        }, 500);
    });

    form.addEventListener('submit', function () {
        clearTimeout(timer);
        showLoading(false);
        submitting = true;
    });
})();

// ── Dropdown tri ─────────────────────────────────────────────────────────
(function () {
    var btn       = document.getElementById('sortToggle');
    var dropdown  = document.getElementById('sortDropdown');
    var sortInput = document.getElementById('sortInput');
    var form      = document.getElementById('searchForm');
    if (!btn) return;

    btn.addEventListener('click', function (e) {
        e.stopPropagation();
        btn.classList.toggle('open');
        dropdown.classList.toggle('open');
    });

    document.querySelectorAll('.sort-option').forEach(function (opt) {
        opt.addEventListener('click', function (e) {
            e.preventDefault();
            sortInput.value = this.dataset.sort;
            var p = form.querySelector('input[name="page"]');
            if (p) p.value = 1;
            form.submit();
        });
    });

    document.addEventListener('click', function () {
        btn.classList.remove('open');
        dropdown.classList.remove('open');
    });
})();

// ── Calendrier ────────────────────────────────────────────────────────────
(function () {
    var overlay    = document.getElementById('calendarOverlay');
    var openBtn    = document.getElementById('openCalendar');
    var closeBtn   = document.getElementById('closeCalendar');
    var grid       = document.getElementById('calendarGrid');
    var monthLabel = document.getElementById('monthLabel');
    var prevBtn    = document.getElementById('prevMonth');
    var nextBtn    = document.getElementById('nextMonth');
    if (!overlay) return;

    var today   = new Date();
    var current = new Date(today.getFullYear(), today.getMonth(), 1);
    var MONTHS_FR = ['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre'];

    function getEventDays(year, month) {
        var days = {};
        EVENEMENTS_DATA.forEach(function (ev) {
            if (!ev.datedebut) return;
            var d = new Date(ev.datedebut);
            if (d.getFullYear() === year && d.getMonth() === month) {
                if (!days[d.getDate()]) days[d.getDate()] = [];
                days[d.getDate()].push(ev.titre);
            }
        });
        return days;
    }

    function renderCalendar() {
        var year  = current.getFullYear();
        var month = current.getMonth();
        monthLabel.textContent = MONTHS_FR[month] + ' ' + year;
        var eventDays   = getEventDays(year, month);
        var firstDay    = new Date(year, month, 1).getDay();
        var offset      = (firstDay === 0) ? 6 : firstDay - 1;
        var daysInMonth = new Date(year, month + 1, 0).getDate();
        grid.innerHTML  = '';

        for (var i = 0; i < offset; i++) {
            var e = document.createElement('div'); e.className = 'cal-day empty'; grid.appendChild(e);
        }
        for (var d = 1; d <= daysInMonth; d++) {
            var cell = document.createElement('div');
            cell.className = 'cal-day';
            cell.textContent = d;
            if (d === today.getDate() && month === today.getMonth() && year === today.getFullYear())
                cell.classList.add('today');
            if (eventDays[d]) {
                cell.classList.add('has-event');
                var dot = document.createElement('div'); dot.className = 'event-dot'; cell.appendChild(dot);
                cell.title = eventDays[d].join('\n');
            }
            grid.appendChild(cell);
        }
    }

    if (openBtn)  openBtn.addEventListener('click',  function () { overlay.classList.add('open'); renderCalendar(); });
    if (closeBtn) closeBtn.addEventListener('click', function () { overlay.classList.remove('open'); });
    overlay.addEventListener('click', function (e) { if (e.target === overlay) overlay.classList.remove('open'); });
    if (prevBtn) prevBtn.addEventListener('click', function () { current = new Date(current.getFullYear(), current.getMonth()-1, 1); renderCalendar(); });
    if (nextBtn) nextBtn.addEventListener('click', function () { current = new Date(current.getFullYear(), current.getMonth()+1, 1); renderCalendar(); });
})();
</script>

