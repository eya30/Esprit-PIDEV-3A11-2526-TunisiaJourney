{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des événements{% endblock %}
{% block page_title %}Liste des événements{% endblock %}

{% block body %}

{# ── PREMIER CONTAINER BLANC : Titre + Admin ────────────────────────────────── #}
<div class="white-container first-container">
    <div class="toolbar-titles">
        <h1 class="page-main-title">Liste des événements</h1>
        <p class="page-header-subtitle">Gérez l'ensemble de vos événements</p>
    </div>
    <div class="admin-badge">
        <div class="admin-avatar"><i class="fas fa-user"></i></div>
        <span class="admin-label">Admin</span>
    </div>
</div>

{# ── DEUXIÈME CONTAINER BLANC : Nouvel événement + Recherche + Trier + Export PDF + Calendrier ── #}
<div class="white-container second-container">
    <a href="{{ path('admin_evenement_new') }}" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i> Nouvel événement
    </a>

    <form method="get" action="{{ path('admin_evenement_index') }}" id="searchForm" class="toolbar-form">
        <input type="hidden" name="sort" value="{{ sort }}">
        <input type="hidden" name="page" value="1">

        <div class="search-wrapper">
            <i class="fas fa-search search-icon"></i>
            <input
                type="text"
                name="search"
                id="searchInput"
                class="search-input"
                placeholder="Rechercher un événement..."
                value="{{ search }}"
                autocomplete="off"
            >
            <span class="search-loading" id="searchLoading">
                <i class="fas fa-spinner fa-spin"></i>
            </span>
            {% if search %}
                <a href="{{ path('admin_evenement_index', {sort: sort}) }}" class="search-clear" title="Effacer">
                    <i class="fas fa-times"></i>
                </a>
            {% endif %}
        </div>

        <div class="sort-wrapper">
            <button type="button" class="sort-btn" id="sortToggle">
                <i class="fas fa-sort-amount-down me-1"></i> Trier
                <i class="fas fa-chevron-down ms-1 sort-arrow"></i>
            </button>
            <div class="sort-dropdown" id="sortDropdown">
                <a href="#" class="sort-option {% if sort == 'date_asc' %}active{% endif %}" data-sort="date_asc">
                    <i class="fas fa-calendar-alt me-2"></i> Date (croissant)
                </a>
                <a href="#" class="sort-option {% if sort == 'capacite_asc' %}active{% endif %}" data-sort="capacite_asc">
                    <i class="fas fa-users me-2"></i> Capacité
                </a>
                <a href="#" class="sort-option {% if sort == 'titre_az' %}active{% endif %}" data-sort="titre_az">
                    <i class="fas fa-sort-alpha-down me-2"></i> Titre (A-Z)
                </a>
                <a href="#" class="sort-option {% if sort == 'organisateur_az' %}active{% endif %}" data-sort="organisateur_az">
                    <i class="fas fa-user me-2"></i> Organisateur (A-Z)
                </a>
            </div>
            <input type="hidden" name="sort" id="sortInput" value="{{ sort }}">
        </div>
    </form>

    <a href="{{ path('admin_evenement_export_pdf', {search: search, sort: sort}) }}"
       class="btn-export-pdf" title="Exporter tous les événements en PDF">
        <i class="fas fa-file-pdf me-1"></i> Export PDF
    </a>

    <button type="button" class="btn-calendar" id="openCalendar" title="Vue calendrier">
        <i class="fas fa-calendar-week me-1"></i> Calendrier
    </button>
</div>

{# ── Tableau ──────────────────────────────────────────────────────────────── #}
<div class="admin-table-wrapper">
    <div class="admin-table">
        <table class="table" id="evenementsTable">
            <thead>
                <tr>
                    <th style="width:100px">Image</th>
                    <th style="width:200px">Titre</th>
                    <th style="width:350px">Description</th>
                    <th style="width:180px">Lieu</th>
                    <th style="width:100px">Capacité</th>
                    <th style="width:180px">Période</th>
                    <th style="width:150px">Organisateur</th>
                    <th style="width:140px">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for evenement in evenements %}
                <tr class="evenement-row">
                    <td>
                        {% if evenement.image %}
                            <img src="{{ asset('uploads/evenements/' ~ evenement.image) }}"
                                 class="evenement-thumbnail" alt="{{ evenement.titre }}">
                        {% else %}
                            <div class="thumbnail-placeholder">
                                <i class="fas fa-calendar-alt"></i>
                            </div>
                        {% endif %}
                    </td>
                    <td class="evenement-titre" title="{{ evenement.titre }}">{{ evenement.titre }}</td>
                    <td class="evenement-description-cell" title="{{ evenement.description }}">{{ evenement.description }}</td>
                    <td class="evenement-lieu" title="{{ evenement.lieu }}">
                        <span><i class="fas fa-map-marker-alt me-1"></i> {{ evenement.lieu }}</span>
                    </td>
                    <td class="evenement-capacite">
                        <span>{{ evenement.capacitemax }} pers</span>
                    </td>
                    <td class="evenement-periode">
                        <div class="periode-info">
                            <span class="date-debut">{{ evenement.datedebut|date('d/m/Y') }}</span>
                            <i class="fas fa-arrow-right mx-1" style="font-size:10px;"></i>
                            <span class="date-fin">{{ evenement.datefin|date('d/m/Y') }}</span>
                        </div>
                    </td>
                    <td class="evenement-organisateur" title="{{ evenement.organisateur }}">
                        {% if evenement.organisateur %}
                            <span>{{ evenement.organisateur }}</span>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>
                        <div class="action-buttons">
                            <a href="{{ path('admin_evenement_activites', {'id': evenement.idev}) }}"
                               class="action-btn activites-btn" title="Voir les activités">
                                <i class="fas fa-tasks"></i>
                            </a>
                            <a href="{{ path('admin_evenement_edit', {'id': evenement.idev}) }}"
                               class="action-btn edit-btn" title="Modifier">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form method="post"
                                  action="{{ path('admin_evenement_delete', {'id': evenement.idev}) }}"
                                  style="display:inline-block;">
                                <input type="hidden" name="_token"
                                       value="{{ csrf_token('delete_evenement_' ~ evenement.idev) }}">
                                <button type="submit" class="action-btn delete-btn"
                                        onclick="return confirm('Supprimer cet événement ?')"
                                        title="Supprimer">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="8" class="text-center py-5">
                        <i class="fas fa-calendar-times fa-3x mb-3" style="color:#E8DFD1;"></i>
                        <p class="text-muted mb-0">Aucun événement trouvé</p>
                        {% if search %}
                            <a href="{{ path('admin_evenement_index') }}" class="btn btn-primary mt-3">
                                Effacer la recherche
                            </a>
                        {% else %}
                            <a href="{{ path('admin_evenement_new') }}" class="btn btn-primary mt-3">
                                Créer un événement
                            </a>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{# ── Pagination ───────────────────────────────────────────────────────────── #}
{% if total_pages is defined and total_pages > 1 %}
<div class="pagination-wrapper">
    <div class="pagination-info">
        Affichage de <strong>{{ evenements|length }}</strong> événement(s) sur
        <strong>{{ total_items }}</strong> total
        <span class="text-muted">| Page {{ current_page }} / {{ total_pages }}</span>
    </div>
    <nav class="pagination-nav">
        <ul class="pagination">
            <li class="page-item {% if current_page == 1 %}disabled{% endif %}">
                <a class="page-link"
                   href="{{ path('admin_evenement_index', {page: 1, search: search, sort: sort}) }}">
                    <i class="fas fa-angle-double-left"></i>
                </a>
            </li>
            <li class="page-item {% if current_page == 1 %}disabled{% endif %}">
                <a class="page-link"
                   href="{{ path('admin_evenement_index', {page: current_page - 1, search: search, sort: sort}) }}">
                    <i class="fas fa-chevron-left"></i>
                </a>
            </li>

            {% set start_page = max(1, current_page - 2) %}
            {% set end_page   = min(total_pages, current_page + 2) %}

            {% if start_page > 1 %}
                <li class="page-item disabled"><span class="page-link">...</span></li>
            {% endif %}

            {% for i in start_page..end_page %}
                <li class="page-item {% if i == current_page %}active{% endif %}">
                    <a class="page-link"
                       href="{{ path('admin_evenement_index', {page: i, search: search, sort: sort}) }}">
                        {{ i }}
                    </a>
                </li>
            {% endfor %}

            {% if end_page < total_pages %}
                <li class="page-item disabled"><span class="page-link">...</span></li>
            {% endif %}

            <li class="page-item {% if current_page == total_pages %}disabled{% endif %}">
                <a class="page-link"
                   href="{{ path('admin_evenement_index', {page: current_page + 1, search: search, sort: sort}) }}">
                    <i class="fas fa-chevron-right"></i>
                </a>
            </li>
            <li class="page-item {% if current_page == total_pages %}disabled{% endif %}">
                <a class="page-link"
                   href="{{ path('admin_evenement_index', {page: total_pages, search: search, sort: sort}) }}">
                    <i class="fas fa-angle-double-right"></i>
                </a>
            </li>
        </ul>
    </nav>
</div>
{% endif %}

{# ── Modal Calendrier ─────────────────────────────────────────────────────── #}
<div class="calendar-overlay" id="calendarOverlay">
    <div class="calendar-modal">
        <div class="calendar-modal-header">
            <h3><i class="fas fa-calendar-week me-2"></i> Calendrier des événements</h3>
            <button class="calendar-close" id="closeCalendar"><i class="fas fa-times"></i></button>
        </div>
        <div class="calendar-modal-body">
            <div class="calendar-nav">
                <button class="cal-nav-btn" id="prevMonth"><i class="fas fa-chevron-left"></i></button>
                <span class="cal-month-label" id="monthLabel"></span>
                <button class="cal-nav-btn" id="nextMonth"><i class="fas fa-chevron-right"></i></button>
            </div>
            <div class="calendar-grid-header">
                <span>Lun</span><span>Mar</span><span>Mer</span>
                <span>Jeu</span><span>Ven</span><span>Sam</span><span>Dim</span>
            </div>
            <div class="calendar-grid" id="calendarGrid"></div>
            <div class="calendar-legend">
                <span class="legend-dot"></span> Début d'événement
            </div>
        </div>
    </div>
</div>

<script>
const EVENEMENTS_DATA = {{ tous_evenements|json_encode|raw }};
</script>

<style>
/* ── Masquer le top-bar ───────────────────────────────────────────────────── */
.top-bar { display: none !important; }

/* ── Containers ───────────────────────────────────────────────────────────── */
.white-container {
    background: white;
    border-radius: 20px;
    border: 1px solid #F0E8DD;
    padding: 30px 24px;
    margin-bottom: 20px;
}
.first-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
}
.second-container {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
}

/* ── Titres ───────────────────────────────────────────────────────────────── */
.toolbar-titles { margin-right: auto; }
.page-main-title {
    font-size: 1.4rem; font-weight: 800; color: #2C1810; margin: 0 0 2px 0;
}
.page-header-subtitle {
    font-size: 0.85rem; color: #93032E; font-weight: 500; margin: 0;
}

/* ── Badge Admin ──────────────────────────────────────────────────────────── */
.admin-badge {
    display: flex; align-items: center; gap: 8px;
    background: #F5F5F5; border-radius: 40px; padding: 6px 14px 6px 6px;
}
.admin-avatar {
    width: 32px; height: 32px; border-radius: 50%;
    background: #93032E; color: white;
    display: flex; align-items: center; justify-content: center; font-size: 14px;
}
.admin-label { font-size: 13px; font-weight: 600; color: #2C1810; }

/* ── Recherche ────────────────────────────────────────────────────────────── */
.toolbar-form {
    display: flex; align-items: center; gap: 12px; flex: 1; flex-wrap: wrap;
}
.search-wrapper { position: relative; flex: 1; min-width: 200px; }
.search-icon {
    position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
    color: #B0A090; font-size: 13px; pointer-events: none; z-index: 2;
}
.search-input {
    width: 100%; height: 42px; border: 1.5px solid #E8DFD1; border-radius: 40px;
    padding: 0 40px 0 38px; font-size: 13px; color: #2C1810;
    background: #FDFAF7; outline: none; transition: all 0.2s;
}
.search-input:focus {
    border-color: #93032E; box-shadow: 0 0 0 3px rgba(147,3,46,0.08);
}
.search-loading {
    display: none; position: absolute; right: 40px; top: 50%;
    transform: translateY(-50%); color: #93032E; font-size: 12px;
}
.search-loading.visible { display: inline-block; }
.search-clear {
    position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
    color: #B0A090; font-size: 12px; text-decoration: none; transition: color 0.2s; z-index: 2;
}
.search-clear:hover { color: #93032E; }

/* ── Tri ──────────────────────────────────────────────────────────────────── */
.sort-wrapper { position: relative; }
.sort-btn {
    height: 42px; padding: 0 18px; border-radius: 40px;
    border: 1.5px solid #E8DFD1; background: #FDFAF7; color: #2C1810;
    font-size: 13px; font-weight: 600; cursor: pointer;
    display: flex; align-items: center; gap: 6px; transition: all 0.2s; white-space: nowrap;
}
.sort-btn:hover, .sort-btn.open { border-color: #93032E; color: #93032E; }
.sort-arrow { font-size: 10px; transition: transform 0.2s; }
.sort-btn.open .sort-arrow { transform: rotate(180deg); }
.sort-dropdown {
    display: none; position: absolute; top: calc(100% + 8px); left: 0;
    background: white; border: 1px solid #F0E8DD; border-radius: 16px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.1); z-index: 100; min-width: 200px; overflow: hidden;
}
.sort-dropdown.open { display: block; }
.sort-option {
    display: flex; align-items: center; padding: 11px 18px;
    font-size: 13px; color: #4A3B2F; text-decoration: none; transition: background 0.15s;
}
.sort-option:hover { background: #FFF9F0; color: #93032E; }
.sort-option.active { background: #FEF0F3; color: #93032E; font-weight: 600; }

/* ── Boutons ───────────────────────────────────────────────────────────────── */
.btn-export-pdf {
    height: 42px; padding: 0 18px; border-radius: 40px;
    border: 1.5px solid #93032E; background: white; color: #93032E;
    font-size: 13px; font-weight: 600; cursor: pointer;
    display: inline-flex; align-items: center; gap: 6px;
    transition: all 0.2s; white-space: nowrap; text-decoration: none;
}
.btn-export-pdf:hover { background: #93032E; color: white; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(147,3,46,0.3); }

.btn-calendar {
    height: 42px; padding: 0 18px; border-radius: 40px;
    border: 1.5px solid #344D59; background: white; color: #344D59;
    font-size: 13px; font-weight: 600; cursor: pointer;
    display: flex; align-items: center; gap: 6px; transition: all 0.2s; white-space: nowrap;
}
.btn-calendar:hover { background: #344D59; color: white; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(52,77,89,0.3); }

.btn-primary {
    background: #93032E; border: none; padding: 10px 20px; border-radius: 40px;
    font-size: 13px; font-weight: 600; color: white; transition: all 0.2s;
    text-decoration: none; display: inline-flex; align-items: center;
    height: 42px; white-space: nowrap;
}
.btn-primary:hover { background: #6B0221; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(147,3,46,0.3); color: white; }

/* ── Tableau ───────────────────────────────────────────────────────────────── */
.admin-table-wrapper { width: 100%; overflow-x: auto; border-radius: 20px; }
.admin-table { background: white; border-radius: 20px; border: 1px solid #F0E8DD; }
.admin-table .table { margin-bottom: 0; width: 100%; table-layout: fixed; }
.admin-table th {
    background: #FEF9F0; padding: 16px 20px; font-size: 12px; font-weight: 700;
    color: #93032E; text-transform: uppercase; letter-spacing: 0.5px;
    border-bottom: 1px solid #F0E8DD; white-space: nowrap;
}
.admin-table td {
    padding: 16px 20px; font-size: 13px; border-bottom: 1px solid #F5F0E8;
    color: #4A3B2F; vertical-align: middle; background: white; height: 102px;
}
.evenement-thumbnail {
    width: 70px; height: 70px; object-fit: cover; border-radius: 12px;
    border: 1px solid #F0E8DD; transition: all 0.2s; display: block;
}
.evenement-thumbnail:hover {
    transform: scale(1.05); border-color: #93032E; box-shadow: 0 4px 12px rgba(147,3,46,0.15);
}
.thumbnail-placeholder {
    width: 70px; height: 70px; background: #FEF9F0; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    color: #E8DFD1; font-size: 1.5rem; border: 1px solid #F0E8DD;
}
.evenement-titre { font-weight: 700; color: #2C1810; font-size: 0.95rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.evenement-description-cell { color: #6B7280; line-height: 1.4; font-size: 0.85rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.evenement-lieu span {
    display: inline-flex; align-items: center; background: #FEF9F0; padding: 5px 12px;
    border-radius: 20px; font-size: 12px; font-weight: 500; color: #2C1810;
    max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.evenement-lieu span i { color: #93032E; flex-shrink: 0; }
.evenement-capacite span {
    display: inline-flex; align-items: center; background: #FEF9F0; padding: 5px 12px;
    border-radius: 20px; font-size: 12px; font-weight: 500; color: #93032E; white-space: nowrap;
}
.evenement-periode .periode-info {
    display: inline-flex; align-items: center; background: #FEF9F0; padding: 5px 12px;
    border-radius: 20px; font-size: 12px; font-weight: 500; color: #4A3B2F; white-space: nowrap; gap: 4px;
}
.date-debut, .date-fin { font-weight: 600; }
.evenement-organisateur span {
    font-size: 12px; color: #6B7280; overflow: hidden; text-overflow: ellipsis;
    white-space: nowrap; display: inline-block; max-width: 130px;
}

/* ── Boutons d'action ─────────────────────────────────────────────────────── */
.action-buttons { display: flex; gap: 8px; justify-content: center; }
.action-btn {
    width: 36px; height: 36px; border-radius: 10px;
    display: inline-flex; align-items: center; justify-content: center;
    transition: all 0.2s; cursor: pointer; border: none;
    background: transparent; font-size: 0.9rem; text-decoration: none;
}
.activites-btn { background: #FEF3C7; color: #D97706; }
.edit-btn { background: #EFF6FF; color: #2F4558; }
.delete-btn { background: #FEF2F2; color: #EF4444; }

/* ── Pagination ───────────────────────────────────────────────────────────── */
.pagination-wrapper {
    display: flex; justify-content: space-between; align-items: center;
    margin-top: 24px; padding: 16px 0; border-top: 1px solid #F0E8DD;
}
.pagination-info { font-size: 0.85rem; color: #9CA3AF; }
.pagination-info strong { color: #93032E; font-weight: 600; }
.pagination { margin: 0; gap: 6px; padding-left: 0; display: flex; flex-wrap: wrap; }
.page-item { list-style: none; }
.page-link {
    display: flex; align-items: center; justify-content: center;
    min-width: 36px; height: 36px; padding: 0 8px; border-radius: 10px;
    background: white; border: 1px solid #E8DFD1; color: #4A3B2F;
    font-size: 0.85rem; font-weight: 500; transition: all 0.2s; text-decoration: none;
}
.page-link:hover { background: #FFF9F0; border-color: #93032E; color: #93032E; }
.page-item.active .page-link { background: #93032E; border-color: #93032E; color: white; }
.page-item.disabled .page-link {
    background: #FEF9F0; border-color: #F0E8DD; color: #E8DFD1;
    cursor: not-allowed; pointer-events: none;
}

/* ── Modal Calendrier ─────────────────────────────────────────────────────── */
.calendar-overlay {
    display: none; position: fixed; inset: 0;
    background: rgba(0,0,0,0.45); z-index: 1000;
    align-items: center; justify-content: center;
}
.calendar-overlay.open { display: flex; }
.calendar-modal {
    background: white; border-radius: 24px; width: 480px; max-width: 95vw;
    box-shadow: 0 24px 60px rgba(0,0,0,0.18); overflow: hidden;
    animation: calSlideIn 0.25s ease;
}
@keyframes calSlideIn {
    from { opacity: 0; transform: translateY(-20px) scale(0.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
}
.calendar-modal-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 20px 24px; background: #93032E; color: white;
}
.calendar-modal-header h3 { margin: 0; font-size: 1rem; font-weight: 700; }
.calendar-close {
    background: rgba(255,255,255,0.15); border: none; color: white;
    width: 34px; height: 34px; border-radius: 50%; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px; transition: background 0.2s;
}
.calendar-close:hover { background: rgba(255,255,255,0.3); }
.calendar-modal-body { padding: 20px 24px 24px; }
.calendar-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
.cal-nav-btn {
    background: #FEF9F0; border: 1px solid #F0E8DD; color: #93032E;
    width: 34px; height: 34px; border-radius: 50%; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; transition: all 0.2s;
}
.cal-nav-btn:hover { background: #93032E; color: white; border-color: #93032E; }
.cal-month-label { font-size: 1rem; font-weight: 700; color: #2C1810; }
.calendar-grid-header { display: grid; grid-template-columns: repeat(7, 1fr); margin-bottom: 6px; }
.calendar-grid-header span {
    text-align: center; font-size: 11px; font-weight: 700;
    color: #93032E; text-transform: uppercase; padding: 4px 0;
}
.calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
.cal-day {
    aspect-ratio: 1; display: flex; flex-direction: column;
    align-items: center; justify-content: center; border-radius: 10px;
    font-size: 13px; font-weight: 500; color: #4A3B2F; cursor: default; transition: background 0.15s;
}
.cal-day.empty { background: transparent; }
.cal-day.today { background: #FEF0F3; color: #93032E; font-weight: 700; }
.cal-day.has-event { background: #93032E; color: white; font-weight: 700; cursor: pointer; }
