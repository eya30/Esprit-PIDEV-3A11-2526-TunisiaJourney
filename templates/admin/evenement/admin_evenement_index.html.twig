<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@fullcalendar/core@6.1.11/locales/fr.global.min.js"></script>

<script>

// Anti-flash tableau
document.addEventListener('DOMContentLoaded', function () {
    var tbody = document.querySelector('#evenementsTable tbody');
    if (tbody) {
        requestAnimationFrame(function () {
            requestAnimationFrame(function () {
                tbody.classList.add('loaded');
            });
        });
    }
});

// Forcer rechargement si page vient du bfcache
window.addEventListener('pageshow', function(e) {
    if (e.persisted) {
        window.location.replace(window.location.href);
    }
});

// Masquer la page immédiatement si elle vient du cache
document.addEventListener('visibilitychange', function() {
    if (document.visibilityState === 'visible') {
        var perf = window.performance;
        if (perf && perf.navigation && perf.navigation.type === 2) {
            window.location.replace(window.location.href);
        }
    }
});

// ── Recherche debounce ──
(function () {
    var input   = document.getElementById('searchInput');
    var form    = document.getElementById('searchForm');
    var loading = document.getElementById('searchLoading');
    if (!input || !form) return;
    var timer = null, submitting = false, lastVal = input.value;
    function restoreFocus() {
        if (input.value.length > 0) { input.focus(); var l = input.value.length; input.setSelectionRange(l, l); }
    }
    document.readyState === 'loading'
        ? document.addEventListener('DOMContentLoaded', restoreFocus) : restoreFocus();
    input.addEventListener('input', function () {
        clearTimeout(timer);
        if (this.value === lastVal) return;
        if (loading) loading.classList.add('visible');
        timer = setTimeout(function () {
            if (submitting) return;
            submitting = true;
            if (loading) loading.classList.remove('visible');
            var p = form.querySelector('input[name="page"]');
            if (p) p.value = 1;
            lastVal = input.value;
            form.submit();
        }, 500);
    });
    form.addEventListener('submit', function () {
        clearTimeout(timer);
        if (loading) loading.classList.remove('visible');
        submitting = true;
    });
})();

// ── Tri dropdown ──
(function () {
    var btn  = document.getElementById('sortToggle');
    var dd   = document.getElementById('sortDropdown');
    var si   = document.getElementById('sortInput');
    var form = document.getElementById('searchForm');
    if (!btn) return;
    btn.addEventListener('click', function (e) { e.stopPropagation(); btn.classList.toggle('open'); dd.classList.toggle('open'); });
    document.querySelectorAll('.sort-option').forEach(function (opt) {
        opt.addEventListener('click', function (e) {
            e.preventDefault(); si.value = this.dataset.sort;
            var p = form.querySelector('input[name="page"]'); if (p) p.value = 1;
            form.submit();
        });
    });
    document.addEventListener('click', function () { btn.classList.remove('open'); dd.classList.remove('open'); });
})();

// ── FullCalendar ──
document.addEventListener('DOMContentLoaded', function () {
    var overlay  = document.getElementById('calendarOverlay');
    var openBtn  = document.getElementById('openCalendar');
    var closeBtn = document.getElementById('closeCalendar');
    var tooltip  = document.getElementById('fcTooltip');
    var calendar = null;

    var FERIES = {
        '2025-01-01':"Jour de l'An",'2025-03-20':"Fête de l'Indépendance",
        '2025-03-30':"Aïd el-Fitr",'2025-03-31':"Aïd el-Fitr",'2025-04-01':"Aïd el-Fitr",
        '2025-04-09':"Journée des Martyrs",'2025-05-01':"Fête du Travail",
        '2025-06-06':"Aïd el-Adha",'2025-06-07':"Aïd el-Adha",
        '2025-07-25':"Fête de la République",'2025-08-13':"Fête de la Femme",
        '2025-10-15':"Fête de l'Évacuation",'2025-12-17':"Fête de la Révolution",
        '2026-01-01':"Jour de l'An",'2026-03-20':"Indépendance / Aïd el-Fitr",
        '2026-03-21':"Aïd el-Fitr",'2026-03-22':"Aïd el-Fitr",
        '2026-04-09':"Journée des Martyrs",'2026-05-01':"Fête du Travail",
        '2026-05-27':"Aïd el-Adha",'2026-05-28':"Aïd el-Adha",
        '2026-06-16':"Ras el Am el Hijri",'2026-07-25':"Fête de la République",
        '2026-08-13':"Fête de la Femme",'2026-08-25':"Mouled",
        '2026-10-15':"Fête de l'Évacuation",'2026-12-17':"Fête de la Révolution",
        '2027-01-01':"Jour de l'An",'2027-03-09':"Aïd el-Fitr",
        '2027-03-10':"Aïd el-Fitr",'2027-03-11':"Aïd el-Fitr",
        '2027-03-20':"Fête de l'Indépendance",'2027-04-09':"Journée des Martyrs",
        '2027-05-01':"Fête du Travail",'2027-05-17':"Aïd el-Adha",'2027-05-18':"Aïd el-Adha",
        '2027-06-06':"Ras el Am el Hijri",'2027-07-25':"Fête de la République",
        '2027-08-13':"Fête de la Femme",'2027-08-14':"Mouled",
        '2027-10-15':"Fête de l'Évacuation",'2027-12-17':"Fête de la Révolution",
        '2028-01-01':"Jour de l'An",'2028-02-26':"Aïd el-Fitr",
        '2028-02-27':"Aïd el-Fitr",'2028-02-28':"Aïd el-Fitr",
        '2028-03-20':"Fête de l'Indépendance",'2028-04-09':"Journée des Martyrs",
        '2028-05-01':"Fête du Travail",'2028-05-05':"Aïd el-Adha",'2028-05-06':"Aïd el-Adha",
        '2028-05-25':"Ras el Am el Hijri",'2028-07-25':"Fête de la République",
        '2028-08-03':"Mouled",'2028-08-13':"Fête de la Femme",
        '2028-10-15':"Fête de l'Évacuation",'2028-12-17':"Fête de la Révolution"
    };

    function getDateStr(date) {
        return date.getFullYear() + '-'
            + String(date.getMonth() + 1).padStart(2, '0') + '-'
            + String(date.getDate()).padStart(2, '0');
    }

    function initCalendar() {
        if (calendar) { calendar.render(); return; }
        var el = document.getElementById('fullcalendar');

        calendar = new FullCalendar.Calendar(el, {
            locale: 'fr',
            initialView: 'dayGridMonth',
            height: 'auto',
            headerToolbar: {
                left:   'prev,next today',
                center: 'title',
                right:  'dayGridMonth,listMonth'
            },
            buttonText: {
                today: "Aujourd'hui",
                month: 'Mois',
                list:  'Liste'
            },
            showNonCurrentDates: false,
            fixedWeekCount:      false,
            events: '{{ path('admin_fullcalendar_events') }}',
            eventColor:       '#A92831',
            eventBorderColor: '#7f1d1d',
            eventTextColor:   '#ffffff',

            dayCellDidMount: function (info) {
                if (info.el.classList.contains('fc-day-other')) return;

                var dateStr = getDateStr(info.date);
                var dow     = info.date.getDay();
                var isWe    = (dow === 0 || dow === 6);
                var ferie   = FERIES[dateStr] || null;
                var isToday = (dateStr === getDateStr(new Date()));

                if (isToday) {
                    var frame = info.el.querySelector('.fc-daygrid-day-frame');
                    var numEl = info.el.querySelector('.fc-daygrid-day-number');
                    if (frame && numEl && !frame.querySelector('.fc-day-today-pin')) {
                        numEl.style.display = 'none';
                        var pin = document.createElement('div');
                        pin.className = 'fc-day-today-pin';
                        pin.textContent = '📍';
                        frame.insertBefore(pin, frame.firstChild);
                    }
                }

                if (!isToday) {
                    if (ferie) {
                        info.el.classList.add('fc-day-ferie');
                        var frame2 = info.el.querySelector('.fc-daygrid-day-frame');
                        if (frame2 && !frame2.querySelector('.fc-day-ferie-label')) {
                            var lbl = document.createElement('div');
                            lbl.className   = 'fc-day-ferie-label';
                            lbl.textContent = ferie;
                            frame2.appendChild(lbl);
                        }
                    } else if (isWe) {
                        info.el.classList.add('fc-day-we');
                    }
                }

                var parts = [];
                if (isToday) parts.push("📅 Aujourd'hui");
                if (ferie)   parts.push('🌿 ' + ferie);
                if (isWe && !ferie && !isToday) parts.push('🌟 Week-end');
                parts.push('➕ Cliquer pour créer un événement');
                info.el.title = parts.join('\n');
            },

            dateClick: function (info) {
                window.location.href = '{{ path('admin_evenement_new') }}?dateDebut=' + info.dateStr;
            },

            eventClick: function (info) {
                if (info.event.url) {
                    info.jsEvent.preventDefault();
                    window.location.href = info.event.url;
                }
            },

            eventMouseEnter: function (info) {
                var lieu  = info.event.extendedProps.lieu || '';
                var start = info.event.start;
                var end   = info.event.end;
                var html  = '<strong style="font-size:14px;">📌 ' + info.event.title + '</strong>';
                if (lieu) html += '<br>📍 ' + lieu;
                if (start) {
                    html += '<br>🗓 ' + start.toLocaleDateString('fr-FR');
                    if (end) {
                        var realEnd = new Date(end);
                        realEnd.setDate(realEnd.getDate() - 1);
                        if (realEnd > start) html += ' → ' + realEnd.toLocaleDateString('fr-FR');
                    }
                }
                html += '<br><span style="font-size:11px;opacity:0.65;display:block;margin-top:2px;">✏️ Cliquer pour modifier</span>';
                tooltip.innerHTML     = html;
                tooltip.style.display = 'block';
            },
            eventMouseLeave: function () {
                tooltip.style.display = 'none';
            },
        });

        calendar.render();
    }

    document.addEventListener('mousemove', function (e) {
        if (tooltip.style.display === 'block') {
            tooltip.style.left = (e.clientX + 16) + 'px';
            tooltip.style.top  = (e.clientY - 12) + 'px';
        }
    });

    openBtn.addEventListener('click', function () {
        overlay.classList.add('open');
        setTimeout(initCalendar, 50);
    });
    closeBtn.addEventListener('click', function () {
        overlay.classList.remove('open');
        tooltip.style.display = 'none';
    });
    overlay.addEventListener('click', function (e) {
        if (e.target === overlay) {
            overlay.classList.remove('open');
            tooltip.style.display = 'none';
        }
    });
});
</script>

