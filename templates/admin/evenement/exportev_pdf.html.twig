<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Evenements Culturels — Tunisie</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
 
        body {
            font-family: DejaVu Sans, sans-serif;
            font-size: 10.5px;
            color: #1a1a1a;
            background: #ffffff;
            padding: 32px 36px;
            line-height: 1.5;
        }
 
        /* ── Évite les coupures dans les tableaux ─────────────────────────── */
        table.data {
            width: 100%;
            border-collapse: collapse;
            page-break-inside: avoid;
            break-inside: avoid;
            table-layout: fixed;  /* ← CRITIQUE : force le respect des largeurs */
        }
 
        table.data tbody tr {
            page-break-inside: avoid;
            break-inside: avoid;
            page-break-after: avoid;
        }
 
        table.data td,
        table.data th {
            page-break-inside: avoid;
            break-inside: avoid;
            word-wrap: break-word;     /* ← Force le retour à la ligne */
            overflow-wrap: break-word;
            word-break: break-word;
        }
 
        /* ── En-tête ─────────────────────────────────────────────────────── */
        .header-table {
            width: 100%;
            margin-bottom: 10px;
        }
        .header-title {
            font-size: 17px;
            font-weight: bold;
            color: #344D59;
            letter-spacing: 0.4px;
        }
        .header-date {
            font-size: 10px;
            color: #6b7280;
            text-align: right;
            vertical-align: top;
            padding-top: 3px;
        }
 
        .divider {
            border: none;
            border-top: 1.5px solid #d1d5db;
            margin-bottom: 18px;
        }
 
        /* ── Tableau ─────────────────────────────────────────────────────── */
        table.data thead tr {
            border-bottom: 1.5px solid #4b5563;
        }
 
        table.data th {
            font-size: 9px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            color: #CC0000;
            padding: 8px 8px;
            text-align: left;
            word-wrap: break-word;
            overflow-wrap: break-word;
        }
 
        table.data td {
            padding: 10px 8px;
            vertical-align: top;
            border-bottom: 0.5px solid #e5e7eb;
            font-size: 10px;
            color: #1a1a1a;
            line-height: 1.5;
            word-wrap: break-word;
            overflow-wrap: break-word;
            word-break: break-word;
        }
 
        table.data tbody tr:nth-child(even) td {
            background-color: #fafafa;
        }
 
        .cell-titre {
            font-weight: bold;
            font-size: 10px;
            color: #111827;
        }
 
        .cell-desc {
            font-size: 9.5px;
            color: #374151;
        }
 
        .cell-lieu {
            font-size: 9.5px;
            color: #374151;
        }
 
        .cell-cap {
            font-weight: bold;
            color: #547D54;
            text-align: center;
            font-size: 10px;
        }
 
        .cell-period {
            font-size: 9.5px;
            color: #374151;
            /* Suppression du white-space: nowrap pour permettre le retour à la ligne */
        }
 
        .cell-org {
            font-size: 9.5px;
            color: #4b5563;
        }
 
        /* ── Pied de page ────────────────────────────────────────────────── */
        .footer-divider {
            border: none;
            border-top: 0.5px solid #e5e7eb;
            margin-top: 18px;
            margin-bottom: 8px;
        }
        .footer-table {
            width: 100%;
        }
        .footer-left {
            font-size: 8.5px;
            color: #9ca3af;
        }
        .footer-right {
            font-size: 9px;
            font-weight: bold;
            color: #374151;
            text-align: right;
            white-space: nowrap;
        }
 
        .page-break-avoid {
            page-break-inside: avoid;
            break-inside: avoid;
        }
    </style>
</head>
<body>
 
    {# ── En-tête ──────────────────────────────────────────────────────────── #}
    <table class="header-table" cellpadding="0" cellspacing="0">
        <tr>
            <td>
                <span class="header-title">EVENEMENTS CULTURELS · TUNISIE</span>
            </td>
            <td class="header-date">
                Document généré le {{ generated_at|date('d/m/Y') }} à {{ generated_at|date('H:i') }}
            </td>
        </tr>
    </table>
    <hr class="divider">
 
    {# ── Tableau ──────────────────────────────────────────────────────────── #}
    <table class="data">
        <thead>
            <tr>
                <th style="width:14%">Titre</th>
                <th style="width:24%">Description</th>
                <th style="width:15%">Lieu</th>
                <th style="width:8%">Capacité</th>
                <th style="width:16%">Période</th>
                <th style="width:23%">Organisateur</th>
            </tr>
        </thead>
        <tbody>
            {% for ev in evenements %}
            <tr>
                <td>
                    <span class="cell-titre">{{ ev.titre }}</span>
                </td>
                <td>
                    <span class="cell-desc">{{ ev.description_short }}</span>
                </td>
                <td>
                    <span class="cell-lieu">{{ ev.lieu }}</span>
                </td>
                <td class="cell-cap">{{ ev.capacitemax }} pers</td>
                <td class="cell-period">{{ ev.datedebut_fmt }} →<br>{{ ev.datefin_fmt }}</td>
                <td class="cell-org">
                    {% if ev.organisateur and ev.organisateur != '' and ev.organisateur != '—' %}
                        {{ ev.organisateur }}
                    {% else %}
                        <span style="color: #9ca3af;">Non renseigné</span>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
 
    {# ── Pied de page ─────────────────────────────────────────────────────── #}
    <hr class="footer-divider">
    <table class="footer-table" cellpadding="0" cellspacing="0">
        <tr>
            <td class="footer-left">
                Ce document a été généré automatiquement le {{ generated_at|date('d/m/Y') }} à {{ generated_at|date('H:i') }}.
                Toute modification manuelle est non autorisée. · Gestion des Événements · Direction des Arts et de la Culture · Tunisie
            </td>
            <td class="footer-right">
                · Total : {{ total }} événement(s)
            </td>
        </tr>
    </table>
 
</body>
</html>