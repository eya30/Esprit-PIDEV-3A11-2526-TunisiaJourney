{% extends 'admin/base_admin.html.twig' %}

{% block title %}Activités de l'événement - {{ evenement.titre }}{% endblock %}
{% block page_title %}Activités : {{ evenement.titre }}{% endblock %}

{% block body %}

{# ── PREMIER CONTAINER BLANC : Titre + Admin ────────────────────────────────── #}
<div class="white-container first-container">
    <div class="toolbar-titles">
        <h1 class="page-main-title">Activités : {{ evenement.titre }}</h1>
        <p class="page-header-subtitle">Gérez les activités de cet événement</p>
    </div>
    <div class="admin-badge">
        <div class="admin-avatar"><i class="fas fa-user"></i></div>
        <span class="admin-label">Admin</span>
    </div>
</div>

{# ── DEUXIÈME CONTAINER BLANC : Nouvelle activité + Recherche + Trier ── #}
<div class="white-container second-container">
    <a href="{{ path('admin_activite_new') }}?evenement={{ evenement.idev }}" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i> Nouvelle activité
    </a>

    <form method="get" action="{{ path('admin_evenement_activites', {'id': evenement.idev}) }}" id="searchForm" class="toolbar-form">
        <input type="hidden" name="sort" value="{{ sort }}">
        <input type="hidden" name="page" value="1">

        <div class="search-wrapper">
            <i class="fas fa-search search-icon"></i>
            <input
                type="text"
                name="search"
                id="searchInput"
                class="search-input"
                placeholder="Rechercher une activité..."
                value="{{ search }}"
                autocomplete="off"
            >
            <span class="search-loading" id="searchLoading">
                <i class="fas fa-spinner fa-spin"></i>
            </span>
            {% if search %}
                <a href="{{ path('admin_evenement_activites', {'id': evenement.idev, sort: sort}) }}" class="search-clear" title="Effacer">
                    <i class="fas fa-times"></i>
                </a>
            {% endif %}
        </div>

        <div class="sort-wrapper">
            <button type="button" class="sort-btn" id="sortToggle">
                <i class="fas fa-sort-amount-down me-1"></i> Trier
                <i class="fas fa-chevron-down ms-1 sort-arrow"></i>
            </button>
            <div class="sort-dropdown" id="sortDropdown">
                <a href="#" class="sort-option {% if sort == 'horaire_asc' %}active{% endif %}" data-sort="horaire_asc">
                    <i class="fas fa-clock me-2"></i> Horaire (croissant)
                </a>
                <a href="#" class="sort-option {% if sort == 'capacite_asc' %}active{% endif %}" data-sort="capacite_asc">
                    <i class="fas fa-users me-2"></i> Capacité
                </a>
                <a href="#" class="sort-option {% if sort == 'titre_az' %}active{% endif %}" data-sort="titre_az">
                    <i class="fas fa-sort-alpha-down me-2"></i> Titre (A-Z)
                </a>
                <a href="#" class="sort-option {% if sort == 'prix_asc' %}active{% endif %}" data-sort="prix_asc">
                    <i class="fas fa-tag me-2"></i> Prix (croissant)
                </a>
                <a href="#" class="sort-option {% if sort == 'type_az' %}active{% endif %}" data-sort="type_az">
                    <i class="fas fa-tag me-2"></i> Type (A-Z)
                </a>
            </div>
            <input type="hidden" name="sort" id="sortInput" value="{{ sort }}">
        </div>
    </form>
</div>

{# ── Tableau des activités ─────────────────────────────────────────────────── #}
<div class="admin-table-wrapper">
    <div class="admin-table">
        <table class="table">
            <thead>
                <tr>
                    <th style="width: 80px">Image</th>
                    <th>Titre</th>
                    <th>Description</th>
                    <th>Type</th>
                    <th>Animateur</th>
                    <th>Horaire</th>
                    <th>Capacité</th>
                    <th>Prix</th>
                    <th style="width: 120px">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for activite in activites %}
                <tr>
                    <td>
                        {% if activite.image %}
                            <img src="{{ asset('uploads/activites/' ~ activite.image|split('/')|last) }}" class="activite-thumbnail">
                        {% else %}
                            <div class="thumbnail-placeholder">
                                <i class="fas fa-calendar-alt"></i>
                            </div>
                        {% endif %}
                    </td>
                    <td><strong class="activite-titre">{{ activite.titre }}</strong></td>
                    <td class="activite-description">{{ activite.description|slice(0, 50) }}{% if activite.description|length > 50 %}...{% endif %}</td>
                    <td><span class="type-badge">{{ activite.typeactivite }}</span></td>
                    <td><span class="animateur-badge">{{ activite.nomanimateur }}</span></td>
                    <td><span class="horaire-badge">{{ activite.heuredebut }} ({{ activite.duree }})</span></td>
                    <td><span class="capacite-badge">{{ activite.capacitem }} pers</span></td>
                    <td class="prix-cell">{{ activite.prix|number_format(2, ',', ' ') }} DT</td>
                    <td>
                        <div class="action-buttons">
                            <a href="{{ path('admin_activite_reservations', {'id': activite.idact}) }}" class="action-btn reservations-btn" title="Réservations">
                                <i class="fas fa-book"></i>
                            </a>
                            <a href="{{ path('admin_activite_edit', {'id': activite.idact}) }}" class="action-btn edit-btn" title="Modifier">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form method="post" action="{{ path('admin_activite_delete', {'id': activite.idact}) }}" style="display: inline-block;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_activite_' ~ activite.idact) }}">
                                <button type="submit" class="action-btn delete-btn" onclick="return confirm('Supprimer cette activité ?')" title="Supprimer">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="9" class="text-center py-5">
                        <i class="fas fa-calendar-alt fa-3x mb-3" style="color: #E8DFD1;"></i>
                        <p class="text-muted mb-0">Aucune activité pour cet événement</p>
                        <a href="{{ path('admin_activite_new') }}?evenement={{ evenement.idev }}" class="btn btn-primary mt-3">Créer une activité</a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{# ── PAGINATION ───────────────────────────────────────────────────────────── #}
{% if total_pages is defined and total_pages > 1 %}
<div class="pagination-wrapper">
    <div class="pagination-info">
        Affichage de <strong>{{ activites|length }}</strong> activité(s) sur
        <strong>{{ total_items }}</strong> total
        <span class="text-muted">| Page {{ current_page }} / {{ total_pages }}</span>
    </div>
    <nav class="pagination-nav">
        <ul class="pagination">
            <li class="page-item {% if current_page == 1 %}disabled{% endif %}">
                <a class="page-link"
                   href="{{ path('admin_evenement_activites', {id: evenement.idev, page: 1, search: search, sort: sort}) }}">
                    <i class="fas fa-angle-double-left"></i>
                </a>
            </li>
            <li class="page-item {% if current_page == 1 %}disabled{% endif %}">
                <a class="page-link"
                   href="{{ path('admin_evenement_activites', {id: evenement.idev, page: current_page - 1, search: search, sort: sort}) }}">
                    <i class="fas fa-chevron-left"></i>
                </a>
            </li>

            {% set start_page = max(1, current_page - 2) %}
            {% set end_page   = min(total_pages, current_page + 2) %}

            {% if start_page > 1 %}
                <li class="page-item disabled"><span class="page-link">...</span></li>
            {% endif %}

            {% for i in start_page..end_page %}
                <li class="page-item {% if i == current_page %}active{% endif %}">
                    <a class="page-link"
                       href="{{ path('admin_evenement_activites', {id: evenement.idev, page: i, search: search, sort: sort}) }}">
                        {{ i }}
                    </a>
                </li>
            {% endfor %}

            {% if end_page < total_pages %}
                <li class="page-item disabled"><span class="page-link">...</span></li>
            {% endif %}

            <li class="page-item {% if current_page == total_pages %}disabled{% endif %}">
                <a class="page-link"
                   href="{{ path('admin_evenement_activites', {id: evenement.idev, page: current_page + 1, search: search, sort: sort}) }}">
                    <i class="fas fa-chevron-right"></i>
                </a>
            </li>
            <li class="page-item {% if current_page == total_pages %}disabled{% endif %}">
                <a class="page-link"
                   href="{{ path('admin_evenement_activites', {id: evenement.idev, page: total_pages, search: search, sort: sort}) }}">
                    <i class="fas fa-angle-double-right"></i>
                </a>
            </li>
        </ul>
    </nav>
</div>
{% endif %}

<style>
    .top-bar { display: none !important; }

    .white-container {
        background: white;
        border-radius: 20px;
        border: 1px solid #F0E8DD;
        padding: 30px 24px;
        margin-bottom: 20px;
    }

    .first-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
    }

    .second-container {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .toolbar-titles { margin-right: auto; }

    .page-main-title {
        font-size: 1.4rem;
        font-weight: 800;
        color: #2C1810;
        margin: 0 0 2px 0;
    }

    .page-header-subtitle {
        font-size: 0.85rem;
        color: #93032E;
        font-weight: 500;
        margin: 0;
    }

    .admin-badge {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #F5F5F5;
        border-radius: 40px;
        padding: 6px 14px 6px 6px;
        margin-left: 4px;
    }

    .admin-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #93032E;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
    }

    .admin-label {
        font-size: 13px;
        font-weight: 600;
        color: #2C1810;
    }

    .toolbar-form {
        display: flex;
        align-items: center;
        gap: 12px;
        flex: 1;
        flex-wrap: wrap;
    }

    .search-wrapper {
        position: relative;
        flex: 1;
        min-width: 200px;
    }

    .search-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #B0A090;
        font-size: 13px;
        pointer-events: none;
        z-index: 2;
    }

    .search-input {
        width: 100%;
        height: 42px;
        border: 1.5px solid #E8DFD1;
        border-radius: 40px;
        padding: 0 40px 0 38px;
        font-size: 13px;
        color: #2C1810;
        background: #FDFAF7;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .search-input:focus {
        border-color: #93032E;
        box-shadow: 0 0 0 3px rgba(147,3,46,0.08);
    }

    .search-loading {
        display: none;
        position: absolute;
        right: 40px;
        top: 50%;
        transform: translateY(-50%);
        color: #93032E;
        font-size: 12px;
    }

    .search-loading.visible { display: inline-block; }

    .search-clear {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #B0A090;
        font-size: 12px;
        text-decoration: none;
        transition: color 0.2s;
        z-index: 2;
    }

    .search-clear:hover { color: #93032E; }

    .sort-wrapper { position: relative; }

    .sort-btn {
        height: 42px;
        padding: 0 18px;
        border-radius: 40px;
        border: 1.5px solid #E8DFD1;
        background: #FDFAF7;
        color: #2C1810;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
        white-space: nowrap;
    }

    .sort-btn:hover, .sort-btn.open { border-color: #93032E; color: #93032E; }
    .sort-arrow { font-size: 10px; transition: transform 0.2s; }
    .sort-btn.open .sort-arrow { transform: rotate(180deg); }

    .sort-dropdown {
        display: none;
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        background: white;
        border: 1px solid #F0E8DD;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.1);
        z-index: 100;
        min-width: 200px;
        overflow: hidden;
    }

    .sort-dropdown.open { display: block; }

    .sort-option {
        display: flex;
        align-items: center;
        padding: 11px 18px;
        font-size: 13px;
        color: #4A3B2F;
        text-decoration: none;
        transition: background 0.15s;
    }

    .sort-option:hover { background: #FFF9F0; color: #93032E; }
    .sort-option.active { background: #FEF0F3; color: #93032E; font-weight: 600; }

    .btn-primary {
        background: #93032E;
        border: none;
        padding: 10px 20px;
        border-radius: 40px;
        font-size: 13px;
        font-weight: 600;
        color: white;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        height: 42px;
        white-space: nowrap;
    }

    .btn-primary:hover {
        background: #6B0221;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(147,3,46,0.3);
        color: white;
    }

    .admin-table-wrapper {
        width: 100%;
        overflow-x: auto;
        border-radius: 20px;
    }

    .admin-table {
        background: white;
        border-radius: 20px 20px 0 0;
        border: 1px solid #F0E8DD;
        border-bottom: none;
    }

    .admin-table .table {
        margin-bottom: 0;
        min-width: 1100px;
        width: 100%;
    }

    .admin-table th {
        background: #FEF9F0;
        padding: 16px 20px;
        font-size: 12px;
        font-weight: 700;
        color: #93032E;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1px solid #F0E8DD;
        white-space: nowrap;
    }

    .admin-table td {
        padding: 16px 20px;
        font-size: 13px;
        border-bottom: 1px solid #F5F0E8;
        color: #4A3B2F;
        vertical-align: middle;
        background: white;
    }

    .admin-table tr:hover td { background: white; }

    .activite-thumbnail {
        width: 50px;
        height: 50px;
        object-fit: cover;
        border-radius: 10px;
    }

    .thumbnail-placeholder {
        width: 50px;
        height: 50px;
        background: #FEF9F0;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #E8DFD1;
    }

    .activite-titre { color: #2C1810; font-weight: 700; }
    .activite-description { color: #6B7280; }

    /* Texte simple sans badge */
    .type-badge, .animateur-badge, .horaire-badge, .capacite-badge {
        font-size: 13px;
        font-weight: 400;
        color: #2C1810;
        background: none;
        padding: 0;
        border-radius: 0;
    }

    .prix-cell { font-weight: 700; color: #93032E; font-size: 14px; white-space: nowrap; }

    .action-buttons { display: flex; gap: 8px; }

    .action-btn {
        width: 34px; height: 34px; border-radius: 8px;
        display: inline-flex; align-items: center; justify-content: center;
        transition: all 0.2s; cursor: pointer; border: none;
        background: transparent; font-size: 0.9rem; text-decoration: none;
    }

    .reservations-btn { background: #EFF6FF; color: #2F4558; }
    .edit-btn { background: #FEF3C7; color: #D97706; }
    .delete-btn { background: #FEF2F2; color: #EF4444; }

    /* ── Pagination ── */
    .pagination-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 24px;
        padding: 16px 0;
        border-top: 1px solid #F0E8DD;
        flex-wrap: wrap;
        gap: 16px;
    }

    .pagination-info { font-size: 0.85rem; color: #9CA3AF; }
    .pagination-info strong { color: #93032E; font-weight: 600; }

    .pagination { margin: 0; gap: 6px; padding-left: 0; display: flex; flex-wrap: wrap; }
    .page-item { list-style: none; }

    .page-link {
        display: flex; align-items: center; justify-content: center;
        min-width: 36px; height: 36px; padding: 0 8px; border-radius: 10px;
        background: white; border: 1px solid #E8DFD1; color: #4A3B2F;
        font-size: 0.85rem; font-weight: 500; transition: all 0.2s; text-decoration: none;
    }

    .page-link:hover { background: #FFF9F0; border-color: #93032E; color: #93032E; }
    .page-item.active .page-link { background: #93032E; border-color: #93032E; color: white; }
    .page-item.disabled .page-link {
        background: #FEF9F0; border-color: #F0E8DD; color: #E8DFD1;
        cursor: not-allowed; pointer-events: none;
    }

    .text-muted { color: #9CA3AF !important; }
    .text-center { text-align: center; }
    .py-5 { padding-top: 3rem; padding-bottom: 3rem; }
    .mt-3 { margin-top: 1rem; }
    .mb-0 { margin-bottom: 0; }
    .mb-3 { margin-bottom: 1rem; }
    .me-1 { margin-right: 0.25rem; }
    .me-2 { margin-right: 0.5rem; }
    .ms-1 { margin-left: 0.25rem; }
</style>

<script>
(function () {
    var input      = document.getElementById('searchInput');
    var form       = document.getElementById('searchForm');
    var loading    = document.getElementById('searchLoading');
    if (!input || !form) return;

    var timer      = null;
    var submitting = false;
    var lastSubmittedValue = input.value;

    function restoreFocusAndCursor() {
        if (input.value.length > 0) {
            input.focus();
            var len = input.value.length;
            input.setSelectionRange(len, len);
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', restoreFocusAndCursor);
    } else {
        restoreFocusAndCursor();
    }

    function showLoading(show) {
        if (!loading) return;
        loading.classList.toggle('visible', show);
    }

    input.addEventListener('input', function () {
        clearTimeout(timer);
        if (this.value === lastSubmittedValue) return;
        showLoading(true);
        timer = setTimeout(function () {
            if (submitting) return;
            submitting = true;
            showLoading(false);
            var p = form.querySelector('input[name="page"]');
            if (p) p.value = 1;
            lastSubmittedValue = input.value;
            form.submit();
        }, 500);
    });

    form.addEventListener('submit', function () {
        clearTimeout(timer);
        showLoading(false);
        submitting = true;
    });
})();

(function () {
    var btn       = document.getElementById('sortToggle');
    var dropdown  = document.getElementById('sortDropdown');
    var sortInput = document.getElementById('sortInput');
    var form      = document.getElementById('searchForm');
    if (!btn) return;

    btn.addEventListener('click', function (e) {
        e.stopPropagation();
        btn.classList.toggle('open');
        dropdown.classList.toggle('open');
    });

    document.querySelectorAll('.sort-option').forEach(function (opt) {
        opt.addEventListener('click', function (e) {
            e.preventDefault();
            sortInput.value = this.dataset.sort;
            var p = form.querySelector('input[name="page"]');
            if (p) p.value = 1;
            form.submit();
        });
    });

    document.addEventListener('click', function () {
        btn.classList.remove('open');
        dropdown.classList.remove('open');
    });
})();
</script>

{% endblock %}
