{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier un événement - {{ evenement.Titre|default(evenement.titre|default('')) }}{% endblock %}
{% block page_title %}Modifier : {{ evenement.Titre|default(evenement.titre|default('')) }}{% endblock %}

{% block body %}
<div class="form-container">
    <div class="form-card">
        <h5 class="form-title">Modifier l'événement</h5>
        <p class="form-subtitle">Modifiez les informations ci-dessous</p>

        <form method="post" enctype="multipart/form-data" id="evenementForm" action="{{ path('admin_evenement_edit', { id: evenementId }) }}">

            {# ── Titre ────────────────────────────────────────────────────── #}
            <div class="form-group {% if errors.titre is defined %}has-error{% endif %}" data-field="titre">
                <label class="form-label">Titre de l'événement <span class="required">*</span></label>
                <div class="input-group-custom">
                    <i class="fas fa-tag"></i>
                    <input type="text" name="titre" class="form-control"
                           value="{{ app.request.method == 'POST' ? old.titre|default('') : evenement.Titre|default('') }}"
                           placeholder="Ex: Festival de la Médina, Gala de bienfaisance..."
                           autocomplete="off">
                </div>
                <div class="error-message{% if errors.titre is defined %} has-error{% endif %}">
                    {{ errors.titre is defined ? errors.titre : '' }}
                </div>
            </div>

            {# ── Description ──────────────────────────────────────────────── #}
            <div class="form-group {% if errors.description is defined %}has-error{% endif %}" data-field="description">
                <label class="form-label">Description <span class="required">*</span></label>
                <div class="input-group-custom">
                    <i class="fas fa-align-left"></i>
                    <textarea name="description" class="form-control" rows="5"
                              placeholder="Décrivez l'événement..." autocomplete="off">{{ app.request.method == 'POST' ? old.description|default('') : evenement.Description|default('') }}</textarea>
                </div>
                <div class="error-message{% if errors.description is defined %} has-error{% endif %}">
                    {{ errors.description is defined ? errors.description : '' }}
                </div>
            </div>

            {# ── Lieu ─────────────────────────────────────────────────────── #}
            <div class="form-group {% if errors.lieu is defined %}has-error{% endif %}" data-field="lieu">
                <label class="form-label">Lieu <span class="required">*</span></label>
                <div class="input-group-custom">
                    <i class="fas fa-map-marker-alt"></i>
                    <input type="text" name="lieu" class="form-control"
                           value="{{ app.request.method == 'POST' ? old.lieu|default('') : evenement.Lieu|default('') }}"
                           placeholder="Ex: Palais des Congrès, Salle polyvalente..."
                           autocomplete="off">
                </div>
                <div class="error-message{% if errors.lieu is defined %} has-error{% endif %}">
                    {{ errors.lieu is defined ? errors.lieu : '' }}
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    {# ── Date de début ──────────────────────────────────────── #}
                    <div class="form-group {% if errors.dateDebut is defined %}has-error{% endif %}" data-field="dateDebut">
                        <label class="form-label">Date de début <span class="required">*</span></label>
                        <div class="input-group-custom">
                            <i class="fas fa-calendar-alt"></i>
                            <input type="text" name="dateDebut" class="form-control"
                                   value="{{ app.request.method == 'POST' ? old.dateDebut|default('') : evenement.DateDebut|default('')|date('d/m/Y') }}"
                                   placeholder="JJ/MM/AAAA" autocomplete="off">
                        </div>
                        <div class="error-message{% if errors.dateDebut is defined %} has-error{% endif %}">
                            {{ errors.dateDebut is defined ? errors.dateDebut : '' }}
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    {# ── Date de fin ────────────────────────────────────────── #}
                    <div class="form-group {% if errors.dateFin is defined %}has-error{% endif %}" data-field="dateFin">
                        <label class="form-label">Date de fin <span class="required">*</span></label>
                        <div class="input-group-custom">
                            <i class="fas fa-calendar-check"></i>
                            <input type="text" name="dateFin" class="form-control"
                                   value="{{ app.request.method == 'POST' ? old.dateFin|default('') : evenement.DateFin|default('')|date('d/m/Y') }}"
                                   placeholder="JJ/MM/AAAA" autocomplete="off">
                        </div>
                        <div class="error-message{% if errors.dateFin is defined %} has-error{% endif %}">
                            {{ errors.dateFin is defined ? errors.dateFin : '' }}
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    {# ── Capacité maximale ───────────────────────────────────── #}
                    <div class="form-group {% if errors.capaciteMax is defined %}has-error{% endif %}" data-field="capaciteMax">
                        <label class="form-label">Capacité maximale <span class="required">*</span></label>
                        <div class="input-group-custom">
                            <i class="fas fa-users"></i>
                            <input type="text" name="capaciteMax" class="form-control"
                                   value="{{ app.request.method == 'POST' ? old.capaciteMax|default('') : evenement.CapaciteMax|default('') }}"
                                   placeholder="100" autocomplete="off">
                        </div>
                        <div class="error-message{% if errors.capaciteMax is defined %} has-error{% endif %}">
                            {{ errors.capaciteMax is defined ? errors.capaciteMax : '' }}
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    {# ── Organisateur ───────────────────────────────────────── #}
                    <div class="form-group {% if errors.organisateur is defined %}has-error{% endif %}" data-field="organisateur">
                        <label class="form-label">Organisateur <span class="required">*</span></label>
                        <div class="input-group-custom">
                            <i class="fas fa-user-tie"></i>
                            <input type="text" name="organisateur" class="form-control"
                                   value="{{ app.request.method == 'POST' ? old.organisateur|default('') : evenement.Organisateur|default('') }}"
                                   placeholder="Nom de l'organisateur" autocomplete="off">
                        </div>
                        <div class="error-message{% if errors.organisateur is defined %} has-error{% endif %}">
                            {{ errors.organisateur is defined ? errors.organisateur : '' }}
                        </div>
                    </div>
                </div>
            </div>

            {# ── Image ────────────────────────────────────────────────────── #}
            <div class="form-group">
                <label class="form-label">Image actuelle</label>
                {% set currentImage = app.request.method == 'POST' ? old.image|default('') : evenement.Image|default('') %}
                {% if currentImage %}
                    <div class="image-wrapper">
                        <div class="current-image">
                            <img src="{{ asset('uploads/evenements/' ~ currentImage) }}" class="current-image-preview" alt="Image de l'événement">
                        </div>
                    </div>
                {% else %}
                    <p class="text-muted mb-2">Aucune image</p>
                {% endif %}
                
                <label class="form-label mt-3">Changer l'image</label>
                <div class="upload-area" id="uploadArea">
                    <i class="fas fa-cloud-upload-alt"></i>
                    <p>Cliquez ou glissez une nouvelle image</p>
                    <small>JPG, PNG, JPEG (max. 2MB)</small>
                    <input type="file" name="image" id="imageInput" accept="image/*" style="display: none;">
                </div>
                <div id="imagePreview" class="image-preview-container"></div>
                {% if errors.image is defined %}
                    <div class="error-message has-error" style="display: block;">
                        {{ errors.image }}
                    </div>
                {% endif %}
            </div>

            <div class="form-actions">
                <a href="{{ path('admin_evenement_index') }}" class="btn btn-outline">
                    <i class="fas fa-arrow-left me-2"></i> Annuler
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i> Enregistrer
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .form-container {
        max-width: 900px;
        margin: 0 auto;
    }

    .form-card {
        background: white;
        border-radius: 24px;
        padding: 32px;
        border: 1px solid #F0E8DD;
    }

    .form-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.4rem;
        font-weight: 700;
        color: #2C1810;
        margin-bottom: 8px;
    }

    .form-subtitle {
        font-size: 0.85rem;
        color: #93032E;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid #F0E8DD;
    }

    .required {
        color: #93032E;
        font-size: 12px;
    }

    .input-group-custom {
        display: flex;
        align-items: center;
        background: white;
        border: 1.5px solid #E8DFD1;
        border-radius: 12px;
        transition: all 0.2s;
    }

    .input-group-custom:focus-within {
        border-color: #93032E;
        box-shadow: 0 0 0 2px rgba(147,3,46,0.1);
    }

    .form-group.has-error .input-group-custom {
        border-color: #dc2626;
        background: white;
    }

    .form-group.has-error .input-group-custom:focus-within {
        border-color: #dc2626;
        box-shadow: 0 0 0 2px rgba(220,38,38,0.1);
    }

    .input-group-custom i {
        padding: 12px 0 12px 16px;
        color: #828282;
        font-size: 1rem;
    }

    .input-group-custom .form-control {
        border: none;
        background: transparent;
        padding: 12px 16px;
        font-size: 14px;
        width: 100%;
        outline: none;
    }

    .input-group-custom .form-control:focus {
        outline: none;
        box-shadow: none;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        font-size: 13px;
        font-weight: 600;
        color: #2C1810;
        margin-bottom: 8px;
        display: block;
    }

    .error-message {
        color: #dc2626;
        font-size: 12px;
        margin-top: 6px;
        padding-left: 12px;
        display: none;
    }

    .error-message.has-error {
        display: block;
    }

    .form-group.has-error .error-message {
        display: block;
    }

    .image-wrapper {
        text-align: center;
    }

    .current-image {
        display: inline-block;
        padding: 9px;
        background: #f8f9fa;
        border: 1px solid #E8DFD1;
        border-radius: 12px;
        text-align: center;
        line-height: 0;
    }

    .current-image-preview {
        max-width: 100%;
        max-height: 300px;
        width: auto;
        height: auto;
        border-radius: 8px;
        object-fit: contain;
        display: block;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .upload-area {
        background: white;
        border: 1.5px dashed #93032E;
        border-radius: 16px;
        padding: 24px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s;
    }

    .upload-area:hover {
        border-color: #93032E;
        background: #FFF5F0;
    }

    .upload-area i {
        font-size: 1.8rem;
        color: #828282;
        margin-bottom: 8px;
    }

    .upload-area p {
        margin: 0;
        font-size: 0.85rem;
        color: #4A3B2F;
    }

    .upload-area small {
        font-size: 0.7rem;
        color: #9CA3AF;
    }

    .image-preview-container {
        margin-top: 16px;
        text-align: center;
    }

    .image-preview {
        max-width: 100%;
        max-height: 250px;
        border-radius: 12px;
        border: 1px solid #E8DFD1;
        object-fit: contain;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid #F0E8DD;
    }

    .btn-primary {
        background: #93032E;
        border: none;
        padding: 10px 24px;
        border-radius: 40px;
        font-size: 13px;
        font-weight: 600;
        color: white;
        transition: all 0.2s;
        cursor: pointer;
    }

    .btn-primary:hover {
        background: #6B0221;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(147,3,46,0.3);
    }

    .btn-outline {
        background: transparent;
        border: 1.5px solid #93032E;
        padding: 10px 24px;
        border-radius: 40px;
        font-size: 13px;
        font-weight: 500;
        color: #93032E;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

    .btn-outline:hover {
        border-color: #6B0221;
        color: #6B0221;
        background: #FFF9F0;
    }

    .text-muted {
        color: #9CA3AF !important;
    }

    .row {
        display: flex;
        gap: 20px;
        margin-bottom: 0;
    }

    .col-md-6 {
        flex: 1;
    }

    .mt-3 {
        margin-top: 1rem;
    }

    .mb-2 {
        margin-bottom: 0.5rem;
    }

    .me-2 {
        margin-right: 0.5rem;
    }

    @media (max-width: 768px) {
        .row {
            flex-direction: column;
            gap: 0;
        }

        .form-card {
            padding: 20px;
        }
        
        .current-image-preview {
            max-height: 200px;
        }
    }
</style>

<script>
    // Validation en temps réel via Ajax
    let timeoutId = null;
    const form = document.getElementById('evenementForm');
    const formAction = form.getAttribute('action');
    const formGroups = document.querySelectorAll('.form-group[data-field]');
    
    function updateFieldError(fieldName, errorMessage) {
        const group = document.querySelector(`.form-group[data-field="${fieldName}"]`);
        if (!group) return;
        
        const errorDiv = group.querySelector('.error-message');
        
        if (errorMessage && errorMessage !== '') {
            group.classList.add('has-error');
            if (errorDiv) {
                errorDiv.textContent = errorMessage;
                errorDiv.classList.add('has-error');
            }
        } else {
            group.classList.remove('has-error');
            if (errorDiv) {
                errorDiv.textContent = '';
                errorDiv.classList.remove('has-error');
            }
        }
    }
    
    formGroups.forEach(group => {
        const input = group.querySelector('input, textarea, select');
        const fieldName = group.getAttribute('data-field');
        
        if (input) {
            input.addEventListener('input', function() {
                clearTimeout(timeoutId);
                
                timeoutId = setTimeout(() => {
                    const formData = new FormData(form);
                    formData.append('ajax_validation', '1');
                    
                    fetch(formAction, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        // Réinitialiser toutes les erreurs
                        document.querySelectorAll('.form-group.has-error').forEach(g => {
                            g.classList.remove('has-error');
                            const msg = g.querySelector('.error-message');
                            if (msg) {
                                msg.textContent = '';
                                msg.classList.remove('has-error');
                            }
                        });
                        
                        // Afficher les nouvelles erreurs
                        if (data.errors) {
                            for (const [field, message] of Object.entries(data.errors)) {
                                updateFieldError(field, message);
                            }
                        }
                    })
                    .catch(error => console.error('Erreur:', error));
                }, 500);
            });
        }
    });

    // Script pour l'upload d'image
    const uploadArea = document.getElementById('uploadArea');
    const imageInput = document.getElementById('imageInput');
    const imagePreview = document.getElementById('imagePreview');

    if (uploadArea) {
        uploadArea.addEventListener('click', () => {
            imageInput.click();
        });

        imageInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    imagePreview.innerHTML = '<img src="' + e.target.result + '" class="image-preview">';
                    uploadArea.style.display = 'none';
                };
                reader.readAsDataURL(file);
            }
        });

        uploadArea.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadArea.style.borderColor = '#93032E';
            uploadArea.style.background = '#FFF5F0';
        });

        uploadArea.addEventListener('dragleave', () => {
            uploadArea.style.borderColor = '#93032E';
            uploadArea.style.background = 'white';
        });

        uploadArea.addEventListener('drop', (e) => {
            e.preventDefault();
            const file = e.dataTransfer.files[0];
            if (file && file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    imagePreview.innerHTML = '<img src="' + e.target.result + '" class="image-preview">';
                    uploadArea.style.display = 'none';
                };
                reader.readAsDataURL(file);
                imageInput.files = e.dataTransfer.files;
            }
            uploadArea.style.borderColor = '#93032E';
            uploadArea.style.background = 'white';
        });
    }
</script>
{% endblock %}