{% extends 'admin/base_admin.html.twig' %}

{% block title %}Nouvel événement{% endblock %}
{% block page_title %}Nouvel événement{% endblock %}

{% block body %}
<div class="form-container">
    <div class="form-card">
        <h5 class="form-title">Créer un nouvel événement</h5>
        <p class="form-subtitle">Remplissez les informations ci-dessous</p>

        <form method="post" enctype="multipart/form-data" id="evenementForm" action="{{ path('admin_evenement_new') }}">

            <div class="form-group {% if errors.titre is defined %}has-error{% endif %}" data-field="titre">
                <label class="form-label">Titre de l'événement <span class="required">*</span></label>
                <div class="input-group-custom">
                    <i class="fas fa-tag"></i>
                    <input type="text" name="titre" class="form-control"
                           value="{{ old.titre|default('') }}"
                           placeholder="Ex: Festival de la Médina, Gala de bienfaisance..."
                           autocomplete="off">
                </div>
                {% if errors.titre is defined %}
                    <div class="error-message">{{ errors.titre }}</div>
                {% endif %}
            </div>

            <div class="form-group {% if errors.description is defined %}has-error{% endif %}" data-field="description">
                <label class="form-label">Description <span class="required">*</span></label>
                <div class="input-group-custom">
                    <i class="fas fa-align-left"></i>
                    <textarea name="description" class="form-control" rows="5"
                              placeholder="Décrivez l'événement..." autocomplete="off">{{ old.description|default('') }}</textarea>
                </div>
                {% if errors.description is defined %}
                    <div class="error-message">{{ errors.description }}</div>
                {% endif %}
            </div>

            <div class="form-group {% if errors.lieu is defined %}has-error{% endif %}" data-field="lieu">
                <label class="form-label">Lieu <span class="required">*</span></label>
                <div class="input-group-custom">
                    <i class="fas fa-map-marker-alt"></i>
                    <input type="text" name="lieu" class="form-control"
                           value="{{ old.lieu|default('') }}"
                           placeholder="Ex: Palais des Congrès, Salle polyvalente..."
                           autocomplete="off">
                </div>
                {% if errors.lieu is defined %}
                    <div class="error-message">{{ errors.lieu }}</div>
                {% endif %}
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group {% if errors.dateDebut is defined %}has-error{% endif %}" data-field="dateDebut">
                        <label class="form-label">Date de début <span class="required">*</span></label>
                        <div class="input-group-custom">
                            <i class="fas fa-calendar-alt"></i>
                            <input type="text" name="dateDebut" id="dateDebut" class="form-control"
                                   value="{{ old.dateDebut|default('') }}"
                                   placeholder="JJ/MM/AAAA" autocomplete="off">
                        </div>
                        {% if errors.dateDebut is defined %}
                            <div class="error-message">{{ errors.dateDebut }}</div>
                        {% endif %}
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group {% if errors.dateFin is defined %}has-error{% endif %}" data-field="dateFin">
                        <label class="form-label">Date de fin <span class="required">*</span></label>
                        <div class="input-group-custom">
                            <i class="fas fa-calendar-check"></i>
                            <input type="text" name="dateFin" class="form-control"
                                   value="{{ old.dateFin|default('') }}"
                                   placeholder="JJ/MM/AAAA" autocomplete="off">
                        </div>
                        {% if errors.dateFin is defined %}
                            <div class="error-message">{{ errors.dateFin }}</div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group {% if errors.capaciteMax is defined %}has-error{% endif %}" data-field="capaciteMax">
                        <label class="form-label">Capacité maximale <span class="required">*</span></label>
                        <div class="input-group-custom">
                            <i class="fas fa-users"></i>
                            <input type="text" name="capaciteMax" class="form-control"
                                   value="{{ old.capaciteMax|default('') }}"
                                   placeholder="100" autocomplete="off">
                        </div>
                        {% if errors.capaciteMax is defined %}
                            <div class="error-message">{{ errors.capaciteMax }}</div>
                        {% endif %}
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group {% if errors.organisateur is defined %}has-error{% endif %}" data-field="organisateur">
                        <label class="form-label">Organisateur <span class="required">*</span></label>
                        <div class="input-group-custom">
                            <i class="fas fa-user-tie"></i>
                            <input type="text" name="organisateur" class="form-control"
                                   value="{{ old.organisateur|default('') }}"
                                   placeholder="Nom de l'organisateur" autocomplete="off">
                        </div>
                        {% if errors.organisateur is defined %}
                            <div class="error-message">{{ errors.organisateur }}</div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Image de l'événement</label>
                <div class="upload-area" id="uploadArea">
                    <i class="fas fa-cloud-upload-alt"></i>
                    <p>Cliquez ou glissez une image ici</p>
                    <small>JPG, PNG, JPEG (max. 2MB)</small>
                    <input type="file" name="image" id="imageInput" accept="image/*" style="display: none;">
                </div>
                <div id="imagePreview" class="image-preview-container"></div>
            </div>

            <div class="form-actions">
                <a href="{{ path('admin_evenement_index') }}" class="btn btn-outline">
                    <i class="fas fa-arrow-left me-2"></i> Annuler
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i> Créer l'événement
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .form-container { max-width: 900px; margin: 0 auto; }
    .form-card { background: white; border-radius: 24px; padding: 32px; border: 1px solid #F0E8DD; }
    .form-title { font-family: 'Playfair Display', serif; font-size: 1.4rem; font-weight: 700; color: #2C1810; margin-bottom: 8px; }
    .form-subtitle { font-size: 0.85rem; color: #93032E; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid #F0E8DD; }
    .required { color: #93032E; font-size: 12px; }
    .input-group-custom { display: flex; align-items: center; background: white; border: 1.5px solid #93032E; border-radius: 12px; transition: all 0.2s; }
    .input-group-custom:focus-within { border-color: #93032E; box-shadow: 0 0 0 2px rgba(147,3,46,0.1); }
    .form-group.has-error .input-group-custom { border-color: #dc2626; background: white; }
    .form-group.has-error .input-group-custom:focus-within { border-color: #dc2626; box-shadow: 0 0 0 2px rgba(220,38,38,0.1); }
    .input-group-custom i { padding: 12px 0 12px 16px; color: #828282; font-size: 1rem; }
    .input-group-custom .form-control { border: none; background: transparent; padding: 12px 16px; font-size: 14px; width: 100%; outline: none; }
    .input-group-custom .form-control:focus { outline: none; box-shadow: none; }
    .form-group { margin-bottom: 20px; }
    .form-label { font-size: 13px; font-weight: 600; color: #2C1810; margin-bottom: 8px; display: block; }
    .error-message { color: #dc2626; font-size: 12px; margin-top: 6px; padding-left: 12px; display: block; }
    .upload-area { background: #FEF9F0; border: 1.5px dashed #93032E; border-radius: 16px; padding: 32px; text-align: center; cursor: pointer; transition: all 0.2s; }
    .upload-area:hover { border-color: #93032E; background: #FFF5F0; }
    .upload-area i { font-size: 2rem; color: #828282; margin-bottom: 12px; }
    .upload-area p { margin: 0; font-size: 0.9rem; color: #4A3B2F; }
    .upload-area small { font-size: 0.75rem; color: #9CA3AF; }
    .image-preview-container { margin-top: 16px; text-align: center; }
    .image-preview { max-width: 200px; max-height: 150px; border-radius: 12px; border: 1px solid #E8DFD1; }
    .form-actions { display: flex; justify-content: flex-end; gap: 12px; margin-top: 32px; padding-top: 24px; border-top: 1px solid #F0E8DD; }
    .btn-primary { background: #93032E; border: none; padding: 10px 24px; border-radius: 40px; font-size: 13px; font-weight: 600; color: white; transition: all 0.2s; cursor: pointer; }
    .btn-primary:hover { background: #6B0221; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(147,3,46,0.3); }
    .btn-outline { background: transparent; border: 1.5px solid #93032E; padding: 10px 24px; border-radius: 40px; font-size: 13px; font-weight: 500; color: #93032E; transition: all 0.2s; text-decoration: none; display: inline-flex; align-items: center; }
    .btn-outline:hover { border-color: #6B0221; color: #6B0221; background: #FFF9F0; }
    .row { display: flex; gap: 20px; margin-bottom: 0; }
    .col-md-6 { flex: 1; }
    .me-2 { margin-right: 0.5rem; }
    @media (max-width: 768px) { .row { flex-direction: column; gap: 0; } }
</style>

<script>
    // ── Effacer les erreurs en temps réel ──
    document.querySelectorAll('.form-group[data-field]').forEach(function(group) {
        var input = group.querySelector('input, textarea, select');
        if (input) {
            input.addEventListener('input', function() {
                group.classList.remove('has-error');
                var errorMsg = group.querySelector('.error-message');
                if (errorMsg) errorMsg.remove();
            });
        }
    });

    // ── Upload d'image ──
    var uploadArea   = document.getElementById('uploadArea');
    var imageInput   = document.getElementById('imageInput');
    var imagePreview = document.getElementById('imagePreview');

    if (uploadArea) {
        uploadArea.addEventListener('click', function() { imageInput.click(); });

        imageInput.addEventListener('change', function(e) {
            var file = e.target.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    imagePreview.innerHTML = '<img src="' + e.target.result + '" class="image-preview">';
                    uploadArea.style.display = 'none';
                };
                reader.readAsDataURL(file);
            }
        });

        uploadArea.addEventListener('dragover', function(e) {
            e.preventDefault();
            uploadArea.style.background = '#FFF5F0';
        });

        uploadArea.addEventListener('dragleave', function() {
            uploadArea.style.background = '#FEF9F0';
        });

        uploadArea.addEventListener('drop', function(e) {
            e.preventDefault();
            var file = e.dataTransfer.files[0];
            if (file && file.type.startsWith('image/')) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    imagePreview.innerHTML = '<img src="' + e.target.result + '" class="image-preview">';
                    uploadArea.style.display = 'none';
                };
                reader.readAsDataURL(file);
                imageInput.files = e.dataTransfer.files;
            }
            uploadArea.style.background = '#FEF9F0';
        });
    }

    // ── NOUVEAU : Pré-remplir la date depuis le calendrier ──
    (function () {
        var params = new URLSearchParams(window.location.search);
        var d = params.get('dateDebut');
        if (d) {
            var parts = d.split('-');
            if (parts.length === 3) {
                var input = document.getElementById('dateDebut');
                if (input && !input.value) {
                    input.value = parts[2] + '/' + parts[1] + '/' + parts[0];
                }
            }
        }
    })();
</script>

{% endblock %}