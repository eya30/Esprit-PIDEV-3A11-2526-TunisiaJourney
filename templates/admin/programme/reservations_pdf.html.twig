<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Réservations</title>

<style>
@page {
    margin: 20px;
}

body {
    font-family: DejaVu Sans, Arial, sans-serif;
    font-size: 11px;
    color: #2c2c2c;
}

/* HEADER */
.header {
    border-bottom: 2px solid #8B0000;
    padding-bottom: 10px;
    margin-bottom: 20px;
}

.header h1 {
    margin: 0;
    font-size: 18px;
    color: #8B0000;
}

.header p {
    margin: 3px 0;
    font-size: 10px;
    color: #666;
}

/* PROGRAMME INFO */
.box {
    border: 1px solid #ddd;
    padding: 10px;
    margin-bottom: 15px;
}

.box-title {
    font-weight: bold;
    margin-bottom: 8px;
    color: #8B0000;
}

.info {
    width: 100%;
}

.info td {
    padding: 3px 0;
}

/* SUMMARY */
.summary {
    width: 100%;
    border: 1px solid #ddd;
    margin-bottom: 15px;
}

.summary td {
    text-align: center;
    padding: 8px;
    border-right: 1px solid #ddd;
}

.summary td:last-child {
    border-right: none;
}

.summary .value {
    font-weight: bold;
    font-size: 14px;
    color: #8B0000;
}

.summary .label {
    font-size: 10px;
    color: #666;
}

/* TABLE */
.table {
    width: 100%;
    border-collapse: collapse;
}

.table th {
    background: #8B0000;
    color: white;
    padding: 8px;
    font-size: 10px;
    text-align: left;
}

.table td {
    padding: 7px;
    border-bottom: 1px solid #ddd;
    font-size: 10px;
}

.table tr:nth-child(even) {
    background: #f9f9f9;
}

.text-center {
    text-align: center;
}

.text-right {
    text-align: right;
}

/* STATUS */
.status-paid {
    color: green;
    font-weight: bold;
}

.status-wait {
    color: orange;
    font-weight: bold;
}

.status-other {
    color: gray;
}

/* FOOTER */
.footer {
    margin-top: 20px;
    font-size: 9px;
    text-align: center;
    color: #999;
}
</style>
</head>

<body>

<!-- HEADER -->
<div class="header">
    <h1>Rapport des réservations</h1>
    <p>Programme : {{ programme.nom }}</p>
    <p>Généré le {{ generated_at|date('d/m/Y H:i') }}</p>
</div>

<!-- PROGRAMME -->
<div class="box">
    <div class="box-title">Informations du programme</div>

    <table class="info">
        <tr>
            <td><strong>Dates :</strong></td>
            <td>Du {{ programme.dateDebut|date('d/m/Y') }} au {{ programme.dateFin|date('d/m/Y') }}</td>
        </tr>
        <tr>
            <td><strong>Lieu :</strong></td>
            <td>{{ programme.lieu }}</td>
        </tr>
        <tr>
            <td><strong>Hôtel :</strong></td>
            <td>{{ programme.hotel }}</td>
        </tr>
        <tr>
            <td><strong>Voyage :</strong></td>
            <td>{{ programme.voyage_nom }}</td>
        </tr>
    </table>
</div>

<!-- SUMMARY -->
<table class="summary">
<tr>
<td>
<div class="value">{{ total_reservations }}</div>
<div class="label">Réservations</div>
</td>

<td>
<div class="value">{{ total_personnes }}</div>
<div class="label">Personnes</div>
</td>

<td>
<div class="value">{{ total_montant|number_format(0, ',', ' ') }} DT</div>
<div class="label">Total</div>
</td>

<td>
<div class="value">{{ total_paye|number_format(0, ',', ' ') }} DT</div>
<div class="label">Payé</div>
</td>
</tr>
</table>

<!-- TABLE -->
{% if reservations|length > 0 %}
<table class="table">
<thead>
<tr>
<th>ID</th>
<th>Client</th>
<th>Email</th>
<th>Tél</th>
<th class="text-center">Pers</th>
<th class="text-right">Prix</th>
<th>Date</th>
<th>Statut</th>
</tr>
</thead>

<tbody>
{% for reservation in reservations %}
<tr>
<td>#{{ reservation.idRP }}</td>
<td>{{ reservation.prenom }} {{ reservation.nom }}</td>
<td>{{ reservation.email }}</td>
<td>{{ reservation.telephone }}</td>
<td class="text-center">{{ reservation.nbre }}</td>
<td class="text-right">{{ reservation.prixProg|number_format(0, ',', ' ') }} DT</td>
<td>{{ reservation.dateProgramme|date('d/m/Y') }}</td>

<td>
{% if reservation.statutPaiement == 'payé' %}
<span class="status-paid">Payé</span>
{% elseif reservation.statutPaiement == 'en_attente' %}
<span class="status-wait">En attente</span>
{% else %}
<span class="status-other">{{ reservation.statutPaiement }}</span>
{% endif %}
</td>

</tr>
{% endfor %}
</tbody>
</table>
{% else %}
<p style="text-align:center; margin-top:30px;">Aucune réservation</p>
{% endif %}

<!-- FOOTER -->
<div class="footer">
TunisiaJourney © {{ "now"|date("Y") }}
</div>

</body>
</html>