{% extends 'admin/base_admin.html.twig' %}

{% block title %}Réservations du programme - {{ programme.nom }}{% endblock %}
{% block page_title %}Réservations : {{ programme.nom }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a href="{{ path('admin_voyage_programmes', {'id': programme.idV}) }}" class="btn btn-outline mb-2">
            <i class="fas fa-arrow-left me-2"></i> Retour aux programmes
        </a>
        <h4 class="mb-1" style="font-family: 'Playfair Display', serif;">Réservations du programme</h4>
        <p class="text-muted small" style="color: #93032E !important;">
            Lieu: {{ programme.lieu }} | Dates: {{ programme.dateDebut|date('d/m/Y') }} - {{ programme.dateFin|date('d/m/Y') }}
        </p>
    </div>
</div>

<div class="admin-table">
    <table class="table">
        <thead>
             </tr>
                <th>Client</th>
                <th>Contact</th>
                <th>Nb personnes</th>
                <th>Prix total</th>
                <th>Date réservation</th>
                <th>Statut</th>
                <th>Action</th>
             </tr>
        </thead>
        <tbody>
            {% for reservation in reservations %}
                <tr>
                    <td class="client-name">
                        <strong>{{ reservation.prenom }} {{ reservation.nom }}</strong>
                    </td>
                    <td>
                        <div><i class="fas fa-phone me-1" style="color: #93032E;"></i> {{ reservation.telephone }}</div>
                        <div><i class="fas fa-envelope me-1" style="color: #93032E;"></i> {{ reservation.email }}</div>
                    </td>
                    <td class="client-nbre">{{ reservation.nbre }} pers</td>
                    <td class="reservation-price">{{ reservation.prixProg|number_format(2, ',', ' ') }} DT</td>
                    <td class="reservation-date">{{ reservation.dateProgramme|date('d/m/Y H:i') }}</td>
                    <td>
                        {% if reservation.statutPaiement == 'payé' %}
                            <span class="badge-status badge-success">Payé</span>
                        {% else %}
                            <span class="badge-status badge-pending">En attente</span>
                        {% endif %}
                    </td>
                    <td>
                        <div class="action-buttons">
                            <form method="post" action="{{ path('admin_reservation_delete', {'id': reservation.idRP}) }}" style="display: inline-block;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_reservation_' ~ reservation.idRP) }}">
                                <button type="submit" class="action-btn delete-btn" onclick="return confirm('Supprimer cette réservation ?')" title="Supprimer">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="text-center py-5">
                        <i class="fas fa-ticket-alt fa-3x mb-3" style="color: #E8DFD1;"></i>
                        <p class="text-muted mb-0">Aucune réservation pour ce programme</p>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<style>
    .admin-table {
        background: white;
        border-radius: 20px;
        border: 1px solid #F0E8DD;
        overflow: hidden;
    }
    
    .admin-table th {
        background: #FEF9F0;
        padding: 14px 20px;
        font-size: 12px;
        font-weight: 600;
        color: #93032E;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1px solid #F0E8DD;
    }
    
    .admin-table td {
        padding: 14px 20px;
        font-size: 13px;
        border-bottom: 1px solid #F5F0E8;
        color: #4A3B2F;
        vertical-align: middle;
    }
    
    .admin-table tr:hover td {
        background: #FFF9F0;
    }
    
    .client-name strong {
        color: #2C1810;
    }
    
    .client-nbre {
        white-space: nowrap;
    }
    
    .reservation-price {
        font-weight: 700;
        color: #93032E;
        font-size: 0.95rem;
        white-space: nowrap;
    }
    
    .reservation-date {
        white-space: nowrap;
        color: #9CA3AF;
        font-size: 0.85rem;
    }
    
    .badge-status {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-block;
        text-align: center;
        min-width: 85px;
    }
    
    .badge-success {
        background: #E0F2E9;
        color: #047857;
    }
    
    .badge-pending {
        background: #FEF3C7;
        color: #B45309;
    }
    
    .action-buttons {
        display: flex;
        gap: 8px;
    }
    
    .action-btn {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        cursor: pointer;
        border: none;
        background: transparent;
        font-size: 0.9rem;
        text-decoration: none;
    }
    
    .delete-btn {
        background: #FEF2F2;
        color: #EF4444;
    }
    
    .delete-btn:hover {
        background: #EF4444;
        color: white;
        transform: translateY(-2px);
    }
    
    .btn-outline {
        background: transparent;
        border: 1.5px solid #E8DFD1;
        padding: 6px 16px;
        border-radius: 40px;
        font-size: 12px;
        font-weight: 500;
        color: #4A3B2F;
        transition: all 0.2s;
    }
    
    .btn-outline:hover {
        border-color: #93032E;
        color: #93032E;
        background: #FFF9F0;
    }
    
    @media (max-width: 768px) {
        .admin-table {
            overflow-x: auto;
        }
    }
</style>
{% endblock %}