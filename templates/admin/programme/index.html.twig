{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Programmes{% endblock %}
{% block page_title %}Programmes{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1" style="font-family: 'Playfair Display', serif;">Liste des programmes</h4>
        <p class="text-muted small" style="color: #93032E !important;">Gérez l'ensemble des programmes</p>
    </div>
    <a href="{{ path('admin_programme_new') }}" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i> Nouveau programme
    </a>
</div>

<!-- Barre de recherche dynamique -->
<div class="search-bar-wrapper mb-4">
    <div class="search-input-group">
        <i class="fas fa-search search-icon"></i>
        <input type="text" id="searchInput" class="form-control search-input" 
               placeholder="Rechercher par nom, lieu, hôtel ou voyage..." 
               value="{{ search }}">
        <button id="clearSearch" class="clear-search-btn" style="display: {% if search %}flex{% else %}none{% endif %};">
            <i class="fas fa-times"></i>
        </button>
    </div>
    <div class="search-info">
        <span id="resultCount">{{ total_count }}</span> programme(s) trouvé(s)
    </div>
</div>

<div class="admin-table">
    <table class="table">
        <thead>
             <tr>
                <th style="width: 80px">Image</th>
                <th>Nom</th>
                <th>Description</th>
                <th>Lieu</th>
                <th>Hôtel</th>
                <th>Dates</th>
                <th>Voyage</th>
                <th style="width: 120px">Actions</th>
            </tr>
        </thead>
        <tbody id="programmesTableBody">
            {% for programme in programmes %}
                <tr>
                    <td>
                        {% if programme.image %}
                            <img src="{{ asset('uploads/programmes/' ~ programme.image) }}" style="width: 50px; height: 50px; object-fit: cover; border-radius: 10px;">
                        {% else %}
                            <div style="width: 50px; height: 50px; background: #FEF9F0; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-calendar-alt" style="color: #E8DFD1;"></i>
                            </div>
                        {% endif %}
                    </td>
                    <td><strong style="color: #2C1810;">{{ programme.nom }}</strong></td>
                    <td style="color: #6B7280;">{{ programme.description|slice(0, 50) }}{% if programme.description|length > 50 %}...{% endif %}</td>
                    <td><span class="location-badge">{{ programme.lieu }}</span></td>
                    <td><span class="hotel-badge">{{ programme.hotel }}</span></td>
                    <td><span class="date-badge">{{ programme.dateDebut|date('d/m/Y') }}<br>→ {{ programme.dateFin|date('d/m/Y') }}</span></td>
                    <td><span class="voyage-badge">{{ programme.voyage_nom }}</span></td>
                    <td>
                        <div class="action-buttons">
                            <a href="{{ path('admin_programme_reservations', {'id': programme.idProg}) }}" class="action-btn reservations-btn" title="Réservations">
                                <i class="fas fa-book"></i>
                            </a>
                            <a href="{{ path('admin_programme_edit', {'id': programme.idProg}) }}" class="action-btn edit-btn" title="Modifier">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form method="post" action="{{ path('admin_programme_delete', {'id': programme.idProg}) }}" style="display: inline-block;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_programme_' ~ programme.idProg) }}">
                                <button type="submit" class="action-btn delete-btn" onclick="return confirm('Supprimer ce programme ?')" title="Supprimer">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8" class="text-center py-5">
                        <i class="fas fa-calendar-alt fa-3x mb-3" style="color: #E8DFD1;"></i>
                        <p class="text-muted mb-0">Aucun programme trouvé</p>
                        <a href="{{ path('admin_programme_new') }}" class="btn btn-primary mt-3">Créer un programme</a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<style>
    .search-bar-wrapper {
        background: white;
        border-radius: 16px;
        padding: 16px 20px;
        border: 1px solid #F0E8DD;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }
    
    .search-input-group {
        position: relative;
        flex: 1;
        min-width: 250px;
    }
    
    .search-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #9CA3AF;
        font-size: 0.9rem;
    }
    
    .search-input {
        width: 100%;
        padding: 12px 40px 12px 40px;
        border: 1px solid #E8DFD1;
        border-radius: 40px;
        font-size: 14px;
        background: #FEF9F0;
        transition: all 0.2s;
    }
    
    .search-input:focus {
        outline: none;
        border-color: #93032E;
        background: white;
        box-shadow: 0 0 0 3px rgba(147,3,46,0.1);
    }
    
    .clear-search-btn {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: #9CA3AF;
        cursor: pointer;
        padding: 5px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.2s;
    }
    
    .clear-search-btn:hover {
        color: #93032E;
    }
    
    .search-info {
        font-size: 0.85rem;
        color: #9CA3AF;
        white-space: nowrap;
    }
    
    .search-info span {
        color: #93032E;
        font-weight: 600;
    }
    
    .admin-table {
        background: white;
        border-radius: 20px;
        border: 1px solid #F0E8DD;
        overflow: hidden;
    }
    
    .admin-table th {
        background: #FEF9F0;
        padding: 14px 20px;
        font-size: 12px;
        font-weight: 600;
        color: #93032E;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1px solid #F0E8DD;
    }
    
    .admin-table td {
        padding: 14px 20px;
        font-size: 13px;
        border-bottom: 1px solid #F5F0E8;
        color: #4A3B2F;
        vertical-align: middle;
    }
    
    .admin-table tr:hover td {
        background: #FFF9F0;
    }
    
    .location-badge, .hotel-badge, .voyage-badge {
        display: inline-flex;
        align-items: center;
        background: #FEF9F0;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
        color: #93032E;
    }
    
    .date-badge {
        display: inline-flex;
        flex-direction: column;
        font-size: 11px;
        color: #9CA3AF;
        line-height: 1.4;
    }
    
    .action-buttons {
        display: flex;
        gap: 8px;
    }
    
    .action-btn {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        cursor: pointer;
        border: none;
        background: transparent;
        font-size: 0.9rem;
        text-decoration: none;
    }
    
    .reservations-btn {
        background: #EFF6FF;
        color: #3B82F6;
    }
    
    .reservations-btn:hover {
        background: #3B82F6;
        color: white;
        transform: translateY(-2px);
    }
    
    .edit-btn {
        background: #FEF3C7;
        color: #D97706;
    }
    
    .edit-btn:hover {
        background: #F59E0B;
        color: white;
        transform: translateY(-2px);
    }
    
    .delete-btn {
        background: #FEF2F2;
        color: #EF4444;
    }
    
    .delete-btn:hover {
        background: #EF4444;
        color: white;
        transform: translateY(-2px);
    }
    
    .btn-primary {
        background: #93032E;
        border: none;
        padding: 8px 20px;
        border-radius: 40px;
        font-size: 13px;
        font-weight: 600;
        color: white;
        transition: all 0.2s;
    }
    
    .btn-primary:hover {
        background: #6B0221;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(147,3,46,0.3);
    }
    
    @media (max-width: 768px) {
        .search-bar-wrapper {
            flex-direction: column;
            align-items: stretch;
        }
        
        .search-info {
            text-align: center;
        }
        
        .admin-table {
            overflow-x: auto;
        }
    }
</style>

<script>
    // Recherche dynamique avec debounce
    let searchTimeout;
    const searchInput = document.getElementById('searchInput');
    const clearSearchBtn = document.getElementById('clearSearch');
    
    function performSearch() {
        const searchValue = searchInput.value;
        const url = new URL(window.location.href);
        url.searchParams.set('search', searchValue);
        window.location.href = url.toString();
    }
    
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            if (this.value.length > 2 || this.value.length === 0) {
                searchTimeout = setTimeout(performSearch, 500);
            }
        });
    }
    
    if (clearSearchBtn) {
        clearSearchBtn.addEventListener('click', function() {
            searchInput.value = '';
            performSearch();
        });
        
        searchInput.addEventListener('input', function() {
            clearSearchBtn.style.display = this.value.length > 0 ? 'flex' : 'none';
        });
    }
</script>
{% endblock %}