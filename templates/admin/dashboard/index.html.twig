{% extends 'admin/base_admin.html.twig' %}

{% block title %}Dashboard{% endblock %}
{% block page_title %}Dashboard{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
    :root {
        --bordeaux:      #93032E;
        --bordeaux2:     #6B0220;
        --bordeaux-l:    #B5294E;
        --blue:          #1A6B9A;
        --blue-l:        #2E8FC4;
        --terra:         #C4531A;
        --terra-l:       #E07840;
        --gold:          #C9943A;
        --gold-l:        #E8BC6E;
        --teal:          #2A8B7A;
        --beige:         #F4EDE4;
        --beige2:        #E8DDD0;
        --cream:         #FCF9F5;
        --text-dark:     #2A241E;
        --text-mid:      #6B5C52;
        --text-light:    #9B8B7D;
        --white:         #FFFFFF;
        --border:        #E8E0D6;
        --shadow:        0 2px 12px rgba(0,0,0,0.05);
        --shadow-lg:     0 8px 30px rgba(0,0,0,0.09);
    }

    .dashboard-container {
        padding: 28px 28px 28px 20px;
        margin-left: 0;
        max-width: 100%;
    }

    /* ── Header ── */
    .dash-header { margin-bottom: 30px; }
    .dash-header h1 {
        font-size: 24px; font-weight: 700;
        color: var(--text-dark); margin: 0; letter-spacing: -0.3px;
    }
    .dash-header p { color: var(--text-light); margin-top: 5px; font-size: 13px; }

    /* ── Section label ── */
    .section-label {
        font-size: 10px; font-weight: 800;
        color: var(--text-light);
        text-transform: uppercase; letter-spacing: 1.4px;
        margin: 28px 0 14px;
        display: flex; align-items: center; gap: 10px;
    }
    .section-label::after {
        content: ''; flex: 1; height: 1px; background: var(--border);
    }

    /* ── KPI Grid ── */
    .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }

    .kpi-card {
        background: var(--white);
        border-radius: 16px;
        padding: 18px 20px;
        box-shadow: var(--shadow);
        border: 1px solid var(--border);
        display: flex; align-items: center; gap: 14px;
        transition: all .22s ease;
        position: relative; overflow: hidden;
    }
    .kpi-card::after {
        content: '';
        position: absolute; bottom: 0; left: 0; right: 0;
        height: 3px;
        background: linear-gradient(90deg, var(--bordeaux), var(--terra));
        transform: scaleX(0); transform-origin: left;
        transition: transform .25s ease;
    }
    .kpi-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); }
    .kpi-card:hover::after { transform: scaleX(1); }

    .kpi-icon {
        width: 46px; height: 46px; border-radius: 13px;
        display: flex; align-items: center; justify-content: center;
        font-size: 18px; flex-shrink: 0;
        background: var(--beige);
        color: var(--bordeaux);
    }
    .kpi-icon.ic-blue   { background: #E8F4FB; color: var(--blue); }
    .kpi-icon.ic-terra  { background: #FBF0EA; color: var(--terra); }
    .kpi-icon.ic-gold   { background: #FBF5E8; color: var(--gold); }
    .kpi-icon.ic-bord   { background: var(--bordeaux); color: white; }

    .kpi-info { display: flex; flex-direction: column; }
    .kpi-value {
        font-size: 24px; font-weight: 800;
        color: var(--text-dark); line-height: 1.15;
    }
    .kpi-value small {
        font-size: 11px; font-weight: 700;
        color: var(--bordeaux); margin-left: 3px;
    }
    .kpi-label {
        font-size: 11px; color: var(--text-light);
        margin-top: 4px; font-weight: 600; letter-spacing: .2px;
    }

    /* ── Charts Grid ── */
    .charts-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }

    .chart-card {
        background: var(--white);
        border-radius: 18px;
        padding: 20px 22px 22px;
        box-shadow: var(--shadow);
        border: 1px solid var(--border);
        transition: box-shadow .22s;
    }
    .chart-card:hover { box-shadow: var(--shadow-lg); }

    .chart-head {
        display: flex; align-items: center; gap: 11px;
        margin-bottom: 18px; padding-bottom: 14px;
        border-bottom: 1.5px solid var(--beige2);
    }
    .chart-head-icon {
        width: 34px; height: 34px; border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 14px;
        background: var(--beige); color: var(--bordeaux);
    }
    .chart-head h4 {
        font-size: 13px; font-weight: 700;
        color: var(--text-dark); margin: 0;
    }
    .chart-head span {
        font-size: 10px; color: var(--text-light);
        margin-left: auto; font-weight: 600;
        background: var(--beige); padding: 3px 9px;
        border-radius: 20px;
    }
    .chart-container { height: 265px; position: relative; }

    @media (max-width: 1100px) {
        .kpi-grid    { grid-template-columns: repeat(2, 1fr); }
        .charts-grid { grid-template-columns: 1fr; }
        .dashboard-container { padding: 16px; }
    }
    @media (max-width: 600px) {
        .kpi-grid { grid-template-columns: 1fr; }
    }
</style>
{% endblock %}

{% block body %}
<div class="dashboard-container">

    <div class="dash-header">
        <h1>Dashboard</h1>
        <p>Aperçu global de votre activité — TunisiaJourney</p>
    </div>

    {# ══ KPI ══ #}
    <div class="section-label">Indicateurs clés</div>
    <div class="kpi-grid">

        <div class="kpi-card">
            <div class="kpi-icon ic-blue">
                <i class="fas fa-users"></i>
            </div>
            <div class="kpi-info">
                <div class="kpi-value">{{ stats.users }}</div>
                <div class="kpi-label">Utilisateurs inscrits</div>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon ic-terra">
                <i class="fas fa-calendar-alt"></i>
            </div>
            <div class="kpi-info">
                <div class="kpi-value">{{ stats.evenements }}</div>
                <div class="kpi-label">Événements organisés</div>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon ic-gold">
                <i class="fas fa-ticket-alt"></i>
            </div>
            <div class="kpi-info">
                <div class="kpi-value">{{ stats.reservations }}</div>
                <div class="kpi-label">Réservations voyages</div>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon ic-bord">
                <i class="fas fa-coins"></i>
            </div>
            <div class="kpi-info">
                <div class="kpi-value">{{ stats.revenue }}<small>DT</small></div>
                <div class="kpi-label">Chiffre d'affaires</div>
            </div>
        </div>

    </div>

    {# ══ Graphiques ══ #}
    <div class="section-label">Analyses détaillées</div>
    <div class="charts-grid">

        <div class="chart-card">
            <div class="chart-head">
                <div class="chart-head-icon"><i class="fas fa-chart-bar"></i></div>
                <h4>CA par programme</h4>
                <span>en DT</span>
            </div>
            <div class="chart-container">
                <canvas id="chartCaProgramme"></canvas>
            </div>
        </div>

        <div class="chart-card">
            <div class="chart-head">
                <div class="chart-head-icon"><i class="fas fa-chart-line"></i></div>
                <h4>Inscriptions mensuelles</h4>
                <span>utilisateurs</span>
            </div>
            <div class="chart-container">
                <canvas id="chartInscriptions"></canvas>
            </div>
        </div>

        <div class="chart-card">
            <div class="chart-head">
                <div class="chart-head-icon"><i class="fas fa-trophy"></i></div>
                <h4>Top événements</h4>
                <span>par réservations</span>
            </div>
            <div class="chart-container">
                <canvas id="chartTopEvenements"></canvas>
            </div>
        </div>

    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
const C = {
    bordeaux:  '#93032E',
    blue:      '#1A6B9A',
    terra:     '#C4531A',
    gold:      '#C9943A',
    teal:      '#2A8B7A',
    blueL:     '#2E8FC4',
    terraL:    '#E07840',
    white:     '#FFFFFF',
    grid:      '#F0E8DC',
    tick:      '#7A6A5A',
};

const PALETTE = [
    '#8B2635',   // bordeaux profond
    '#9B6A4A',   // brun chaud
    '#6B8F7A',   // sauge vert
    '#C4A27A',   // beige doré
    '#4A6B7F',   // bleu ardoise
    '#7A4A3A',   // brun foncé
    '#5A7A6A',   // sauge foncé
];

const tickFont = { size: 11, family: "'Segoe UI', sans-serif" };

// ── 1. CA par programme ───────────────────────────────────────────────────────
new Chart(document.getElementById('chartCaProgramme'), {
    type: 'bar',
    data: {
        labels: [{% for d in ca_par_programme %}'{{ d.label|slice(0,18)|e('js') }}'{% if not loop.last %},{% endif %}{% endfor %}],
        datasets: [{
            data: [{% for d in ca_par_programme %}{{ d.total }}{% if not loop.last %},{% endif %}{% endfor %}],
            backgroundColor: PALETTE,
            borderRadius: 8,
            barPercentage: 0.62
        }]
    },
    options: {
        responsive: true, maintainAspectRatio: false,
        plugins: {
            legend: { display: false },
            tooltip: { callbacks: { label: function(ctx) { return ' ' + ctx.raw.toLocaleString() + ' DT'; } } }
        },
        scales: {
            y: {
                beginAtZero: true, grid: { color: C.grid },
                ticks: { color: C.tick, font: tickFont, callback: function(v) { return v.toLocaleString(); } }
            },
            x: { grid: { display: false }, ticks: { color: C.tick, font: tickFont, maxRotation: 25 } }
        }
    }
});

// ── 2. Inscriptions mensuelles ────────────────────────────────────────────────
new Chart(document.getElementById('chartInscriptions'), {
    type: 'line',
    data: {
        labels: [{% for m in inscriptions_par_mois %}'{{ m.mois|e('js') }}'{% if not loop.last %},{% endif %}{% endfor %}],
        datasets: [{
            label: 'Inscriptions',
            data:  [{% for m in inscriptions_par_mois %}{{ m.count }}{% if not loop.last %},{% endif %}{% endfor %}],
            borderColor: PALETTE[0],
            backgroundColor: 'rgba(139,38,53,0.08)',
            borderWidth: 2.5,
            pointBackgroundColor: C.white,
            pointBorderColor: PALETTE[0],
            pointBorderWidth: 2.5,
            pointRadius: 5,
            pointHoverRadius: 7,
            tension: 0.42,
            fill: true
        }]
    },
    options: {
        responsive: true, maintainAspectRatio: false,
        plugins: {
            legend: { display: false },
            tooltip: { callbacks: { label: function(ctx) { return ' ' + ctx.raw + ' inscription(s)'; } } }
        },
        scales: {
            y: { beginAtZero: true, grid: { color: C.grid }, ticks: { color: C.tick, font: tickFont, stepSize: 1 } },
            x: { grid: { display: false }, ticks: { color: C.tick, font: tickFont } }
        }
    }
});

// ── 3. Top événements (pie avec % dans les tranches) ──────────────────────────
new Chart(document.getElementById('chartTopEvenements'), {
    type: 'pie',
    data: {
        labels: [{% for e in top_evenements %}'{{ e.label|slice(0,22)|e('js') }}'{% if not loop.last %},{% endif %}{% endfor %}],
        datasets: [{
            data:  [{% for e in top_evenements %}{{ e.count }}{% if not loop.last %},{% endif %}{% endfor %}],
            backgroundColor: PALETTE,
            borderColor: C.white,
            borderWidth: 3,
            hoverOffset: 8
        }]
    },
    options: {
        responsive: true, maintainAspectRatio: false,
        plugins: {
            legend: {
                position: 'bottom',
                labels: {
                    usePointStyle: true, padding: 12,
                    font: { size: 11 }, color: C.tick,
                    boxWidth: 9, boxHeight: 9
                }
            },
            tooltip: {
                callbacks: {
                    label: function(ctx) {
                        var total = ctx.dataset.data.reduce(function(a, b) { return a + b; }, 0);
                        var pct   = total > 0 ? Math.round(ctx.raw / total * 100) : 0;
                        return ' ' + ctx.label + ' : ' + ctx.raw + ' (' + pct + '%)';
                    }
                }
            }
        },
        animation: {
            onComplete: function() {
                var chart = this;
                var ctx   = chart.ctx;
                ctx.save();
                ctx.font         = 'bold 12px Segoe UI';
                ctx.fillStyle    = C.white;
                ctx.textAlign    = 'center';
                ctx.textBaseline = 'middle';
                var meta  = chart.getDatasetMeta(0);
                var total = chart.data.datasets[0].data.reduce(function(a, b) { return a + b; }, 0);
                meta.data.forEach(function(arc, i) {
                    var val = chart.data.datasets[0].data[i];
                    var pct = total > 0 ? Math.round(val / total * 100) : 0;
                    if (pct < 5) return;
                    var angle  = arc.startAngle + (arc.endAngle - arc.startAngle) / 2;
                    var radius = (arc.innerRadius + arc.outerRadius) / 2;
                    var x = arc.x + Math.cos(angle) * radius;
                    var y = arc.y + Math.sin(angle) * radius;
                    ctx.fillText(pct + '%', x, y);
                });
                ctx.restore();
            }
        }
    }
});
</script>
{% endblock %}