{% extends 'admin/base_admin.html.twig' %}

{% block title %}Dashboard{% endblock %}
{% block page_title %}Dashboard{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
    :root {
        --bordeaux: #93032E; --bordeaux2: #6B0220; --bordeaux-l: #B5294E;
        --blue: #1A6B9A; --blue-l: #2E8FC4;
        --terra: #C4531A; --terra-l: #E07840;
        --gold: #C9943A; --gold-l: #E8BC6E;
        --teal: #2A8B7A;
        --beige: #F4EDE4; --beige2: #E8DDD0; --cream: #FCF9F5;
        --text-dark: #2A241E; --text-mid: #6B5C52; --text-light: #9B8B7D;
        --white: #FFFFFF; --border: #E8E0D6;
        --shadow: 0 2px 12px rgba(0,0,0,0.05);
        --shadow-lg: 0 8px 30px rgba(0,0,0,0.09);
    }
    .dashboard-container { padding: 28px 28px 28px 20px; max-width: 100%; }
    .dash-header { margin-bottom: 30px; }
    .dash-header h1 { font-size: 24px; font-weight: 700; color: var(--text-dark); margin: 0; }
    .dash-header p { color: var(--text-light); margin-top: 5px; font-size: 13px; }
    .section-label {
        font-size: 10px; font-weight: 800; color: var(--text-light);
        text-transform: uppercase; letter-spacing: 1.4px;
        margin: 28px 0 14px; display: flex; align-items: center; gap: 10px;
    }
    .section-label::after { content: ''; flex: 1; height: 1px; background: var(--border); }

    /* KPI */
    .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
    .kpi-card {
        background: var(--white); border-radius: 16px; padding: 18px 20px;
        box-shadow: var(--shadow); border: 1px solid var(--border);
        display: flex; align-items: center; gap: 14px;
        transition: all .22s ease; position: relative; overflow: hidden;
    }
    .kpi-card::after {
        content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 3px;
        background: linear-gradient(90deg, var(--bordeaux), var(--terra));
        transform: scaleX(0); transform-origin: left; transition: transform .25s ease;
    }
    .kpi-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); }
    .kpi-card:hover::after { transform: scaleX(1); }
    .kpi-icon { width: 46px; height: 46px; border-radius: 13px; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; background: var(--beige); color: var(--bordeaux); }
    .kpi-icon.ic-blue  { background: #E8F4FB; color: var(--blue); }
    .kpi-icon.ic-terra { background: #FBF0EA; color: var(--terra); }
    .kpi-icon.ic-gold  { background: #FBF5E8; color: var(--gold); }
    .kpi-icon.ic-bord  { background: var(--bordeaux); color: white; }
    .kpi-icon.ic-teal  { background: #E8F5F2; color: var(--teal); }
    .kpi-icon.ic-green { background: #E8F5E9; color: #2E7D32; }
    .kpi-value { font-size: 24px; font-weight: 800; color: var(--text-dark); line-height: 1.15; }
    .kpi-value small { font-size: 11px; font-weight: 700; color: var(--bordeaux); margin-left: 3px; }
    .kpi-label { font-size: 11px; color: var(--text-light); margin-top: 4px; font-weight: 600; }

    /* Charts */
    .charts-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
    .chart-card {
        background: var(--white); border-radius: 18px; padding: 20px 22px 22px;
        box-shadow: var(--shadow); border: 1px solid var(--border); transition: box-shadow .22s;
    }
    .chart-card:hover { box-shadow: var(--shadow-lg); }
    .chart-card.full-width { grid-column: 1 / -1; }
    .chart-head {
        display: flex; align-items: center; gap: 11px;
        margin-bottom: 18px; padding-bottom: 14px;
        border-bottom: 1.5px solid var(--beige2);
    }
    .chart-head-icon { width: 34px; height: 34px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 14px; background: var(--beige); color: var(--bordeaux); }
    .chart-head-icon.ic-teal  { background: #E8F5F2; color: var(--teal); }
    .chart-head-icon.ic-gold  { background: #FBF5E8; color: var(--gold); }
    .chart-head h4 { font-size: 13px; font-weight: 700; color: var(--text-dark); margin: 0; }
    .chart-head span { font-size: 10px; color: var(--text-light); margin-left: auto; font-weight: 600; background: var(--beige); padding: 3px 9px; border-radius: 20px; }

    .chart-container { height: 265px; position: relative; }

    @media (max-width: 1100px) { .kpi-grid { grid-template-columns: repeat(2, 1fr); } .charts-grid { grid-template-columns: 1fr; } }
    @media (max-width: 600px)  { .kpi-grid { grid-template-columns: 1fr; } }
</style>
{% endblock %}

{% block body %}
<div class="dashboard-container">

    <div class="dash-header">
        <h1>Dashboard</h1>
        <p>Aperçu global de votre activité — TunisiaJourney</p>
    </div>

    {# ══ STATISTIQUES DU FORUM ══ #}
    <div class="section-label">Statistiques du Forum</div>
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon ic-gold"><i class="fas fa-chat-square-dots"></i></div>
            <div class="kpi-info">
                <div class="kpi-value">{{ totalForums|default(0) }}</div>
                <div class="kpi-label">Forums</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon ic-blue"><i class="fas fa-file-alt"></i></div>
            <div class="kpi-info">
                <div class="kpi-value">{{ totalPublications|default(0) }}</div>
                <div class="kpi-label">Publications</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon ic-terra"><i class="fas fa-comments"></i></div>
            <div class="kpi-info">
                <div class="kpi-value">{{ totalCommentaires|default(0) }}</div>
                <div class="kpi-label">Commentaires</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon ic-teal"><i class="fas fa-chart-line"></i></div>
            <div class="kpi-info">
                <div class="kpi-value">{{ avgParForum|default(0) }}</div>
                <div class="kpi-label">Moyenne/forum</div>
            </div>
        </div>
    </div>

    {# ══ KPI VOYAGES ══ #}
    <div class="section-label">Indicateurs voyages</div>
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon ic-blue"><i class="fas fa-users"></i></div>
            <div class="kpi-info">
                <div class="kpi-value">{{ stats.users|default(0) }}</div>
                <div class="kpi-label">Utilisateurs inscrits</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon ic-terra"><i class="fas fa-calendar-alt"></i></div>
            <div class="kpi-info">
                <div class="kpi-value">{{ stats.evenements|default(0) }}</div>
                <div class="kpi-label">Événements organisés</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon ic-gold"><i class="fas fa-ticket-alt"></i></div>
            <div class="kpi-info">
                <div class="kpi-value">{{ stats.reservations|default(0) }}</div>
                <div class="kpi-label">Réservations voyages</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon ic-bord"><i class="fas fa-coins"></i></div>
            <div class="kpi-info">
                <div class="kpi-value">{{ stats.revenue|default(0) }}<small>DT</small></div>
                <div class="kpi-label">CA voyages</div>
            </div>
        </div>
    </div>

    {# ══ KPI PRODUITS ══ #}
    <div class="section-label">Boutique & Commandes</div>
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon ic-teal"><i class="fas fa-box"></i></div>
            <div class="kpi-info">
                <div class="kpi-value">{{ stats.produits|default(0) }}</div>
                <div class="kpi-label">Produits en catalogue</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon ic-blue"><i class="fas fa-shopping-bag"></i></div>
            <div class="kpi-info">
                <div class="kpi-value">{{ stats.commandes|default(0) }}</div>
                <div class="kpi-label">Commandes reçues</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon ic-green"><i class="fas fa-cash-register"></i></div>
            <div class="kpi-info">
                <div class="kpi-value">{{ stats.revenue_produits|default(0) }}<small>DT</small></div>
                <div class="kpi-label">CA boutique</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon ic-gold"><i class="fas fa-star"></i></div>
            <div class="kpi-info">
               <div class="kpi-value">
                    {{ top_produits|first ? top_produits|first.label|slice(0,12) : '—' }}
                </div>
                <div class="kpi-label">Produit #1 vendu</div>
            </div>
        </div>
    </div>

    {# ══ ANALYSES DÉTAILLÉES (TOUS LES GRAPHIQUES) ══ #}
    <div class="section-label">Analyses détaillées</div>
    <div class="charts-grid">
        
        {# Graphique 1 : Évolution publications vs commentaires #}
        <div class="chart-card">
            <div class="chart-head">
                <div class="chart-head-icon ic-teal"><i class="fas fa-chart-line"></i></div>
                <h4>Évolution publications / commentaires</h4>
                <span>7 derniers jours</span>
            </div>
            <div class="chart-container"><canvas id="evolutionChart"></canvas></div>
        </div>

        {# Graphique 2 : CA par programme #}
        <div class="chart-card">
            <div class="chart-head">
                <div class="chart-head-icon"><i class="fas fa-chart-bar"></i></div>
                <h4>CA par programme</h4>
                <span>en DT</span>
            </div>
            <div class="chart-container"><canvas id="chartCaProgramme"></canvas></div>
        </div>

        {# Graphique 3 : Inscriptions mensuelles #}
        <div class="chart-card">
            <div class="chart-head">
                <div class="chart-head-icon"><i class="fas fa-chart-line"></i></div>
                <h4>Inscriptions mensuelles</h4>
                <span>utilisateurs</span>
            </div>
            <div class="chart-container"><canvas id="chartInscriptions"></canvas></div>
        </div>

        {# Graphique 4 : Top événements #}
        <div class="chart-card">
            <div class="chart-head">
                <div class="chart-head-icon ic-gold"><i class="fas fa-trophy"></i></div>
                <h4>Top événements</h4>
                <span>par réservations</span>
            </div>
            <div class="chart-container"><canvas id="chartTopEvenements"></canvas></div>
        </div>

        {# Graphique 5 : Commandes boutique / mois #}
        <div class="chart-card">
            <div class="chart-head">
                <div class="chart-head-icon ic-teal"><i class="fas fa-chart-area"></i></div>
                <h4>Commandes boutique / mois</h4>
                <span>commandes</span>
            </div>
            <div class="chart-container"><canvas id="chartCommandesMois"></canvas></div>
        </div>

        {# Graphique 6 : Top Hôtels #}
        <div class="chart-card">
            <div class="chart-head">
                <div class="chart-head-icon ic-blue"><i class="fas fa-hotel"></i></div>
                <h4>Top Hôtels</h4>
                <span>par réservations</span>
            </div>
            <div class="chart-container"><canvas id="chartTopHotels"></canvas></div>
        </div>

        {# Graphique 7 : Volume de ventes par produit #}
        <div class="chart-card">
            <div class="chart-head">
                <div class="chart-head-icon ic-terra"><i class="fas fa-boxes"></i></div>
                <h4>Volume de ventes par produit</h4>
                <span>unités commandées</span>
            </div>
            <div class="chart-container"><canvas id="chartTopProduits"></canvas></div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
const C = {
    bordeaux: '#93032E', blue: '#1A6B9A', terra: '#C4531A',
    gold: '#C9943A', teal: '#2A8B7A', white: '#FFFFFF',
    grid: '#F0E8DC', tick: '#7A6A5A',
};
const PALETTE = ['#8B2635','#9B6A4A','#6B8F7A','#C4A27A','#4A6B7F','#7A4A3A','#5A7A6A'];
const tickFont = { size: 11, family: "'Segoe UI', sans-serif" };

// ── GRAPHIQUE 1 : ÉVOLUTION PUBLICATIONS vs COMMENTAIRES ──
const evolutionPublications = {{ evolution_week|default([4, 6, 8, 5, 7, 9, 12])|json_encode|raw }};
const evolutionCommentaires = {{ evolution_week_comments|default([2, 3, 5, 4, 6, 8, 10])|json_encode|raw }};

new Chart(document.getElementById('evolutionChart'), {
    type: 'line',
    data: {
        labels: ['Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam', 'Dim'],
        datasets: [
            {
                label: 'Publications',
                data: evolutionPublications,
                borderColor: '#93032E',
                backgroundColor: 'rgba(147,3,46,0.05)',
                borderWidth: 2,
                tension: 0.4,
                fill: true,
                pointBackgroundColor: '#93032E',
                pointBorderColor: '#fff',
                pointRadius: 3,
                pointHoverRadius: 5
            },
            {
                label: 'Commentaires',
                data: evolutionCommentaires,
                borderColor: '#C9943A',
                backgroundColor: 'rgba(201,148,58,0.05)',
                borderWidth: 2,
                tension: 0.4,
                fill: true,
                pointBackgroundColor: '#C9943A',
                pointBorderColor: '#fff',
                pointRadius: 3,
                pointHoverRadius: 5
            }
        ]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { 
            legend: { 
                position: 'top',
                labels: { usePointStyle: true, boxWidth: 8, font: { size: 10, family: "'Inter', sans-serif" } }
            },
            tooltip: { bodyFont: { size: 11 } }
        },
        scales: {
            y: {
                beginAtZero: true,
                grid: { color: '#F0E8DD' },
                ticks: { color: '#7A6A5A', font: { size: 10 } }
            },
            x: { 
                grid: { display: false },
                ticks: { color: '#7A6A5A', font: { size: 10 } }
            }
        }
    }
});

// ── GRAPHIQUE 2 : CA par programme ──
new Chart(document.getElementById('chartCaProgramme'), {
    type: 'bar',
    data: {
        labels: [{% for d in ca_par_programme|default([]) %}'{{ d.label|slice(0,15)|e('js') }}'{% if not loop.last %},{% endif %}{% endfor %}],
        datasets: [{ data: [{% for d in ca_par_programme|default([]) %}{{ d.total }}{% if not loop.last %},{% endif %}{% endfor %}], backgroundColor: PALETTE, borderRadius: 8, barPercentage: 0.62 }]
    },
    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { bodyFont: { size: 11 } } }, scales: { y: { beginAtZero: true, grid: { color: C.grid }, ticks: { color: C.tick, font: { size: 10 } } }, x: { grid: { display: false }, ticks: { color: C.tick, font: { size: 10 }, maxRotation: 25 } } } }
});

// ── GRAPHIQUE 3 : Inscriptions ──
new Chart(document.getElementById('chartInscriptions'), {
    type: 'line',
    data: {
        labels: [{% for m in inscriptions_par_mois|default([]) %}'{{ m.mois|e('js') }}'{% if not loop.last %},{% endif %}{% endfor %}],
        datasets: [{ data: [{% for m in inscriptions_par_mois|default([]) %}{{ m.count }}{% if not loop.last %},{% endif %}{% endfor %}], borderColor: PALETTE[0], backgroundColor: 'rgba(139,38,53,0.08)', borderWidth: 2, pointBackgroundColor: C.white, pointBorderColor: PALETTE[0], pointBorderWidth: 2, pointRadius: 3, tension: 0.42, fill: true }]
    },
    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { bodyFont: { size: 11 } } }, scales: { y: { beginAtZero: true, grid: { color: C.grid }, ticks: { color: C.tick, font: { size: 10 }, stepSize: 1 } }, x: { grid: { display: false }, ticks: { color: C.tick, font: { size: 10 } } } } }
});

// ── GRAPHIQUE 4 : Top événements pie ──
new Chart(document.getElementById('chartTopEvenements'), {
    type: 'pie',
    data: {
        labels: [{% for e in top_evenements|default([]) %}'{{ e.label|slice(0,18)|e('js') }}'{% if not loop.last %},{% endif %}{% endfor %}],
        datasets: [{ data: [{% for e in top_evenements|default([]) %}{{ e.count }}{% if not loop.last %},{% endif %}{% endfor %}], backgroundColor: PALETTE, borderColor: C.white, borderWidth: 2 }]
    },
    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, padding: 10, font: { size: 10 }, color: C.tick } }, tooltip: { bodyFont: { size: 11 } } } }
});

// ── GRAPHIQUE 5 : Commandes par mois ──
new Chart(document.getElementById('chartCommandesMois'), {
    type: 'line',
    data: {
        labels: [{% for m in commandes_par_mois|default([]) %}'{{ m.mois|e('js') }}'{% if not loop.last %},{% endif %}{% endfor %}],
        datasets: [{ data: [{% for m in commandes_par_mois|default([]) %}{{ m.count }}{% if not loop.last %},{% endif %}{% endfor %}], borderColor: '#2A8B7A', backgroundColor: 'rgba(42,139,122,0.08)', borderWidth: 2, pointBackgroundColor: C.white, pointBorderColor: '#2A8B7A', pointBorderWidth: 2, pointRadius: 3, tension: 0.42, fill: true }]
    },
    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { bodyFont: { size: 11 } } }, scales: { y: { beginAtZero: true, grid: { color: C.grid }, ticks: { color: C.tick, font: { size: 10 }, stepSize: 1 } }, x: { grid: { display: false }, ticks: { color: C.tick, font: { size: 10 } } } } }
});

// ── GRAPHIQUE 6 : Top hôtels ──
new Chart(document.getElementById('chartTopHotels'), {
    type: 'bar',
    data: {
        labels: [{% for h in top_hotels|default([]) %}'{{ h.label|slice(0,15)|e('js') }}'{% if not loop.last %},{% endif %}{% endfor %}],
        datasets: [{
            label: 'Réservations',
            data: [{% for h in top_hotels|default([]) %}{{ h.total_reservations }}{% if not loop.last %},{% endif %}{% endfor %}],
            backgroundColor: PALETTE,
            borderRadius: 8,
            barPercentage: 0.62
        }]
    },
    options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false }, tooltip: { bodyFont: { size: 11 } } },
        scales: {
            y: { beginAtZero: true, grid: { color: C.grid }, ticks: { color: C.tick, font: { size: 10 }, stepSize: 1 } },
            x: { grid: { display: false }, ticks: { color: C.tick, font: { size: 10 }, maxRotation: 25 } }
        }
    }
});

// ── GRAPHIQUE 7 : Top produits barres horizontales ──
new Chart(document.getElementById('chartTopProduits'), {
    type: 'bar',
    data: {
        labels: [{% for p in top_produits|default([]) %}'{{ p.label|slice(0,15)|e('js') }}'{% if not loop.last %},{% endif %}{% endfor %}],
        datasets: [{
            label: 'Unités',
            data: [{% for p in top_produits|default([]) %}{{ p.total_commande }}{% if not loop.last %},{% endif %}{% endfor %}],
            backgroundColor: PALETTE,
            borderRadius: 8,
            barPercentage: 0.55
        }]
    },
    options: {
        indexAxis: 'y',
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false }, tooltip: { bodyFont: { size: 11 } } },
        scales: {
            x: { beginAtZero: true, grid: { color: C.grid }, ticks: { color: C.tick, font: { size: 10 } } },
            y: { grid: { display: false }, ticks: { color: C.tick, font: { size: 10 } } }
        }
    }
});
</script>
{% endblock %}