{% extends 'admin/dashboard/base_admin.html.twig' %}

{% block title %}Nouvelle Publication{% endblock %}
{% block page_title %}Créer une nouvelle publication{% endblock %}

{% block body %}
<div class="row">
    <div class="col-md-8">
        <div class="form-card">
            <h5 class="form-title">Créer une publication</h5>
            <p class="form-subtitle">Ajoutez une nouvelle publication au forum</p>

            {# SECTION IA INTELLIGENTE #}
            <div class="form-group ai-section">
                <div class="ai-header-badge">
                    <i class="fas fa-brain me-1"></i> IA Contextuelle
                </div>
                
                <label class="form-label ai-label">
                    <span>Génération intelligente par ville</span>
                    <span class="ai-subtitle">L'IA analyse la ville et recherche des images/vidéos spécifiques</span>
                </label>
                
                <div class="ai-search-container">
                    <div class="input-group-custom ai-input-group">
                        <i class="fas fa-map-marker-alt" style="color: #3B82F6;"></i>
                        <input type="text" 
                               id="aiSearchInput" 
                               class="form-control" 
                               placeholder="Ex: Djerba, Tozeur, Sidi Bou Said..." 
                               onkeypress="if(event.key==='Enter'){event.preventDefault(); generateWithAI();}">
                        <button type="button" onclick="generateWithAI()" class="btn-submit ai-generate-btn" id="btnGenerate">
                            <i class="fas fa-magic me-2"></i>Analyser & Générer
                        </button>
                    </div>
                </div>
                
                <div class="ai-loading" id="aiLoading" style="display: none;">
                    <div class="spinner-border text-primary" role="status"></div>
                    <div>
                        <strong>Analyse IA en cours...</strong><br>
                        <small id="loadingDetail">Recherche de médias authentiques</small>
                    </div>
                </div>
                
                <div class="ai-results" id="aiResults" style="display: none;">
                    <div class="ai-results-header">
                        <div>
                            <h6><i class="fas fa-robot me-2"></i>Suggestions IA pour <span id="resultVille"></span></h6>
                            <span id="contextIA" class="badge bg-info"></span>
                        </div>
                        <button type="button" onclick="closeAIResults()" class="btn-close-ai">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    <div id="aiSuggestionsList"></div>
                </div>
            </div>

            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'id': 'pub-form'}}) }}

                {# TITRE #}
                <div class="form-group">
                    <label class="form-label">Titre <span class="required">*</span></label>
                    <div class="input-group-custom">
                        <i class="fas fa-heading"></i>
                        {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Titre de la publication...'}}) }}
                    </div>
                </div>

                {# DESCRIPTION #}
                <div class="form-group">
                    <label class="form-label">Description <span class="optional">(optionnel)</span></label>
                    <div class="input-group-custom textarea-wrap">
                        <i class="fas fa-align-left" style="align-self:flex-start;padding-top:14px;"></i>
                        {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': '4', 'placeholder': 'Description...'}}) }}
                    </div>
                </div>

                {# IMAGE AVEC IA #}
                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-image me-2" style="color:#3B82F6;"></i>Image
                    </label>
                    
                    <div class="source-tabs">
                        <button type="button" id="img-tab-upload" onclick="switchSource('image','upload')" class="source-tab active">
                            <i class="fas fa-upload me-1"></i> Upload
                        </button>
                        <button type="button" id="img-tab-url" onclick="switchSource('image','url')" class="source-tab">
                            <i class="fas fa-robot me-1"></i> IA (Auto)
                        </button>
                    </div>

                    <div id="img-upload-panel">
                        <input type="file" id="imgFileInput" name="publication_image_file" accept="image/*" 
                               style="display:none;" onchange="onFileChosen(this,'image')">
                        <label for="imgFileInput" class="dropzone-label">
                            <div class="upload-icon">🖼️</div>
                            <div class="upload-text">Cliquez ou glissez une image</div>
                        </label>
                    </div>

                    <div id="img-url-panel" style="display:none;">
                        <div class="url-input-group">
                            <input type="text" id="imgUrlInput" class="url-input" placeholder="URL de l'image (générée par l'IA)">
                            <button type="button" onclick="applyImageUrl()" class="btn-apply">Charger</button>
                        </div>
                        <div id="img-url-preview" style="display:none; margin-top:10px;">
                            <img id="img-url-thumb" src="" style="max-height:100px; border-radius:6px;">
                            <button type="button" onclick="clearImageUrl()" class="btn-remove-small" style="margin-left:10px;">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                    <input type="hidden" id="imageUrlHidden" name="image_url" value="">
                </div>

                {# VIDEO AVEC IA #}
                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-video me-2" style="color:#93032E;"></i>Vidéo
                    </label>
                    
                    <div class="source-tabs">
                        <button type="button" id="vid-tab-upload" onclick="switchSource('video','upload')" class="source-tab active">
                            <i class="fas fa-upload me-1"></i> Upload
                        </button>
                        <button type="button" id="vid-tab-url" onclick="switchSource('video','url')" class="source-tab">
                            <i class="fab fa-youtube me-1"></i> YouTube (IA)
                        </button>
                    </div>

                    <div id="vid-upload-panel">
                        <input type="file" id="videoFileInput" name="publication_video_file" accept="video/*"
                               style="display:none;" onchange="onFileChosen(this,'video')">
                        <label for="videoFileInput" class="dropzone-label dropzone-video">
                            <div class="upload-icon">🎬</div>
                            <div class="upload-text">Cliquez ou glissez une vidéo</div>
                        </label>
                    </div>

                    <div id="vid-url-panel" style="display:none;">
                        <div class="url-input-group">
                            <input type="text" id="vidUrlInput" class="url-input" placeholder="https://www.youtube.com/embed/...">
                            <button type="button" onclick="applyVideoUrl()" class="btn-apply">Vérifier</button>
                        </div>
                        <div id="vid-url-preview" style="display:none; margin-top:10px; padding:10px; background:#f8f9fa; border-radius:8px;">
                            <div id="vid-embed-container" style="margin-bottom:10px;"></div>
                            <button type="button" onclick="clearVideoUrl()" class="btn-remove-small">
                                <i class="fas fa-trash"></i> Supprimer
                            </button>
                        </div>
                    </div>
                    <input type="hidden" id="videoUrlHidden" name="video_url" value="">
                </div>

                {# FORUM #}
                <div class="form-group">
                    <label class="form-label">Forum <span class="required">*</span></label>
                    <div class="input-group-custom">
                        <i class="fas fa-comments"></i>
                        {{ form_widget(form.forum, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </div>

                <div class="form-actions">
                    <a href="{{ path('app_publication_index') }}" class="btn-outline-action">
                        <i class="fas fa-arrow-left me-2"></i>Annuler
                    </a>
                    <button type="submit" class="btn-submit">
                        <i class="fas fa-save me-2"></i>Publier
                    </button>
                </div>

            {{ form_end(form) }}
        </div>
    </div>

    {# APERCU #}
    <div class="col-md-4">
        <div class="preview-card">
            <h5 class="preview-title"><i class="fas fa-eye me-2"></i>Aperçu</h5>
            
            <div class="preview-box" id="previewImgBox">
                <img id="previewImg" src="" style="display:none; max-width:100%; max-height:150px; border-radius:8px;" onerror="this.style.display='none'; document.getElementById('previewImgPlaceholder').style.display='block'">
                <div id="previewImgPlaceholder" style="text-align:center; color:#94a3b8;">
                    <div style="font-size:40px;">🖼️</div>
                    <div>Aucune image</div>
                </div>
            </div>
            
            <div class="preview-box" style="margin-top:16px;" id="previewVidBox">
                <div id="previewVidContainer" style="display:none;">
                    <iframe id="previewVidIframe" width="100%" height="150" frameborder="0" allowfullscreen style="border-radius:8px;"></iframe>
                </div>
                <div id="previewVidPlaceholder" style="text-align:center; color:#94a3b8;">
                    <div style="font-size:40px;">🎬</div>
                    <div>Aucune vidéo</div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* Styles */
.ai-section { background: linear-gradient(135deg, #eff6ff 0%, #f0fdf4 100%); border: 2px dashed #3b82f6; border-radius: 12px; padding: 24px; position: relative; margin-bottom: 24px; }
.ai-header-badge { position: absolute; top: -12px; left: 16px; background: linear-gradient(135deg, #3b82f6, #8b5cf6); color: white; padding: 4px 16px; border-radius: 20px; font-size: 0.8rem; font-weight: 700; box-shadow: 0 4px 6px -1px rgba(59, 130, 246, 0.2); }
.ai-label { color: #1e40af; font-weight: 700; margin-bottom: 8px; display: block; }
.ai-subtitle { font-size: 0.85rem; color: #64748b; display: block; margin-top: 4px; font-weight: 500; }
.ai-input-group { background: white; border-color: #3b82f6; }
.ai-generate-btn { background: linear-gradient(135deg, #3b82f6, #8b5cf6) !important; border-radius: 0 8px 8px 0 !important; border: none !important; }
.ai-loading { display: flex; align-items: center; gap: 16px; padding: 20px; background: rgba(255,255,255,0.8); border-radius: 8px; margin-top: 16px; }
.ai-results { margin-top: 20px; animation: fadeIn 0.4s ease; }
.ai-results-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid #e2e8f0; }
.ai-results-header h6 { margin: 0; font-weight: 700; color: #1e293b; }
.suggestion-card { background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; margin-bottom: 12px; cursor: pointer; transition: all 0.3s ease; display: flex; gap: 16px; align-items: flex-start; }
.suggestion-card:hover { transform: translateY(-2px); box-shadow: 0 10px 25px -5px rgba(59, 130, 246, 0.2); border-color: #3b82f6; }
.suggestion-img-container { width: 120px; height: 90px; flex-shrink: 0; position: relative; border-radius: 8px; overflow: hidden; background: #f1f5f9; }
.suggestion-img { width: 100%; height: 100%; object-fit: cover; }
.suggestion-video-indicator { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: rgba(147, 3, 46, 0.9); color: white; width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; }
.suggestion-content { flex: 1; }
.suggestion-title { font-weight: 700; color: #1e293b; margin-bottom: 6px; font-size: 1.05rem; }
.suggestion-desc { color: #64748b; font-size: 0.9rem; line-height: 1.4; margin-bottom: 8px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.suggestion-tags { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 8px; }
.tag { background: #dbeafe; color: #1e40af; font-size: 0.75rem; padding: 2px 8px; border-radius: 12px; font-weight: 600; }
.suggestion-source { font-size: 0.75rem; color: #059669; font-weight: 500; display: flex; align-items: center; gap: 4px; }
.btn-use { background: linear-gradient(135deg, #93032e, #be123c); color: white; border: none; padding: 8px 16px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; cursor: pointer; align-self: center; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }

/* Standard styles */
.form-card { background: white; border-radius: 16px; padding: 24px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); }
.form-title { font-size: 1.5rem; font-weight: 700; color: #1e293b; margin-bottom: 8px; }
.form-subtitle { color: #64748b; margin-bottom: 24px; font-size: 0.9rem; }
.form-group { margin-bottom: 20px; }
.form-label { font-size: 0.9rem; font-weight: 600; color: #374151; margin-bottom: 6px; display: block; }
.required { color: #ef4444; }
.input-group-custom { display: flex; align-items: center; background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 10px; transition: all 0.2s; }
.input-group-custom:focus-within { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.1); }
.input-group-custom > i:first-child { padding: 12px 0 12px 14px; color: #94a3b8; }
.input-group-custom .form-control { border: none; background: transparent; padding: 12px; font-size: 0.9rem; width: 100%; outline: none; }
.textarea-wrap { align-items: flex-start; }
.source-tabs { display: flex; gap: 8px; margin-bottom: 12px; }
.source-tab { flex: 1; padding: 10px; border-radius: 8px; border: 1px solid #e2e8f0; background: #f8fafc; color: #64748b; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: all 0.2s; }
.source-tab.active { background: #3b82f6; border-color: #3b82f6; color: white; }
.dropzone-label { display: block; border: 2px dashed #cbd5e1; border-radius: 12px; padding: 32px 20px; text-align: center; cursor: pointer; transition: all 0.2s; background: #f8fafc; }
.dropzone-label:hover { border-color: #3b82f6; background: #eff6ff; }
.dropzone-video { background: #fef2f2; border-color: #fecaca; }
.dropzone-video:hover { border-color: #ef4444; background: #fee2e2; }
.upload-icon { font-size: 36px; margin-bottom: 8px; opacity: 0.6; }
.upload-text { font-size: 0.95rem; color: #475569; font-weight: 500; }
.url-input-group { display: flex; gap: 8px; }
.url-input { flex: 1; padding: 10px 12px; border: 1.5px solid #e2e8f0; border-radius: 8px; font-size: 0.9rem; outline: none; }
.url-input:focus { border-color: #3b82f6; }
.btn-apply { padding: 10px 18px; background: #3b82f6; color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 0.85rem; }
.btn-remove-small { background: #fee2e2; color: #dc2626; border: none; padding: 6px 12px; border-radius: 6px; font-size: 0.8rem; font-weight: 600; cursor: pointer; }
.form-actions { display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px; padding-top: 20px; border-top: 1px solid #e2e8f0; }
.btn-submit { background: #93032e; color: white; border: none; padding: 12px 24px; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 0.9rem; }
.btn-outline-action { color: #64748b; text-decoration: none; padding: 12px 20px; border: 1px solid #e2e8f0; border-radius: 8px; font-weight: 500; display: flex; align-items: center; }
.preview-card { background: white; border-radius: 12px; padding: 20px; border: 1px solid #e2e8f0; }
.preview-title { font-size: 1rem; font-weight: 700; color: #1e293b; margin-bottom: 12px; }
.preview-box { background: #f8fafc; border: 2px dashed #e2e8f0; border-radius: 10px; padding: 20px; min-height: 150px; display: flex; align-items: center; justify-content: center; margin-bottom: 16px; }
</style>

<script>
let currentSuggestions = [];

async function generateWithAI() {
    const input = document.getElementById('aiSearchInput');
    const ville = input.value.trim();
    
    if (!ville) {
        alert('Veuillez entrer une ville tunisienne');
        return;
    }
    
    document.getElementById('aiLoading').style.display = 'flex';
    document.getElementById('aiResults').style.display = 'none';
    document.getElementById('loadingDetail').textContent = `Analyse de "${ville}" et recherche de médias...`;
    
    try {
        const response = await fetch('{{ path('api_ai_generate_content') }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ville: ville })
        });
        
        if (!response.ok) throw new Error('Erreur serveur');
        
        const data = await response.json();
        
        if (data.suggestions && data.suggestions.length > 0) {
            currentSuggestions = data.suggestions;
            displayResults(data.suggestions, ville);
        } else {
            throw new Error('Pas de données');
        }
    } catch (error) {
        console.error(error);
        alert('Erreur: Assurez-vous qu\'Ollama est lancé (ollama serve)');
    } finally {
        document.getElementById('aiLoading').style.display = 'none';
    }
}

function displayResults(suggestions, ville) {
    document.getElementById('resultVille').textContent = ville;
    
    // Afficher contexte IA si disponible
    const context = suggestions[0]?.contexte_ia || 'Génération automatique';
    document.getElementById('contextIA').textContent = context;
    
    const container = document.getElementById('aiSuggestionsList');
    container.innerHTML = '';
    
    suggestions.forEach((sugg, index) => {
        const card = document.createElement('div');
        card.className = 'suggestion-card';
        card.onclick = () => applySuggestion(index);
        
        // Indicateur vidéo si présente
        const videoBadge = sugg.video_url ? 
            `<div class="suggestion-video-indicator"><i class="fas fa-play"></i></div>` : '';
        
        card.innerHTML = `
            <div class="suggestion-img-container">
                <img src="${sugg.image_url}" class="suggestion-img" alt="${ville}" 
                     onerror="this.src='https://placehold.co/120x90?text=${ville}'">
                ${videoBadge}
            </div>
            <div class="suggestion-content">
                <div class="suggestion-title">${sugg.titre}</div>
                <div class="suggestion-desc">${sugg.description}</div>
                <div class="suggestion-tags">
                    ${sugg.tags.map(t => `<span class="tag">#${t}</span>`).join('')}
                </div>
                <div class="suggestion-source">
                    <i class="fas fa-check-circle"></i> Images contextuelles IA
                </div>
            </div>
            <button type="button" class="btn-use" onclick="event.stopPropagation(); applySuggestion(${index})">
                Utiliser
            </button>
        `;
        
        container.appendChild(card);
    });
    
    document.getElementById('aiResults').style.display = 'block';
}

function applySuggestion(index) {
    const sugg = currentSuggestions[index];
    if (!sugg) return;
    
    // Remplir texte
    document.querySelector('input[name$="[nom]"]').value = sugg.titre;
    document.querySelector('textarea[name$="[description]"]').value = sugg.description;
    
    // Image - Mode URL
    if (sugg.image_url) {
        switchSource('image', 'url');
        setTimeout(() => {
            document.getElementById('imgUrlInput').value = sugg.image_url;
            applyImageUrl();
        }, 100);
    }
    
    // Vidéo si présente
    if (sugg.video_url) {
        switchSource('video', 'url');
        setTimeout(() => {
            document.getElementById('vidUrlInput').value = sugg.video_url;
            applyVideoUrl();
        }, 100);
    }
    
    closeAIResults();
}

function closeAIResults() {
    document.getElementById('aiResults').style.display = 'none';
}

// Gestion des sources
function switchSource(type, source) {
    const isUpload = source === 'upload';
    const pfx = type === 'image' ? 'img' : 'vid';
    
    document.getElementById(pfx + '-upload-panel').style.display = isUpload ? 'block' : 'none';
    document.getElementById(pfx + '-url-panel').style.display = isUpload ? 'none' : 'block';
    
    document.getElementById(pfx + '-tab-upload').classList.toggle('active', isUpload);
    document.getElementById(pfx + '-tab-url').classList.toggle('active', !isUpload);
    
    if (isUpload) {
        if (type === 'image') {
            document.getElementById('imgFileInput').value = '';
            document.getElementById('img-url-preview').style.display = 'none';
        } else {
            document.getElementById('videoFileInput').value = '';
            document.getElementById('vid-url-preview').style.display = 'none';
        }
    }
}

function onFileChosen(input, type) {
    if (!input.files || !input.files[0]) return;
    const file = input.files[0];
    
    if (type === 'image') {
        const reader = new FileReader();
        reader.onload = (e) => {
            document.getElementById('previewImg').src = e.target.result;
            document.getElementById('previewImg').style.display = 'block';
            document.getElementById('previewImgPlaceholder').style.display = 'none';
        };
        reader.readAsDataURL(file);
    } else {
        const reader = new FileReader();
        reader.onload = (e) => {
            document.getElementById('previewVidFile').src = e.target.result;
            document.getElementById('previewVidFile').style.display = 'block';
            document.getElementById('previewVidContainer').style.display = 'none';
            document.getElementById('previewVidPlaceholder').style.display = 'none';
        };
        reader.readAsDataURL(file);
    }
}
function applyImageUrl() {
    const url = document.getElementById('imgUrlInput').value.trim();
    if (!url) return;
    
    document.getElementById('imageUrlHidden').value = url;
    document.getElementById('img-url-thumb').src = url;
    document.getElementById('img-url-preview').style.display = 'block';
    
    // Aperçu avec gestion d'erreur
    const img = document.getElementById('previewImg');
    img.src = url;
    img.style.display = 'block';
    img.onerror = function() {
        this.style.display = 'none';
        document.getElementById('previewImgPlaceholder').innerHTML = `
            <div style="color: #dc2626; text-align: center;">
                <i class="fas fa-exclamation-triangle" style="font-size: 24px; margin-bottom: 8px;"></i>
                <div>Image non disponible</div>
            </div>
        `;
        document.getElementById('previewImgPlaceholder').style.display = 'flex';
    };
    img.onload = function() {
        document.getElementById('previewImgPlaceholder').style.display = 'none';
    };
}

function clearImageUrl() {
    document.getElementById('imgUrlInput').value = '';
    document.getElementById('img-url-preview').style.display = 'none';
    document.getElementById('imageUrlHidden').value = '';
    document.getElementById('previewImg').style.display = 'none';
    document.getElementById('previewImgPlaceholder').innerHTML = `
        <div style="font-size:40px; opacity:0.3;">🖼️</div>
        <div>Aucune image</div>
    `;
    document.getElementById('previewImgPlaceholder').style.display = 'block';
}

function applyVideoUrl() {
    let url = document.getElementById('vidUrlInput').value.trim();
    if (!url) return;
    
    // Conversion automatique des URLs YouTube standard vers embed
    if (url.includes('watch?v=')) {
        const videoId = url.split('v=')[1].split('&')[0];
        url = `https://www.youtube.com/embed/${videoId}`;
    } else if (url.includes('youtu.be/')) {
        const videoId = url.split('youtu.be/')[1].split('?')[0];
        url = `https://www.youtube.com/embed/${videoId}`;
    }
    
    // Vérifier que c'est bien une URL embed
    if (!url.includes('embed')) {
        alert('Veuillez entrer une URL YouTube valide (format embed ou watch)');
        return;
    }
    
    document.getElementById('videoUrlHidden').value = url;
    document.getElementById('vid-embed-container').innerHTML = `
        <iframe width="100%" height="160" src="${url}" frameborder="0" allowfullscreen 
                style="border-radius: 8px;"></iframe>
    `;
    document.getElementById('vid-url-preview').style.display = 'block';
    
    // Mise à jour de l'aperçu
    document.getElementById('previewVidIframe').src = url;
    document.getElementById('previewVidContainer').style.display = 'block';
    document.getElementById('previewVidPlaceholder').style.display = 'none';
    document.getElementById('previewVidFile').style.display = 'none';
}

function clearVideoUrl() {
    document.getElementById('vidUrlInput').value = '';
    document.getElementById('vid-url-preview').style.display = 'none';
    document.getElementById('vid-embed-container').innerHTML = '';
    document.getElementById('videoUrlHidden').value = '';
    document.getElementById('previewVidContainer').style.display = 'none';
    document.getElementById('previewVidFile').style.display = 'none';
    document.getElementById('previewVidIframe').src = '';
    document.getElementById('previewVidPlaceholder').style.display = 'block';
}

// Drag & Drop support
function setupDz(dzId, inputId) {
    const dz = document.getElementById(dzId);
    const input = document.getElementById(inputId);
    if (!dz || !input) return;
    
    ['dragenter', 'dragover'].forEach(eventName => {
        dz.addEventListener(eventName, (e) => {
            e.preventDefault();
            dz.style.borderColor = '#3b82f6';
            dz.style.background = '#eff6ff';
        });
    });
    
    dz.addEventListener('dragleave', () => {
        dz.style.borderColor = '';
        dz.style.background = '';
    });
    
    dz.addEventListener('drop', (e) => {
        e.preventDefault();
        dz.style.borderColor = '';
        dz.style.background = '';
        
        const files = e.dataTransfer.files;
        if (files.length) {
            input.files = files;
            // Déclencher l'événement change manuellement
            const event = new Event('change', { bubbles: true });
            input.dispatchEvent(event);
        }
    });
}

// Initialisation
document.addEventListener('DOMContentLoaded', function() {
    setupDz('dropzone-img', 'imgFileInput');
    setupDz('dropzone-vid', 'videoFileInput');
});
</script>
{% endblock %}
