.vid-url-preview{margin-top:12px;padding:14px;background:#FFF5F0;border-radius:12px;border:1px solid #F5CAC3}
.btn-remove{background:#FDE8E8;color:#c0392b;border:none;border-radius:8px;padding:7px 14px;font-size:.78rem;font-weight:600;cursor:pointer}
.btn-remove:hover{background:#c0392b;color:white}
.btn-remove-small{background:#FDE8E8;color:#c0392b;border:none;border-radius:6px;padding:3px 10px;font-size:.72rem;font-weight:600;cursor:pointer}
