.btn-submit{background:#93032E;border:none;padding:11px 26px;border-radius:40px;font-size:.88rem;font-weight:600;color:white;cursor:pointer;transition:all .2s;display:inline-flex;align-items:center}
.btn-submit:hover{background:#6B0221;transform:translateY(-2px);box-shadow:0 4px 14px rgba(147,3,46,.3)}
.btn-outline-action{background:transparent;border:1.5px solid #E8DFD1;padding:11px 22px;border-radius:40px;font-size:.88rem;font-weight:500;color:#4A3B2F;text-decoration:none;display:inline-flex;align-items:center;transition:all .2s}
.btn-outline-action:hover{border-color:#93032E;color:#93032E;background:#FFF9F0}
.preview-card{background:white;border-radius:20px;padding:20px;border:1px solid #F0E8DD;box-shadow:0 4px 12px rgba(0,0,0,.04)}
.preview-title{font-size:.95rem;font-weight:700;color:#2C1810;margin-bottom:14px;display:flex;align-items:center}
.preview-box{background:#FEF9F0;border:2px dashed #E8DFD1;border-radius:14px;padding:18px;min-height:140px;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden}
</style>

<script>
// ── SOURCE IMAGE ──────────────────────────────────────────
function switchSource(type, source) {
    var isUpload = source === 'upload';
    var pfx = type === 'image' ? 'img' : 'vid';
    document.getElementById(pfx+'-upload-panel').style.display = isUpload ? 'block' : 'none';
    document.getElementById(pfx+'-url-panel').style.display    = isUpload ? 'none'  : 'block';
    document.getElementById(pfx+'-tab-upload').classList.toggle('active', isUpload);
    document.getElementById(pfx+'-tab-url').classList.toggle('active', !isUpload);
    if (isUpload) { if (type==='image') clearImageUrl(); else clearVideoUrl(); }
    else          { clearFile(type); }
}

// ── FICHIER ────────────────────────────────────────────────
function onFileChosen(input, type) {
    if (input.files && input.files[0]) processFile(input.files[0], type);
}

function processFile(file, type) {
    var isImage = type === 'image';
    var maxMb   = isImage ? 5 : 50;
    if (file.size > maxMb * 1024 * 1024) { alert('Fichier trop grand ! Max '+maxMb+' Mo.'); clearFile(type); return; }
    var reader = new FileReader();
    reader.onload = function(e) {
        if (isImage) {
            document.getElementById('img-preview-thumb').src = e.target.result;
            document.getElementById('img-preview-name').textContent = '📁 '+file.name;
            document.getElementById('img-upload-ph').style.display = 'none';
            document.getElementById('img-upload-preview').style.display = 'block';
            document.getElementById('img-upload-actions').style.display = 'block';
            document.getElementById('imageUrlHidden').value = '';
            // Aperçu
            document.getElementById('previewImg').src = e.target.result;
            document.getElementById('previewImg').style.display = 'block';
            document.getElementById('previewImgPH').style.display = 'none';
        } else {
            document.getElementById('vid-preview-thumb').src = e.target.result;
            document.getElementById('vid-preview-name').textContent = '🎬 '+file.name;
            document.getElementById('vid-upload-ph').style.display = 'none';
            document.getElementById('vid-upload-preview').style.display = 'block';
            document.getElementById('vid-upload-actions').style.display = 'block';
            document.getElementById('videoUrlHidden').value = '';
            // Aperçu
            document.getElementById('previewVid').src = e.target.result;
            document.getElementById('previewVid').style.display = 'block';
            document.getElementById('previewVidPH').style.display = 'none';
        }
    };
    reader.readAsDataURL(file);
}

function clearFile(type) {
    if (type === 'image') {
        var fi = document.getElementById('imgFileInput'); if(fi) fi.value='';
        document.getElementById('img-upload-ph').style.display = 'block';
        document.getElementById('img-upload-preview').style.display = 'none';
        document.getElementById('img-upload-actions').style.display = 'none';
        document.getElementById('previewImg').style.display = 'none';
        document.getElementById('previewImg').src = '';
        document.getElementById('previewImgPH').style.display = 'block';
    } else {
        var fv = document.getElementById('videoFileInput'); if(fv) fv.value='';
        document.getElementById('vid-upload-ph').style.display = 'block';
        document.getElementById('vid-upload-preview').style.display = 'none';
        document.getElementById('vid-upload-actions').style.display = 'none';
        var pv = document.getElementById('vid-preview-thumb'); if(pv) pv.src='';
        document.getElementById('previewVid').style.display = 'none';
        document.getElementById('previewVidPH').style.display = 'block';
    }
}

// ── URL IMAGE ──────────────────────────────────────────────
function applyImageUrl() {
    var url = document.getElementById('imgUrlInput').value.trim();
    if (!url) { alert('Entrez une URL.'); return; }
    var img = new Image();
    img.onload = function() {
        document.getElementById('img-url-thumb').src = url;
        document.getElementById('img-url-link').textContent = url.slice(0,50);
        document.getElementById('img-url-preview').style.display = 'flex';
        document.getElementById('imageUrlHidden').value = url;
        var fi = document.getElementById('imgFileInput'); if(fi) fi.value='';
        document.getElementById('previewImg').src = url;
        document.getElementById('previewImg').style.display = 'block';
        document.getElementById('previewImgPH').style.display = 'none';
    };
    img.onerror = function() { alert('❌ URL image invalide.'); };
    img.src = url;
}

function clearImageUrl() {
    var i = document.getElementById('imgUrlInput'); if(i) i.value='';
    document.getElementById('img-url-preview').style.display = 'none';
    document.getElementById('imageUrlHidden').value = '';
    document.getElementById('previewImg').style.display = 'none';
    document.getElementById('previewImgPH').style.display = 'block';
}

// ── URL VIDÉO ──────────────────────────────────────────────
function applyVideoUrl() {
    var url = document.getElementById('vidUrlInput').value.trim();
    if (!url) { alert('Entrez une URL.'); return; }
    var html = buildVideoEmbed(url);
    if (!html) { alert('❌ URL vidéo non reconnue.'); return; }
    document.getElementById('vid-url-embed-container').innerHTML = html;
    document.getElementById('vid-url-link').textContent = url.slice(0,50);
    document.getElementById('vid-url-preview').style.display = 'block';
    document.getElementById('videoUrlHidden').value = url;
    var fv = document.getElementById('videoFileInput'); if(fv) fv.value='';
    document.getElementById('previewVidEmbed').innerHTML = buildVideoEmbed(url) || '';
    document.getElementById('previewVidEmbed').style.display = 'block';
    document.getElementById('previewVidPH').style.display = 'none';
}

function clearVideoUrl() {
    var v = document.getElementById('vidUrlInput'); if(v) v.value='';
    document.getElementById('vid-url-preview').style.display = 'none';
    document.getElementById('vid-url-embed-container').innerHTML = '';
    document.getElementById('videoUrlHidden').value = '';
    document.getElementById('previewVidEmbed').style.display = 'none';
    document.getElementById('previewVidEmbed').innerHTML = '';
    document.getElementById('previewVidPH').style.display = 'block';
}

function buildVideoEmbed(url) {
    var yt = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
    if (yt) return '<iframe width="100%" height="160" src="https://www.youtube.com/embed/'+yt[1]+'" frameborder="0" allowfullscreen style="border-radius:8px;"></iframe>';
    var vm = url.match(/vimeo\.com\/(\d+)/);
    if (vm) return '<iframe width="100%" height="160" src="https://player.vimeo.com/video/'+vm[1]+'" frameborder="0" allowfullscreen style="border-radius:8px;"></iframe>';
    if (/\.(mp4|webm|ogg|mov)(\?.*)?$/i.test(url)) return '<video src="'+url+'" controls style="width:100%;max-height:160px;border-radius:8px;"></video>';
    return null;
}

// ── DRAG & DROP ────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', function() {
    setupDz('dropzone-img','imgFileInput','image');
    setupDz('dropzone-vid','videoFileInput','video');
});
function setupDz(dzId, inputId, type) {
    var dz=document.getElementById(dzId); var fi=document.getElementById(inputId);
    if(!dz||!fi) return;
    ['dragenter','dragover'].forEach(function(ev){ dz.addEventListener(ev,function(e){e.preventDefault();dz.style.borderColor='#93032E';}); });
    dz.addEventListener('dragleave',function(){dz.style.borderColor='';});
    dz.addEventListener('drop',function(e){
        e.preventDefault();dz.style.borderColor='';
        var f=e.dataTransfer&&e.dataTransfer.files[0];
        if(f){try{var dt=new DataTransfer();dt.items.add(f);fi.files=dt.files;}catch(x){}processFile(f,type);}
    });
}
</script>
{% endblock %}
