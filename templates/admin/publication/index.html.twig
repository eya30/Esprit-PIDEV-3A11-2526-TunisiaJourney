{% extends 'admin/base_admin.html.twig' %}

{% block title %}Publications{% endblock %}
{% block page_title %}Gestion des Publications{% endblock %}

{% block body %}

<style>
.tj-table-wrap { 
    background: white; 
    border-radius: 20px; 
    border: 1px solid #F0E8DD; 
    overflow: hidden; 
    box-shadow: 0 2px 8px rgba(0,0,0,0.04); 
}
.tj-table { 
    width: 100%; 
    border-collapse: collapse; 
}
.tj-table thead tr { 
    background: #FEF9F0; 
    border-bottom: 2px solid #F0E8DD; 
}
.tj-table th { 
    padding: 14px 20px; 
    font-size: 0.72rem; 
    font-weight: 700; 
    color: #93032E; 
    text-transform: uppercase; 
    letter-spacing: 0.6px; 
    white-space: nowrap;
}
.tj-table td { 
    padding: 14px 20px; 
    font-size: 0.87rem; 
    border-bottom: 1px solid #F5F0E8; 
    color: #4A3B2F; 
    vertical-align: middle; 
}
.tj-table tr:last-child td { 
    border-bottom: none; 
}
.tj-table tbody tr:hover td { 
    background: #FFF9F0; 
    transition: background 0.15s; 
}

.tj-badge { 
    padding: 4px 12px; 
    border-radius: 20px; 
    font-size: 0.75rem; 
    font-weight: 600; 
    display: inline-block; 
    white-space: nowrap;
}
.tj-badge-wine { 
    background: #FEF9F0; 
    color: #93032E; 
    border: 1px solid #F0E8DD; 
}
.tj-badge-orange { 
    background: #FEF3C7; 
    color: #B45309; 
}
.tj-badge-green { 
    background: #E0F2E9; 
    color: #047857; 
}
.tj-badge-grey { 
    background: #F3F4F6; 
    color: #6B7280; 
}
.tj-badge-blue { 
    background: #EFF6FF; 
    color: #3B82F6; 
}

.media-thumb { 
    width: 64px; 
    height: 48px; 
    border-radius: 8px; 
    object-fit: cover; 
    border: 1px solid #F0E8DD; 
    display: block; 
}
.media-thumb-video { 
    width: 64px; 
    height: 48px; 
    border-radius: 8px; 
    object-fit: cover; 
    border: 1px solid #F5CAC3; 
    display: block; 
}
.media-cell { 
    display: flex; 
    align-items: center; 
    gap: 10px; 
    flex-wrap: wrap; 
}

.tj-actions { 
    display: flex; 
    gap: 8px; 
    justify-content: center; 
    align-items: center; 
}
.action-btn { 
    width: 34px; 
    height: 34px; 
    border-radius: 8px; 
    display: inline-flex; 
    align-items: center; 
    justify-content: center; 
    transition: all 0.2s; 
    cursor: pointer; 
    border: none; 
    font-size: 0.9rem; 
    text-decoration: none; 
}
.view-btn { 
    background: #EFF6FF; 
    color: #3B82F6; 
}
.view-btn:hover { 
    background: #3B82F6; 
    color: white; 
    transform: translateY(-2px); 
}
.edit-btn { 
    background: #FEF3C7; 
    color: #D97706; 
}
.edit-btn:hover { 
    background: #F59E0B; 
    color: white; 
    transform: translateY(-2px); 
}
.delete-btn { 
    background: #FEF2F2; 
    color: #EF4444; 
}
.delete-btn:hover { 
    background: #EF4444; 
    color: white; 
    transform: translateY(-2px); 
}

.tj-btn-primary { 
    background: #93032E; 
    color: white; 
    border: none; 
    padding: 10px 22px; 
    border-radius: 40px; 
    font-size: 0.85rem; 
    font-weight: 600; 
    text-decoration: none; 
    display: inline-flex; 
    align-items: center; 
    gap: 8px; 
    transition: all 0.2s; 
}
.tj-btn-primary:hover { 
    background: #6B0221; 
    color: white; 
    transform: translateY(-2px); 
    box-shadow: 0 4px 14px rgba(147,3,46,0.3); 
}

.search-wrap { 
    position: relative; 
}
.search-icon { 
    position: absolute; 
    left: 14px; 
    top: 50%; 
    transform: translateY(-50%); 
    color: #C49A6C; 
    font-size: 0.9rem; 
}
.search-input { 
    width: 100%; 
    padding: 10px 14px 10px 38px; 
    border: 1px solid #E8DFD1; 
    border-radius: 10px; 
    font-size: 0.87rem; 
    background: #FEF9F0; 
    color: #2C1810; 
    outline: none; 
    transition: all 0.2s; 
    min-width: 260px;
}
.search-input:focus { 
    border-color: #93032E; 
    background: white; 
    box-shadow: 0 0 0 3px rgba(147,3,46,0.06); 
}

.tj-empty { 
    background: white; 
    border-radius: 20px; 
    border: 1px solid #F0E8DD; 
    padding: 3rem; 
    text-align: center; 
}

.alert-success-custom { 
    background: #E8F8EE; 
    border: 1px solid #A3E4B7; 
    border-radius: 16px; 
    padding: 12px 18px; 
    color: #047857; 
    font-size: .85rem; 
    font-weight: 500; 
    margin-bottom: 20px; 
}

/* ── BOUTONS TRI ── */
.sort-btn { 
    padding: 9px 16px; 
    border-radius: 10px; 
    border: 1.5px solid #F0E8DD; 
    background: #FEF9F0; 
    color: #93032E; 
    font-size: 0.8rem; 
    font-weight: 600; 
    cursor: pointer; 
    transition: all 0.18s; 
}
.sort-btn:hover { 
    background: #93032E; 
    color: white; 
    border-color: #93032E; 
}
.sort-active { 
    background: #93032E !important; 
    color: white !important; 
    border-color: #93032E !important; 
    box-shadow: 0 2px 8px rgba(147,3,46,0.25) !important; 
}
</style>

{# ── EN-TÊTE AVEC BOUTON ── #}
<div class="d-flex justify-content-between align-items-center mb-4" style="flex-wrap:wrap;gap:12px;">
    <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
        <div class="search-wrap">
            <i class="fas fa-search search-icon"></i>
            <input type="text" class="search-input" id="searchInput" placeholder="Rechercher par titre..." oninput="filterAndSort()">
        </div>
        {# ── TRI PAR DATE ── #}
        <div style="display:flex; gap:8px; align-items:center;">
            <span style="font-size:0.82rem; color:#9CA3AF; font-weight:500; white-space:nowrap;">Tri date :</span>
            <button onclick="setSort('asc')" id="btnAsc" class="sort-btn">
                <i class="fas fa-sort-amount-up-alt me-1"></i>Croissant
            </button>
            <button onclick="setSort('desc')" id="btnDesc" class="sort-btn">
                <i class="fas fa-sort-amount-down me-1"></i>Décroissant
            </button>
            <button onclick="setSort('none')" id="btnNone" class="sort-btn" style="background:#F3F4F6; color:#6B7280; border-color:#E5E7EB;">
                <i class="fas fa-times me-1"></i>
            </button>
        </div>
    </div>
    <a href="{{ path('app_publication_new') }}" class="tj-btn-primary">
        <i class="fas fa-plus"></i> Nouvelle publication
    </a>
</div>

{# ── FLASH MESSAGES ── #}
{% for msg in app.flashes('success') %}
    <div class="alert-success-custom d-flex align-items-center gap-2 mb-3">
        <i class="fas fa-check-circle"></i> {{ msg }}
    </div>
{% endfor %}

{# ── TABLEAU DES PUBLICATIONS ── #}
{% if publications is empty %}
    <div class="tj-empty">
        <i class="fas fa-newspaper" style="font-size:3rem; color:#E8DFD1; margin-bottom:1rem;"></i>
        <p style="color:#9CA3AF; margin-bottom:1rem;">Aucune publication.</p>
        <a href="{{ path('app_publication_new') }}" class="tj-btn-primary">
            <i class="fas fa-plus me-2"></i>Créer une publication
        </a>
    </div>
{% else %}
<div class="tj-table-wrap">
    <div style="overflow-x:auto;">
        <table class="tj-table" id="pubTable">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Titre</th>
                    <th>Description</th>
                    <th>Image</th>
                    <th>Vidéo</th>
                    <th>Forum</th>
                    <th>Date</th>
                    <th>Commentaires</th>
                    <th style="text-align:center;">Actions</th>
                </tr>
            </thead>
            <tbody id="pubBody">
                {% for pub in publications %}
                <tr data-title="{{ pub.nom|lower }}" data-date="{{ pub.dateCreation|date('Y-m-d') }}">
                    <td style="color:#C49A6C; font-weight:700;">{{ pub.idP }}</td>
                    <td><strong style="color:#2C1810;">{{ pub.nom|slice(0,40) }}{% if pub.nom|length > 40 %}…{% endif %}</strong></td>
                    <td style="color:#6B7280; max-width:200px;">
                        {{ pub.description|slice(0,60)|default('—') }}{% if pub.description|length > 60 %}…{% endif %}
                    </td>
                    
                    {# ── COLONNE IMAGE ── #}
                    <td>
                        {% if pub.image %}
                            <div class="media-cell">
                                {% if pub.image starts with 'http' %}
                                    <img src="{{ pub.image }}" class="media-thumb" alt="image" onerror="this.style.display='none'">
                                {% else %}
                                    <img src="{{ asset('uploads/publications/' ~ pub.image) }}" class="media-thumb" alt="image">
                                {% endif %}
                                <span class="tj-badge tj-badge-blue"><i class="fas fa-image"></i> Image</span>
                            </div>
                        {% else %}
                            <span class="tj-badge tj-badge-grey">Aucune</span>
                        {% endif %}
                    </td>
                    
                    {# ── COLONNE VIDÉO ── #}
                    <td>
                        {% if pub.video %}
                            <div class="media-cell">
                                {% if pub.isYoutubeVideo() and pub.youtubeId %}
                                    <img src="https://img.youtube.com/vi/{{ pub.youtubeId }}/mqdefault.jpg" class="media-thumb-video" alt="YouTube">
                                    <span class="tj-badge tj-badge-wine"><i class="fab fa-youtube"></i> YouTube</span>
                                {% elseif pub.isVimeoVideo() %}
                                    <span class="tj-badge tj-badge-wine"><i class="fab fa-vimeo"></i> Vimeo</span>
                                {% else %}
                                    <video src="{{ pub.video starts with 'http' ? pub.video : asset('uploads/publications/' ~ pub.video) }}" class="media-thumb-video" muted preload="metadata"></video>
                                    <span class="tj-badge tj-badge-wine"><i class="fas fa-video"></i> Vidéo</span>
                                {% endif %}
                            </div>
                        {% else %}
                            <span class="tj-badge tj-badge-grey">Aucune</span>
                        {% endif %}
                    </td>
                    
                    <td><span class="tj-badge tj-badge-wine">{{ pub.forum.nom }}</span></td>
                    <td><span class="tj-badge tj-badge-orange">{{ pub.dateCreation|date('d/m/Y') }}</span></td>
                    <td><span class="tj-badge tj-badge-green"><i class="fas fa-comment"></i> {{ pub.commentaires|length }}</span></td>
                    
                    <td>
                        <div class="tj-actions">
                            {# ── BOUTON VOIR COMMENTAIRES ── #}
                            <a href="{{ path('app_publication_show', {'idP': pub.idP}) }}" class="action-btn view-btn" title="Voir commentaires">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="{{ path('app_publication_edit', {'idP': pub.idP}) }}" class="action-btn edit-btn" title="Modifier">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form method="post" action="{{ path('app_publication_delete', {'idP': pub.idP}) }}" 
                                  onsubmit="return confirm('Supprimer cette publication ?')" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ pub.idP) }}">
                                <button type="submit" class="action-btn delete-btn" title="Supprimer">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div id="noResult" style="display:none; padding:2.5rem; text-align:center; color:#9CA3AF;">
        <i class="fas fa-search" style="font-size:1.4rem; opacity:0.4; display:block; margin-bottom:8px;"></i>
        Aucune publication ne correspond à votre recherche.
    </div>
</div>
{% endif %}

<script>
let currentSort = 'none';

function filterAndSort() {
    var search = document.getElementById('searchInput').value.toLowerCase().trim();
    var tbody = document.getElementById('pubBody');
    if (!tbody) return;

    var allRows = Array.from(tbody.querySelectorAll('tr'));

    var visibleRows = allRows.filter(function(row) {
        var title = (row.getAttribute('data-title') || '').toLowerCase();
        var match = search === '' || title.includes(search);
        row.style.display = match ? '' : 'none';
        return match;
    });

    if (currentSort !== 'none') {
        visibleRows.sort(function(a, b) {
            var da = a.getAttribute('data-date') || '';
            var db = b.getAttribute('data-date') || '';
            return currentSort === 'asc' ? da.localeCompare(db) : db.localeCompare(da);
        });
        visibleRows.forEach(function(row) { tbody.appendChild(row); });
    }

    var noResult = document.getElementById('noResult');
    if (noResult) noResult.style.display = (visibleRows.length === 0) ? 'block' : 'none';
}

function setSort(dir) {
    currentSort = dir;

    var btnAsc  = document.getElementById('btnAsc');
    var btnDesc = document.getElementById('btnDesc');
    var btnNone = document.getElementById('btnNone');

    if (btnAsc)  btnAsc.classList.toggle('sort-active', dir === 'asc');
    if (btnDesc) btnDesc.classList.toggle('sort-active', dir === 'desc');
    if (btnNone) {
        btnNone.style.background   = dir === 'none' ? '#F3F4F6' : '#FEF9F0';
        btnNone.style.color        = dir === 'none' ? '#6B7280' : '#93032E';
        btnNone.style.borderColor  = dir === 'none' ? '#E5E7EB' : '#93032E';
    }

    filterAndSort();
}

// Forcer rechargement après retour arrière (évite bugs de cache)
window.addEventListener('pageshow', function(event) {
    if (event.persisted) { location.reload(); }
});

document.addEventListener('DOMContentLoaded', function() {
    filterAndSort();
});
</script>
{% endblock %}
