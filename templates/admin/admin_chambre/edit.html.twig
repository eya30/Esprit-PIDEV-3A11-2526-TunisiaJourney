{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier une chambre{% endblock %}
{% block page_title %}Modifier la chambre n°{{ chambre.num }}{% endblock %}

{% block body %}
<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="form-card">
            <h5 class="form-title">Modifier la chambre</h5>
            <p class="form-subtitle">Modifiez les informations ci-dessous</p>
            
            {% if errors is defined and errors|length > 0 %}
                <div class="error-box">
                    <strong>Veuillez corriger les erreurs suivantes :</strong>
                    <ul>
                        {% for field, error in errors %}
                            <li>{{ error }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
            
            <form method="post" enctype="multipart/form-data">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Numéro de chambre</label>
                            <input type="text" name="num" class="form-control" value="{{ num }}">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Type de chambre</label>
                            <select name="type" class="form-control">
                                <option value="simple" {% if type == 'simple' %}selected{% endif %}>Simple</option>
                                <option value="double" {% if type == 'double' %}selected{% endif %}>Double</option>
                                <option value="suite" {% if type == 'suite' %}selected{% endif %}>Suite</option>
                                <option value="familiale" {% if type == 'familiale' %}selected{% endif %}>Familiale</option>
                            </select>
                        </div>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Prix par nuit (€)</label>
                            <input type="text" name="prix_nuit" class="form-control" value="{{ prix_nuit }}">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Capacité max</label>
                            <input type="text" name="capacite_max" class="form-control" value="{{ capacite_max }}">
                        </div>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Status</label>
                            <select name="status" class="form-control">
                                <option value="disponible" {% if status == 'disponible' %}selected{% endif %}>Disponible</option>
                                <option value="indisponible" {% if status == 'indisponible' %}selected{% endif %}>Indisponible</option>
                                <option value="maintenance" {% if status == 'maintenance' %}selected{% endif %}>Maintenance</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Hôtel associé</label>
                            <select name="idH" class="form-control">
                                <option value="">Sélectionner un hôtel</option>
                                {% for hotel in hotels %}
                                    <option value="{{ hotel.idH }}" {% if idH == hotel.idH %}selected{% endif %}>{{ hotel.nom }} - {{ hotel.ville }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                </div>
                
                <div class="form-group">
                    <label class="form-label">Description</label>
                    <textarea name="description" class="form-control" rows="4">{{ description }}</textarea>
                </div>
                
                <div class="form-group">
                    <label class="form-label">URL modèle 3D (optionnel)</label>
                    <input type="text" name="modele3D_URL" class="form-control" value="{{ modele3D_URL }}">
                </div>
                
                <div class="form-group">
                    <label class="form-label">Image actuelle</label>
                    {% if chambre.image %}
                        <div class="current-image">
                            <img src="{{ asset('uploads/chambres/' ~ chambre.image) }}" style="max-width: 150px; border-radius: 8px;">
                            <p>{{ chambre.image }}</p>
                        </div>
                    {% endif %}
                    <label class="form-label mt-2">Changer l'image</label>
                    <input type="file" name="image" class="form-control">
                </div>
                
                <div class="form-actions">
                    <a href="{{ path('admin_chambre_index') }}" class="btn btn-outline">Annuler</a>
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .form-card {
        background: white;
        border-radius: 24px;
        padding: 32px;
        border: 1px solid #F0E8DD;
    }
    .form-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: #2C1810;
        margin-bottom: 8px;
    }
    .form-subtitle {
        font-size: 0.85rem;
        color: #93032E;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid #F0E8DD;
    }
    .form-group {
        margin-bottom: 20px;
    }
    .form-label {
        font-size: 13px;
        font-weight: 600;
        color: #2C1810;
        margin-bottom: 8px;
        display: block;
    }
    .form-control {
        width: 100%;
        padding: 12px 16px;
        border: 1px solid #E8DFD1;
        border-radius: 12px;
        font-size: 14px;
        background: #FEF9F0;
    }
    .form-control:focus {
        outline: none;
        border-color: #93032E;
        background: white;
    }
    .current-image {
        text-align: center;
        padding: 12px;
        background: #FEF9F0;
        border-radius: 12px;
        margin-bottom: 16px;
    }
    .error-box {
        background: #FEF2F2;
        border-left: 4px solid #DC2626;
        border-radius: 16px;
        padding: 16px 20px;
        margin-bottom: 24px;
    }
    .error-box ul {
        margin: 8px 0 0;
        padding-left: 20px;
        color: #DC2626;
    }
    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid #F0E8DD;
    }
    .btn-primary {
        background: #93032E;
        border: none;
        padding: 10px 24px;
        border-radius: 40px;
        font-size: 13px;
        font-weight: 600;
        color: white;
        cursor: pointer;
    }
    .btn-primary:hover {
        background: #6B0221;
    }
    .btn-outline {
        background: transparent;
        border: 1.5px solid #E8DFD1;
        padding: 10px 24px;
        border-radius: 40px;
        font-size: 13px;
        font-weight: 500;
        color: #4A3B2F;
        text-decoration: none;
        display: inline-block;
    }
    .btn-outline:hover {
        border-color: #93032E;
        color: #93032E;
        background: #FFF9F0;
    }
</style>
{% endblock %}