{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ action }} un produit{% endblock %}
{% block page_title %}{{ action }} un produit{% endblock %}

{% block body %}
<div class="form-container">
    <div class="form-card">
        <h5 class="form-title">{{ action }} un produit artisanal</h5>
        <p class="form-subtitle" style="color: #93032E;">Remplissez les informations ci-dessous</p>

        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

            <!-- Titre -->
            <div class="form-group">
                <label class="form-label">Titre du produit</label>
                <div class="input-group-custom">
                    <i class="fas fa-tag"></i>
                    {{ form_widget(form.titre, {
                        'attr': {'class': 'form-control', 'placeholder': 'Ex : Tapis berbère, Poterie de Nabeul...'}
                    }) }}
                </div>
                {% if form_errors(form.titre) %}
                    <div class="field-error">{{ form_errors(form.titre) }}</div>
                {% endif %}
            </div>

            <!-- Description -->
            <div class="form-group">
                <label class="form-label">Description</label>
                <div class="input-group-custom">
                    <i class="fas fa-align-left"></i>
                    {{ form_widget(form.description, {
                        'attr': {'class': 'form-control', 'rows': 5, 'placeholder': "Décrivez l'article : matériaux, origine, histoire..."}
                    }) }}
                </div>
                {% if form_errors(form.description) %}
                    <div class="field-error">{{ form_errors(form.description) }}</div>
                {% endif %}
            </div>

            <!-- Prix & Stock -->
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Prix (TND)</label>
                        <div class="input-group-custom">
                            <i class="fas fa-money-bill-wave"></i>
                            {{ form_widget(form.prix, {
                                'attr': {'class': 'form-control', 'placeholder': 'Ex : 120'}
                            }) }}
                        </div>
                        {% if form_errors(form.prix) %}
                            <div class="field-error">{{ form_errors(form.prix) }}</div>
                        {% endif %}
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Stock disponible</label>
                        <div class="input-group-custom">
                            <i class="fas fa-boxes"></i>
                            {{ form_widget(form.stock, {
                                'attr': {'class': 'form-control', 'placeholder': 'Ex : 25'}
                            }) }}
                        </div>
                        {% if form_errors(form.stock) %}
                            <div class="field-error">{{ form_errors(form.stock) }}</div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Poids & Disponibilité -->
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Poids (grammes)</label>
                        <div class="input-group-custom">
                            <i class="fas fa-weight-hanging"></i>
                            {{ form_widget(form.poids, {
                                'attr': {'class': 'form-control', 'placeholder': 'Ex : 350'}
                            }) }}
                        </div>
                        {% if form_errors(form.poids) %}
                            <div class="field-error">{{ form_errors(form.poids) }}</div>
                        {% endif %}
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Disponibilité</label>
                        <div class="input-group-custom">
                            <i class="fas fa-check-circle"></i>
                            {{ form_widget(form.disponibilite, {
                                'attr': {'class': 'form-control', 'style': 'border:none; background:transparent; padding:12px 16px; font-size:14px; box-shadow:none; cursor:pointer;'}
                            }) }}
                        </div>
                        {% if form_errors(form.disponibilite) %}
                            <div class="field-error">{{ form_errors(form.disponibilite) }}</div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Image -->
            <div class="form-group">
                <label class="form-label">Image du produit</label>

                {# Afficher l'image actuelle en mode édition #}
                {% if form.vars.data.image is defined and form.vars.data.image %}
                    <div class="current-image mb-3">
                        <img src="{{ asset('uploads/produits/' ~ form.vars.data.image) }}"
                             class="current-image-preview" alt="Image actuelle">
                        <p class="image-info">Image actuelle</p>
                    </div>
                    <label class="form-label mt-2">Changer l'image</label>
                {% endif %}

                <div class="upload-area" id="uploadArea">
                    <i class="fas fa-cloud-upload-alt"></i>
                    <p>Cliquez ou glissez une image ici</p>
                    <small>JPG, PNG (max. 2 Mo)</small>
                </div>
                <div id="imagePreview" class="image-preview-container"></div>

                {# Champ caché du formulaire Symfony #}
                <div style="display:none;" id="fileFieldWrapper">
                    {{ form_widget(form.image, {'attr': {'id': 'imageInput', 'accept': 'image/*'}}) }}
                </div>

                {% if form_errors(form.image) %}
                    <div class="field-error">{{ form_errors(form.image) }}</div>
                {% endif %}
            </div>

            <!-- Actions -->
            <div class="form-actions">
                <a href="{{ path('admin_produit_index') }}" class="btn btn-outline">
                    <i class="fas fa-arrow-left me-2"></i> Annuler
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i> {{ action }}
                </button>
            </div>

        {{ form_end(form) }}
    </div>
</div>

<style>
    .form-container {
        max-width: 800px;
        margin: 0 auto;
    }

    .form-card {
        background: white;
        border-radius: 24px;
        padding: 32px;
        border: 1px solid #F0E8DD;
    }

    .form-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.4rem;
        font-weight: 700;
        color: #2C1810;
        margin-bottom: 8px;
    }

    .form-subtitle {
        font-size: 0.85rem;
        color: #93032E;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid #F0E8DD;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        font-size: 13px;
        font-weight: 600;
        color: #2C1810;
        margin-bottom: 8px;
        display: block;
    }

    .input-group-custom {
        display: flex;
        align-items: center;
        background: #FEF9F0;
        border: 1px solid #E8DFD1;
        border-radius: 12px;
        transition: all 0.2s;
    }

    .input-group-custom:focus-within {
        border-color: #93032E;
        box-shadow: 0 0 0 3px rgba(147,3,46,0.05);
        background: white;
    }

    .input-group-custom i {
        padding: 12px 0 12px 16px;
        color: #C49A6C;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .input-group-custom .form-control {
        border: none;
        background: transparent;
        padding: 12px 16px;
        font-size: 14px;
        width: 100%;
    }

    .input-group-custom .form-control:focus {
        box-shadow: none;
        outline: none;
    }

    /* Image courante */
    .current-image {
        text-align: center;
        padding: 12px;
        background: #FEF9F0;
        border-radius: 12px;
    }

    .current-image-preview {
        max-width: 150px;
        max-height: 100px;
        border-radius: 8px;
        border: 1px solid #E8DFD1;
    }

    .image-info {
        font-size: 11px;
        color: #9CA3AF;
        margin-top: 8px;
        margin-bottom: 0;
    }

    /* Zone upload */
    .upload-area {
        background: #FEF9F0;
        border: 2px dashed #E8DFD1;
        border-radius: 16px;
        padding: 32px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s;
    }

    .upload-area:hover {
        border-color: #93032E;
        background: #FFF5F0;
    }

    .upload-area i {
        font-size: 2rem;
        color: #C49A6C;
        margin-bottom: 12px;
        display: block;
    }

    .upload-area p {
        margin: 0;
        font-size: 0.9rem;
        color: #4A3B2F;
    }

    .upload-area small {
        font-size: 0.75rem;
        color: #9CA3AF;
    }

    .image-preview-container {
        margin-top: 16px;
        text-align: center;
    }

    .image-preview {
        max-width: 200px;
        max-height: 150px;
        border-radius: 12px;
        border: 1px solid #E8DFD1;
    }

    /* Erreurs */
    .field-error {
        color: #93032E;
        font-size: 0.8rem;
        margin-top: 5px;
        padding-left: 4px;
    }

    /* Actions */
    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid #F0E8DD;
    }

    .btn-primary {
        background: #93032E;
        border: none;
        padding: 10px 24px;
        border-radius: 40px;
        font-size: 13px;
        font-weight: 600;
        color: white;
        transition: all 0.2s;
        cursor: pointer;
    }

    .btn-primary:hover {
        background: #6B0221;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(147,3,46,0.3);
    }

    .btn-outline {
        background: transparent;
        border: 1.5px solid #E8DFD1;
        padding: 10px 24px;
        border-radius: 40px;
        font-size: 13px;
        font-weight: 500;
        color: #4A3B2F;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

    .btn-outline:hover {
        border-color: #93032E;
        color: #93032E;
        background: #FFF9F0;
    }
</style>

<script>
    const uploadArea = document.getElementById('uploadArea');
    const imageInput = document.getElementById('imageInput');
    const imagePreview = document.getElementById('imagePreview');

    uploadArea.addEventListener('click', () => imageInput.click());

    imageInput.addEventListener('change', function (e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
                imagePreview.innerHTML = '<img src="' + e.target.result + '" class="image-preview">';
                uploadArea.style.display = 'none';
            };
            reader.readAsDataURL(file);
        }
    });

    uploadArea.addEventListener('dragover', (e) => {
        e.preventDefault();
        uploadArea.style.borderColor = '#93032E';
        uploadArea.style.background = '#FFF5F0';
    });

    uploadArea.addEventListener('dragleave', () => {
        uploadArea.style.borderColor = '#E8DFD1';
        uploadArea.style.background = '#FEF9F0';
    });

    uploadArea.addEventListener('drop', (e) => {
        e.preventDefault();
        const file = e.dataTransfer.files[0];
        if (file && file.type.startsWith('image/')) {
            const reader = new FileReader();
            reader.onload = function (e) {
                imagePreview.innerHTML = '<img src="' + e.target.result + '" class="image-preview">';
                uploadArea.style.display = 'none';
            };
            reader.readAsDataURL(file);
            imageInput.files = e.dataTransfer.files;
        }
        uploadArea.style.borderColor = '#E8DFD1';
        uploadArea.style.background = '#FEF9F0';
    });
</script>
{% endblock %}
