{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Réservations{% endblock %}
{% block page_title %}Réservations{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1" style="font-family: 'Playfair Display', serif;">Liste des réservations</h4>
        <p class="text-muted small" style="color: #93032E !important;">Gérez l'ensemble des réservations des programmes</p>
    </div>
</div>

<div class="admin-table">
    <table class="table">
        <thead>
             </tr>
                <th style="width: 180px">Programme</th>
                <th style="width: 180px">Client</th>
                <th style="width: 200px">Contact</th>
                <th style="width: 80px">Nb pers</th>
                <th style="width: 100px">Prix total</th>
                <th style="width: 120px">Date réservation</th>
                <th style="width: 100px">Statut</th>
                <th style="width: 80px">Action</th>
             </tr>
        </thead>
        <tbody>
            {% for reservation in reservations %}
                <tr>
                    <td class="programme-name">
                        {{ reservation.programme_nom }}<br>
                        <small class="text-muted">{{ reservation.voyage_nom }}</small>
                    </td>
                    <td class="client-name">
                        <strong>{{ reservation.prenom }} {{ reservation.nom }}</strong>
                    </td>
                    <td>
                        <div><i class="fas fa-phone me-1" style="color: #93032E;"></i> {{ reservation.telephone }}</div>
                        <div><i class="fas fa-envelope me-1" style="color: #93032E;"></i> {{ reservation.email }}</div>
                    </td>
                    <td class="client-nbre">{{ reservation.nbre }} pers</td>
                    <td class="reservation-price">{{ reservation.prixProg|number_format(2, ',', ' ') }} DT</td>
                    <td class="reservation-date">{{ reservation.dateProgramme|date('d/m/Y H:i') }}</td>
                    <td>
                        {% if reservation.statutPaiement == 'payé' %}
                            <span class="badge-status badge-success">Payé</span>
                        {% else %}
                            <span class="badge-status badge-pending">En attente</span>
                        {% endif %}
                    </td>
                    <td>
                        <div class="action-buttons">
                            <form method="post" action="{{ path('admin_reservation_delete', {'id': reservation.idRP}) }}" style="display: inline-block;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_reservation_' ~ reservation.idRP) }}">
                                <button type="submit" class="action-btn delete-btn" onclick="return confirm('Supprimer cette réservation ?')" title="Supprimer">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8" class="text-center py-5">
                        <i class="fas fa-ticket-alt fa-3x mb-3" style="color: #E8DFD1;"></i>
                        <p class="text-muted mb-0">Aucune réservation trouvée</p>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<!-- Pagination -->
{% if reservations is defined and reservations|length > 0 %}
<div class="pagination-wrapper">
    <div class="pagination-info">
        Affichage de <strong>{{ reservations|length }}</strong> réservation(s)
    </div>
    <nav class="pagination-nav">
        <ul class="pagination">
            <li class="page-item {% if current_page == 1 %}disabled{% endif %}">
                <a class="page-link" href="{{ path('admin_reservation_index', {page: current_page - 1}) }}" {% if current_page == 1 %}tabindex="-1" aria-disabled="true"{% endif %}>
                    <i class="fas fa-chevron-left"></i>
                </a>
            </li>
            {% for i in 1..total_pages %}
                <li class="page-item {% if i == current_page %}active{% endif %}">
                    <a class="page-link" href="{{ path('admin_reservation_index', {page: i}) }}">{{ i }}</a>
                </li>
            {% endfor %}
            <li class="page-item {% if current_page == total_pages %}disabled{% endif %}">
                <a class="page-link" href="{{ path('admin_reservation_index', {page: current_page + 1}) }}" {% if current_page == total_pages %}tabindex="-1" aria-disabled="true"{% endif %}>
                    <i class="fas fa-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
</div>
{% endif %}

<style>
    .admin-table {
        background: white;
        border-radius: 20px;
        border: 1px solid #F0E8DD;
        overflow-x: auto;
        overflow-y: visible;
    }
    
    .admin-table .table {
        margin-bottom: 0;
        min-width: 1000px;
    }
    
    .admin-table th {
        background: #FEF9F0;
        padding: 14px 20px;
        font-size: 12px;
        font-weight: 600;
        color: #93032E;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1px solid #F0E8DD;
        white-space: nowrap;
    }
    
    .admin-table td {
        padding: 14px 20px;
        font-size: 13px;
        border-bottom: 1px solid #F5F0E8;
        color: #4A3B2F;
        vertical-align: middle;
        background: white;
    }
    
    .admin-table tr:hover td {
        background: #FFF9F0;
    }
    
    .programme-name {
        font-weight: 600;
        color: #2C1810;
        font-size: 0.9rem;
    }
    
    .programme-name small {
        font-size: 0.7rem;
        color: #93032E;
    }
    
    .client-name strong {
        color: #2C1810;
    }
    
    .client-nbre {
        white-space: nowrap;
    }
    
    .reservation-price {
        font-weight: 700;
        color: #93032E;
        font-size: 0.95rem;
        white-space: nowrap;
    }
    
    .reservation-date {
        white-space: nowrap;
        color: #9CA3AF;
        font-size: 0.85rem;
    }
    
    .badge-status {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-block;
        text-align: center;
        min-width: 85px;
    }
    
    .badge-success {
        background: #E0F2E9;
        color: #047857;
    }
    
    .badge-pending {
        background: #FEF3C7;
        color: #B45309;
    }
    
    .action-buttons {
        display: flex;
        gap: 8px;
    }
    
    .action-btn {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        cursor: pointer;
        border: none;
        background: transparent;
        font-size: 0.9rem;
        text-decoration: none;
    }
    
    .delete-btn {
        background: #FEF2F2;
        color: #EF4444;
    }
    
    .delete-btn:hover {
        background: #EF4444;
        color: white;
        transform: translateY(-2px);
    }
    
    /* Pagination Styles */
    .pagination-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 24px;
        padding: 16px 0;
    }
    
    .pagination-info {
        font-size: 0.85rem;
        color: #9CA3AF;
    }
    
    .pagination-info strong {
        color: #93032E;
        font-weight: 600;
    }
    
    .pagination-nav {
        margin: 0;
    }
    
    .pagination {
        margin: 0;
        gap: 6px;
    }
    
    .page-item {
        list-style: none;
    }
    
    .page-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: white;
        border: 1px solid #E8DFD1;
        color: #4A3B2F;
        font-size: 0.85rem;
        font-weight: 500;
        transition: all 0.2s;
        text-decoration: none;
    }
    
    .page-link:hover {
        background: #FFF9F0;
        border-color: #93032E;
        color: #93032E;
    }
    
    .page-item.active .page-link {
        background: #93032E;
        border-color: #93032E;
        color: white;
    }
    
    .page-item.disabled .page-link {
        background: #FEF9F0;
        border-color: #F0E8DD;
        color: #E8DFD1;
        cursor: not-allowed;
    }
    
    @media (max-width: 768px) {
        .pagination-wrapper {
            flex-direction: column;
            gap: 16px;
            align-items: center;
        }
        
        .admin-table {
            overflow-x: auto;
        }
    }
</style>
{% endblock %}