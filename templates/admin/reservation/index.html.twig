{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Réservations{% endblock %}
{% block page_title %}Réservations{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1" style="font-family: 'Playfair Display', serif;">Liste des réservations</h4>
        <p class="text-muted small" style="color: #93032E !important;">Gérez l'ensemble des réservations des programmes</p>
    </div>
    <div class="d-flex gap-3">
        <a href="{{ path('admin_reservation_index', {'sort': 'nom', 'direction': 'ASC'}) }}" class="btn-elegant" style="background: #93032E;">
            <i class="fas fa-sort-alpha-down"></i>
            <span>Trier A-Z</span>
        </a>
        <a href="{{ path('admin_reservation_pdf') }}" target="_blank" class="btn-elegant btn-elegant-outline">
            <i class="fas fa-file-pdf"></i>
            <span>Exporter PDF</span>
        </a>
    </div>
</div>

<!-- Barre de recherche -->
<div class="search-bar-wrapper mb-4">
    <div class="search-input-group">
        <i class="fas fa-search search-icon"></i>
        <input type="text" id="searchInput" class="form-control search-input"
               placeholder="Rechercher par nom, prénom, email, téléphone ou programme..."
               value="{{ search }}">
        <button id="clearSearch" class="clear-search-btn" style="display: {% if search %}flex{% else %}none{% endif %};">
            <i class="fas fa-times"></i>
        </button>
    </div>
    <div class="search-info">
        <span id="resultCount">{{ total_count }}</span> réservation(s) trouvée(s)
    </div>
</div>

<!-- Boutons de tri -->
<div class="sort-buttons-wrapper mb-4">
    <span class="sort-label"><i class="fas fa-sort-amount-down-alt me-2"></i>Trier par :</span>
    <div class="sort-buttons-group">
        <button type="button" class="sort-btn {% if sort == 'nom' %}active{% endif %}" data-sort="nom">
            <i class="fas fa-user"></i> Nom (A-Z)
        </button>
        <button type="button" class="sort-btn {% if sort == 'prenom' %}active{% endif %}" data-sort="prenom">
            <i class="fas fa-user"></i> Prénom (A-Z)
        </button>
        <button type="button" class="sort-btn {% if sort == 'dateProgramme' %}active{% endif %}" data-sort="dateProgramme">
            <i class="fas fa-calendar"></i> Date (récent → ancien)
        </button>
        <button type="button" class="sort-btn {% if sort == 'prixProg' %}active{% endif %}" data-sort="prixProg">
            <i class="fas fa-tag"></i> Prix (croissant)
        </button>
        <button type="button" class="sort-btn {% if sort == 'nbre' %}active{% endif %}" data-sort="nbre">
            <i class="fas fa-users"></i> Personnes
        </button>
        <button type="button" class="sort-btn {% if sort == 'statutPaiement' %}active{% endif %}" data-sort="statutPaiement">
            <i class="fas fa-check-circle"></i> Statut
        </button>
    </div>
</div>

<div class="admin-table">
    <table class="table" id="reservationsTable">
        <thead>
            <tr>
                <th>Programme</th>
                <th>Client</th>
                <th>Contact</th>
                <th>Nb pers</th>
                <th>Prix total</th>
                <th>Date réservation</th>
                <th>Statut</th>
                <th style="width: 80px">Action</th>
            </tr>
        </thead>
        <tbody>
            {% for reservation in reservations %}
                <tr data-id="{{ reservation.idRP }}">
                    <td class="programme-name">
                        {{ reservation.programme_nom }}<br>
                        <small class="text-muted">{{ reservation.voyage_nom }}</small>
                    </td>
                    <td class="client-name">
                        <strong>{{ reservation.prenom }} {{ reservation.nom }}</strong>
                    </td>
                    <td>
                        <div><i class="fas fa-phone me-1" style="color: #93032E;"></i> {{ reservation.telephone }}</div>
                        <div><i class="fas fa-envelope me-1" style="color: #93032E;"></i> {{ reservation.email }}</div>
                    </td>
                    <td class="client-nbre">{{ reservation.nbre }} pers</td>
                    <td class="reservation-price">{{ reservation.prixProg|number_format(2, ',', ' ') }} DT</td>
                    <td class="reservation-date">{{ reservation.dateProgramme|date('d/m/Y H:i') }}</td>
                    <td>
                        {% if reservation.statutPaiement == 'payé' %}
                            <span class="badge-status badge-success">Payé</span>
                        {% else %}
                            <span class="badge-status badge-pending">En attente</span>
                        {% endif %}
                    </td>
                    <td>
                        <div class="action-buttons">
                            <form method="post" action="{{ path('admin_reservation_delete', {'id': reservation.idRP}) }}" style="display: inline-block;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_reservation_' ~ reservation.idRP) }}">
                                <button type="submit" class="action-btn delete-btn" onclick="return confirm('Supprimer cette réservation ?')" title="Supprimer">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8" class="text-center py-5">
                        <i class="fas fa-ticket-alt fa-3x mb-3" style="color: #E8DFD1;"></i>
                        <p class="text-muted mb-0">Aucune réservation trouvée</p>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<!-- Pagination -->
<div class="pagination-wrapper">
    <div class="pagination-info">
        Affichage de <strong>{{ reservations|length }}</strong> sur <strong>{{ total_count }}</strong> réservation(s)
    </div>
    <nav class="pagination-nav">
        <ul class="pagination">
            <li class="page-item {% if current_page == 1 %}disabled{% endif %}">
                <a class="page-link" href="#" data-page="{{ current_page - 1 }}">
                    <i class="fas fa-chevron-left"></i>
                </a>
            </li>
            {% for i in 1..total_pages %}
                <li class="page-item {% if i == current_page %}active{% endif %}">
                    <a class="page-link" href="#" data-page="{{ i }}">{{ i }}</a>
                </li>
            {% endfor %}
            <li class="page-item {% if current_page == total_pages %}disabled{% endif %}">
                <a class="page-link" href="#" data-page="{{ current_page + 1 }}">
                    <i class="fas fa-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
</div>

<style>
    .btn-elegant {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 24px;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.85rem;
        text-decoration: none;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
        background: #93032E;
        color: white;
        box-shadow: 0 4px 12px rgba(147, 3, 46, 0.2);
    }
   
    .btn-elegant:hover {
        background: #6B0221;
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(147, 3, 46, 0.3);
        color: white;
        text-decoration: none;
    }
   
    .btn-elegant-outline {
        background: transparent;
        border: 2px solid #93032E;
        color: #93032E;
        box-shadow: none;
    }
   
    .btn-elegant-outline:hover {
        background: #93032E;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(147, 3, 46, 0.3);
    }
   
    .search-bar-wrapper {
        background: white;
        border-radius: 16px;
        padding: 16px 20px;
        border: 1px solid #F0E8DD;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }
   
    .search-input-group {
        position: relative;
        flex: 1;
        min-width: 250px;
    }
   
    .search-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #9CA3AF;
        font-size: 0.9rem;
    }
   
    .search-input {
        width: 100%;
        padding: 12px 40px 12px 40px;
        border: 1px solid #E8DFD1;
        border-radius: 40px;
        font-size: 14px;
        background: #FEF9F0;
        transition: all 0.2s;
    }
   
    .search-input:focus {
        outline: none;
        border-color: #93032E;
        background: white;
        box-shadow: 0 0 0 3px rgba(147,3,46,0.1);
    }
   
    .clear-search-btn {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: #9CA3AF;
        cursor: pointer;
        padding: 5px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.2s;
    }
   
    .clear-search-btn:hover {
        color: #93032E;
    }
   
    .search-info {
        font-size: 0.85rem;
        color: #9CA3AF;
        white-space: nowrap;
    }
   
    .search-info span {
        color: #93032E;
        font-weight: 600;
    }
   
    .sort-buttons-wrapper {
        background: white;
        border-radius: 16px;
        padding: 12px 20px;
        border: 1px solid #F0E8DD;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }
   
    .sort-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: #2C1810;
    }
   
    .sort-buttons-group {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }
   
    .sort-btn {
        background: #FEF9F0;
        border: 1px solid #E8DFD1;
        padding: 8px 16px;
        border-radius: 30px;
        font-size: 0.8rem;
        font-weight: 500;
        color: #4A3B2F;
        cursor: pointer;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
   
    .sort-btn i {
        font-size: 0.75rem;
        color: #9CA3AF;
    }
   
    .sort-btn:hover {
        background: #FFF0E8;
        border-color: #93032E;
        color: #93032E;
        transform: translateY(-2px);
    }
   
    .sort-btn:hover i {
        color: #93032E;
    }
   
    .sort-btn.active {
        background: #93032E;
        border-color: #93032E;
        color: white;
    }
   
    .sort-btn.active i {
        color: white;
    }
   
    .admin-table {
        background: white;
        border-radius: 20px;
        border: 1px solid #F0E8DD;
        overflow-x: auto;
    }
   
    .admin-table .table {
        margin-bottom: 0;
        min-width: 1000px;
    }
   
    .admin-table th {
        background: #FEF9F0;
        padding: 14px 20px;
        font-size: 12px;
        font-weight: 600;
        color: #93032E;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1px solid #F0E8DD;
    }
   
    .admin-table td {
        padding: 14px 20px;
        font-size: 13px;
        border-bottom: 1px solid #F5F0E8;
        color: #4A3B2F;
        vertical-align: middle;
    }
   
    .admin-table tr:hover td {
        background: #FFF9F0;
    }
   
    .programme-name {
        font-weight: 600;
        color: #2C1810;
        font-size: 0.9rem;
    }
   
    .programme-name small {
        font-size: 0.7rem;
        color: #93032E;
    }
   
    .client-name strong {
        color: #2C1810;
    }
   
    .reservation-price {
        font-weight: 700;
        color: #93032E;
        font-size: 0.95rem;
        white-space: nowrap;
    }
   
    .badge-status {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-block;
        min-width: 85px;
        text-align: center;
    }
   
    .badge-success {
        background: #E0F2E9;
        color: #047857;
    }
   
    .badge-pending {
        background: #FEF3C7;
        color: #B45309;
    }
   
    .action-buttons {
        display: flex;
        gap: 8px;
    }
   
    .action-btn {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        cursor: pointer;
        border: none;
        background: transparent;
        font-size: 0.9rem;
    }
   
    .delete-btn {
        background: #FEF2F2;
        color: #EF4444;
    }
   
    .delete-btn:hover {
        background: #EF4444;
        color: white;
        transform: translateY(-2px);
    }
   
    .pagination-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 24px;
        padding: 16px 0;
    }
   
    .pagination-info {
        font-size: 0.85rem;
        color: #9CA3AF;
    }
   
    .pagination-info strong {
        color: #93032E;
    }
   
    .pagination {
        margin: 0;
        gap: 6px;
    }
   
    .page-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: white;
        border: 1px solid #E8DFD1;
        color: #4A3B2F;
        font-size: 0.85rem;
        text-decoration: none;
    }
   
    .page-link:hover {
        background: #FFF9F0;
        border-color: #93032E;
        color: #93032E;
    }
   
    .page-item.active .page-link {
        background: #93032E;
        border-color: #93032E;
        color: white;
    }
   
    .page-item.disabled .page-link {
        background: #FEF9F0;
        border-color: #F0E8DD;
        color: #E8DFD1;
        cursor: not-allowed;
    }
</style>

<script>
    // Recherche
    let searchTimeout;
    const searchInput = document.getElementById('searchInput');
    const clearSearchBtn = document.getElementById('clearSearch');
   
    function performSearch() {
        const searchValue = searchInput ? searchInput.value : '';
        const url = new URL(window.location.href);
        url.searchParams.set('search', searchValue);
        url.searchParams.set('page', 1);
        window.location.href = url.toString();
    }
   
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            if (this.value.length > 2 || this.value.length === 0) {
                searchTimeout = setTimeout(performSearch, 500);
            }
        });
    }
   
    if (clearSearchBtn && searchInput) {
        clearSearchBtn.addEventListener('click', function() {
            searchInput.value = '';
            performSearch();
        });
        searchInput.addEventListener('input', function() {
            clearSearchBtn.style.display = this.value.length > 0 ? 'flex' : 'none';
        });
    }
   
    // Tri
    const sortBtns = document.querySelectorAll('.sort-btn');
    if (sortBtns && sortBtns.length > 0) {
        sortBtns.forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const sort = this.getAttribute('data-sort');
                if (!sort) return;
                
                const url = new URL(window.location.href);
                let direction = 'ASC';
                if (sort === 'dateProgramme') direction = 'DESC';
                else if (sort === 'prixProg') direction = 'ASC';
                else if (sort === 'nbre') direction = 'ASC';
                
                url.searchParams.set('sort', sort);
                url.searchParams.set('direction', direction);
                url.searchParams.set('page', 1);
                window.location.href = url.toString();
            });
        });
    }
   
    // Pagination
    const pageLinks = document.querySelectorAll('.page-link[data-page]');
    if (pageLinks && pageLinks.length > 0) {
        pageLinks.forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const page = this.getAttribute('data-page');
                if (page && !this.parentElement.classList.contains('disabled')) {
                    const url = new URL(window.location.href);
                    url.searchParams.set('page', page);
                    window.location.href = url.toString();
                }
            });
        });
    }
</script>
{% endblock %}