<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Export Commandes - TunisiaJourney</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'DejaVu Sans', sans-serif;
            font-size: 9.5px;
            color: #2C1810;
            background: white;
            padding: 18px 22px;
        }

        /* ── EN-TÊTE ── */
        .header-table {
            width: 100%;
            background: #93032E;
            border-radius: 8px;
            margin-bottom: 14px;
            padding: 16px 22px;
        }

        .header-table td {
            color: white;
            vertical-align: middle;
            padding: 0;
        }

        .brand-name {
            font-size: 18px;
            font-weight: bold;
            letter-spacing: 1px;
            margin-bottom: 3px;
        }

        .brand-name span { opacity: 0.7; font-weight: normal; }

        .doc-subtitle {
            font-size: 10px;
            opacity: 0.8;
        }

        .header-right-cell {
            text-align: right;
        }

        .ref-num {
            font-size: 13px;
            font-weight: bold;
            letter-spacing: 1px;
            margin-bottom: 3px;
        }

        .header-meta-row {
            width: 100%;
            border-top: 1px solid rgba(255,255,255,0.2);
            margin-top: 10px;
            padding-top: 8px;
            font-size: 8.5px;
            opacity: 0.75;
            color: white;
        }

        /* ── STATS (table à 5 colonnes) ── */
        .stats-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 6px 0;
            margin-bottom: 14px;
        }

        .stats-table td {
            background: white;
            border: 1px solid #E8DFD1;
            border-top: 3px solid #93032E;
            border-radius: 6px;
            padding: 10px 8px;
            text-align: center;
            width: 20%;
        }

        .stat-val {
            font-size: 18px;
            font-weight: bold;
            color: #93032E;
            line-height: 1.2;
        }

        .stat-lbl {
            font-size: 8px;
            color: #9CA3AF;
            margin-top: 3px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }

        /* ── TITRE SECTION ── */
        .section-title {
            font-size: 10px;
            font-weight: bold;
            color: #93032E;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            border-bottom: 2px solid #93032E;
            padding-bottom: 5px;
            margin-bottom: 8px;
        }

        /* ── TABLEAU COMMANDES ── */
        .commandes-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 12px;
        }

        .commandes-table thead tr {
            background: #2C1810;
        }

        .commandes-table thead th {
            color: white;
            padding: 8px 9px;
            text-align: left;
            font-size: 8px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .commandes-table tbody tr {
            border-bottom: 1px solid #F0E8DD;
        }

        .commandes-table tbody tr:nth-child(even) {
            background: #FFFBF5;
        }

        .commandes-table tbody td {
            padding: 7px 9px;
            font-size: 9px;
            color: #4A3B2F;
            vertical-align: middle;
        }

        .id-cell {
            font-weight: bold;
            color: #93032E;
        }

        .price-cell {
            font-weight: bold;
            color: #93032E;
            white-space: nowrap;
            text-align: right;
        }

        .articles-cell {
            font-size: 8.5px;
            color: #6B7280;
            line-height: 1.6;
        }

        /* ── BADGES ── */
        .badge {
            display: inline-block;
            padding: 2px 7px;
            border-radius: 10px;
            font-size: 8px;
            font-weight: bold;
            white-space: nowrap;
        }

        .badge-attente   { background: #FEF3C7; color: #92400E; }
        .badge-confirmee { background: #D1FAE5; color: #065F46; }
        .badge-expediee  { background: #DBEAFE; color: #1E40AF; }
        .badge-livree    { background: #E5E7EB; color: #374151; }
        .badge-annulee   { background: #FEE2E2; color: #991B1B; }

        /* ── RÉCAP FINAL (table 2 colonnes) ── */
        .recap-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 12px;
        }

        .recap-table td {
            padding: 0;
            vertical-align: top;
        }

        .recap-left {
            width: 60%;
            padding-right: 10px;
        }

        .recap-right {
            width: 40%;
        }

        .ca-box {
            background: #93032E;
            color: white;
            border-radius: 8px;
            padding: 14px 18px;
        }

        .ca-box .ca-lbl {
            font-size: 9px;
            opacity: 0.8;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }

        .ca-box .ca-val {
            font-size: 20px;
            font-weight: bold;
        }

        .ca-box .ca-sub {
            font-size: 8px;
            opacity: 0.65;
            margin-top: 3px;
        }

        .note-box {
            background: #FEF9F0;
            border: 1px solid #F0E8DD;
            border-radius: 8px;
            padding: 12px 14px;
            font-size: 8.5px;
            color: #6B7280;
            line-height: 1.7;
        }

        .note-box strong {
            color: #93032E;
            display: block;
            margin-bottom: 4px;
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }

        /* ── PIED DE PAGE ── */
        .footer-table {
            width: 100%;
            border-top: 1px solid #E8DFD1;
            padding-top: 8px;
            margin-top: 4px;
        }

        .footer-table td {
            font-size: 8px;
            color: #9CA3AF;
            vertical-align: middle;
        }

        .footer-table .brand-foot {
            color: #93032E;
            font-weight: bold;
        }
    </style>
</head>
<body>

<!-- ── EN-TÊTE ── -->
<table class="header-table" cellpadding="0" cellspacing="0">
    <tr>
        <td style="width:60%; padding: 16px 22px;">
            <div class="brand-name">Tunisia<span>Journey</span></div>
            <div class="doc-subtitle">Rapport des commandes — Panneau d'administration</div>
        </td>
        <td style="width:40%; text-align:right; padding: 16px 22px;" class="header-right-cell">
            <div class="ref-num">EXPORT-{{ date|date('Ymd') }}</div>
            <div style="font-size:9px; color:rgba(255,255,255,0.8);">
                Généré le {{ date|date('d/m/Y') }} à {{ date|date('H:i') }}<br>
                {{ commandes|length }} commande(s) exportée(s)
            </div>
        </td>
    </tr>
    <tr>
        <td colspan="2" style="padding: 0 22px 12px 22px;">
            <div class="header-meta-row">
                ▸ Boutique Artisanale Tunisienne &nbsp;&nbsp;
                ▸ contact@tunisiajourney.tn &nbsp;&nbsp;
                ▸ Tunis, Tunisie
            </div>
        </td>
    </tr>
</table>

<!-- ── STATS EN LIGNE ── -->
{% set nb_livrees   = 0 %}
{% set nb_attente   = 0 %}
{% set nb_annulees  = 0 %}
{% for c in commandes %}
    {% if c.statut == 'Livrée'     %}{% set nb_livrees  = nb_livrees  + 1 %}{% endif %}
    {% if c.statut == 'En attente' %}{% set nb_attente  = nb_attente  + 1 %}{% endif %}
    {% if c.statut == 'Annulée'    %}{% set nb_annulees = nb_annulees + 1 %}{% endif %}
{% endfor %}

<table class="stats-table" cellpadding="0" cellspacing="6">
    <tr>
        <td>
            <div class="stat-val">{{ commandes|length }}</div>
            <div class="stat-lbl">Total commandes</div>
        </td>
        <td>
            <div class="stat-val">{{ nb_livrees }}</div>
            <div class="stat-lbl">Livrées</div>
        </td>
        <td>
            <div class="stat-val">{{ nb_attente }}</div>
            <div class="stat-lbl">En attente</div>
        </td>
        <td>
            <div class="stat-val">{{ nb_annulees }}</div>
            <div class="stat-lbl">Annulées</div>
        </td>
        <td>
            <div class="stat-val" style="font-size:14px;">{{ caTotal|number_format(0, ',', ' ') }}<span style="font-size:9px;"> TND</span></div>
            <div class="stat-lbl">Chiffre d'affaires</div>
        </td>
    </tr>
</table>

<!-- ── TITRE TABLEAU ── -->
<div class="section-title">▸ &nbsp;Détail des commandes</div>

<!-- ── TABLEAU COMMANDES ── -->
<table class="commandes-table" cellpadding="0" cellspacing="0">
    <thead>
        <tr>
            <th style="width:35px">#</th>
            <th style="width:55px">Date</th>
            <th style="width:130px">Articles</th>
            <th>Adresse de livraison</th>
            <th style="width:55px; text-align:center;">Code postal</th>
            <th style="width:100px">Mode paiement</th>
            <th style="width:75px; text-align:right;">Total</th>
            <th style="width:65px; text-align:center;">Statut</th>
        </tr>
    </thead>
    <tbody>
        {% for commande in commandes %}
        <tr>
            <td class="id-cell">#{{ commande.id }}</td>
            <td>{{ commande.dateC|date('d/m/Y') }}</td>
            <td class="articles-cell">
                {% for ligne in commande.lignes %}
                    <span style="color:#93032E;">•</span> {{ ligne.produit.titre }} × {{ ligne.quantite }}<br>
                {% else %}—{% endfor %}
            </td>
            <td>{{ commande.adresseLiv ?? '—' }}</td>
            <td style="text-align:center;">{{ commande.codePostal ?? '—' }}</td>
            <td>{{ commande.modePaiement ?? '—' }}</td>
            <td class="price-cell">{{ commande.total|number_format(2, ',', ' ') }} TND</td>
            <td style="text-align:center;">
                {% set s = commande.statut|default('En attente') %}
                {% if s == 'Livrée' %}<span class="badge badge-livree">{{ s }}</span>
                {% elseif s == 'Confirmée' %}<span class="badge badge-confirmee">{{ s }}</span>
                {% elseif s == 'Expédiée' %}<span class="badge badge-expediee">{{ s }}</span>
                {% elseif s == 'Annulée' %}<span class="badge badge-annulee">{{ s }}</span>
                {% else %}<span class="badge badge-attente">{{ s }}</span>{% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>

<!-- ── RÉCAP FINAL ── -->
<table class="recap-table" cellpadding="0" cellspacing="0">
    <tr>
        <td class="recap-left">
            <div class="note-box">
                <strong>Note</strong>
                Ce document est généré automatiquement depuis le panneau d'administration de TunisiaJourney.
                Il est confidentiel et réservé à un usage interne uniquement.<br><br>
                Réf. export : <strong style="color:#93032E;">EXPORT-{{ date|date('Ymd') }}</strong>
            </div>
        </td>
        <td class="recap-right">
            <div class="ca-box">
                <div class="ca-lbl">Chiffre d'affaires total</div>
                <div class="ca-val">{{ caTotal|number_format(2, ',', ' ') }} TND</div>
                <div class="ca-sub">Somme de {{ commandes|length }} commande(s) exportée(s)</div>
            </div>
        </td>
    </tr>
</table>

<!-- ── PIED DE PAGE ── -->
<table class="footer-table" cellpadding="0" cellspacing="0">
    <tr>
        <td><span class="brand-foot">TunisiaJourney</span> — Document confidentiel réservé à l'administration</td>
        <td style="text-align:right;">© {{ date|date('Y') }} — Exporté le {{ date|date('d/m/Y à H:i') }}</td>
    </tr>
</table>

</body>
</html>
