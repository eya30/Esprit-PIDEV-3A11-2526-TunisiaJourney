{# templates/admin/commande/form.html.twig #}

{% extends 'admin/base_admin.html.twig' %}

{% block body %}
<div class="form-container">
    <div class="form-card">
        <h5 class="form-title">{{ action }} une commande</h5>
        <p class="form-subtitle">Détails de la transaction artisanale</p>
        
        <form method="POST">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Quantité</label>
                    <div class="input-group-custom">
                        <i class="fas fa-sort-numeric-up"></i>
                        <input type="number" name="quantite" class="form-control" value="{{ commande.quantite }}" required>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Total (TND)</label>
                    <div class="input-group-custom">
                        <i class="fas fa-money-bill-wave"></i>
                        <input type="number" step="0.01" name="total" class="form-control" value="{{ commande.total }}" required>
                    </div>
                </div>
            </div>

            <div class="form-group mb-3">
                <label class="form-label">Statut</label>
                <div class="input-group-custom">
                    <i class="fas fa-info-circle"></i>
                    <select name="statut" class="form-control">
                        <option value="En attente" {{ commande.statut == 'En attente' ? 'selected' }}>En attente</option>
                        <option value="Confirmée" {{ commande.statut == 'Confirmée' ? 'selected' }}>✅ Confirmée</option>  <!-- ✅ AJOUTÉ -->
                        <option value="En cours" {{ commande.statut == 'En cours' ? 'selected' }}>En cours</option>
                        <option value="Expédiée" {{ commande.statut == 'Expédiée' ? 'selected' }}>Expédiée</option>  <!-- ✅ AJOUTÉ -->
                        <option value="Livrée" {{ commande.statut == 'Livrée' ? 'selected' }}>Livrée</option>
                        <option value="Annulée" {{ commande.statut == 'Annulée' ? 'selected' }}>Annulée</option>  <!-- ✅ AJOUTÉ -->
                    </select>
                </div>
            </div>

            <div class="form-group mb-3">
                <label class="form-label">Adresse de livraison</label>
                <div class="input-group-custom">
                    <i class="fas fa-map-marker-alt"></i>
                    <input type="text" name="adresse" class="form-control" value="{{ commande.adresseLiv }}" required>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Code Postal</label>
                    <div class="input-group-custom">
                        <i class="fas fa-mail-bulk"></i>
                        <input type="text" name="cp" class="form-control" value="{{ commande.codePostal }}">
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Mode de Paiement</label>
                    <div class="input-group-custom">
                        <i class="fas fa-credit-card"></i>
                        <select name="paiement" class="form-control">
                            <option value="Espèces" {{ commande.modePaiement == 'Espèces' ? 'selected' }}>Espèces à la livraison</option>
                            <option value="Carte bancaire" {{ commande.modePaiement == 'Carte bancaire' ? 'selected' }}>Carte Bancaire</option>
                            <option value="Virement" {{ commande.modePaiement == 'Virement' ? 'selected' }}>Virement</option>
                        </select>
                    </div>
                </div>
            </div>

            {# ✅ BOUTON SPÉCIAL "CONFIRMER" #}
            {% if commande.statut == 'En attente' %}
                <div class="alert alert-info mt-3 mb-3" style="background:#DBEAFE; border-radius:12px; padding:12px;">
                    <i class="fas fa-info-circle"></i>
                    <strong>Astuce :</strong> Passez le statut à "Confirmée" ci-dessus pour valider la commande.
                </div>
            {% endif %}

            <div class="form-actions mt-4">
                <a href="{{ path('admin_commande_index') }}" class="btn btn-outline">Annuler</a>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i> {{ action }} la commande
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .form-container { max-width: 850px; margin: 0 auto; padding-top: 20px; }
    .form-card { background: white; border-radius: 24px; padding: 35px; border: 1px solid #F0E8DD; }
    .form-title { font-family: 'Playfair Display', serif; font-size: 1.5rem; color: #2C1810; margin-bottom: 5px; }
    .form-subtitle { color: #93032E; font-size: 0.9rem; margin-bottom: 30px; }
    .input-group-custom { display: flex; align-items: center; background: #FEF9F0; border: 1px solid #E8DFD1; border-radius: 12px; transition: 0.2s; }
    .input-group-custom i { padding: 0 15px; color: #C49A6C; }
    .form-control { border: none; background: transparent; padding: 12px; font-size: 14px; }
    .form-control:focus { outline: none; box-shadow: none; }
    .btn-primary { background: #93032E; border: none; border-radius: 40px; padding: 12px 30px; font-weight: 600; color: white; }
    .btn-outline { border: 1.5px solid #E8DFD1; border-radius: 40px; padding: 12px 30px; color: #4A3B2F; text-decoration: none; }
    .alert-info { background: #DBEAFE; border-radius: 12px; padding: 12px; }
</style>
{% endblock %}