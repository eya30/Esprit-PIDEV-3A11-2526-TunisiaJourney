{% extends 'admin/base_admin.html.twig' %}

{% block title %}Réservations de l'activité - {{ activite.Titre }}{% endblock %}
{% block page_title %}Réservations : {{ activite.Titre }}{% endblock %}

{% block body %}

{# ── CONTAINER UNIQUE : Recherche + Trier + Export PDF ── #}
<div class="white-container">
    <form method="get" action="" id="searchForm" class="toolbar-form">
        <input type="hidden" name="sort" value="{{ sort }}">
        <input type="hidden" name="page" value="1">

        <div class="search-wrapper">
            <i class="fas fa-search search-icon"></i>
            <input
                type="text"
                name="search"
                id="searchInput"
                class="search-input"
                placeholder="Rechercher par nom, prénom, email, téléphone, nb places, prix..."
                value="{{ search }}"
                autocomplete="off"
            >
            <span class="search-loading" id="searchLoading">
                <i class="fas fa-spinner fa-spin"></i>
            </span>
            {% if search %}
                <a href="{{ path('admin_activite_reservations', {'id': activite.IDAct, sort: sort}) }}" class="search-clear" title="Effacer">
                    <i class="fas fa-times"></i>
                </a>
            {% endif %}
        </div>

        <div class="sort-wrapper">
            <button type="button" class="sort-btn" id="sortToggle">
                <i class="fas fa-sort-amount-down me-1"></i> Trier
                <i class="fas fa-chevron-down ms-1 sort-arrow"></i>
            </button>
            <div class="sort-dropdown" id="sortDropdown">
                <a href="#" class="sort-option {% if sort == 'client_asc' %}active{% endif %}"
                   data-sort="client_asc">
                    <i class="fas fa-sort-alpha-down me-2" style="color: #2F4558;"></i> Client (A-Z)
                </a>
                <a href="#" class="sort-option {% if sort == 'date_asc' %}active{% endif %}"
                   data-sort="date_asc">
                    <i class="fas fa-calendar-alt me-2" style="color: #2F4558;"></i> Date réservation (croissant)
                </a>
                <a href="#" class="sort-option {% if sort == 'places_asc' %}active{% endif %}"
                   data-sort="places_asc">
                    <i class="fas fa-users me-2" style="color: #2F4558;"></i> Nombre places (croissant)
                </a>
                <a href="#" class="sort-option {% if sort == 'prix_asc' %}active{% endif %}"
                   data-sort="prix_asc">
                    <i class="fas fa-euro-sign me-2" style="color: #2F4558;"></i> Prix total (croissant)
                </a>
            </div>
            <input type="hidden" name="sort" id="sortInput" value="{{ sort }}">
        </div>
    </form>

    <a href="{{ path('admin_reservations_export_pdf', {'id': activite.IDAct, search: search, sort: sort}) }}"
       class="btn-export-pdf" title="Exporter les réservations en PDF">
        <i class="fas fa-file-pdf me-1"></i> Export PDF
    </a>
</div>

{# ── Tableau ──────────────────────────────────────────────────────────────── #}
<div class="admin-table-wrapper">
    <div class="admin-table">
        <table class="table">
            <thead>
                <tr>
                    <th style="color: #2F4558;">Client</th>
                    <th style="color: #2F4558;">Email</th>
                    <th style="color: #2F4558;">Téléphone</th>
                    <th style="color: #2F4558;">Date réservation</th>
                    <th style="color: #2F4558;">Nb places</th>
                    <th style="color: #2F4558;">Prix total</th>
                    <th style="color: #2F4558;">Activité réservée</th>
                    <th style="color: #2F4558;">Action</th>
                </tr>
            </thead>
            <tbody>
                {% for reservation in reservations %}
                <tr>
                    <td class="client-name">
                        <strong>{{ reservation.Prenom }} {{ reservation.Nom }}</strong>
                    </td>
                    <td class="client-email">{{ reservation.email }}</td>
                    <td class="client-telephone">{{ reservation.telephone }}</td>
                    <td class="reservation-date">{{ reservation.DateReservation|date('d/m/Y') }}</td>
                    <td class="client-nbre">{{ reservation.NombrePlaces }} pers</td>
                    <td class="reservation-price">{{ reservation.Prix|number_format(2, ',', ' ') }} DT</td>
                    <td class="activite-name">
                        <strong>{{ activite.Titre }}</strong>
                    </td>
                    <td>
                        <div class="action-buttons">
                            <form method="post" action="{{ path('admin_reservationact_delete', {'id': reservation.IDRes}) }}" style="display: inline-block;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_reservationact_' ~ reservation.IDRes) }}">
                                <button type="submit" class="action-btn delete-btn" onclick="return confirm('Supprimer cette réservation ?')" title="Supprimer">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="8" class="text-center py-5">
                        <i class="fas fa-ticket-alt fa-3x mb-3" style="color: #E8DFD1;"></i>
                        <p class="text-muted mb-0">Aucune réservation pour cette activité</p>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{# ── PAGINATION — même style qu'événements ── #}
{% if total_pages is defined and total_pages > 1 %}
<div class="pagination-wrapper">
    <div class="pagination-info">
        Affichage de <strong>{{ reservations|length }}</strong> réservation(s) sur
        <strong>{{ total_items }}</strong> total
        <span class="text-muted">| Page {{ current_page }} / {{ total_pages }}</span>
    </div>
    <nav class="pagination-nav">
        <ul class="pagination">
            <li class="page-item {% if current_page == 1 %}disabled{% endif %}">
                <a class="page-link"
                   href="{{ path('admin_activite_reservations', {id: activite.IDAct, page: 1, search: search, sort: sort}) }}">
                    <i class="fas fa-angle-double-left"></i>
                </a>
            </li>
            <li class="page-item {% if current_page == 1 %}disabled{% endif %}">
                <a class="page-link"
                   href="{{ path('admin_activite_reservations', {id: activite.IDAct, page: current_page - 1, search: search, sort: sort}) }}">
                    <i class="fas fa-chevron-left"></i>
                </a>
            </li>

            {% set start_page = max(1, current_page - 2) %}
            {% set end_page   = min(total_pages, current_page + 2) %}

            {% if start_page > 1 %}
                <li class="page-item disabled"><span class="page-link">...</span></li>
            {% endif %}

            {% for i in start_page..end_page %}
                <li class="page-item {% if i == current_page %}active{% endif %}">
                    <a class="page-link"
                       href="{{ path('admin_activite_reservations', {id: activite.IDAct, page: i, search: search, sort: sort}) }}">
                        {{ i }}
                    </a>
                </li>
            {% endfor %}

            {% if end_page < total_pages %}
                <li class="page-item disabled"><span class="page-link">...</span></li>
            {% endif %}

            <li class="page-item {% if current_page == total_pages %}disabled{% endif %}">
                <a class="page-link"
                   href="{{ path('admin_activite_reservations', {id: activite.IDAct, page: current_page + 1, search: search, sort: sort}) }}">
                    <i class="fas fa-chevron-right"></i>
                </a>
            </li>
            <li class="page-item {% if current_page == total_pages %}disabled{% endif %}">
                <a class="page-link"
                   href="{{ path('admin_activite_reservations', {id: activite.IDAct, page: total_pages, search: search, sort: sort}) }}">
                    <i class="fas fa-angle-double-right"></i>
                </a>
            </li>
        </ul>
    </nav>
</div>
{% endif %}

<style>
/* ── Container blanc générique ───────────────────────────────────────────── */
.white-container {
    background: white;
    border-radius: 20px;
    border: 1px solid #F0E8DD;
    padding: 30px 24px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
}

/* ── Recherche ───────────────────────────────────────────────────────────── */
.toolbar-form { display: flex; align-items: center; gap: 12px; flex: 1; flex-wrap: wrap; }
.search-wrapper { position: relative; flex: 1; min-width: 200px; }
.search-icon {
    position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
    color: #B0A090; font-size: 13px; pointer-events: none; z-index: 2;
}
.search-input {
    width: 100%; height: 42px; border: 1.5px solid #E8DFD1; border-radius: 40px;
    padding: 0 40px 0 38px; font-size: 13px; color: #2C1810;
    background: #FDFAF7; outline: none; transition: border-color 0.2s, box-shadow 0.2s;
}
.search-input:focus { border-color: #2F4558; box-shadow: 0 0 0 3px rgba(47,69,88,0.08); }
.search-loading {
    display: none; position: absolute; right: 40px; top: 50%;
    transform: translateY(-50%); color: #2F4558; font-size: 12px;
}
.search-loading.visible { display: inline-block; }
.search-clear {
    position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
    color: #B0A090; font-size: 12px; text-decoration: none; transition: color 0.2s; z-index: 2;
}
.search-clear:hover { color: #2F4558; }

/* ── Tri ─────────────────────────────────────────────────────────────────── */
.sort-wrapper { position: relative; }
.sort-btn {
    height: 42px; padding: 0 18px; border-radius: 40px;
    border: 1.5px solid #2F4558; background: white; color: #2F4558;
    font-size: 13px; font-weight: 600; cursor: pointer;
    display: flex; align-items: center; gap: 6px; transition: all 0.2s; white-space: nowrap;
}
.sort-btn i { color: #2F4558; }
.sort-btn:hover { border-color: #2F4558; background: #2F4558; color: white; }
.sort-btn:hover i { color: white; }
.sort-btn.open { border-color: #2F4558; background: #2F4558; color: white; }
.sort-btn.open i { color: white; }
.sort-arrow { font-size: 10px; transition: transform 0.2s; }
.sort-btn.open .sort-arrow { transform: rotate(180deg); }
.sort-dropdown {
    display: none; position: absolute; top: calc(100% + 8px); left: 0;
    background: white; border: 1px solid #E8DFD1; border-radius: 16px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.1); z-index: 100; min-width: 200px; overflow: hidden;
}
.sort-dropdown.open { display: block; }
.sort-option {
    display: flex; align-items: center; padding: 11px 18px;
    font-size: 13px; color: #4A3B2F; text-decoration: none; transition: background 0.15s;
}
.sort-option:hover { background: #E8F4F8; color: #2F4558; }
.sort-option.active { background: #D6EEF5; color: #2F4558; font-weight: 600; }

/* ── Bouton Export PDF ───────────────────────────────────────────── */
.btn-export-pdf {
    height: 42px; padding: 0 18px; border-radius: 40px;
    border: 1.5px solid #93032E; background: white; color: #93032E;
    font-size: 13px; font-weight: 600; cursor: pointer;
    display: inline-flex; align-items: center; gap: 6px;
    transition: all 0.2s; white-space: nowrap; text-decoration: none;
}
.btn-export-pdf:hover {
    background: #93032E; color: white;
    transform: translateY(-2px); box-shadow: 0 4px 12px rgba(147,3,46,0.3);
}

/* ── Tableau ─────────────────────────────────────────────────────────────── */
.admin-table-wrapper { width: 100%; overflow-x: auto; border-radius: 20px; }

.admin-table {
    background: white;
    border-radius: 20px 20px 0 0;
    border: 1px solid #F0E8DD;
    border-bottom: none;
    overflow-x: auto;
}

.admin-table .table { margin-bottom: 0; width: 100%; }

.admin-table th {
    background: #FEF9F0;
    padding: 14px 20px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 1px solid #F0E8DD;
    white-space: nowrap;
}

.admin-table td {
    padding: 14px 20px;
    font-size: 13px;
    border-bottom: 1px solid #F5F0E8;
    color: #4A3B2F;
    vertical-align: middle;
    background: white;
}

/* Hover supprimé sur les lignes */
.admin-table tr:hover td { background: white; }

.client-name strong { font-weight: 600; color: #2C1810; }
.client-email, .client-telephone { color: #6B7280; font-size: 12px; }
.client-nbre { font-weight: 600; text-align: center; color: #4A3B2F; }
.reservation-price { font-weight: 700; color: #4A3B2F; font-size: 0.95rem; white-space: nowrap; }
.reservation-date { white-space: nowrap; color: #9CA3AF; font-size: 0.85rem; }
.activite-name strong { color: #4A3B2F; font-size: 13px; }

/* ── Boutons d'action ────────────────────────────────────────────────────── */
.action-buttons { display: flex; gap: 8px; }
.action-btn {
    width: 36px; height: 36px; border-radius: 10px;
    display: inline-flex; align-items: center; justify-content: center;
    transition: all 0.2s; cursor: pointer; border: none;
    background: transparent; font-size: 0.9rem; text-decoration: none;
}
.delete-btn { background: #FEF2F2; color: #93032E; }


/* ── Pagination — même style qu'événements ── */
.pagination-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 24px;
    padding: 16px 0;
    border-top: 1px solid #F0E8DD;
    flex-wrap: wrap;
    gap: 16px;
}

.pagination-info { font-size: 0.85rem; color: #9CA3AF; }
.pagination-info strong { color: #93032E; font-weight: 600; }

.pagination { margin: 0; gap: 6px; padding-left: 0; display: flex; flex-wrap: wrap; }
.page-item { list-style: none; }

.page-link {
    display: flex; align-items: center; justify-content: center;
    min-width: 36px; height: 36px; padding: 0 8px; border-radius: 10px;
    background: white; border: 1px solid #E8DFD1; color: #4A3B2F;
    font-size: 0.85rem; font-weight: 500; transition: all 0.2s; text-decoration: none;
}

.page-link:hover { background: #FFF9F0; border-color: #93032E; color: #93032E; }
.page-item.active .page-link { background: #93032E; border-color: #93032E; color: white; }
.page-item.disabled .page-link {
    background: #FEF9F0; border-color: #F0E8DD; color: #E8DFD1;
    cursor: not-allowed; pointer-events: none;
}

/* ── Utilitaires ─────────────────────────────────────────────────────────── */
.text-muted { color: #9CA3AF !important; }
.text-center { text-align: center; }
.py-5 { padding-top: 3rem; padding-bottom: 3rem; }
.mb-0 { margin-bottom: 0; }
.mb-3 { margin-bottom: 1rem; }
.me-1 { margin-right: 0.25rem; }
.me-2 { margin-right: 0.5rem; }
.ms-1 { margin-left: 0.25rem; }

@media (max-width: 768px) {
    .white-container { flex-direction: column; align-items: stretch; }
    .toolbar-form { flex-direction: column; }
    .admin-table { overflow-x: auto; }
    .admin-table th, .admin-table td { white-space: nowrap; }
    .pagination-wrapper { flex-direction: column; align-items: center; }
    .pagination { justify-content: center; }
}
</style>

<script>
(function () {
    var input      = document.getElementById('searchInput');
    var form       = document.getElementById('searchForm');
    var loading    = document.getElementById('searchLoading');
    if (!input || !form) return;

    var timer      = null;
    var submitting = false;
    var lastSubmittedValue = input.value;

    function restoreFocusAndCursor() {
        if (input.value.length > 0) {
            input.focus();
            var len = input.value.length;
            input.setSelectionRange(len, len);
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', restoreFocusAndCursor);
    } else {
        restoreFocusAndCursor();
    }

    function showLoading(show) {
        if (!loading) return;
        loading.classList.toggle('visible', show);
    }

    input.addEventListener('input', function () {
        clearTimeout(timer);
        if (this.value === lastSubmittedValue) return;
        showLoading(true);
        timer = setTimeout(function () {
            if (submitting) return;
            submitting = true;
            showLoading(false);
            var p = form.querySelector('input[name="page"]');
            if (p) p.value = 1;
            lastSubmittedValue = input.value;
            form.submit();
        }, 500);
    });

    form.addEventListener('submit', function () {
        clearTimeout(timer);
        showLoading(false);
        submitting = true;
    });
})();

(function () {
    var btn       = document.getElementById('sortToggle');
    var dropdown  = document.getElementById('sortDropdown');
    var sortInput = document.getElementById('sortInput');
    var form      = document.getElementById('searchForm');
    if (!btn) return;

    btn.addEventListener('click', function (e) {
        e.stopPropagation();
        btn.classList.toggle('open');
        dropdown.classList.toggle('open');
    });

    document.querySelectorAll('.sort-option').forEach(function (opt) {
        opt.addEventListener('click', function (e) {
            e.preventDefault();
            sortInput.value = this.dataset.sort;
            var p = form.querySelector('input[name="page"]');
            if (p) p.value = 1;
            form.submit();
        });
    });

    document.addEventListener('click', function () {
        btn.classList.remove('open');
        dropdown.classList.remove('open');
    });
})();
</script>

{% endblock %}
