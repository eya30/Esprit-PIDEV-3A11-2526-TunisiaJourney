{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des activités{% endblock %}
{% block page_title %}Activités{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1" style="font-family: 'Playfair Display', serif;">Liste des activités</h4>
        <p class="text-muted small" style="color: #93032E !important;">Gérez l'ensemble des activités</p>
    </div>
    <a href="{{ path('admin_activite_new') }}" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i> Nouvelle activité
    </a>
</div>

<div class="admin-table">
    <table class="table">
        <thead>
            <tr>
                <th style="width: 80px">Image</th>
                <th>Titre</th>
                <th>Description</th>
                <th>Type</th>
                <th>Animateur</th>
                <th>Horaire</th>
                <th>Capacité</th>
                <th>Prix</th>
                <th>Événement</th>
                <th style="width: 120px">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for activite in activites %}
            <tr>
                <td>
                    {% if activite.Image %}
                        <img src="{{ asset('uploads/activites/' ~ activite.Image) }}" style="width: 50px; height: 50px; object-fit: cover; border-radius: 10px;">
                    {% else %}
                        <div style="width: 50px; height: 50px; background: #FEF9F0; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-calendar-alt" style="color: #E8DFD1;"></i>
                        </div>
                    {% endif %}
                </td>
                <td><strong style="color: #2C1810;">{{ activite.Titre }}</strong></td>
                <td style="color: #6B7280;">{{ activite.Description|slice(0, 50) }}{% if activite.Description|length > 50 %}...{% endif %}</td>
                <td><span class="type-badge">{{ activite.TypeActivite }}</span></td>
                <td><span class="animateur-badge">{{ activite.NomAnimateur }}</span></td>
                <td>
                    <span class="horaire-badge">
                        {{ activite.HeureDebut }}<br>{{ activite.Duree }}
                    </span>
                </td>
                <td><span class="capacite-badge">{{ activite.CapaciteM }} pers</span></td>
                <td class="prix-cell">{{ activite.Prix|number_format(2, ',', ' ') }} DT</td>
                <td><span class="evenement-badge">{{ activite.evenement_titre }}</span></td>
                <td>
                    <div class="action-buttons">
                        <a href="{{ path('admin_activite_reservations', {'id': activite['IDAct']}) }}" class="action-btn reservations-btn" title="Réservations">
                            <i class="fas fa-book"></i>
                        </a>
                        <a href="{{ path('admin_activite_edit', {'id': activite.IDAct}) }}" class="action-btn edit-btn" title="Modifier">
                            <i class="fas fa-edit"></i>
                        </a>
                        <form method="post" action="{{ path('admin_activite_delete', {'id': activite.IDAct}) }}" style="display: inline-block;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_activite_' ~ activite.IDAct) }}">
                            <button type="submit" class="action-btn delete-btn" onclick="return confirm('Supprimer cette activité ?')" title="Supprimer">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="10" class="text-center py-5">
                    <i class="fas fa-calendar-alt fa-3x mb-3" style="color: #E8DFD1;"></i>
                    <p class="text-muted mb-0">Aucune activité trouvée</p>
                    <a href="{{ path('admin_activite_new') }}" class="btn btn-primary mt-3">Créer une activité</a>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<style>
    .admin-table {
        background: white;
        border-radius: 20px;
        border: 1px solid #F0E8DD;
        overflow-x: auto;
    }
    
    .admin-table .table {
        margin-bottom: 0;
        min-width: 1200px;
    }
    
    .admin-table th {
        background: #FEF9F0;
        padding: 14px 20px;
        font-size: 12px;
        font-weight: 600;
        color: #93032E;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1px solid #F0E8DD;
        white-space: nowrap;
    }
    
    .admin-table td {
        padding: 14px 20px;
        font-size: 13px;
        border-bottom: 1px solid #F5F0E8;
        color: #4A3B2F;
        vertical-align: middle;
    }
    
    .admin-table tr:hover td {
        background: #FFF9F0;
    }
    
    .type-badge, .animateur-badge, .capacite-badge, .evenement-badge {
        display: inline-flex;
        align-items: center;
        background: #FEF9F0;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
        color: #93032E;
        white-space: nowrap;
    }
    
    .animateur-badge {
        background: #EFF6FF;
        color: #3B82F6;
    }
    
    .horaire-badge {
        display: inline-flex;
        flex-direction: column;
        font-size: 11px;
        color: #6B7280;
        line-height: 1.4;
        background: #FEF9F0;
        padding: 5px 12px;
        border-radius: 20px;
        white-space: nowrap;
    }
    
    .prix-cell {
        font-weight: 700;
        color: #93032E;
        font-size: 14px;
        white-space: nowrap;
    }
    
    .action-buttons {
        display: flex;
        gap: 8px;
    }
    
    .action-btn {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        cursor: pointer;
        border: none;
        background: transparent;
        font-size: 0.9rem;
        text-decoration: none;
    }
    
    .reservations-btn {
        background: #EFF6FF;
        color: #3B82F6;
    }
    
    .reservations-btn:hover {
        background: #3B82F6;
        color: white;
        transform: translateY(-2px);
    }
    
    .edit-btn {
        background: #FEF3C7;
        color: #D97706;
    }
    
    .edit-btn:hover {
        background: #F59E0B;
        color: white;
        transform: translateY(-2px);
    }
    
    .delete-btn {
        background: #FEF2F2;
        color: #EF4444;
    }
    
    .delete-btn:hover {
        background: #EF4444;
        color: white;
        transform: translateY(-2px);
    }
    
    .btn-primary {
        background: #93032E;
        border: none;
        padding: 8px 20px;
        border-radius: 40px;
        font-size: 13px;
        font-weight: 600;
        color: white;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }
    
    .btn-primary:hover {
        background: #6B0221;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(147,3,46,0.3);
        color: white;
    }
</style>
{% endblock %}