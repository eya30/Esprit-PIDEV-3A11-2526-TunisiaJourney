{% extends 'admin/base_admin.html.twig' %}

{% block title %}Nouvelle activité{% endblock %}
{% block page_title %}Ajouter une activité{% endblock %}

{% block body %}
<div class="form-container">
    <div class="form-card">
        <h5 class="form-title">Créer une nouvelle activité</h5>
        <p class="form-subtitle">Remplissez les informations ci-dessous</p>

        <form method="post" enctype="multipart/form-data" id="activiteForm">

            {# ── Titre ────────────────────────────────────────────────────── #}
            <div class="form-group {% if errors.Titre is defined %}has-error{% endif %}" data-field="Titre">
                <label class="form-label">Titre de l'activité <span class="required">*</span></label>
                <div class="input-group-custom">
                    <i class="fas fa-tag"></i>
                    <input type="text" name="Titre" class="form-control"
                           value="{{ old.Titre|default('') }}"
                           placeholder="Ex: Atelier cuisine, Randonnée..."
                           autocomplete="off">
                </div>
                {% if errors.Titre is defined %}
                    <div class="error-message">{{ errors.Titre }}</div>
                {% endif %}
            </div>

            {# ── Description ──────────────────────────────────────────────── #}
            <div class="form-group {% if errors.Description is defined %}has-error{% endif %}" data-field="Description">
                <label class="form-label">Description <span class="required">*</span></label>
                <div class="input-group-custom">
                    <i class="fas fa-align-left"></i>
                    <textarea name="Description" class="form-control" rows="5"
                              placeholder="Décrivez l'activité..."
                              autocomplete="off">{{ old.Description|default('') }}</textarea>
                </div>
                {% if errors.Description is defined %}
                    <div class="error-message">{{ errors.Description }}</div>
                {% endif %}
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group {% if errors.TypeActivite is defined %}has-error{% endif %}" data-field="TypeActivite">
                        <label class="form-label">Type d'activité <span class="required">*</span></label>
                        <div class="input-group-custom">
                            <i class="fas fa-icons"></i>
                            <input type="text" name="TypeActivite" class="form-control"
                                   value="{{ old.TypeActivite|default('') }}"
                                   placeholder="Ex: Atelier, Conférence, Spectacle"
                                   autocomplete="off">
                        </div>
                        {% if errors.TypeActivite is defined %}
                            <div class="error-message">{{ errors.TypeActivite }}</div>
                        {% endif %}
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group {% if errors.NomAnimateur is defined %}has-error{% endif %}" data-field="NomAnimateur">
                        <label class="form-label">Nom de l'animateur <span class="required">*</span></label>
                        <div class="input-group-custom">
                            <i class="fas fa-chalkboard-teacher"></i>
                            <input type="text" name="NomAnimateur" class="form-control"
                                   value="{{ old.NomAnimateur|default('') }}"
                                   placeholder="Ex: Jean Dupont"
                                   autocomplete="off">
                        </div>
                        {% if errors.NomAnimateur is defined %}
                            <div class="error-message">{{ errors.NomAnimateur }}</div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group {% if errors.HeureDebut is defined %}has-error{% endif %}" data-field="HeureDebut">
                        <label class="form-label">Heure de début <span class="required">*</span></label>
                        <div class="input-group-custom">
                            <i class="fas fa-clock"></i>
                            <input type="text" name="HeureDebut" class="form-control"
                                   value="{{ old.HeureDebut|default('') }}"
                                   placeholder="HH:MM (ex: 09:30)"
                                   autocomplete="off">
                        </div>
                        {% if errors.HeureDebut is defined %}
                            <div class="error-message">{{ errors.HeureDebut }}</div>
                        {% endif %}
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group {% if errors.Duree is defined %}has-error{% endif %}" data-field="Duree">
                        <label class="form-label">Durée <span class="required">*</span></label>
                        <div class="input-group-custom">
                            <i class="fas fa-hourglass-half"></i>
                            <input type="text" name="Duree" class="form-control"
                                   value="{{ old.Duree|default('') }}"
                                   placeholder="Ex: 2h30min, 1h, 45min"
                                   autocomplete="off">
                        </div>
                        {% if errors.Duree is defined %}
                            <div class="error-message">{{ errors.Duree }}</div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group {% if errors.CapaciteM is defined %}has-error{% endif %}" data-field="CapaciteM">
                        <label class="form-label">Capacité maximale <span class="required">*</span></label>
                        <div class="input-group-custom">
                            <i class="fas fa-users"></i>
                            <input type="text" name="CapaciteM" class="form-control"
                                   value="{{ old.CapaciteM|default('') }}"
                                   placeholder="50"
                                   autocomplete="off">
                        </div>
                        {% if errors.CapaciteM is defined %}
                            <div class="error-message">{{ errors.CapaciteM }}</div>
                        {% endif %}
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group {% if errors.Prix is defined %}has-error{% endif %}" data-field="Prix">
                        <label class="form-label">Prix (DT) <span class="required">*</span></label>
                        <div class="input-group-custom">
                            <i class="fas fa-coins"></i>
                            <input type="text" name="Prix" class="form-control"
                                   value="{{ old.Prix|default('') }}"
                                   placeholder="29.99"
                                   autocomplete="off">
                        </div>
                        {% if errors.Prix is defined %}
                            <div class="error-message">{{ errors.Prix }}</div>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# ── Événement associé ────────────────────────────────────────── #}
            <div class="form-group {% if errors.IDEv is defined %}has-error{% endif %}" data-field="IDEv">
                <label class="form-label">Événement associé <span class="required">*</span></label>
                <div class="input-group-custom">
                    <i class="fas fa-calendar-alt"></i>
                    <select name="IDEv" class="form-control">
                        <option value="">Sélectionner un événement</option>
                        {% for evenement in evenements %}
                            <option value="{{ evenement.IDEv }}" {% if app.request.get('evenement') == evenement.IDEv %}selected{% endif %}>
                                {{ evenement.Titre }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                {% if errors.IDEv is defined %}
                    <div class="error-message">{{ errors.IDEv }}</div>
                {% endif %}
            </div>

            {# ── Image ────────────────────────────────────────────────────── #}
            <div class="form-group">
                <label class="form-label">Image</label>
                <div class="upload-area" id="uploadArea">
                    <i class="fas fa-cloud-upload-alt"></i>
                    <p>Cliquez ou glissez une image ici</p>
                    <small>JPG, PNG, JPEG (max. 2MB)</small>
                    <input type="file" name="image" id="imageInput" accept="image/*" style="display: none;">
                </div>
                <div id="imagePreview" class="image-preview-container"></div>
            </div>

            <div class="form-actions">
                <a href="{{ path('admin_evenement_activites', { id: app.request.get('evenement') }) }}" class="btn btn-outline">
                    <i class="fas fa-arrow-left me-2"></i> Annuler
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i> Créer l'activité
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .form-container {
        max-width: 1200px;
        margin: 0 auto;
        width: 100%;
    }

    .form-card {
        background: white;
        border-radius: 24px;
        padding: 40px;
        border: 1px solid #F0E8DD;
        width: 100%;
    }

    .form-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.4rem;
        font-weight: 700;
        color: #2C1810;
        margin-bottom: 8px;
    }

    .form-subtitle {
        font-size: 0.85rem;
        color: #93032E;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid #F0E8DD;
    }

    .required {
        color: #93032E;
        font-size: 12px;
    }

    .input-group-custom {
        display: flex;
        align-items: center;
        background: white;
        border: 1.5px solid #93032E;
        border-radius: 12px;
        transition: all 0.2s;
    }

    .input-group-custom:focus-within {
        border-color: #93032E;
        box-shadow: 0 0 0 2px rgba(147,3,46,0.1);
    }

    .form-group.has-error .input-group-custom {
        border-color: #dc2626;
        background: white;
    }

    .form-group.has-error .input-group-custom:focus-within {
        border-color: #dc2626;
        box-shadow: 0 0 0 2px rgba(220,38,38,0.1);
    }

    .input-group-custom i {
        padding: 12px 0 12px 16px;
        color: #828282;
        font-size: 1rem;
    }

    .input-group-custom .form-control {
        border: none;
        background: transparent;
        padding: 12px 16px;
        font-size: 14px;
        width: 100%;
        outline: none;
    }

    .input-group-custom .form-control:focus {
        outline: none;
        box-shadow: none;
    }

    .input-group-custom select.form-control {
        cursor: pointer;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        font-size: 13px;
        font-weight: 600;
        color: #2C1810;
        margin-bottom: 8px;
        display: block;
    }

    .error-message {
        color: #dc2626;
        font-size: 12px;
        margin-top: 6px;
        padding-left: 12px;
        display: block;
    }

    .upload-area {
        background: white;
        border: 1.5px dashed #93032E;
        border-radius: 16px;
        padding: 24px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s;
    }

    .upload-area:hover {
        border-color: #93032E;
        background: #FFF5F0;
    }

    .upload-area i {
        font-size: 1.8rem;
        color: #828282;
        margin-bottom: 8px;
    }

    .upload-area p {
        margin: 0;
        font-size: 0.85rem;
        color: #4A3B2F;
    }

    .upload-area small {
        font-size: 0.7rem;
        color: #9CA3AF;
    }

    /* AVANT - Règle CSS originale */
    .image-preview-container {
        margin-top: 16px;
        text-align: center;
    }

    .image-preview {
        max-width: 100%;
        max-height: 250px;
        border-radius: 12px;
        border: 1px solid #E8DFD1;
        object-fit: contain;
    }

    /* APRÈS - Nouvelles règles CSS améliorées */
    .image-preview-container {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        margin: 8px 0 4px 0;
    }

    .image-preview {
        max-width: 100%;
        max-height: 300px;
        width: auto;
        height: auto;
        border-radius: 12px;
        object-fit: contain;
        display: block;
        background: #FEF9F0;
        border: 2px solid #E8DFD1;
        border-radius: 20px;
        padding: 12px;
    }

    /* Styles pour l'affichage de l'image actuelle (si nécessaire) */
    .current-image-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        margin: 8px 0 4px 0;
    }

    .current-image-container {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        background: #FEF9F0;
        border: 2px solid #E8DFD1;
        border-radius: 20px;
        padding: 12px;
        transition: all 0.25s ease;
    }

    .current-image-container:hover {
        border-color: #93032E;
        background: #FFF9F0;
        box-shadow: 0 6px 16px rgba(147,3,46,0.12);
    }

    .current-image-preview {
        max-width: 100%;
        max-height: 300px;
        width: auto;
        height: auto;
        border-radius: 12px;
        object-fit: contain;
        display: block;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid #F0E8DD;
    }

    .btn-primary {
        background: #93032E;
        border: none;
        padding: 10px 24px;
        border-radius: 40px;
        font-size: 13px;
        font-weight: 600;
        color: white;
        transition: all 0.2s;
        cursor: pointer;
    }

    .btn-primary:hover {
        background: #6B0221;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(147,3,46,0.3);
    }

    .btn-outline {
        background: transparent;
        border: 1.5px solid #93032E;
        padding: 10px 24px;
        border-radius: 40px;
        font-size: 13px;
        font-weight: 500;
        color: #93032E;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

    .btn-outline:hover {
        background: #FFF5F0;
        color: #6B0221;
        border-color: #6B0221;
    }

    .row {
        display: flex;
        gap: 20px;
        margin-bottom: 0;
    }

    .col-md-6 {
        flex: 1;
    }

    .me-2 {
        margin-right: 0.5rem;
    }

    @media (max-width: 768px) {
        .row {
            flex-direction: column;
            gap: 0;
        }

        .form-card {
            padding: 20px;
        }
        
        .image-preview {
            max-height: 200px;
        }
    }
</style>

<script>
    // Script pour effacer les erreurs en temps réel
    const formGroups = document.querySelectorAll('.form-group[data-field]');
    
    formGroups.forEach(group => {
        const input = group.querySelector('input, textarea, select');
        if (input) {
            input.addEventListener('input', function() {
                group.classList.remove('has-error');
                const errorMsg = group.querySelector('.error-message');
                if (errorMsg) {
                    errorMsg.remove();
                }
            });
        }
    });

    // Script pour l'upload d'image
    const uploadArea = document.getElementById('uploadArea');
    const imageInput = document.getElementById('imageInput');
    const imagePreview = document.getElementById('imagePreview');

    if (uploadArea) {
        uploadArea.addEventListener('click', () => {
            imageInput.click();
        });

        imageInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    imagePreview.innerHTML = '<img src="' + e.target.result + '" class="image-preview">';
                    uploadArea.style.display = 'none';
                };
                reader.readAsDataURL(file);
            }
        });

        uploadArea.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadArea.style.borderColor = '#93032E';
            uploadArea.style.background = '#FFF5F0';
        });

        uploadArea.addEventListener('dragleave', () => {
            uploadArea.style.borderColor = '#93032E';
            uploadArea.style.background = 'white';
        });

        uploadArea.addEventListener('drop', (e) => {
            e.preventDefault();
            const file = e.dataTransfer.files[0];
            if (file && file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    imagePreview.innerHTML = '<img src="' + e.target.result + '" class="image-preview">';
                    uploadArea.style.display = 'none';
                };
                reader.readAsDataURL(file);
                imageInput.files = e.dataTransfer.files;
            }
            uploadArea.style.borderColor = '#93032E';
            uploadArea.style.background = 'white';
        });
    }
</script>
{% endblock %}