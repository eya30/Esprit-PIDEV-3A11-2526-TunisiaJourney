<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Réservations - {{ activite.Titre }} - {{ generated_at|date('d/m/Y') }}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: DejaVu Sans, sans-serif;
            font-size: 10.5px;
            color: #1a1a1a;
            background: #ffffff;
            padding: 32px 36px;
            line-height: 1.5;
        }

        /* ── En-tête ─────────────────────────────────────────────────────── */
        .header-table {
            width: 100%;
            margin-bottom: 10px;
        }
        .header-title {
            font-size: 17px;
            font-weight: bold;
            color: #344D59;
            letter-spacing: 0.4px;
        }
        .header-date {
            font-size: 10px;
            color: #6b7280;
            text-align: right;
            vertical-align: top;
            padding-top: 3px;
        }

        /* Ligne séparatrice fine */
        .divider {
            border: none;
            border-top: 1.5px solid #d1d5db;
            margin-bottom: 18px;
        }

        /* ── Tableau ─────────────────────────────────────────────────────── */
        table.data {
            width: 100%;
            border-collapse: collapse;
        }

        table.data thead tr {
            border-bottom: 1.5px solid #4b5563;
        }

        /* En-têtes des colonnes en ROUGE */
        table.data th {
            font-size: 9px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            color: #CC0000;
            padding: 8px 10px;
            text-align: left;
        }

        table.data td {
            padding: 10px 10px;
            vertical-align: top;
            border-bottom: 0.5px solid #e5e7eb;
            font-size: 10px;
            color: #1a1a1a;
            line-height: 1.5;
        }

        table.data tbody tr:nth-child(even) td {
            background-color: #fafafa;
        }

        /* Client */
        .cell-client {
            font-weight: bold;
            font-size: 10px;
            color: #111827;
        }

        /* Email / Téléphone */
        .cell-contact {
            font-size: 9.5px;
            color: #374151;
        }

        /* Date réservation */
        .cell-date {
            font-size: 9.5px;
            color: #374151;
            white-space: nowrap;
        }

        /* Nb places */
        .cell-places {
            font-weight: bold;
            color: #547D54;
            text-align: center;
        }

        /* Prix total */
        .cell-prix {
            font-weight: bold;
            color: #CC0000;
            font-size: 10px;
        }

        /* Activité réservée */
        .cell-activite {
            font-weight: bold;
            font-size: 10px;
            color: #111827;
        }

        /* ── Pied de page ────────────────────────────────────────────────── */
        .footer-divider {
            border: none;
            border-top: 0.5px solid #e5e7eb;
            margin-top: 18px;
            margin-bottom: 8px;
        }
        .footer-table {
            width: 100%;
        }
        .footer-left {
            font-size: 8.5px;
            color: #9ca3af;
        }
        .footer-right {
            font-size: 9px;
            font-weight: bold;
            color: #374151;
            text-align: right;
        }
    </style>
</head>
<body>

    {# ── En-tête ──────────────────────────────────────────────────────────── #}
    <table class="header-table" cellpadding="0" cellspacing="0">
        <tr>
            <td>
                <span class="header-title">RÉSERVATIONS · {{ activite.Titre|upper }}</span>
            </td>
            <td class="header-date">
                Document généré le {{ generated_at|date('d/m/Y à H:i') }}
            </td>
        </tr>
    </table>
    <hr class="divider">

    {# ── Tableau ──────────────────────────────────────────────────────────── #}
    <table class="data">
        <thead>
            <tr>
                <th style="width:15%">Client</th>
                <th style="width:15%">Email</th>
                <th style="width:10%">Téléphone</th>
                <th style="width:12%">Date réservation</th>
                <th style="width:8%">Nb places</th>
                <th style="width:10%">Prix total</th>
                <th style="width:20%">Activité réservée</th>
            </tr>
        </thead>
        <tbody>
            {% if reservations is empty %}
                <tr>
                    <td colspan="7" style="text-align:center; padding:24px; color:#9ca3af;">
                        Aucune réservation à afficher.
                    </td>
                </tr>
            {% else %}
                {% for reservation in reservations %}
                <tr>
                    <td class="cell-client">
                        {{ reservation.Prenom }} {{ reservation.Nom }}
                    </td>
                    <td class="cell-contact">
                        {{ reservation.email }}
                    </td>
                    <td class="cell-contact">
                        {{ reservation.telephone }}
                    </td>
                    <td class="cell-date">
                        {{ reservation.DateReservation|date('d/m/Y') }}
                    </td>
                    <td class="cell-places">
                        {{ reservation.NombrePlaces }} pers
                    </td>
                    <td class="cell-prix">
                        {{ reservation.Prix|number_format(2, ',', ' ') }} DT
                    </td>
                    <td class="cell-activite">
                        {{ activite.Titre }}
                    </td>
                </tr>
                {% endfor %}
            {% endif %}
        </tbody>
    </table>

    {# ── Pied de page ─────────────────────────────────────────────────────── #}
    <hr class="footer-divider">
    <table class="footer-table" cellpadding="0" cellspacing="0">
        <tr>
            <td class="footer-left">
                Toute modification manuelle est non autorisée. · Gestion des Réservations · Direction des Arts et de la Culture · Tunisie
            </td>
            <td class="footer-right">
                Nombre total de réservations : {{ reservations|length }}
            </td>
        </tr>
    </table>

</body>
</html>