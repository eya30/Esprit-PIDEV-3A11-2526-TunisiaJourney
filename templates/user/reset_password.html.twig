{# templates/user/reset_password.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TunisiaJourney — Nouveau mot de passe</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --rouge:    #A0231F;
      --rouge-vif:#C0392B;
      --nuit:     #1A2E4A;
      --sable-cl: #FDF6EC;
      --blanc:    #FFFFFF;
      --gris:     #A0A0A0;
      --vert:     #2E7D32;
    }
    html, body { height: 100%; width: 100%; margin: 0; }

    .auth-wrapper { width: 100vw; height: 100vh; display: flex; overflow: hidden; background: var(--blanc); }

    /* ── Overlay gauche ── */
    .auth-overlay {
      width: 45%; height: 100%;
      background: linear-gradient(150deg, #C94040 0%, #A0231F 45%, #2A1010 100%);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 40px 30px; text-align: center; position: relative; overflow: hidden;
    }
    .overlay-circles { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
    .overlay-circles span { position: absolute; border-radius: 50%; background: rgba(255,255,255,.07); animation: floatCircle linear infinite; }
    .overlay-circles span:nth-child(1) { width:200px;height:200px;top:-60px;left:-60px;animation-duration:8s; }
    .overlay-circles span:nth-child(2) { width:140px;height:140px;top:60%;left:60%;animation-duration:11s;animation-delay:-3s; }
    .overlay-circles span:nth-child(3) { width:90px;height:90px;top:30%;left:10%;animation-duration:7s;animation-delay:-1.5s; }
    .overlay-circles span:nth-child(4) { width:60px;height:60px;top:70%;left:20%;animation-duration:9s;animation-delay:-4s; }
    .overlay-circles span:nth-child(5) { width:110px;height:110px;top:10%;left:55%;animation-duration:13s;animation-delay:-2s; }
    @keyframes floatCircle {
      0%   { transform: translate(0,0) scale(1); }
      25%  { transform: translate(18px,-22px) scale(1.06); }
      50%  { transform: translate(-12px,16px) scale(.94); }
      75%  { transform: translate(20px,8px) scale(1.03); }
      100% { transform: translate(0,0) scale(1); }
    }
    .overlay-logo-ring {
      width: 110px; height: 110px; border-radius: 50%;
      border: 2px solid rgba(255,255,255,.35); background: rgba(255,255,255,.1);
      display: flex; align-items: center; justify-content: center; margin-bottom: 18px;
      box-shadow: 0 0 0 6px rgba(255,255,255,.06), 0 4px 18px rgba(0,0,0,.2);
      overflow: hidden; animation: pulseLogo 4s ease-in-out infinite; position: relative; z-index: 1;
    }
    .overlay-logo-ring img { width: 100px; height: 100px; border-radius: 50%; object-fit: cover; }
    @keyframes pulseLogo {
      0%,100% { box-shadow: 0 0 0 6px rgba(255,255,255,.06), 0 4px 18px rgba(0,0,0,.2); }
      50%      { box-shadow: 0 0 0 10px rgba(255,255,255,.10), 0 4px 22px rgba(0,0,0,.28); }
    }
    .overlay-brand { position: relative; z-index: 1; margin-bottom: 24px; }
    .overlay-brand .brand-main { font-family: 'Playfair Display', serif; color: var(--blanc); font-size: 2.6rem; font-weight: 700; line-height: 1.1; display: block; animation: pulseBrand 3.5s ease-in-out infinite; }
    .overlay-brand .brand-sub { color: rgba(255,255,255,.7); font-size: .8rem; letter-spacing: 1.5px; display: block; margin-top: 4px; }
    @keyframes pulseBrand { 0%,100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.08); opacity: .82; } }

    /* Icône cadenas animée */
    .lock-anim {
      position: relative; z-index: 1; margin-bottom: 24px;
      width: 80px; height: 80px; background: rgba(255,255,255,.15); border-radius: 20px;
      display: flex; align-items: center; justify-content: center;
      animation: floatLock 3s ease-in-out infinite;
    }
    @keyframes floatLock { 0%,100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-8px) rotate(-5deg); } }
    .lock-anim svg { width: 38px; height: 38px; color: white; }

    .overlay-title { font-family: 'Playfair Display', serif; color: var(--blanc); font-size: 1.7rem; line-height: 1.3; margin-bottom: 10px; position: relative; z-index: 1; }
    .overlay-desc  { color: rgba(255,255,255,.75); font-size: .83rem; margin-bottom: 26px; position: relative; z-index: 1; }
    .btn-overlay {
      display: inline-block; padding: 10px 30px;
      border: 2px solid var(--blanc); border-radius: 50px;
      color: var(--blanc); font-family: 'DM Sans', sans-serif; font-size: .88rem; font-weight: 600;
      cursor: pointer; background: transparent; transition: background .28s, color .28s;
      text-decoration: none; position: relative; z-index: 1;
    }
    .btn-overlay:hover { background: var(--blanc); color: var(--rouge); }

    /* ── Formulaire droit ── */
    .auth-form-panel { width: 55%; height: 100%; display: flex; flex-direction: column; justify-content: center; padding: 70px 70px; background: var(--blanc); }

    .back-link { display: inline-flex; align-items: center; gap: 6px; color: var(--gris); font-size: .8rem; text-decoration: none; margin-bottom: 32px; transition: color .2s; }
    .back-link:hover { color: var(--rouge); }
    .back-link svg { width: 14px; height: 14px; }

    h1 { font-family: 'Playfair Display', serif; font-size: 2rem; color: var(--nuit); margin-bottom: 4px; }
    .form-subtitle { color: var(--rouge); font-size: .95rem; margin-bottom: 24px; }

    .form-group { margin-bottom: 14px; }
    .form-group label { display: block; font-size: .9rem; font-weight: 500; color: var(--nuit); margin-bottom: 6px; }
    .input-wrapper { position: relative; }
    .input-wrapper input {
      width: 100%; padding: 14px 45px 14px 16px;
      border: 1.5px solid #E0E0E0; border-radius: 12px;
      font-family: 'DM Sans', sans-serif; font-size: 1rem; color: #333;
      background: var(--sable-cl); outline: none; transition: border-color .22s, background .22s;
    }
    .input-wrapper input:focus { border-color: var(--rouge); background: var(--blanc); }
    .input-wrapper.has-error input { border-color: var(--rouge-vif) !important; background: #FFF5F5; }
    .input-icon { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); color: #bbb; display: flex; align-items: center; }
    .input-icon svg { width: 16px; height: 16px; }
    .input-icon.toggle-eye { cursor: pointer; pointer-events: auto; }
    .input-icon.toggle-eye:hover { color: var(--rouge); }
    .field-error { display: block; font-size: .78rem; color: var(--rouge-vif); margin-top: 5px; font-weight: 500; }

    /* Barre de force du mot de passe */
    .strength-bar { margin-top: 8px; }
    .strength-track { height: 4px; background: #E0E0E0; border-radius: 4px; overflow: hidden; }
    .strength-fill { height: 100%; border-radius: 4px; width: 0%; transition: width .3s, background .3s; }
    .strength-label { font-size: .72rem; color: var(--gris); margin-top: 4px; }

    .btn-primary {
      width: 100%; padding: 14px;
      background: linear-gradient(90deg, var(--rouge) 0%, var(--rouge-vif) 100%);
      color: var(--blanc); border: none; border-radius: 50px;
      font-family: 'DM Sans', sans-serif; font-size: 1.05rem; font-weight: 600;
      cursor: pointer; box-shadow: 0 5px 16px rgba(160,35,31,.3);
      transition: transform .18s, box-shadow .18s; margin-top: 8px;
    }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(160,35,31,.42); }
    .btn-primary:active { transform: translateY(0); }
    .btn-primary:disabled { opacity: .6; cursor: not-allowed; transform: none; }

    .alert { padding: 12px 14px; border-radius: 10px; font-size: .84rem; margin-bottom: 16px; display: flex; align-items: flex-start; gap: 10px; }
    .alert svg { width: 18px; height: 18px; flex-shrink: 0; margin-top: 1px; }
    .alert-error   { background: #FDECEA; color: var(--rouge-vif); border-left: 4px solid var(--rouge-vif); }
    .alert-success { background: #E8F5E9; color: var(--vert); border-left: 4px solid var(--vert); }

    /* Token invalide / expiré */
    .expired-state { text-align: center; padding: 20px 0; }
    .expired-icon { width: 80px; height: 80px; border-radius: 50%; background: #FDECEA; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; }
    .expired-icon svg { width: 36px; height: 36px; color: var(--rouge-vif); }
    .expired-state h2 { font-family: 'Playfair Display', serif; color: var(--nuit); font-size: 1.6rem; margin-bottom: 10px; }
    .expired-state p { color: var(--gris); font-size: .88rem; line-height: 1.6; margin-bottom: 24px; }

    .requirements { background: var(--sable-cl); border-radius: 10px; padding: 12px 14px; margin-bottom: 14px; font-size: .78rem; color: var(--nuit); }
    .requirements ul { list-style: none; display: flex; flex-direction: column; gap: 5px; }
    .requirements li { display: flex; align-items: center; gap: 7px; }
    .requirements li .dot { width: 6px; height: 6px; border-radius: 50%; background: #ccc; flex-shrink: 0; transition: background .3s; }
    .requirements li.ok .dot { background: var(--vert); }
    .requirements li.ok { color: var(--vert); }

    @media (max-width: 680px) {
      .auth-overlay { display: none; }
      .auth-form-panel { width: 100%; padding: 36px 24px; }
    }
  </style>
</head>
<body>

<div class="auth-wrapper">

  {# ── Overlay gauche ── #}
  <div class="auth-overlay">
    <div class="overlay-circles"><span></span><span></span><span></span><span></span><span></span></div>
    <div class="overlay-logo-ring">
      <img src="{{ asset('images/logo.png') }}" alt="TunisiaJourney" referrerpolicy="no-referrer">
    </div>
    <div class="overlay-brand">
      <span class="brand-main">Tunisia<span style="opacity:.75">Journey</span></span>
      <span class="brand-sub">DÉCOUVREZ LA TUNISIE</span>
    </div>
    <div class="lock-anim">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
    </div>
    <h2 class="overlay-title">Nouveau<br>mot de passe</h2>
    <p class="overlay-desc">Choisissez un mot de passe fort et unique pour sécuriser votre compte.</p>
    <a href="{{ path('app_login') }}" class="btn-overlay">← Retour à la connexion</a>
  </div>

  {# ── Panneau droit ── #}
  <div class="auth-form-panel">

    <a href="{{ path('app_login') }}" class="back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
      Retour à la connexion
    </a>

    {% if invalid %}
      {# ── Token invalide ou expiré ── #}
      <div class="expired-state">
        <div class="expired-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        </div>
        <h2>Lien expiré&nbsp;!</h2>
        <p>Ce lien de réinitialisation est invalide ou a expiré.<br>Les liens sont valables <strong>1 heure</strong>.</p>
        <a href="{{ path('app_forgot_password') }}" class="btn-primary" style="display:inline-block;text-decoration:none;text-align:center;max-width:320px;margin:0 auto;">
          Demander un nouveau lien
        </a>
      </div>

    {% else %}
      {# ── Formulaire de reset ── #}
      <h1>Nouveau mot de passe</h1>
      <p class="form-subtitle">Choisissez un mot de passe sécurisé</p>

      {% for msg in app.flashes('reset_error') %}
        <div class="alert alert-error">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          {{ msg }}
        </div>
      {% endfor %}

      <div class="requirements">
        <ul>
          <li id="req-len"><span class="dot"></span>Au moins 8 caractères</li>
          <li id="req-upper"><span class="dot"></span>Une majuscule</li>
          <li id="req-num"><span class="dot"></span>Un chiffre</li>
        </ul>
      </div>

      <form method="POST" action="{{ path('app_reset_password', {token: token}) }}" id="resetForm">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password') }}">

        <div class="form-group">
          <label for="new_password">Nouveau mot de passe</label>
          <div class="input-wrapper">
            <input type="password" id="new_password" name="new_password" placeholder="••••••••" required autofocus>
            <span class="input-icon toggle-eye" onclick="togglePwd('new_password', this)">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </span>
          </div>
          <div class="strength-bar">
            <div class="strength-track"><div class="strength-fill" id="strengthFill"></div></div>
            <div class="strength-label" id="strengthLabel">Entrez un mot de passe</div>
          </div>
        </div>

        <div class="form-group">
          <label for="confirm_password">Confirmer le mot de passe</label>
          <div class="input-wrapper" id="confirmWrapper">
            <input type="password" id="confirm_password" name="confirm_password" placeholder="••••••••" required>
            <span class="input-icon toggle-eye" onclick="togglePwd('confirm_password', this)">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </span>
          </div>
          <span class="field-error" id="matchError" style="display:none">Les mots de passe ne correspondent pas</span>
        </div>

        <button type="submit" class="btn-primary" id="submitBtn">
          Enregistrer le nouveau mot de passe
        </button>
      </form>
    {% endif %}

  </div>
</div>

<script>
  window.togglePwd = function(id, span) {
    const input = document.getElementById(id);
    const svg   = span.querySelector('svg');
    const eyeOpen   = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
    const eyeClosed = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/>';
    if (input.type === 'password') { input.type = 'text'; svg.innerHTML = eyeClosed; }
    else { input.type = 'password'; svg.innerHTML = eyeOpen; }
  };

  // ── Barre de force ──
  const pwdInput    = document.getElementById('new_password');
  const fillEl      = document.getElementById('strengthFill');
  const labelEl     = document.getElementById('strengthLabel');
  const reqLen      = document.getElementById('req-len');
  const reqUpper    = document.getElementById('req-upper');
  const reqNum      = document.getElementById('req-num');

  if (pwdInput) {
    pwdInput.addEventListener('input', function() {
      const v = this.value;
      let score = 0;
      const hasLen   = v.length >= 8;
      const hasUpper = /[A-Z]/.test(v);
      const hasNum   = /[0-9]/.test(v);

      reqLen.classList.toggle('ok', hasLen);
      reqUpper.classList.toggle('ok', hasUpper);
      reqNum.classList.toggle('ok', hasNum);

      if (hasLen)   score++;
      if (hasUpper) score++;
      if (hasNum)   score++;
      if (v.length >= 12) score++;

      const levels = [
        { pct: '0%',   color: '#ccc',    label: 'Entrez un mot de passe' },
        { pct: '25%',  color: '#E53935', label: 'Très faible' },
        { pct: '50%',  color: '#FB8C00', label: 'Faible' },
        { pct: '75%',  color: '#FDD835', label: 'Moyen' },
        { pct: '100%', color: '#43A047', label: 'Fort 💪' },
      ];
      const lvl = levels[v.length === 0 ? 0 : score];
      fillEl.style.width    = lvl.pct;
      fillEl.style.background = lvl.color;
      labelEl.textContent   = lvl.label;
    });
  }

  // ── Vérification correspondance ──
  const confirmInput = document.getElementById('confirm_password');
  const matchError   = document.getElementById('matchError');
  const confirmWrap  = document.getElementById('confirmWrapper');

  if (confirmInput) {
    confirmInput.addEventListener('input', function() {
      const match = this.value === pwdInput.value;
      matchError.style.display  = match || !this.value ? 'none' : 'block';
      confirmWrap.classList.toggle('has-error', !match && !!this.value);
    });
  }

  // ── Bloquer submit si pas valide ──
  document.getElementById('resetForm')?.addEventListener('submit', function(e) {
    if (pwdInput.value !== confirmInput.value) {
      e.preventDefault();
      matchError.style.display = 'block';
      confirmWrap.classList.add('has-error');
      return;
    }
    const btn = document.getElementById('submitBtn');
    btn.disabled = true;
    btn.textContent = 'Enregistrement…';
  });
</script>

</body>
</html>
