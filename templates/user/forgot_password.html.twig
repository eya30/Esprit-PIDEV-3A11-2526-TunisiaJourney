{# templates/user/forgot_password.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TunisiaJourney — Mot de passe oublié</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --rouge:    #A0231F;
      --rouge-vif:#C0392B;
      --nuit:     #1A2E4A;
      --sable-cl: #FDF6EC;
      --blanc:    #FFFFFF;
      --gris:     #A0A0A0;
    }
    html, body { height: 100%; width: 100%; margin: 0; }

    .auth-wrapper {
      width: 100vw; height: 100vh;
      display: flex; overflow: hidden;
      background: var(--blanc);
    }

    /* ── Panneau gauche : overlay rouge ── */
    .auth-overlay {
      width: 45%; height: 100%;
      background: linear-gradient(150deg, #C94040 0%, #A0231F 45%, #2A1010 100%);
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      padding: 40px 30px; text-align: center;
      position: relative; overflow: hidden;
    }
    .overlay-circles { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
    .overlay-circles span {
      position: absolute; border-radius: 50%;
      background: rgba(255,255,255,.07); animation: floatCircle linear infinite;
    }
    .overlay-circles span:nth-child(1) { width:200px;height:200px;top:-60px;left:-60px;animation-duration:8s; }
    .overlay-circles span:nth-child(2) { width:140px;height:140px;top:60%;left:60%;animation-duration:11s;animation-delay:-3s; }
    .overlay-circles span:nth-child(3) { width:90px;height:90px;top:30%;left:10%;animation-duration:7s;animation-delay:-1.5s; }
    .overlay-circles span:nth-child(4) { width:60px;height:60px;top:70%;left:20%;animation-duration:9s;animation-delay:-4s; }
    .overlay-circles span:nth-child(5) { width:110px;height:110px;top:10%;left:55%;animation-duration:13s;animation-delay:-2s; }
    @keyframes floatCircle {
      0%   { transform: translate(0,0) scale(1); }
      25%  { transform: translate(18px,-22px) scale(1.06); }
      50%  { transform: translate(-12px,16px) scale(.94); }
      75%  { transform: translate(20px,8px) scale(1.03); }
      100% { transform: translate(0,0) scale(1); }
    }
    .overlay-logo-ring {
      width: 110px; height: 110px; border-radius: 50%;
      border: 2px solid rgba(255,255,255,.35); background: rgba(255,255,255,.1);
      display: flex; align-items: center; justify-content: center; margin-bottom: 18px;
      box-shadow: 0 0 0 6px rgba(255,255,255,.06), 0 4px 18px rgba(0,0,0,.2);
      overflow: hidden; animation: pulseLogo 4s ease-in-out infinite;
      position: relative; z-index: 1;
    }
    .overlay-logo-ring img { width: 100px; height: 100px; border-radius: 50%; object-fit: cover; }
    @keyframes pulseLogo {
      0%,100% { box-shadow: 0 0 0 6px rgba(255,255,255,.06), 0 4px 18px rgba(0,0,0,.2); }
      50%      { box-shadow: 0 0 0 10px rgba(255,255,255,.10), 0 4px 22px rgba(0,0,0,.28); }
    }
    .overlay-brand { position: relative; z-index: 1; margin-bottom: 24px; }
    .overlay-brand .brand-main {
      font-family: 'Playfair Display', serif; color: var(--blanc);
      font-size: 2.6rem; font-weight: 700; line-height: 1.1; display: block;
      animation: pulseBrand 3.5s ease-in-out infinite;
    }
    .overlay-brand .brand-sub {
      color: rgba(255,255,255,.7); font-size: .8rem; letter-spacing: 1.5px;
      display: block; margin-top: 4px;
    }
    @keyframes pulseBrand {
      0%,100% { transform: scale(1); opacity: 1; }
      50%      { transform: scale(1.08); opacity: .82; }
    }
    .overlay-title {
      font-family: 'Playfair Display', serif; color: var(--blanc);
      font-size: 1.7rem; line-height: 1.3; margin-bottom: 10px;
      position: relative; z-index: 1;
    }
    .overlay-desc { color: rgba(255,255,255,.75); font-size: .83rem; margin-bottom: 26px; position: relative; z-index: 1; }

    /* Icône envelope animée */
    .envelope-anim {
      position: relative; z-index: 1; margin-bottom: 24px;
      width: 80px; height: 80px;
      background: rgba(255,255,255,.15); border-radius: 20px;
      display: flex; align-items: center; justify-content: center;
      animation: floatEnv 3s ease-in-out infinite;
    }
    @keyframes floatEnv {
      0%,100% { transform: translateY(0); }
      50%      { transform: translateY(-8px); }
    }
    .envelope-anim svg { width: 40px; height: 40px; color: white; }

    .btn-overlay {
      display: inline-block; padding: 10px 30px;
      border: 2px solid var(--blanc); border-radius: 50px;
      color: var(--blanc); font-family: 'DM Sans', sans-serif; font-size: .88rem; font-weight: 600;
      cursor: pointer; background: transparent; transition: background .28s, color .28s;
      text-decoration: none; position: relative; z-index: 1;
    }
    .btn-overlay:hover { background: var(--blanc); color: var(--rouge); }

    /* ── Panneau droit : formulaire ── */
    .auth-form-panel {
      width: 55%; height: 100%;
      display: flex; flex-direction: column;
      justify-content: center; padding: 70px 70px;
      background: var(--blanc);
    }
    .back-link {
      display: inline-flex; align-items: center; gap: 6px;
      color: var(--gris); font-size: .8rem; text-decoration: none;
      margin-bottom: 32px; transition: color .2s;
    }
    .back-link:hover { color: var(--rouge); }
    .back-link svg { width: 14px; height: 14px; }

    h1 { font-family: 'Playfair Display', serif; font-size: 2rem; color: var(--nuit); margin-bottom: 4px; }
    .form-subtitle { color: var(--rouge); font-size: .95rem; margin-bottom: 8px; }
    .form-hint { color: var(--gris); font-size: .82rem; margin-bottom: 24px; line-height: 1.5; }

    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-size: .9rem; font-weight: 500; color: var(--nuit); margin-bottom: 6px; }
    .input-wrapper { position: relative; }
    .input-wrapper input {
      width: 100%; padding: 14px 45px 14px 16px;
      border: 1.5px solid #E0E0E0; border-radius: 12px;
      font-family: 'DM Sans', sans-serif; font-size: 1rem; color: #333;
      background: var(--sable-cl); outline: none;
      transition: border-color .22s, background .22s;
    }
    .input-wrapper input:focus { border-color: var(--rouge); background: var(--blanc); }
    .input-icon { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); color: #bbb; display: flex; align-items: center; }
    .input-icon svg { width: 16px; height: 16px; }

    .btn-primary {
      width: 100%; padding: 14px;
      background: linear-gradient(90deg, var(--rouge) 0%, var(--rouge-vif) 100%);
      color: var(--blanc); border: none; border-radius: 50px;
      font-family: 'DM Sans', sans-serif; font-size: 1.05rem; font-weight: 600;
      cursor: pointer; box-shadow: 0 5px 16px rgba(160,35,31,.3);
      transition: transform .18s, box-shadow .18s; margin-top: 4px;
    }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(160,35,31,.42); }
    .btn-primary:active { transform: translateY(0); }
    .btn-primary:disabled { opacity: .6; cursor: not-allowed; transform: none; }

    .alert { padding: 12px 14px; border-radius: 10px; font-size: .84rem; margin-bottom: 16px; display: flex; align-items: flex-start; gap: 10px; }
    .alert svg { width: 18px; height: 18px; flex-shrink: 0; margin-top: 1px; }
    .alert-error   { background: #FDECEA; color: var(--rouge-vif); border-left: 4px solid var(--rouge-vif); }
    .alert-success { background: #E8F5E9; color: #2E7D32; border-left: 4px solid #2E7D32; }

    /* État "email envoyé" */
    .success-state { display: none; text-align: center; padding: 20px 0; }
    .success-state.visible { display: block; }
    .success-icon {
      width: 80px; height: 80px; border-radius: 50%;
      background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 20px; animation: popIn .4s cubic-bezier(.34,1.56,.64,1);
    }
    @keyframes popIn {
      from { transform: scale(0); opacity: 0; }
      to   { transform: scale(1); opacity: 1; }
    }
    .success-icon svg { width: 36px; height: 36px; color: #2E7D32; }
    .success-state h2 { font-family: 'Playfair Display', serif; color: var(--nuit); font-size: 1.6rem; margin-bottom: 10px; }
    .success-state p { color: var(--gris); font-size: .88rem; line-height: 1.6; margin-bottom: 24px; }
    .success-state .email-highlight { color: var(--nuit); font-weight: 600; }

    .resend-link { font-size: .78rem; color: var(--gris); margin-top: 14px; }
    .resend-link a { color: var(--rouge); cursor: pointer; font-weight: 600; text-decoration: none; }
    .resend-link a:hover { text-decoration: underline; }

    @media (max-width: 680px) {
      .auth-overlay { display: none; }
      .auth-form-panel { width: 100%; padding: 36px 24px; }
    }
  </style>
</head>
<body>

<div class="auth-wrapper">

  {# ── Panneau gauche ── #}
  <div class="auth-overlay">
    <div class="overlay-circles"><span></span><span></span><span></span><span></span><span></span></div>

    <div class="overlay-logo-ring">
      <img src="{{ asset('images/logo.png') }}" alt="TunisiaJourney" referrerpolicy="no-referrer">
    </div>

    <div class="overlay-brand">
      <span class="brand-main">Tunisia<span style="opacity:.75">Journey</span></span>
      <span class="brand-sub">DÉCOUVREZ LA TUNISIE</span>
    </div>

    <div class="envelope-anim">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
        <polyline points="22,6 12,13 2,6"/>
      </svg>
    </div>

    <h2 class="overlay-title">Réinitialisation<br>sécurisée</h2>
    <p class="overlay-desc">Un lien vous sera envoyé par email pour créer un nouveau mot de passe.</p>

    <a href="{{ path('app_login') }}" class="btn-overlay">← Retour à la connexion</a>
  </div>

  {# ── Panneau droit : formulaire ── #}
  <div class="auth-form-panel">

    <a href="{{ path('app_login') }}" class="back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
      Retour à la connexion
    </a>

    {# ── Formulaire (caché après envoi) ── #}
    <div id="formSection">
      <h1>Mot de passe oublié&nbsp;?</h1>
      <p class="form-subtitle">Pas de panique, ça arrive !</p>
      <p class="form-hint">Entrez votre adresse email et nous vous enverrons un lien pour réinitialiser votre mot de passe.</p>

      {% for msg in app.flashes('reset_error') %}
        <div class="alert alert-error">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          {{ msg }}
        </div>
      {% endfor %}

      <form method="POST" action="{{ path('app_forgot_password') }}" id="forgotForm">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password') }}">

        <div class="form-group">
          <label for="email">Adresse email</label>
          <div class="input-wrapper">
            <input
              type="email"
              id="email"
              name="email"
              placeholder="exemple@email.com"
              required
              autofocus
              value="{{ prefill_email ?? '' }}"
            >
            <span class="input-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </span>
          </div>
        </div>

        <button type="submit" class="btn-primary" id="submitBtn">
          Envoyer le lien de réinitialisation
        </button>
      </form>
    </div>

    {# ── État succès (affiché si email envoyé) ── #}
    <div class="success-state {% if sent %}visible{% endif %}" id="successSection">
      <div class="success-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <h2>Email envoyé&nbsp;!</h2>
      <p>
        Si un compte existe avec l'adresse<br>
        <span class="email-highlight">{{ sent_email ?? '' }}</span><br><br>
        vous recevrez un lien de réinitialisation dans quelques minutes.<br>
        <strong>Vérifiez aussi vos spams.</strong>
      </p>
      <a href="{{ path('app_login') }}" class="btn-primary" style="display:inline-block;text-decoration:none;text-align:center;max-width:320px;margin:0 auto;">
        Retour à la connexion
      </a>
      <p class="resend-link">
        Vous n'avez pas reçu l'email&nbsp;?
        <a href="{{ path('app_forgot_password') }}">Renvoyer</a>
      </p>
    </div>

  </div>
</div>

<script>
  // Désactiver le bouton pendant l'envoi pour éviter double-clic
  document.getElementById('forgotForm')?.addEventListener('submit', function() {
    const btn = document.getElementById('submitBtn');
    btn.disabled = true;
    btn.textContent = 'Envoi en cours…';
  });

  {% if sent %}
    document.getElementById('formSection').style.display = 'none';
    document.getElementById('successSection').classList.add('visible');
  {% endif %}
</script>

</body>
</html>
