{# templates/user/auth.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TunisiaJourney — {% if mode == 'register' %}Inscription{% else %}Connexion{% endif %}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --rouge:      #A0231F;
      --rouge-vif:  #C0392B;
      --nuit:       #1A2E4A;
      --sable:      #F5EDD8;
      --sable-cl:   #FDF6EC;
      --blanc:      #FFFFFF;
      --gris:       #A0A0A0;
      --trans:      0.65s cubic-bezier(.76,0,.24,1);
    }

    html, body { height: 100%; width: 100%; margin: 0; }

    .auth-splash {
      position: fixed; inset: 0;
      background: var(--rouge); z-index: 9999;
      transform: scaleX(0); transform-origin: left center;
      pointer-events: none;
      transition: transform .5s cubic-bezier(.76,0,.24,1);
    }
    .auth-splash.splash-in  { pointer-events: auto; transform: scaleX(1); }
    .auth-splash.splash-out { transform-origin: right center; transform: scaleX(0); }

    .auth-wrapper { width: 100vw; height: 100vh; border-radius: 0; position: relative; overflow: hidden; background: var(--blanc); }

    .auth-form-panel {
      position: absolute; top: 0; height: 100%; width: 50%;
      background: var(--blanc); display: flex; flex-direction: column;
      justify-content: center; padding: 70px 60px;
      transition: opacity .3s ease, visibility .3s ease; z-index: 2;
    }
    .auth-form-panel.login-panel    { right: 0; }
    .auth-form-panel.register-panel { left: 0; opacity: 0; visibility: hidden; }
    .auth-wrapper.register-mode .login-panel    { opacity: 0; visibility: hidden; }
    .auth-wrapper.register-mode .register-panel { opacity: 1; visibility: visible; }

    .auth-overlay {
      position: absolute; top: 0; left: 0; width: 50%; height: 100%;
      background: linear-gradient(150deg, #C94040 0%, #A0231F 45%, #2A1010 100%);
      border-radius: 0 18px 18px 0; z-index: 10;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 40px 30px; text-align: center; overflow: hidden;
      transition: left var(--trans);
    }
    .auth-wrapper.register-mode .auth-overlay { left: 50%; border-radius: 18px 0 0 18px; }

    .overlay-circles { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
    .overlay-circles span {
      position: absolute; border-radius: 50%;
      background: rgba(255,255,255,.07); animation: floatCircle linear infinite;
    }
    .overlay-circles span:nth-child(1) { width:200px;height:200px;top:-60px;left:-60px;animation-duration:8s; }
    .overlay-circles span:nth-child(2) { width:140px;height:140px;top:60%;left:60%;animation-duration:11s;animation-delay:-3s; }
    .overlay-circles span:nth-child(3) { width:90px;height:90px;top:30%;left:10%;animation-duration:7s;animation-delay:-1.5s; }
    .overlay-circles span:nth-child(4) { width:60px;height:60px;top:70%;left:20%;animation-duration:9s;animation-delay:-4s; }
    .overlay-circles span:nth-child(5) { width:110px;height:110px;top:10%;left:55%;animation-duration:13s;animation-delay:-2s; }
    @keyframes floatCircle {
      0%   { transform: translate(0,0) scale(1); }
      25%  { transform: translate(18px,-22px) scale(1.06); }
      50%  { transform: translate(-12px,16px) scale(.94); }
      75%  { transform: translate(20px,8px) scale(1.03); }
      100% { transform: translate(0,0) scale(1); }
    }

    .overlay-logo { position: relative; z-index: 1; margin-bottom: 14px; display: flex; flex-direction: column; align-items: center; }
    .overlay-logo-ring {
      width: 110px; height: 110px; border-radius: 50%;
      border: 2px solid rgba(255,255,255,.35); background: rgba(255,255,255,.1);
      display: flex; align-items: center; justify-content: center; margin-bottom: 10px;
      box-shadow: 0 0 0 6px rgba(255,255,255,.06), 0 4px 18px rgba(0,0,0,.2);
      overflow: hidden; animation: pulseLogo 4s ease-in-out infinite;
    }
    .overlay-logo-ring img { width: 100px; height: 100px; border-radius: 50%; object-fit: cover; }
    @keyframes pulseLogo {
      0%,100% { box-shadow: 0 0 0 6px rgba(255,255,255,.06), 0 4px 18px rgba(0,0,0,.2); }
      50%      { box-shadow: 0 0 0 10px rgba(255,255,255,.10), 0 4px 22px rgba(0,0,0,.28); }
    }

    .overlay-brand { position: relative; z-index: 1; margin-bottom: 18px; }
    .overlay-brand .brand-main {
      font-family: 'Playfair Display', serif; color: var(--blanc);
      font-size: 2.6rem; font-weight: 700; line-height: 1.1; display: block;
      animation: pulseBrand 3.5s ease-in-out infinite;
    }
    .overlay-brand .brand-sub {
      color: rgba(255,255,255,.7); font-size: .8rem; letter-spacing: 1.5px;
      display: block; margin-top: 4px;
      animation: pulseBrand 3.5s ease-in-out infinite; animation-delay: .4s;
    }
    @keyframes pulseBrand {
      0%,100% { transform: scale(1); opacity: 1; }
      50%      { transform: scale(1.08); opacity: .82; }
    }

    .overlay-title { font-family: 'Playfair Display', serif; color: var(--blanc); font-size: 2rem; line-height: 1.2; margin-bottom: 8px; position: relative; z-index: 1; }
    .overlay-desc  { color: rgba(255,255,255,.75); font-size: .83rem; margin-bottom: 22px; position: relative; z-index: 1; }
    .btn-overlay {
      display: inline-block; padding: 10px 30px;
      border: 2px solid var(--blanc); border-radius: 50px;
      color: var(--blanc); font-family: 'DM Sans', sans-serif; font-size: .88rem; font-weight: 600;
      cursor: pointer; background: transparent; transition: background .28s, color .28s; position: relative; z-index: 1;
    }
    .btn-overlay:hover { background: var(--blanc); color: var(--rouge); }

    .auth-form-panel h1 { font-family: 'Playfair Display', serif; font-size: 2rem; color: var(--nuit); margin-bottom: 3px; }
    .auth-form-panel .form-subtitle { color: var(--rouge); font-size: 1rem; margin-bottom: 16px; }

    .form-group { margin-bottom: 10px; }
    .form-group label { display: block; font-size: 0.9rem; font-weight: 500; color: var(--nuit); margin-bottom: 6px; }
    .input-wrapper { position: relative; }
    .input-wrapper input {
      width: 100%; padding: 14px 45px 14px 16px;
      border: 1.5px solid #E0E0E0; border-radius: 12px;
      font-family: 'DM Sans', sans-serif; font-size: 1rem; color: #333;
      background: var(--sable-cl); outline: none;
      -webkit-appearance: none; appearance: none;
      transition: border-color .22s, background .22s;
    }
    .input-wrapper input:focus { border-color: var(--rouge); background: var(--blanc); }
    .input-icon { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: #bbb; display: flex; align-items: center; pointer-events: none; }
    .input-icon svg { width: 16px; height: 16px; }
    .input-icon.toggle-eye { cursor: pointer; pointer-events: auto; }
    .input-icon.toggle-eye:hover { color: var(--rouge); }
    .field-error { display: block; font-size: .72rem; color: var(--rouge-vif); margin-top: 3px; }
    .fields-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 10px; }
    .forgot-link { display: block; text-align: right; font-size: .76rem; color: var(--rouge); text-decoration: none; margin: -4px 0 12px; }
    .forgot-link:hover { text-decoration: underline; }

    .btn-primary {
      width: 100%; padding: 14px;
      background: linear-gradient(90deg, var(--rouge) 0%, var(--rouge-vif) 100%);
      color: var(--blanc); border: none; border-radius: 50px;
      font-family: 'DM Sans', sans-serif; font-size: 1.05rem; font-weight: 600;
      cursor: pointer; box-shadow: 0 5px 16px rgba(160,35,31,.3);
      transition: transform .18s, box-shadow .18s; margin-top: 4px;
    }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(160,35,31,.42); }
    .btn-primary:active { transform: translateY(0); }

    .btn-outline {
      display: inline-block; width: 100%; padding: 14px;
      border: 2px solid var(--rouge); border-radius: 50px;
      background: transparent; color: var(--rouge);
      font-family: 'DM Sans', sans-serif; font-size: 1.05rem; font-weight: 600;
      text-align: center; text-decoration: none; margin-top: 10px;
      transition: all 0.3s ease; cursor: pointer;
    }
    .btn-outline:hover { background: var(--rouge); color: white; }

    .social-sep { text-align: center; font-size: .74rem; color: var(--gris); margin: 10px 0 8px; position: relative; }
    .social-sep::before, .social-sep::after { content:''; position:absolute; top:50%; width:30%; height:1px; background:#E8E8E8; }
    .social-sep::before { left: 0; } .social-sep::after { right: 0; }
    .social-btns { display: flex; gap: 8px; justify-content: center; }
    .btn-social {
      width: 36px; height: 36px; border: 1.5px solid #E0E0E0; border-radius: 8px;
      background: var(--blanc); display: flex; align-items: center; justify-content: center;
      cursor: pointer; font-size: .78rem; font-weight: 700; color: #555; text-decoration: none;
      transition: border-color .2s, color .2s, transform .18s;
    }
    .btn-social:hover { border-color: var(--rouge); color: var(--rouge); transform: translateY(-2px); }

    @keyframes shake {
  0%, 100% { transform: translateX(0); }
  15%       { transform: translateX(-7px); }
  30%       { transform: translateX(7px); }
  45%       { transform: translateX(-5px); }
  60%       { transform: translateX(5px); }
  75%       { transform: translateX(-3px); }
  90%       { transform: translateX(3px); }
}
.alert-shake {
  animation: shake 0.55s ease;
}

    .switch-link { text-align: center; font-size: .76rem; color: var(--gris); margin-top: 10px; }
    .switch-link a { color: var(--rouge); font-weight: 600; cursor: pointer; text-decoration: none; }
    .switch-link a:hover { text-decoration: underline; }

    .field-error { display: block; font-size: .78rem; color: var(--rouge-vif); margin-top: 5px; font-weight: 500; }
    .input-wrapper.has-error input { border-color: var(--rouge-vif) !important; background: #FFF5F5; }

    .alert { padding: 9px 12px; border-radius: 9px; font-size: .82rem; margin-bottom: 12px; }
    .alert-error   { background: #FDECEA; color: var(--rouge-vif); border-left: 4px solid var(--rouge-vif); }
    .alert-success { background: #E8F5E9; color: #2E7D32; border-left: 4px solid #2E7D32; }

    @media (max-width: 680px) {
      .auth-wrapper { width: 100vw; height: 100dvh; border-radius: 0; }
      .auth-overlay { display: none; }
      .auth-form-panel { width: 100% !important; padding: 36px 24px; }
    }
  </style>
</head>
<body>

<div class="auth-splash" id="authSplash"></div>

<div class="auth-wrapper {% if mode == 'register' %}register-mode{% endif %}" id="authWrapper">

  {# ── PANNEAU LOGIN ── #}
  <div class="auth-form-panel login-panel">
    <h1>Bienvenue&nbsp;!</h1>
    <p class="form-subtitle">Connectez-vous à votre espace</p>

   {# ── Erreur d'authentification Symfony (mauvais email/mot de passe) ── #}
{# ── Alertes login ── #}
{% if app.session.get('_blocked_message') %}
  <div class="alert alert-error alert-shake">
    <div style="display:flex;align-items:center;gap:10px;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:20px;height:20px;flex-shrink:0;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <div>
        <strong>Compte bloqué</strong><br>
        <span style="font-size:.8rem;">{{ app.session.get('_blocked_message') }}</span>
      </div>
    </div>
  </div>
  {% do app.session.remove('_blocked_message') %}

{% elseif error is defined and error %}
  <div class="alert alert-error alert-shake">
    <div style="display:flex;align-items:center;gap:10px;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:20px;height:20px;flex-shrink:0;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <div>
        <strong>Identifiants incorrects</strong><br>
        <span style="font-size:.8rem;">L'adresse email ou le mot de passe est invalide.</span>
      </div>
      <button onclick="this.parentElement.parentElement.style.display='none'" style="margin-left:auto;background:none;border:none;cursor:pointer;color:inherit;font-size:1.1rem;">✕</button>
    </div>
  </div>
{% endif %}

{% for msg in app.flashes('success') %}
  <div class="alert alert-success">{{ msg }}</div>
{% endfor %}

{% for msg in app.flashes('login_error') %}
  <div class="alert alert-error">{{ msg }}</div>
{% endfor %}
{% for msg in app.flashes('success') %}
  <div class="alert alert-success">{{ msg }}</div>
{% endfor %}

    {{ form_start(loginForm, {'action': path('app_login'), 'method': 'POST', 'attr': {'novalidate': 'novalidate', 'autocomplete': 'off'}}) }}
      <div class="form-group">
        {{ form_label(loginForm.email) }}
        <div class="input-wrapper {% if loginForm.email.vars.errors|length %}has-error{% endif %}">
          {{ form_widget(loginForm.email, {'value': last_username}) }}
          <span class="input-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </span>
        </div>
        {% if loginForm.email.vars.errors|length %}
          <span class="field-error">{{ loginForm.email.vars.errors[0].message }}</span>
        {% endif %}
      </div>

      <div class="form-group">
        {{ form_label(loginForm.password) }}
        <div class="input-wrapper {% if loginForm.password.vars.errors|length %}has-error{% endif %}">
          {{ form_widget(loginForm.password, {'attr': {'id': 'lpass'}}) }}
          <span class="input-icon toggle-eye" onclick="togglePwd('lpass', this)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </span>
        </div>
        {% if loginForm.password.vars.errors|length %}
          <span class="field-error">{{ loginForm.password.vars.errors[0].message }}</span>
        {% endif %}
      </div>

      <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
      <a href="#" class="forgot-link">Mot de passe oublié&nbsp;?</a>
      <button type="submit" class="btn-primary">Se connecter</button>
      <a href="{{ path('app_accueil') }}" class="btn-outline">Annuler</a>

     

    {{ form_end(loginForm) }}

    <div class="social-sep">ou se connecter avec</div>
    <div class="social-btns">
      <a href="#" class="btn-social" title="Face ID">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:15px;height:15px"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
      </a>
      <a href="#" class="btn-social" title="Google">G</a>
    </div>

    <p class="switch-link">Pas encore de compte&nbsp;? <a id="goRegister">S'inscrire</a></p>
  </div>

  {# ── PANNEAU REGISTER ── #}
  <div class="auth-form-panel register-panel">
    <h1>Inscription</h1>
    <p class="form-subtitle">Créez votre espace TunisiaJourney</p>

    {% for msg in app.flashes('register_error') %}
      <div class="alert alert-error">{{ msg }}</div>
    {% endfor %}

    {{ form_start(registrationForm, {'action': path('app_register'), 'method': 'POST', 'attr': {'novalidate': 'novalidate', 'autocomplete': 'off'}}) }}
      <div class="fields-grid">
        <div class="form-group">
          {{ form_label(registrationForm.nom) }}
          <div class="input-wrapper {% if registrationForm.nom.vars.errors|length %}has-error{% endif %}">
            {{ form_widget(registrationForm.nom) }}
            <span class="input-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span>
          </div>
          {% if registrationForm.nom.vars.errors|length %}
            <span class="field-error">{{ registrationForm.nom.vars.errors[0].message }}</span>
          {% endif %}
        </div>
        <div class="form-group">
          {{ form_label(registrationForm.prenom) }}
          <div class="input-wrapper {% if registrationForm.prenom.vars.errors|length %}has-error{% endif %}">
            {{ form_widget(registrationForm.prenom) }}
            <span class="input-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span>
          </div>
          {% if registrationForm.prenom.vars.errors|length %}
            <span class="field-error">{{ registrationForm.prenom.vars.errors[0].message }}</span>
          {% endif %}
        </div>
      </div>

      <div class="form-group">
        {{ form_label(registrationForm.email) }}
        <div class="input-wrapper {% if registrationForm.email.vars.errors|length %}has-error{% endif %}">
          {{ form_widget(registrationForm.email) }}
          <span class="input-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="2,4 12,13 22,4"/></svg></span>
        </div>
        {% if registrationForm.email.vars.errors|length %}
          <span class="field-error">{{ registrationForm.email.vars.errors[0].message }}</span>
        {% endif %}
      </div>

      <div class="fields-grid">
        <div class="form-group">
          {{ form_label(registrationForm.telephone) }}
          <div class="input-wrapper {% if registrationForm.telephone.vars.errors|length %}has-error{% endif %}">
            {{ form_widget(registrationForm.telephone) }}
            <span class="input-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.38 2 2 0 0 1 3.6 1.22h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.86a16 16 0 0 0 6 6l1-1a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>
          </div>
          {% if registrationForm.telephone.vars.errors|length %}
            <span class="field-error">{{ registrationForm.telephone.vars.errors[0].message }}</span>
          {% endif %}
        </div>
        <div class="form-group">
          {{ form_label(registrationForm.dateNaissance) }}
<div class="input-wrapper {% if registrationForm.dateNaissance.vars.errors|length %}has-error{% endif %}">
  {{ form_widget(registrationForm.dateNaissance) }}
</div>
{% if registrationForm.dateNaissance.vars.errors|length %}
  <span class="field-error">{{ registrationForm.dateNaissance.vars.errors[0].message }}</span>
{% endif %}
        </div>
      </div>

      <div class="form-group">
        {{ form_label(registrationForm.adresse) }}
        <div class="input-wrapper {% if registrationForm.adresse.vars.errors|length %}has-error{% endif %}">
          {{ form_widget(registrationForm.adresse) }}
          <span class="input-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
        </div>
        {% if registrationForm.adresse.vars.errors|length %}
          <span class="field-error">{{ registrationForm.adresse.vars.errors[0].message }}</span>
        {% endif %}
      </div>

      <div class="fields-grid">
        <div class="form-group">
          {{ form_label(registrationForm.mot_de_passe.first) }}
          <div class="input-wrapper {% if registrationForm.mot_de_passe.vars.errors|length %}has-error{% endif %}">
            {{ form_widget(registrationForm.mot_de_passe.first, {'attr': {'id': 'rpass'}}) }}
            <span class="input-icon toggle-eye" onclick="togglePwd('rpass', this)">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </span>
          </div>
          {% if registrationForm.mot_de_passe.first.vars.errors|length %}
            <span class="field-error">{{ registrationForm.mot_de_passe.first.vars.errors[0].message }}</span>
          {% endif %}
        </div>
        <div class="form-group">
          {{ form_label(registrationForm.mot_de_passe.second) }}
          <div class="input-wrapper {% if registrationForm.mot_de_passe.vars.errors|length %}has-error{% endif %}">
            {{ form_widget(registrationForm.mot_de_passe.second, {'attr': {'id': 'rpass2'}}) }}
            <span class="input-icon toggle-eye" onclick="togglePwd('rpass2', this)">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </span>
          </div>
          {% if registrationForm.mot_de_passe.vars.errors|length %}
            <span class="field-error">{{ registrationForm.mot_de_passe.vars.errors[0].message }}</span>
          {% endif %}
        </div>
      </div>

      <button type="submit" class="btn-primary">S'inscrire</button>
      <a href="{{ path('app_accueil') }}" class="btn-outline">Annuler</a>
    {{ form_end(registrationForm) }}

    <p class="switch-link">Déjà un compte&nbsp;? <a id="goLogin">Se connecter</a></p>
  </div>

  {# ── OVERLAY ── #}
  <div class="auth-overlay" id="authOverlay">
    <div class="overlay-circles"><span></span><span></span><span></span><span></span><span></span></div>

    <div class="overlay-logo">
      <div class="overlay-logo-ring">
        <img src="{{ asset('images/logo.png') }}" alt="TunisiaJourney logo">
      </div>
    </div>

    <div class="overlay-brand">
      <span class="brand-main">Tunisia<span style="opacity:.75">Journey</span></span>
      <span class="brand-sub">DÉCOUVREZ LA TUNISIE</span>
    </div>

    {# Texte et bouton initialisés selon le mode côté serveur #}
    <h2 class="overlay-title" id="overlayTitle">
      {% if mode == 'register' %}Bon retour&nbsp;!{% else %}Bonjour,<br>Bienvenue&nbsp;!{% endif %}
    </h2>
    <p class="overlay-desc" id="overlayDesc">
      {% if mode == 'register' %}Vous avez déjà un compte ?{% else %}Vous n'avez pas encore de compte ?{% endif %}
    </p>
    <button class="btn-overlay" id="overlayBtn">
      {% if mode == 'register' %}Se connecter{% else %}S'inscrire{% endif %}
    </button>
  </div>

</div>


<script>
(function(){
  const wrapper = document.getElementById('authWrapper');
  const splash  = document.getElementById('authSplash');
  const oTitle  = document.getElementById('overlayTitle');
  const oDesc   = document.getElementById('overlayDesc');
  const oBtn    = document.getElementById('overlayBtn');
  var current   = '{{ mode == "register" ? "register" : "login" }}';

  function switchTo(target) {
    if (target === current) return;
    splash.classList.remove('splash-out');
    splash.style.transformOrigin = 'left center';
    splash.classList.add('splash-in');
    setTimeout(function() {
      if (target === 'register') {
        wrapper.classList.add('register-mode');
        oTitle.innerHTML = 'Bon retour&nbsp;!';
        oDesc.textContent = 'Vous avez déjà un compte ?';
        oBtn.textContent = 'Se connecter';
      } else {
        wrapper.classList.remove('register-mode');
        oTitle.innerHTML = 'Bonjour,<br>Bienvenue&nbsp;!';
        oDesc.textContent = "Vous n'avez pas encore de compte ?";
        oBtn.textContent = "S'inscrire";
      }
      current = target;
      splash.style.transformOrigin = 'right center';
      splash.classList.remove('splash-in');
      splash.classList.add('splash-out');
      setTimeout(function(){ splash.classList.remove('splash-out'); }, 520);
    }, 480);
  }

  document.getElementById('goRegister').addEventListener('click', function(e){ e.preventDefault(); switchTo('register'); });
  document.getElementById('goLogin').addEventListener('click',    function(e){ e.preventDefault(); switchTo('login'); });
  oBtn.addEventListener('click', function(){ switchTo(current === 'login' ? 'register' : 'login'); });

  window.togglePwd = function(inputId, span) {
    var input = document.getElementById(inputId);
    var svg   = span.querySelector('svg');
    var eyeOpen   = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
    var eyeClosed = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/>';
    if (input.type === 'password') { input.type = 'text'; svg.innerHTML = eyeClosed; }
    else { input.type = 'password'; svg.innerHTML = eyeOpen; }
  };
})();
</script>

</body>
</html>
