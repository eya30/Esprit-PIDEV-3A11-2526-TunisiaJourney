{# templates/user/2fa_enable.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TunisiaJourney — Activer 2FA</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  {# Librairie QR code côté client #}
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --rouge: #A0231F; --rouge-vif: #C0392B;
      --nuit: #1A2E4A; --sable-cl: #FDF6EC; --blanc: #FFFFFF; --gris: #A0A0A0;
    }
    html, body { height: 100%; font-family: 'DM Sans', sans-serif; background: var(--sable-cl); }

    .page-wrap {
      min-height: 100vh; display: flex; align-items: center; justify-content: center;
      padding: 40px 20px;
    }

    .card {
      background: white; border-radius: 24px; padding: 44px 48px;
      max-width: 520px; width: 100%;
      box-shadow: 0 20px 60px rgba(26,46,74,.12);
    }

    .back-link { display: inline-flex; align-items: center; gap: 6px; color: var(--gris); font-size: .8rem; text-decoration: none; margin-bottom: 28px; transition: color .2s; }
    .back-link:hover { color: var(--rouge); }
    .back-link svg { width: 14px; height: 14px; }

    h1 { font-family: 'Playfair Display', serif; font-size: 1.8rem; color: var(--nuit); margin-bottom: 4px; }
    .subtitle { color: var(--rouge); font-size: .9rem; margin-bottom: 28px; }

    /* Étapes */
    .steps { display: flex; flex-direction: column; gap: 16px; margin-bottom: 28px; }
    .step { display: flex; align-items: flex-start; gap: 14px; }
    .step-num {
      width: 28px; height: 28px; border-radius: 50%; flex-shrink: 0;
      background: linear-gradient(135deg, var(--rouge), var(--rouge-vif));
      color: white; font-size: .78rem; font-weight: 700;
      display: flex; align-items: center; justify-content: center;
      margin-top: 1px;
    }
    .step-text { font-size: .88rem; color: #4A3B2F; line-height: 1.5; }
    .step-text strong { color: var(--nuit); }

    /* QR code */
    .qr-wrap {
      display: flex; justify-content: center; margin-bottom: 20px;
    }
    #qrcode {
      padding: 16px; background: white; border-radius: 16px;
      border: 2px solid #F0E8DD;
      box-shadow: 0 4px 20px rgba(26,46,74,.08);
    }
    #qrcode img, #qrcode canvas { border-radius: 8px; }

    /* Champ code */
    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-size: .88rem; font-weight: 500; color: var(--nuit); margin-bottom: 6px; }
    .otp-input {
      width: 100%; padding: 14px 20px; border: 2px solid #E0E0E0; border-radius: 12px;
      font-family: 'DM Sans', sans-serif; font-size: 1.5rem; font-weight: 700;
      color: var(--nuit); background: var(--sable-cl); outline: none;
      letter-spacing: 10px; text-align: center;
      transition: border-color .22s, background .22s;
    }
    .otp-input:focus { border-color: var(--rouge); background: white; }

    .btn-primary {
      width: 100%; padding: 14px;
      background: linear-gradient(90deg, var(--rouge) 0%, var(--rouge-vif) 100%);
      color: white; border: none; border-radius: 50px;
      font-family: 'DM Sans', sans-serif; font-size: 1rem; font-weight: 600;
      cursor: pointer; box-shadow: 0 5px 16px rgba(160,35,31,.3);
      transition: transform .18s, box-shadow .18s;
    }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(160,35,31,.42); }

    .alert { padding: 10px 14px; border-radius: 9px; font-size: .84rem; margin-bottom: 14px; }
    .alert-error { background: #FDECEA; color: var(--rouge-vif); border-left: 4px solid var(--rouge-vif); }

  </style>
</head>
<body>
<div class="page-wrap">
  <div class="card">

    <a href="{{ path('app_accueil', {'openProfile': '1'}) }}" class="back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
      Retour au profil
    </a>

    <h1>Activer la 2FA</h1>
    <p class="subtitle">Double authentification avec Google Authenticator</p>

    {% for msg in app.flashes('2fa_error') %}
      <div class="alert alert-error">{{ msg }}</div>
    {% endfor %}

    {# Étapes #}
    <div class="steps">
      <div class="step">
        <div class="step-num">1</div>
        <div class="step-text">
          Installez <strong>Google Authenticator</strong> sur votre téléphone
          (App Store ou Google Play)
        </div>
      </div>
      <div class="step">
        <div class="step-num">2</div>
        <div class="step-text">
          Ouvrez l'app → <strong>"+"</strong> → <strong>Scanner un QR code</strong>
        </div>
      </div>
      <div class="step">
        <div class="step-num">3</div>
        <div class="step-text">
          Scannez le QR code ci-dessous avec votre téléphone
        </div>
      </div>
      <div class="step">
        <div class="step-num">4</div>
        <div class="step-text">
          Entrez le <strong>code à 6 chiffres</strong> affiché pour confirmer
        </div>
      </div>
    </div>

    {# QR Code — généré côté client depuis l'URI #}
    <div class="qr-wrap">
      <div id="qrcode"></div>
    </div>

    {# Formulaire de confirmation #}
    <form method="POST" action="{{ path('app_2fa_enable') }}">
      <div class="form-group">
        <label for="code">Code de confirmation (6 chiffres)</label>
        <input type="text" name="code" id="code" class="otp-input"
               maxlength="6" placeholder="000000"
               inputmode="numeric" pattern="[0-9]*"
               autocomplete="one-time-code" autofocus>
      </div>
      <button type="submit" class="btn-primary">
        ✓ Confirmer et activer la 2FA
      </button>
    </form>

  </div>
</div>

<script>
// Générer le QR code depuis l'URI TOTP
new QRCode(document.getElementById('qrcode'), {
  text: {{ qr_uri|json_encode|raw }},
  width: 200, height: 200,
  colorDark: '#1A2E4A', colorLight: '#FFFFFF',
  correctLevel: QRCode.CorrectLevel.M
});

// Auto-submit à 6 chiffres
document.getElementById('code').addEventListener('input', function() {
  this.value = this.value.replace(/[^0-9]/g, '').slice(0, 6);
  if (this.value.length === 6) this.form.submit();
});

</script>
</body>
</html>
