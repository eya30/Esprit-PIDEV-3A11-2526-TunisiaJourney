{# templates/user/profile.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TunisiaJourney — Mon Profil</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --rouge:     #A0231F;
      --rouge-vif: #C0392B;
      --nuit:      #1A2E4A;
      --sable:     #F5EDD8;
      --sable-cl:  #FDF6EC;
      --blanc:     #FFFFFF;
      --gris:      #A0A0A0;
      --border:    #EFE5D0;
    }

    html, body {
      min-height: 100%;
      font-family: 'DM Sans', sans-serif;
      background: linear-gradient(135deg, var(--sable-cl) 0%, var(--sable) 100%);
      color: var(--nuit);
    }

    /* ─── NAV RETOUR ── */
    .pf-topbar {
      padding: 16px 40px;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .pf-back {
      display: inline-flex; align-items: center; gap: 6px;
      color: var(--rouge); font-size: .84rem; font-weight: 600;
      text-decoration: none; transition: gap .2s;
    }
    .pf-back:hover { gap: 10px; }
    .pf-back svg { width: 16px; height: 16px; }

    /* ─── LAYOUT ── */
    .pf-page { padding: 0 20px 60px; }
    .pf-container { max-width: 780px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; }

    /* ─── HEADER CARD ── */
    .pf-header {
      background: var(--blanc);
      border-radius: 20px;
      padding: 36px 40px;
      display: flex;
      align-items: center;
      gap: 28px;
      box-shadow: 0 4px 24px rgba(26,46,74,.08);
    }

    .pf-avatar-wrap { position: relative; flex-shrink: 0; }
    .pf-avatar {
      width: 100px; height: 100px; border-radius: 50%;
      background: linear-gradient(135deg, #C94040, #A0231F);
      display: flex; align-items: center; justify-content: center;
      font-family: 'Playfair Display', serif;
      font-size: 2.2rem; font-weight: 700; color: #fff;
      border: 3px solid rgba(160,35,31,.2);
      box-shadow: 0 4px 18px rgba(160,35,31,.22);
      overflow: hidden;
    }
    .pf-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .pf-avatar-edit {
      position: absolute; bottom: 2px; right: 2px;
      width: 28px; height: 28px; border-radius: 50%;
      background: var(--rouge); border: 2px solid var(--blanc);
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; transition: transform .2s;
      title: "Changer la photo (bientôt disponible)";
    }
    .pf-avatar-edit:hover { transform: scale(1.15); }
    .pf-avatar-edit svg { width: 13px; height: 13px; }

    .pf-header-info { flex: 1; }
    .pf-name {
      font-family: 'Playfair Display', serif;
      font-size: 1.7rem; font-weight: 700; color: var(--nuit);
      margin: 0 0 4px;
    }
    .pf-email { color: var(--rouge); font-size: .85rem; margin: 0 0 10px; }
    .pf-badge {
      display: inline-flex; align-items: center; gap: 5px;
      background: #FDF1F1; color: var(--rouge);
      font-size: .72rem; font-weight: 600;
      padding: 4px 12px; border-radius: 20px;
      border: 1px solid rgba(160,35,31,.18);
    }
    .pf-badge-dot { width: 7px; height: 7px; border-radius: 50%; background: #22C55E; }

    /* ─── CARDS ── */
    .pf-card {
      background: var(--blanc);
      border-radius: 16px;
      padding: 28px 36px;
      box-shadow: 0 4px 24px rgba(26,46,74,.06);
    }

    .pf-section-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.05rem; font-weight: 700; color: var(--nuit);
      margin: 0 0 18px; padding-bottom: 10px;
      border-bottom: 1.5px solid #F0E8DD;
      display: flex; align-items: center; gap: 8px;
    }
    .pf-section-title svg { width: 16px; height: 16px; color: var(--rouge); flex-shrink: 0; }

    .pf-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

    .pf-field { display: flex; flex-direction: column; gap: 4px; }
    .pf-field-label {
      font-size: .72rem; font-weight: 600; color: var(--gris);
      letter-spacing: .5px; text-transform: uppercase;
    }
    .pf-field-value {
      font-size: .92rem; color: var(--nuit); font-weight: 500;
      padding: 10px 14px;
      background: var(--sable-cl);
      border-radius: 9px;
      border: 1px solid var(--border);
    }
    .pf-field-value.empty { color: #C0B090; font-style: italic; }

    /* ─── BOUTON MODIFIER ── */
    .pf-actions { display: flex; justify-content: flex-end; margin-top: 4px; }
    .pf-btn-edit {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 12px 28px;
      background: linear-gradient(90deg, var(--rouge) 0%, var(--rouge-vif) 100%);
      color: var(--blanc); border: none; border-radius: 50px;
      font-family: 'DM Sans', sans-serif; font-size: .9rem; font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(160,35,31,.28);
      transition: transform .18s, box-shadow .18s;
    }
    .pf-btn-edit:hover { transform: translateY(-2px); box-shadow: 0 7px 20px rgba(160,35,31,.4); color: var(--blanc); }
    .pf-btn-edit svg { width: 15px; height: 15px; }

    /* ─── TOOLTIP PHOTO ── */
    .photo-soon {
      font-size: .72rem; color: var(--gris);
      text-align: center; margin-top: 6px;
    }

    @media (max-width: 600px) {
      .pf-header { flex-direction: column; text-align: center; padding: 28px 20px; }
      .pf-grid { grid-template-columns: 1fr; }
      .pf-card { padding: 20px; }
      .pf-topbar { padding: 16px 20px; }
    }
  </style>
</head>
<body>

  {# ── Barre retour ── #}
  <div class="pf-topbar">
    <a href="{{ path('app_accueil') }}" class="pf-back">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M19 12H5M12 5l-7 7 7 7"/>
      </svg>
      Retour à l'accueil
    </a>
  </div>

  <div class="pf-page">
    <div class="pf-container">

      {# ── Flash messages ── #}
      {% for msg in app.flashes('success') %}
        <div style="background:#E8F5E9;color:#2E7D32;border-left:4px solid #2E7D32;padding:10px 16px;border-radius:10px;font-size:.85rem;">
          {{ msg }}
        </div>
      {% endfor %}

      {# ── Header profil ── #}
      <div class="pf-header">
        <div class="pf-avatar-wrap">
          <div class="pf-avatar">
            {# Photo ou initiales #}
            {% if user.photo is defined and user.photo %}
              <img src="{{ asset('uploads/photos/' ~ user.photo) }}" alt="Photo de profil">
            {% else %}
              {{ user.prenom|slice(0,1)|upper }}{{ user.nom|slice(0,1)|upper }}
            {% endif %}
          </div>
          <div class="pf-avatar-edit" title="Photo de profil (bientôt disponible)">
            <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5">
              <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
              <circle cx="12" cy="13" r="4"/>
            </svg>
          </div>
        </div>
        <div class="pf-header-info">
          <h1 class="pf-name">{{ user.prenom }} {{ user.nom }}</h1>
          <p class="pf-email">{{ user.email }}</p>
          <span class="pf-badge">
            <span class="pf-badge-dot"></span>
            Compte actif
          </span>
        </div>
      </div>

      {# ── Infos personnelles ── #}
      <div class="pf-card">
        <div class="pf-section-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
          </svg>
          Informations personnelles
        </div>
        <div class="pf-grid">
          <div class="pf-field">
            <span class="pf-field-label">Nom</span>
            <span class="pf-field-value">{{ user.nom }}</span>
          </div>
          <div class="pf-field">
            <span class="pf-field-label">Prénom</span>
            <span class="pf-field-value">{{ user.prenom }}</span>
          </div>
          <div class="pf-field">
            <span class="pf-field-label">Date de naissance</span>
            <span class="pf-field-value {% if not user.dateNaissance %}empty{% endif %}">
              {% if user.dateNaissance %}
                {{ user.dateNaissance|date('d/m/Y') }}
              {% else %}
                Non renseignée
              {% endif %}
            </span>
          </div>
          <div class="pf-field">
            <span class="pf-field-label">Téléphone</span>
            <span class="pf-field-value {% if not user.telephone %}empty{% endif %}">
              {% if user.telephone %}
                {{ user.telephone }}
              {% else %}
                Non renseigné
              {% endif %}
            </span>
          </div>
          <div class="pf-field" style="grid-column: 1 / -1">
            <span class="pf-field-label">Adresse</span>
            <span class="pf-field-value {% if not user.adresse %}empty{% endif %}">
              {% if user.adresse %}
                {{ user.adresse }}
              {% else %}
                Non renseignée
              {% endif %}
            </span>
          </div>
        </div>
      </div>

      {# ── Infos de connexion ── #}
      <div class="pf-card">
        <div class="pf-section-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="2,4 12,13 22,4"/>
          </svg>
          Informations de connexion
        </div>
        <div class="pf-grid">
          <div class="pf-field" style="grid-column: 1 / -1">
            <span class="pf-field-label">Email</span>
            <span class="pf-field-value">{{ user.email }}</span>
          </div>
          <div class="pf-field" style="grid-column: 1 / -1">
            <span class="pf-field-label">Mot de passe</span>
            <span class="pf-field-value">••••••••••••</span>
          </div>
        </div>
      </div>

      {# ── Bouton modifier ── #}
      <div class="pf-actions">
        <a href="{{ path('app_profile_edit') }}" class="pf-edit-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
          </svg>
          Modifier le profil
        </a>
      </div>

    </div>
  </div>

</body>
</html>
