{% extends 'base.html.twig' %}

{% block title %}{{ programme.nom }} - TunisiaJourney{% endblock %}

{% block stylesheets %}
<style>
    .back-arrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--tunisia-red);
        text-decoration: none;
        font-weight: 500;
        margin-bottom: 2rem;
        transition: all 0.3s ease;
    }
    .back-arrow:hover { transform: translateX(-5px); color: var(--tunisia-orange); }

    .programme-container {
        display: flex;
        gap: 2rem;
        background: white;
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid #F0E8DD;
    }

    .programme-image { flex: 1; min-width: 0; background: #FEF9F0; min-height: 400px; display: flex; align-items: center; justify-content: center; }
    .programme-image img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .programme-image-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #E8DFD1; font-size: 3rem; background: #FEF9F0; }
    .programme-info { flex: 1; padding: 2rem; }
    .programme-title { font-family: 'Cormorant Garamond', serif; font-size: 2rem; font-weight: 700; color: var(--tunisia-red); margin-bottom: 1rem; }
    .programme-meta { display: flex; flex-wrap: wrap; gap: 1.5rem; margin: 1.5rem 0; padding: 1rem 0; border-top: 1px solid #F0E8DD; border-bottom: 1px solid #F0E8DD; }
    .meta-item { display: flex; align-items: center; gap: 8px; color: #6c757d; font-size: 0.9rem; }
    .meta-item i { color: var(--tunisia-red); width: 20px; }
    .programme-description { color: #4A3B2F; line-height: 1.8; margin: 1.5rem 0; }
    .btn-reserve { background: var(--tunisia-blue); color: white; border: none; padding: 12px 30px; border-radius: 30px; font-weight: 600; font-size: 1rem; cursor: pointer; transition: all 0.3s ease; margin-top: 1rem; display: inline-block; }
    .btn-reserve:hover { background: #00408a; transform: translateY(-2px); }

    .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center; }
    .modal.active { display: flex; }
    .modal-content { background: white; border-radius: 20px; padding: 2rem; max-width: 480px; width: 90%; max-height: 90vh; overflow-y: auto; }
    .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid #E8DFD1; }
    .modal-header h3 { font-size: 1.3rem; font-weight: 600; color: var(--tunisia-blue); margin: 0; }
    .close-modal { background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #9CA3AF; }
    .close-modal:hover { color: var(--tunisia-red); }
    .form-group { margin-bottom: 1rem; }
    .form-group label { display: block; font-size: 0.85rem; font-weight: 500; color: var(--dark-gray); margin-bottom: 0.3rem; }
    .form-group label .required { color: #E31B23; margin-left: 3px; }
    .form-group input { width: 100%; padding: 10px 12px; border: 1px solid #E8DFD1; border-radius: 10px; font-size: 0.9rem; box-sizing: border-box; }
    .form-group input:focus { outline: none; border-color: var(--tunisia-blue); }
    .btn-submit { width: 100%; background: var(--tunisia-blue); color: white; border: none; padding: 12px; border-radius: 30px; font-weight: 600; font-size: 0.95rem; cursor: pointer; margin-top: 1rem; }
    .btn-submit:hover { background: #00408a; }

    .error-messages { background: #FEF2F2; border-left: 4px solid #EF4444; padding: 12px 16px; margin-bottom: 1rem; border-radius: 8px; }
    .error-messages ul { margin: 0; padding-left: 1.5rem; color: #EF4444; font-size: 0.85rem; }
    .success-messages { background: #E0F2E9; border-left: 4px solid #10B981; padding: 12px 16px; margin-bottom: 1rem; border-radius: 8px; }
    .success-messages ul { margin: 0; padding-left: 1.5rem; color: #047857; font-size: 0.85rem; }

    @media (max-width: 768px) {
        .programme-container { flex-direction: column; }
        .programme-image { min-height: 300px; }
        .programme-info { padding: 1.5rem; }
        .programme-title { font-size: 1.5rem; }
        .modal-content { padding: 1.5rem; }
    }
</style>
{% endblock %}

{% block body %}
<div class="container py-5">
    <a href="{{ path('app_voyage_programmes', {'idV': programme.voyage.idV}) }}" class="back-arrow">
        <i class="fas fa-arrow-left"></i> Retour aux programmes
    </a>

    <div class="programme-container">
        <div class="programme-image">
            {% if programme.image and programme.image != 'NULL' and programme.image != '' %}
                <img src="{{ asset('uploads/programmes/' ~ programme.image|replace({' ': '%20'})) }}" alt="{{ programme.nom }}">
            {% else %}
                <div class="programme-image-placeholder"><i class="fas fa-image"></i></div>
            {% endif %}
        </div>

        <div class="programme-info">
            <h1 class="programme-title">{{ programme.nom }}</h1>
            <div class="programme-meta">
                <div class="meta-item"><i class="fas fa-map-marker-alt"></i> <span>{{ programme.lieu }}</span></div>
                <div class="meta-item"><i class="fas fa-hotel"></i> <span>{{ programme.hotel }}</span></div>
                <div class="meta-item"><i class="fas fa-calendar-alt"></i> <span>{{ programme.dateDebut|date('d/m/Y') }} - {{ programme.dateFin|date('d/m/Y') }}</span></div>
                <div class="meta-item"><i class="fas fa-tag"></i> <span>{{ programme.activiteAssociee }}</span></div>
            </div>
            <div class="programme-description">{{ programme.description }}</div>
            <button class="btn-reserve" onclick="openModal()">
                Réserver ce programme <i class="fas fa-arrow-right ms-2"></i>
            </button>
        </div>
    </div>
</div>

{# ===================== MODAL DE RÉSERVATION ===================== #}
<div id="reservationModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Réserver un programme</h3>
            <button class="close-modal" onclick="closeModal()">&times;</button>
        </div>

        {# ✅ Erreurs Symfony passées directement depuis le controller (pas de redirect) #}
        {% if errors is defined and errors|length > 0 %}
            <div class="error-messages">
                <ul>
                    {% for message in errors %}
                        <li>{{ message }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {# ✅ Messages flash de succès (après redirect réussi) #}
        {% for message in app.flashes('success') %}
            <div class="success-messages">
                <ul><li>{{ message }}</li></ul>
            </div>
        {% endfor %}

        {#
            ⚠️ AUCUN ATTRIBUT HTML5 :
            - Pas de "required"
            - Pas de "pattern"
            - Pas de "min/max"
            - Pas de "type=email" ou "type=number"
            - Tout est en "type=text"
            → Validation 100% côté serveur via les annotations Symfony sur l'entité
        #}
        <form method="post" action="{{ path('app_reservation_new', {'idProg': programme.idProg}) }}" novalidate>
            <div class="form-group">
                <label>Nom <span class="required">*</span></label>
                <input type="text" name="nom"
                       placeholder="Votre nom"
                       value="{{ formData.nom ?? '' }}">
            </div>
            <div class="form-group">
                <label>Prénom <span class="required">*</span></label>
                <input type="text" name="prenom"
                       placeholder="Votre prénom"
                       value="{{ formData.prenom ?? '' }}">
            </div>
            <div class="form-group">
                <label>Téléphone <span class="required">*</span></label>
                <input type="text" name="telephone"
                       placeholder="Ex: 12345678"
                       value="{{ formData.telephone ?? '' }}">
            </div>
            <div class="form-group">
                <label>Email <span class="required">*</span></label>
                <input type="text" name="email"
                       placeholder="exemple@email.com"
                       value="{{ formData.email ?? '' }}">
            </div>
            <div class="form-group">
                <label>Nombre de personnes <span class="required">*</span></label>
                <input type="text" name="nbre"
                       placeholder="Ex: 2"
                       value="{{ formData.nbre ?? '1' }}">
            </div>
            <button type="submit" class="btn-submit">Confirmer la réservation</button>
        </form>
    </div>
</div>

<script>
    function openModal() {
        document.getElementById('reservationModal').classList.add('active');
    }
    function closeModal() {
        document.getElementById('reservationModal').classList.remove('active');
    }

    // ✅ Ouvrir le modal automatiquement s'il y a des erreurs Symfony
    // (errors est une variable Twig, pas des flash messages)
    {% if errors is defined and errors|length > 0 %}
        document.getElementById('reservationModal').classList.add('active');
    {% endif %}

    // Fermer en cliquant en dehors du modal
    window.onclick = function(event) {
        const modal = document.getElementById('reservationModal');
        if (event.target === modal) closeModal();
    }
</script>
{% endblock %}
