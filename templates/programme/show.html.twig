{% block body %}
<div class="container py-5">
    <a href="{{ path('app_voyage_programmes', {'idV': programme.voyage.idV}) }}" class="back-arrow">
        <i class="fas fa-arrow-left"></i> Retour aux programmes
    </a>

    <div class="programme-container">
        <div class="programme-image">
            {% if programme.image is not null and programme.image != 'NULL' and programme.image != '' %}
                <img src="{{ asset('uploads/programmes/' ~ programme.image|replace({' ': '%20'})) }}"
                     alt="{{ programme.nom }}">
            {% else %}
                <div class="programme-image-placeholder"><i class="fas fa-image"></i></div>
            {% endif %}
        </div>

        <div class="programme-info">
            <h1 class="programme-title">{{ programme.nom }}</h1>
            <div class="programme-meta">
                <div class="meta-item"><i class="fas fa-map-marker-alt"></i> <span>{{ programme.lieu }}</span></div>
                <div class="meta-item"><i class="fas fa-hotel"></i> <span>{{ programme.hotel }}</span></div>
                <div class="meta-item">
                    <i class="fas fa-calendar-alt"></i>
                    <span>{{ programme.dateDebut|date('d/m/Y') }} - {{ programme.dateFin|date('d/m/Y') }}</span>
                </div>
                <div class="meta-item"><i class="fas fa-tag"></i> <span>{{ programme.activiteAssociee }}</span></div>
            </div>
            <div class="programme-description">{{ programme.description }}</div>
            <button class="btn-reserve" onclick="openModal()">
                Réserver ce programme <i class="fas fa-arrow-right ms-2"></i>
            </button>
        </div>
    </div>
</div>


<div id="reservationModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Réserver : {{ programme.nom|slice(0, 35) }}</h3>
            <button class="close-modal" onclick="closeModal()">&times;</button>
        </div>

        {# Messages Flash Symfony #}
        {% for message in app.flashes('success') %}
            <div class="success-messages">
                <ul><li>{{ message }}</li></ul>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="error-messages">
                <ul><li>{{ message }}</li></ul>
            </div>
        {% endfor %}
        {% for message in app.flashes('warning') %}
            <div class="warning-messages">
                <ul><li>{{ message }}</li></ul>
            </div>
        {% endfor %}

        {# Vérification si l'utilisateur n'est pas connecté #}
        {% if not app.user %}
            <div class="warning-messages">
                <ul>
                    <li>⚠️ Vous devez être connecté pour effectuer une réservation.</li>
                    <li><a href="{{ path('app_login') }}" style="color: #D97706;">🔐 Se connecter</a> ou 
                        <a href="{{ path('app_register') }}" style="color: #D97706;">📝 Créer un compte</a>
                    </li>
                </ul>
            </div>
        {% else %}
            {# Vérifier si l'utilisateur connecté est ADMIN #}
            {% set userRole = app.user.role ?? '' %}
            {% if userRole == 'ADMIN' %}
                <div class="error-messages">
                    <ul>
                        <li>❌ Les administrateurs ne peuvent pas effectuer de réservation.</li>
                        <li>Veuillez utiliser un compte <strong>MEMBRE</strong>.</li>
                    </ul>
                </div>
            {% else %}
                {# Formulaire de réservation normal #}
                <form method="post" action="{{ path('app_reservation_new', {'idProg': programme.idProg}) }}" novalidate>

