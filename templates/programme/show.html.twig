{% extends 'base.html.twig' %}

{% block title %}{{ programme.nom }} - TunisiaJourney{% endblock %}

{% block stylesheets %}
<style>
    .back-arrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--tunisia-red);
        text-decoration: none;
        font-weight: 500;
        margin-bottom: 2rem;
        transition: all 0.3s ease;
    }
    .back-arrow:hover { transform: translateX(-5px); color: var(--tunisia-orange); }

    .programme-container {
        display: flex;
        gap: 2rem;
        background: white;
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid #F0E8DD;
    }

    .programme-image {
        flex: 1;
        min-width: 0;
        background: #FEF9F0;
        min-height: 400px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .programme-image img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .programme-image-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #E8DFD1;
        font-size: 3rem;
        background: #FEF9F0;
    }

    .programme-info { flex: 1; padding: 2rem; }
    .programme-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 2rem;
        font-weight: 700;
        color: var(--tunisia-red);
        margin-bottom: 1rem;
    }
    .programme-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        margin: 1.5rem 0;
        padding: 1rem 0;
        border-top: 1px solid #F0E8DD;
        border-bottom: 1px solid #F0E8DD;
    }
    .meta-item { display: flex; align-items: center; gap: 8px; color: #6c757d; font-size: 0.9rem; }
    .meta-item i { color: var(--tunisia-red); width: 20px; }
    .programme-description { color: #4A3B2F; line-height: 1.8; margin: 1.5rem 0; }

    .btn-reserve {
        background: var(--tunisia-blue);
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 30px;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 1rem;
        display: inline-block;
    }
    .btn-reserve:hover { background: #00408a; transform: translateY(-2px); }

    .modal {
        display: none;
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(0,0,0,0.5);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }
    .modal.active { display: flex; }

    .modal-content {
        background: white;
        border-radius: 20px;
        padding: 2rem;
        max-width: 480px;
        width: 90%;
        max-height: 90vh;
        overflow-y: auto;
    }
    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #E8DFD1;
    }
    .modal-header h3 { font-size: 1.3rem; font-weight: 600; color: var(--tunisia-blue); margin: 0; }
    .close-modal { background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #9CA3AF; }
    .close-modal:hover { color: var(--tunisia-red); }

    .form-group { margin-bottom: 1rem; }
    .form-group label {
        display: block;
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--dark-gray);
        margin-bottom: 0.3rem;
    }
    .form-group label .required { color: #E31B23; margin-left: 3px; }
    .form-group input {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #E8DFD1;
        border-radius: 10px;
        font-size: 0.9rem;
        box-sizing: border-box;
    }
    .form-group input:focus { outline: none; border-color: var(--tunisia-blue); }

