    // Prix unitaire du voyage (par personne)
    const prixUnitaire = {{ programme.voyage.prix ?? 0 }};

    const nbreInput       = document.getElementById('prog-nbre');
    const prixTotalEl     = document.getElementById('prog-prix-total');
    const promoInput      = document.getElementById('prog-code-promo-input');
    const promoHidden     = document.getElementById('prog-code-promo-hidden');
    const promoFeedback   = document.getElementById('prog-promo-feedback');

    let reductionAppliquee = 0; // pourcentage (0–100)

    function getPrixBase() {
        const nbre = parseInt(nbreInput ? nbreInput.value : 1) || 1;
        return prixUnitaire * nbre;
    }

    function afficherPrix() {
        const base    = getPrixBase();
        const reduit  = base * (1 - reductionAppliquee / 100);

        if (prixTotalEl) {
            if (reductionAppliquee > 0) {
                prixTotalEl.innerHTML =
                    '<span class="prix-barre">' + base.toFixed(2) + ' TND</span>' +
                    reduit.toFixed(2) + ' TND';
            } else {
                prixTotalEl.textContent = (base > 0 ? base.toFixed(2) + ' TND' : '— TND');
            }
        }
    }

    if (nbreInput) {
        nbreInput.addEventListener('input', function () {
            // Si un code promo valide était appliqué, on ré-affiche le nouveau total
            afficherPrix();
        });
    }

    afficherPrix();

    function verifierPromo() {
        const code     = promoInput ? promoInput.value.trim().toUpperCase() : '';
        const prixBase = getPrixBase();

        if (!code) {
            promoFeedback.className = 'promo-feedback error';
            promoFeedback.textContent = '⚠️ Veuillez saisir un code promo.';
            return;
        }

        promoFeedback.className = 'promo-feedback';
        promoFeedback.textContent = '⏳ Vérification…';

        fetch('{{ path('api_verifier_code_promo') }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ code: code, prix_base: prixBase })
        })
        .then(r => r.json())
        .then(data => {
            if (data.valid) {
                reductionAppliquee = data.reduction;
                promoHidden.value  = code;
                promoFeedback.className  = 'promo-feedback success';
                promoFeedback.textContent = data.message;
                afficherPrix();
            } else {
                reductionAppliquee = 0;
                promoHidden.value  = '';
                promoFeedback.className  = 'promo-feedback error';
                promoFeedback.textContent = '❌ ' + data.message;
                afficherPrix();
            }
        })
        .catch(() => {
            promoFeedback.className  = 'promo-feedback error';
            promoFeedback.textContent = '❌ Erreur réseau. Réessayez.';
        });
    }

    // Permettre la validation du code promo avec la touche Entrée
    if (promoInput) {
        promoInput.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') { e.preventDefault(); verifierPromo(); }
        });

        // Réinitialiser si l'utilisateur efface le code
        promoInput.addEventListener('input', function () {
            if (this.value.trim() === '') {
                reductionAppliquee = 0;
                promoHidden.value  = '';
                promoFeedback.className  = 'promo-feedback';
                promoFeedback.textContent = '';
                afficherPrix();
            }
        });
    }

