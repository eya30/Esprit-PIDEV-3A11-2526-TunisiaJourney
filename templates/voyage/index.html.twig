    .price-item { text-align: center; }
    .price-label { font-size: 0.7rem; color: var(--gray-text); text-transform: uppercase; }
    .price-value { font-size: 1.4rem; font-weight: 800; color: var(--bordeaux); }
    .total-price { font-size: 1.8rem; font-weight: 800; color: var(--bordeaux); }
    .save-trip-btn { background: linear-gradient(135deg, var(--bordeaux), #a0213c); border: none; padding: 12px 28px; border-radius: 40px; color: white; font-weight: 700; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; gap: 8px; }
    .save-trip-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(125,46,62,0.4); }
    .drop-zone-active { background: rgba(193,120,23,0.1); border: 2px dashed var(--or-ambre); }

    /* =============================================
       RESPONSIVE
       ============================================= */
    @media (max-width: 768px) {
        .hero { height: 45vh; min-height: 350px; }
        .hero h1 { font-size: 2rem; }
        .hero-content { padding: 1.5rem 2rem; }
        .voyages-grid { grid-template-columns: 1fr; }
        .search-sort-bar { flex-direction: column; align-items: stretch; }
        .sort-wrapper { width: 100%; }
        .sort-toggle-btn { width: 100%; justify-content: center; }
        .section-title { font-size: 2rem; }
        .card-img { height: 200px; }
        .button-group { flex-direction: column; gap: 8px; }
        .notif-dropdown { width: calc(100vw - 2rem); right: -10px; }
        .mood-emojis { grid-template-columns: repeat(2, 1fr); }
        .saison-btns { grid-template-columns: repeat(2, 1fr); }
        .mood-modal-inner { padding: 1.4rem; }
        .mood-modal-title { font-size: 1.6rem; }
        #toastContainer { right: 12px; bottom: 12px; left: 12px; align-items: stretch; }
        .notif-toast { min-width: unset; max-width: unset; width: 100%; }
        .call-content { margin: 1rem; padding: 1.5rem; }
        .agent-name { font-size: 1.4rem; }
        .orb-container { width: 160px; height: 160px; }
        .orb-sphere { width: 110px; height: 110px; }
        .call-transcript { max-height: 180px; }
        .ctrl-btn { width: 44px; height: 44px; }
        .ctrl-btn-end { width: 56px; height: 56px; }
        .flipbook-book { height: 460px; }
        .fb-cover-title { font-size: 2.2rem; }
        .fb-title { font-size: 1.4rem; }
        .fb-left { padding: 1.5rem 1.2rem; }
        .fb-toc { padding: 1.5rem; }
        .fb-toc-dots { display: none; }
        .trip-builder-body { flex-direction: column; }
        .programs-panel, .itinerary-panel { width: 100%; }
        .programs-panel { max-height: 40%; }
        .price-summary { flex-direction: column; gap: 0.5rem; }
        .total-price { font-size: 1.2rem; }
    }
</style>
{% endblock %}

{% block body %}
<section class="hero">
    <div class="hero-content">
        <h1>Nos Voyages en Tunisie</h1>
        <div class="hero-divider"></div>
        <p>Découvrez nos séjours exclusifs, conçus pour vous faire vivre la magie de la Tunisie.</p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="search-sort-bar">
            <div class="search-field-wrapper">
                <i class="fas fa-search search-icon"></i>
                <input type="text" id="searchInput" class="search-input" placeholder="Rechercher un voyage..." autocomplete="off">
                <button class="search-clear-btn" id="searchClearBtn" type="button"><i class="fas fa-times"></i></button>
            </div>

            <button class="mood-btn" id="moodBtn" type="button">
                <i class="fas fa-wand-magic-sparkles"></i> Trouver mon voyage
            </button>

            <button class="flipbook-trigger-btn" id="flipbookTriggerBtn" type="button">
                <i class="fas fa-book-open"></i> Livre Tunisie
            </button>

            <div class="sort-wrapper">
                <button class="sort-toggle-btn" id="sortToggleBtn" type="button">
                    <i class="fas fa-sliders-h"></i>
                    <span id="sortLabel">Trier par</span>
                    <i class="fas fa-chevron-down sort-chevron"></i>
                </button>
                <div class="sort-dropdown-menu" id="sortDropdownMenu">
                    <div class="sort-option active" data-value="name_asc"><i class="fas fa-sort-alpha-down"></i> Nom (A-Z)</div>
                    <div class="sort-option" data-value="price_asc"><i class="fas fa-arrow-up"></i> Prix (croissant)</div>
                    <div class="sort-option" data-value="price_desc"><i class="fas fa-arrow-down"></i> Prix (décroissant)</div>
                    <div class="sort-option" data-value="date_asc"><i class="fas fa-calendar"></i> Date (plus ancien)</div>
                </div>
            </div>

            <div class="notif-wrapper" id="notifWrapper">
                <button class="notif-btn" id="notifBtn" type="button">
                    <i class="fas fa-bell"></i>
                    <span>Alertes</span>
                    <span class="notif-badge" id="notifBadge">0</span>
                </button>
                <div class="notif-dropdown" id="notifDropdown">
                    <div class="notif-dropdown-header">
                        <div class="notif-dropdown-title">
                            <i class="fas fa-bell"></i> Notifications
                        </div>
                        <button class="btn-read-all" id="btnReadAll">Tout lire</button>
                    </div>
                    <div class="notif-scroll-area" id="notifList">
                        <div class="notif-empty"><i class="fas fa-bell-slash"></i><p>Aucune notification</p></div>
                    </div>
                    <div class="notif-dropdown-footer">
                        <span style="font-size:0.7rem;color:#B8AFA8;">TunisiaJourney · Alertes en temps réel</span>
                    </div>
                </div>
            </div>

            <div class="wishlist-icon" id="wishlistIcon">
                <i class="fas fa-heart"></i>
                <span>Wishlist</span>
                <span class="wishlist-count" id="wishlistCount">0</span>
            </div>
        </div>

        <h2 class="section-title">Séjours Disponibles</h2>
        <p class="section-subtitle">Choisissez votre prochaine aventure tunisienne</p>

        <div class="voyages-grid" id="voyagesGrid">
            {% for voyage in voyages %}
                <div class="voyage-item"
                     data-id="{{ voyage.idV }}"
                     data-name="{{ voyage.nom }}"
                     data-price="{{ voyage.prix }}"
                     data-date="{{ voyage.dateCreation|date('Y-m-d') }}"
                     data-image="{{ voyage.image ? asset('uploads/voyages/' ~ voyage.image) : 'https://images.pexels.com/photos/1618750/pexels-photo-1618750.jpeg?auto=compress&cs=tinysrgb&w=800' }}">
                    <div class="card-custom">
                        <div class="card-img">
                            <img src="{{ voyage.image ? asset('uploads/voyages/' ~ voyage.image) : 'https://i.pinimg.com/1200x/40/79/5a/40795a77f4822edd456542c3719eac93.jpg?auto=compress&cs=tinysrgb&w=800' }}" alt="{{ voyage.nom }}" loading="lazy">
                            <span class="card-badge"><i class="fas fa-tag"></i> À découvrir</span>
                            <div class="wishlist-star" data-id="{{ voyage.idV }}"><i class="far fa-star"></i></div>
                        </div>
                        <div class="card-content">
                            <h3 class="card-title">{{ voyage.nom }}</h3>
                            <p class="card-location"><i class="fas fa-map-marker-alt"></i> {{ voyage.lieu|default('Tunisie') }}</p>
                            <p class="card-desc">{{ voyage.description|slice(0, 100) }}{% if voyage.description|length > 100 %}...{% endif %}</p>
                            <div class="card-meta">
                                <span><i class="fas fa-user"></i> {{ voyage.capacite|default('2-8') }} pers</span>
                                <span><i class="fas fa-clock"></i> {{ voyage.heure|date('H:i') }}</span>
                                <span><i class="fas fa-calendar-alt"></i> {{ voyage.duree|default(5) }} jours</span>
                            </div>
                            <div class="card-divider"></div>
                            <div class="card-price">{{ voyage.prix|number_format(0, ',', ' ') }} TND <span>/personne</span></div>
                            <div class="button-group">
                                <a href="{{ path('app_voyage_show', {'idV': voyage.idV}) }}" class="btn-details"><i class="fas fa-info-circle"></i> Détails</a>
                                <a href="{{ path('app_voyage_programmes', {'idV': voyage.idV}) }}" class="btn-programmes"><i class="fas fa-calendar-alt"></i> Programmes</a>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center py-5"><div class="no-results"><i class="fas fa-suitcase"></i><p>Aucun voyage trouvé.</p></div></div>
            {% endfor %}
        </div>

        <div class="pagination" id="paginationContainer"></div>
    </div>
</section>

<!-- Wishlist Sidebar -->
<div class="wishlist-overlay" id="wishlistOverlay"></div>
<div class="wishlist-sidebar" id="wishlistSidebar">
    <div class="wishlist-header">
        <h4><i class="fas fa-heart me-2"></i> Ma Wishlist</h4>
        <button class="close-wishlist" id="closeWishlistBtn">&times;</button>
    </div>
    <div id="wishlistList">
        <div class="empty-wishlist">
            <i class="fas fa-heart fa-3x mb-2"></i>
            <p>Votre wishlist est vide</p>
            <p class="small">Ajoutez vos voyages préférés avec l'étoile ⭐</p>
        </div>
    </div>
</div>

<!-- Toast container -->
<div id="toastContainer"></div>

<!-- ===================== MOOD MODAL ===================== -->
<div class="mood-modal-overlay" id="moodModalOverlay">
    <div class="mood-modal">
        <div class="mood-modal-band"></div>
        <div class="mood-modal-inner">
            <div class="mood-modal-header">
                <div class="mood-modal-title-wrap">
                    <div class="mood-modal-eyebrow">Recommandation IA</div>
                    <div class="mood-modal-title">    Quel voyage vous ressemble ?</div>
                    <div class="mood-modal-subtitle">Notre intelligence artificielle analyse vos envies<br>et vous propose le séjour parfait parmi nos offres.</div>
                </div>
                <button class="close-mood" id="closeMoodBtn"><i class="fas fa-times"></i></button>
            </div>

            <div class="mood-section">
                <div class="mood-section-label"><i class="fas fa-face-smile"></i> Votre humeur du moment</div>
                <div class="mood-emojis">
                    <button class="mood-emoji-btn" data-value="aventurier">
                        <div class="mood-emoji-check"><i class="fas fa-check"></i></div>
                        <span class="emoji">🏔️</span>Aventurier
                    </button>
                    <button class="mood-emoji-btn" data-value="zen et détente">
                        <div class="mood-emoji-check"><i class="fas fa-check"></i></div>
                        <span class="emoji">😌</span>Zen & Détente
                    </button>
                    <button class="mood-emoji-btn" data-value="romantique">
                        <div class="mood-emoji-check"><i class="fas fa-check"></i></div>
                        <span class="emoji">💕</span>Romantique
                    </button>
                    <button class="mood-emoji-btn" data-value="curieux et culturel">
                        <div class="mood-emoji-check"><i class="fas fa-check"></i></div>
                        <span class="emoji">🎭</span>Culturel
                    </button>
                    <button class="mood-emoji-btn" data-value="festif">
                        <div class="mood-emoji-check"><i class="fas fa-check"></i></div>
                        <span class="emoji">🎉</span>Festif
                    </button>
                    <button class="mood-emoji-btn" data-value="famille">
                        <div class="mood-emoji-check"><i class="fas fa-check"></i></div>
                        <span class="emoji">👨‍👩‍👧</span>Famille
                    </button>
                </div>
            </div>

            <div class="mood-section">
                <div class="mood-section-label"><i class="fas fa-map-pin"></i> Vos préférences</div>
                <div class="pref-chips">
                    <div class="pref-chip" data-value="plages et mer"><i class="fas fa-umbrella-beach"></i> Plages</div>
                    <div class="pref-chip" data-value="désert et dunes"><i class="fas fa-sun"></i> Désert</div>
                    <div class="pref-chip" data-value="culture et histoire"><i class="fas fa-landmark"></i> Culture</div>
                    <div class="pref-chip" data-value="gastronomie"><i class="fas fa-utensils"></i> Gastronomie</div>
                    <div class="pref-chip" data-value="nature et forêts"><i class="fas fa-tree"></i> Nature</div>
                    <div class="pref-chip" data-value="sport et aventure"><i class="fas fa-person-hiking"></i> Sport</div>
                    <div class="pref-chip" data-value="shopping et médinas"><i class="fas fa-shopping-bag"></i> Shopping</div>
                    <div class="pref-chip" data-value="détente et spa"><i class="fas fa-spa"></i> Spa</div>
                </div>
            </div>

            <div class="mood-section">
                <div class="mood-section-label"><i class="fas fa-coins"></i> Budget par personne</div>
                <div class="budget-track">
                    <div class="budget-display-row">
                        <div class="budget-display" id="budgetDisplay">500 DT</div>
                        <div class="budget-display-sub">par personne</div>
                    </div>
                    <input type="range" class="budget-slider" id="budgetSlider" min="100" max="2000" step="50" value="500">
                    <div class="budget-range-labels"><span>100 DT</span><span>2 000 DT</span></div>
                </div>
            </div>

            <div class="mood-section">
                <div class="mood-section-label"><i class="fas fa-cloud-sun"></i> Saison préférée</div>
                <div class="saison-btns">
                    <button class="saison-btn" data-value="printemps"><span>🌸</span>Printemps</button>
                    <button class="saison-btn" data-value="été"><span>☀️</span>Été</button>
                    <button class="saison-btn" data-value="automne"><span>🍂</span>Automne</button>
                    <button class="saison-btn" data-value="hiver"><span>❄️</span>Hiver</button>
                </div>
            </div>

            <button class="btn-recommend" id="btnRecommend" type="button">
                <i class="fas fa-wand-magic-sparkles"></i> Trouver mon voyage idéal
            </button>

            <div class="recommend-result" id="recommendResult">
                <div class="recommend-result-header">
                    <div class="recommend-result-header-icon"><i class="fas fa-robot"></i></div>
                    <div>
                        <div class="recommend-result-label">Recommandation IA</div>
                        <div class="recommend-result-name" id="recommendName"></div>
                    </div>
                </div>
                <div class="recommend-result-body">
                    <div class="recommend-result-price" id="recommendPrice"><i class="fas fa-tag"></i> </div>
                    <div class="recommend-result-raison" id="recommendRaison"></div>
                    <a href="#" class="btn-go-voyage" id="recommendLink">
                        <i class="fas fa-arrow-right"></i> Voir ce voyage
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===================== VOICE CALL BUTTON ===================== -->
<button class="call-trigger-btn" id="callTriggerBtn" aria-label="Appel avec le guide Tunisie">
    <i class="fas fa-microphone-alt"></i>
</button>
<div class="call-trigger-tooltip">Appeler le guide Tunisie</div>

<!-- ===================== CALL OVERLAY LUMINEUX ===================== -->
<div class="call-overlay" id="callOverlay">
    <div class="call-content">
        <div class="agent-info">
            <div class="call-timer" id="callTimer">00:00</div>
            <div class="agent-name">Guide Tunisie</div>
            <div class="agent-status" id="agentStatus">En attente...</div>
        </div>
        <div class="orb-container">
            <div class="orb-ring"></div>
            <div class="orb-ring"></div>
            <div class="orb-ring"></div>
            <div class="orb-sphere idle" id="orbSphere">
                <canvas class="orb-canvas" id="orbCanvas"></canvas>
            </div>
        </div>
        <div class="audio-bars" id="audioBars">
            <div class="audio-bar"></div><div class="audio-bar"></div><div class="audio-bar"></div>
            <div class="audio-bar"></div><div class="audio-bar"></div><div class="audio-bar"></div>
            <div class="audio-bar"></div>
        </div>
        <div class="call-transcript" id="callTranscript">
            <div class="transcript-line bot-line">Bonjour ! Appuyez sur le micro et parlez...</div>
        </div>
        <div class="call-text-input" id="callTextInput">
            <input type="text" id="callInputField" placeholder="Écrivez votre message...">
            <button id="callSendBtn"><i class="fas fa-paper-plane"></i></button>
        </div>
        <div class="call-controls">
            <button class="ctrl-btn ctrl-btn-mute" id="ctrlMute" title="Muet"><i class="fas fa-microphone-slash"></i></button>
            <button class="ctrl-btn ctrl-btn-end" id="ctrlEnd" title="Raccrocher"><i class="fas fa-phone-slash"></i></button>
            <button class="ctrl-btn ctrl-btn-keyboard" id="ctrlKeyboard" title="Clavier"><i class="fas fa-keyboard"></i></button>
        </div>
        <p class="call-hint">TUNISIAJOURNEY · GUIDE VOCAL IA</p>
    </div>
</div>

<!-- ===================== FLIPBOOK OVERLAY ===================== -->
<div class="flipbook-overlay" id="flipbookOverlay">
    <div class="flipbook-container">
        <button class="flipbook-close" id="flipbookClose"><i class="fas fa-times"></i></button>
        <button class="flipbook-sound-btn" id="flipbookSoundBtn"><i class="fas fa-music"></i></button>

        <div class="flipbook-book" id="flipbookBook">

            <div class="fb-page active" id="fb-page-0">
                <div class="fb-page-inner fb-cover">
                    <div class="fb-cover-content">
                        <span class="fb-cover-ornament">🌙</span>
                        <div class="fb-cover-subtitle">Édition Voyage · Collection Découverte</div>
                        <div class="fb-cover-title">Tunisia<br>Journey</div>
                        <div class="fb-cover-divider"></div>
                        <div class="fb-cover-tagline">Un voyage à travers les saveurs,<br>les couleurs et l'âme d'un pays unique.</div>
                        <div class="fb-cover-year">✦ Tunisie · Terre de Mille Visages ✦</div>
                    </div>
                </div>
            </div>

            <div class="fb-page" id="fb-page-1">
                <div class="fb-page-inner">
                    <div class="fb-toc">
                        <div class="fb-toc-title">Sommaire</div>
                        <div class="fb-toc-subtitle">Table des matières · فهرس المحتويات</div>
                        <ul class="fb-toc-list">
                            <li class="fb-toc-item" onclick="flipbookGoTo(2)"><span class="fb-toc-emoji">✨</span><span class="fb-toc-num">I.</span><span class="fb-toc-name">Introduction</span><span class="fb-toc-dots"></span><span class="fb-toc-page">2</span></li>
                            <li class="fb-toc-item" onclick="flipbookGoTo(3)"><span class="fb-toc-emoji">🏛️</span><span class="fb-toc-num">II.</span><span class="fb-toc-name">Histoire de la Tunisie</span><span class="fb-toc-dots"></span><span class="fb-toc-page">3</span></li>
                            <li class="fb-toc-item" onclick="flipbookGoTo(4)"><span class="fb-toc-emoji">🎭</span><span class="fb-toc-num">III.</span><span class="fb-toc-name">Culture & Traditions</span><span class="fb-toc-dots"></span><span class="fb-toc-page">4</span></li>
                            <li class="fb-toc-item" onclick="flipbookGoTo(5)"><span class="fb-toc-emoji">🍽️</span><span class="fb-toc-num">IV.</span><span class="fb-toc-name">Gastronomie Tunisienne</span><span class="fb-toc-dots"></span><span class="fb-toc-page">5</span></li>
                            <li class="fb-toc-item" onclick="flipbookGoTo(6)"><span class="fb-toc-emoji">🗺️</span><span class="fb-toc-num">V.</span><span class="fb-toc-name">Destinations Touristiques</span><span class="fb-toc-dots"></span><span class="fb-toc-page">6</span></li>
                            <li class="fb-toc-item" onclick="flipbookGoTo(7)"><span class="fb-toc-emoji">🏜️</span><span class="fb-toc-num">VI.</span><span class="fb-toc-name">Expérience du Désert</span><span class="fb-toc-dots"></span><span class="fb-toc-page">7</span></li>
                            <li class="fb-toc-item" onclick="flipbookGoTo(8)"><span class="fb-toc-emoji">🌊</span><span class="fb-toc-num">VII.</span><span class="fb-toc-name">Mer & Plages</span><span class="fb-toc-dots"></span><span class="fb-toc-page">8</span></li>
                            <li class="fb-toc-item" onclick="flipbookGoTo(9)"><span class="fb-toc-emoji">🧶</span><span class="fb-toc-num">VIII.</span><span class="fb-toc-name">Expériences Locales</span><span class="fb-toc-dots"></span><span class="fb-toc-page">9</span></li>
                            <li class="fb-toc-item" onclick="flipbookGoTo(10)"><span class="fb-toc-emoji">💡</span><span class="fb-toc-num">IX.</span><span class="fb-toc-name">Conseils de Voyage</span><span class="fb-toc-dots"></span><span class="fb-toc-page">10</span></li>
                            <li class="fb-toc-item" onclick="flipbookGoTo(11)"><span class="fb-toc-emoji">💛</span><span class="fb-toc-num">X.</span><span class="fb-toc-name">Pourquoi la Tunisie ?</span><span class="fb-toc-dots"></span><span class="fb-toc-page">11</span></li>
                        </ul>
                    </div>
                    <div class="fb-spine"></div>
                    <div class="fb-right" style="max-width:260px;flex:0 0 260px;">
                        <img src="https://i.pinimg.com/1200x/40/79/5a/40795a77f4822edd456542c3719eac93.jpg" alt="Médina de Tunis">
                        <div class="fb-caption">Médina de Tunis · Patrimoine UNESCO</div>
                    </div>
                </div>
            </div>

            <div class="fb-page" id="fb-page-2">
                <div class="fb-page-inner">
                    <div class="fb-left fb-paper">
                        <div class="fb-chapter-label">Chapitre I</div>
                        <div class="fb-title">Bienvenue en Tunisie</div>
                        <div class="fb-divider"></div>
                        <div class="fb-text">
                            Il existe des terres qui ne se visitent pas, elles se <em>ressentent</em>. La Tunisie est l'une d'elles. Dès que vous posez le pied sur ce sol ancien, quelque chose change en vous.
                            <br><br>
                            Entre le bleu infini de la Méditerranée et l'or brûlant du Sahara, entre les ruelles parfumées des médinas et les ruines silencieuses de Carthage, ce pays vous raconte une histoire qui dure depuis des millénaires.
                        </div>
                        <div class="fb-quote">
                            "La Tunisie, c'est un pays qui entre dans le cœur et n'en repart plus."
                        </div>
                        <div class="fb-page-num">— page 2 —</div>
                    </div>
                    <div class="fb-spine"></div>
                    <div class="fb-right">
                        <img src="https://i.pinimg.com/736x/7c/2b/d0/7c2bd0de408877e20d375ef79a0d5a20.jpg" alt="Sidi Bou Saïd">
                        <div class="fb-caption">Sidi Bou Saïd · Le village bleu et blanc</div>
                    </div>
                </div>
            </div>

            <div class="fb-page" id="fb-page-3">
                <div class="fb-page-inner">
                    <div class="fb-left fb-paper">
                        <div class="fb-chapter-label">Chapitre II</div>
                        <span class="fb-icon">🏛️</span>
                        <div class="fb-title">Une Histoire<br>Millénaire</div>
                        <div class="fb-divider"></div>
                        <div class="fb-text">
