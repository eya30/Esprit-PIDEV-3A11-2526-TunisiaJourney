// ==================== VOICE CALL ENGINE ====================
const callOverlay    = document.getElementById('callOverlay');
const callTriggerBtn = document.getElementById('callTriggerBtn');
const orbSphere      = document.getElementById('orbSphere');
const orbCanvas      = document.getElementById('orbCanvas');
const agentStatus    = document.getElementById('agentStatus');
const callTranscript = document.getElementById('callTranscript');
const audioBars      = document.getElementById('audioBars');
const callTimer      = document.getElementById('callTimer');
const ctrlMute       = document.getElementById('ctrlMute');
const ctrlEnd        = document.getElementById('ctrlEnd');
const ctrlKeyboard   = document.getElementById('ctrlKeyboard');
const callTextInput  = document.getElementById('callTextInput');
const callInputField = document.getElementById('callInputField');
const callSendBtn    = document.getElementById('callSendBtn');

let callActive=false, isMuted=false, timerInterval=null, timerSeconds=0;
let recognition=null, isListening=false, isSpeaking=false;
let synth=window.speechSynthesis, conversationHistory=[];
let orbAnimFrame=null, audioCtx=null, analyser=null, micStream=null, lastVolume=0;
let abortController=null;

function setupCanvas() { const dpr=window.devicePixelRatio||1,size=orbSphere.offsetWidth||140; orbCanvas.width=size*dpr; orbCanvas.height=size*dpr; orbCanvas.style.width=size+'px'; orbCanvas.style.height=size+'px'; orbCanvas.getContext('2d').scale(dpr,dpr); }
function drawWave(volume,state) {
    const ctx=orbCanvas.getContext('2d'),w=orbCanvas.width/(window.devicePixelRatio||1),h=orbCanvas.height/(window.devicePixelRatio||1);
    ctx.clearRect(0,0,w,h); const cx=w/2,cy=h/2,baseR=Math.min(w,h)*0.38,points=80,time=Date.now()/1000;
    let color1,color2;
    if(state==='listening'){color1='rgba(59,130,246,0.8)';color2='rgba(96,165,250,0.4)';}
    else if(state==='speaking'){color1='rgba(16,185,129,0.8)';color2='rgba(34,197,94,0.4)';}
    else if(state==='thinking'){color1='rgba(245,158,11,0.8)';color2='rgba(251,191,36,0.4)';}
    else{color1='rgba(193,120,23,0.6)';color2='rgba(125,46,62,0.3)';}
    const grad=ctx.createRadialGradient(cx,cy,0,cx,cy,baseR); grad.addColorStop(0,color2); grad.addColorStop(1,'transparent');
    ctx.beginPath(); ctx.arc(cx,cy,baseR,0,Math.PI*2); ctx.fillStyle=grad; ctx.fill();
    ctx.beginPath();
    for(let i=0;i<=points;i++){const angle=(i/points)*Math.PI*2;let r=baseR;if(state!=='idle'){let freq1=0;if(analyser){const buf=new Uint8Array(analyser.frequencyBinCount);analyser.getByteFrequencyData(buf);freq1=(buf[Math.floor((i/points)*buf.length)]||0)/255;}const wave=Math.sin(angle*4+time*3)*(volume*25+6)+Math.sin(angle*7+time*5)*(volume*15+3)+Math.sin(angle*2+time*1.5)*4+freq1*20*volume;r=baseR+wave;}else{r=baseR+Math.sin(angle*3+time*0.8)*3+Math.cos(angle*5+time*1.2)*2;}const x=cx+r*Math.cos(angle),y=cy+r*Math.sin(angle);if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y);}
    ctx.closePath(); ctx.strokeStyle=color1; ctx.lineWidth=1.5; ctx.stroke();
    ctx.beginPath(); ctx.arc(cx,cy,4,0,Math.PI*2); ctx.fillStyle=color1; ctx.fill();
}
function animateOrb() {
    const state=orbSphere.classList.contains('listening')?'listening':orbSphere.classList.contains('speaking')?'speaking':orbSphere.classList.contains('thinking')?'thinking':'idle';
    let volume=0;
    if(analyser&&state==='listening'){const buf=new Uint8Array(analyser.frequencyBinCount);analyser.getByteFrequencyData(buf);volume=buf.reduce((a,b)=>a+b,0)/buf.length/128;}
    else if(state==='speaking'){volume=0.3+Math.sin(Date.now()/200)*0.2;}
    lastVolume=lastVolume*0.7+volume*0.3; drawWave(lastVolume,state);
    orbAnimFrame=requestAnimationFrame(animateOrb);
}
function startTimer() { timerSeconds=0; timerInterval=setInterval(()=>{timerSeconds++;const m=String(Math.floor(timerSeconds/60)).padStart(2,'0'),s=String(timerSeconds%60).padStart(2,'0');callTimer.textContent=m+':'+s;},1000); }
function stopTimer() { clearInterval(timerInterval); timerInterval=null; }
function setOrbState(state) {
    orbSphere.classList.remove('idle','listening','speaking','thinking'); orbSphere.classList.add(state);
    const labels={idle:'En attente...',listening:'Je vous écoute...',speaking:'Je vous réponds...',thinking:'Réflexion...'};
    const statusClasses={idle:'',listening:'listening',speaking:'speaking',thinking:'thinking'};
    agentStatus.textContent=labels[state]||''; agentStatus.className='agent-status '+(statusClasses[state]||'');
    audioBars.classList.toggle('active',state==='listening');
}
function addTranscriptLine(text,isUser) {
    const dots=callTranscript.querySelector('.typing-dots-container'); if(dots)dots.remove();
    const div=document.createElement('div'); div.className='transcript-line '+(isUser?'user-line':'bot-line');
    div.textContent=isUser?'🎤 '+text:text; callTranscript.appendChild(div);
    const lines=callTranscript.querySelectorAll('.transcript-line'); if(lines.length>6)lines[0].remove();
    callTranscript.scrollTop=callTranscript.scrollHeight;
}
function showThinkingDots() { const div=document.createElement('div'); div.className='transcript-line bot-line typing-dots-container'; div.innerHTML='<div class="typing-dots"><span></span><span></span><span></span></div>'; callTranscript.appendChild(div); callTranscript.scrollTop=callTranscript.scrollHeight; }
function speakText(text) {
    if(!synth)return; synth.cancel();
    const clean=text.replace(/[#*_`\[\]]/g,'').replace(/\n/g,'. ').replace(/\s+/g,' ').trim();
    const utter=new SpeechSynthesisUtterance(clean); utter.lang='fr-FR'; utter.rate=0.95; utter.pitch=1.05; utter.volume=1;
    const voices=synth.getVoices(); const frVoice=voices.find(v=>v.lang.startsWith('fr')&&v.localService)||voices.find(v=>v.lang.startsWith('fr'))||null;
    if(frVoice)utter.voice=frVoice;
    utter.onstart=()=>{setOrbState('speaking');isSpeaking=true;};
    utter.onend=()=>{isSpeaking=false;if(callActive&&!isMuted){setTimeout(()=>{if(callActive&&!isMuted&&!isSpeaking)startListening();},500);}else setOrbState('idle');};
    utter.onerror=()=>{isSpeaking=false;setOrbState('idle');};
    synth.speak(utter);
}

async function sendToAI(text) {
    if(abortController) abortController.abort();
    abortController = new AbortController();
    setOrbState('thinking');
    showThinkingDots();
    conversationHistory.push({ role: 'user', content: text });
    if (conversationHistory.length > 20) conversationHistory = conversationHistory.slice(-20);
    try {
        const formData = new URLSearchParams();
        formData.append('question', text);
        formData.append('history', JSON.stringify(conversationHistory.slice(0, -1)));
        const res  = await fetch('{{ path("app_ai_ask") }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body:    formData.toString(),
            signal:  abortController.signal
        });
        const data   = await res.json();
        const answer = data.answer || "Je suis désolé, je n'ai pas pu répondre.";
        conversationHistory.push({ role: 'assistant', content: answer });
        if (conversationHistory.length > 20) conversationHistory = conversationHistory.slice(-20);
        addTranscriptLine(answer, false);
        speakText(answer);
    } catch(e) {
        if (e.name === 'AbortError') return;
        const fallback = "Désolé, connexion interrompue. Réessayez !";
        addTranscriptLine(fallback, false);
        speakText(fallback);
    }
}
function setupRecognition() {
    const SR=window.SpeechRecognition||window.webkitSpeechRecognition; if(!SR)return null;
    const r=new SR(); r.lang='fr-FR'; r.continuous=false; r.interimResults=true; r.maxAlternatives=1;
    let finalTranscript='';
    r.onstart=()=>{isListening=true;finalTranscript='';setOrbState('listening');};
    r.onend=()=>{isListening=false;if(!isSpeaking)setOrbState('idle');if(finalTranscript.trim()){addTranscriptLine(finalTranscript.trim(),true);sendToAI(finalTranscript.trim());finalTranscript='';}};
    r.onresult=(e)=>{let interim='';for(let i=e.resultIndex;i<e.results.length;i++){if(e.results[i].isFinal)finalTranscript+=e.results[i][0].transcript;else interim+=e.results[i][0].transcript;}if(interim){const existing=callTranscript.querySelector('.interim-line');if(existing)existing.remove();const div=document.createElement('div');div.className='transcript-line user-line interim-line';div.style.opacity='0.6';div.textContent='🎤 '+interim+'...';callTranscript.appendChild(div);callTranscript.scrollTop=callTranscript.scrollHeight;}};
    r.onerror=(e)=>{isListening=false;const interim=callTranscript.querySelector('.interim-line');if(interim)interim.remove();if(e.error==='no-speech'&&callActive&&!isMuted&&!isSpeaking){setTimeout(()=>{if(callActive&&!isMuted&&!isSpeaking)startListening();},800);}};
    return r;
}
function startListening() { if(!recognition||isMuted||isSpeaking||!callActive)return; try{recognition.start();}catch(e){} }
function stopListening() { if(recognition){try{recognition.stop();}catch(e){}} isListening=false; }
async function setupMicAnalyser() { try{const stream=await navigator.mediaDevices.getUserMedia({audio:true});micStream=stream;audioCtx=new(window.AudioContext||window.webkitAudioContext)();const source=audioCtx.createMediaStreamSource(stream);analyser=audioCtx.createAnalyser();analyser.fftSize=256;source.connect(analyser);}catch(e){console.warn('Mic access:',e);} }
async function openCall() {
    callActive=true;conversationHistory=[];
    callOverlay.classList.add('visible'); requestAnimationFrame(()=>callOverlay.classList.add('active'));
    document.body.style.overflow='hidden';
    setupCanvas(); if(!orbAnimFrame)animateOrb(); startTimer();
    await setupMicAnalyser(); recognition=setupRecognition();
    const greeting="Bonjour ! Je suis votre guide TunisiaJourney. Je peux vous parler de nos voyages, des destinations en Tunisie, de la gastronomie, ou répondre à toutes vos questions. Parlez-moi !";
    callTranscript.innerHTML=''; addTranscriptLine(greeting,false); speakText(greeting);
}
function closeCall() {
    callActive=false; stopListening(); synth.cancel(); stopTimer();
    if(abortController){abortController.abort();abortController=null;}
    isSpeaking=false;isListening=false;
    if(micStream){micStream.getTracks().forEach(t=>t.stop());micStream=null;}
    if(audioCtx){audioCtx.close();audioCtx=null;analyser=null;}
    if(orbAnimFrame){cancelAnimationFrame(orbAnimFrame);orbAnimFrame=null;}
    callOverlay.classList.remove('active'); setTimeout(()=>callOverlay.classList.remove('visible'),400);
    document.body.style.overflow=''; callTextInput.classList.remove('visible'); setOrbState('idle');
    timerSeconds=0;callTimer.textContent='00:00';
}
callTriggerBtn.addEventListener('click', openCall);
ctrlEnd.addEventListener('click', closeCall);
ctrlMute.addEventListener('click',()=>{isMuted=!isMuted;ctrlMute.classList.toggle('muted',isMuted);if(isMuted){stopListening();setOrbState('idle');}else if(callActive&&!isSpeaking)startListening();});
ctrlKeyboard.addEventListener('click',()=>{const visible=callTextInput.classList.toggle('visible');ctrlKeyboard.classList.toggle('active',visible);if(visible)callInputField.focus();});
function sendTextMessage(){const text=callInputField.value.trim();if(!text)return;callInputField.value='';stopListening();addTranscriptLine(text,true);sendToAI(text);}
callSendBtn.addEventListener('click',sendTextMessage);
callInputField.addEventListener('keypress',e=>{if(e.key==='Enter')sendTextMessage();});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&callActive)closeCall();});
if(synth.onvoiceschanged!==undefined)synth.onvoiceschanged=()=>{};

// ==================== FLIPBOOK ENGINE ====================
const flipbookOverlay   = document.getElementById('flipbookOverlay');
const flipbookTriggerBtn= document.getElementById('flipbookTriggerBtn');
const flipbookClose     = document.getElementById('flipbookClose');
const flipbookSoundBtn  = document.getElementById('flipbookSoundBtn');
const fbPrev            = document.getElementById('fbPrev');
const fbNext            = document.getElementById('fbNext');
const fbIndicator       = document.getElementById('fbIndicator');

const FB_TOTAL_PAGES = 12;
let fbCurrentPage  = 0;
let fbIsAnimating  = false;
let fbSoundMuted   = false;
let ytPlayer       = null;
let ytReady        = false;

const fbPageLabels = [
    'Couverture', 'Sommaire', 'Introduction', 'Histoire',
    'Culture', 'Gastronomie', 'Destinations', 'Désert',
    'Mer & Plages', 'Artisanat', 'Conseils', 'Épilogue'
];

window.onYouTubeIframeAPIReady = function() {
    ytReady = true;
    ytPlayer = new YT.Player('yt-player', {
        videoId: 'ic8F58kk1-o',
        playerVars: { autoplay: 0, controls: 0, loop: 1, playlist: 'ic8F58kk1-o', modestbranding: 1, rel: 0 },
        events: { onReady: function(e) { e.target.setVolume(55); } }
    });
};

(function loadYT() {
    const tag = document.createElement('script');
    tag.src = 'https://www.youtube.com/iframe_api';
    document.head.appendChild(tag);
})();

function fbPlayMusic() { if (ytPlayer && ytReady && !fbSoundMuted) { try { ytPlayer.playVideo(); } catch(e) {} } }
function fbPauseMusic() { if (ytPlayer && ytReady) { try { ytPlayer.pauseVideo(); } catch(e) {} } }

flipbookSoundBtn.addEventListener('click', () => {
    fbSoundMuted = !fbSoundMuted;
    flipbookSoundBtn.classList.toggle('muted', fbSoundMuted);
    flipbookSoundBtn.innerHTML = fbSoundMuted ? '<i class="fas fa-volume-mute"></i>' : '<i class="fas fa-music"></i>';
    if (fbSoundMuted) fbPauseMusic();
    else fbPlayMusic();
});

function fbUpdateNav() {
    fbPrev.disabled = fbCurrentPage === 0;
    fbNext.disabled = fbCurrentPage === FB_TOTAL_PAGES - 1;
    fbIndicator.textContent = fbPageLabels[fbCurrentPage] || `Page ${fbCurrentPage}`;
}

function fbShowPage(index, direction) {
    if (fbIsAnimating) return;
    if (index < 0 || index >= FB_TOTAL_PAGES) return;
    const currentEl = document.getElementById('fb-page-' + fbCurrentPage);
    const nextEl    = document.getElementById('fb-page-' + index);
    if (!currentEl || !nextEl) return;
    fbIsAnimating = true;
    const outClass = direction === 'next' ? 'turning-out' : 'turning-out-back';
    const inClass  = direction === 'next' ? 'turning-in'  : 'turning-in-back';
    currentEl.classList.add(outClass);
    currentEl.classList.remove('active');
    setTimeout(() => {
        currentEl.classList.remove(outClass);
        currentEl.style.display = 'none';
        nextEl.classList.add('active', inClass);
        nextEl.style.display = '';
        setTimeout(() => {
            nextEl.classList.remove(inClass);
            fbCurrentPage = index;
            fbUpdateNav();
            fbIsAnimating = false;
        }, 560);
    }, 560);
}

function flipbookGoTo(index) {
    const dir = index > fbCurrentPage ? 'next' : 'prev';
    fbShowPage(index, dir);
}

fbNext.addEventListener('click', () => { if (fbCurrentPage < FB_TOTAL_PAGES - 1) flipbookGoTo(fbCurrentPage + 1); });
fbPrev.addEventListener('click', () => { if (fbCurrentPage > 0) flipbookGoTo(fbCurrentPage - 1); });

flipbookTriggerBtn.addEventListener('click', () => {
    flipbookOverlay.classList.add('open');
    document.body.style.overflow = 'hidden';
    fbUpdateNav();
    setTimeout(fbPlayMusic, 800);
});

function closeFlipbook() { flipbookOverlay.classList.remove('open'); document.body.style.overflow = ''; fbPauseMusic(); }
flipbookClose.addEventListener('click', closeFlipbook);
flipbookOverlay.addEventListener('click', (e) => { if (e.target === flipbookOverlay) closeFlipbook(); });

document.addEventListener('keydown', (e) => {
    if (!flipbookOverlay.classList.contains('open')) return;
    if (e.key === 'ArrowRight') fbNext.click();
    if (e.key === 'ArrowLeft')  fbPrev.click();
    if (e.key === 'Escape') closeFlipbook();
});

(function initSwipe() {
    const book = document.getElementById('flipbookBook');
    if (!book) return;
    let startX = 0;
    book.addEventListener('touchstart', e => { startX = e.touches[0].clientX; }, {passive:true});
    book.addEventListener('touchend', e => {
        const diff = startX - e.changedTouches[0].clientX;
        if (Math.abs(diff) > 50) { if (diff > 0) fbNext.click(); else fbPrev.click(); }
    }, {passive:true});
})();

fbUpdateNav();
</script>
