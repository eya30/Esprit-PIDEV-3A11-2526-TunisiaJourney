    .flipbook-sound-btn.muted { color: #6B7280; border-color: rgba(107,114,128,0.3); background: rgba(107,114,128,0.1); }
    .flipbook-book { width: 100%; max-width: 900px; height: 560px; position: relative; perspective: 2400px; transform-style: preserve-3d; }
    .fb-page { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: none; border-radius: 4px 16px 16px 4px; overflow: hidden; box-shadow: 8px 8px 40px rgba(0,0,0,0.5), -4px 0 20px rgba(0,0,0,0.3); }
    .fb-page.active { display: flex; }
    .fb-page.turning-out { display: flex; animation: pageFlipOut 0.55s cubic-bezier(0.55, 0, 1, 0.45) forwards; transform-origin: left center; }
    .fb-page.turning-in { display: flex; animation: pageFlipIn 0.55s cubic-bezier(0, 0.55, 0.45, 1) forwards; transform-origin: left center; }
    .fb-page.turning-out-back { display: flex; animation: pageFlipOutBack 0.55s cubic-bezier(0.55, 0, 1, 0.45) forwards; transform-origin: left center; }
    .fb-page.turning-in-back { display: flex; animation: pageFlipInBack 0.55s cubic-bezier(0, 0.55, 0.45, 1) forwards; transform-origin: left center; }
    @keyframes pageFlipOut { 0% { transform: rotateY(0deg); opacity:1; } 100% { transform: rotateY(-90deg); opacity:0; } }
    @keyframes pageFlipIn { 0% { transform: rotateY(90deg); opacity:0; } 100% { transform: rotateY(0deg); opacity:1; } }
    @keyframes pageFlipOutBack { 0% { transform: rotateY(0deg); opacity:1; } 100% { transform: rotateY(90deg); opacity:0; } }
    @keyframes pageFlipInBack { 0% { transform: rotateY(-90deg); opacity:0; } 100% { transform: rotateY(0deg); opacity:1; } }
