{% extends 'base.html.twig' %}

{% block title %}TunisiaJourney - Découvrez les voyages en Tunisie{% endblock %}

{% block stylesheets %}
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Poppins:wght@300;400;500;600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
    :root {
        --bleu-nuit:    #1B3A4B;
        --or-ambre:     #C17817;
        --or-light:     #E8960E;
        --bordeaux:     #7D2E3E;
        --bordeaux-deep:#5E1F2C;
        --vert-sauge:   #3D6B4F;
        --vert-deep:    #2A4F38;
        --cream:        #FEF9F0;
        --cream-dark:   #F9EDD8;
        --gray-soft:    #F5F2EE;
        --gray-text:    #6B7280;
        --dark:         #1A1A2E;
        --white:        #FFFFFF;
        --shadow-sm:    0 2px 12px rgba(27,58,75,0.09);
        --shadow-md:    0 8px 32px rgba(27,58,75,0.13);
        --shadow-lg:    0 20px 56px rgba(27,58,75,0.18);
        --radius-card:  24px;
        --radius-btn:   50px;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Poppins', sans-serif; background: var(--cream); }

    /* =============================================
       HERO
       ============================================= */
    .hero {
        position: relative;
        height: 58vh; min-height: 420px;
        background-image: linear-gradient(155deg, rgba(27,58,75,0.80) 0%, rgba(125,46,62,0.65) 60%, rgba(61,107,79,0.45) 100%), url('https://switchmed.eu/wp-content/uploads/2020/04/tunisia-1.jpg');
        background-size: cover; background-position: center; background-attachment: fixed;
        display: flex; align-items: center; justify-content: center; text-align: center; overflow: hidden;
    }
    .hero::after {
        content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 120px;
        background: linear-gradient(to top, var(--cream), transparent); pointer-events: none;
    }
    .hero-content {
        position: relative; z-index: 2; max-width: 720px; padding: 2.5rem 3.5rem;
        background: rgba(255,255,255,0.12); backdrop-filter: blur(28px);
        border-radius: 44px; border: 1px solid rgba(255,255,255,0.25);
        box-shadow: 0 32px 80px rgba(0,0,0,0.28), inset 0 1px 0 rgba(255,255,255,0.15);
        animation: fadeInUp 1s ease forwards; margin: 0 1.5rem;
    }
    @keyframes fadeInUp { from { opacity:0; transform:translateY(40px); } to { opacity:1; transform:translateY(0); } }
    .hero h1 {
        font-family: 'Cormorant Garamond', serif; font-size: 3.6rem; font-weight: 700;
        color: #FFFFFF; letter-spacing: 3px; margin-bottom: 1rem;
        text-shadow: 0 2px 24px rgba(0,0,0,0.3);
    }
    .hero-divider {
        width: 60px; height: 3px;
        background: linear-gradient(90deg, transparent, var(--or-ambre), #e8a832, transparent);
        border-radius: 3px; margin: 0 auto 1.2rem;
    }
    .hero p { font-size: 1.05rem; font-weight: 300; line-height: 1.75; color: rgba(255,255,255,0.90); letter-spacing: 0.3px; }

    /* =============================================
       SECTION TITLES
       ============================================= */
    .section-title {
        text-align: center; font-family: 'Cormorant Garamond', serif;
        font-size: 3rem; font-weight: 700; color: var(--bordeaux); margin-bottom: 0.6rem;
        letter-spacing: 1px;
    }
    .section-title:after { display: block; color: var(--or-ambre); font-size: 1.2rem; margin-top: 0.6rem; letter-spacing: 10px; }
    .section-subtitle { text-align: center; color: var(--gray-text); font-size: 1rem; margin-bottom: 3rem; font-style: italic; font-family: 'DM Sans', sans-serif; }

    /* =============================================
       WISHLIST
       ============================================= */
    .wishlist-icon { cursor: pointer; margin-left: auto; transition: all 0.3s ease; display: inline-flex; align-items: center; gap: 8px; background: white; padding: 9px 20px; border-radius: 50px; box-shadow: var(--shadow-sm); border: 1px solid rgba(193,120,23,0.15); width: fit-content; }
    .wishlist-icon i { font-size: 1.1rem; color: var(--bordeaux); }
    .wishlist-icon span { font-size: 0.88rem; font-weight: 600; color: var(--dark); font-family: 'DM Sans', sans-serif; }
    .wishlist-icon:hover { transform: scale(1.03); background: #FFF6EE; border-color: var(--or-ambre); box-shadow: 0 4px 16px rgba(193,120,23,0.2); }
    .wishlist-count { background: linear-gradient(135deg, #E31B23, #c01018); color: white; font-size: 0.68rem; font-weight: 700; padding: 2px 7px; border-radius: 50%; margin-left: 4px; }
    .wishlist-sidebar { position: fixed; top: 0; right: -450px; width: 450px; height: 100vh; background: white; box-shadow: -5px 0 40px rgba(0,0,0,0.12); z-index: 1060; transition: right 0.35s cubic-bezier(0.16,1,0.3,1); overflow-y: auto; padding: 1.5rem; }
    .wishlist-sidebar.open { right: 0; }
    .wishlist-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.45); z-index: 1055; display: none; }
    .wishlist-overlay.active { display: block; }
    .wishlist-header { display: flex; justify-content: space-between; align-items: center; padding-bottom: 1rem; margin-bottom: 1.5rem; border-bottom: 2px solid #F0E8DD; }
    .wishlist-header h4 { font-family: 'Cormorant Garamond', serif; font-size: 1.5rem; color: var(--bordeaux); margin: 0; }
    .close-wishlist { background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #9CA3AF; transition: all 0.2s; }
    .close-wishlist:hover { color: var(--bordeaux); transform: rotate(90deg); }
    .wishlist-item { display: flex; gap: 1rem; padding: 1rem; margin-bottom: 1rem; background: #FEF9F0; border-radius: 18px; border: 1px solid #F0E8DD; transition: all 0.2s; position: relative; }
    .wishlist-item:hover { transform: translateX(-5px); border-color: var(--bordeaux); }
    .wishlist-item-img { width: 80px; height: 80px; border-radius: 14px; object-fit: cover; }
    .wishlist-item-info { flex: 1; }
    .wishlist-item-title { font-weight: 700; color: var(--bordeaux); margin-bottom: 0.3rem; font-family: 'DM Sans', sans-serif; }
    .wishlist-item-price { color: var(--or-ambre); font-weight: 600; font-size: 0.9rem; }
    .wishlist-item-remove { position: absolute; top: 5px; right: 10px; background: none; border: none; color: #EF4444; cursor: pointer; font-size: 1.2rem; }
    .empty-wishlist { text-align: center; padding: 2rem; color: #9CA3AF; }

    /* =============================================
       SEARCH + SORT BAR
       ============================================= */
    .search-sort-bar {
        background: var(--white); padding: 1.3rem 2rem;
        border-radius: 24px;
        box-shadow: var(--shadow-md);
        border: 1px solid rgba(193,120,23,0.10);
        margin-bottom: 3rem;
        display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;
    }
    .search-field-wrapper { position: relative; flex: 1; min-width: 260px; }
    .search-icon { position: absolute; left: 18px; top: 50%; transform: translateY(-50%); color: var(--or-ambre); font-size: 0.95rem; pointer-events: none; }
    .search-input {
        width: 100%; padding: 13px 48px;
        border: 2px solid rgba(193,120,23,0.25);
        border-radius: 50px;
        background: var(--gray-soft);
        font-size: 0.92rem; font-family: 'DM Sans', sans-serif;
        color: var(--dark); outline: none; transition: all 0.3s ease;
        letter-spacing: 0.2px;
    }
    .search-input:focus { border-color: var(--or-ambre); background: var(--white); box-shadow: 0 0 0 4px rgba(193,120,23,0.10); }
    .search-input::placeholder { color: #B8AFA8; font-style: italic; }
    .search-clear-btn { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); background: rgba(193,120,23,0.10); border: none; color: var(--or-ambre); font-size: 0.75rem; cursor: pointer; border-radius: 50%; width: 24px; height: 24px; display: none; align-items: center; justify-content: center; }
    .search-clear-btn.visible { display: flex; }
    .search-clear-btn:hover { background: var(--or-ambre); color: white; }
    .sort-wrapper { position: relative; }
    .sort-toggle-btn {
        display: flex; align-items: center; gap: 10px; padding: 12px 22px;
        border: none; border-radius: 50px;
        background: linear-gradient(135deg, var(--bleu-nuit) 0%, #275168 100%);
        color: white; font-weight: 600; font-size: 0.88rem;
        cursor: pointer; transition: all 0.3s ease;
        font-family: 'DM Sans', sans-serif;
        box-shadow: 0 4px 16px rgba(27,58,75,0.30);
        letter-spacing: 0.2px;
    }
    .sort-toggle-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(27,58,75,0.42); }
    .sort-chevron { transition: transform 0.28s ease; font-size: 0.75rem; }
    .sort-toggle-btn.open .sort-chevron { transform: rotate(180deg); }
    .sort-dropdown-menu { display: none; position: absolute; top: calc(100% + 10px); right: 0; background: var(--white); border-radius: 20px; box-shadow: 0 20px 50px rgba(27,58,75,0.18); min-width: 240px; z-index: 9999; overflow: hidden; padding: 8px 0; border: 1px solid rgba(27,58,75,0.08); }
    .sort-dropdown-menu.open { display: block; animation: dropFade 0.2s ease; }
    @keyframes dropFade { from { opacity:0; transform:translateY(-8px); } to { opacity:1; transform:translateY(0); } }
    .sort-option { display: flex; align-items: center; gap: 12px; padding: 12px 22px; font-size: 0.88rem; color: var(--bleu-nuit); cursor: pointer; transition: all 0.18s; font-weight: 500; font-family: 'DM Sans', sans-serif; }
    .sort-option:hover { background: var(--gray-soft); }
    .sort-option.active { background: rgba(27,58,75,0.07); font-weight: 700; }
    .sort-option i { width: 20px; color: var(--or-ambre); }

    /* =============================================
       VOYAGE CARDS — REFONTE COMPLÈTE
       ============================================= */
    .voyages-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 32px; margin: 0; padding: 0; }
    .voyage-item { display: flex; height: 100%; }

    .card-custom {
        background: var(--white);
        border-radius: var(--radius-card);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        transition: all 0.45s cubic-bezier(0.16,1,0.3,1);
        border: 1px solid rgba(27,58,75,0.07);
        display: flex; flex-direction: column; width: 100%; height: 100%;
        position: relative;
    }
    .card-custom:hover {
        transform: translateY(-9px);
        box-shadow: var(--shadow-lg);
        border-color: rgba(193,120,23,0.25);
    }
    .card-custom::before {
        content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px;
        background: linear-gradient(90deg, var(--bordeaux) 0%, var(--or-ambre) 50%, var(--vert-sauge) 100%);
        opacity: 0; transition: opacity 0.4s ease;
        border-radius: var(--radius-card) var(--radius-card) 0 0; z-index: 2;
    }
    .card-custom:hover::before { opacity: 1; }

    /* IMAGE */
    .card-img { height: 230px; overflow: hidden; position: relative; flex-shrink: 0; }
    .card-img img {
        width: 100%; height: 100%; object-fit: cover;
        transition: transform 0.65s cubic-bezier(0.16,1,0.3,1);
        filter: saturate(1.05);
    }
    .card-custom:hover .card-img img { transform: scale(1.07); filter: saturate(1.15); }
    .card-img::after {
        content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 60%;
        background: linear-gradient(to top, rgba(27,58,75,0.6), transparent); pointer-events: none;
    }

    /* BADGE */
    .card-badge {
        position: absolute; bottom: 14px; left: 14px;
        background: linear-gradient(135deg, var(--or-ambre), var(--or-light));
        color: white; padding: 5px 14px; border-radius: 20px;
        font-weight: 700; font-size: 0.68rem; z-index: 2;
        box-shadow: 0 3px 12px rgba(193,120,23,0.45);
        display: flex; align-items: center; gap: 6px;
        letter-spacing: 0.5px; text-transform: uppercase;
        font-family: 'DM Sans', sans-serif;
    }

    /* WISHLIST STAR */
    .wishlist-star {
        position: absolute; top: 14px; right: 14px;
        background: rgba(255,255,255,0.2); backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,0.3);
        border-radius: 50%; width: 38px; height: 38px;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; z-index: 10; transition: all 0.25s;
    }
    .wishlist-star i { font-size: 16px; color: rgba(255,255,255,0.9); text-shadow: 0 1px 3px rgba(0,0,0,0.3); }
    .wishlist-star.active { background: rgba(255,215,0,0.25); border-color: rgba(255,215,0,0.5); }
    .wishlist-star.active i { color: #FFD700; }
    .wishlist-star:hover { transform: scale(1.12); background: rgba(255,255,255,0.3); }

    /* CARD CONTENT */
    .card-content {
        padding: 1.5rem 1.7rem 1.7rem;
        display: flex; flex-direction: column; flex: 1; gap: 0.6rem;
    }

    /* CARD TITLE */
    .card-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.45rem; font-weight: 700;
        color: var(--bleu-nuit); line-height: 1.2;
        transition: color 0.25s; margin: 0;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
        min-height: 58px; letter-spacing: 0.3px;
    }
    .card-custom:hover .card-title { color: var(--bordeaux); }

    /* LOCATION */
    .card-location {
        color: var(--gray-text); font-size: 0.82rem; font-weight: 500;
        display: flex; align-items: center; gap: 7px;
        font-family: 'DM Sans', sans-serif;
    }
    .card-location i { color: var(--or-ambre); font-size: 0.78rem; }

    /* DESCRIPTION */
    .card-desc {
        color: #7A7066; line-height: 1.6; font-size: 0.84rem;
        display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
        flex: 1; font-family: 'DM Sans', sans-serif;
    }

    /* META */
    .card-meta {
        display: flex; gap: 0.8rem; font-size: 0.74rem; color: var(--gray-text);
        flex-wrap: wrap; margin-top: auto;
        font-family: 'DM Sans', sans-serif;
    }
    .card-meta span {
        display: flex; align-items: center; gap: 4px;
        background: var(--gray-soft); padding: 4px 10px; border-radius: 20px;
        font-weight: 500;
    }
    .card-meta i { color: var(--or-ambre); font-size: 0.68rem; }

    /* DIVIDER */
    .card-divider {
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(193,120,23,0.2), transparent);
        margin: 0.2rem 0;
    }

    /* PRICE */
    .card-price {
        font-size: 1.45rem; font-weight: 800; color: var(--bordeaux);
        margin: 0.1rem 0;
        font-family: 'Cormorant Garamond', serif;
        letter-spacing: 0.5px;
    }
    .card-price span { font-size: 0.72rem; font-weight: 400; color: var(--gray-text); font-family: 'DM Sans', sans-serif; margin-left: 2px; }

    /* BUTTONS */
    .button-group { display: flex; gap: 10px; margin-top: 0.4rem; }

    .btn-details {
        flex: 1; height: 44px; padding: 0 16px; border-radius: 50px;
        font-weight: 600; text-decoration: none;
        display: inline-flex; align-items: center; justify-content: center; gap: 7px;
        font-size: 0.8rem; cursor: pointer; transition: all 0.3s ease;
        background: linear-gradient(135deg, var(--bordeaux), var(--bordeaux-deep));
        color: white; border: none;
        box-shadow: 0 3px 12px rgba(125,46,62,0.28);
        letter-spacing: 0.3px; font-family: 'DM Sans', sans-serif;
    }
    .btn-details:hover {
        background: linear-gradient(135deg, #9f1c36, var(--bordeaux));
        transform: translateY(-2px); box-shadow: 0 8px 22px rgba(125,46,62,0.42); color: white;
    }

    .btn-programmes {
        flex: 1; height: 44px; padding: 0 16px; border-radius: 50px;
        font-weight: 600; text-decoration: none;
        display: inline-flex; align-items: center; justify-content: center; gap: 7px;
        font-size: 0.8rem; cursor: pointer; transition: all 0.3s ease;
        background: linear-gradient(135deg, var(--vert-sauge), var(--vert-deep));
        color: white; border: none;
        box-shadow: 0 3px 12px rgba(61,107,79,0.28);
        letter-spacing: 0.3px; font-family: 'DM Sans', sans-serif;
    }
    .btn-programmes:hover {
        background: linear-gradient(135deg, #2d5a3e, var(--vert-sauge));
        transform: translateY(-2px); box-shadow: 0 8px 22px rgba(61,107,79,0.42); color: white;
    }

    /* =============================================
       PAGINATION
       ============================================= */
    .pagination { display: flex; justify-content: center; gap: 0.5rem; margin-top: 2.5rem; margin-bottom: 2rem; flex-wrap: wrap; }
    .pagination a, .pagination span {
        display: flex; align-items: center; justify-content: center;
        min-width: 44px; height: 44px; padding: 0 12px;
        border-radius: 50%; background: var(--white); color: var(--bleu-nuit);
        text-decoration: none; font-weight: 600; font-size: 0.9rem;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        border: 1px solid rgba(27,58,75,0.08);
        font-family: 'DM Sans', sans-serif;
    }
    .pagination a:hover, .pagination .active {
        background: linear-gradient(135deg, var(--bleu-nuit), #275168);
        color: white; border-color: transparent; transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(27,58,75,0.3);
    }
    .pagination .disabled { opacity: 0.4; cursor: not-allowed; pointer-events: none; }
    .no-results { text-align: center; padding: 4rem; background: white; border-radius: 20px; border: 1px solid #F0E8DD; width: 100%; }
    .no-results i { font-size: 3rem; color: #E8DFD1; margin-bottom: 1rem; }

    /* =============================================
       NOTIFICATIONS
       ============================================= */
    .notif-wrapper { position: relative; }
    .notif-btn {
        position: relative;
        display: inline-flex; align-items: center; gap: 8px;
        background: white; padding: 9px 20px; border-radius: 50px;
        box-shadow: var(--shadow-sm); border: 1px solid rgba(193,120,23,0.15);
        cursor: pointer; font-family: 'DM Sans', sans-serif;
        font-size: 0.88rem; font-weight: 600; color: var(--dark);
        transition: all 0.3s ease;
    }
    .notif-btn i { color: var(--or-ambre); font-size: 1.05rem; }
    .notif-btn:hover { transform: scale(1.03); background: #FFF6EE; border-color: var(--or-ambre); box-shadow: 0 4px 16px rgba(193,120,23,0.2); }
    .notif-badge {
        position: absolute; top: -5px; right: -5px;
        background: linear-gradient(135deg, #E31B23, #c01018);
        color: white; font-size: 0.62rem; font-weight: 800;
        min-width: 20px; height: 20px; border-radius: 50%;
        display: none; align-items: center; justify-content: center;
        border: 2.5px solid white;
        box-shadow: 0 2px 8px rgba(227,27,35,0.5);
        animation: notifPop 0.5s cubic-bezier(0.34,1.56,0.64,1);
    }
    .notif-badge.visible { display: flex; }
    @keyframes notifPop { from { transform: scale(0) rotate(-15deg); } to { transform: scale(1) rotate(0); } }

    .notif-dropdown {
        position: absolute; top: calc(100% + 12px); right: 0;
        width: 390px; background: white;
        border-radius: 22px;
        box-shadow: 0 20px 60px rgba(27,58,75,0.18), 0 4px 16px rgba(0,0,0,0.08);
        border: 1px solid rgba(193,120,23,0.12);
        z-index: 9999; overflow: hidden;
        transform-origin: top right;
        transform: scale(0.92) translateY(-8px);
        opacity: 0; pointer-events: none;
        transition: all 0.25s cubic-bezier(0.16,1,0.3,1);
    }
    .notif-dropdown.open { transform: scale(1) translateY(0); opacity: 1; pointer-events: auto; }
    .notif-dropdown-header {
        display: flex; justify-content: space-between; align-items: center;
        padding: 1rem 1.2rem 0.8rem;
        border-bottom: 1px solid #F0E8DD;
        background: linear-gradient(135deg, #FEF9F0, white);
    }
    .notif-dropdown-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.15rem; font-weight: 700; color: var(--bordeaux);
        display: flex; align-items: center; gap: 8px;
    }
    .notif-dropdown-title i { font-size: 1rem; }
    .btn-read-all {
        background: none; border: 1.5px solid var(--or-ambre);
        color: var(--or-ambre); border-radius: 20px; padding: 3px 12px;
        font-size: 0.68rem; font-weight: 700; cursor: pointer;
        transition: all 0.2s; font-family: 'DM Sans', sans-serif;
        letter-spacing: 0.05em;
    }
    .btn-read-all:hover { background: var(--or-ambre); color: white; }
    .notif-scroll-area { max-height: 340px; overflow-y: auto; padding: 8px 0; }
    .notif-scroll-area::-webkit-scrollbar { width: 4px; }
    .notif-scroll-area::-webkit-scrollbar-track { background: transparent; }
    .notif-scroll-area::-webkit-scrollbar-thumb { background: #E8DFD1; border-radius: 2px; }
    .notif-item {
        display: flex; gap: 12px; padding: 12px 16px;
        margin: 4px 8px; border-radius: 14px;
        cursor: pointer; transition: all 0.2s;
        position: relative; background: transparent;
        border: 1px solid transparent;
    }
    .notif-item:hover { background: #FEF9F0; border-color: #F0E8DD; }
    .notif-item.unread { background: #FFF5F0; border-color: #FDDCCC; }
    .notif-item.unread::before {
        content: ''; position: absolute; left: 6px; top: 50%; transform: translateY(-50%);
        width: 6px; height: 6px; border-radius: 50%; background: var(--bordeaux);
    }
    .notif-item-icon { width: 38px; height: 38px; border-radius: 12px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 1rem; }
    .notif-item.type-reduction .notif-item-icon { background: rgba(16,185,129,0.12); color: #10B981; }
    .notif-item.type-nouveau_voyage .notif-item-icon { background: rgba(193,120,23,0.12); color: var(--or-ambre); }
    .notif-item-body { flex: 1; min-width: 0; }
    .notif-item-msg { font-size: 0.82rem; font-weight: 600; color: var(--dark); margin-bottom: 3px; line-height: 1.35; font-family: 'DM Sans', sans-serif; }
    .notif-item-sub { font-size: 0.72rem; color: var(--bordeaux); font-weight: 500; margin-bottom: 3px; }
    .notif-item-date { font-size: 0.68rem; color: #9CA3AF; display: flex; align-items: center; gap: 4px; }
    .notif-dropdown-footer { padding: 10px 16px; border-top: 1px solid #F0E8DD; text-align: center; background: #FAFAF8; }
    .notif-empty { text-align: center; padding: 2rem 1rem; color: #9CA3AF; }
    .notif-empty i { font-size: 2rem; margin-bottom: 0.5rem; display: block; color: #E8DFD1; }
    .notif-empty p { font-size: 0.82rem; }

    /* =============================================
       TOAST NOTIFICATIONS
       ============================================= */
    #toastContainer {
        position: fixed; bottom: 28px; right: 28px;
        z-index: 9999; display: flex; flex-direction: column;
        gap: 10px; align-items: flex-end;
    }
    .notif-toast {
        background: white; border-radius: 18px; padding: 0;
        box-shadow: 0 12px 40px rgba(0,0,0,0.15), 0 4px 12px rgba(0,0,0,0.06);
        display: flex; align-items: stretch; overflow: hidden;
        min-width: 310px; max-width: 380px;
        transform: translateX(120%) scale(0.9);
        opacity: 0;
        transition: all 0.4s cubic-bezier(0.16,1,0.3,1);
        pointer-events: none;
    }
    .notif-toast.show { transform: translateX(0) scale(1); opacity: 1; pointer-events: auto; }
    .notif-toast.hide { transform: translateX(120%) scale(0.9); opacity: 0; }
    .notif-toast-accent { width: 5px; flex-shrink: 0; }
    .notif-toast.type-reduction .notif-toast-accent { background: linear-gradient(180deg, #10B981, #059669); }
    .notif-toast.type-nouveau_voyage .notif-toast-accent { background: linear-gradient(180deg, var(--or-ambre), #9a5e12); }
    .notif-toast-inner { display: flex; align-items: center; gap: 12px; padding: 14px 14px 14px 16px; flex: 1; }
    .notif-toast-icon-wrap { width: 40px; height: 40px; border-radius: 12px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; }
    .notif-toast.type-reduction .notif-toast-icon-wrap { background: rgba(16,185,129,0.1); color: #10B981; }
    .notif-toast.type-nouveau_voyage .notif-toast-icon-wrap { background: rgba(193,120,23,0.1); color: var(--or-ambre); }
    .notif-toast-body { flex: 1; }
    .notif-toast-label { font-size: 0.65rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 3px; }
    .notif-toast.type-reduction .notif-toast-label { color: #10B981; }
    .notif-toast.type-nouveau_voyage .notif-toast-label { color: var(--or-ambre); }
    .notif-toast-title { font-size: 0.82rem; font-weight: 700; color: var(--dark); line-height: 1.3; margin-bottom: 2px; }
    .notif-toast-sub { font-size: 0.72rem; color: var(--gray-text); }
    .notif-toast-close { background: none; border: none; color: #C4B9B0; cursor: pointer; font-size: 0.9rem; padding: 4px; align-self: flex-start; margin-top: 2px; transition: color 0.2s; }
    .notif-toast-close:hover { color: var(--bordeaux); }
    .notif-toast-progress { position: absolute; bottom: 0; left: 5px; right: 0; height: 3px; background: rgba(0,0,0,0.06); border-radius: 0 0 18px 0; overflow: hidden; }
    .notif-toast-progress-bar { height: 100%; width: 100%; animation: toastProgress 5s linear forwards; }
    .notif-toast.type-reduction .notif-toast-progress-bar { background: linear-gradient(90deg, #10B981, #059669); }
    .notif-toast.type-nouveau_voyage .notif-toast-progress-bar { background: linear-gradient(90deg, var(--or-ambre), #9a5e12); }
    @keyframes toastProgress { from { width: 100%; } to { width: 0%; } }

    /* =============================================
       MOOD MODAL
       ============================================= */
    .mood-btn {
        display: inline-flex; align-items: center; gap: 8px;
        background: linear-gradient(135deg, var(--bordeaux), #a83050);
        color: white; border: none; padding: 9px 20px;
        border-radius: 50px; font-size: 0.88rem; font-weight: 600;
        cursor: pointer; font-family: 'DM Sans', sans-serif;
        box-shadow: 0 4px 16px rgba(125,46,62,0.32);
        transition: all 0.3s ease; letter-spacing: 0.2px;
    }
    .mood-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(125,46,62,0.45); }

    .mood-modal-overlay {
        position: fixed; inset: 0;
        background: rgba(10,8,20,0.70);
        z-index: 1070; display: none; align-items: center; justify-content: center;
        backdrop-filter: blur(8px);
        padding: 1rem;
    }
    .mood-modal-overlay.open { display: flex; }
    .mood-modal {
        background: #fff; border-radius: 32px;
        max-width: 580px; width: 100%; max-height: 92vh; overflow-y: auto;
        box-shadow: 0 40px 100px rgba(0,0,0,0.3), 0 0 0 1px rgba(193,120,23,0.15);
        animation: moodModalIn 0.45s cubic-bezier(0.16,1,0.3,1);
        position: relative; overflow: hidden;
    }
    @keyframes moodModalIn { from { opacity:0; transform: scale(0.88) translateY(30px); } to { opacity:1; transform: scale(1) translateY(0); } }
    .mood-modal-band { height: 6px; background: linear-gradient(90deg, var(--bordeaux) 0%, var(--or-ambre) 50%, var(--vert-sauge) 100%); border-radius: 32px 32px 0 0; }
    .mood-modal-inner { padding: 1.8rem 2rem 2rem; overflow-y: auto; max-height: calc(92vh - 6px); }
    .mood-modal-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.8rem; }
    .mood-modal-title-wrap {}
    .mood-modal-eyebrow { font-size: 0.65rem; font-weight: 800; letter-spacing: 0.15em; text-transform: uppercase; color: var(--or-ambre); display: flex; align-items: center; gap: 6px; margin-bottom: 6px; }
    .mood-modal-eyebrow::before, .mood-modal-eyebrow::after { content: ''; display: block; width: 20px; height: 1px; background: var(--or-ambre); }
    .mood-modal-title { font-family: 'Cormorant Garamond', serif; font-size: 2rem; font-weight: 700; color: var(--bordeaux); line-height: 1.15; }
    .mood-modal-subtitle { font-size: 0.8rem; color: var(--gray-text); margin-top: 6px; line-height: 1.5; font-family: 'DM Sans', sans-serif; }
    .close-mood { background: #F5F0EC; border: none; border-radius: 50%; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; cursor: pointer; color: #9CA3AF; font-size: 1rem; transition: all 0.2s; flex-shrink: 0; margin-top: 4px; }
    .close-mood:hover { background: #F0E0E5; color: var(--bordeaux); transform: rotate(90deg); }
    .mood-section { margin-bottom: 1.5rem; }
    .mood-section-label { font-size: 0.7rem; font-weight: 800; color: var(--bleu-nuit); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; font-family: 'DM Sans', sans-serif; }
    .mood-section-label::after { content: ''; flex: 1; height: 1px; background: #F0E8DD; }
    .mood-emojis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .mood-emoji-btn { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 12px 8px; border-radius: 16px; border: 2px solid #F0E8DD; background: var(--gray-soft); cursor: pointer; transition: all 0.25s cubic-bezier(0.34,1.56,0.64,1); font-family: 'DM Sans', sans-serif; font-size: 0.7rem; color: var(--gray-text); gap: 6px; position: relative; overflow: hidden; }
    .mood-emoji-btn::after { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(125,46,62,0.05), transparent); opacity: 0; transition: opacity 0.2s; }
    .mood-emoji-btn span.emoji { font-size: 1.8rem; line-height: 1; filter: grayscale(0.3); transition: filter 0.2s, transform 0.3s; }
    .mood-emoji-btn:hover { border-color: var(--bordeaux); background: #FFF5F7; transform: translateY(-2px); }
    .mood-emoji-btn:hover span.emoji { filter: grayscale(0); transform: scale(1.15); }
    .mood-emoji-btn.selected { border-color: var(--bordeaux); background: linear-gradient(135deg, #FFF0F3, #FEF5F7); color: var(--bordeaux); font-weight: 700; box-shadow: 0 4px 16px rgba(125,46,62,0.18); transform: translateY(-2px); }
    .mood-emoji-btn.selected::after { opacity: 1; }
    .mood-emoji-btn.selected span.emoji { filter: grayscale(0); transform: scale(1.1); }
    .mood-emoji-check { position: absolute; top: 6px; right: 6px; width: 16px; height: 16px; border-radius: 50%; background: var(--bordeaux); color: white; font-size: 0.5rem; display: none; align-items: center; justify-content: center; }
    .mood-emoji-btn.selected .mood-emoji-check { display: flex; }
    .pref-chips { display: flex; gap: 8px; flex-wrap: wrap; }
    .pref-chip { padding: 7px 14px; border-radius: 30px; border: 1.5px solid #E8DFD1; background: var(--gray-soft); font-size: 0.75rem; cursor: pointer; transition: all 0.2s cubic-bezier(0.34,1.56,0.64,1); font-family: 'DM Sans', sans-serif; color: var(--gray-text); font-weight: 500; display: flex; align-items: center; gap: 6px; }
    .pref-chip:hover { border-color: var(--or-ambre); color: var(--or-ambre); transform: translateY(-1px); }
    .pref-chip.selected { border-color: var(--or-ambre); background: rgba(193,120,23,0.1); color: #8a5310; font-weight: 700; box-shadow: 0 2px 10px rgba(193,120,23,0.2); transform: translateY(-1px); }
    .budget-track { position: relative; }
    .budget-display-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
    .budget-display { font-family: 'Cormorant Garamond', serif; font-size: 1.6rem; font-weight: 700; color: var(--bordeaux); line-height: 1; }
    .budget-display-sub { font-size: 0.7rem; color: var(--gray-text); font-weight: 500; font-family: 'DM Sans', sans-serif; }
    .budget-range-labels { display: flex; justify-content: space-between; font-size: 0.68rem; color: #B8AFA8; margin-top: 8px; font-family: 'DM Sans', sans-serif; }
    .budget-slider { width: 100%; -webkit-appearance: none; height: 6px; border-radius: 3px; background: #F0E8DD; outline: none; background-image: linear-gradient(var(--bordeaux), var(--bordeaux)); background-size: 20% 100%; background-repeat: no-repeat; }
    .budget-slider::-webkit-slider-thumb { -webkit-appearance: none; width: 24px; height: 24px; border-radius: 50%; background: white; cursor: pointer; border: 3px solid var(--bordeaux); box-shadow: 0 2px 10px rgba(125,46,62,0.3); transition: transform 0.15s; }
    .budget-slider::-webkit-slider-thumb:hover { transform: scale(1.15); }
    .budget-slider::-moz-range-thumb { width: 24px; height: 24px; border-radius: 50%; background: white; cursor: pointer; border: 3px solid var(--bordeaux); box-shadow: 0 2px 10px rgba(125,46,62,0.3); }
    .saison-btns { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .saison-btn { padding: 10px 8px; border-radius: 14px; border: 2px solid #F0E8DD; background: var(--gray-soft); font-size: 0.7rem; cursor: pointer; text-align: center; transition: all 0.25s cubic-bezier(0.34,1.56,0.64,1); font-family: 'DM Sans', sans-serif; color: var(--gray-text); font-weight: 500; }
    .saison-btn span { display: block; font-size: 1.4rem; margin-bottom: 4px; }
    .saison-btn:hover { border-color: var(--bleu-nuit); color: var(--bleu-nuit); transform: translateY(-2px); }
    .saison-btn.selected { border-color: var(--bleu-nuit); background: rgba(27,58,75,0.08); color: var(--bleu-nuit); font-weight: 700; box-shadow: 0 4px 14px rgba(27,58,75,0.15); transform: translateY(-2px); }
    .btn-recommend { width: 100%; padding: 16px; border-radius: 50px; border: none; background: linear-gradient(135deg, var(--bordeaux) 0%, #a0213c 50%, var(--or-ambre) 100%); background-size: 200% 100%; background-position: left center; color: white; font-size: 1rem; font-weight: 700; cursor: pointer; font-family: 'DM Sans', sans-serif; transition: all 0.4s ease; margin-top: 0.8rem; display: flex; align-items: center; justify-content: center; gap: 10px; box-shadow: 0 8px 24px rgba(125,46,62,0.35); letter-spacing: 0.03em; }
    .btn-recommend:hover { background-position: right center; transform: translateY(-2px); box-shadow: 0 12px 32px rgba(125,46,62,0.45); }
    .btn-recommend:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
    .recommend-result { display: none; margin-top: 1.5rem; border-radius: 20px; overflow: hidden; box-shadow: 0 8px 30px rgba(125,46,62,0.12); animation: resultFadeIn 0.5s ease; }
    @keyframes resultFadeIn { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }
    .recommend-result-header { background: linear-gradient(135deg, var(--bordeaux), #a0213c); padding: 1rem 1.3rem; display: flex; align-items: center; gap: 10px; }
    .recommend-result-header-icon { width: 36px; height: 36px; border-radius: 10px; background: rgba(255,255,255,0.15); display: flex; align-items: center; justify-content: center; color: white; font-size: 1rem; }
    .recommend-result-label { font-size: 0.65rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.7); margin-bottom: 2px; }
    .recommend-result-name { font-family: 'Cormorant Garamond', serif; font-size: 1.3rem; font-weight: 700; color: white; }
    .recommend-result-body { background: #FFF5F0; padding: 1.1rem 1.3rem; }
    .recommend-result-price { display: inline-flex; align-items: center; gap: 6px; background: rgba(193,120,23,0.12); color: #8a5310; border: 1px solid rgba(193,120,23,0.25); padding: 4px 12px; border-radius: 30px; font-size: 0.8rem; font-weight: 700; margin-bottom: 10px; }
    .recommend-result-raison { font-size: 0.84rem; color: var(--bleu-nuit); line-height: 1.65; margin-bottom: 14px; padding: 10px 14px; background: white; border-radius: 12px; border-left: 3px solid var(--bordeaux); font-family: 'DM Sans', sans-serif; }
    .btn-go-voyage { display: inline-flex; align-items: center; gap: 8px; background: var(--bordeaux); color: white; padding: 10px 22px; border-radius: 30px; text-decoration: none; font-size: 0.82rem; font-weight: 700; transition: all 0.2s; box-shadow: 0 4px 14px rgba(125,46,62,0.3); font-family: 'DM Sans', sans-serif; }
    .btn-go-voyage:hover { background: #9f1c36; color: white; transform: translateY(-2px); box-shadow: 0 6px 20px rgba(125,46,62,0.4); }

    /* =============================================
       VOICE CALL INTERFACE
       ============================================= */
    .call-trigger-btn {
        position: fixed; bottom: 28px; right: 28px;
        width: 64px; height: 64px; border-radius: 50%;
        background: linear-gradient(135deg, var(--bordeaux) 0%, #b5122a 100%);
        border: none; cursor: pointer;
        box-shadow: 0 6px 24px rgba(125,46,62,0.45), 0 0 0 0 rgba(125,46,62,0.25);
        transition: all 0.3s cubic-bezier(0.34,1.56,0.64,1);
        z-index: 1000; display: flex; align-items: center; justify-content: center;
        animation: floatBtn 3s ease-in-out infinite;
    }
    @keyframes floatBtn {
        0%,100% { transform: translateY(0); box-shadow: 0 6px 24px rgba(125,46,62,0.45), 0 0 0 0 rgba(125,46,62,0.25); }
        50%      { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(125,46,62,0.5), 0 0 0 8px rgba(125,46,62,0.08); }
    }
    .call-trigger-btn:hover { transform: scale(1.12) translateY(-2px); animation: none; box-shadow: 0 10px 32px rgba(125,46,62,0.55); }
    .call-trigger-btn i { font-size: 26px; color: white; }
    .call-trigger-tooltip { position: fixed; bottom: 100px; right: 28px; background: rgba(27,27,40,0.92); color: white; font-size: 0.75rem; padding: 6px 14px; border-radius: 20px; white-space: nowrap; opacity: 0; pointer-events: none; transition: opacity 0.2s; font-family: 'DM Sans', sans-serif; }
    .call-trigger-btn:hover + .call-trigger-tooltip { opacity: 1; }
    .call-overlay { position: fixed; inset: 0; background: linear-gradient(145deg, #FFF9F0 0%, #FEF5E8 30%, #FFF0E5 60%, #FEF9F0 100%); z-index: 2000; display: none; flex-direction: column; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.4s ease; }
    .call-overlay.visible { display: flex; }
    .call-overlay.active { opacity: 1; }
    .call-overlay::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(1px 1px at 20% 30%, rgba(193,120,23,0.15) 0%, transparent 100%), radial-gradient(1px 1px at 80% 20%, rgba(125,46,62,0.12) 0%, transparent 100%), radial-gradient(2px 2px at 35% 15%, rgba(193,120,23,0.08) 0%, transparent 100%), radial-gradient(2px 2px at 65% 85%, rgba(125,46,62,0.1) 0%, transparent 100%); pointer-events: none; }
    .call-content { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; width: 100%; max-width: 550px; padding: 2rem; background: rgba(255,255,255,0.85); backdrop-filter: blur(20px); border-radius: 48px; box-shadow: 0 30px 70px rgba(0,0,0,0.12), 0 0 0 1px rgba(193,120,23,0.12); margin: 1.5rem; }
    .agent-info { text-align: center; margin-bottom: 2rem; }
    .agent-name { font-family: 'Cormorant Garamond', serif; font-size: 1.8rem; font-weight: 700; color: var(--bordeaux); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 0.4rem; }
    .agent-status { font-size: 0.8rem; color: var(--or-ambre); letter-spacing: 2px; text-transform: uppercase; font-weight: 600; font-family: 'DM Sans', sans-serif; }
    .agent-status.speaking { color: #10B981; }
    .agent-status.listening { color: #3B82F6; }
    .agent-status.thinking { color: #F59E0B; }
    .orb-container { position: relative; width: 200px; height: 200px; display: flex; align-items: center; justify-content: center; margin-bottom: 2rem; }
    .orb-ring { position: absolute; border-radius: 50%; border: 1px solid; animation: orbRingPulse 3s ease-in-out infinite; opacity: 0; }
    .orb-ring:nth-child(1) { width: 200px; height: 200px; border-color: rgba(125,46,62,0.2); animation-delay: 0s; }
    .orb-ring:nth-child(2) { width: 220px; height: 220px; border-color: rgba(193,120,23,0.15); animation-delay: 0.4s; }
    .orb-ring:nth-child(3) { width: 240px; height: 240px; border-color: rgba(61,107,79,0.1); animation-delay: 0.8s; }
    @keyframes orbRingPulse { 0% { opacity:0; transform:scale(0.85); } 40% { opacity:1; } 100% { opacity:0; transform:scale(1.15); } }
    .orb-sphere { position: relative; width: 140px; height: 140px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, rgba(193,120,23,0.8) 0%, rgba(125,46,62,0.6) 40%, rgba(27,58,75,0.5) 70%, rgba(61,107,79,0.4) 100%); box-shadow: 0 0 40px rgba(125,46,62,0.3), 0 0 80px rgba(193,120,23,0.2), inset 0 0 20px rgba(255,255,255,0.3); transition: all 0.3s ease; overflow: hidden; z-index: 1; }
    .orb-canvas { width: 100%; height: 100%; border-radius: 50%; }
    .orb-sphere.idle { animation: orbIdle 4s ease-in-out infinite; }
    @keyframes orbIdle { 0%,100% { box-shadow: 0 0 40px rgba(125,46,62,0.3),0 0 80px rgba(193,120,23,0.2),inset 0 0 20px rgba(255,255,255,0.3); } 50% { box-shadow: 0 0 60px rgba(125,46,62,0.2),0 0 100px rgba(193,120,23,0.15),inset 0 0 25px rgba(255,255,255,0.4); } }
    .orb-sphere.listening { animation: orbListening 0.8s ease-in-out infinite alternate; background: radial-gradient(circle at 35% 35%, rgba(59,130,246,0.8) 0%, rgba(96,165,250,0.6) 40%, rgba(27,58,75,0.5) 70%, rgba(61,107,79,0.4) 100%); box-shadow: 0 0 50px rgba(59,130,246,0.4),0 0 90px rgba(96,165,250,0.3),inset 0 0 20px rgba(255,255,255,0.4); }
    @keyframes orbListening { from { transform:scale(1); } to { transform:scale(1.04); } }
    .orb-sphere.speaking { animation: orbSpeaking 0.3s ease-in-out infinite alternate; background: radial-gradient(circle at 35% 35%, rgba(16,185,129,0.8) 0%, rgba(34,197,94,0.6) 40%, rgba(27,58,75,0.5) 70%, rgba(61,107,79,0.4) 100%); box-shadow: 0 0 50px rgba(16,185,129,0.4),0 0 90px rgba(34,197,94,0.3),inset 0 0 20px rgba(255,255,255,0.4); }
    @keyframes orbSpeaking { from { transform:scale(1) rotate(0deg); } to { transform:scale(1.03) rotate(0.5deg); } }
    .orb-sphere.thinking { animation: orbThinking 1.5s ease-in-out infinite; background: radial-gradient(circle at 35% 35%, rgba(245,158,11,0.8) 0%, rgba(251,191,36,0.6) 40%, rgba(27,58,75,0.5) 70%, rgba(61,107,79,0.4) 100%); box-shadow: 0 0 50px rgba(245,158,11,0.4),0 0 90px rgba(251,191,36,0.3),inset 0 0 20px rgba(255,255,255,0.4); }
    @keyframes orbThinking { 0%,100% { transform:scale(1); } 50% { transform:scale(1.05); } }
    .call-transcript { width: 100%; min-height: 100px; max-height: 220px; overflow-y: auto; margin-bottom: 1.8rem; padding: 0 0.5rem; background: rgba(255,255,255,0.6); border-radius: 28px; }
    .transcript-line { font-size: 0.95rem; line-height: 1.5; color: var(--dark); font-weight: 400; transition: all 0.3s ease; margin-bottom: 0.6rem; padding: 0.5rem 1rem; border-radius: 20px; font-family: 'DM Sans', sans-serif; }
    .transcript-line.user-line { background: rgba(125,46,62,0.08); color: var(--bordeaux); font-weight: 500; text-align: right; }
    .transcript-line.bot-line { background: rgba(61,107,79,0.06); color: var(--bleu-nuit); text-align: left; }
    .typing-dots { display: inline-flex; gap: 5px; align-items: center; padding: 0.5rem 0; }
    .typing-dots span { width: 7px; height: 7px; background: var(--or-ambre); border-radius: 50%; animation: typingBounce 1.2s ease-in-out infinite; }
    .typing-dots span:nth-child(2) { animation-delay: 0.2s; }
