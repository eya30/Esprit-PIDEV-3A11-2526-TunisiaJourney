{% block javascripts %}
<script>
// ==================== PAGINATION ====================
let allItems = [];
let currentPage = 1;
const itemsPerPage = 6;
let currentSort = 'name_asc';
let currentSearch = '';

const grid = document.getElementById('voyagesGrid');
const searchInput = document.getElementById('searchInput');
const searchClearBtn = document.getElementById('searchClearBtn');
const sortToggleBtn = document.getElementById('sortToggleBtn');
const sortDropdownMenu = document.getElementById('sortDropdownMenu');
const sortLabel = document.getElementById('sortLabel');
const paginationContainer = document.getElementById('paginationContainer');

function initItems() { allItems = Array.from(document.querySelectorAll('.voyage-item')); applyFiltersAndSort(); }
function filterItems() { const term = currentSearch.toLowerCase(); if (!term) return allItems; return allItems.filter(item => (item.dataset.name?.toLowerCase() || '').includes(term)); }
function sortItems(items) {
    const sorted = [...items];
    switch(currentSort) {
        case 'name_asc':  sorted.sort((a,b) => (a.dataset.name||'').localeCompare(b.dataset.name||'')); break;
        case 'price_asc': sorted.sort((a,b) => (parseFloat(a.dataset.price)||0) - (parseFloat(b.dataset.price)||0)); break;
        case 'price_desc':sorted.sort((a,b) => (parseFloat(b.dataset.price)||0) - (parseFloat(a.dataset.price)||0)); break;
        case 'date_asc':  sorted.sort((a,b) => (a.dataset.date||'').localeCompare(b.dataset.date||'')); break;
    }
    return sorted;
}
function paginateItems(items) { const totalPages = Math.ceil(items.length / itemsPerPage); const start = (currentPage-1)*itemsPerPage; return { items: items.slice(start, start+itemsPerPage), totalPages }; }
function renderGrid() {
    const filtered = filterItems(); const sorted = sortItems(filtered); const { items: paginated, totalPages } = paginateItems(sorted);
    allItems.forEach(i => i.style.display = 'none');
    paginated.forEach(i => i.style.display = '');
    const existingMsg = document.getElementById('noResultMsg');
    if (paginated.length === 0 && filtered.length === 0 && currentSearch) {
        if (!existingMsg) { const d = document.createElement('div'); d.id = 'noResultMsg'; d.className = 'col-12'; d.innerHTML = `<div class="no-results"><i class="fas fa-search"></i><p>Aucun voyage ne correspond à "${currentSearch}"</p></div>`; grid.appendChild(d); }
    } else if (existingMsg) existingMsg.remove();
    renderPagination(totalPages);
}
function renderPagination(totalPages) {
    if (!paginationContainer) return;
    if (totalPages <= 1) { paginationContainer.innerHTML = ''; return; }
    let html = `<a href="#" class="pagination-prev ${currentPage===1?'disabled':''}" data-page="${currentPage-1}"><i class="fas fa-chevron-left"></i></a>`;
    let sp = Math.max(1,currentPage-2), ep = Math.min(totalPages,sp+4);
    if (sp>1) { html+=`<a href="#" data-page="1">1</a>`; if(sp>2) html+=`<span>...</span>`; }
    for(let i=sp;i<=ep;i++) html+=`<a href="#" data-page="${i}" class="${i===currentPage?'active':''}">${i}</a>`;
    if(ep<totalPages) { if(ep<totalPages-1) html+=`<span>...</span>`; html+=`<a href="#" data-page="${totalPages}">${totalPages}</a>`; }
    html+=`<a href="#" class="pagination-next ${currentPage===totalPages?'disabled':''}" data-page="${currentPage+1}"><i class="fas fa-chevron-right"></i></a>`;
    paginationContainer.innerHTML = html;
    paginationContainer.querySelectorAll('a[data-page]').forEach(link => {
        link.addEventListener('click', function(e) {
            e.preventDefault(); const page = parseInt(this.dataset.page);
            if (page && !this.classList.contains('disabled') && page>=1 && page<=totalPages) { currentPage = page; renderGrid(); document.getElementById('voyagesGrid').scrollIntoView({behavior:'smooth',block:'start'}); }
        });
    });
}
function applyFiltersAndSort() { currentPage = 1; renderGrid(); }
let searchTimeout;
searchInput.addEventListener('input', function() { currentSearch=this.value.trim(); searchClearBtn.classList.toggle('visible',currentSearch.length>0); clearTimeout(searchTimeout); searchTimeout=setTimeout(applyFiltersAndSort,300); });
searchClearBtn.addEventListener('click', function() { searchInput.value=''; currentSearch=''; searchClearBtn.classList.remove('visible'); applyFiltersAndSort(); searchInput.focus(); });
sortToggleBtn.addEventListener('click', function(e) { e.stopPropagation(); sortDropdownMenu.classList.toggle('open'); sortToggleBtn.classList.toggle('open'); });
document.addEventListener('click', function(e) {
    if (!sortToggleBtn.contains(e.target)) { sortDropdownMenu.classList.remove('open'); sortToggleBtn.classList.remove('open'); }
});
document.querySelectorAll('.sort-option').forEach(opt => {
    opt.addEventListener('click', function(e) { e.stopPropagation(); document.querySelectorAll('.sort-option').forEach(o=>o.classList.remove('active')); opt.classList.add('active'); currentSort=opt.dataset.value; sortLabel.textContent=opt.textContent.trim(); sortDropdownMenu.classList.remove('open'); sortToggleBtn.classList.remove('open'); applyFiltersAndSort(); });
});
initItems();

// ==================== WISHLIST ====================
let wishlist = JSON.parse(localStorage.getItem('wishlist')) || [];
function saveWishlist() { localStorage.setItem('wishlist', JSON.stringify(wishlist)); updateWishlistUI(); updateWishlistSidebar(); }
function updateWishlistCount() { const c = document.getElementById('wishlistCount'); if(c) c.textContent = wishlist.length; }
function updateWishlistUI() {
    document.querySelectorAll('.wishlist-star').forEach(star => {
        const id = parseInt(star.dataset.id); const icon = star.querySelector('i');
        if(wishlist.includes(id)) { icon.className='fas fa-star'; star.classList.add('active'); } else { icon.className='far fa-star'; star.classList.remove('active'); }
    }); updateWishlistCount();
}
function updateWishlistSidebar() {
    const container = document.getElementById('wishlistList'); if(!container) return;
    if(wishlist.length===0) { container.innerHTML=`<div class="empty-wishlist"><i class="fas fa-heart fa-3x mb-2"></i><p>Votre wishlist est vide</p><p class="small">Ajoutez vos voyages préférés avec l'étoile ⭐</p></div>`; return; }
    let html='';
    wishlist.forEach(id => {
        const el = document.querySelector(`.voyage-item[data-id="${id}"]`);
        if(el) { const name=el.querySelector('.card-title')?.textContent||''; const price=el.querySelector('.card-price')?.textContent||''; const image=el.dataset.image||'';
            html+=`<div class="wishlist-item" data-id="${id}"><img src="${image}" class="wishlist-item-img" alt="${name}"><div class="wishlist-item-info"><div class="wishlist-item-title">${name}</div><div class="wishlist-item-price">${price}</div></div><button class="wishlist-item-remove" onclick="removeFromWishlist(${id})"><i class="fas fa-times-circle"></i></button></div>`; }
    }); container.innerHTML=html;
}
function toggleWishlist(id) { const i=wishlist.indexOf(id); if(i===-1)wishlist.push(id); else wishlist.splice(i,1); saveWishlist(); }
function removeFromWishlist(id) { const i=wishlist.indexOf(id); if(i!==-1){wishlist.splice(i,1); saveWishlist(); updateWishlistUI();} }
document.querySelectorAll('.wishlist-star').forEach(star => { star.addEventListener('click', function(e) { e.stopPropagation(); toggleWishlist(parseInt(this.dataset.id)); }); });
updateWishlistUI(); updateWishlistSidebar();
const wishlistIcon=document.getElementById('wishlistIcon'), wishlistSidebar=document.getElementById('wishlistSidebar'), wishlistOverlay=document.getElementById('wishlistOverlay'), closeWishlistBtn=document.getElementById('closeWishlistBtn');
function openWishlist() { wishlistSidebar.classList.add('open'); wishlistOverlay.classList.add('active'); updateWishlistSidebar(); }
function closeWishlist() { wishlistSidebar.classList.remove('open'); wishlistOverlay.classList.remove('active'); }
wishlistIcon.addEventListener('click', openWishlist);
closeWishlistBtn.addEventListener('click', closeWishlist);
wishlistOverlay.addEventListener('click', closeWishlist);

// ==================== NOTIFICATIONS ====================
const notifBtn       = document.getElementById('notifBtn');
const notifDropdown  = document.getElementById('notifDropdown');
const notifBadge     = document.getElementById('notifBadge');
const notifList      = document.getElementById('notifList');
const btnReadAll     = document.getElementById('btnReadAll');
const toastContainer = document.getElementById('toastContainer');
const notifWrapper   = document.getElementById('notifWrapper');

let shownNotifIds = JSON.parse(sessionStorage.getItem('shownNotifIds') || '[]');

function timeAgo(dateStr) {
    const diff = Math.floor((Date.now() - new Date(dateStr).getTime()) / 1000);
    if (diff < 60)    return 'À l\'instant';
    if (diff < 3600)  return `Il y a ${Math.floor(diff/60)} min`;
    if (diff < 86400) return `Il y a ${Math.floor(diff/3600)} h`;
    return `Il y a ${Math.floor(diff/86400)} j`;
}

function renderNotifList(notifications) {
    if (!notifications.length) {
        notifList.innerHTML = `<div class="notif-empty"><i class="fas fa-bell-slash"></i><p>Tout est à jour !</p></div>`;
        return;
    }
    const icons = { reduction: 'fa-tags', nouveau_voyage: 'fa-plane-departure' };
    notifList.innerHTML = notifications.map(n => `
        <div class="notif-item type-${n.type} ${n.lu == 0 ? 'unread' : ''}" data-id="${n.id}" onclick="markNotifRead(${n.id}, this)">
            <div class="notif-item-icon">
                <i class="fas ${icons[n.type] || 'fa-bell'}"></i>
            </div>
            <div class="notif-item-body">
                <div class="notif-item-msg">${n.message}</div>
                ${n.voyage_nom ? `<div class="notif-item-sub"><i class="fas fa-map-marker-alt"></i> ${n.voyage_nom}</div>` : ''}
                <div class="notif-item-date"><i class="far fa-clock"></i> ${timeAgo(n.date_creation)}</div>
            </div>
        </div>
    `).join('');
}

function showToast(notif) {
    const icons = { reduction: 'fa-tags', nouveau_voyage: 'fa-plane-departure' };
    const labels = { reduction: 'Réduction prix', nouveau_voyage: 'Nouveau voyage' };
    const toast = document.createElement('div');
    toast.className = `notif-toast type-${notif.type}`;
    toast.style.position = 'relative';
    toast.innerHTML = `
        <div class="notif-toast-accent"></div>
        <div class="notif-toast-inner">
            <div class="notif-toast-icon-wrap">
                <i class="fas ${icons[notif.type] || 'fa-bell'}"></i>
            </div>
            <div class="notif-toast-body">
                <div class="notif-toast-label">${labels[notif.type] || 'Notification'}</div>
                <div class="notif-toast-title">${notif.message}</div>
                ${notif.voyage_nom ? `<div class="notif-toast-sub"><i class="fas fa-map-marker-alt"></i> ${notif.voyage_nom}</div>` : ''}
            </div>
            <button class="notif-toast-close" onclick="dismissToast(this.closest('.notif-toast'))"><i class="fas fa-times"></i></button>
        </div>
        <div class="notif-toast-progress"><div class="notif-toast-progress-bar"></div></div>
    `;
    toastContainer.appendChild(toast);
    requestAnimationFrame(() => { requestAnimationFrame(() => { toast.classList.add('show'); }); });
    setTimeout(() => dismissToast(toast), 5500);
}

function dismissToast(toast) {
    if (!toast || toast.classList.contains('hide')) return;
    toast.classList.add('hide');
    toast.classList.remove('show');
    setTimeout(() => toast.remove(), 500);
}

async function fetchNotifications() {
    try {
