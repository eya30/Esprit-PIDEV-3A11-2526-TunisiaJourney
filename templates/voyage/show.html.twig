{% extends 'base.html.twig' %}

{% block title %}{{ voyage.nom }} - TunisiaJourney{% endblock %}

{% block stylesheets %}
<style>
    .back-arrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--tunisia-red);
        text-decoration: none;
        font-weight: 500;
        margin-bottom: 2rem;
        transition: all 0.3s ease;
    }
    
    .back-arrow:hover {
        transform: translateX(-5px);
        color: var(--tunisia-orange);
    }
    
    .voyage-container {
        display: flex;
        gap: 2rem;
        background: white;
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid #F0E8DD;
    }
    
    .voyage-image {
        flex: 1;
        min-width: 0;
    }
    
    .voyage-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    
    .voyage-info {
        flex: 1;
        padding: 2rem;
    }
    
    .voyage-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 2rem;
        font-weight: 700;
        color: var(--tunisia-red);
        margin-bottom: 1rem;
    }
    
    .voyage-price {
        font-size: 1.8rem;
        font-weight: 800;
        color: var(--tunisia-red);
        margin: 1rem 0;
    }
    
    .voyage-price small {
        font-size: 0.9rem;
        font-weight: 400;
        color: #6c757d;
    }
    
    .voyage-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        margin: 1.5rem 0;
        padding: 1rem 0;
        border-top: 1px solid #F0E8DD;
        border-bottom: 1px solid #F0E8DD;
    }
    
    .meta-item {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #6c757d;
        font-size: 0.9rem;
    }
    
    .meta-item i {
        color: var(--tunisia-red);
        width: 20px;
    }
    
    .voyage-description {
        color: #4A3B2F;
        line-height: 1.8;
        margin: 1.5rem 0;
    }
    
    .programmes-section {
        margin-top: 2rem;
    }
    
    .programmes-section h3 {
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 1rem;
        color: var(--dark-gray);
    }
    
    .programme-item {
        padding: 0.8rem;
        margin-bottom: 0.8rem;
        background: #FEF9F0;
        border-radius: 12px;
        transition: all 0.2s;
    }
    
    .programme-item:hover {
        background: #FFF5F0;
        transform: translateX(5px);
    }
    
    .programme-name {
        font-weight: 700;
        color: var(--tunisia-red);
        margin-bottom: 0.3rem;
    }
    
    .programme-date {
        font-size: 0.75rem;
        color: #9CA3AF;
    }
    
    .btn-programmes {
        display: inline-block;
        background: transparent;
        border: 2px solid var(--tunisia-red);
        color: var(--tunisia-red);
        padding: 8px 25px;
        border-radius: 30px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        margin-top: 1rem;
        font-size: 0.85rem;
    }
    
    .btn-programmes:hover {
        background: var(--tunisia-red);
        color: white;
        transform: translateY(-2px);
    }
    
    @media (max-width: 768px) {
        .voyage-container {
            flex-direction: column;
        }
        
        .voyage-image {
            height: 300px;
        }
        
        .voyage-info {
            padding: 1.5rem;
        }
        
        .voyage-title {
            font-size: 1.5rem;
        }
        
        .voyage-price {
            font-size: 1.3rem;
        }
        
        .voyage-meta {
            gap: 1rem;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="container py-5">
    <!-- Flèche de retour -->
    <a href="{{ path('app_voyage_index') }}" class="back-arrow">
        <i class="fas fa-arrow-left"></i> Retour
    </a>
    
    <div class="voyage-container">
        <!-- Image à gauche -->
        <div class="voyage-image">
            {% if voyage.image %}
                <img src="{{ asset('uploads/voyages/' ~ voyage.image) }}" alt="{{ voyage.nom }}">
            {% else %}
                <img src="https://images.pexels.com/photos/1618750/pexels-photo-1618750.jpeg?auto=compress&cs=tinysrgb&w=800" alt="{{ voyage.nom }}">
            {% endif %}
        </div>
        
        <!-- Détails à droite -->
        <div class="voyage-info">
            <h1 class="voyage-title">{{ voyage.nom }}</h1>
            
            <div class="voyage-price">
                {{ voyage.prix|number_format(0, ',', ' ') }} <small>DT / personne</small>
            </div>
            
            <div class="voyage-meta">
                <div class="meta-item">
                    <i class="fas fa-users"></i>
                    <span>{{ voyage.capacite }} personnes max</span>
                </div>
                <div class="meta-item">
                    <i class="fas fa-clock"></i>
                    <span>Départ à {{ voyage.heure|date('H:i') }}</span>
                </div>
                <div class="meta-item">
                    <i class="fas fa-calendar"></i>
                    <span>Créé le {{ voyage.dateCreation|date('d/m/Y') }}</span>
                </div>
            </div>
            
            <div class="voyage-description">
                {{ voyage.description }}
            </div>
            
            <div class="programmes-section">
                <h3>Programmes disponibles</h3>
                {% if programmes is defined and programmes|length > 0 %}
                    {% for programme in programmes|slice(0, 3) %}
                        <div class="programme-item">
                            <div class="programme-name">{{ programme.nom }}</div>
                            <div class="programme-date">
                                <i class="far fa-calendar-alt"></i> {{ programme.dateDebut|date('d/m/Y') }} - {{ programme.dateFin|date('d/m/Y') }}
                            </div>
                        </div>
                    {% endfor %}
                    
                    {% if programmes|length > 3 %}
                        <div class="text-center">
                            <a href="{{ path('app_voyage_programmes', {'idV': voyage.idV}) }}" class="btn-programmes">
                                Voir tous les programmes ({{ programmes|length }})
                            </a>
                        </div>
                    {% endif %}
                {% else %}
                    <p class="text-muted">Aucun programme disponible pour ce voyage.</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}