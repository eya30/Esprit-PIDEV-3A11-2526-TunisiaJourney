{% extends 'base.html.twig' %}

{% block title %}Programmes - {{ voyage.nom }}{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --tunisia-red: #E31B23;
        --tunisia-blue: #0054A6;
        --tunisia-blue-light: #E8F0FE;
        --tunisia-sand: #FDF5E6;
        --dark-gray: #2C3E50;
    }

    .back-arrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--tunisia-red);
        text-decoration: none;
        font-weight: 500;
        margin-bottom: 1.5rem;
        transition: all 0.3s ease;
    }
    
    .back-arrow:hover {
        transform: translateX(-5px);
        color: var(--tunisia-orange);
    }

    .page-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 2rem;
        font-weight: 700;
        color: var(--tunisia-red);
        margin-bottom: 2rem;
    }

    .programme-card {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        transition: all 0.4s ease;
        margin-bottom: 30px;
    }

    .programme-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(227,27,35,0.2);
    }

    .programme-img {
        height: 250px;
        overflow: hidden;
    }

    .programme-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .programme-card:hover .programme-img img {
        transform: scale(1.05);
    }

    .programme-content {
        padding: 1.5rem;
    }

    .programme-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--tunisia-blue);
        margin-bottom: 0.5rem;
    }

    .programme-info {
        display: flex;
        gap: 1rem;
        margin-bottom: 1rem;
        font-size: 0.85rem;
        color: #6c757d;
        flex-wrap: wrap;
    }

    .programme-info i {
        color: var(--tunisia-red);
        margin-right: 5px;
    }

    .programme-desc {
        color: #6c757d;
        line-height: 1.6;
        margin-bottom: 1rem;
        font-size: 0.9rem;
    }

    .programme-dates {
        font-size: 0.8rem;
        color: #9CA3AF;
        margin-bottom: 1rem;
    }

    .btn-group {
        display: flex;
        gap: 10px;
        margin-top: 1rem;
    }

    .btn-details {
        flex: 1;
        background: transparent;
        border: 2px solid var(--tunisia-red);
        color: var(--tunisia-red);
        padding: 8px 0;
        border-radius: 25px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        text-align: center;
        transition: all 0.3s ease;
        font-size: 0.85rem;
    }

    .btn-details:hover {
        background: var(--tunisia-red);
        color: white;
    }

    .btn-reserve {
        flex: 1;
        background: var(--tunisia-blue);
        color: white;
        border: none;
        padding: 8px 0;
        border-radius: 25px;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.3s ease;
        text-align: center;
    }

    .btn-reserve:hover {
        background: #00408a;
        transform: translateY(-2px);
    }

    /* Modal Styles */
    .modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }
    
    .modal.active {
        display: flex;
    }
    
    .modal-content {
        background: white;
        border-radius: 20px;
        padding: 2rem;
        max-width: 480px;
        width: 90%;
        max-height: 90vh;
        overflow-y: auto;
    }
    
    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #E8DFD1;
    }
    
    .modal-header h3 {
        font-size: 1.3rem;
        font-weight: 600;
        color: var(--tunisia-blue);
        margin: 0;
    }
    
    .close-modal {
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        color: #9CA3AF;
    }
    
    .close-modal:hover {
        color: var(--tunisia-red);
    }
    
    .form-group {
        margin-bottom: 1rem;
    }
    
    .form-group label {
        display: block;
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--dark-gray);
        margin-bottom: 0.3rem;
    }
    
    .form-group input {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #E8DFD1;
        border-radius: 10px;
        font-size: 0.9rem;
        transition: all 0.2s;
    }
    
    .form-group input:focus {
        outline: none;
        border-color: var(--tunisia-blue);
    }
    
    .form-group input.error {
        border-color: #EF4444;
        background: #FEF2F2;
    }
    
    .error-message {
        color: #EF4444;
        font-size: 0.7rem;
        margin-top: 0.2rem;
        display: none;
    }
    
    .error-message.show {
        display: block;
    }
    
    .btn-submit {
        width: 100%;
        background: var(--tunisia-blue);
        color: white;
        border: none;
        padding: 12px;
        border-radius: 30px;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 0.5rem;
    }
    
    .btn-submit:hover {
        background: #00408a;
    }
    
    .btn-submit:disabled {
        background: #9CA3AF;
        cursor: not-allowed;
    }
    
    /* Toast de confirmation */
    .success-toast {
        position: fixed;
        top: 100px;
        right: 20px;
        background: #10B981;
        color: white;
        padding: 12px 20px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        z-index: 1100;
        animation: slideInRight 0.3s ease, fadeOut 0.3s ease 3.7s forwards;
        font-size: 0.9rem;
    }
    
    .error-toast {
        position: fixed;
        top: 100px;
        right: 20px;
        background: #EF4444;
        color: white;
        padding: 12px 20px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        z-index: 1100;
        animation: slideInRight 0.3s ease, fadeOut 0.3s ease 3.7s forwards;
        font-size: 0.9rem;
    }
    
    @keyframes slideInRight {
        from { transform: translateX(100%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
    }
    
    @keyframes fadeOut {
        to { opacity: 0; visibility: hidden; }
    }
    
    .success-toast i, .error-toast i {
        font-size: 1.2rem;
    }

    .empty-state {
        text-align: center;
        padding: 4rem;
        background: white;
        border-radius: 20px;
    }

    @media (max-width: 768px) {
        .page-title { font-size: 1.5rem; }
        .programme-img { height: 200px; }
        .btn-group { flex-direction: column; gap: 8px; }
        .modal-content { padding: 1.5rem; }
    }
</style>
{% endblock %}

{% block body %}
<div class="container py-5">
    <a href="{{ path('app_voyage_index') }}" class="back-arrow">
        <i class="fas fa-arrow-left"></i> Retour aux voyages
    </a>
    
    <h1 class="page-title">{{ voyage.nom }}</h1>

    <div class="row">
        {% for programme in programmes %}
            <div class="col-md-6 col-lg-4">
                <div class="programme-card">
                    <div class="programme-img">
                        {% if programme.image and programme.image != 'NULL' %}
                            <img src="{{ asset('uploads/programmes/' ~ programme.image|replace({' ': '%20'})) }}" alt="{{ programme.nom }}">
                        {% else %}
                            <img src="https://images.pexels.com/photos/1618750/pexels-photo-1618750.jpeg?auto=compress&cs=tinysrgb&w=800" alt="{{ programme.nom }}">
                        {% endif %}
                    </div>
                    <div class="programme-content">
                        <h3 class="programme-title">{{ programme.nom }}</h3>
                        <div class="programme-info">
                            <span><i class="fas fa-map-marker-alt"></i> {{ programme.lieu }}</span>
                            <span><i class="fas fa-hotel"></i> {{ programme.hotel }}</span>
                        </div>
                        <p class="programme-desc">{{ programme.description|slice(0, 100) }}...</p>
                        <div class="programme-dates">
                            <i class="far fa-calendar-alt"></i> {{ programme.dateDebut|date('d/m/Y') }} - {{ programme.dateFin|date('d/m/Y') }}
                        </div>
                        <div class="btn-group">
                            <a href="{{ path('app_programme_show', {'idProg': programme.idProg}) }}" class="btn-details">
                                Détails
                            </a>
                            <button class="btn-reserve" onclick="openReservationModal('{{ programme.idProg }}', '{{ programme.nom }}')">
                                Réserver
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="empty-state">
                    <i class="fas fa-calendar-alt"></i>
                    <h3>Aucun programme disponible</h3>
                    <p>Aucun programme n'est proposé pour ce voyage pour le moment.</p>
                </div>
            </div>
        {% endfor %}
    </div>
</div>

<!-- Modal de réservation -->
<div id="reservationModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Réserver un programme</h3>
            <button class="close-modal" onclick="closeReservationModal()">&times;</button>
        </div>

        {% if errors is defined and errors|length > 0 %}
            <div class="error-messages">
                <ul>
                    {% for message in errors %}
                        <li>{{ message }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {% for message in app.flashes('success') %}
            <div class="success-messages">
                <ul><li>{{ message }}</li></ul>
            </div>
        {% endfor %}

        <form id="reservationForm" method="post">
            <input type="hidden" name="source" value="voyage_programmes">
            <input type="hidden" name="voyageId" value="{{ voyage.idV }}">
            <input type="hidden" name="idProg" id="programmeId">
            <div class="form-group">
                <label>Nom *</label>
                <input type="text" name="nom" id="nom" placeholder="Votre nom" value="{{ formData.nom|default('') }}">
            </div>
            <div class="form-group">
                <label>Prénom *</label>
                <input type="text" name="prenom" id="prenom" placeholder="Votre prénom" value="{{ formData.prenom|default('') }}">
            </div>
            <div class="form-group">
                <label>Téléphone *</label>
                <input type="text" name="telephone" id="telephone" placeholder="Ex: 12345678" value="{{ formData.telephone|default('') }}">
            </div>
            <div class="form-group">
                <label>Email *</label>
                <input type="text" name="email" id="email" placeholder="exemple@email.com" value="{{ formData.email|default('') }}">
            </div>
            <div class="form-group">
                <label>Nombre de personnes *</label>
                <input type="text" name="nbre" id="nbre" value="{{ formData.nbre|default('1') }}" placeholder="Ex: 2">
            </div>
            <button type="submit" class="btn-submit" id="submitBtn">
                Confirmer la réservation
            </button>
        </form>
    </div>
</div>

<script>
    function openReservationModal(programmeId) {
        const modal = document.getElementById('reservationModal');
        const form = document.getElementById('reservationForm');
        const routeUrl = "{{ path('app_reservation_new', {'idProg': 'PROGRAMME_ID'}) }}";
        form.action = routeUrl.replace('PROGRAMME_ID', programmeId);
        document.getElementById('programmeId').value = programmeId;
        modal.classList.add('active');
    }

    function closeReservationModal() {
        const modal = document.getElementById('reservationModal');
        modal.classList.remove('active');
    }

    {% if errors is defined and errors|length > 0 %}
        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('reservationModal').classList.add('active');
        });
    {% endif %}
</script>
{% endblock %}