{% extends 'base.html.twig' %}

{% block title %}Programmes - {{ voyage.nom }}{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --tunisia-red: #E31B23;
        --tunisia-blue: #0054A6;
        --tunisia-blue-light: #E8F0FE;
        --tunisia-sand: #FDF5E6;
        --dark-gray: #2C3E50;
    }

    .back-arrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--tunisia-red);
        text-decoration: none;
        font-weight: 500;
        margin-bottom: 2rem;
        transition: all 0.3s ease;
    }
    
    .back-arrow:hover {
        transform: translateX(-5px);
        color: var(--tunisia-orange);
    }

    .page-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 2rem;
        font-weight: 700;
        color: var(--tunisia-red);
        margin-bottom: 2rem;
        border-left: 4px solid var(--tunisia-red);
        padding-left: 1rem;
    }

    /* Grille égale */
    .programmes-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 30px;
    }

    .programme-card {
        background: white;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        transition: all 0.4s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        display: flex;
        flex-direction: column;
        height: 100%;
        position: relative;
    }

    .programme-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(227,27,35,0.15);
    }

    /* Badge "Nouveau" ou "Promo" */
    .programme-badge {
        position: absolute;
        top: 15px;
        right: 15px;
        background: linear-gradient(135deg, #E31B23, #FF6B35);
        color: white;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 600;
        z-index: 2;
        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }

    .programme-img {
        height: 310px;
        overflow: hidden;
        position: relative;
    }

    .programme-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .programme-card:hover .programme-img img {
        transform: scale(1.05);
    }

    .programme-content {
        padding: 1.5rem;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .programme-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--tunisia-red);
        margin-bottom: 0.5rem;
        line-height: 1.4;
        min-height: 55px;
    }

    .programme-info {
        display: flex;
        gap: 1rem;
        margin-bottom: 0.8rem;
        font-size: 0.8rem;
        color: #6c757d;
        flex-wrap: wrap;
    }

    .programme-info i {
        color: var(--tunisia-red);
        margin-right: 5px;
        width: 14px;
    }

    .programme-desc {
        color: #6c757d;
        line-height: 1.5;
        margin-bottom: 1rem;
        font-size: 0.85rem;
        flex: 1;
    }

    .programme-dates {
        background: #FEF9F0;
        padding: 8px 12px;
        border-radius: 12px;
        font-size: 0.75rem;
        color: #93032E;
        margin-bottom: 1rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        width: fit-content;
    }

    .programme-dates i {
        color: var(--tunisia-red);
    }

    .btn-group {
        display: flex;
        gap: 10px;
        margin-top: 0.5rem;
    }

    .btn-details {
        flex: 1;
        background: transparent;
        border: 1.5px solid var(--tunisia-red);
        color: var(--tunisia-red);
        padding: 8px 0;
        border-radius: 30px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        text-align: center;
        transition: all 0.3s ease;
        font-size: 0.8rem;
    }

    .btn-details:hover {
        background: var(--tunisia-red);
        color: white;
        transform: translateY(-2px);
    }

    .btn-reserve {
        flex: 1;
        background: linear-gradient(135deg, var(--tunisia-blue), #00408a);
        color: white;
        border: none;
        padding: 8px 0;
        border-radius: 30px;
        font-weight: 600;
        font-size: 0.8rem;
        cursor: pointer;
        transition: all 0.3s ease;
        text-align: center;
    }

    .btn-reserve:hover {
        background: linear-gradient(135deg, #00408a, var(--tunisia-blue));
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(0,84,166,0.3);
    }

    /* Modal Styles */
    .modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }
    
    .modal.active {
        display: flex;
    }
    
    .modal-content {
        background: white;
        border-radius: 24px;
        padding: 2rem;
        max-width: 500px;
        width: 90%;
        max-height: 90vh;
        overflow-y: auto;
    }
    
    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #F0E8DD;
    }
    
    .modal-header h3 {
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--tunisia-red);
        margin: 0;
        font-family: 'Cormorant Garamond', serif;
    }
    
    .close-modal {
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        color: #9CA3AF;
        transition: all 0.2s;
    }
    
    .close-modal:hover {
        color: var(--tunisia-red);
        transform: rotate(90deg);
    }
    
    .form-group {
        margin-bottom: 1.2rem;
    }
    
    .form-group label {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--dark-gray);
        margin-bottom: 0.3rem;
    }
    
    .form-group label .required {
        color: #E31B23;
        margin-left: 3px;
    }
    
    .form-group input {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid #E8DFD1;
        border-radius: 12px;
        font-size: 0.9rem;
        transition: all 0.2s;
        background: #FEF9F0;
    }
    
    .form-group input:focus {
        outline: none;
        border-color: var(--tunisia-blue);
        background: white;
        box-shadow: 0 0 0 3px rgba(0,84,166,0.1);
    }
    
    .form-group input.error {
        border-color: #EF4444;
        background: #FEF2F2;
    }
    
    .error-message {
        color: #EF4444;
        font-size: 0.7rem;
        margin-top: 0.3rem;
        display: none;
    }
    
    .error-message.show {
        display: block;
    }
    
    .error-messages {
        background: #FEF2F2;
        border-left: 4px solid #EF4444;
        padding: 12px 16px;
        margin-bottom: 1rem;
        border-radius: 12px;
    }
    
    .error-messages ul {
        margin: 0;
        padding-left: 1.2rem;
        color: #EF4444;
        font-size: 0.85rem;
    }
    
    .success-messages {
        background: #E0F2E9;
        border-left: 4px solid #10B981;
        padding: 12px 16px;
        margin-bottom: 1rem;
        border-radius: 12px;
    }
    
    .success-messages ul {
        margin: 0;
        padding-left: 1.2rem;
        color: #047857;
        font-size: 0.85rem;
    }
    
    .btn-submit {
        width: 100%;
        background: linear-gradient(135deg, var(--tunisia-blue), #00408a);
        color: white;
        border: none;
        padding: 12px;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 0.5rem;
    }
    
    .btn-submit:hover {
        background: linear-gradient(135deg, #00408a, var(--tunisia-blue));
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(0,84,166,0.3);
    }
    
    .btn-submit:disabled {
        background: #9CA3AF;
        cursor: not-allowed;
        transform: none;
    }
    
    /* Toast */
    .success-toast {
        position: fixed;
        top: 100px;
        right: 20px;
        background: #10B981;
        color: white;
        padding: 12px 20px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        z-index: 1100;
        animation: slideInRight 0.3s ease, fadeOut 0.3s ease 3.7s forwards;
        font-size: 0.9rem;
    }
    
    .error-toast {
        position: fixed;
        top: 100px;
        right: 20px;
        background: #EF4444;
        color: white;
        padding: 12px 20px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        z-index: 1100;
        animation: slideInRight 0.3s ease, fadeOut 0.3s ease 3.7s forwards;
        font-size: 0.9rem;
    }
    
    @keyframes slideInRight {
        from { transform: translateX(100%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
    }
    
    @keyframes fadeOut {
        to { opacity: 0; visibility: hidden; }
    }
    
    .success-toast i, .error-toast i {
        font-size: 1.2rem;
    }

    .empty-state {
        text-align: center;
        padding: 4rem;
        background: white;
        border-radius: 24px;
        border: 1px solid #F0E8DD;
    }
    
    .empty-state i {
        font-size: 4rem;
        color: #E8DFD1;
        margin-bottom: 1rem;
    }
    
    .empty-state h3 {
        font-family: 'Cormorant Garamond', serif;
        color: var(--tunisia-red);
        margin-bottom: 0.5rem;
    }

    @media (max-width: 768px) {
        .page-title { font-size: 1.5rem; }
        .programmes-grid { grid-template-columns: 1fr; gap: 20px; }
        .programme-img { height: 200px; }
        .btn-group { flex-direction: column; gap: 8px; }
        .modal-content { padding: 1.5rem; }
    }
</style>
{% endblock %}

{% block body %}
<div class="container py-5">
    <a href="{{ path('app_voyage_index') }}" class="back-arrow">
        <i class="fas fa-arrow-left"></i> Retour aux voyages
    </a>
    
    <h1 class="page-title">{{ voyage.nom }}</h1>

    <div class="programmes-grid">
        {% for programme in programmes %}
            <div class="programme-card">
                <div class="programme-img">
                    {% if programme.image and programme.image != 'NULL' %}
                        <img src="{{ asset('uploads/programmes/' ~ programme.image|replace({' ': '%20'})) }}" alt="{{ programme.nom }}">
                    {% else %}
                        <img src="https://images.pexels.com/photos/1618750/pexels-photo-1618750.jpeg?auto=compress&cs=tinysrgb&w=800" alt="{{ programme.nom }}">
                    {% endif %}
                    <span class="programme-badge">⭐ À découvrir</span>
                </div>
                <div class="programme-content">
                    <h3 class="programme-title">{{ programme.nom }}</h3>
                    <div class="programme-info">
                        <span><i class="fas fa-map-marker-alt"></i> {{ programme.lieu }}</span>
                        <span><i class="fas fa-hotel"></i> {{ programme.hotel }}</span>
                    </div>
                    <p class="programme-desc">{{ programme.description|slice(0, 100) }}{% if programme.description|length > 100 %}...{% endif %}</p>
                    <div class="programme-dates">
                        <i class="far fa-calendar-alt"></i> {{ programme.dateDebut|date('d/m/Y') }} - {{ programme.dateFin|date('d/m/Y') }}
                    </div>
                    <div class="btn-group">
                        <a href="{{ path('app_programme_show', {'idProg': programme.idProg}) }}" class="btn-details">
                            <i class="fas fa-info-circle me-1"></i> Détails
                        </a>
                        <button class="btn-reserve" onclick="openReservationModal('{{ programme.idProg }}', '{{ programme.nom }}')">
                            <i class="fas fa-calendar-check me-1"></i> Réserver
                        </button>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="empty-state">
                <i class="fas fa-calendar-alt"></i>
                <h3>Aucun programme disponible</h3>
                <p>Aucun programme n'est proposé pour ce voyage pour le moment.</p>
                <a href="{{ path('app_voyage_index') }}" class="btn-details" style="display: inline-block; margin-top: 1rem; padding: 10px 25px;">Découvrir d'autres voyages</a>
            </div>
        {% endfor %}
    </div>
</div>

<!-- Modal de réservation -->
<div id="reservationModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3><i class="fas fa-ticket-alt me-2"></i> Réserver un programme</h3>
            <button class="close-modal" onclick="closeReservationModal()">&times;</button>
        </div>

        {% if errors is defined and errors|length > 0 %}
            <div class="error-messages">
                <ul>
                    {% for message in errors %}
                        <li>{{ message }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {% for message in app.flashes('success') %}
            <div class="success-messages">
                <ul><li>{{ message }}</li></ul>
            </div>
        {% endfor %}

        <form id="reservationForm" method="post">
            <input type="hidden" name="source" value="voyage_programmes">
            <input type="hidden" name="voyageId" value="{{ voyage.idV }}">
            <input type="hidden" name="idProg" id="programmeId">
            <div class="form-group">
                <label>Nom <span class="required">*</span></label>
                <input type="text" name="nom" id="nom" placeholder="Votre nom" value="{{ formData.nom|default('') }}">
                <div class="error-message" id="nomError"></div>
            </div>
            <div class="form-group">
                <label>Prénom <span class="required">*</span></label>
                <input type="text" name="prenom" id="prenom" placeholder="Votre prénom" value="{{ formData.prenom|default('') }}">
                <div class="error-message" id="prenomError"></div>
            </div>
            <div class="form-group">
                <label>Téléphone <span class="required">*</span></label>
                <input type="text" name="telephone" id="telephone" placeholder="Ex: 12345678" value="{{ formData.telephone|default('') }}">
                <div class="error-message" id="telephoneError"></div>
            </div>
            <div class="form-group">
                <label>Email <span class="required">*</span></label>
                <input type="text" name="email" id="email" placeholder="exemple@email.com" value="{{ formData.email|default('') }}">
                <div class="error-message" id="emailError"></div>
            </div>
            <div class="form-group">
                <label>Nombre de personnes <span class="required">*</span></label>
                <input type="text" name="nbre" id="nbre" value="{{ formData.nbre|default('1') }}" placeholder="Ex: 2">
                <div class="error-message" id="nbreError"></div>
            </div>
            <button type="submit" class="btn-submit" id="submitBtn">
                <i class="fas fa-check-circle me-2"></i> Confirmer la réservation
            </button>
        </form>
    </div>
</div>

<script>
    let isSubmitting = false;
    
    function showToast(message, isError = false) {
        const toast = document.createElement('div');
        toast.className = isError ? 'error-toast' : 'success-toast';
        toast.innerHTML = isError ? 
            '<i class="fas fa-exclamation-circle"></i> ' + message : 
            '<i class="fas fa-check-circle"></i> ' + message;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 4000);
    }
    
    function openReservationModal(programmeId) {
        const modal = document.getElementById('reservationModal');
        const form = document.getElementById('reservationForm');
        const routeUrl = "{{ path('app_reservation_new', {'idProg': 'PROGRAMME_ID'}) }}";
        form.action = routeUrl.replace('PROGRAMME_ID', programmeId);
        document.getElementById('programmeId').value = programmeId;
        modal.classList.add('active');
        
        // Réinitialiser les erreurs
        document.querySelectorAll('.error-message').forEach(el => {
            el.classList.remove('show');
            el.textContent = '';
        });
        document.querySelectorAll('.form-group input').forEach(el => {
            el.classList.remove('error');
        });
    }
    
    function closeReservationModal() {
        const modal = document.getElementById('reservationModal');
        modal.classList.remove('active');
        isSubmitting = false;
    }
    
    function displayErrors(errors) {
        document.querySelectorAll('.error-message').forEach(el => {
            el.classList.remove('show');
            el.textContent = '';
        });
        document.querySelectorAll('.form-group input').forEach(el => el.classList.remove('error'));
        
        const errorMap = {
            'nom': 'nomError', 'prénom': 'prenomError', 'prenom': 'prenomError',
            'téléphone': 'telephoneError', 'telephone': 'telephoneError',
            'email': 'emailError', 'personnes': 'nbreError', 'nbre': 'nbreError'
        };
        
        errors.forEach(error => {
            const lowerError = error.toLowerCase();
            let field = null;
            for (const [key, value] of Object.entries(errorMap)) {
                if (lowerError.includes(key)) { field = value; break; }
            }
            if (field) {
                const errorDiv = document.getElementById(field);
                if (errorDiv) {
                    errorDiv.textContent = error;
                    errorDiv.classList.add('show');
                }
                const inputId = field.replace('Error', '');
                const input = document.getElementById(inputId);
                if (input) input.classList.add('error');
            }
        });
    }
    
    document.getElementById('reservationForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        if (isSubmitting) return;
        isSubmitting = true;
        
        const submitBtn = document.getElementById('submitBtn');
        const originalText = submitBtn.innerHTML;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Traitement...';
        submitBtn.disabled = true;
        
        try {
            const response = await fetch(this.action, {
                method: 'POST',
                body: new FormData(this)
            });
            const result = await response.json();
            
            if (result.success) {
                closeReservationModal();
                showToast(result.message);
                setTimeout(() => window.location.reload(), 2000);
            } else if (result.errors) {
                displayErrors(result.errors);
                showToast('Veuillez corriger les erreurs', true);
                isSubmitting = false;
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
            } else {
                showToast(result.message || 'Une erreur est survenue', true);
                isSubmitting = false;
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
            }
        } catch (error) {
            showToast('Erreur de connexion', true);
            isSubmitting = false;
            submitBtn.innerHTML = originalText;
            submitBtn.disabled = false;
        }
    });
    
    {% if errors is defined and errors|length > 0 %}
        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('reservationModal').classList.add('active');
        });
    {% endif %}
    
    window.onclick = function(event) {
        const modal = document.getElementById('reservationModal');
        if (event.target === modal) closeReservationModal();
    }
</script>
{% endblock %}