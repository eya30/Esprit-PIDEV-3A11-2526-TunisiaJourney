<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirmation de réservation</title>
</head>
<body style="margin:0;padding:0;background-color:#f0f4f8;font-family:'Segoe UI',Arial,sans-serif;">

    <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f0f4f8;padding:40px 0;">
        <tr>
            <td align="center">
                <table width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;">

                    {# ── En-tête ── #}
                    <tr>
                        <td style="background:linear-gradient(135deg,#1a535c,#4ecdc4);border-radius:16px 16px 0 0;padding:40px 40px 30px;text-align:center;">
                            <p style="margin:0 0 8px;font-size:13px;color:#a8f0ec;letter-spacing:3px;text-transform:uppercase;">TunisiaJourney</p>
                            <h1 style="margin:0;font-size:28px;color:#ffffff;font-weight:700;">Réservation confirmée </h1>
                            
                        </td>
                    </tr>

                    {# ── Corps ── #}
                    <tr>
                        <td style="background:#ffffff;padding:40px;">

                            <p style="margin:0 0 24px;font-size:16px;color:#2d3748;">
                                Bonjour <strong style="color:#1a535c;">{{ prenom }} {{ nom }}</strong>,
                            </p>
                            <p style="margin:0 0 32px;font-size:15px;color:#4a5568;line-height:1.7;">
                                Nous avons bien enregistré votre réservation pour l'activité
                                <strong style="color:#1a535c;">{{ titreActivite }}</strong>.
                                Scannez le QR code ci-dessous pour accéder à votre billet d'entrée :
                            </p>

                            {# ── QR Code central ── #}
                            <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:24px;">
                                <tr>
                                    <td align="center">
                                        <table cellpadding="0" cellspacing="0"
                                               style="background:#f7fffe;border:2px solid #4ecdc4;border-radius:16px;padding:28px 40px;">
                                            <tr>
                                                <td align="center">
                                                    <p style="margin:0 0 16px;font-size:13px;color:#718096;text-transform:uppercase;letter-spacing:2px;">
                                                         Votre billet numérique
                                                    </p>
                                                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data={{ billetUrl|url_encode }}&color=1a535c&bgcolor=ffffff&qzone=1"
                                                         alt="QR Code billet"
                                                         width="200" height="200"
                                                         style="display:block;border-radius:8px;border:1px solid #e2f5f3;" />
                                                    <p style="margin:16px 0 0;font-size:12px;color:#a0aec0;">
                                                        Scannez avec votre téléphone pour afficher votre billet
                                                    </p>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            {# Récap rapide #}
                            <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:24px;">
                                
                            </table>

                            {# Note #}
                            <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:32px;">
                                <tr>
                                    <td style="padding:16px 20px;background:#fffbeb;border-left:4px solid #f6c90e;border-radius:0 8px 8px 0;font-size:14px;color:#744210;line-height:1.6;">
                                        ✨ Présentez ce QR code à l'entrée de l'activité. Merci pour votre confiance !
                                    </td>
                                </tr>
                            </table>

                            {# Bouton fallback #}
                            <table width="100%" cellpadding="0" cellspacing="0">
                                <tr>
                                    <td align="center">
                                        <a href="{{ billetUrl }}"
                                           style="display:inline-block;background:linear-gradient(135deg,#1a535c,#4ecdc4);color:#ffffff;text-decoration:none;font-size:15px;font-weight:600;padding:14px 36px;border-radius:50px;letter-spacing:0.5px;">
                                            🎟️ Voir mon billet en ligne
                                        </a>
                                    </td>
                                </tr>
                            </table>

                        </td>
                    </tr>

                    {# ── Pied de page ── #}
                    <tr>
                        <td style="background:#1a535c;border-radius:0 0 16px 16px;padding:24px 40px;text-align:center;">
                            <p style="margin:0 0 4px;font-size:13px;color:#a8f0ec;font-weight:600;">TunisiaJourney</p>
                            <p style="margin:0;font-size:12px;color:#6bb8b4;">Cet email a été envoyé automatiquement, merci de ne pas y répondre.</p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>

</body>
</html>
