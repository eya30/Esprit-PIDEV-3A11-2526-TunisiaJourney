{% extends 'base.html.twig' %}

{% block title %}Supprimer ma réservation - TunisiaJourney{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .delete-header {
        background: linear-gradient(135deg, #8B0000, #dc3545);
        padding: 2rem 0;
        margin-bottom: 2rem;
    }
    
    .info-card {
        background: white;
        border-radius: 20px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    }
    
    .rule-badge {
        text-align: center;
        padding: 1rem;
        border-radius: 12px;
        background: #f8f9fa;
    }
    
    .rule-badge .percent {
        font-size: 1.5rem;
        font-weight: bold;
    }
    
    .rule-badge.rule-100 { background: #d4edda; color: #155724; }
    .rule-badge.rule-50 { background: #fff3cd; color: #856404; }
    .rule-badge.rule-25 { background: #d1ecf1; color: #0c5460; }
    .rule-badge.rule-0 { background: #f8d7da; color: #721c24; }
    
    .remboursement-box {
        background: #f8f9fa;
        border-radius: 16px;
        padding: 1.5rem;
        text-align: center;
    }
    
    .montant-rembourse {
        font-size: 2.5rem;
        font-weight: bold;
    }
    
    .btn-delete {
        background: #dc3545;
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 30px;
        font-weight: 600;
        transition: all 0.3s;
    }
    
    .btn-delete:hover {
        background: #c82333;
        transform: scale(1.02);
        color: white;
    }
</style>
{% endblock %}

{% block body %}
<div class="delete-header">
    <div class="container text-center text-white">
        <h1 class="mb-2">Supprimer ma réservation</h1>
        <p>Vérifiez les conditions avant de confirmer la suppression</p>
    </div>
</div>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <!-- Informations de la réservation -->
            <div class="info-card">
                <h4 class="mb-3">📋 Détails de la réservation</h4>
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>N° réservation :</strong> #{{ reservation.idRes }}</p>
                        <p><strong>Hôtel :</strong> {{ reservation.hotel_nom }}</p>
                        <p><strong>Chambre :</strong> N°{{ reservation.chambre_num }}</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Dates :</strong> {{ reservation.dateDebut|date('d/m/Y') }} → {{ reservation.dateFin|date('d/m/Y') }}</p>
                        <p><strong>Nombre de nuits :</strong> {{ reservation.nbNuit }} nuits</p>
                        <p><strong>Personnes :</strong> {{ reservation.nbPersonnes }}</p>
                    </div>
                </div>
                <hr>
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Nom complet :</strong> {{ reservation.prenom }} {{ reservation.nom }}</p>
                        <p><strong>Téléphone :</strong> {{ reservation.telephone }}</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Email :</strong> {{ reservation.email }}</p>
                        <p><strong>Montant total payé :</strong> <span class="fw-bold fs-5">{{ reservation.prixTotal }} DT</span></p>
                    </div>
                </div>
            </div>
            
            <!-- Politique d'annulation -->
            <div class="info-card">
                <h4 class="mb-3">📜 Politique d'annulation</h4>
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="rule-badge rule-100">
                            <div class="percent">100%</div>
                            <small>remboursé</small>
                            <div class="mt-2"><small>+30 jours</small></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="rule-badge rule-50">
                            <div class="percent">50%</div>
                            <small>remboursé</small>
                            <div class="mt-2"><small>15-30 jours</small></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="rule-badge rule-25">
                            <div class="percent">25%</div>
                            <small>remboursé</small>
                            <div class="mt-2"><small>7-15 jours</small></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="rule-badge rule-0">
                            <div class="percent">0%</div>
                            <small>remboursé</small>
                            <div class="mt-2"><small>-7 jours</small></div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Calcul du remboursement -->
            <div class="info-card">
                <h4 class="mb-3">💰 Calcul du remboursement</h4>
                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <td>Date de suppression :</td>
                                <td><strong>{{ date_suppression|date('d/m/Y') }}</strong></td>
                            </tr>
                            <tr>
                                <td>Date d'arrivée :</td>
                                <td><strong>{{ reservation.dateDebut|date('d/m/Y') }}</strong></td>
                            </tr>
                            <tr>
                                <td>Jours avant l'arrivée :</td>
                                <td><strong>{{ jours_avant_arrivee }} jours</strong></td>
                            </tr>
                            <tr>
                                <td>Pourcentage remboursé :</td>
                                <td>
                                    <span class="badge bg-{{ css_class }} fs-6 p-2">
                                        <i class="fas {{ icone }}"></i> {{ pourcentage_remboursement }}%
                                    </span>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <div class="remboursement-box">
                            <p class="mb-1">Montant remboursé</p>
                            <div class="montant-rembourse text-{{ css_class }}">
                                {{ montant_rembourse }} DT
                            </div>
                            <p class="mb-0 small">sur {{ reservation.prixTotal }} DT</p>
                        </div>
                    </div>
                </div>
                
                <div class="alert alert-{{ css_class }} mt-3">
                    <i class="fas {{ icone }} me-2"></i>
                    {{ texte_explication }}
                </div>
            </div>
            
            <!-- Formulaire de confirmation -->
            <div class="info-card text-center">
                <div class="alert alert-warning mb-3">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Attention :</strong> Cette action est irréversible. Une fois supprimée, votre réservation ne pourra pas être restaurée.
                </div>
                
                <form method="post" onsubmit="return confirm('Êtes-vous SÛR de vouloir supprimer cette réservation ? Cette action est définitive.')">
                    <button type="submit" class="btn-delete">
                        <i class="fas fa-trash-alt me-2"></i> Confirmer la suppression
                    </button>
                    <a href="{{ path('app_profile') }}" class="btn btn-secondary ms-2">
                        <i class="fas fa-arrow-left me-2"></i> Retour
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}