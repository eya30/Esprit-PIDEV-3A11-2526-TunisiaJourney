{% extends 'base.html.twig' %}
{% block title %}Finaliser la commande - TunisiaJourney{% endblock %}

{% block stylesheets %}
<style>
    :root { --tunisia-red:#E31B23; --tunisia-orange:#FF6B35; --tunisia-sand:#FDF5E6; --tunisia-soft:#F5CAC3; --dark-gray:#2C3E50; }
    .hero { position:relative; height:32vh; min-height:220px; background-image:linear-gradient(rgba(227,27,35,0.22),rgba(245,202,195,0.32)),url('https://switchmed.eu/wp-content/uploads/2020/04/tunisia-1.jpg'); background-size:cover; background-position:center; background-attachment:fixed; display:flex; align-items:center; justify-content:center; text-align:center; color:white; overflow:hidden; }
    .hero::before { content:''; position:absolute; inset:0; background:radial-gradient(circle at center,transparent 0%,rgba(0,0,0,0.28) 100%); }
    .hero-content { position:relative; z-index:2; max-width:700px; padding:2rem; animation:fadeInUp 1s cubic-bezier(0.2,0.9,0.4,1.1); }
    @keyframes fadeInUp { from{opacity:0;transform:translateY(40px)} to{opacity:1;transform:translateY(0)} }
    .hero h1 { font-family:'Cormorant Garamond',serif; font-size:2.6rem; font-weight:700; margin-bottom:0.5rem; text-shadow:3px 3px 12px rgba(0,0,0,0.5); color:#F5CAC3; letter-spacing:2px; }
    .hero p { font-size:0.95rem; font-weight:300; color:rgba(255,255,255,0.92); }

    .section-title { text-align:center; font-family:'Cormorant Garamond',serif; font-size:2.2rem; font-weight:700; color:var(--tunisia-red); margin-bottom:0.5rem; }
    .section-title:after { content:'✦ ✦ ✦'; display:block; color:#F5CAC3; font-size:1rem; margin-top:0.5rem; letter-spacing:12px; }
    .section-subtitle { text-align:center; color:var(--dark-gray); font-size:0.9rem; margin-bottom:2rem; font-style:italic; opacity:0.75; }

    /* Formulaire */
    .form-card { background:white; border-radius:28px; padding:2.2rem 2.5rem; box-shadow:0 20px 50px rgba(0,0,0,0.09); }
    .form-section-label { font-family:'Cormorant Garamond',serif; font-size:1.2rem; font-weight:700; color:var(--dark-gray); margin-bottom:1rem; padding-bottom:0.5rem; border-bottom:2px solid #F5CAC3; display:flex; align-items:center; gap:8px; }
    .form-section-label i { color:var(--tunisia-orange); }
    .form-label-custom { display:block; font-weight:600; font-size:0.88rem; color:var(--dark-gray); margin-bottom:0.4rem; }
    .form-label-custom i { color:var(--tunisia-orange); margin-right:6px; width:16px; }
    .input-custom { width:100%; padding:11px 20px; border:2px solid #F5CAC3; border-radius:25px; background:white; font-size:0.92rem; color:var(--dark-gray); font-family:'Montserrat',sans-serif; transition:all 0.3s ease; box-sizing:border-box; }
    .input-custom:focus { outline:none; border-color:var(--tunisia-red); box-shadow:0 0 0 3px rgba(227,27,35,0.1); }

    input[type="hidden"] { display: none !important; }

    select.input-custom { appearance:auto; cursor:pointer; }
    .form-divider { height:1px; background:linear-gradient(to right,transparent,#F5CAC3,transparent); margin:1.5rem 0; }
    .field-error { color:var(--tunisia-red); font-size:0.8rem; margin-top:4px; padding-left:12px; }

    /* Autocomplete styles */
    .autocomplete-container { position: relative; }
    #adresse-suggestions {
        display: none;
        position: absolute;
        top: calc(100% + 5px);
        left: 0;
        right: 0;
        z-index: 9999;
        background: white;
        border: 2px solid #F5CAC3;
        border-radius: 0 0 20px 20px;
        max-height: 250px;
        overflow-y: auto;
        list-style: none;
        padding: 0;
        margin: 0;
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    }
    #adresse-suggestions li {
        padding: 12px 20px;
        cursor: pointer;
        border-bottom: 1px solid #f0e8dd;
        transition: background 0.2s;
        color: var(--dark-gray);
    }
    #adresse-suggestions li:last-child { border-bottom: none; }
    #adresse-suggestions li:hover { background: #FEF9F0; color: var(--tunisia-red); }

    /* Récap commande */
    .recap-card { background:white; border-radius:20px; box-shadow:0 10px 30px rgba(0,0,0,0.07); padding:1.5rem; position:sticky; top:100px; }
    .recap-card h4 { font-family:'Cormorant Garamond',serif; font-size:1.4rem; font-weight:700; color:var(--dark-gray); margin-bottom:1rem; padding-bottom:0.8rem; border-bottom:2px solid #F5CAC3; }
    .recap-item { display:flex; align-items:center; gap:0.8rem; padding:0.7rem 0; border-bottom:1px solid #FDF5E6; }
    .recap-item:last-of-type { border-bottom:none; }
    .recap-item img { width:45px; height:45px; object-fit:cover; border-radius:10px; border:1px solid #F5CAC3; flex-shrink:0; }
    .recap-item-placeholder { width:45px; height:45px; background:#FEF9F0; border-radius:10px; display:flex; align-items:center; justify-content:center; color:#F5CAC3; font-size:1.2rem; flex-shrink:0; }
    .recap-item-name { flex:1; font-size:0.85rem; font-weight:600; color:var(--dark-gray); }
    .recap-item-qty { font-size:0.8rem; color:#6c757d; }
    .recap-item-prix { font-weight:700; color:var(--tunisia-red); font-size:0.9rem; white-space:nowrap; }
    .recap-total-row { display:flex; justify-content:space-between; align-items:center; padding-top:1rem; margin-top:0.5rem; border-top:2px solid #F5CAC3; }
    .recap-total-row .label { font-weight:700; color:var(--dark-gray); }
    .recap-total-row .montant { font-weight:800; font-size:1.3rem; color:var(--tunisia-red); }

    /* Boutons */
    .btn-back { display:inline-flex; align-items:center; gap:8px; background:transparent; border:2px solid var(--tunisia-red); color:var(--tunisia-red); padding:10px 24px; border-radius:30px; font-weight:600; font-size:0.9rem; font-family:'Montserrat',sans-serif; text-decoration:none; transition:all 0.3s ease; margin-bottom:2rem; }
    .btn-back:hover { background:var(--tunisia-red); color:white; transform:translateY(-2px); }

    /* Options de paiement */
    .payment-options {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 1rem;
    }
    .payment-method-card {
        background: white;
        border: 2px solid #F5CAC3;
        border-radius: 20px;
        padding: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    .payment-method-card:hover {
        border-color: var(--tunisia-orange);
        background: #FEF9F0;
    }
    .payment-method-card.selected {
        border-color: var(--tunisia-red);
        background: #FFF5F0;
    }
    .payment-method-card input[type="radio"] {
        width: 20px;
        height: 20px;
        cursor: pointer;
        accent-color: var(--tunisia-red);
    }
    .payment-method-card label {
        flex: 1;
        cursor: pointer;
        font-weight: 600;
        color: var(--dark-gray);
        margin: 0;
    }
    .payment-method-card i {
        font-size: 1.5rem;
        color: var(--tunisia-orange);
    }

    .btn-stripe { width:100%; background:linear-gradient(135deg, #635BFF, #0A2540); color:white; border:none; padding:14px; border-radius:30px; font-weight:700; font-size:1rem; font-family:'Montserrat',sans-serif; cursor:pointer; transition:all 0.3s ease; margin-top:1rem; }
    .btn-stripe:hover { transform:translateY(-2px); box-shadow:0 10px 25px rgba(99,91,255,0.4); }
    .btn-stripe:disabled { opacity:0.6; cursor:not-allowed; transform:none; }
    .btn-submit { width:100%; background:linear-gradient(135deg,var(--tunisia-red),var(--tunisia-orange)); color:white; border:none; padding:14px; border-radius:30px; font-weight:700; font-size:1rem; font-family:'Montserrat',sans-serif; cursor:pointer; transition:all 0.3s ease; margin-top:1rem; }
    .btn-submit:hover { background:linear-gradient(135deg,var(--tunisia-orange),var(--tunisia-red)); transform:translateY(-2px); box-shadow:0 10px 25px rgba(227,27,35,0.4); }

    @media(max-width:768px) { .hero h1{font-size:2rem;} .form-card{padding:1.5rem 1.2rem;} .recap-card{position:static;margin-top:1.5rem;} }
</style>
{% endblock %}

{% block body %}
<div class="container mt-3">
    {% if not form.vars.valid %}
        <div class="alert alert-danger" style="border-radius:15px;">
            <strong><i class="fas fa-exclamation-triangle"></i> Le formulaire est invalide :</strong>
            <ul class="mb-0">
                {% for child in form.children %}
                    {% for error in child.vars.errors %}
                        <li>{{ child.vars.label|default(child.vars.name) }} : {{ error.message }}</li>
                    {% endfor %}
                {% endfor %}
                {% for error in form.vars.errors %}
                    <li>{{ error.message }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }}" style="border-radius:15px;">{{ message }}</div>
        {% endfor %}
    {% endfor %}
</div>

<section class="hero">
    <div class="hero-content">
        <h1>Finaliser la Commande</h1>
        <p>Renseignez vos informations de livraison et de paiement.</p>
    </div>
</section>

<section class="py-5" style="background:var(--tunisia-sand);">
    <div class="container">
        <h2 class="section-title">Validation de la Commande</h2>
        <p class="section-subtitle">Dernière étape avant la confirmation</p>

        <div class="row justify-content-center">
            <div class="col-lg-10">
                <a href="{{ path('app_panier_index') }}" class="btn-back">
                    <i class="fas fa-arrow-left"></i> Retour au panier
                </a>

                <div class="row g-4">
                    <div class="col-lg-7">
                        <div class="form-card">
                            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                            <div class="form-section-label">
                                <i class="fas fa-truck"></i> Livraison
                            </div>

                            <div class="mb-3 autocomplete-container">
                                <label class="form-label-custom"><i class="fas fa-map-marker-alt"></i> Adresse de livraison</label>
                                <input type="text"
                                       id="adresse-input"
                                       name="{{ form.AdresseLiv.vars.full_name }}"
                                       class="input-custom"
                                       placeholder="Ex: Avenue Habib Bourguiba, Tunis"
                                       autocomplete="off"
                                       value="{{ form.AdresseLiv.vars.value }}">
                                <ul id="adresse-suggestions"></ul>
                                {{ form_errors(form.AdresseLiv) }}
                            </div>

                            <div class="mb-3">
                                <label class="form-label-custom"><i class="fas fa-mail-bulk"></i> Code postal</label>
                                {{ form_widget(form.CodePostal, {'attr': {'class': 'input-custom', 'placeholder': '1000', 'required': false}}) }}
                                {{ form_errors(form.CodePostal) }}
                            </div>

                            <div class="form-divider"></div>

                            <div class="form-section-label">
                                <i class="fas fa-credit-card"></i> Mode de paiement
                            </div>

                            <div class="payment-options">
                                <div class="payment-method-card" data-method="livraison">
                                    <input type="radio" name="payment_method" id="payment_livraison" value="livraison" checked>
                                    <i class="fas fa-money-bill-wave"></i>
                                    <label for="payment_livraison">Paiement à la livraison (espèces)</label>
                                </div>
                                <div class="payment-method-card" data-method="carte">
                                    <input type="radio" name="payment_method" id="payment_carte" value="carte">
                                    <i class="fab fa-stripe"></i>
                                    <label for="payment_carte">Carte bancaire (Stripe)</label>
                                </div>
                            </div>

                            <input type="hidden" id="mode_paiement" name="{{ form.ModePaiement.vars.full_name }}" value="livraison">

                            <div id="stripe-button-container" style="display: none;">
                                <button type="button" id="stripe-payment-btn" class="btn-stripe">
                                    <i class="fab fa-stripe me-2"></i> Payer par Carte Bancaire
                                </button>
                            </div>

                            <button type="submit" id="submit-livraison" class="btn-submit">
                                <i class="fas fa-check-circle me-2"></i> Confirmer la commande
                            </button>

                            {{ form_widget(form._token) }}
                            {{ form_end(form, {'render_rest': false}) }}
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <div class="recap-card">
                            <h4><i class="fas fa-shopping-bag me-2" style="color:var(--tunisia-orange);"></i> Votre commande</h4>

                            {% for item in items %}
                                <div class="recap-item">
                                    {% if item.produit.image %}
                                        <img src="{{ asset('uploads/produits/' ~ item.produit.image) }}" alt="{{ item.produit.titre }}">
                                    {% else %}
                                        <div class="recap-item-placeholder"><i class="fas fa-box"></i></div>
                                    {% endif %}
                                    <div class="recap-item-name">
                                        {{ item.produit.titre }}
                                        <div class="recap-item-qty">× {{ item.quantite }}</div>
                                    </div>
                                    <div class="recap-item-prix">{{ (item.produit.prix * item.quantite)|number_format(2, ',', ' ') }} TND</div>
                                </div>
                            {% endfor %}

                            {# Affichage du sous-total et de la remise si applicable #}
                            <div style="display:flex; justify-content:space-between; font-size:0.85rem; color:#6c757d; padding:0.8rem 0 0;">
                                <span>Sous-total</span>
                                <span>{{ totalInitial|number_format(2, ',', ' ') }} TND</span>
                            </div>

                            {% if remise > 0 %}
                                <div style="display:flex; justify-content:space-between; font-size:0.85rem; color:var(--tunisia-red); padding:0.2rem 0 0;">
                                    <span><i class="fas fa-tag me-1"></i> Remise 10% (≥ 100 DT)</span>
                                    <span style="font-weight:600;">- {{ remise|number_format(2, ',', ' ') }} TND</span>
                                </div>
                            {% endif %}

                            <div style="display:flex; justify-content:space-between; font-size:0.85rem; color:#6c757d; padding:0.4rem 0 0;">
                                <span><i class="fas fa-truck me-1" style="color:var(--tunisia-orange);"></i> Livraison</span>
                                <span style="color:#10B981; font-weight:600;">Gratuite</span>
                            </div>

                            <div class="recap-total-row">
                                <span class="label">Total à payer</span>
                                <span class="montant" id="total-montant">{{ total|number_format(2, ',', ' ') }} TND</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://js.stripe.com/v3/"></script>
<script>
// AUTOCOMPLETION D'ADRESSE
document.addEventListener('DOMContentLoaded', function() {
    const inputAdresse = document.getElementById('adresse-input');
    const suggestionsBox = document.getElementById('adresse-suggestions');
    if (!inputAdresse) return;
    let timeoutId;
    async function searchAddresses(query) {
        if (query.length < 2) {
            suggestionsBox.style.display = 'none';
            return;
        }
        suggestionsBox.innerHTML = '<li style="text-align:center; padding:12px; color:#999;"><i class="fas fa-spinner fa-spin"></i> Recherche...</li>';
        suggestionsBox.style.display = 'block';
        try {
            const response = await fetch('/api/adresse/autocomplete?query=' + encodeURIComponent(query));
            const data = await response.json();
            if (data && data.length > 0) {
                suggestionsBox.innerHTML = '';
                data.forEach(address => {
                    const li = document.createElement('li');
                    li.innerHTML = `<i class="fas fa-map-marker-alt" style="margin-right:10px; color:#FF6B35;"></i>${address}`;
                    li.onclick = () => {
                        inputAdresse.value = address;
                        suggestionsBox.style.display = 'none';
                    };
                    suggestionsBox.appendChild(li);
                });
            } else {
                suggestionsBox.innerHTML = '<li style="text-align:center; padding:12px; color:#999;">Aucune adresse trouvée</li>';
                setTimeout(() => { suggestionsBox.style.display = 'none'; }, 2000);
            }
        } catch (error) {
            console.error('Erreur:', error);
            suggestionsBox.innerHTML = '<li style="text-align:center; padding:12px; color:#E31B23;">Erreur de connexion</li>';
        }
    }
    inputAdresse.addEventListener('input', function(e) {
        clearTimeout(timeoutId);
        timeoutId = setTimeout(() => searchAddresses(e.target.value.trim()), 500);
    });
    document.addEventListener('click', function(e) {
        if (!inputAdresse.contains(e.target) && !suggestionsBox.contains(e.target)) {
            suggestionsBox.style.display = 'none';
        }
    });
});

// GESTION DES MODES DE PAIEMENT
document.addEventListener('DOMContentLoaded', function() {
    const stripe = Stripe('{{ stripe_public_key }}');
    const stripeButton = document.getElementById('stripe-payment-btn');
    const submitLivraison = document.getElementById('submit-livraison');
    const stripeContainer = document.getElementById('stripe-button-container');
    const paymentMethods = document.querySelectorAll('input[name="payment_method"]');
    const modePaiementInput = document.getElementById('mode_paiement');
    const adresseInput = document.getElementById('adresse-input');
    const codePostalInput = document.querySelector('input[name="{{ form.CodePostal.vars.full_name }}"]');

    paymentMethods.forEach(radio => {
        radio.addEventListener('change', function() {
            if (this.value === 'carte') {
                stripeContainer.style.display = 'block';
                submitLivraison.style.display = 'none';
                modePaiementInput.value = 'carte_bancaire';
            } else {
                stripeContainer.style.display = 'none';
                submitLivraison.style.display = 'block';
                modePaiementInput.value = 'livraison';
            }
        });
    });

    if (stripeButton) {
        stripeButton.addEventListener('click', async function() {
            stripeButton.disabled = true;
            const originalText = stripeButton.innerHTML;
            stripeButton.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Préparation...';
            try {
                const items = [
                    {% for item in items %}
                    {
                        name: "{{ item.produit.titre|escape('js') }}",
                        price: {{ item.produit.prix }},
                        quantity: {{ item.quantite }},
                        description: ""
                    },
                    {% endfor %}
                ];
                const response = await fetch('/paiement/creer-session', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        items: items,
                        adresse: adresseInput.value,
                        codePostal: codePostalInput ? codePostalInput.value : ''
                    })
                });
                if (!response.ok) throw new Error('Erreur serveur: ' + response.status);
                const session = await response.json();
                if (session.url) window.location.href = session.url;
                else throw new Error('URL de paiement non reçue');
            } catch (error) {
                console.error('Erreur paiement:', error);
                alert('❌ Erreur: ' + error.message);
                stripeButton.disabled = false;
                stripeButton.innerHTML = originalText;
            }
        });
    }
});
</script>
{% endblock %}