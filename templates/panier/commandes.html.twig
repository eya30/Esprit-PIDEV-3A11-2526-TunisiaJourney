{% extends 'base.html.twig' %}
{% block title %}Mes Commandes - TunisiaJourney{% endblock %}

{% block stylesheets %}
<style>
    :root { --tunisia-red:#E31B23; --tunisia-orange:#FF6B35; --tunisia-sand:#FDF5E6; --tunisia-soft:#F5CAC3; --dark-gray:#2C3E50; }
    .hero { position:relative; height:35vh; min-height:240px; background-image:linear-gradient(rgba(227,27,35,0.22),rgba(245,202,195,0.32)),url('https://switchmed.eu/wp-content/uploads/2020/04/tunisia-1.jpg'); background-size:cover; background-position:center; background-attachment:fixed; display:flex; align-items:center; justify-content:center; text-align:center; color:white; overflow:hidden; }
    .hero::before { content:''; position:absolute; inset:0; background:radial-gradient(circle at center,transparent 0%,rgba(0,0,0,0.28) 100%); }
    .hero-content { position:relative; z-index:2; max-width:700px; padding:2rem; animation:fadeInUp 1s cubic-bezier(0.2,0.9,0.4,1.1); }
    @keyframes fadeInUp { from{opacity:0;transform:translateY(40px)} to{opacity:1;transform:translateY(0)} }
    .hero h1 { font-family:'Cormorant Garamond',serif; font-size:2.8rem; font-weight:700; margin-bottom:0.6rem; text-shadow:3px 3px 12px rgba(0,0,0,0.5); color:#F5CAC3; letter-spacing:2px; }
    .hero p { font-size:1rem; font-weight:300; color:rgba(255,255,255,0.92); }

    .section-title { text-align:center; font-family:'Cormorant Garamond',serif; font-size:2.2rem; font-weight:700; color:var(--tunisia-red); margin-bottom:0.5rem; }
    .section-title:after { content:'✦ ✦ ✦'; display:block; color:#F5CAC3; font-size:1rem; margin-top:0.5rem; letter-spacing:12px; }
    .section-subtitle { text-align:center; color:var(--dark-gray); font-size:0.9rem; margin-bottom:2rem; font-style:italic; opacity:0.75; }

    .table-card { background:white; border-radius:24px; box-shadow:0 15px 40px rgba(0,0,0,0.08); overflow:hidden; }
    .table-card table { margin-bottom:0; }
    .table-card thead th { background:#FEF9F0; padding:16px 20px; font-size:11px; font-weight:700; color:var(--tunisia-red); text-transform:uppercase; letter-spacing:0.8px; border-bottom:2px solid #F5CAC3; white-space:nowrap; }
    .table-card tbody td { padding:14px 20px; font-size:0.88rem; border-bottom:1px solid #FDF5E6; color:var(--dark-gray); vertical-align:middle; }
    .table-card tbody tr:hover td { background:#FFFBF5; }
    .table-card tbody tr:last-child td { border-bottom:none; }

    /* Produits dans la commande */
    .ligne-produit { display:flex; align-items:center; gap:6px; margin-bottom:4px; font-size:0.82rem; }
    .ligne-produit img { width:30px; height:30px; object-fit:cover; border-radius:6px; border:1px solid #F5CAC3; }
    .ligne-produit-placeholder { width:30px; height:30px; background:#FEF9F0; border-radius:6px; display:flex; align-items:center; justify-content:center; color:#F5CAC3; font-size:0.9rem; }

    /* Badges statut */
    .badge-statut { display:inline-flex; align-items:center; gap:5px; padding:5px 14px; border-radius:20px; font-size:11px; font-weight:600; white-space:nowrap; }
    .statut-attente   { background:#FEF3C7; color:#D97706; }
    .statut-confirmee { background:#D1FAE5; color:#065F46; }
    .statut-expediee  { background:#DBEAFE; color:#1D4ED8; }
    .statut-livree    { background:#F3F4F6; color:#374151; }
    .statut-annulee   { background:#FEE2E2; color:#991B1B; }

    .prix-total { font-weight:800; color:var(--tunisia-red); }

    .action-btn { width:34px; height:34px; border-radius:10px; display:inline-flex; align-items:center; justify-content:center; transition:all 0.2s; cursor:pointer; border:none; font-size:0.85rem; text-decoration:none; }
    .btn-delete-cmd { background:#FEF2F2; color:#EF4444; }
    .btn-delete-cmd:hover { background:#EF4444; color:white; transform:translateY(-2px); }

    .btn-shop { display:inline-flex; align-items:center; gap:8px; background:transparent; border:2px solid var(--tunisia-red); color:var(--tunisia-red); padding:10px 24px; border-radius:30px; font-weight:600; font-size:0.9rem; font-family:'Montserrat',sans-serif; text-decoration:none; transition:all 0.3s ease; }
    .btn-shop:hover { background:var(--tunisia-red); color:white; transform:translateY(-2px); }

    .empty-state { text-align:center; padding:4rem 2rem; }
    .empty-state i { font-size:3.5rem; color:#F5CAC3; margin-bottom:1rem; display:block; }
    .empty-state p { color:#6c757d; font-size:1.05rem; margin-bottom:1.5rem; }

    @media(max-width:768px) { .hero h1{font-size:2rem;} .table-card{overflow-x:auto;} }
</style>
{% endblock %}

{% block body %}
<section class="hero">
    <div class="hero-content">
        <h1>Mes Commandes</h1>
        <p>Suivez l'historique de vos commandes artisanales.</p>
    </div>
</section>

<section class="py-5" style="background:var(--tunisia-sand);">
    <div class="container">
        <h2 class="section-title">Historique des Commandes</h2>
        <p class="section-subtitle">{{ commandes|length }} commande(s) au total</p>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <a href="{{ path('app_produit_index') }}" class="btn-shop">
                <i class="fas fa-store"></i> Retour à la boutique
            </a>
            <a href="{{ path('app_panier_index') }}" class="btn-shop">
                <i class="fas fa-shopping-cart"></i> Mon panier
            </a>
        </div>

        {% if commandes is empty %}
            <div class="empty-state">
                <i class="fas fa-shopping-bag"></i>
                <p>Aucune commande pour le moment.</p>
                <a href="{{ path('app_produit_index') }}" class="btn-shop">
                    <i class="fas fa-store me-1"></i> Découvrir la boutique
                </a>
            </div>
        {% else %}
            <div class="table-card">
                <table class="table table-borderless">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Date</th>
                            <th>Articles commandés</th>
                            <th>Adresse</th>
                            <th>Paiement</th>
                            <th>Total</th>
                            <th>Statut</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for commande in commandes %}
                        <tr>
                            <td><strong>#{{ commande.id }}</strong></td>
                            <td>{{ commande.dateC|date('d/m/Y') }}</td>
                            <td>
                                {% for ligne in commande.lignes %}
                                    <div class="ligne-produit">
                                        {% if ligne.produit.image %}
                                            <img src="{{ asset('uploads/produits/' ~ ligne.produit.image) }}" alt="{{ ligne.produit.titre }}">
                                        {% else %}
                                            <div class="ligne-produit-placeholder"><i class="fas fa-box"></i></div>
                                        {% endif %}
                                        <span>{{ ligne.produit.titre }} × {{ ligne.quantite }}</span>
                                    </div>
                                {% else %}
                                    <span style="color:#9CA3AF; font-size:0.8rem;">—</span>
                                {% endfor %}
                            </td>
                            <td>{{ commande.adresseLiv ?? '—' }}<br><small style="color:#6c757d;">{{ commande.codePostal ?? '' }}</small></td>
                            <td>
                                <i class="fas fa-credit-card me-1" style="color:var(--tunisia-orange);"></i>
                                {{ commande.modePaiement ?? '—' }}
                            </td>
                            <td class="prix-total">{{ commande.total|number_format(2, ',', ' ') }} TND</td>
                            <td>
                                {% set statut = commande.statut|default('En attente') %}
                                {% if statut == 'En attente' %}
                                    <span class="badge-statut statut-attente"><i class="fas fa-clock"></i> {{ statut }}</span>
                                {% elseif statut == 'Confirmée' %}
                                    <span class="badge-statut statut-confirmee"><i class="fas fa-check"></i> {{ statut }}</span>
                                {% elseif statut == 'Expédiée' %}
                                    <span class="badge-statut statut-expediee"><i class="fas fa-truck"></i> {{ statut }}</span>
                                {% elseif statut == 'Livrée' %}
                                    <span class="badge-statut statut-livree"><i class="fas fa-box"></i> {{ statut }}</span>
                                {% else %}
                                    <span class="badge-statut statut-annulee"><i class="fas fa-times"></i> {{ statut }}</span>
                                {% endif %}
                            </td>
                            <td>
                                <form method="post" action="{{ path('app_commande_delete', {id: commande.id}) }}"
                                      onsubmit="return confirm('Supprimer cette commande ?')">
                                    <button type="submit" class="action-btn btn-delete-cmd" title="Supprimer">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
